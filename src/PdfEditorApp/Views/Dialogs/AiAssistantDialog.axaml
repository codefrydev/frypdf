<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PdfEditorApp.ViewModels"
             xmlns:converters="using:PdfEditorApp.Converters"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="PdfEditorApp.Views.Dialogs.AiAssistantDialog"
             x:DataType="vm:AiAssistantViewModel">

    <UserControl.Resources>
        <converters:EqualityToBooleanConverter x:Key="EqualityConverter" />
        <converters:NullToBooleanConverter x:Key="NullToBooleanConverter" />
    </UserControl.Resources>

    <!-- Modal Backdrop Overlay -->
    <Grid Background="#75000000"
          IsVisible="{Binding IsOpen}">

        <!-- Studio Assistant Card -->
        <Border Width="740"
                MaxHeight="720"
                Background="{DynamicResource WinPanelBrush}"
                BorderBrush="{DynamicResource WinBorderBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource M3ShapeCornerExtraLarge}"
                BoxShadow="{StaticResource M3ElevationLevel4}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Padding="24">

            <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto">

                <!-- 1. Header Bar -->
                <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Margin="0,0,0,16">
                    <!-- Sparkle / AI Gradient Icon -->
                    <Border Grid.Column="0" Width="44" Height="44" Background="#EDE9FE" CornerRadius="12" VerticalAlignment="Center">
                        <materialIcons:MaterialIcon Kind="AutoFixHigh" Width="24" Height="24" Foreground="#7C3AED" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <!-- Title & Model Indicator -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock Text="AI Studio Assistant" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource WinTextBrush}" VerticalAlignment="Center" />

                            <!-- 1. Free Local Badge -->
                            <Border Background="#DCFCE7"
                                    BorderBrush="#86EFAC"
                                    BorderThickness="1"
                                    CornerRadius="5"
                                    Padding="7,2"
                                    VerticalAlignment="Center"
                                    IsVisible="{Binding IsActiveModelFreeLocal}">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <materialIcons:MaterialIcon Kind="ShieldCheckOutline" Width="13" Height="13" Foreground="#15803D" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding ActiveModelDisplayName}" FontSize="11" FontWeight="SemiBold" Foreground="#15803D" VerticalAlignment="Center" />
                                    <TextBlock Text="• Free / Local" FontSize="10.5" FontWeight="Medium" Foreground="#166534" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>

                            <!-- 2. Free Cloud Tier Badge (e.g. Ollama Free Cloud, Groq Free Tier) -->
                            <Border Background="#E0F2FE"
                                    BorderBrush="#7DD3FC"
                                    BorderThickness="1"
                                    CornerRadius="5"
                                    Padding="7,2"
                                    VerticalAlignment="Center"
                                    IsVisible="{Binding IsActiveModelFreeCloud}">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <materialIcons:MaterialIcon Kind="CloudCheck" Width="13" Height="13" Foreground="#0369A1" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding ActiveModelDisplayName}" FontSize="11" FontWeight="SemiBold" Foreground="#0369A1" VerticalAlignment="Center" />
                                    <TextBlock Text="• Free / Cloud" FontSize="10.5" FontWeight="Medium" Foreground="#0284C7" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>

                            <!-- 3. Paid Cloud API Badge -->
                            <Border Background="#EDE9FE"
                                    BorderBrush="#C4B5FD"
                                    BorderThickness="1"
                                    CornerRadius="5"
                                    Padding="7,2"
                                    VerticalAlignment="Center"
                                    IsVisible="{Binding IsActiveModelPaidCloud}">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <materialIcons:MaterialIcon Kind="CloudOutline" Width="13" Height="13" Foreground="#6D28D9" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding ActiveModelDisplayName}" FontSize="11" FontWeight="SemiBold" Foreground="#6D28D9" VerticalAlignment="Center" />
                                    <TextBlock Text="• Paid / Cloud" FontSize="10.5" FontWeight="Medium" Foreground="#5B21B6" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <TextBlock Text="Powered by Microsoft.Extensions.AI — generate headings, shapes, tables, cards, and badges directly on your document canvas."
                                   FontSize="11.5" Foreground="{DynamicResource WinMutedBrush}" />
                    </StackPanel>

                    <!-- Actions: Settings & Close -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <Button Classes="mini-tool-btn" Width="30" Height="30"
                                Command="{Binding OpenSettingsCommand}"
                                ToolTip.Tip="Configure AI Providers, Ollama Endpoint &amp; Models">
                            <materialIcons:MaterialIcon Kind="CogOutline" Width="16" Height="16" Foreground="{DynamicResource WinMutedBrush}" />
                        </Button>
                        <Button Classes="mini-tool-btn" Width="30" Height="30"
                                Command="{Binding CloseCommand}"
                                ToolTip.Tip="Close Assistant (Esc)">
                            <materialIcons:MaterialIcon Kind="Close" Width="16" Height="16" Foreground="{DynamicResource WinMutedBrush}" />
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- 2. Target Element & Mode Switcher (Visible when an element is selected) -->
                <Border Grid.Row="1" Background="{DynamicResource WinBgBrush}" BorderBrush="#C4B5FD" BorderThickness="1.5" CornerRadius="10" Padding="12,8" Margin="0,0,0,10"
                        IsVisible="{Binding HasTargetElement}">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" VerticalAlignment="Center">
                        <!-- Target Element Badge -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Border Background="#EDE9FE" CornerRadius="6" Padding="6,4">
                                <materialIcons:MaterialIcon Kind="{Binding TargetElementKindIcon}" Width="16" Height="16" Foreground="#7C3AED" />
                            </Border>
                            <StackPanel Spacing="1" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <TextBlock Text="Target:" FontSize="10" Foreground="{DynamicResource WinMutedBrush}" FontWeight="Medium" />
                                    <TextBlock Text="{Binding TargetElementKindBadge}" FontSize="11" FontWeight="Bold" Foreground="#7C3AED" />
                                </StackPanel>
                                <TextBlock Text="{Binding TargetElementTitle}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource WinTextBrush}" MaxWidth="280" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Segmented Mode Switcher -->
                        <Border Grid.Column="2" Background="{DynamicResource WinInputBgBrush}" BorderBrush="{DynamicResource WinBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="2">
                            <StackPanel Orientation="Horizontal" Spacing="2">
                                <Button Classes="mini-tool-btn" Height="24" Padding="8,2" CornerRadius="4"
                                        Command="{Binding SwitchToModifyModeCommand}"
                                        Classes.active="{Binding IsModifyMode}">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <materialIcons:MaterialIcon Kind="AutoFixHigh" Width="12" Height="12" Foreground="#7C3AED" />
                                        <TextBlock Text="Modify Selected" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource WinTextBrush}" />
                                    </StackPanel>
                                </Button>
                                <Button Classes="mini-tool-btn" Height="24" Padding="8,2" CornerRadius="4"
                                        Command="{Binding SwitchToCreateModeCommand}"
                                        Classes.active="{Binding !IsModifyMode}">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <materialIcons:MaterialIcon Kind="PlusBoxOutline" Width="12" Height="12" Foreground="{DynamicResource WinMutedBrush}" />
                                        <TextBlock Text="Create New" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource WinTextBrush}" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- 2b. Dynamic Prompt Suggestion Pills -->
                <Border Grid.Row="2" Background="{DynamicResource WinBgBrush}" BorderBrush="{DynamicResource WinBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,0,0,14">
                    <StackPanel Spacing="8">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <materialIcons:MaterialIcon Kind="LightbulbOutline" Width="14" Height="14" Foreground="#D97706" VerticalAlignment="Center" />
                                <TextBlock Text="Quick Prompts (Click to populate)" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource WinTextBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="AI Context-Aware" FontSize="10" FontWeight="SemiBold" Foreground="#7C3AED" VerticalAlignment="Center" />
                        </Grid>

                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding SuggestedPrompts}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="6" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Classes="secondary-btn" Padding="8,5" CornerRadius="6" FontSize="11"
                                                Command="{Binding $parent[UserControl].((vm:AiAssistantViewModel)DataContext).UsePromptCommand}"
                                                CommandParameter="{Binding}"
                                                ToolTip.Tip="{Binding}">
                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                <materialIcons:MaterialIcon Kind="Sparkles" Width="12" Height="12" Foreground="#7C3AED" />
                                                <TextBlock Text="{Binding}" MaxWidth="260" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>

                <!-- 3. Prompt Input Box & Generation Action -->
                <StackPanel Grid.Row="3" Spacing="10" Margin="0,0,0,14">
                    <TextBox Text="{Binding PromptText, Mode=TwoWay}"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             Height="75"
                             CornerRadius="{StaticResource M3ShapeCornerMedium}"
                             Padding="12,10"
                             FontSize="12.5"
                             PlaceholderText="Tell AI what changes to make (e.g. 'Convert to line chart with emerald palette and add 2027 projection')..." />

                    <!-- Action Row: Status / Progress + Generate Button -->
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10" VerticalAlignment="Center">
                        <!-- Status Indicator -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <ProgressBar IsIndeterminate="{Binding IsGenerating}"
                                         IsVisible="{Binding IsGenerating}"
                                         Width="70" Height="4"
                                         VerticalAlignment="Center" />
                            <TextBlock Text="{Binding StatusMessage}"
                                       FontSize="11.5"
                                       Foreground="{DynamicResource WinMutedBrush}"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <!-- Cancel Button (visible when generating) -->
                        <Button Grid.Column="1"
                                Command="{Binding CancelGenerationCommand}"
                                IsVisible="{Binding IsGenerating}"
                                Background="{DynamicResource WinHoverBrush}"
                                Foreground="{DynamicResource WinTextBrush}"
                                BorderBrush="{DynamicResource WinBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource M3ShapeCornerFull}"
                                Padding="14,8"
                                FontSize="12"
                                FontWeight="SemiBold">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <materialIcons:MaterialIcon Kind="CloseCircleOutline" Width="14" Height="14" Foreground="#DC2626" />
                                <TextBlock Text="Cancel" />
                            </StackPanel>
                        </Button>

                        <!-- Generate / Modify Action Button -->
                        <Button Grid.Column="2"
                                Command="{Binding GenerateCommand}"
                                IsEnabled="{Binding !IsGenerating}"
                                Background="#7C3AED"
                                Foreground="White"
                                BorderThickness="0"
                                CornerRadius="{StaticResource M3ShapeCornerFull}"
                                Padding="18,9"
                                FontSize="12.5"
                                FontWeight="Bold"
                                Cursor="Hand">
                            <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                                <materialIcons:MaterialIcon Kind="AutoFixHigh" Width="16" Height="16" Foreground="White" />
                                <TextBlock Text="Modify with AI" IsVisible="{Binding IsModifyMode}" />
                                <TextBlock Text="Generate Elements" IsVisible="{Binding !IsModifyMode}" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>

                <!-- 4. Real-time Activity Logs & Execution History -->
                <Border Grid.Row="4" Background="{DynamicResource WinBgBrush}" BorderBrush="{DynamicResource WinBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12" MinHeight="140" MaxHeight="220">
                    <Grid RowDefinitions="Auto,*">
                        <TextBlock Grid.Row="0" Text="Agent Activity &amp; Tool Invocations" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource WinMutedBrush}" Margin="0,0,0,6" />
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding ActivityLogs}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}"
                                                   FontFamily="Consolas, Menlo, monospace"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource WinTextBrush}"
                                                   Margin="0,2" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- 5. Bottom Action Bar: Undo & Done -->
                <Grid Grid.Row="5" ColumnDefinitions="Auto,*,Auto" Margin="0,16,0,0" VerticalAlignment="Center">
                    <!-- 1-Click Undo Button -->
                    <Button Grid.Column="0"
                            Command="{Binding UndoGenerationCommand}"
                            IsEnabled="{Binding CanUndoLastGeneration}"
                            Background="{DynamicResource WinHoverBrush}"
                            BorderBrush="{DynamicResource WinBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource M3ShapeCornerFull}"
                            Padding="14,8"
                            FontSize="12"
                            FontWeight="SemiBold"
                            ToolTip.Tip="Revert elements added during the last AI generation">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <materialIcons:MaterialIcon Kind="Undo" Width="15" Height="15" Foreground="#0F6CBD" />
                            <TextBlock Text="Revert AI Changes" />
                        </StackPanel>
                    </Button>

                    <!-- Summary message -->
                    <TextBlock Grid.Column="1"
                               Text="{Binding LastGenerationSummary}"
                               FontSize="11.5"
                               Foreground="#15803D"
                               FontWeight="Medium"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Margin="12,0" />

                    <!-- Close Button -->
                    <Button Grid.Column="2"
                            Command="{Binding CloseCommand}"
                            Background="{DynamicResource WinPanelBrush}"
                            BorderBrush="{DynamicResource WinBorderBrush}"
                            BorderThickness="1"
                            Foreground="{DynamicResource WinTextBrush}"
                            CornerRadius="{StaticResource M3ShapeCornerFull}"
                            Padding="18,8"
                            FontSize="12"
                            FontWeight="SemiBold">
                        <TextBlock Text="Done" />
                    </Button>
                </Grid>

            </Grid>
        </Border>
    </Grid>

</UserControl>
