<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PdfEditorApp.ViewModels"
             xmlns:converters="using:PdfEditorApp.Converters"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:coreModels="clr-namespace:PdfEditorApp.Core.Models;assembly=PdfEditorApp.Core"
             x:Class="PdfEditorApp.Views.SettingsPageView"
             x:DataType="vm:SettingsViewModel">

    <UserControl.Resources>
        <converters:EqualityToBooleanConverter x:Key="EqualityConverter" />
        <converters:BooleanToStringConverter x:Key="BooleanToStringConverter" />
    </UserControl.Resources>

    <UserControl.Styles>
        <!-- Segmented Option Button Style (Pill shape) -->
        <Style Selector="Button.setting-segment-btn">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource M3OnSurfaceVariantBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource M3OutlineVariantBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource M3ShapeCornerFull}" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15" />
                    <BrushTransition Property="Foreground" Duration="0:0:0.15" />
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.setting-segment-btn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource M3SurfaceContainerHighBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource M3OnSurfaceBrush}" />
        </Style>
        <Style Selector="Button.setting-segment-btn.active /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource M3SecondaryContainerBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource M3OnSecondaryContainerBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource M3PrimaryBrush}" />
        </Style>
        <Style Selector="Button.setting-segment-btn.active">
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <!-- Category Nav Pill Button Style -->
        <Style Selector="Button.setting-nav-pill">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource M3OnSurfaceVariantBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="{StaticResource M3ShapeCornerFull}" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15" />
                    <BrushTransition Property="Foreground" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.setting-nav-pill:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource M3SurfaceContainerHighBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource M3OnSurfaceBrush}" />
        </Style>
        <Style Selector="Button.setting-nav-pill.active /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource M3SecondaryContainerBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource M3OnSecondaryContainerBrush}" />
        </Style>
        <Style Selector="Button.setting-nav-pill.active">
            <Setter Property="FontWeight" Value="Bold" />
        </Style>

        <!-- Setting Card Style (M3 Elevated) -->
        <Style Selector="Border.setting-card">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Background" Value="{DynamicResource M3SurfaceContainerLowBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource M3OutlineVariantBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource M3ShapeCornerLarge}" />
            <Setter Property="Padding" Value="24,20" />
            <Setter Property="BoxShadow" Value="{StaticResource M3ElevationLevel1}" />
            <Setter Property="Margin" Value="0,0,0,18" />
        </Style>

        <!-- Preset Chip Style -->
        <Style Selector="Button.setting-preset-chip">
            <Setter Property="Background" Value="{DynamicResource M3SurfaceContainerHighBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource M3OnSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource M3OutlineVariantBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource M3ShapeCornerFull}" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15" />
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.setting-preset-chip:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource M3SurfaceContainerHighestBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource M3PrimaryBrush}" />
        </Style>
    </UserControl.Styles>

    <StackPanel Margin="32,24,32,48" HorizontalAlignment="Stretch">

        <!-- ========================================== -->
        <!-- 1. HERO HEADER BANNER                      -->
        <!-- ========================================== -->
        <Border Classes="setting-card" Padding="24,20">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="18">
                <Border Grid.Column="0" Width="48" Height="48"
                        Background="{DynamicResource M3PrimaryContainerBrush}"
                        CornerRadius="14" VerticalAlignment="Center">
                    <materialIcons:MaterialIcon Kind="TuneVariant" Width="26" Height="26"
                                                Foreground="{DynamicResource M3OnPrimaryContainerBrush}"
                                                HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="Settings &amp; Preferences" FontSize="19" FontWeight="Bold"
                                   Foreground="{DynamicResource M3OnSurfaceBrush}" />
                        <Border Background="{DynamicResource M3SecondaryContainerBrush}"
                                CornerRadius="{StaticResource M3ShapeCornerSmall}"
                                Padding="6,1.5" VerticalAlignment="Center">
                            <TextBlock Text="Studio Preferences" FontSize="10" FontWeight="Bold"
                                       Foreground="{DynamicResource M3OnSecondaryContainerBrush}" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Personalize studio theme, document canvas defaults, notification behavior, AI engines, and system storage."
                               FontSize="12.5" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" TextWrapping="Wrap" />
                </StackPanel>
                <Button Grid.Column="2"
                        Command="{Binding ResetAllDefaultsCommand}"
                        Classes="m3-tonal-btn"
                        CornerRadius="{StaticResource M3ShapeCornerFull}"
                        Padding="14,8"
                        VerticalAlignment="Center"
                        ToolTip.Tip="Reset all interface preferences to factory default values">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <materialIcons:MaterialIcon Kind="Restore" Width="15" Height="15"
                                                    Foreground="{DynamicResource M3OnSurfaceVariantBrush}"
                                                    VerticalAlignment="Center" />
                        <TextBlock Text="Restore Defaults" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- ========================================== -->
        <!-- 2. SEARCH & CATEGORY NAVIGATION BAR        -->
        <!-- ========================================== -->
        <Border Margin="0,0,0,18">
            <StackPanel Spacing="12">
                <!-- Search Box (Full Pill) -->
                <Grid ColumnDefinitions="*,Auto">
                    <TextBox Grid.Column="0"
                             Classes="m3-search"
                             Text="{Binding SearchQuery, Mode=TwoWay}"
                             PlaceholderText="Search preferences (e.g., dark mode, grid, snap, ollama, notifications)...">
                        <TextBox.InnerLeftContent>
                            <materialIcons:MaterialIcon Kind="Magnify" Width="18" Height="18"
                                                        Foreground="{DynamicResource M3OnSurfaceVariantBrush}"
                                                        Margin="12,0,4,0" VerticalAlignment="Center" />
                        </TextBox.InnerLeftContent>
                        <TextBox.InnerRightContent>
                            <Button Command="{Binding ClearSearchCommand}"
                                    IsVisible="{Binding HasSearchQuery}"
                                    Classes="m3-icon-btn" Width="28" Height="28" Margin="0,0,6,0"
                                    ToolTip.Tip="Clear search">
                                <materialIcons:MaterialIcon Kind="CloseCircle" Width="16" Height="16" />
                            </Button>
                        </TextBox.InnerRightContent>
                    </TextBox>
                </Grid>

                <!-- Category Segmented Navigation Capsule -->
                <Border Classes="m3-segmented-container" HorizontalAlignment="Left">
                    <WrapPanel Orientation="Horizontal">
                        <Button Classes="setting-nav-pill"
                                Classes.active="{Binding SelectedCategory, Converter={StaticResource EqualityConverter}, ConverterParameter=All}"
                                Command="{Binding SelectCategoryCommand}" CommandParameter="All">
                            <TextBlock Text="All Settings" />
                        </Button>
                        <Button Classes="setting-nav-pill"
                                Classes.active="{Binding SelectedCategory, Converter={StaticResource EqualityConverter}, ConverterParameter=Appearance}"
                                Command="{Binding SelectCategoryCommand}" CommandParameter="Appearance">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <materialIcons:MaterialIcon Kind="PaletteOutline" Width="15" Height="15" />
                                <TextBlock Text="Appearance" />
                            </StackPanel>
                        </Button>
                        <Button Classes="setting-nav-pill"
                                Classes.active="{Binding SelectedCategory, Converter={StaticResource EqualityConverter}, ConverterParameter=Canvas}"
                                Command="{Binding SelectCategoryCommand}" CommandParameter="Canvas">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <materialIcons:MaterialIcon Kind="Grid" Width="15" Height="15" />
                                <TextBlock Text="Canvas &amp; Editor" />
                            </StackPanel>
                        </Button>
                        <Button Classes="setting-nav-pill"
                                Classes.active="{Binding SelectedCategory, Converter={StaticResource EqualityConverter}, ConverterParameter=Notifications}"
                                Command="{Binding SelectCategoryCommand}" CommandParameter="Notifications">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <materialIcons:MaterialIcon Kind="BellRingOutline" Width="15" Height="15" />
                                <TextBlock Text="Notifications" />
                            </StackPanel>
                        </Button>
                        <Button Classes="setting-nav-pill"
                                Classes.active="{Binding SelectedCategory, Converter={StaticResource EqualityConverter}, ConverterParameter=Ai}"
                                Command="{Binding SelectCategoryCommand}" CommandParameter="Ai">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <materialIcons:MaterialIcon Kind="AutoFixHigh" Width="15" Height="15" />
                                <TextBlock Text="AI Studio" />
                            </StackPanel>
                        </Button>
                        <Button Classes="setting-nav-pill"
                                Classes.active="{Binding SelectedCategory, Converter={StaticResource EqualityConverter}, ConverterParameter=Privacy}"
                                Command="{Binding SelectCategoryCommand}" CommandParameter="Privacy">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <materialIcons:MaterialIcon Kind="ShieldCheckOutline" Width="15" Height="15" />
                                <TextBlock Text="Privacy &amp; Storage" />
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- ========================================== -->
        <!-- EMPTY STATE (WHEN NO SEARCH MATCHES)       -->
        <!-- ========================================== -->
        <Border Classes="setting-card" IsVisible="{Binding !HasSearchResults}" Padding="32,28">
            <StackPanel HorizontalAlignment="Center" Spacing="12">
                <materialIcons:MaterialIcon Kind="MagnifyClose" Width="44" Height="44"
                                            Foreground="{DynamicResource M3OnSurfaceVariantBrush}"
                                            HorizontalAlignment="Center" />
                <TextBlock Text="No matching preferences found" FontSize="15" FontWeight="Bold"
                           Foreground="{DynamicResource M3OnSurfaceBrush}" HorizontalAlignment="Center" />
                <TextBlock Text="Try searching for 'theme', 'grid', 'snap', 'ollama', 'sound', or 'notifications'."
                           FontSize="12" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" HorizontalAlignment="Center" />
                <Button Command="{Binding ClearSearchCommand}" Classes="m3-tonal-btn"
                        HorizontalAlignment="Center" Margin="0,4,0,0">
                    <TextBlock Text="Clear Search Filter" />
                </Button>
            </StackPanel>
        </Border>

        <!-- ========================================== -->
        <!-- 3. APPEARANCE & THEME CARD                 -->
        <!-- ========================================== -->
        <Border Classes="setting-card" IsVisible="{Binding IsAppearanceVisible}">
            <StackPanel Spacing="16">
                <!-- Section Header -->
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                    <Border Grid.Column="0" Width="38" Height="38"
                            Background="{DynamicResource M3SecondaryContainerBrush}"
                            CornerRadius="10" VerticalAlignment="Center">
                        <materialIcons:MaterialIcon Kind="PaletteOutline" Width="20" Height="20"
                                                    Foreground="{DynamicResource M3OnSecondaryContainerBrush}"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="Appearance &amp; Themes" FontSize="14.5" FontWeight="Bold"
                                   Foreground="{DynamicResource M3OnSurfaceBrush}" />
                        <TextBlock Text="Customize application color scheme, reader themes, and interface density."
                                   FontSize="11.5" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                    </StackPanel>
                </Grid>

                <Separator Height="1" Background="{DynamicResource M3OutlineVariantBrush}" Opacity="0.5" />

                <!-- Row 1: Studio Theme -->
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16" MinHeight="44">
                    <Border Grid.Column="0" Width="36" Height="36" CornerRadius="10"
                            Background="{DynamicResource M3SurfaceContainerHighBrush}" VerticalAlignment="Center">
                        <materialIcons:MaterialIcon Kind="WeatherSunny" Width="18" Height="18"
                                                    Foreground="{DynamicResource M3PrimaryBrush}"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="Application Color Theme" FontSize="13.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource M3OnSurfaceBrush}" />
                        <TextBlock Text="Choose light, dark, or automatically follow your operating system appearance."
                                   FontSize="11.5" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                    <Border Grid.Column="2" Classes="m3-segmented-container" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="2">
                            <Button Classes="setting-segment-btn"
                                    Classes.active="{Binding ThemeMode, Converter={StaticResource EqualityConverter}, ConverterParameter=Light}"
                                    Command="{Binding SetThemeModeCommand}" CommandParameter="Light">
                                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                    <materialIcons:MaterialIcon Kind="WeatherSunny" Width="14" Height="14" Foreground="#F59E0B" />
                                    <TextBlock Text="Light" />
                                </StackPanel>
                            </Button>
                            <Button Classes="setting-segment-btn"
                                    Classes.active="{Binding ThemeMode, Converter={StaticResource EqualityConverter}, ConverterParameter=Dark}"
                                    Command="{Binding SetThemeModeCommand}" CommandParameter="Dark">
                                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                    <materialIcons:MaterialIcon Kind="WeatherNight" Width="14" Height="14" Foreground="#818CF8" />
                                    <TextBlock Text="Dark" />
                                </StackPanel>
                            </Button>
                            <Button Classes="setting-segment-btn"
                                    Classes.active="{Binding ThemeMode, Converter={StaticResource EqualityConverter}, ConverterParameter=System}"
                                    Command="{Binding SetThemeModeCommand}" CommandParameter="System">
                                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                    <materialIcons:MaterialIcon Kind="Laptop" Width="14" Height="14" />
                                    <TextBlock Text="System" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>

                <Separator Height="1" Background="{DynamicResource M3OutlineVariantBrush}" Opacity="0.5" />

                <!-- Row 2: PDF Reader Theme -->
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16" MinHeight="44">
                    <Border Grid.Column="0" Width="36" Height="36" CornerRadius="10"
                            Background="{DynamicResource M3SurfaceContainerHighBrush}" VerticalAlignment="Center">
                        <materialIcons:MaterialIcon Kind="BookOpenPageVariantOutline" Width="18" Height="18"
                                                    Foreground="{DynamicResource M3PrimaryBrush}"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="PDF Reader Mode Theme" FontSize="13.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource M3OnSurfaceBrush}" />
                        <TextBlock Text="Background paper tint applied to document pages during reading and presentation."
                                   FontSize="11.5" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                    <Border Grid.Column="2" Classes="m3-segmented-container" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="2">
                            <Button Classes="setting-segment-btn"
                                    Classes.active="{Binding ReadingTheme, Converter={StaticResource EqualityConverter}, ConverterParameter=Default}"
                                    Command="{Binding SetReadingThemeCommand}" CommandParameter="Default">
                                <TextBlock Text="Studio" />
                            </Button>
                            <Button Classes="setting-segment-btn"
                                    Classes.active="{Binding ReadingTheme, Converter={StaticResource EqualityConverter}, ConverterParameter=Sepia}"
                                    Command="{Binding SetReadingThemeCommand}" CommandParameter="Sepia">
                                <TextBlock Text="Sepia" />
                            </Button>
                            <Button Classes="setting-segment-btn"
                                    Classes.active="{Binding ReadingTheme, Converter={StaticResource EqualityConverter}, ConverterParameter=Dark}"
                                    Command="{Binding SetReadingThemeCommand}" CommandParameter="Dark">
                                <TextBlock Text="Night" />
                            </Button>
                            <Button Classes="setting-segment-btn"
                                    Classes.active="{Binding ReadingTheme, Converter={StaticResource EqualityConverter}, ConverterParameter=HighContrast}"
                                    Command="{Binding SetReadingThemeCommand}" CommandParameter="HighContrast">
                                <TextBlock Text="Contrast" />
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>

                <Separator Height="1" Background="{DynamicResource M3OutlineVariantBrush}" Opacity="0.5" />

                <!-- Row 3: Compact Ribbon Toolbar -->
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16" MinHeight="44">
                    <Border Grid.Column="0" Width="36" Height="36" CornerRadius="10"
                            Background="{DynamicResource M3SurfaceContainerHighBrush}" VerticalAlignment="Center">
                        <materialIcons:MaterialIcon Kind="ViewHeadline" Width="18" Height="18"
                                                    Foreground="{DynamicResource M3PrimaryBrush}"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="Compact Ribbon Toolbar" FontSize="13.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource M3OnSurfaceBrush}" />
                        <TextBlock Text="Reduce toolbar height to maximize document canvas viewport on smaller screens."
                                   FontSize="11.5" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="2"
                                  IsChecked="{Binding CompactRibbonByDefault, Mode=TwoWay}"
                                  OnContent="" OffContent=""
                                  VerticalAlignment="Center" Margin="0" />
                </Grid>

                <Separator Height="1" Background="{DynamicResource M3OutlineVariantBrush}" Opacity="0.5" />

                <!-- Row 4: Keyboard Shortcut Hints -->
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16" MinHeight="44">
                    <Border Grid.Column="0" Width="36" Height="36" CornerRadius="10"
                            Background="{DynamicResource M3SurfaceContainerHighBrush}" VerticalAlignment="Center">
                        <materialIcons:MaterialIcon Kind="KeyboardOutline" Width="18" Height="18"
                                                    Foreground="{DynamicResource M3PrimaryBrush}"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="Show Keyboard Shortcut Hints" FontSize="13.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource M3OnSurfaceBrush}" />
                        <TextBlock Text="Display keyboard shortcuts inside tooltips and context menus for rapid navigation."
                                   FontSize="11.5" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="2"
                                  IsChecked="{Binding ShowShortcutHints, Mode=TwoWay}"
                                  OnContent="" OffContent=""
                                  VerticalAlignment="Center" Margin="0" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- ========================================== -->
        <!-- 4. DOCUMENT CANVAS & EDITOR CARD           -->
        <!-- ========================================== -->
        <Border Classes="setting-card" IsVisible="{Binding IsCanvasVisible}">
            <StackPanel Spacing="16">
                <!-- Section Header -->
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                    <Border Grid.Column="0" Width="38" Height="38"
                            Background="{DynamicResource M3SecondaryContainerBrush}"
                            CornerRadius="10" VerticalAlignment="Center">
                        <materialIcons:MaterialIcon Kind="Grid" Width="20" Height="20"
                                                    Foreground="{DynamicResource M3OnSecondaryContainerBrush}"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="Document Canvas &amp; Grid Alignment" FontSize="14.5" FontWeight="Bold"
                                   Foreground="{DynamicResource M3OnSurfaceBrush}" />
                        <TextBlock Text="Configure layout grid guidelines, snapping behaviors, and default zoom levels."
                                   FontSize="11.5" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                    </StackPanel>
                </Grid>

                <Separator Height="1" Background="{DynamicResource M3OutlineVariantBrush}" Opacity="0.5" />

                <!-- Row 1: Show Grid Guidelines -->
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16" MinHeight="44">
                    <Border Grid.Column="0" Width="36" Height="36" CornerRadius="10"
                            Background="{DynamicResource M3SurfaceContainerHighBrush}" VerticalAlignment="Center">
                        <materialIcons:MaterialIcon Kind="GridLarge" Width="18" Height="18"
                                                    Foreground="{DynamicResource M3PrimaryBrush}"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="Show Canvas Alignment Grid" FontSize="13.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource M3OnSurfaceBrush}" />
                        <TextBlock Text="Display background guideline grid dots across document pages by default."
                                   FontSize="11.5" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="2"
                                  IsChecked="{Binding ShowGridByDefault, Mode=TwoWay}"
                                  OnContent="" OffContent=""
                                  VerticalAlignment="Center" Margin="0" />
                </Grid>

                <Separator Height="1" Background="{DynamicResource M3OutlineVariantBrush}" Opacity="0.5" />

                <!-- Row 2: Snap to Grid -->
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16" MinHeight="44">
                    <Border Grid.Column="0" Width="36" Height="36" CornerRadius="10"
                            Background="{DynamicResource M3SurfaceContainerHighBrush}" VerticalAlignment="Center">
                        <materialIcons:MaterialIcon Kind="Magnet" Width="18" Height="18"
                                                    Foreground="{DynamicResource M3PrimaryBrush}"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="Snap Objects to Grid" FontSize="13.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource M3OnSurfaceBrush}" />
                        <TextBlock Text="Automatically align shapes, text blocks, and images to nearest grid points during drag."
                                   FontSize="11.5" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="2"
                                  IsChecked="{Binding SnapToGridByDefault, Mode=TwoWay}"
                                  OnContent="" OffContent=""
                                  VerticalAlignment="Center" Margin="0" />
                </Grid>

                <Separator Height="1" Background="{DynamicResource M3OutlineVariantBrush}" Opacity="0.5" />

                <!-- Row 3: Grid Snap Spacing -->
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16" MinHeight="44">
                    <Border Grid.Column="0" Width="36" Height="36" CornerRadius="10"
                            Background="{DynamicResource M3SurfaceContainerHighBrush}" VerticalAlignment="Center">
                        <materialIcons:MaterialIcon Kind="Ruler" Width="18" Height="18"
                                                    Foreground="{DynamicResource M3PrimaryBrush}"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="Grid Snap Spacing" FontSize="13.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource M3OnSurfaceBrush}" />
                        <TextBlock Text="Distance between alignment snap intervals across the canvas."
                                   FontSize="11.5" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                    <Border Grid.Column="2" Classes="m3-segmented-container" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="2">
                            <Button Classes="setting-segment-btn"
                                    Classes.active="{Binding GridSnapSize, Converter={StaticResource EqualityConverter}, ConverterParameter=Points10}"
                                    Command="{Binding SetGridSnapSizeCommand}" CommandParameter="Points10">
                                <TextBlock Text="10 pt" />
                            </Button>
                            <Button Classes="setting-segment-btn"
                                    Classes.active="{Binding GridSnapSize, Converter={StaticResource EqualityConverter}, ConverterParameter=Points20}"
                                    Command="{Binding SetGridSnapSizeCommand}" CommandParameter="Points20">
                                <TextBlock Text="20 pt (Default)" />
                            </Button>
                            <Button Classes="setting-segment-btn"
                                    Classes.active="{Binding GridSnapSize, Converter={StaticResource EqualityConverter}, ConverterParameter=Points40}"
                                    Command="{Binding SetGridSnapSizeCommand}" CommandParameter="Points40">
                                <TextBlock Text="40 pt" />
                            </Button>
                            <Button Classes="setting-segment-btn"
                                    Classes.active="{Binding GridSnapSize, Converter={StaticResource EqualityConverter}, ConverterParameter=Points50}"
                                    Command="{Binding SetGridSnapSizeCommand}" CommandParameter="Points50">
                                <TextBlock Text="50 pt" />
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>

                <Separator Height="1" Background="{DynamicResource M3OutlineVariantBrush}" Opacity="0.5" />

                <!-- Row 4: Default Document Zoom -->
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16" MinHeight="44">
                    <Border Grid.Column="0" Width="36" Height="36" CornerRadius="10"
                            Background="{DynamicResource M3SurfaceContainerHighBrush}" VerticalAlignment="Center">
                        <materialIcons:MaterialIcon Kind="ArrowExpandHorizontal" Width="18" Height="18"
                                                    Foreground="{DynamicResource M3PrimaryBrush}"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="Default Document Zoom Mode" FontSize="13.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource M3OnSurfaceBrush}" />
                        <TextBlock Text="Initial canvas zoom ratio applied upon opening documents or templates."
                                   FontSize="11.5" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                    <Border Grid.Column="2" Classes="m3-segmented-container" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="2">
                            <Button Classes="setting-segment-btn"
                                    Classes.active="{Binding DefaultZoomMode, Converter={StaticResource EqualityConverter}, ConverterParameter=FitWidth}"
                                    Command="{Binding SetDefaultZoomModeCommand}" CommandParameter="FitWidth">
                                <TextBlock Text="Fit Width (Default)" />
                            </Button>
                            <Button Classes="setting-segment-btn"
                                    Classes.active="{Binding DefaultZoomMode, Converter={StaticResource EqualityConverter}, ConverterParameter=FitPage}"
                                    Command="{Binding SetDefaultZoomModeCommand}" CommandParameter="FitPage">
                                <TextBlock Text="Fit Page" />
                            </Button>
                            <Button Classes="setting-segment-btn"
                                    Classes.active="{Binding DefaultZoomMode, Converter={StaticResource EqualityConverter}, ConverterParameter=Custom}"
                                    Command="{Binding SetDefaultZoomModeCommand}" CommandParameter="Custom">
                                <TextBlock Text="100% Actual" />
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>

                <Separator Height="1" Background="{DynamicResource M3OutlineVariantBrush}" Opacity="0.5" />

                <!-- Row 5: Auto-Expand Inspector -->
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16" MinHeight="44">
                    <Border Grid.Column="0" Width="36" Height="36" CornerRadius="10"
                            Background="{DynamicResource M3SurfaceContainerHighBrush}" VerticalAlignment="Center">
                        <materialIcons:MaterialIcon Kind="DockRight" Width="18" Height="18"
                                                    Foreground="{DynamicResource M3PrimaryBrush}"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="Auto-Expand Inspector Sidebar" FontSize="13.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource M3OnSurfaceBrush}" />
                        <TextBlock Text="Automatically expand the property inspector panel when any canvas element is clicked."
                                   FontSize="11.5" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="2"
                                  IsChecked="{Binding AutoExpandInspectorOnSelect, Mode=TwoWay}"
                                  OnContent="" OffContent=""
                                  VerticalAlignment="Center" Margin="0" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- ========================================== -->
        <!-- 5. NOTIFICATIONS & SNACKBARS CARD          -->
        <!-- ========================================== -->
        <Border Classes="setting-card" IsVisible="{Binding IsNotificationsVisible}">
            <StackPanel Spacing="16">
                <!-- Section Header -->
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                    <Border Grid.Column="0" Width="38" Height="38"
                            Background="{DynamicResource M3SecondaryContainerBrush}"
                            CornerRadius="10" VerticalAlignment="Center">
                        <materialIcons:MaterialIcon Kind="BellRingOutline" Width="20" Height="20"
                                                    Foreground="{DynamicResource M3OnSecondaryContainerBrush}"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="Notification &amp; Snackbar System" FontSize="14.5" FontWeight="Bold"
                                   Foreground="{DynamicResource M3OnSurfaceBrush}" />
                        <TextBlock Text="Choose where on-screen action toasts appear and configure their visual styles."
                                   FontSize="11.5" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                    </StackPanel>
                </Grid>

                <Separator Height="1" Background="{DynamicResource M3OutlineVariantBrush}" Opacity="0.5" />

                <!-- Row 1: Position Placement Matrix -->
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20" MinHeight="80">
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="3">
                        <TextBlock Text="On-Screen Toast Placement" FontSize="13.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource M3OnSurfaceBrush}" />
                        <TextBlock Text="Select which corner or edge of the FryPDF studio window displays feedback notifications."
                                   FontSize="11.5" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" TextWrapping="Wrap" />
                        <Border Background="{DynamicResource M3SurfaceContainerHighBrush}"
                                CornerRadius="{StaticResource M3ShapeCornerSmall}"
                                Padding="8,4" HorizontalAlignment="Left" Margin="0,4,0,0">
                            <TextBlock Text="{Binding ToastPosition, StringFormat='Active: {0}'}"
                                       FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource M3PrimaryBrush}" />
                        </Border>
                    </StackPanel>

                    <!-- Mini Window Placement Selector -->
                    <Border Grid.Column="1"
                            Background="{DynamicResource M3SurfaceContainerHighBrush}"
                            BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource M3ShapeCornerMedium}"
                            Padding="8"
                            VerticalAlignment="Center">
                        <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,Auto,Auto" RowSpacing="6" ColumnSpacing="6">
                            <!-- Top Left -->
                            <Button Grid.Row="0" Grid.Column="0" Classes="setting-segment-btn" Width="104"
                                    Classes.active="{Binding ToastPosition, Converter={StaticResource EqualityConverter}, ConverterParameter=TopLeft}"
                                    Command="{Binding SetToastPositionCommand}" CommandParameter="TopLeft" ToolTip.Tip="Top Left">
                                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                    <materialIcons:MaterialIcon Kind="DockTop" Width="14" Height="14" />
                                    <TextBlock Text="Top Left" FontSize="11" />
                                </StackPanel>
                            </Button>
                            <!-- Top Center -->
                            <Button Grid.Row="0" Grid.Column="1" Classes="setting-segment-btn" Width="104"
                                    Classes.active="{Binding ToastPosition, Converter={StaticResource EqualityConverter}, ConverterParameter=TopCenter}"
                                    Command="{Binding SetToastPositionCommand}" CommandParameter="TopCenter" ToolTip.Tip="Top Center">
                                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                    <materialIcons:MaterialIcon Kind="FormatVerticalAlignTop" Width="14" Height="14" />
                                    <TextBlock Text="Top Center" FontSize="11" />
                                </StackPanel>
                            </Button>
                            <!-- Top Right -->
                            <Button Grid.Row="0" Grid.Column="2" Classes="setting-segment-btn" Width="104"
                                    Classes.active="{Binding ToastPosition, Converter={StaticResource EqualityConverter}, ConverterParameter=TopRight}"
                                    Command="{Binding SetToastPositionCommand}" CommandParameter="TopRight" ToolTip.Tip="Top Right">
                                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                    <materialIcons:MaterialIcon Kind="DockTop" Width="14" Height="14" />
                                    <TextBlock Text="Top Right" FontSize="11" />
                                </StackPanel>
                            </Button>
                            <!-- Bottom Left -->
                            <Button Grid.Row="1" Grid.Column="0" Classes="setting-segment-btn" Width="104"
                                    Classes.active="{Binding ToastPosition, Converter={StaticResource EqualityConverter}, ConverterParameter=BottomLeft}"
                                    Command="{Binding SetToastPositionCommand}" CommandParameter="BottomLeft" ToolTip.Tip="Bottom Left">
                                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                    <materialIcons:MaterialIcon Kind="DockBottom" Width="14" Height="14" />
                                    <TextBlock Text="Bottom Left" FontSize="11" />
                                </StackPanel>
                            </Button>
                            <!-- Bottom Center (Default) -->
                            <Button Grid.Row="1" Grid.Column="1" Classes="setting-segment-btn" Width="104"
                                    Classes.active="{Binding ToastPosition, Converter={StaticResource EqualityConverter}, ConverterParameter=BottomCenter}"
                                    Command="{Binding SetToastPositionCommand}" CommandParameter="BottomCenter" ToolTip.Tip="Bottom Center (Default)">
                                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                    <materialIcons:MaterialIcon Kind="FormatVerticalAlignBottom" Width="14" Height="14" />
                                    <TextBlock Text="Bottom Center" FontSize="11" />
                                </StackPanel>
                            </Button>
                            <!-- Bottom Right -->
                            <Button Grid.Row="1" Grid.Column="2" Classes="setting-segment-btn" Width="104"
                                    Classes.active="{Binding ToastPosition, Converter={StaticResource EqualityConverter}, ConverterParameter=BottomRight}"
                                    Command="{Binding SetToastPositionCommand}" CommandParameter="BottomRight" ToolTip.Tip="Bottom Right">
                                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                    <materialIcons:MaterialIcon Kind="DockBottom" Width="14" Height="14" />
                                    <TextBlock Text="Bottom Right" FontSize="11" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>
                </Grid>

                <Separator Height="1" Background="{DynamicResource M3OutlineVariantBrush}" Opacity="0.5" />

                <!-- Row 2: Visual Style Variant -->
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16" MinHeight="44">
                    <Border Grid.Column="0" Width="36" Height="36" CornerRadius="10"
                            Background="{DynamicResource M3SurfaceContainerHighBrush}" VerticalAlignment="Center">
                        <materialIcons:MaterialIcon Kind="PaletteOutline" Width="18" Height="18"
                                                    Foreground="{DynamicResource M3PrimaryBrush}"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="Visual Style &amp; Tint Variant" FontSize="13.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource M3OnSurfaceBrush}" />
                        <TextBlock Text="Card fill density: high-contrast solid fill, pastel soft tint, or auto-adapting to dark theme."
                                   FontSize="11.5" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                    <Border Grid.Column="2" Classes="m3-segmented-container" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="2">
                            <Button Classes="setting-segment-btn"
                                    Classes.active="{Binding ToastStyleVariant, Converter={StaticResource EqualityConverter}, ConverterParameter=Solid}"
                                    Command="{Binding SetToastStyleVariantCommand}" CommandParameter="Solid">
                                <TextBlock Text="Solid / Filled" />
                            </Button>
                            <Button Classes="setting-segment-btn"
                                    Classes.active="{Binding ToastStyleVariant, Converter={StaticResource EqualityConverter}, ConverterParameter=Subtle}"
                                    Command="{Binding SetToastStyleVariantCommand}" CommandParameter="Subtle">
                                <TextBlock Text="Subtle / Tint" />
                            </Button>
                            <Button Classes="setting-segment-btn"
                                    Classes.active="{Binding ToastStyleVariant, Converter={StaticResource EqualityConverter}, ConverterParameter=Auto}"
                                    Command="{Binding SetToastStyleVariantCommand}" CommandParameter="Auto">
                                <TextBlock Text="Theme Adaptive" />
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>

                <Separator Height="1" Background="{DynamicResource M3OutlineVariantBrush}" Opacity="0.5" />

                <!-- Row 3: Display Duration -->
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16" MinHeight="44">
                    <Border Grid.Column="0" Width="36" Height="36" CornerRadius="10"
                            Background="{DynamicResource M3SurfaceContainerHighBrush}" VerticalAlignment="Center">
                        <materialIcons:MaterialIcon Kind="ClockOutline" Width="18" Height="18"
                                                    Foreground="{DynamicResource M3PrimaryBrush}"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="Display Duration Timeout" FontSize="13.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource M3OnSurfaceBrush}" />
                        <TextBlock Text="How long notifications remain on screen before automatically fading out."
                                   FontSize="11.5" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                    <Border Grid.Column="2" Classes="m3-segmented-container" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="2">
                            <Button Classes="setting-segment-btn"
                                    Classes.active="{Binding ToastDurationMs, Converter={StaticResource EqualityConverter}, ConverterParameter=2000}"
                                    Command="{Binding SetToastDurationCommand}" CommandParameter="2000">
                                <TextBlock Text="2.0s Fast" />
                            </Button>
                            <Button Classes="setting-segment-btn"
                                    Classes.active="{Binding ToastDurationMs, Converter={StaticResource EqualityConverter}, ConverterParameter=3500}"
                                    Command="{Binding SetToastDurationCommand}" CommandParameter="3500">
                                <TextBlock Text="3.5s Default" />
                            </Button>
                            <Button Classes="setting-segment-btn"
                                    Classes.active="{Binding ToastDurationMs, Converter={StaticResource EqualityConverter}, ConverterParameter=6000}"
                                    Command="{Binding SetToastDurationCommand}" CommandParameter="6000">
                                <TextBlock Text="6.0s Extended" />
                            </Button>
                            <Button Classes="setting-segment-btn"
                                    Classes.active="{Binding ToastDurationMs, Converter={StaticResource EqualityConverter}, ConverterParameter=-1}"
                                    Command="{Binding SetToastDurationCommand}" CommandParameter="-1">
                                <TextBlock Text="Sticky (Manual)" />
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>

                <Separator Height="1" Background="{DynamicResource M3OutlineVariantBrush}" Opacity="0.5" />

                <!-- Row 4: Dismiss Close Button -->
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16" MinHeight="44">
                    <Border Grid.Column="0" Width="36" Height="36" CornerRadius="10"
                            Background="{DynamicResource M3SurfaceContainerHighBrush}" VerticalAlignment="Center">
                        <materialIcons:MaterialIcon Kind="CloseCircleOutline" Width="18" Height="18"
                                                    Foreground="{DynamicResource M3PrimaryBrush}"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="Show Dismiss Close Button ('X')" FontSize="13.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource M3OnSurfaceBrush}" />
                        <TextBlock Text="Display an explicit close button on each toast banner for instant dismissal."
                                   FontSize="11.5" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="2"
                                  IsChecked="{Binding ToastShowCloseButton, Mode=TwoWay}"
                                  OnContent="" OffContent=""
                                  VerticalAlignment="Center" Margin="0" />
                </Grid>

                <Separator Height="1" Background="{DynamicResource M3OutlineVariantBrush}" Opacity="0.5" />

                <!-- Row 5: Notification Sound -->
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16" MinHeight="44">
                    <Border Grid.Column="0" Width="36" Height="36" CornerRadius="10"
                            Background="{DynamicResource M3SurfaceContainerHighBrush}" VerticalAlignment="Center">
                        <materialIcons:MaterialIcon Kind="VolumeHigh" Width="18" Height="18"
                                                    Foreground="{DynamicResource M3PrimaryBrush}"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="Notification Audio Effects" FontSize="13.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource M3OnSurfaceBrush}" />
                        <TextBlock Text="Play subtle audio cues when action notifications and completed task toasts appear."
                                   FontSize="11.5" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="2"
                                  IsChecked="{Binding ToastSoundEnabled, Mode=TwoWay}"
                                  OnContent="" OffContent=""
                                  VerticalAlignment="Center" Margin="0" />
                </Grid>

                <Separator Height="1" Background="{DynamicResource M3OutlineVariantBrush}" Opacity="0.5" />

                <!-- Row 6: Interactive Live Test Playground -->
                <Border Background="{DynamicResource M3SurfaceContainerBrush}"
                        BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource M3ShapeCornerMedium}"
                        Padding="18,16">
                    <StackPanel Spacing="14">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <materialIcons:MaterialIcon Kind="PlayCircleOutline" Width="18" Height="18"
                                                            Foreground="{DynamicResource M3PrimaryBrush}"
                                                            VerticalAlignment="Center" />
                                <TextBlock Text="Interactive Toast Playground" FontSize="13" FontWeight="Bold"
                                           Foreground="{DynamicResource M3OnSurfaceBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="Click any badge to test live toast"
                                       FontSize="11" Foreground="{DynamicResource M3OnSurfaceVariantBrush}"
                                       VerticalAlignment="Center" />
                        </Grid>

                        <!-- Test Action Buttons -->
                        <Grid ColumnDefinitions="*,*,*,*,*" ColumnSpacing="8">
                            <Button Grid.Column="0" Command="{Binding TestPrimaryNotificationCommand}"
                                    Classes="m3-tonal-btn" Height="34" CornerRadius="{StaticResource M3ShapeCornerFull}">
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <materialIcons:MaterialIcon Kind="InformationOutline" Width="14" Height="14" Foreground="#0F6CBD" />
                                    <TextBlock Text="Primary" FontSize="11.5" FontWeight="SemiBold" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="1" Command="{Binding TestSuccessNotificationCommand}"
                                    Classes="m3-tonal-btn" Height="34" CornerRadius="{StaticResource M3ShapeCornerFull}">
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <materialIcons:MaterialIcon Kind="CheckCircleOutline" Width="14" Height="14" Foreground="#15803D" />
                                    <TextBlock Text="Success" FontSize="11.5" FontWeight="SemiBold" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="2" Command="{Binding TestWarningNotificationCommand}"
                                    Classes="m3-tonal-btn" Height="34" CornerRadius="{StaticResource M3ShapeCornerFull}">
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <materialIcons:MaterialIcon Kind="AlertOutline" Width="14" Height="14" Foreground="#D97706" />
                                    <TextBlock Text="Warning" FontSize="11.5" FontWeight="SemiBold" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="3" Command="{Binding TestDangerNotificationCommand}"
                                    Classes="m3-tonal-btn" Height="34" CornerRadius="{StaticResource M3ShapeCornerFull}">
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <materialIcons:MaterialIcon Kind="AlertOctagonOutline" Width="14" Height="14" Foreground="#DC2626" />
                                    <TextBlock Text="Danger" FontSize="11.5" FontWeight="SemiBold" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="4" Command="{Binding TestGeneralNotificationCommand}"
                                    Classes="m3-tonal-btn" Height="34" CornerRadius="{StaticResource M3ShapeCornerFull}">
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <materialIcons:MaterialIcon Kind="InformationOutline" Width="14" Height="14"
                                                                Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                                    <TextBlock Text="General" FontSize="11.5" FontWeight="SemiBold" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- Live Visual Preview of Current Selected Variant -->
                        <Border Background="{DynamicResource M3SurfaceContainerLowBrush}"
                                BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource M3ShapeCornerMedium}"
                                Padding="16,12">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="LIVE PREVIEW" FontSize="9.5" FontWeight="Bold"
                                               Foreground="{DynamicResource M3PrimaryBrush}" />
                                    <TextBlock Text="Selected Styling:" FontSize="11"
                                               Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                                </StackPanel>

                                <!-- Embedded Preview Toast Banner -->
                                <Border Grid.Column="1"
                                        Margin="16,0"
                                        Background="{Binding PreviewBackgroundBrush}"
                                        BorderBrush="{Binding PreviewBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{StaticResource M3ShapeCornerFull}"
                                        Padding="16,8"
                                        BoxShadow="{StaticResource M3ElevationLevel2}"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" VerticalAlignment="Center">
                                        <materialIcons:MaterialIcon Grid.Column="0"
                                                                    Kind="{Binding PreviewToastIcon}"
                                                                    Width="17" Height="17"
                                                                    Foreground="{Binding PreviewIconBrush}"
                                                                    VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding PreviewToastMessage}"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="{Binding PreviewForegroundBrush}"
                                                   VerticalAlignment="Center" />
                                        <Border Grid.Column="2"
                                                IsVisible="{Binding ToastShowCloseButton}"
                                                Background="Transparent"
                                                Padding="2"
                                                VerticalAlignment="Center">
                                            <materialIcons:MaterialIcon Kind="Close" Width="14" Height="14"
                                                                        Foreground="{Binding PreviewCloseBrush}" />
                                        </Border>
                                    </Grid>
                                </Border>

                                <Border Grid.Column="2"
                                        Background="{DynamicResource M3SurfaceContainerHighestBrush}"
                                        CornerRadius="{StaticResource M3ShapeCornerSmall}"
                                        Padding="8,4" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ToastPosition, StringFormat='At: {0}'}"
                                               FontSize="11" FontWeight="SemiBold"
                                               Foreground="{DynamicResource M3OnSurfaceBrush}" />
                                </Border>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- ========================================== -->
        <!-- 6. AI STUDIO & LOCAL LLM CARD              -->
        <!-- ========================================== -->
        <Border Classes="setting-card" IsVisible="{Binding IsAiVisible}">
            <StackPanel DataContext="{Binding AiSettings}" Spacing="16">
                <!-- Section Header -->
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                    <Border Grid.Column="0" Width="38" Height="38"
                            Background="{DynamicResource M3SecondaryContainerBrush}"
                            CornerRadius="10" VerticalAlignment="Center">
                        <materialIcons:MaterialIcon Kind="AutoFixHigh" Width="22" Height="22"
                                                    Foreground="{DynamicResource M3OnSecondaryContainerBrush}"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="AI Studio &amp; Local LLM Engine" FontSize="14.5" FontWeight="Bold"
                                       Foreground="{DynamicResource M3OnSurfaceBrush}" />
                            <Border Background="{DynamicResource M3SecondaryContainerBrush}"
                                    CornerRadius="{StaticResource M3ShapeCornerSmall}"
                                    Padding="6,1.5" VerticalAlignment="Center">
                                <TextBlock Text="Microsoft.Extensions.AI" FontSize="10" FontWeight="Bold"
                                           Foreground="{DynamicResource M3OnSecondaryContainerBrush}" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Configure local Ollama models (100% offline &amp; free) or cloud providers to generate canvas elements."
                                   FontSize="11.5" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                    </StackPanel>
                    <Border Grid.Column="2" Background="#DCFCE7" BorderBrush="#86EFAC" BorderThickness="1"
                            CornerRadius="{StaticResource M3ShapeCornerSmall}" Padding="8,3" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <materialIcons:MaterialIcon Kind="ShieldCheckOutline" Width="14" Height="14"
                                                        Foreground="#15803D" VerticalAlignment="Center" />
                            <TextBlock Text="Local LLM Ready" FontSize="10.5" FontWeight="Bold"
                                       Foreground="#15803D" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Separator Height="1" Background="{DynamicResource M3OutlineVariantBrush}" Opacity="0.5" />

                <!-- A. Provider Selector (Segmented Cards) -->
                <StackPanel Spacing="8">
                    <TextBlock Text="AI Model Provider" FontSize="12.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource M3OnSurfaceBrush}" />
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                        <!-- Ollama Local & Free Cloud -->
                        <Button Grid.Column="0" Classes="setting-segment-btn"
                                Classes.active="{Binding SelectedProvider, Converter={StaticResource EqualityConverter}, ConverterParameter=OllamaLocal}"
                                Command="{Binding SetProviderCommand}" CommandParameter="OllamaLocal">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <materialIcons:MaterialIcon Kind="ShieldCheckOutline" Width="16" Height="16" Foreground="#15803D" VerticalAlignment="Center" />
                                <StackPanel VerticalAlignment="Center" Spacing="1">
                                    <TextBlock Text="Ollama (Local &amp; Cloud)" FontWeight="SemiBold" />
                                    <TextBlock Text="Free Local &amp; Free Cloud Tier" FontSize="10" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                                </StackPanel>
                            </StackPanel>
                        </Button>

                        <!-- OpenAI Cloud -->
                        <Button Grid.Column="1" Classes="setting-segment-btn"
                                Classes.active="{Binding SelectedProvider, Converter={StaticResource EqualityConverter}, ConverterParameter=OpenAiCloud}"
                                Command="{Binding SetProviderCommand}" CommandParameter="OpenAiCloud">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <materialIcons:MaterialIcon Kind="CloudOutline" Width="16" Height="16" Foreground="#6D28D9" VerticalAlignment="Center" />
                                <StackPanel VerticalAlignment="Center" Spacing="1">
                                    <TextBlock Text="OpenAI (Cloud)" FontWeight="SemiBold" />
                                    <TextBlock Text="Official API Key Tier" FontSize="10" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                                </StackPanel>
                            </StackPanel>
                        </Button>

                        <!-- Custom OpenAI-Compatible -->
                        <Button Grid.Column="2" Classes="setting-segment-btn"
                                Classes.active="{Binding SelectedProvider, Converter={StaticResource EqualityConverter}, ConverterParameter=CustomOpenAiCompatible}"
                                Command="{Binding SetProviderCommand}" CommandParameter="CustomOpenAiCompatible">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <materialIcons:MaterialIcon Kind="Api" Width="16" Height="16" Foreground="#0F6CBD" VerticalAlignment="Center" />
                                <StackPanel VerticalAlignment="Center" Spacing="1">
                                    <TextBlock Text="Custom Compatible" FontWeight="SemiBold" />
                                    <TextBlock Text="Groq / OpenRouter / LM Studio" FontSize="10" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                                </StackPanel>
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>

                <!-- B. Provider-Specific Fields -->
                <!-- 1. Ollama Endpoint & Model Detection -->
                <StackPanel Spacing="10" IsVisible="{Binding IsOllamaProvider}">
                    <TextBlock Text="Ollama Service Endpoint" FontSize="12.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource M3OnSurfaceBrush}" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <TextBox Grid.Column="0" Text="{Binding OllamaEndpoint, Mode=TwoWay}"
                                 Classes="m3-outlined" CornerRadius="{StaticResource M3ShapeCornerMedium}"
                                 Padding="12,8" FontSize="12.5"
                                 PlaceholderText="http://localhost:11434 (or https://your-ollama-cloud-url)" />

                        <Button Grid.Column="1"
                                Command="{Binding DiscoverModelsCommand}"
                                IsEnabled="{Binding !IsDetectingModels}"
                                Classes="m3-tonal-btn"
                                CornerRadius="{StaticResource M3ShapeCornerFull}"
                                Padding="14,8">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <materialIcons:MaterialIcon Kind="Refresh" Width="15" Height="15" VerticalAlignment="Center" />
                                <TextBlock Text="Detect Installed Models" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Optional Ollama Cloud API Key / Token -->
                    <StackPanel Spacing="4">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="Ollama Cloud Token / API Key (Optional)" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource M3OnSurfaceBrush}" />
                            <TextBlock Grid.Column="1" Text="Leave blank if using offline local Ollama" FontSize="11"
                                       Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                        </Grid>
                        <TextBox Text="{Binding OllamaApiKey, Mode=TwoWay}"
                                 Classes="m3-outlined" PasswordChar="•"
                                 CornerRadius="{StaticResource M3ShapeCornerMedium}"
                                 Padding="12,8" FontSize="12.5"
                                 PlaceholderText="Optional token for authenticated Ollama Cloud / remote endpoints" />
                    </StackPanel>

                    <!-- Guidance Banner -->
                    <Border Background="{DynamicResource M3SurfaceContainerHighBrush}"
                            BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                            BorderThickness="1" CornerRadius="{StaticResource M3ShapeCornerMedium}" Padding="14,10">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <materialIcons:MaterialIcon Grid.Column="0" Kind="InformationOutline" Width="18" Height="18"
                                                        Foreground="#0284C7" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1"
                                       Text="Supports both 100% offline local Ollama ('ollama serve') and Ollama Free Cloud tier. Models are automatically tagged as [Free / Local] or [Free / Cloud] based on whether the endpoint is on-device or remote."
                                       FontSize="11" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" TextWrapping="Wrap" />
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- 2. Cloud / Custom Credentials -->
                <StackPanel Spacing="10" IsVisible="{Binding !IsOllamaProvider}">
                    <!-- Provider Presets for Custom Compatible -->
                    <StackPanel Spacing="6" IsVisible="{Binding IsCustomProvider}">
                        <TextBlock Text="Quick Provider Presets" FontSize="11.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                        <WrapPanel Orientation="Horizontal">
                            <Button Command="{Binding ApplyPresetCommand}" CommandParameter="groq"
                                    Classes="setting-preset-chip" Margin="0,0,6,6"
                                    ToolTip.Tip="High-speed Groq LPU endpoint (https://api.groq.com/openai/v1)">
                                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                    <materialIcons:MaterialIcon Kind="Flash" Width="13" Height="13" Foreground="#F59E0B" VerticalAlignment="Center" />
                                    <TextBlock Text="Groq (Ultra-Fast LPU)" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding ApplyPresetCommand}" CommandParameter="openrouter"
                                    Classes="setting-preset-chip" Margin="0,0,6,6"
                                    ToolTip.Tip="OpenRouter aggregator endpoint (https://openrouter.ai/api/v1)">
                                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                    <materialIcons:MaterialIcon Kind="CloudOutline" Width="13" Height="13" Foreground="#6366F1" VerticalAlignment="Center" />
                                    <TextBlock Text="OpenRouter" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding ApplyPresetCommand}" CommandParameter="together"
                                    Classes="setting-preset-chip" Margin="0,0,6,6"
                                    ToolTip.Tip="Together AI endpoint (https://api.together.xyz/v1)">
                                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                    <materialIcons:MaterialIcon Kind="Api" Width="13" Height="13" Foreground="#0EA5E9" VerticalAlignment="Center" />
                                    <TextBlock Text="Together AI" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding ApplyPresetCommand}" CommandParameter="lmstudio"
                                    Classes="setting-preset-chip" Margin="0,0,6,6"
                                    ToolTip.Tip="Local LM Studio server (http://localhost:1234/v1)">
                                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                    <materialIcons:MaterialIcon Kind="Laptop" Width="13" Height="13" Foreground="#10B981" VerticalAlignment="Center" />
                                    <TextBlock Text="LM Studio / Local" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </WrapPanel>
                    </StackPanel>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock Text="API Key" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource M3OnSurfaceBrush}" />
                            <TextBox Text="{Binding OpenAiApiKey, Mode=TwoWay}"
                                     Classes="m3-outlined" PasswordChar="•"
                                     CornerRadius="{StaticResource M3ShapeCornerMedium}"
                                     Padding="12,8" FontSize="12.5"
                                     PlaceholderText="sk-... or gsk_... (stored securely locally)" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Spacing="4" IsVisible="{Binding IsCustomProvider}">
                            <TextBlock Text="Custom Base URL" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource M3OnSurfaceBrush}" />
                            <TextBox Text="{Binding CustomBaseUrl, Mode=TwoWay}"
                                     Classes="m3-outlined"
                                     CornerRadius="{StaticResource M3ShapeCornerMedium}"
                                     Padding="12,8" FontSize="12.5"
                                     PlaceholderText="https://api.groq.com/openai/v1" />
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <!-- C. Model Selection -->
                <StackPanel Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="Active AI Model Identifier" FontSize="12.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource M3OnSurfaceBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding ModelSectionSubtitle}" FontSize="11"
                                       Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                        </StackPanel>

                        <!-- Action buttons for Ollama only -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                                    IsVisible="{Binding IsOllamaProvider}">
                            <Button Command="{Binding DiscoverModelsCommand}"
                                    IsEnabled="{Binding !IsDetectingModels}"
                                    Classes="m3-tonal-btn" CornerRadius="{StaticResource M3ShapeCornerFull}"
                                    Padding="10,5" FontSize="11" FontWeight="Medium"
                                    ToolTip.Tip="Queries your running Ollama instance (/api/tags) for installed models">
                                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                    <materialIcons:MaterialIcon Kind="Refresh" Width="13" Height="13" VerticalAlignment="Center" />
                                    <TextBlock Text="Detect Installed" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Button Command="{Binding FetchOnlineLibraryCommand}"
                                    IsEnabled="{Binding !IsFetchingLibrary}"
                                    Classes="m3-tonal-btn" CornerRadius="{StaticResource M3ShapeCornerFull}"
                                    Padding="10,5" FontSize="11" FontWeight="Medium"
                                    ToolTip.Tip="Fetches latest models from ollama.com library">
                                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                    <materialIcons:MaterialIcon Kind="CloudDownloadOutline" Width="13" Height="13"
                                                                Foreground="#2563EB" VerticalAlignment="Center" />
                                    <TextBlock Text="Browse Library" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!-- Action for Custom Provider -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                                    IsVisible="{Binding IsCustomProvider}">
                            <Button Command="{Binding SaveCustomModelCommand}"
                                    CommandParameter="{Binding SelectedModelId}"
                                    Classes="m3-tonal-btn" CornerRadius="{StaticResource M3ShapeCornerFull}"
                                    Padding="10,5" FontSize="11" FontWeight="Medium"
                                    ToolTip.Tip="Saves the current model identifier into your custom model history">
                                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                    <materialIcons:MaterialIcon Kind="BookmarkPlusOutline" Width="13" Height="13" VerticalAlignment="Center" />
                                    <TextBlock Text="Save to History" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Direct Model Identifier Input & Dropdown Picker -->
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <TextBox Grid.Column="0"
                                 Classes="m3-outlined"
                                 Text="{Binding SelectedModelId, Mode=TwoWay}"
                                 CornerRadius="{StaticResource M3ShapeCornerMedium}"
                                 Padding="12,9" FontSize="12.5" FontWeight="SemiBold"
                                 PlaceholderText="{Binding ModelInputPlaceholder}" />

                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding AvailableModels}"
                                  SelectedItem="{Binding SelectedModel, Mode=TwoWay}"
                                  CornerRadius="{StaticResource M3ShapeCornerMedium}"
                                  Padding="10,7" Width="260"
                                  ToolTip.Tip="Browse available models for active provider">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="coreModels:AiModelInfo">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" Margin="0,2">
                                        <Border Grid.Column="0"
                                                Background="{Binding BadgeBackgroundColor}"
                                                BorderBrush="{Binding BadgeBorderColor}"
                                                BorderThickness="1"
                                                CornerRadius="4" Padding="5,1.5" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding TierBadgeText}" FontSize="9.5" FontWeight="Bold"
                                                       Foreground="{Binding BadgeForegroundColor}" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="11.5" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Category}" FontSize="10" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding FormattedSize}" FontSize="10.5"
                                                   Foreground="{DynamicResource M3OnSurfaceVariantBrush}" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>

                    <!-- Quick Pick Suggestions -->
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <TextBlock Text="Quick Picks:" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource M3OnSurfaceVariantBrush}" VerticalAlignment="Center" Margin="0,0,2,0" />
                        <ItemsControl ItemsSource="{Binding PopularModelSuggestions}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding $parent[UserControl].((vm:SettingsViewModel)DataContext).AiSettings.SelectModelCommand}"
                                            CommandParameter="{Binding}"
                                            Classes="setting-preset-chip" Margin="0,0,6,4">
                                        <TextBlock Text="{Binding}" FontSize="10.5" FontWeight="Medium" />
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- Active Model Info Card -->
                    <Border Background="{DynamicResource M3SurfaceContainerHighBrush}"
                            BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource M3ShapeCornerMedium}"
                            Padding="14,10">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" VerticalAlignment="Center">
                            <!-- Tier Badge -->
                            <Border Grid.Column="0"
                                    Background="{Binding ActiveModelInfo.BadgeBackgroundColor}"
                                    BorderBrush="{Binding ActiveModelInfo.BadgeBorderColor}"
                                    BorderThickness="1"
                                    CornerRadius="6" Padding="8,4" VerticalAlignment="Center">
                                <StackPanel HorizontalAlignment="Center" Spacing="2">
                                    <TextBlock Text="{Binding ActiveModelInfo.TierBadgeText}"
                                               FontSize="10.5" FontWeight="Bold" HorizontalAlignment="Center"
                                               Foreground="{Binding ActiveModelInfo.BadgeForegroundColor}" />
                                    <TextBlock Text="{Binding ActiveModelInfo.FormattedSize}"
                                               FontSize="9.5" HorizontalAlignment="Center"
                                               Foreground="{Binding ActiveModelInfo.BadgeForegroundColor}"
                                               IsVisible="{Binding ActiveModelInfo.FormattedSize, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                </StackPanel>
                            </Border>

                            <!-- Model Details -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{Binding ActiveModelInfo.DisplayName}"
                                               FontWeight="Bold" FontSize="13"
                                               Foreground="{DynamicResource M3OnSurfaceBrush}" />
                                    <Border Background="{DynamicResource M3SurfaceContainerHighestBrush}"
                                            CornerRadius="4" Padding="5,1" VerticalAlignment="Center"
                                            IsVisible="{Binding ActiveModelInfo.ParameterSize, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                        <TextBlock Text="{Binding ActiveModelInfo.ParameterSize}" FontSize="10" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{Binding ActiveModelInfo.Description}" FontSize="11"
                                           Foreground="{DynamicResource M3OnSurfaceVariantBrush}" TextWrapping="Wrap" />
                            </StackPanel>

                            <!-- Capabilities / Status -->
                            <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Spacing="2">
                                <Border Background="{DynamicResource M3SecondaryContainerBrush}"
                                        CornerRadius="4" Padding="6,2" HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding ActiveModelInfo.Capabilities}" FontSize="10" FontWeight="SemiBold"
                                               Foreground="{DynamicResource M3OnSecondaryContainerBrush}" />
                                </Border>
                                <TextBlock Text="{Binding ActiveModelInfo.Category}" FontSize="10"
                                           HorizontalAlignment="Right" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- D. Connection Verification Test -->
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" VerticalAlignment="Center">
                    <Button Grid.Column="0"
                            Command="{Binding TestConnectionCommand}"
                            IsEnabled="{Binding !IsTestingConnection}"
                            Classes="m3-tonal-btn" CornerRadius="{StaticResource M3ShapeCornerFull}"
                            Padding="14,8">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <materialIcons:MaterialIcon Kind="LightningBoltOutline" Width="15" Height="15"
                                                        Foreground="#D97706" VerticalAlignment="Center" />
                            <TextBlock Text="Test Connection" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <TextBlock Grid.Column="1"
                               Text="{Binding TestConnectionStatus}"
                               FontSize="11.5" FontWeight="Medium"
                               Foreground="{Binding TestConnectionSuccess, Converter={StaticResource BooleanToStringConverter}, ConverterParameter='#15803D|#DC2626'}"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- ========================================== -->
        <!-- 7. PRIVACY, STORAGE & DEFAULTS CARD        -->
        <!-- ========================================== -->
        <Border Classes="setting-card" IsVisible="{Binding IsPrivacyVisible}">
            <StackPanel Spacing="16">
                <!-- Section Header -->
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                    <Border Grid.Column="0" Width="38" Height="38"
                            Background="{DynamicResource M3SecondaryContainerBrush}"
                            CornerRadius="10" VerticalAlignment="Center">
                        <materialIcons:MaterialIcon Kind="ShieldCheckOutline" Width="20" Height="20"
                                                    Foreground="{DynamicResource M3OnSecondaryContainerBrush}"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="Privacy, Storage &amp; Factory Reset" FontSize="14.5" FontWeight="Bold"
                                   Foreground="{DynamicResource M3OnSurfaceBrush}" />
                        <TextBlock Text="Local application configuration, offline privacy guarantee, and reset tools."
                                   FontSize="11.5" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                    </StackPanel>
                </Grid>

                <Separator Height="1" Background="{DynamicResource M3OutlineVariantBrush}" Opacity="0.5" />

                <!-- Row 1: 100% Offline Guarantee -->
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16" MinHeight="44">
                    <Border Grid.Column="0" Width="36" Height="36" CornerRadius="10"
                            Background="{DynamicResource M3SurfaceContainerHighBrush}" VerticalAlignment="Center">
                        <materialIcons:MaterialIcon Kind="ShieldCheckOutline" Width="18" Height="18"
                                                    Foreground="#15803D" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="100% Offline &amp; Privacy-First Architecture" FontSize="13.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource M3OnSurfaceBrush}" />
                        <TextBlock Text="All user preferences, tool settings, and workspaces are stored strictly locally on your machine. Zero tracking, telemetry, or external data sharing."
                                   FontSize="11.5" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>

                <Separator Height="1" Background="{DynamicResource M3OutlineVariantBrush}" Opacity="0.5" />

                <!-- Row 2: Configuration Storage File -->
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16" MinHeight="44">
                    <Border Grid.Column="0" Width="36" Height="36" CornerRadius="10"
                            Background="{DynamicResource M3SurfaceContainerHighBrush}" VerticalAlignment="Center">
                        <materialIcons:MaterialIcon Kind="FolderOutline" Width="18" Height="18"
                                                    Foreground="{DynamicResource M3PrimaryBrush}"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="Preferences File Location" FontSize="13.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource M3OnSurfaceBrush}" />
                        <TextBlock Text="Settings are serialized as clean JSON in your user profile: ui_settings.json."
                                   FontSize="11.5" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                    <Border Grid.Column="2" Background="{DynamicResource M3SurfaceContainerHighBrush}"
                            BorderBrush="{DynamicResource M3OutlineVariantBrush}" BorderThickness="1"
                            CornerRadius="{StaticResource M3ShapeCornerSmall}" Padding="10,5" VerticalAlignment="Center">
                        <TextBlock Text="ui_settings.json" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource M3OnSurfaceBrush}" />
                    </Border>
                </Grid>

                <Separator Height="1" Background="{DynamicResource M3OutlineVariantBrush}" Opacity="0.5" />

                <!-- Row 3: Factory Reset -->
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16" MinHeight="44">
                    <Border Grid.Column="0" Width="36" Height="36" CornerRadius="10"
                            Background="{DynamicResource M3SurfaceContainerHighBrush}" VerticalAlignment="Center">
                        <materialIcons:MaterialIcon Kind="Restore" Width="18" Height="18"
                                                    Foreground="#DC2626" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="Reset All Settings to Factory Defaults" FontSize="13.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource M3OnSurfaceBrush}" />
                        <TextBlock Text="Restores all appearance themes, canvas grids, notification placements, and AI configs back to initial settings."
                                   FontSize="11.5" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                    <Button Grid.Column="2"
                            Command="{Binding ResetAllDefaultsCommand}"
                            Classes="m3-tonal-btn" CornerRadius="{StaticResource M3ShapeCornerFull}"
                            Padding="14,8" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <materialIcons:MaterialIcon Kind="Restore" Width="15" Height="15" VerticalAlignment="Center" />
                            <TextBlock Text="Restore Defaults" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>
            </StackPanel>
        </Border>

    </StackPanel>
</UserControl>
