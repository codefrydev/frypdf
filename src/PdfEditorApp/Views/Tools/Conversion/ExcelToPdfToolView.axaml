<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PdfEditorApp.ViewModels.Tools.Conversion"
             xmlns:converters="using:PdfEditorApp.Converters"
             xmlns:shell="using:PdfEditorApp.Views.Shell"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="PdfEditorApp.Views.Tools.Conversion.ExcelToPdfToolView"
             x:DataType="vm:ExcelToPdfToolViewModel">

    <UserControl.Resources>
        <converters:EqualityToBooleanConverter x:Key="EqualityConverter" />
    </UserControl.Resources>

    <shell:PdfToolWorkspaceView>

        <!-- Toolbar primary action -->
        <shell:PdfToolWorkspaceView.ToolbarActionContent>
            <Button Command="{Binding ExecuteToolCommand}" IsEnabled="{Binding !IsRunning}" Background="#16A34A" Foreground="White" CornerRadius="8" Padding="16,8" FontWeight="Bold" FontSize="12.5" Cursor="Hand">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <materialIcons:MaterialIcon Kind="FilePdfBox" Width="15" Height="15" />
                    <TextBlock Text="Convert to PDF" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </shell:PdfToolWorkspaceView.ToolbarActionContent>

        <!-- Sidebar Options tab: status, spreadsheet selection, and conversion settings -->
        <shell:PdfToolWorkspaceView.OptionsContent>
            <StackPanel Spacing="16">

                <!-- Error Alert Banner -->
                <Border Background="#FEF2F2" BorderBrush="#FCA5A5" BorderThickness="1" CornerRadius="10" Padding="16,12" IsVisible="{Binding HasError}">
                    <Grid ColumnDefinitions="Auto,*">
                        <materialIcons:MaterialIcon Grid.Column="0" Kind="AlertCircleOutline" Width="22" Height="22" Foreground="#DC2626" Margin="0,0,12,0" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="Conversion Failed" FontSize="13" FontWeight="Bold" Foreground="#991B1B" />
                            <TextBlock Text="{Binding ErrorMessage}" FontSize="12" Foreground="#B91C1C" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Success Banner -->
                <Border Background="#F0FDF4" BorderBrush="#86EFAC" BorderThickness="1" CornerRadius="12" Padding="18,16" BoxShadow="0 4 12 #1016A34A" IsVisible="{Binding IsComplete}">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <Border Width="36" Height="36" Background="#DCFCE7" CornerRadius="10">
                                <materialIcons:MaterialIcon Kind="CheckCircle" Width="21" Height="21" Foreground="#16A34A" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="PDF Generated Successfully!" FontSize="13.5" FontWeight="Bold" Foreground="#166534" />
                                <TextBlock Text="{Binding ResultSummaryMessage}" FontSize="11.5" Foreground="#15803D" TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>

                        <WrapPanel Orientation="Horizontal">
                            <Button Command="{Binding OpenOutputFileCommand}" Background="#16A34A" Foreground="White" CornerRadius="8" Padding="12,7" FontSize="11.5" FontWeight="SemiBold" Cursor="Hand" Margin="0,0,6,6">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <materialIcons:MaterialIcon Kind="FileEyeOutline" Width="14" Height="14" />
                                    <TextBlock Text="Open PDF" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding OpenOutputFolderCommand}" Background="#DCFCE7" Foreground="#166534" BorderBrush="#86EFAC" BorderThickness="1" CornerRadius="8" Padding="12,7" FontSize="11.5" FontWeight="SemiBold" Cursor="Hand" Margin="0,0,6,6">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <materialIcons:MaterialIcon Kind="FolderOpenOutline" Width="14" Height="14" />
                                    <TextBlock Text="Show in Folder" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding OpenInEditorCommand}" Background="#EFF6FF" Foreground="#0F6CBD" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="8" Padding="12,7" FontSize="11.5" FontWeight="SemiBold" Cursor="Hand" Margin="0,0,6,6">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <materialIcons:MaterialIcon Kind="SquareEditOutline" Width="14" Height="14" />
                                    <TextBlock Text="Edit in FryPDF" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- Processing Card -->
                <Border Background="{DynamicResource WinPanelBrush}" BorderBrush="{DynamicResource WinBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16,14" IsVisible="{Binding IsRunning}">
                    <StackPanel Spacing="10">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource WinTextBrush}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding ProgressPercentage, StringFormat='{}{0:F0}%'}" FontSize="13" FontWeight="Bold" Foreground="#16A34A" VerticalAlignment="Center" />
                        </Grid>
                        <ProgressBar Value="{Binding ProgressPercentage}" Minimum="0" Maximum="100" Height="7" CornerRadius="4" Foreground="#16A34A" Background="{DynamicResource WinHoverBrush}" />
                    </StackPanel>
                </Border>

                <!-- Dropzone Box -->
                <Border Background="{DynamicResource WinPanelBrush}" BorderBrush="{DynamicResource WinBorderBrush}" BorderThickness="2" CornerRadius="12" Padding="24,28" IsVisible="{Binding !HasSelectedFiles}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14">
                        <Border Width="56" Height="56" Background="#DCFCE7" BorderBrush="#86EFAC" BorderThickness="1" CornerRadius="16" HorizontalAlignment="Center">
                            <materialIcons:MaterialIcon Kind="FileExcel" Width="30" Height="30" Foreground="#16A34A" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Spacing="4" HorizontalAlignment="Center">
                            <TextBlock Text="Select Excel Spreadsheet to Convert" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource WinTextBrush}" HorizontalAlignment="Center" TextAlignment="Center" />
                            <TextBlock Text="Render XLSX and XLS spreadsheets to beautifully formatted PDF pages" FontSize="11.5" Foreground="{DynamicResource WinMutedBrush}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Command="{Binding AddFilesCommand}" Background="#16A34A" Foreground="White" CornerRadius="8" Padding="20,10" FontSize="12.5" FontWeight="SemiBold" HorizontalAlignment="Center" Cursor="Hand">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <materialIcons:MaterialIcon Kind="FolderOpenOutline" Width="16" Height="16" />
                                <TextBlock Text="Select Excel File" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Loaded Document Card -->
                <Border Background="{DynamicResource WinPanelBrush}" BorderBrush="{DynamicResource WinBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16" IsVisible="{Binding HasSelectedFiles}">
                    <StackPanel Spacing="10">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="Spreadsheet to Convert" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource WinTextBrush}" VerticalAlignment="Center" />
                            <Button Command="{Binding AddFilesCommand}" Background="#DCFCE7" Foreground="#16A34A" BorderBrush="#86EFAC" BorderThickness="1" CornerRadius="6" Padding="10,5" FontSize="11" FontWeight="SemiBold" Cursor="Hand">
                                Change File
                            </Button>
                        </Grid>
                        <Border Background="{DynamicResource WinInputBgBrush}" BorderBrush="{DynamicResource WinBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,10">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <Border Grid.Column="0" Width="32" Height="32" Background="#DCFCE7" CornerRadius="8" Margin="0,0,10,0">
                                    <materialIcons:MaterialIcon Kind="FileExcel" Width="18" Height="18" Foreground="#16A34A" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Grid.Column="1" Text="{Binding PrimaryInputFile}" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource WinTextBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <Button Grid.Column="2" Command="{Binding ClearFilesCommand}" Background="Transparent" BorderThickness="0" Padding="6" Cursor="Hand">
                                    <materialIcons:MaterialIcon Kind="Close" Width="16" Height="16" Foreground="{DynamicResource WinSubtleBrush}" />
                                </Button>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Conversion settings -->
                <StackPanel Spacing="3">
                    <TextBlock Text="Conversion Settings" FontSize="14" FontWeight="ExtraBold" Foreground="{DynamicResource WinTextBrush}" />
                    <TextBlock Text="Choose the output page orientation" FontSize="11" Foreground="{DynamicResource WinMutedBrush}" TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Spacing="4">
                    <TextBlock Text="Page Orientation" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource WinMutedBrush}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <RadioButton Content="Landscape (Best for Wide Tables)" IsChecked="{Binding Orientation, Converter={StaticResource EqualityConverter}, ConverterParameter=Landscape}" />
                        <RadioButton Content="Portrait" IsChecked="{Binding Orientation, Converter={StaticResource EqualityConverter}, ConverterParameter=Portrait}" />
                    </StackPanel>
                </StackPanel>

            </StackPanel>
        </shell:PdfToolWorkspaceView.OptionsContent>

    </shell:PdfToolWorkspaceView>
</UserControl>
