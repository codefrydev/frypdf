<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PdfEditorApp.ViewModels"
             xmlns:controls="using:PdfEditorApp.Views.Controls"
             xmlns:elvm="using:PdfEditorApp.ViewModels.ElementViewModels"
             xmlns:models="using:PdfEditorApp.Models"
             xmlns:converters="using:PdfEditorApp.Converters"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="PdfEditorApp.Views.ThumbnailSidebarView"
             x:DataType="vm:MainViewModel">

    <UserControl.Resources>
        <converters:BooleanToBrushConverter x:Key="BoolToBrush" />
        <converters:BooleanToThicknessConverter x:Key="BoolToThickness" />
        <converters:EqualityToBooleanConverter x:Key="EqualityConverter" />
        <converters:HexToBrushConverter x:Key="HexToBrushConverter" />
        <converters:NullToBooleanConverter x:Key="NullToBooleanConverter" />
        <converters:DoubleToThicknessConverter x:Key="DoubleToThickness" />
        <converters:TextAlignmentConverter x:Key="TextAlignmentConverter" />

        <!-- Page Thumbnail Context Menu -->
        <ContextMenu x:Key="PageThumbnailContextMenu" x:DataType="vm:PageViewModel">
            <MenuItem Header="Add New Page" InputGesture="Ctrl+Shift+N" Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).AddPageCommand}">
                <MenuItem.Icon><materialIcons:MaterialIcon Kind="FilePlusOutline" Width="16" Height="16" Foreground="#0F6CBD" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Duplicate Page" InputGesture="Ctrl+Shift+D" Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).DuplicateCurrentPageCommand}">
                <MenuItem.Icon><materialIcons:MaterialIcon Kind="FileMultipleOutline" Width="16" Height="16" Foreground="{DynamicResource WinMutedBrush}" /></MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem Header="Rotate 90° Clockwise" InputGesture="Ctrl+Shift+R" Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).RotateCurrentPageCommand}">
                <MenuItem.Icon><materialIcons:MaterialIcon Kind="RotateRight" Width="16" Height="16" Foreground="{DynamicResource WinMutedBrush}" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Rotate 90° Counter-Clockwise" Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).RotateCurrentPageCounterClockwiseCommand}">
                <MenuItem.Icon><materialIcons:MaterialIcon Kind="RotateLeft" Width="16" Height="16" Foreground="{DynamicResource WinMutedBrush}" /></MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem Header="Move Page Up" InputGesture="Ctrl+Shift+Up" Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).MovePageUpCommand}">
                <MenuItem.Icon><materialIcons:MaterialIcon Kind="ChevronUp" Width="16" Height="16" Foreground="{DynamicResource WinMutedBrush}" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Move Page Down" InputGesture="Ctrl+Shift+Down" Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).MovePageDownCommand}">
                <MenuItem.Icon><materialIcons:MaterialIcon Kind="ChevronDown" Width="16" Height="16" Foreground="{DynamicResource WinMutedBrush}" /></MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem Header="Delete Page" InputGesture="Ctrl+Shift+Delete" Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).DeleteCurrentPageCommand}">
                <MenuItem.Icon><materialIcons:MaterialIcon Kind="DeleteOutline" Width="16" Height="16" Foreground="#DC2626" /></MenuItem.Icon>
            </MenuItem>
        </ContextMenu>
    </UserControl.Resources>

    <!-- Outer Container: dynamically switches between Expanded (240px) and Collapsed (38px) mode -->
    <Panel>
        <!-- A. EXPANDED MODE (Width 240) -->
        <Border Background="{DynamicResource WinPanelBrush}" BorderBrush="{DynamicResource WinBorderBrush}" BorderThickness="0,0,1,0" Width="240"
                IsVisible="{Binding !IsLeftSidebarCollapsed}">
            <Grid RowDefinitions="Auto,*,Auto">

                <!-- 1. Sidebar Tab Bar Header (Thumbnails, Outline, Comments) -->
                <Border Grid.Row="0" Background="{DynamicResource WinBgBrush}" Height="42" BorderBrush="{DynamicResource WinBorderBrush}" BorderThickness="0,0,0,1" Padding="8,0">
                    <Grid ColumnDefinitions="*,Auto">
                        <!-- Tab Switcher -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                            <Button Classes="mini-tool-btn" Width="30" Height="30"
                                    Classes.active="{Binding ActiveSidebarTab, Converter={StaticResource EqualityConverter}, ConverterParameter=Thumbnails}"
                                    Command="{Binding SelectSidebarTabCommand}"
                                    CommandParameter="{x:Static models:SidebarTabKind.Thumbnails}"
                                    ToolTip.Tip="Page Thumbnails">
                                <materialIcons:MaterialIcon Kind="FileDocumentMultipleOutline" Width="16" Height="16" Foreground="{DynamicResource WinTextBrush}" />
                            </Button>

                            <Button Classes="mini-tool-btn" Width="30" Height="30"
                                    Classes.active="{Binding ActiveSidebarTab, Converter={StaticResource EqualityConverter}, ConverterParameter=Outline}"
                                    Command="{Binding SelectSidebarTabCommand}"
                                    CommandParameter="{x:Static models:SidebarTabKind.Outline}"
                                    ToolTip.Tip="Document Outline &amp; Bookmarks">
                                <materialIcons:MaterialIcon Kind="FormatListBulleted" Width="16" Height="16" Foreground="{DynamicResource WinTextBrush}" />
                            </Button>

                            <Button Classes="mini-tool-btn" Width="30" Height="30"
                                    Classes.active="{Binding ActiveSidebarTab, Converter={StaticResource EqualityConverter}, ConverterParameter=Comments}"
                                    Command="{Binding SelectSidebarTabCommand}"
                                    CommandParameter="{x:Static models:SidebarTabKind.Comments}"
                                    ToolTip.Tip="Comments &amp; Review Annotations">
                                <materialIcons:MaterialIcon Kind="CommentTextMultipleOutline" Width="16" Height="16" Foreground="{DynamicResource WinTextBrush}" />
                            </Button>
                        </StackPanel>

                        <!-- Quick Page Actions & Collapse Button -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                            <Button Classes="mini-tool-btn" Width="26" Height="26" Command="{Binding AddPageCommand}" ToolTip.Tip="Add New Page (⌘⇧N)"
                                    IsVisible="{Binding ActiveSidebarTab, Converter={StaticResource EqualityConverter}, ConverterParameter=Thumbnails}">
                                <materialIcons:MaterialIcon Kind="Plus" Width="14" Height="14" Foreground="{DynamicResource WinMutedBrush}" />
                            </Button>
                            <Button Classes="mini-tool-btn" Width="26" Height="26" Command="{Binding RotateCurrentPageCommand}" ToolTip.Tip="Rotate 90° CW (⌘⇧R)"
                                    IsVisible="{Binding ActiveSidebarTab, Converter={StaticResource EqualityConverter}, ConverterParameter=Thumbnails}">
                                <materialIcons:MaterialIcon Kind="RotateRight" Width="14" Height="14" Foreground="{DynamicResource WinMutedBrush}" />
                            </Button>
                            <Rectangle Width="1" Height="14" Fill="{DynamicResource WinBorderBrush}" Margin="2,0" />
                            <Button Classes="mini-tool-btn" Width="26" Height="26"
                                    Command="{Binding ToggleLeftSidebarCommand}"
                                    ToolTip.Tip="Collapse Pages Sidebar (⌘B / Ctrl+B)">
                                <materialIcons:MaterialIcon Kind="ChevronLeft" Width="16" Height="16" Foreground="{DynamicResource WinMutedBrush}" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

            <!-- 2. Content Area (Dynamically changes based on ActiveSidebarTab) -->
            <Panel Grid.Row="1">

                <!-- 2A. TAB: REAL LIVE PAGE THUMBNAILS (Real Live Scaled Viewboxes) -->
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Padding="12"
                              IsVisible="{Binding ActiveSidebarTab, Converter={StaticResource EqualityConverter}, ConverterParameter=Thumbnails}">
                    <ItemsControl ItemsSource="{Binding Pages}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:PageViewModel">
                                <Button Background="Transparent"
                                        BorderThickness="0"
                                        Padding="0"
                                        Margin="0,0,0,16"
                                        HorizontalAlignment="Center"
                                        ContextMenu="{StaticResource PageThumbnailContextMenu}"
                                        Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).SelectPageCommand}"
                                        CommandParameter="{Binding}">
                                    <StackPanel HorizontalAlignment="Center" Spacing="6">

                                        <!-- Real Live Miniature Page Card -->
                                        <Border Background="{DynamicResource WinPanelBrush}"
                                                BorderThickness="{Binding IsSelected, Converter={StaticResource BoolToThickness}, ConverterParameter='2.5|1'}"
                                                BorderBrush="{Binding IsSelected, Converter={StaticResource BoolToBrush}, ConverterParameter='#0F6CBD|#CBD5E1'}"
                                                CornerRadius="6"
                                                BoxShadow="0 4 14 #15000000"
                                                Padding="2"
                                                Width="148"
                                                Height="208"
                                                ClipToBounds="True">

                                            <!-- Live Scaled Page Canvas Viewbox -->
                                            <Viewbox Width="142" Height="202" Stretch="Uniform">
                                                <LayoutTransformControl>
                                                    <LayoutTransformControl.LayoutTransform>
                                                        <RotateTransform Angle="{Binding RotationAngle, FallbackValue=0}" />
                                                    </LayoutTransformControl.LayoutTransform>
                                                    <Border Width="{Binding Width}" Height="{Binding Height}"
                                                            Background="{Binding BackgroundColorHex, Converter={StaticResource HexToBrushConverter}}"
                                                            BoxShadow="0 1 4 #08000000">

                                                    <!-- Live Real Elements on Page -->
                                                    <ItemsControl ItemsSource="{Binding Elements}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <Canvas Width="{Binding Width}" Height="{Binding Height}" />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>

                                                        <ItemsControl.ItemContainerTheme>
                                                            <ControlTheme TargetType="ContentPresenter" x:DataType="elvm:ElementViewModelBase">
                                                                <Setter Property="Canvas.Left" Value="{Binding X}" />
                                                                <Setter Property="Canvas.Top" Value="{Binding Y}" />
                                                                <Setter Property="Canvas.ZIndex" Value="{Binding ZIndex}" />
                                                                <Setter Property="Opacity" Value="{Binding Opacity}" />
                                                                <Setter Property="RenderTransformOrigin" Value="50%,50%" />
                                                                <Setter Property="RenderTransform" Value="{Binding Rotation, Converter={StaticResource RotationToTransformConverter}}" />
                                                            </ControlTheme>
                                                        </ItemsControl.ItemContainerTheme>

                                                        <ItemsControl.DataTemplates>

                                                            <!-- Text Element Mini Template -->
                                                            <DataTemplate DataType="elvm:TextElementViewModel">
                                                                <controls:AdvancedTextControl
                                                                    Width="{Binding Width}" Height="{Binding Height}"
                                                                    Text="{Binding Text}"
                                                                    FontFamilyName="{Binding FontFamily}"
                                                                    FontSize="{Binding FontSize}"
                                                                    IsBold="{Binding IsBold}"
                                                                    IsItalic="{Binding IsItalic}"
                                                                    IsUnderline="{Binding IsUnderline}"
                                                                    IsDoubleUnderline="{Binding IsDoubleUnderline}"
                                                                    IsStrikethrough="{Binding IsStrikethrough}"
                                                                    TextBrush="{Binding TextBrush}"
                                                                    TextOpacity="{Binding TextOpacity}"
                                                                    Alignment="{Binding Alignment}"
                                                                    TextVerticalAlignment="{Binding VerticalAlignment}"
                                                                    LineHeight="{Binding LineHeight}"
                                                                    CharacterSpacing="{Binding CharacterSpacing}"
                                                                    WordSpacing="{Binding WordSpacing}"
                                                                    ParagraphSpacing="{Binding ParagraphSpacing}"
                                                                    TextWrap="{Binding TextWrap}"
                                                                    HasStroke="{Binding HasStroke}"
                                                                    StrokeBrush="{Binding StrokeBrush}"
                                                                    StrokeWidth="{Binding StrokeWidth}"
                                                                    HasShadow="{Binding HasShadow}"
                                                                    ShadowBrush="{Binding ShadowBrush}"
                                                                    ShadowOffsetX="{Binding ShadowOffsetX}"
                                                                    ShadowOffsetY="{Binding ShadowOffsetY}"
                                                                    ShadowBlurRadius="{Binding ShadowBlurRadius}"
                                                                    ShadowOpacity="{Binding ShadowOpacity}"
                                                                    BackgroundBrush="{Binding BackgroundBrush}"
                                                                    BorderBrush="{Binding BorderBrush}"
                                                                    BorderThickness="{Binding BorderThickness}"
                                                                    CornerRadius="{Binding CornerRadius}"
                                                                    Padding="{Binding Padding}"
                                                                    ShapeMode="{Binding ShapeMode}"
                                                                    CurveRadius="{Binding CurveRadius}"
                                                                    CurveArcAngle="{Binding CurveArcAngle}"
                                                                    CurveStartAngle="{Binding CurveStartAngle}"
                                                                    CurveClockwise="{Binding CurveClockwise}"
                                                                    CurveInvert="{Binding CurveInvert}"
                                                                    CircularPlacement="{Binding CircularPlacement}"
                                                                    BaselineShift="{Binding BaselineShift}"
                                                                    CharacterRotation="{Binding CharacterRotation}"
                                                                    ScaleX="{Binding ScaleX}"
                                                                    ScaleY="{Binding ScaleY}"
                                                                    FlipX="{Binding FlipX}"
                                                                    FlipY="{Binding FlipY}"
                                                                    BezierPreset="{Binding BezierPreset}"
                                                                    BezierP0X="{Binding BezierP0X}"
                                                                    BezierP0Y="{Binding BezierP0Y}"
                                                                    BezierP1X="{Binding BezierP1X}"
                                                                    BezierP1Y="{Binding BezierP1Y}"
                                                                    BezierP2X="{Binding BezierP2X}"
                                                                    BezierP2Y="{Binding BezierP2Y}"
                                                                    BezierP3X="{Binding BezierP3X}"
                                                                    BezierP3Y="{Binding BezierP3Y}" />
                                                            </DataTemplate>

                                                            <!-- Shape Element Mini Template -->
                                                            <DataTemplate DataType="elvm:ShapeElementViewModel">
                                                                <Grid Width="{Binding Width}" Height="{Binding Height}">
                                                                    <Path Data="{Binding PathData}"
                                                                          Fill="{Binding FillColorHex, Converter={StaticResource HexToBrushConverter}}"
                                                                          Stroke="{Binding StrokeColorHex, Converter={StaticResource HexToBrushConverter}}"
                                                                          StrokeThickness="{Binding StrokeThickness}"
                                                                          StrokeDashArray="{Binding DashArrayString}"
                                                                          Stretch="Fill" />
                                                                </Grid>
                                                            </DataTemplate>

                                                            <!-- Divider Element Mini Template -->
                                                            <DataTemplate DataType="elvm:DividerElementViewModel">
                                                                <Grid Width="{Binding Width}" Height="{Binding Height}">
                                                                    <Path Data="{Binding PathData}"
                                                                          Stroke="{Binding ColorHex, Converter={StaticResource HexToBrushConverter}}"
                                                                          StrokeThickness="{Binding Thickness}"
                                                                          StrokeDashArray="{Binding DashArrayString}"
                                                                          Stretch="Fill" />
                                                                </Grid>
                                                            </DataTemplate>

                                                            <!-- Ink Element Mini Template -->
                                                            <DataTemplate DataType="elvm:InkElementViewModel">
                                                                <Grid Width="{Binding Width}" Height="{Binding Height}">
                                                                    <Path Data="{Binding PathData}"
                                                                          Stroke="{Binding StrokeColorHex, Converter={StaticResource HexToBrushConverter}}"
                                                                          StrokeThickness="{Binding StrokeThickness}"
                                                                          Opacity="{Binding Opacity}"
                                                                          Stretch="None" />
                                                                </Grid>
                                                            </DataTemplate>

                                                            <!-- Table Element Mini Template -->
                                                            <DataTemplate DataType="elvm:TableElementViewModel">
                                                                <Border Width="{Binding Width}" Height="{Binding Height}"
                                                                        Background="{DynamicResource WinPanelBrush}"
                                                                        BorderBrush="{Binding BorderColorHex, Converter={StaticResource HexToBrushConverter}}"
                                                                        BorderThickness="1" Padding="4">
                                                                    <Grid RowDefinitions="Auto,*">
                                                                        <Rectangle Grid.Row="0" Height="20" Fill="{Binding HeaderBackgroundHex, Converter={StaticResource HexToBrushConverter}}" />
                                                                        <StackPanel Grid.Row="1" Spacing="4" Margin="0,4,0,0">
                                                                            <Rectangle Height="8" Fill="{DynamicResource WinBorderBrush}" />
                                                                            <Rectangle Height="8" Fill="#F1F5F9" />
                                                                            <Rectangle Height="8" Fill="{DynamicResource WinBorderBrush}" />
                                                                        </StackPanel>
                                                                    </Grid>
                                                                </Border>
                                                            </DataTemplate>

                                                            <!-- Chart Element Mini Template -->
                                                            <DataTemplate DataType="elvm:ChartElementViewModel">
                                                                <Border Width="{Binding Width}" Height="{Binding Height}"
                                                                        Background="{Binding BackgroundColorHex, Converter={StaticResource HexToBrushConverter}}"
                                                                        BorderBrush="{Binding BorderColorHex, Converter={StaticResource HexToBrushConverter}}"
                                                                        BorderThickness="1" CornerRadius="4" Padding="6">
                                                                    <Grid RowDefinitions="Auto,*">
                                                                        <TextBlock Grid.Row="0" Text="{Binding Title}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource WinTextBrush}" />
                                                                        <ItemsControl Grid.Row="1" ItemsSource="{Binding Bars}" Margin="0,4,0,0">
                                                                            <ItemsControl.ItemsPanel>
                                                                                <ItemsPanelTemplate>
                                                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" HorizontalAlignment="Center" Spacing="8" />
                                                                                </ItemsPanelTemplate>
                                                                            </ItemsControl.ItemsPanel>
                                                                            <ItemsControl.ItemTemplate>
                                                                                <DataTemplate DataType="elvm:ChartBarItem">
                                                                                    <Border Width="28" Height="{Binding BarHeightPx}"
                                                                                            Background="{Binding ColorHex, Converter={StaticResource HexToBrushConverter}}"
                                                                                            CornerRadius="2,2,0,0" />
                                                                                </DataTemplate>
                                                                            </ItemsControl.ItemTemplate>
                                                                        </ItemsControl>
                                                                    </Grid>
                                                                </Border>
                                                            </DataTemplate>

                                                            <!-- Image Element Mini Template -->
                                                            <DataTemplate DataType="elvm:ImageElementViewModel">
                                                                <Border Width="{Binding Width}" Height="{Binding Height}"
                                                                        Background="Transparent" BorderThickness="0" CornerRadius="0" ClipToBounds="True">
                                                                    <Panel>
                                                                        <Image Source="{Binding PreviewBitmap}" Stretch="UniformToFill"
                                                                               IsVisible="{Binding PreviewBitmap, Converter={StaticResource NullToBooleanConverter}}" />
                                                                        <materialIcons:MaterialIcon Kind="ImageOutline" Width="28" Height="28" Foreground="{DynamicResource WinSubtleBrush}"
                                                                                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                                                    IsVisible="{Binding PreviewBitmap, Converter={x:Static converters:EqualityToBooleanConverter.Instance}, ConverterParameter={x:Null}, FallbackValue=True}" />
                                                                    </Panel>
                                                                </Border>
                                                            </DataTemplate>

                                                            <!-- QR Code Mini Template -->
                                                            <DataTemplate DataType="elvm:QrCodeElementViewModel">
                                                                <Border Width="{Binding Width}" Height="{Binding Height}"
                                                                        Background="{Binding LightColorHex, Converter={StaticResource HexToBrushConverter}}" BorderBrush="{DynamicResource WinBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="4">
                                                                    <Image Source="{Binding QrBitmap}" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                </Border>
                                                            </DataTemplate>

                                                            <!-- Barcode Mini Template -->
                                                            <DataTemplate DataType="elvm:BarcodeElementViewModel">
                                                                <Border Width="{Binding Width}" Height="{Binding Height}"
                                                                        Background="{DynamicResource WinPanelBrush}" BorderBrush="{DynamicResource WinBorderBrush}" BorderThickness="1" CornerRadius="3" Padding="4">
                                                                    <materialIcons:MaterialIcon Kind="Barcode" Width="100" Height="24" Foreground="{Binding BarColorHex, Converter={StaticResource HexToBrushConverter}}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                </Border>
                                                            </DataTemplate>

                                                            <!-- Redaction Mini Template -->
                                                            <DataTemplate DataType="elvm:RedactionElementViewModel">
                                                                <Border Width="{Binding Width}" Height="{Binding Height}"
                                                                        Background="{Binding FillColorHex, Converter={StaticResource HexToBrushConverter}}"
                                                                        BorderBrush="{Binding BorderColorHex, Converter={StaticResource HexToBrushConverter}}"
                                                                        BorderThickness="1.5" CornerRadius="2">
                                                                    <TextBlock Text="{Binding ExemptionCode}" FontSize="8" FontWeight="Bold" Foreground="{Binding TextColorHex, Converter={StaticResource HexToBrushConverter}}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                </Border>
                                                            </DataTemplate>

                                                            <!-- Sticky Note Mini Template -->
                                                            <DataTemplate DataType="elvm:StickyNoteElementViewModel">
                                                                <Border Width="{Binding Width}" Height="{Binding Height}"
                                                                        Background="{Binding ColorHex, Converter={StaticResource HexToBrushConverter}}"
                                                                        BorderBrush="{Binding BorderColorHex, Converter={StaticResource HexToBrushConverter}}"
                                                                        BorderThickness="1" CornerRadius="4" Padding="4">
                                                                    <TextBlock Text="{Binding NoteText}" FontSize="8" Foreground="#78350F" TextWrapping="Wrap" />
                                                                </Border>
                                                            </DataTemplate>

                                                            <!-- Form Field Mini Template -->
                                                            <DataTemplate DataType="elvm:FormFieldElementViewModel">
                                                                <Border Width="{Binding Width}" Height="{Binding Height}"
                                                                        Background="{Binding BackgroundColorHex, Converter={StaticResource HexToBrushConverter}}"
                                                                        BorderBrush="{Binding BorderColorHex, Converter={StaticResource HexToBrushConverter}}"
                                                                        BorderThickness="1" CornerRadius="3" Padding="3">
                                                                    <TextBlock Text="{Binding Label}" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource WinTextBrush}" />
                                                                </Border>
                                                            </DataTemplate>

                                                            <!-- Watermark Mini Template -->
                                                            <DataTemplate DataType="elvm:WatermarkElementViewModel">
                                                                <Grid Width="{Binding Width}" Height="{Binding Height}">
                                                                    <TextBlock Text="{Binding Text}" FontSize="{Binding FontSize}" FontWeight="Bold"
                                                                               Opacity="{Binding Opacity}" Foreground="{Binding ColorHex, Converter={StaticResource HexToBrushConverter}}"
                                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                </Grid>
                                                            </DataTemplate>

                                                            <!-- SVG Vector Mini Template -->
                                                            <DataTemplate DataType="elvm:SvgElementViewModel">
                                                                <Grid Width="{Binding Width}" Height="{Binding Height}">
                                                                    <Viewbox Stretch="Uniform">
                                                                        <Path Data="{Binding PathGeometryData}"
                                                                              Fill="{Binding TintColorHex, Converter={StaticResource HexToBrushConverter}, FallbackValue='#D97706'}"
                                                                              Stroke="{Binding TintColorHex, Converter={StaticResource HexToBrushConverter}, FallbackValue='#8B0000'}"
                                                                              StrokeThickness="1.5" />
                                                                    </Viewbox>
                                                                </Grid>
                                                            </DataTemplate>

                                                        </ItemsControl.DataTemplates>
                                                    </ItemsControl>

                                                </Border>
                                                </LayoutTransformControl>
                                            </Viewbox>
                                        </Border>

                                        <!-- Page Number Pill -->
                                        <Border Background="{Binding IsSelected, Converter={StaticResource BoolToBrush}, ConverterParameter='#0F6CBD|#F1F5F9'}"
                                                BorderBrush="{Binding IsSelected, Converter={StaticResource BoolToBrush}, ConverterParameter='#0F6CBD|#CBD5E1'}"
                                                BorderThickness="1"
                                                CornerRadius="10"
                                                Padding="10,2">
                                            <TextBlock Text="{Binding PageNumber, StringFormat='Page {0}'}"
                                                       FontSize="10.5"
                                                       FontWeight="SemiBold"
                                                       Foreground="{Binding IsSelected, Converter={StaticResource BoolToBrush}, ConverterParameter='#FFFFFF|#64748B'}"
                                                       HorizontalAlignment="Center" />
                                        </Border>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- 2B. TAB: DOCUMENT OUTLINE & BOOKMARKS -->
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Padding="12"
                              IsVisible="{Binding ActiveSidebarTab, Converter={StaticResource EqualityConverter}, ConverterParameter=Outline}">
                    <StackPanel Spacing="6">
                        <TextBlock Text="DOCUMENT OUTLINE" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource WinSubtleBrush}" Margin="2,0,0,6" LetterSpacing="0.5" />
                        <ItemsControl ItemsSource="{Binding OutlineItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="models:OutlineItem">
                                    <Button Background="Transparent"
                                            BorderThickness="0"
                                            Padding="6,4"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Left"
                                            Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).JumpToOutlineItemCommand}"
                                            CommandParameter="{Binding}">
                                        <Grid ColumnDefinitions="Auto,*">
                                            <materialIcons:MaterialIcon Grid.Column="0" Kind="BookmarkOutline" Width="14" Height="14" Foreground="{DynamicResource WinAccentBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="11.5" Foreground="{DynamicResource WinTextBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <!-- 2C. TAB: COMMENTS & REVIEW STREAM -->
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Padding="12"
                              IsVisible="{Binding ActiveSidebarTab, Converter={StaticResource EqualityConverter}, ConverterParameter=Comments}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="COMMENTS &amp; ANNOTATIONS" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource WinSubtleBrush}" Margin="2,0,0,6" LetterSpacing="0.5" />
                        <ItemsControl ItemsSource="{Binding CommentItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="models:CommentItem">
                                    <Button Background="{DynamicResource WinPanelBrush}"
                                            BorderBrush="{DynamicResource WinBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="8"
                                            Margin="0,0,0,6"
                                            HorizontalAlignment="Stretch"
                                            Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).JumpToCommentItemCommand}"
                                            CommandParameter="{Binding}">
                                        <Grid RowDefinitions="Auto,Auto,Auto">
                                            <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,4">
                                                <materialIcons:MaterialIcon Grid.Column="0" Kind="NoteTextOutline" Width="14" Height="14" Foreground="#B45309" Margin="0,0,4,0" />
                                                <TextBlock Grid.Column="1" Text="{Binding Author}" FontSize="11" FontWeight="Bold" Foreground="#78350F" />
                                                <TextBlock Grid.Column="2" Text="{Binding PageIndex, StringFormat='p. {0}'}" FontSize="9.5" Foreground="{DynamicResource WinSubtleBrush}" />
                                            </Grid>
                                            <TextBlock Grid.Row="1" Text="{Binding Text}" FontSize="10.5" Foreground="{DynamicResource WinTextBrush}" TextWrapping="Wrap" Margin="0,0,0,4" />
                                            <Border Grid.Row="2" Background="#FEF3C7" CornerRadius="3" Padding="4,1" HorizontalAlignment="Left">
                                                <TextBlock Text="{Binding Status}" FontSize="8.5" FontWeight="SemiBold" Foreground="#B45309" />
                                            </Border>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

            </Panel>

            <!-- 3. Bottom Reorder Page Actions -->
            <Border Grid.Row="2" Background="{DynamicResource WinBgBrush}" BorderBrush="{DynamicResource WinBorderBrush}" BorderThickness="0,1,0,0" Padding="10,8">
                <Grid ColumnDefinitions="*,*">
                    <Button Grid.Column="0"
                            Classes="secondary-btn"
                            Height="28"
                            Margin="0,0,3,0"
                            Command="{Binding MovePageUpCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                            <materialIcons:MaterialIcon Kind="ChevronUp" Width="14" Height="14" Foreground="{DynamicResource WinMutedBrush}" />
                            <TextBlock Text="Move Up" FontSize="11" FontWeight="Medium" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="1"
                            Classes="secondary-btn"
                            Height="28"
                            Margin="3,0,0,0"
                            Command="{Binding MovePageDownCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                            <materialIcons:MaterialIcon Kind="ChevronDown" Width="14" Height="14" Foreground="{DynamicResource WinMutedBrush}" />
                            <TextBlock Text="Move Down" FontSize="11" FontWeight="Medium" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

        </Grid>
    </Border>

    <!-- B. COLLAPSED MINI DOCK RAIL (Width 38) -->
    <Border Background="{DynamicResource WinBgBrush}" BorderBrush="{DynamicResource WinBorderBrush}" BorderThickness="0,0,1,0" Width="38"
            IsVisible="{Binding IsLeftSidebarCollapsed}">
        <Grid RowDefinitions="Auto,*,Auto" Margin="0,4">
            <!-- Top: Expand Chevron Button -->
            <StackPanel Grid.Row="0" HorizontalAlignment="Center" Spacing="4">
                <Button Classes="mini-tool-btn" Width="30" Height="30"
                        Command="{Binding ToggleLeftSidebarCommand}"
                        ToolTip.Tip="Expand Pages Sidebar (⌘B / Ctrl+B)">
                    <materialIcons:MaterialIcon Kind="ChevronRight" Width="16" Height="16" Foreground="{DynamicResource WinAccentBrush}" />
                </Button>
                <Rectangle Width="22" Height="1" Fill="{DynamicResource WinBorderBrush}" Margin="0,2" />
            </StackPanel>

            <!-- Middle: Vertical Navigation Tabs -->
            <StackPanel Grid.Row="1" HorizontalAlignment="Center" Spacing="6" Margin="0,4">
                <Button Classes="mini-tool-btn" Width="30" Height="30"
                        Classes.active="{Binding ActiveSidebarTab, Converter={StaticResource EqualityConverter}, ConverterParameter=Thumbnails}"
                        Command="{Binding SelectSidebarTabCommand}"
                        CommandParameter="{x:Static models:SidebarTabKind.Thumbnails}"
                        ToolTip.Tip="Open Page Thumbnails (⌘B)">
                    <materialIcons:MaterialIcon Kind="FileDocumentMultipleOutline" Width="16" Height="16" Foreground="{DynamicResource WinTextBrush}" />
                </Button>

                <Button Classes="mini-tool-btn" Width="30" Height="30"
                        Classes.active="{Binding ActiveSidebarTab, Converter={StaticResource EqualityConverter}, ConverterParameter=Outline}"
                        Command="{Binding SelectSidebarTabCommand}"
                        CommandParameter="{x:Static models:SidebarTabKind.Outline}"
                        ToolTip.Tip="Open Document Outline &amp; Bookmarks">
                    <materialIcons:MaterialIcon Kind="FormatListBulleted" Width="16" Height="16" Foreground="{DynamicResource WinTextBrush}" />
                </Button>

                <Button Classes="mini-tool-btn" Width="30" Height="30"
                        Classes.active="{Binding ActiveSidebarTab, Converter={StaticResource EqualityConverter}, ConverterParameter=Comments}"
                        Command="{Binding SelectSidebarTabCommand}"
                        CommandParameter="{x:Static models:SidebarTabKind.Comments}"
                        ToolTip.Tip="Open Comments &amp; Review Annotations">
                    <materialIcons:MaterialIcon Kind="CommentTextMultipleOutline" Width="16" Height="16" Foreground="{DynamicResource WinTextBrush}" />
                </Button>
            </StackPanel>

            <!-- Bottom: Page Indicator & Add Page -->
            <StackPanel Grid.Row="2" HorizontalAlignment="Center" Spacing="4">
                <Button Classes="mini-tool-btn" Width="30" Height="30" Command="{Binding AddPageCommand}" ToolTip.Tip="Add New Page (⌘⇧N)">
                    <materialIcons:MaterialIcon Kind="Plus" Width="14" Height="14" Foreground="{DynamicResource WinMutedBrush}" />
                </Button>
                <Border Background="{DynamicResource WinPanelBrush}" BorderBrush="{DynamicResource WinBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="3,2" Margin="0,2">
                    <TextBlock Text="{Binding CurrentPageNumber}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource WinAccentBrush}" HorizontalAlignment="Center" />
                </Border>
            </StackPanel>
        </Grid>
    </Border>
</Panel>
</UserControl>
