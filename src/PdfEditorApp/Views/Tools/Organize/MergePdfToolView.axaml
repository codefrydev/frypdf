<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PdfEditorApp.ViewModels.Tools.Organize"
             xmlns:models="using:PdfEditorApp.Models"
             xmlns:converters="using:PdfEditorApp.Converters"
             xmlns:shell="using:PdfEditorApp.Views.Shell"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="PdfEditorApp.Views.Tools.Organize.MergePdfToolView"
             x:DataType="vm:MergePdfToolViewModel">

    <UserControl.Resources>
        <converters:HexToBrushConverter x:Key="HexToBrushConverter" />
    </UserControl.Resources>

    <shell:PdfToolWorkspaceView>

        <!-- Toolbar primary action -->
        <shell:PdfToolWorkspaceView.ToolbarActionContent>
            <Button Command="{Binding ExecuteToolCommand}" IsEnabled="{Binding !IsRunning}" Background="#EA580C" Foreground="White" CornerRadius="8" Padding="16,8" FontWeight="Bold" FontSize="12.5" Cursor="Hand">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <materialIcons:MaterialIcon Kind="CallMerge" Width="15" Height="15" />
                    <TextBlock Text="Merge PDFs Now" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </shell:PdfToolWorkspaceView.ToolbarActionContent>

        <!-- Sidebar Options tab: status, merge sequence summary, and merge settings.
             File selection/reorder itself lives in the shared Files tab (reuses
             MoveFileUpCommand/MoveFileDownCommand/RemoveFileCommand already on the base class). -->
        <shell:PdfToolWorkspaceView.OptionsContent>
            <StackPanel Spacing="16">

                <!-- Error Banner -->
                <Border Background="#FEF2F2" BorderBrush="#FCA5A5" BorderThickness="1" CornerRadius="10" Padding="14,10" IsVisible="{Binding HasError}">
                    <Grid ColumnDefinitions="Auto,*">
                        <materialIcons:MaterialIcon Grid.Column="0" Kind="AlertCircleOutline" Width="20" Height="20" Foreground="#DC2626" Margin="0,0,10,0" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="Merge Failed" FontSize="12.5" FontWeight="Bold" Foreground="#991B1B" />
                            <TextBlock Text="{Binding ErrorMessage}" FontSize="11.5" Foreground="#B91C1C" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Saved Destination Notification Banner -->
                <Border Background="#F0FDF4" BorderBrush="#86EFAC" BorderThickness="1" CornerRadius="10" Padding="12,9" IsVisible="{Binding HasSavedNotification}">
                    <StackPanel Spacing="6">
                        <TextBlock Text="{Binding SavedNotificationMessage}" FontSize="11.5" FontWeight="SemiBold" Foreground="#166534" TextWrapping="Wrap" />
                        <Button Command="{Binding OpenOutputFolderCommand}" Background="#DCFCE7" Foreground="#166534" CornerRadius="6" Padding="10,4" FontSize="11" Cursor="Hand" HorizontalAlignment="Left">
                            View in Folder
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Success Summary -->
                <Border Background="{DynamicResource WinPanelBrush}" BorderBrush="#86EFAC" BorderThickness="1.5" CornerRadius="12" Padding="16" BoxShadow="0 6 18 #1216A34A" IsVisible="{Binding IsComplete}">
                    <StackPanel Spacing="12">
                        <StackPanel Spacing="2">
                            <TextBlock Text="PDFs merged!" FontSize="15" FontWeight="ExtraBold" Foreground="{DynamicResource WinTextBrush}" />
                            <TextBlock Text="{Binding ResultSummaryMessage}" FontSize="11.5" Foreground="{DynamicResource WinMutedBrush}" TextWrapping="Wrap" />
                        </StackPanel>

                        <Border Background="{DynamicResource WinInputBgBrush}" BorderBrush="{DynamicResource WinBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10">
                            <Grid ColumnDefinitions="*,Auto,Auto">
                                <TextBlock Grid.Column="0" Text="{Binding OutputFilePreview.FileName}" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource WinTextBrush}" TextTrimming="CharacterEllipsis" />
                                <Border Grid.Column="1" Background="#DCFCE7" CornerRadius="4" Padding="6,2" Margin="8,0">
                                    <TextBlock Text="{Binding OutputFilePreview.PageCountText}" FontSize="10.5" FontWeight="Bold" Foreground="#166534" />
                                </Border>
                                <Border Grid.Column="2" Background="{DynamicResource WinHoverBrush}" CornerRadius="4" Padding="6,2">
                                    <TextBlock Text="{Binding OutputFilePreview.FileSizeFormatted}" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource WinTextBrush}" />
                                </Border>
                            </Grid>
                        </Border>

                        <WrapPanel Orientation="Horizontal">
                            <Button Command="{Binding SaveOutputFileAsCommand}" Background="#EA580C" Foreground="White" CornerRadius="8" Padding="14,9" FontSize="12" FontWeight="Bold" Cursor="Hand" Margin="0,0,6,6">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <materialIcons:MaterialIcon Kind="ContentSaveOutline" Width="15" Height="15" />
                                    <TextBlock Text="Save As..." VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding OpenInEditorCommand}" Background="#EFF6FF" Foreground="#0F6CBD" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="8" Padding="14,9" FontSize="12" FontWeight="SemiBold" Cursor="Hand" Margin="0,0,6,6">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <materialIcons:MaterialIcon Kind="SquareEditOutline" Width="15" Height="15" />
                                    <TextBlock Text="Edit in FryPDF" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding StartOverCommand}" Background="{DynamicResource WinInputBgBrush}" BorderBrush="{DynamicResource WinBorderBrush}" BorderThickness="1" Foreground="{DynamicResource WinMutedBrush}" CornerRadius="8" Padding="14,9" FontSize="12" Cursor="Hand" Margin="0,0,6,6">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <materialIcons:MaterialIcon Kind="Refresh" Width="14" Height="14" />
                                    <TextBlock Text="Merge Another" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- Progress -->
                <Border Background="{DynamicResource WinPanelBrush}" BorderBrush="{DynamicResource WinBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14" IsVisible="{Binding IsRunning}">
                    <StackPanel Spacing="10">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <materialIcons:MaterialIcon Kind="CogSyncOutline" Width="17" Height="17" Foreground="#EA580C" />
                                <TextBlock Text="{Binding StatusMessage}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource WinTextBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding ProgressPercentage, StringFormat='{}{0:F0}%'}" FontSize="13" FontWeight="Bold" Foreground="#EA580C" VerticalAlignment="Center" />
                        </Grid>
                        <ProgressBar Value="{Binding ProgressPercentage}" Minimum="0" Maximum="100" Height="7" CornerRadius="4" Foreground="#EA580C" Background="{DynamicResource WinHoverBrush}" />
                        <Button Command="{Binding CancelExecutionCommand}" HorizontalAlignment="Right" Background="{DynamicResource WinHoverBrush}" Foreground="{DynamicResource WinMutedBrush}" CornerRadius="6" Padding="10,4" FontSize="11" Cursor="Hand">
                            Cancel Merge
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Dropzone -->
                <Border Background="{DynamicResource WinPanelBrush}" BorderBrush="{DynamicResource WinBorderBrush}" BorderThickness="2" CornerRadius="10" Padding="20,26" IsVisible="{Binding !HasSelectedFiles}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                        <Border Width="52" Height="52" Background="#FFF7ED" BorderBrush="#FED7AA" BorderThickness="1" CornerRadius="14" HorizontalAlignment="Center">
                            <materialIcons:MaterialIcon Kind="CallMerge" Width="28" Height="28" Foreground="#EA580C" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Spacing="3" HorizontalAlignment="Center">
                            <TextBlock Text="Select PDFs to combine" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource WinTextBrush}" HorizontalAlignment="Center" TextAlignment="Center" />
                            <TextBlock Text="Combine multiple documents into one" FontSize="11.5" Foreground="{DynamicResource WinMutedBrush}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Command="{Binding AddFilesCommand}" Background="#EA580C" Foreground="White" CornerRadius="8" Padding="18,9" FontSize="12.5" FontWeight="SemiBold" HorizontalAlignment="Center" Cursor="Hand">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <materialIcons:MaterialIcon Kind="FolderOpenOutline" Width="15" Height="15" />
                                <TextBlock Text="Select PDF Documents" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <TextBlock Text="Select 2 or more files" FontSize="10.5" Foreground="{DynamicResource WinSubtleBrush}" HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- Merge sequence quick summary -->
                <Border Background="#FFF7ED" BorderBrush="#FFEDD5" BorderThickness="1" CornerRadius="10" Padding="12,9" IsVisible="{Binding HasSelectedFiles}">
                    <StackPanel Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <materialIcons:MaterialIcon Kind="FileTreeOutline" Width="16" Height="16" Foreground="#EA580C" />
                            <TextBlock Text="Merge Sequence" FontSize="11.5" FontWeight="Bold" Foreground="#9A3412" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{Binding TotalSummaryText}" FontSize="11" FontWeight="Medium" Foreground="#C2410C" TextWrapping="Wrap" />
                        <TextBlock Text="Files merge in the order shown in the Files tab — use the ↑/↓ buttons there to reorder." FontSize="10.5" Foreground="#C2410C" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- Merge Engine Selection -->
                <Border Background="{DynamicResource WinPanelBrush}" BorderBrush="{DynamicResource WinBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Merge Processing Engine" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource WinTextBrush}" />
                        <RadioButton GroupName="MergeEngineGroup" Content="QuestPDF Native (High-Speed &amp; Range Support)" IsChecked="{Binding IsQuestPdfEngine}" FontSize="11.5" />
                        <RadioButton GroupName="MergeEngineGroup" Content="Standard (PdfSharp Compatible)" IsChecked="{Binding IsStandardEngine}" FontSize="11.5" />
                    </StackPanel>
                </Border>

                <!-- Merge settings -->
                <StackPanel Spacing="8">
                    <TextBlock Text="Merge Options" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource WinMutedBrush}" />
                    <CheckBox Content="Preserve Bookmarks &amp; Outlines (Coming Soon)" IsChecked="{Binding PreserveBookmarks}" IsEnabled="False" FontSize="12" />
                    <CheckBox Content="Normalize Page Dimensions (Coming Soon)" IsChecked="{Binding NormalizePageSizes}" IsEnabled="False" FontSize="12" />
                </StackPanel>

            </StackPanel>
        </shell:PdfToolWorkspaceView.OptionsContent>

    </shell:PdfToolWorkspaceView>
</UserControl>
