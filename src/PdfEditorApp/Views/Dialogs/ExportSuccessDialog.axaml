<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PdfEditorApp.ViewModels"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="PdfEditorApp.Views.Dialogs.ExportSuccessDialog"
             x:DataType="vm:MainViewModel">

    <!-- Modal Backdrop -->
    <Grid Background="#60000000">
        <!-- Dialog Card -->
        <Border Width="500"
                Background="White"
                BorderBrush="{StaticResource WinBorderBrush}"
                BorderThickness="1"
                CornerRadius="10"
                BoxShadow="0 20 60 #35000000"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Padding="24">

            <StackPanel Spacing="18">
                <!-- Header with Success Icon -->
                <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                    <Border Width="44" Height="44" Background="{StaticResource WinSuccessLightBrush}" CornerRadius="22">
                        <materialIcons:MaterialIcon Kind="CheckCircleOutline" Width="26" Height="26" Foreground="{StaticResource WinSuccessBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="PDF Exported Successfully" FontSize="16" FontWeight="Bold" Foreground="{StaticResource WinTextBrush}" />
                        <TextBlock Text="Your high-fidelity document is ready for distribution." FontSize="12" Foreground="{StaticResource WinMutedBrush}" />
                    </StackPanel>
                </StackPanel>

                <!-- File Location Info Card -->
                <Border Background="{StaticResource WinBgBrush}" BorderBrush="{StaticResource WinBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12">
                    <Grid ColumnDefinitions="Auto,*">
                        <materialIcons:MaterialIcon Grid.Column="0" Kind="FilePdfBox" Width="22" Height="22" Foreground="#DC2626" Margin="0,0,10,0" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding LastExportedFilePath}" FontSize="11.5" Foreground="{StaticResource WinTextBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <!-- Actions -->
                <Grid ColumnDefinitions="*,Auto" Margin="0,6,0,0">
                    <Button Grid.Column="1"
                            Classes="accent-btn"
                            Content="Done"
                            Padding="24,6"
                            Height="34"
                            Command="{Binding CloseExportDialogCommand}" />
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
