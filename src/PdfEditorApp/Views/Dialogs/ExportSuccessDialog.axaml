<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PdfEditorApp.ViewModels"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="PdfEditorApp.Views.Dialogs.ExportSuccessDialog"
             x:DataType="vm:MainViewModel">

    <!-- Modal Backdrop (Transparent so only the rounded card floats with no square box) -->
    <Grid Background="Transparent">
        <!-- Dialog Card -->
        <Border Width="500"
                Background="{DynamicResource M3SurfaceBrush}"
                BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource M3ShapeCornerExtraLarge}"
                BoxShadow="{StaticResource M3ElevationModalDialog}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Margin="24">

            <Border CornerRadius="{StaticResource M3ShapeCornerExtraLarge}"
                    ClipToBounds="True"
                    Padding="24">
                <StackPanel Spacing="18">
                    <!-- Header with Success Icon -->
                    <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                        <Border Width="44" Height="44" Background="{DynamicResource M3SuccessContainerBrush}" CornerRadius="{StaticResource M3ShapeCornerFull}">
                            <materialIcons:MaterialIcon Kind="CheckCircleOutline" Width="26" Height="26" Foreground="{DynamicResource M3SuccessBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="PDF Exported Successfully" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource M3OnSurfaceBrush}" />
                            <TextBlock Text="Your high-fidelity document is ready for distribution." FontSize="12" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- File Location Info Card -->
                    <Border Background="{DynamicResource M3SurfaceContainerLowBrush}" BorderBrush="{DynamicResource M3OutlineVariantBrush}" BorderThickness="1" CornerRadius="{StaticResource M3ShapeCornerMedium}" Padding="12">
                        <Grid ColumnDefinitions="Auto,*">
                            <materialIcons:MaterialIcon Grid.Column="0" Kind="FilePdfBox" Width="22" Height="22" Foreground="{DynamicResource M3ErrorBrush}" Margin="0,0,10,0" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding LastExportedFilePath}" FontSize="11.5" Foreground="{DynamicResource M3OnSurfaceBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <!-- Actions -->
                    <Grid ColumnDefinitions="*,Auto" Margin="0,6,0,0">
                        <Button Grid.Column="1"
                                Classes="m3-filled-btn"
                                Content="Done"
                                Padding="28,8"
                                Height="36"
                                CornerRadius="{StaticResource M3ShapeCornerFull}"
                                Command="{Binding CloseExportDialogCommand}" />
                    </Grid>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
