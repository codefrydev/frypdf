<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PdfEditorApp.ViewModels.Tools.Security"
             xmlns:models="using:PdfEditorApp.Models"
             xmlns:converters="using:PdfEditorApp.Converters"
             xmlns:shell="using:PdfEditorApp.Views.Shell"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="PdfEditorApp.Views.Tools.Security.CompressPdfToolView"
             x:DataType="vm:CompressPdfToolViewModel">

    <UserControl.Resources>
        <converters:HexToBrushConverter x:Key="HexToBrushConverter" />
        <converters:BooleanToBrushConverter x:Key="BooleanToBrushConverter" />
        <converters:BooleanToThicknessConverter x:Key="BooleanToThicknessConverter" />
    </UserControl.Resources>

    <shell:PdfToolWorkspaceView>

        <!-- Toolbar primary action -->
        <shell:PdfToolWorkspaceView.ToolbarActionContent>
            <Button Command="{Binding ExecuteToolCommand}" IsEnabled="{Binding !IsRunning}" Background="#DC2626" Foreground="White" CornerRadius="8" Padding="16,8" FontWeight="Bold" FontSize="12.5" Cursor="Hand">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <materialIcons:MaterialIcon Kind="ArrowCollapseVertical" Width="15" Height="15" />
                    <TextBlock Text="Compress PDF" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </shell:PdfToolWorkspaceView.ToolbarActionContent>

        <!-- Sidebar Options tab: status, document selection, and compression settings -->
        <shell:PdfToolWorkspaceView.OptionsContent>
            <StackPanel Spacing="16">

                <!-- Error Banner -->
                <Border Background="#FEF2F2" BorderBrush="#FCA5A5" BorderThickness="1" CornerRadius="10" Padding="14,10" IsVisible="{Binding HasError}">
                    <Grid ColumnDefinitions="Auto,*">
                        <materialIcons:MaterialIcon Grid.Column="0" Kind="AlertCircleOutline" Width="20" Height="20" Foreground="#DC2626" Margin="0,0,10,0" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="Compression Failed" FontSize="12.5" FontWeight="Bold" Foreground="#991B1B" />
                            <TextBlock Text="{Binding ErrorMessage}" FontSize="11.5" Foreground="#B91C1C" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Saved Destination Notification Banner -->
                <Border Background="#F0FDF4" BorderBrush="#86EFAC" BorderThickness="1" CornerRadius="10" Padding="12,9" IsVisible="{Binding HasSavedNotification}">
                    <StackPanel Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <materialIcons:MaterialIcon Kind="CheckCircleOutline" Width="18" Height="18" Foreground="#16A34A" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding SavedNotificationMessage}" FontSize="11.5" FontWeight="SemiBold" Foreground="#166534" VerticalAlignment="Center" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Command="{Binding OpenOutputFolderCommand}" Background="#DCFCE7" Foreground="#166534" CornerRadius="6" Padding="10,4" FontSize="11" Cursor="Hand" HorizontalAlignment="Left">
                            View in Folder
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Success Summary -->
                <Border Background="{DynamicResource WinPanelBrush}" BorderBrush="#86EFAC" BorderThickness="1.5" CornerRadius="12" Padding="16" BoxShadow="0 6 18 #1216A34A" IsVisible="{Binding IsComplete}">
                    <StackPanel Spacing="12">
                        <StackPanel Spacing="2">
                            <TextBlock Text="PDF compressed!" FontSize="15" FontWeight="ExtraBold" Foreground="{DynamicResource WinTextBrush}" />
                            <TextBlock Text="{Binding ResultSummaryMessage}" FontSize="11.5" Foreground="{DynamicResource WinMutedBrush}" TextWrapping="Wrap" />
                        </StackPanel>

                        <Border Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1.5" CornerRadius="10" Padding="12" IsVisible="{Binding HasSizeReduction}">
                            <StackPanel Spacing="2">
                                <TextBlock Text="{Binding SizeReductionPercentage, StringFormat='{}{0:F0}% smaller'}" FontSize="14" FontWeight="Bold" Foreground="#166534" />
                                <TextBlock Text="{Binding SizeComparisonText}" FontSize="11.5" FontWeight="SemiBold" Foreground="#15803D" />
                            </StackPanel>
                        </Border>

                        <WrapPanel Orientation="Horizontal">
                            <Button Command="{Binding SaveOutputFileAsCommand}" Background="#DC2626" Foreground="White" CornerRadius="8" Padding="14,9" FontSize="12" FontWeight="Bold" Cursor="Hand" Margin="0,0,6,6">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <materialIcons:MaterialIcon Kind="Download" Width="15" Height="15" />
                                    <TextBlock Text="Save As..." VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding OpenInEditorCommand}" Background="#EFF6FF" Foreground="#0F6CBD" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="8" Padding="14,9" FontSize="12" FontWeight="SemiBold" Cursor="Hand" Margin="0,0,6,6">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <materialIcons:MaterialIcon Kind="SquareEditOutline" Width="15" Height="15" />
                                    <TextBlock Text="Edit in FryPDF" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding StartOverCommand}" Background="{DynamicResource WinInputBgBrush}" BorderBrush="{DynamicResource WinBorderBrush}" BorderThickness="1" Foreground="{DynamicResource WinMutedBrush}" CornerRadius="8" Padding="14,9" FontSize="12" Cursor="Hand" Margin="0,0,6,6">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <materialIcons:MaterialIcon Kind="Refresh" Width="14" Height="14" />
                                    <TextBlock Text="Compress Another" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </WrapPanel>

                        <StackPanel Spacing="8">
                            <TextBlock Text="Continue to..." FontSize="12" FontWeight="Bold" Foreground="{DynamicResource WinTextBrush}" />
                            <WrapPanel Orientation="Horizontal">
                                <Button Classes="mini-tool-btn" Command="{Binding NavigateToToolCommand}" CommandParameter="MergePdf" Margin="0,0,6,6" Background="{DynamicResource WinInputBgBrush}" BorderBrush="{DynamicResource WinBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10,7">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <materialIcons:MaterialIcon Kind="CallMerge" Width="14" Height="14" Foreground="#E11D48" />
                                        <TextBlock Text="Merge PDF" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource WinTextBrush}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Classes="mini-tool-btn" Command="{Binding NavigateToToolCommand}" CommandParameter="Watermark" Margin="0,0,6,6" Background="{DynamicResource WinInputBgBrush}" BorderBrush="{DynamicResource WinBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10,7">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <materialIcons:MaterialIcon Kind="Watermark" Width="14" Height="14" Foreground="#D97706" />
                                        <TextBlock Text="Add Watermark" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource WinTextBrush}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Classes="mini-tool-btn" Command="{Binding NavigateToToolCommand}" CommandParameter="ProtectPdf" Margin="0,0,6,6" Background="{DynamicResource WinInputBgBrush}" BorderBrush="{DynamicResource WinBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10,7">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <materialIcons:MaterialIcon Kind="ShieldLockOutline" Width="14" Height="14" Foreground="#059669" />
                                        <TextBlock Text="Protect PDF" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource WinTextBrush}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </WrapPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Progress -->
                <Border Background="{DynamicResource WinPanelBrush}" BorderBrush="{DynamicResource WinBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14" IsVisible="{Binding IsRunning}">
                    <StackPanel Spacing="10">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource WinTextBrush}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding ProgressPercentage, StringFormat='{}{0:F0}%'}" FontSize="13" FontWeight="Bold" Foreground="#16A34A" VerticalAlignment="Center" />
                        </Grid>
                        <ProgressBar Value="{Binding ProgressPercentage}" Minimum="0" Maximum="100" Height="7" CornerRadius="4" Foreground="#16A34A" Background="{DynamicResource WinHoverBrush}" />
                        <Button Command="{Binding CancelExecutionCommand}" HorizontalAlignment="Right" Background="{DynamicResource WinHoverBrush}" Foreground="{DynamicResource WinMutedBrush}" CornerRadius="6" Padding="10,4" FontSize="11" Cursor="Hand">
                            Cancel
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Dropzone -->
                <Border Background="{DynamicResource WinPanelBrush}" BorderBrush="{DynamicResource WinBorderBrush}" BorderThickness="2" CornerRadius="10" Padding="20,26" IsVisible="{Binding !HasSelectedFiles}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                        <Border Width="52" Height="52" Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="14" HorizontalAlignment="Center">
                            <materialIcons:MaterialIcon Kind="ArrowCollapseVertical" Width="28" Height="28" Foreground="#16A34A" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Spacing="3" HorizontalAlignment="Center">
                            <TextBlock Text="Select PDF to Compress" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource WinTextBrush}" HorizontalAlignment="Center" TextAlignment="Center" />
                            <TextBlock Text="Reduce file size while preserving clarity" FontSize="11.5" Foreground="{DynamicResource WinMutedBrush}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Command="{Binding AddFilesCommand}" Background="#16A34A" Foreground="White" CornerRadius="8" Padding="18,9" FontSize="12.5" FontWeight="SemiBold" HorizontalAlignment="Center" Cursor="Hand">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <materialIcons:MaterialIcon Kind="FolderOpenOutline" Width="15" Height="15" />
                                <TextBlock Text="Select PDF Document" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Selected document -->
                <Border Background="{DynamicResource WinPanelBrush}" BorderBrush="{DynamicResource WinBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14" IsVisible="{Binding HasSelectedFiles}">
                    <StackPanel Spacing="8">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="Document to Compress" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource WinTextBrush}" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Command="{Binding ClearFilesCommand}" Background="Transparent" BorderThickness="0" Foreground="#EF4444" FontSize="11" Cursor="Hand">
                                Change
                            </Button>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding SelectedFilePreviewItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="models:PdfFilePreviewItem">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="{Binding FileName}" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource WinTextBrush}" TextTrimming="CharacterEllipsis" />
                                        <WrapPanel Orientation="Horizontal">
                                            <Border Background="#DCFCE7" CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                                                <TextBlock Text="{Binding PageCountText}" FontSize="10.5" FontWeight="SemiBold" Foreground="#166534" />
                                            </Border>
                                            <Border Background="{DynamicResource WinHoverBrush}" CornerRadius="4" Padding="6,2">
                                                <TextBlock Text="{Binding FileSizeFormatted}" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource WinTextBrush}" />
                                            </Border>
                                        </WrapPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Compression settings -->
                <StackPanel Spacing="3">
                    <TextBlock Text="Compression level" FontSize="14" FontWeight="ExtraBold" Foreground="{DynamicResource WinTextBrush}" />
                    <TextBlock Text="Choose a preset or fine-tune with live feedback" FontSize="11" Foreground="{DynamicResource WinMutedBrush}" TextWrapping="Wrap" />
                </StackPanel>

                <!-- 1. EXTREME COMPRESSION PRESET -->
                <Border Background="{Binding IsExtremeCompression, Converter={StaticResource BooleanToBrushConverter}, ConverterParameter='#EFF6FF|#FFFFFF'}"
                        BorderBrush="{Binding IsExtremeCompression, Converter={StaticResource BooleanToBrushConverter}, ConverterParameter='#3B82F6|#E2E8F0'}"
                        BorderThickness="{Binding IsExtremeCompression, Converter={StaticResource BooleanToThicknessConverter}, ConverterParameter='2|1'}"
                        CornerRadius="10" Padding="12" Cursor="Hand">
                    <Button Command="{Binding SelectPresetCommand}" CommandParameter="extreme" Background="Transparent" Padding="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="EXTREME COMPRESSION" FontSize="11.5" FontWeight="ExtraBold" Foreground="{Binding IsExtremeCompression, Converter={StaticResource BooleanToBrushConverter}, ConverterParameter='#1D4ED8|#DC2626'}" LetterSpacing="0.4" />
                                <TextBlock Text="Less quality, high compression (~75%)" FontSize="10.5" Foreground="{DynamicResource WinMutedBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                            <Border Grid.Column="1" Width="20" Height="20" CornerRadius="10"
                                    Background="{Binding IsExtremeCompression, Converter={StaticResource BooleanToBrushConverter}, ConverterParameter='#16A34A|#F1F5F9'}"
                                    VerticalAlignment="Center">
                                <materialIcons:MaterialIcon Kind="Check" Width="13" Height="13" Foreground="White" IsVisible="{Binding IsExtremeCompression}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                    </Button>
                </Border>

                <!-- 2. RECOMMENDED COMPRESSION PRESET (DEFAULT) -->
                <Border Background="{Binding IsRecommendedCompression, Converter={StaticResource BooleanToBrushConverter}, ConverterParameter='#EFF6FF|#FFFFFF'}"
                        BorderBrush="{Binding IsRecommendedCompression, Converter={StaticResource BooleanToBrushConverter}, ConverterParameter='#3B82F6|#E2E8F0'}"
                        BorderThickness="{Binding IsRecommendedCompression, Converter={StaticResource BooleanToThicknessConverter}, ConverterParameter='2|1'}"
                        CornerRadius="10" Padding="12" Cursor="Hand">
                    <Button Command="{Binding SelectPresetCommand}" CommandParameter="recommended" Background="Transparent" Padding="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="2">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="RECOMMENDED" FontSize="11.5" FontWeight="ExtraBold" Foreground="{Binding IsRecommendedCompression, Converter={StaticResource BooleanToBrushConverter}, ConverterParameter='#1D4ED8|#DC2626'}" LetterSpacing="0.4" />
                                    <Border Background="#DCFCE7" CornerRadius="4" Padding="5,1">
                                        <TextBlock Text="DEFAULT" FontSize="8" FontWeight="Bold" Foreground="#166534" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="Good quality, good compression (~70%)" FontSize="10.5" Foreground="{DynamicResource WinMutedBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                            <Border Grid.Column="1" Width="20" Height="20" CornerRadius="10"
                                    Background="{Binding IsRecommendedCompression, Converter={StaticResource BooleanToBrushConverter}, ConverterParameter='#16A34A|#F1F5F9'}"
                                    VerticalAlignment="Center">
                                <materialIcons:MaterialIcon Kind="Check" Width="13" Height="13" Foreground="White" IsVisible="{Binding IsRecommendedCompression}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                    </Button>
                </Border>

                <!-- 3. LESS COMPRESSION PRESET -->
                <Border Background="{Binding IsLessCompression, Converter={StaticResource BooleanToBrushConverter}, ConverterParameter='#EFF6FF|#FFFFFF'}"
                        BorderBrush="{Binding IsLessCompression, Converter={StaticResource BooleanToBrushConverter}, ConverterParameter='#3B82F6|#E2E8F0'}"
                        BorderThickness="{Binding IsLessCompression, Converter={StaticResource BooleanToThicknessConverter}, ConverterParameter='2|1'}"
                        CornerRadius="10" Padding="12" Cursor="Hand">
                    <Button Command="{Binding SelectPresetCommand}" CommandParameter="less" Background="Transparent" Padding="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="LESS COMPRESSION" FontSize="11.5" FontWeight="ExtraBold" Foreground="{Binding IsLessCompression, Converter={StaticResource BooleanToBrushConverter}, ConverterParameter='#1D4ED8|#DC2626'}" LetterSpacing="0.4" />
                                <TextBlock Text="High quality, less compression (~40%)" FontSize="10.5" Foreground="{DynamicResource WinMutedBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                            <Border Grid.Column="1" Width="20" Height="20" CornerRadius="10"
                                    Background="{Binding IsLessCompression, Converter={StaticResource BooleanToBrushConverter}, ConverterParameter='#16A34A|#F1F5F9'}"
                                    VerticalAlignment="Center">
                                <materialIcons:MaterialIcon Kind="Check" Width="13" Height="13" Foreground="White" IsVisible="{Binding IsLessCompression}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                    </Button>
                </Border>

                <!-- 4. CUSTOM / FINE-TUNE PRESET -->
                <Border Background="{Binding IsCustomMode, Converter={StaticResource BooleanToBrushConverter}, ConverterParameter='#EFF6FF|#FFFFFF'}"
                        BorderBrush="{Binding IsCustomMode, Converter={StaticResource BooleanToBrushConverter}, ConverterParameter='#3B82F6|#E2E8F0'}"
                        BorderThickness="{Binding IsCustomMode, Converter={StaticResource BooleanToThicknessConverter}, ConverterParameter='2|1'}"
                        CornerRadius="10" Padding="12" Cursor="Hand">
                    <Button Command="{Binding SelectPresetCommand}" CommandParameter="custom" Background="Transparent" Padding="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="CUSTOM / EXPERT" FontSize="11.5" FontWeight="ExtraBold" Foreground="{Binding IsCustomMode, Converter={StaticResource BooleanToBrushConverter}, ConverterParameter='#1D4ED8|#0F172A'}" LetterSpacing="0.4" />
                                <TextBlock Text="Manual sliders for DPI, quality, color" FontSize="10.5" Foreground="{DynamicResource WinMutedBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                            <Border Grid.Column="1" Width="20" Height="20" CornerRadius="10"
                                    Background="{Binding IsCustomMode, Converter={StaticResource BooleanToBrushConverter}, ConverterParameter='#16A34A|#F1F5F9'}"
                                    VerticalAlignment="Center">
                                <materialIcons:MaterialIcon Kind="Tune" Width="13" Height="13" Foreground="{Binding IsCustomMode, Converter={StaticResource BooleanToBrushConverter}, ConverterParameter='#FFFFFF|#64748B'}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                    </Button>
                </Border>

                <!-- Live quality feedback -->
                <Border Background="{DynamicResource WinInputBgBrush}" BorderBrush="{DynamicResource WinBorderBrush}" BorderThickness="1.5" CornerRadius="10" Padding="12,10">
                    <Grid ColumnDefinitions="Auto,*">
                        <materialIcons:MaterialIcon Grid.Column="0" Kind="InformationOutline" Width="17" Height="17" Foreground="#2563EB" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding QualityFeedbackMessage}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource WinTextBrush}" TextWrapping="Wrap" VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <!-- Fine-tuning -->
                <Border Background="{DynamicResource WinInputBgBrush}" BorderBrush="{DynamicResource WinBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14,12">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Interactive Fine-Tuning" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource WinTextBrush}" />

                        <StackPanel Spacing="4">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="Image Resolution (DPI):" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource WinMutedBrush}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding ImageQualityDpi, StringFormat='{}{0} DPI'}" FontSize="11.5" FontWeight="Bold" Foreground="#0F6CBD" VerticalAlignment="Center" />
                            </Grid>
                            <Slider Value="{Binding ImageQualityDpi}" Minimum="50" Maximum="350" SmallChange="5" LargeChange="25" />
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="JPEG Compression Quality:" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource WinMutedBrush}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding JpegQuality, StringFormat='{}{0}%'}" FontSize="11.5" FontWeight="Bold" Foreground="#0F6CBD" VerticalAlignment="Center" />
                            </Grid>
                            <Slider Value="{Binding JpegQuality}" Minimum="20" Maximum="100" SmallChange="2" LargeChange="10" />
                        </StackPanel>

                        <Border Background="{DynamicResource WinPanelBrush}" BorderBrush="{DynamicResource WinBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10,8">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock Text="Convert to Grayscale" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource WinTextBrush}" />
                                    <TextBlock Text="Saves extra ~20-30% on scans" FontSize="9.5" Foreground="{DynamicResource WinMutedBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" IsChecked="{Binding ConvertToGrayscale}" OnContent="" OffContent="" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <Expander Header="Advanced PDF Stream Settings" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource WinMutedBrush}">
                    <StackPanel Spacing="8" Margin="0,4,0,0">
                        <CheckBox Content="Compress Content Streams &amp; Fonts" IsChecked="{Binding CompressStreams}" FontSize="11.5" />
                        <CheckBox Content="Remove Duplicate Objects &amp; Fonts" IsChecked="{Binding RemoveDuplicateObjects}" FontSize="11.5" />
                        <CheckBox Content="Strip Metadata &amp; Bookmarks" IsChecked="{Binding RemoveMetadata}" FontSize="11.5" />
                        <CheckBox Content="Linearize for Fast Web View (QuestPDF Native)" IsChecked="{Binding LinearizeForWeb}" FontSize="11.5" />
                    </StackPanel>
                </Expander>

                <TextBlock Text="Safe &amp; privacy-first compression runs 100% locally on your device" FontSize="10.5" Foreground="{DynamicResource WinSubtleBrush}" TextAlignment="Center" TextWrapping="Wrap" />

            </StackPanel>
        </shell:PdfToolWorkspaceView.OptionsContent>

    </shell:PdfToolWorkspaceView>
</UserControl>
