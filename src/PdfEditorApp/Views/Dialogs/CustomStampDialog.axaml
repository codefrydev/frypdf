<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PdfEditorApp.ViewModels"
             xmlns:converters="using:PdfEditorApp.Converters"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="PdfEditorApp.Views.Dialogs.CustomStampDialog"
             x:DataType="vm:MainViewModel">

    <UserControl.Resources>
        <converters:HexToBrushConverter x:Key="HexToBrushConverter" />
    </UserControl.Resources>

    <!-- Modal Backdrop (Transparent so only the rounded card floats) -->
    <Grid Background="Transparent">
        <!-- Dialog Card -->
        <Border Width="600"
                Background="{DynamicResource WinPanelBrush}"
                BorderBrush="{DynamicResource WinBorderBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource M3ShapeCornerExtraLarge}"
                BoxShadow="{StaticResource M3ElevationModalDialog}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Margin="24"
                Padding="24">

            <Grid RowDefinitions="Auto,*,Auto">
                <!-- Header -->
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,16">
                    <StackPanel Grid.Column="0" Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Border Width="30" Height="30" Background="{DynamicResource WinAccentLightBrush}" CornerRadius="{StaticResource M3ShapeCornerSmall}">
                                <materialIcons:MaterialIcon Kind="CertificateOutline" Width="18" Height="18" Foreground="{DynamicResource WinAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Custom Stamp Studio" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource WinTextBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="Create customized legal, corporate, or certification stamps with live timestamp." FontSize="11.5" Foreground="{DynamicResource WinMutedBrush}" />
                    </StackPanel>

                    <Button Grid.Column="1"
                            Classes="mini-tool-btn"
                            Width="30" Height="30"
                            Command="{Binding CloseCustomStampDialogCommand}">
                        <materialIcons:MaterialIcon Kind="Close" Width="16" Height="16" Foreground="{DynamicResource WinMutedBrush}" />
                    </Button>
                </Grid>

                <!-- Body -->
                <StackPanel Grid.Row="1" Spacing="16">

                    <!-- Custom Stamp Label -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="Stamp Header Text" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource WinTextBrush}" />
                        <TextBox Text="{Binding CustomStampText, Mode=TwoWay}"
                                 Height="36" FontSize="13" CornerRadius="{StaticResource M3ShapeCornerSmall}"
                                 Padding="10,8" PlaceholderText="e.g. CERTIFIED TRUE COPY, REVIEWED &amp; APPROVED..." />

                        <WrapPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <Button Classes="secondary-btn" Height="24" Padding="6,2" Margin="0,0,6,0" Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).AddStampElementCommand}" CommandParameter="APPROVED">
                                <TextBlock Text="APPROVED" FontSize="10" />
                            </Button>
                            <Button Classes="secondary-btn" Height="24" Padding="6,2" Margin="0,0,6,0" Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).AddStampElementCommand}" CommandParameter="CONFIDENTIAL">
                                <TextBlock Text="CONFIDENTIAL" FontSize="10" />
                            </Button>
                            <Button Classes="secondary-btn" Height="24" Padding="6,2" Margin="0,0,6,0" Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).AddStampElementCommand}" CommandParameter="FINAL">
                                <TextBlock Text="FINAL" FontSize="10" />
                            </Button>
                            <Button Classes="secondary-btn" Height="24" Padding="6,2" Margin="0,0,6,0" Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).AddStampElementCommand}" CommandParameter="SIGNHERE">
                                <TextBlock Text="SIGN HERE" FontSize="10" />
                            </Button>
                        </WrapPanel>
                    </StackPanel>

                    <!-- Stamp Color Choice -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="Border &amp; Text Color" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource WinTextBrush}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Width="26" Height="26" CornerRadius="{StaticResource M3ShapeCornerFull}" Background="{DynamicResource M3PrimaryBrush}" Command="{Binding PlaceCustomStampCommand}" />
                            <Button Width="26" Height="26" CornerRadius="{StaticResource M3ShapeCornerFull}" Background="{DynamicResource M3SuccessBrush}" />
                            <Button Width="26" Height="26" CornerRadius="{StaticResource M3ShapeCornerFull}" Background="{DynamicResource M3ErrorBrush}" />
                            <Button Width="26" Height="26" CornerRadius="{StaticResource M3ShapeCornerFull}" Background="{DynamicResource M3WarningBrush}" />
                            <Button Width="26" Height="26" CornerRadius="{StaticResource M3ShapeCornerFull}" Background="{DynamicResource M3TertiaryBrush}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Stamp Live Preview -->
                    <Border Background="{DynamicResource WinInputBgBrush}" BorderBrush="{DynamicResource WinBorderBrush}" BorderThickness="1" CornerRadius="{StaticResource M3ShapeCornerSmall}" Padding="16">
                        <StackPanel Spacing="6" HorizontalAlignment="Center">
                            <TextBlock Text="Live Stamp Preview" FontSize="10.5" Foreground="{DynamicResource WinMutedBrush}" HorizontalAlignment="Center" />
                            <Border Width="240" Height="65" CornerRadius="{StaticResource M3ShapeCornerSmall}" BorderThickness="2" BorderBrush="{DynamicResource M3PrimaryBrush}" Background="{DynamicResource WinPanelBrush}" Padding="6" HorizontalAlignment="Center">
                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="{Binding CustomStampText}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource M3PrimaryBrush}" HorizontalAlignment="Center" />
                                    <TextBlock Text="2026-08-29 10:30 UTC" FontSize="9.5" FontWeight="Medium" Foreground="{DynamicResource M3PrimaryBrush}" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Footer Buttons -->
                <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto" Margin="0,20,0,0">
                    <Button Grid.Column="0" Classes="secondary-btn" Height="34" Padding="14,0" Command="{Binding CloseCustomStampDialogCommand}">
                        <TextBlock Text="Cancel" FontSize="12" />
                    </Button>

                    <Button Grid.Column="2" Classes="primary-btn" Height="34" Padding="18,0" Command="{Binding PlaceCustomStampCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <materialIcons:MaterialIcon Kind="CertificateOutline" Width="15" Height="15" Foreground="{DynamicResource M3OnPrimaryBrush}" />
                            <TextBlock Text="Place Stamp on Page" FontSize="12" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
