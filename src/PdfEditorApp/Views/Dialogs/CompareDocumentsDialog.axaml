<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PdfEditorApp.ViewModels"
             xmlns:models="using:PdfEditorApp.Models"
             xmlns:converters="using:PdfEditorApp.Converters"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="PdfEditorApp.Views.Dialogs.CompareDocumentsDialog"
             x:DataType="vm:MainViewModel">

    <UserControl.Resources>
        <converters:HexToBrushConverter x:Key="HexToBrushConverter" />
    </UserControl.Resources>

    <!-- Modal Backdrop -->
    <Grid Background="#60000000">
        <Border Width="720"
                MaxHeight="620"
                Background="White"
                BorderBrush="{StaticResource WinBorderBrush}"
                BorderThickness="1"
                CornerRadius="10"
                BoxShadow="0 20 60 #35000000"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Padding="24">

            <Grid RowDefinitions="Auto,*,Auto">
                <!-- Header -->
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,16">
                    <StackPanel Grid.Column="0" Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Border Width="30" Height="30" Background="#EFF6FF" CornerRadius="6">
                                <materialIcons:MaterialIcon Kind="FileCompare" Width="18" Height="18" Foreground="#0F6CBD" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Document Comparison &amp; Diff Report" FontSize="17" FontWeight="Bold" Foreground="{StaticResource WinTextBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="Detailed comparison matrix between document revisions." FontSize="11.5" Foreground="{StaticResource WinMutedBrush}" />
                    </StackPanel>

                    <Button Grid.Column="1"
                            Classes="mini-tool-btn"
                            Width="30" Height="30"
                            Command="{Binding CloseCompareDialogCommand}">
                        <materialIcons:MaterialIcon Kind="Close" Width="16" Height="16" Foreground="{StaticResource WinMutedBrush}" />
                    </Button>
                </Grid>

                <!-- Body -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="440">
                    <StackPanel Spacing="14">

                        <!-- Summary Cards Row -->
                        <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="8">
                            <Border Grid.Column="0" Background="{StaticResource WinBgBrush}" BorderBrush="{StaticResource WinBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="TOTAL DIFFS" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource WinMutedBrush}" />
                                    <TextBlock Text="{Binding ActiveComparisonReport.TotalDifferencesCount, FallbackValue=0}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource WinTextBrush}" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="8" Padding="10">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="ADDITIONS" FontSize="9.5" FontWeight="Bold" Foreground="#16A34A" />
                                    <TextBlock Text="{Binding ActiveComparisonReport.AdditionsCount, FallbackValue=0}" FontSize="18" FontWeight="Bold" Foreground="#16A34A" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="8" Padding="10">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="DELETIONS" FontSize="9.5" FontWeight="Bold" Foreground="#DC2626" />
                                    <TextBlock Text="{Binding ActiveComparisonReport.DeletionsCount, FallbackValue=0}" FontSize="18" FontWeight="Bold" Foreground="#DC2626" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="3" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="8" Padding="10">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="MODIFICATIONS" FontSize="9.5" FontWeight="Bold" Foreground="#0F6CBD" />
                                    <TextBlock Text="{Binding ActiveComparisonReport.ModificationsCount, FallbackValue=0}" FontSize="18" FontWeight="Bold" Foreground="#0F6CBD" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Differences Items List -->
                        <Border Background="{StaticResource WinBgBrush}" BorderBrush="{StaticResource WinBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10">
                            <StackPanel Spacing="8">
                                <TextBlock Text="ITEMIZED AUDIT TRAIL" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource WinMutedBrush}" LetterSpacing="0.5" />

                                <ItemsControl ItemsSource="{Binding ActiveComparisonReport.Differences}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="models:DocumentDifferenceItem">
                                            <Border Background="White" BorderBrush="{StaticResource WinBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,6">
                                                <Grid ColumnDefinitions="Auto,*,Auto">
                                                    <!-- Diff Icon Badge -->
                                                    <Border Grid.Column="0" Width="28" Height="28" CornerRadius="14" Background="{Binding BadgeColorHex, Converter={StaticResource HexToBrushConverter}}" Margin="0,0,10,0">
                                                        <materialIcons:MaterialIcon Kind="{Binding BadgeIcon}" Width="16" Height="16" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>

                                                    <!-- Description & Old/New details -->
                                                    <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Description}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource WinTextBrush}" />
                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                            <TextBlock Text="{Binding ElementKindDisplay}" FontSize="10.5" Foreground="{StaticResource WinMutedBrush}" />
                                                            <TextBlock Text="•" FontSize="10" Foreground="{StaticResource WinSubtleBrush}" />
                                                            <TextBlock Text="{Binding PageNumber, StringFormat='Page {0}'}" FontSize="10.5" Foreground="{StaticResource WinMutedBrush}" />
                                                        </StackPanel>
                                                    </StackPanel>

                                                    <!-- Diff Type Badge -->
                                                    <Border Grid.Column="2" Background="{StaticResource WinHoverBrush}" BorderBrush="{StaticResource WinBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding DiffType}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource WinMutedBrush}" />
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>

                <!-- Footer Actions -->
                <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,18,0,0">
                    <Button Grid.Column="1" Classes="accent-btn" Height="32" Padding="16,0" Command="{Binding CloseCompareDialogCommand}">
                        <TextBlock Text="Done" FontSize="12" FontWeight="SemiBold" />
                    </Button>
                </Grid>

            </Grid>
        </Border>
    </Grid>

</UserControl>
