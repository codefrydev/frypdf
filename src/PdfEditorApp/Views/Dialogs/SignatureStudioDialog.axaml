<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PdfEditorApp.ViewModels"
             xmlns:models="using:PdfEditorApp.Models"
             xmlns:converters="using:PdfEditorApp.Converters"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="PdfEditorApp.Views.Dialogs.SignatureStudioDialog"
             x:DataType="vm:MainViewModel">

    <UserControl.Resources>
        <converters:EqualityToBooleanConverter x:Key="EqualityConverter" />
    </UserControl.Resources>

    <!-- Modal Backdrop -->
    <Grid Background="#60000000">
        <!-- Dialog Card -->
        <Border Width="680"
                Background="{DynamicResource WinPanelBrush}"
                BorderBrush="{DynamicResource WinBorderBrush}"
                BorderThickness="1"
                CornerRadius="10"
                BoxShadow="0 20 60 #35000000"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Padding="24">

            <Grid RowDefinitions="Auto,*,Auto">
                <!-- Header -->
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,16">
                    <StackPanel Grid.Column="0" Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Border Width="30" Height="30" Background="{DynamicResource WinAccentLightBrush}" CornerRadius="6">
                                <materialIcons:MaterialIcon Kind="Draw" Width="18" Height="18" Foreground="{DynamicResource WinAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Fill &amp; Sign: Digital Signature Studio" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource WinTextBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="Create a legally binding handwritten cursive signature or monogram initial stamp." FontSize="11.5" Foreground="{DynamicResource WinMutedBrush}" />
                    </StackPanel>

                    <Button Grid.Column="1"
                            Classes="mini-tool-btn"
                            Width="30" Height="30"
                            Command="{Binding CloseSignatureStudioCommand}">
                        <materialIcons:MaterialIcon Kind="Close" Width="16" Height="16" Foreground="{DynamicResource WinMutedBrush}" />
                    </Button>
                </Grid>

                <!-- Signature Body -->
                <StackPanel Grid.Row="1" Spacing="16">
                    <!-- Signer Name Input -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="Signer Full Legal Name" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource WinTextBrush}" />
                        <TextBox Text="{Binding SignatureSignerName, Mode=TwoWay}"
                                 Height="36" FontSize="13" CornerRadius="6"
                                 Padding="10,8" PlaceholderText="e.g. Johnathan A. Doe" />
                    </StackPanel>

                    <!-- Style Selection Cards (4 Distinct Cursive Styles) -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="Choose Calligraphy &amp; Handwriting Style" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource WinTextBrush}" />
                        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto">

                            <!-- Style 1: Executive Elegance -->
                            <Button Grid.Row="0" Grid.Column="0" Margin="4" Padding="12"
                                    Classes="secondary-btn" Height="70"
                                    Classes.active="{Binding SelectedSignatureStyle, Converter={StaticResource EqualityConverter}, ConverterParameter=CursiveElegance}"
                                    Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).PlaceSignatureFromStudioCommand}">
                                <StackPanel Spacing="3" HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding SignatureSignerName}" FontFamily="Georgia" FontStyle="Italic" FontSize="20" FontWeight="SemiBold" Foreground="#0F2942" HorizontalAlignment="Center" />
                                    <TextBlock Text="Executive Elegance (Formal)" FontSize="9.5" Foreground="{DynamicResource WinMutedBrush}" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <!-- Style 2: Classic Script -->
                            <Button Grid.Row="0" Grid.Column="1" Margin="4" Padding="12"
                                    Classes="secondary-btn" Height="70"
                                    Classes.active="{Binding SelectedSignatureStyle, Converter={StaticResource EqualityConverter}, ConverterParameter=ClassicScript}"
                                    Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).PlaceSignatureFromStudioCommand}">
                                <StackPanel Spacing="3" HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding SignatureSignerName}" FontFamily="Times New Roman" FontStyle="Italic" FontSize="20" FontWeight="Bold" Foreground="#0F6CBD" HorizontalAlignment="Center" />
                                    <TextBlock Text="Classic Fountain Blue" FontSize="9.5" Foreground="{DynamicResource WinMutedBrush}" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <!-- Style 3: Modern Casual -->
                            <Button Grid.Row="1" Grid.Column="0" Margin="4" Padding="12"
                                    Classes="secondary-btn" Height="70"
                                    Classes.active="{Binding SelectedSignatureStyle, Converter={StaticResource EqualityConverter}, ConverterParameter=SignatureCasual}"
                                    Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).PlaceSignatureFromStudioCommand}">
                                <StackPanel Spacing="3" HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding SignatureSignerName}" FontFamily="Segoe UI" FontStyle="Italic" FontSize="19" FontWeight="Medium" Foreground="{DynamicResource WinTextBrush}" HorizontalAlignment="Center" />
                                    <TextBlock Text="Modern Minimalist" FontSize="9.5" Foreground="{DynamicResource WinMutedBrush}" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <!-- Style 4: Handwritten Legal -->
                            <Button Grid.Row="1" Grid.Column="1" Margin="4" Padding="12"
                                    Classes="secondary-btn" Height="70"
                                    Classes.active="{Binding SelectedSignatureStyle, Converter={StaticResource EqualityConverter}, ConverterParameter=ModernHandwriting}"
                                    Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).PlaceSignatureFromStudioCommand}">
                                <StackPanel Spacing="3" HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding SignatureSignerName}" FontFamily="Arial" FontStyle="Italic" FontSize="19" FontWeight="SemiBold" Foreground="#003366" HorizontalAlignment="Center" />
                                    <TextBlock Text="Legal Navy Script" FontSize="9.5" Foreground="{DynamicResource WinMutedBrush}" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>

                    <!-- Preview Badge -->
                    <Border Background="{DynamicResource WinInputBgBrush}" BorderBrush="{DynamicResource WinBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <materialIcons:MaterialIcon Grid.Column="0" Kind="ShieldCheck" Width="24" Height="24" Foreground="{DynamicResource WinSuccessBrush}" VerticalAlignment="Center" Margin="0,0,12,0" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Cryptographic &amp; Visual Authenticity" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource WinTextBrush}" />
                                <TextBlock Text="Signature will be stamped with timestamp and author certification metadata." FontSize="10.5" Foreground="{DynamicResource WinMutedBrush}" />
                            </StackPanel>
                            <Border Grid.Column="2" Background="{DynamicResource WinSuccessLightBrush}" BorderBrush="{DynamicResource WinSuccessBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                <TextBlock Text="READY TO STAMP" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource WinSuccessBrush}" />
                            </Border>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- Footer Buttons -->
                <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto" Margin="0,20,0,0">
                    <Button Grid.Column="0" Classes="secondary-btn" Height="34" Padding="14,0" Command="{Binding CloseSignatureStudioCommand}">
                        <TextBlock Text="Cancel" FontSize="12" />
                    </Button>

                    <Button Grid.Column="2" Classes="primary-btn" Height="34" Padding="18,0" Command="{Binding PlaceSignatureFromStudioCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <materialIcons:MaterialIcon Kind="Draw" Width="15" Height="15" Foreground="White" />
                            <TextBlock Text="Place Signature on Page" FontSize="12" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
