<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PdfEditorApp.ViewModels"
             xmlns:models="using:PdfEditorApp.Models"
             xmlns:converters="using:PdfEditorApp.Converters"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:controls="using:PdfEditorApp.Views.Controls"
             x:Class="PdfEditorApp.Views.AiAssistantSidebarView"
             x:DataType="vm:AiAssistantViewModel">

    <UserControl.Resources>
        <converters:EqualityToBooleanConverter x:Key="EqualityConverter" />
        <converters:NullToBooleanConverter x:Key="NullToBooleanConverter" />
    </UserControl.Resources>

    <!-- Main Sidebar Container: Top Header + Dynamic Body (History vs Chat Thread) -->
    <Grid RowDefinitions="Auto,*">

        <!-- 1. Top Header: Title, Active Model Pill, New Chat, History & Actions -->
        <Border Grid.Row="0"
                Background="{DynamicResource M3SurfaceBrush}"
                BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                BorderThickness="0,0,0,1"
                Padding="10,8">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" VerticalAlignment="Center">
                <!-- Sparkle Badge -->
                <Border Grid.Column="0" Width="30" Height="30"
                        Background="#EDE9FE"
                        CornerRadius="{StaticResource M3ShapeCornerMedium}"
                        VerticalAlignment="Center">
                    <materialIcons:MaterialIcon Kind="AutoFixHigh" Width="17" Height="17" Foreground="#7C3AED" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <!-- Title & Model Indicator Pill -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="AI Studio Assistant"
                               FontSize="12.5"
                               FontWeight="Bold"
                               Foreground="{DynamicResource M3OnSurfaceBrush}"
                               VerticalAlignment="Center" />

                    <!-- Model Status Badges -->
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <!-- 1. Free Local Badge -->
                        <Border Background="#DCFCE7"
                                BorderBrush="#86EFAC"
                                BorderThickness="1"
                                CornerRadius="{StaticResource M3ShapeCornerSmall}"
                                Padding="5,1"
                                VerticalAlignment="Center"
                                IsVisible="{Binding IsActiveModelFreeLocal}">
                            <StackPanel Orientation="Horizontal" Spacing="3">
                                <materialIcons:MaterialIcon Kind="ShieldCheckOutline" Width="10" Height="10" Foreground="#15803D" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding ActiveModelDisplayName}" FontSize="9" FontWeight="SemiBold" Foreground="#15803D" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="90" />
                                <TextBlock Text="• Local" FontSize="8.5" FontWeight="Medium" Foreground="#166534" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <!-- 2. Free Cloud Tier Badge -->
                        <Border Background="#E0F2FE"
                                BorderBrush="#7DD3FC"
                                BorderThickness="1"
                                CornerRadius="{StaticResource M3ShapeCornerSmall}"
                                Padding="5,1"
                                VerticalAlignment="Center"
                                IsVisible="{Binding IsActiveModelFreeCloud}">
                            <StackPanel Orientation="Horizontal" Spacing="3">
                                <materialIcons:MaterialIcon Kind="CloudCheck" Width="10" Height="10" Foreground="#0369A1" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding ActiveModelDisplayName}" FontSize="9" FontWeight="SemiBold" Foreground="#0369A1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="90" />
                                <TextBlock Text="• Cloud" FontSize="8.5" FontWeight="Medium" Foreground="#0284C7" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <!-- 3. Paid Cloud API Badge -->
                        <Border Background="#EDE9FE"
                                BorderBrush="#C4B5FD"
                                BorderThickness="1"
                                CornerRadius="{StaticResource M3ShapeCornerSmall}"
                                Padding="5,1"
                                VerticalAlignment="Center"
                                IsVisible="{Binding IsActiveModelPaidCloud}">
                            <StackPanel Orientation="Horizontal" Spacing="3">
                                <materialIcons:MaterialIcon Kind="CloudOutline" Width="10" Height="10" Foreground="#6D28D9" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding ActiveModelDisplayName}" FontSize="9" FontWeight="SemiBold" Foreground="#6D28D9" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="90" />
                                <TextBlock Text="• Cloud" FontSize="8.5" FontWeight="Medium" Foreground="#5B21B6" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>

                <!-- Actions: + New Chat, History Toggle, Settings & Close -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                    <!-- + New Chat Button -->
                    <Button Classes="mini-tool-btn" Width="26" Height="26"
                            Command="{Binding NewChatCommand}"
                            ToolTip.Tip="Start New Conversation (+)">
                        <materialIcons:MaterialIcon Kind="Plus" Width="16" Height="16" Foreground="#7C3AED" />
                    </Button>

                    <!-- Chat History Drawer Toggle -->
                    <Button Classes="mini-tool-btn" Width="26" Height="26"
                            Classes.active="{Binding IsHistoryDrawerOpen}"
                            Command="{Binding ToggleHistoryDrawerCommand}"
                            ToolTip.Tip="Chat History &amp; Sessions">
                        <materialIcons:MaterialIcon Kind="History" Width="15" Height="15" Foreground="{DynamicResource WinMutedBrush}" />
                    </Button>

                    <!-- AI Settings Gear -->
                    <Button Classes="mini-tool-btn" Width="26" Height="26"
                            Command="{Binding OpenSettingsCommand}"
                            ToolTip.Tip="Configure AI Providers &amp; Models">
                        <materialIcons:MaterialIcon Kind="CogOutline" Width="14" Height="14" Foreground="{DynamicResource WinMutedBrush}" />
                    </Button>

                    <!-- Return to Thumbnails -->
                    <Button Classes="mini-tool-btn" Width="26" Height="26"
                            Command="{Binding CloseCommand}"
                            ToolTip.Tip="Return to Page Thumbnails (Esc)">
                        <materialIcons:MaterialIcon Kind="Close" Width="15" Height="15" Foreground="{DynamicResource WinMutedBrush}" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. Dynamic Body: Panel A = History Drawer, Panel B = Chat Stream & Input -->
        <Panel Grid.Row="1">

            <!-- ============================================================== -->
            <!-- VIEW A: CHAT SESSIONS HISTORY DRAWER (Visible when open)        -->
            <!-- ============================================================== -->
            <Border Background="{DynamicResource M3SurfaceBrush}"
                    IsVisible="{Binding IsHistoryDrawerOpen}">
                <Grid RowDefinitions="Auto,*,Auto">
                    <!-- History Header -->
                    <Border Grid.Row="0" Background="{DynamicResource M3SurfaceContainerLowBrush}" BorderBrush="{DynamicResource M3OutlineVariantBrush}" BorderThickness="0,0,0,1" Padding="12,10">
                        <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <materialIcons:MaterialIcon Kind="History" Width="15" Height="15" Foreground="#7C3AED" />
                                <TextBlock Text="Conversation History" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource M3OnSurfaceBrush}" VerticalAlignment="Center" />
                                <Border Background="#EDE9FE" CornerRadius="{StaticResource M3ShapeCornerSmall}" Padding="5,1">
                                    <TextBlock Text="{Binding Sessions.Count, StringFormat='{}{0}'}" FontSize="10" FontWeight="Bold" Foreground="#7C3AED" />
                                </Border>
                            </StackPanel>

                            <Button Grid.Column="1"
                                    Classes="mini-tool-btn"
                                    Height="24" Padding="6,2"
                                    Command="{Binding NewChatCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <materialIcons:MaterialIcon Kind="Plus" Width="13" Height="13" Foreground="#7C3AED" />
                                    <TextBlock Text="New" FontSize="10.5" FontWeight="SemiBold" Foreground="#7C3AED" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Sessions List -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="8" Spacing="6">
                            <!-- Empty History State -->
                            <Border Background="{DynamicResource M3SurfaceContainerLowestBrush}"
                                    BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource M3ShapeCornerMedium}"
                                    Padding="16"
                                    Margin="4"
                                    IsVisible="{Binding Sessions.Count, Converter={StaticResource EqualityConverter}, ConverterParameter=0}">
                                <StackPanel Spacing="6" HorizontalAlignment="Center">
                                    <materialIcons:MaterialIcon Kind="MessageOutline" Width="28" Height="28" Foreground="{DynamicResource WinMutedBrush}" HorizontalAlignment="Center" />
                                    <TextBlock Text="No conversations yet" FontSize="11.5" FontWeight="Medium" Foreground="{DynamicResource WinMutedBrush}" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>

                            <ItemsControl ItemsSource="{Binding Sessions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:AiChatSession">
                                        <Border Background="{DynamicResource M3SurfaceContainerLowestBrush}"
                                                BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                                                BorderThickness="1"
                                                CornerRadius="{StaticResource M3ShapeCornerMedium}"
                                                Padding="10,8"
                                                Margin="0,0,0,4">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <Button Grid.Column="0"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        Padding="0"
                                                        HorizontalAlignment="Stretch"
                                                        HorizontalContentAlignment="Left"
                                                        Command="{Binding $parent[UserControl].((vm:AiAssistantViewModel)DataContext).SwitchSessionCommand}"
                                                        CommandParameter="{Binding}">
                                                    <StackPanel Spacing="3">
                                                        <TextBlock Text="{Binding Title}"
                                                                   FontSize="11.5"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource M3OnSurfaceBrush}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                                            <TextBlock Grid.Column="0"
                                                                       Text="{Binding PreviewSnippet}"
                                                                       FontSize="10"
                                                                       Foreground="{DynamicResource WinMutedBrush}"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Grid.Column="1"
                                                                       Text="{Binding FormattedLastModified}"
                                                                       FontSize="9.5"
                                                                       Foreground="{DynamicResource WinMutedBrush}" />
                                                        </Grid>
                                                    </StackPanel>
                                                </Button>

                                                <!-- Delete Session Button -->
                                                <Button Grid.Column="1"
                                                        Classes="mini-tool-btn"
                                                        Width="24" Height="24"
                                                        Margin="4,0,0,0"
                                                        Command="{Binding $parent[UserControl].((vm:AiAssistantViewModel)DataContext).DeleteSessionCommand}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip.Tip="Delete Conversation">
                                                    <materialIcons:MaterialIcon Kind="DeleteOutline" Width="14" Height="14" Foreground="{DynamicResource WinMutedBrush}" />
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- History Footer: Return to Chat -->
                    <Border Grid.Row="2" Background="{DynamicResource M3SurfaceBrush}" BorderBrush="{DynamicResource M3OutlineVariantBrush}" BorderThickness="0,1,0,0" Padding="10,8">
                        <Button Classes="secondary-btn"
                                HorizontalAlignment="Stretch"
                                CornerRadius="{StaticResource M3ShapeCornerFull}"
                                Command="{Binding ToggleHistoryDrawerCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                <materialIcons:MaterialIcon Kind="ArrowLeft" Width="14" Height="14" Foreground="{DynamicResource WinMutedBrush}" />
                                <TextBlock Text="Back to Current Chat" FontSize="11" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>
                    </Border>
                </Grid>
            </Border>

            <!-- ============================================================== -->
            <!-- VIEW B: ACTIVE CONVERSATION CHAT STREAM & INPUT DOCK            -->
            <!-- ============================================================== -->
            <Grid RowDefinitions="*,Auto"
                  IsVisible="{Binding !IsHistoryDrawerOpen}">

                <!-- B1. CHAT MESSAGE THREAD -->
                <ScrollViewer Grid.Row="0"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="10,10,10,6" Spacing="10">

                        <!-- EMPTY STATE (Zero messages in active session) -->
                        <Border Background="{DynamicResource M3SurfaceContainerLowBrush}"
                                BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource M3ShapeCornerLarge}"
                                Padding="14,12"
                                IsVisible="{Binding CurrentSession.Messages.Count, Converter={StaticResource EqualityConverter}, ConverterParameter=0}">
                            <StackPanel Spacing="10">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" VerticalAlignment="Center">
                                    <Border Grid.Column="0" Width="36" Height="36"
                                            Background="#EDE9FE"
                                            CornerRadius="{StaticResource M3ShapeCornerMedium}">
                                        <materialIcons:MaterialIcon Kind="Sparkles" Width="20" Height="20" Foreground="#7C3AED" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                        <TextBlock Text="AI Document Studio" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource M3OnSurfaceBrush}" />
                                        <TextBlock Text="What would you like to create or edit?" FontSize="10.5" Foreground="{DynamicResource WinMutedBrush}" />
                                    </StackPanel>
                                </Grid>

                                <Rectangle Height="1" Fill="{DynamicResource M3OutlineVariantBrush}" />

                                <!-- Quick Starter Chips -->
                                <TextBlock Text="Suggested Starters (Click to generate)" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource WinMutedBrush}" />
                                <WrapPanel Orientation="Horizontal">
                                    <Button Classes="secondary-btn" Margin="0,0,5,5" Padding="8,4" CornerRadius="{StaticResource M3ShapeCornerFull}" FontSize="10"
                                            Command="{Binding SendSuggestedPromptCommand}"
                                            CommandParameter="Add a 4-column financial summary table with Quarterly revenue">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <materialIcons:MaterialIcon Kind="Table" Width="11" Height="11" Foreground="#0284C7" />
                                            <TextBlock Text="Financial Table" />
                                        </StackPanel>
                                    </Button>

                                    <Button Classes="secondary-btn" Margin="0,0,5,5" Padding="8,4" CornerRadius="{StaticResource M3ShapeCornerFull}" FontSize="10"
                                            Command="{Binding SendSuggestedPromptCommand}"
                                            CommandParameter="Add a modern corporate invoice header with company name Acme Corp and blue accent bar">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <materialIcons:MaterialIcon Kind="FileDocumentOutline" Width="11" Height="11" Foreground="#7C3AED" />
                                            <TextBlock Text="Invoice Header" />
                                        </StackPanel>
                                    </Button>

                                    <Button Classes="secondary-btn" Margin="0,0,5,5" Padding="8,4" CornerRadius="{StaticResource M3ShapeCornerFull}" FontSize="10"
                                            Command="{Binding SendSuggestedPromptCommand}"
                                            CommandParameter="Add an amber warning callout card with Important Notice title">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <materialIcons:MaterialIcon Kind="AlertCircleOutline" Width="11" Height="11" Foreground="#D97706" />
                                            <TextBlock Text="Warning Callout" />
                                        </StackPanel>
                                    </Button>

                                    <Button Classes="secondary-btn" Margin="0,0,5,5" Padding="8,4" CornerRadius="{StaticResource M3ShapeCornerFull}" FontSize="10"
                                            Command="{Binding SendSuggestedPromptCommand}"
                                            CommandParameter="Add a green pill badge with text PAID &amp; VERIFIED">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <materialIcons:MaterialIcon Kind="CheckCircleOutline" Width="11" Height="11" Foreground="#15803D" />
                                            <TextBlock Text="Status Badge" />
                                        </StackPanel>
                                    </Button>

                                    <Button Classes="secondary-btn" Margin="0,0,5,5" Padding="8,4" CornerRadius="{StaticResource M3ShapeCornerFull}" FontSize="10"
                                            Command="{Binding SendSuggestedPromptCommand}"
                                            CommandParameter="Add Pythagorean theorem math equation with right align">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <materialIcons:MaterialIcon Kind="Sigma" Width="11" Height="11" Foreground="#2563EB" />
                                            <TextBlock Text="Math Formula" />
                                        </StackPanel>
                                    </Button>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <!-- CHAT MESSAGES STREAM -->
                        <ItemsControl ItemsSource="{Binding CurrentSession.Messages}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:AiChatMessage">
                                    <Panel Margin="0,2,0,6">

                                        <!-- CASE A: USER MESSAGE (Right-Aligned Pill Container) -->
                                        <Border HorizontalAlignment="Right"
                                                MaxWidth="320"
                                                Background="#EDE9FE"
                                                BorderBrush="#C4B5FD"
                                                BorderThickness="1"
                                                CornerRadius="14,14,2,14"
                                                Padding="10,8"
                                                IsVisible="{Binding IsUser}">
                                            <StackPanel Spacing="4">
                                                <!-- Target Element Chip (if modifying) -->
                                                <Border Background="#DDD6FE" CornerRadius="{StaticResource M3ShapeCornerSmall}" Padding="5,1.5" HorizontalAlignment="Left"
                                                        IsVisible="{Binding HasTargetElement}">
                                                    <StackPanel Orientation="Horizontal" Spacing="3">
                                                        <materialIcons:MaterialIcon Kind="Target" Width="10" Height="10" Foreground="#6D28D9" />
                                                        <TextBlock Text="{Binding TargetElementTitle}" FontSize="9" FontWeight="Bold" Foreground="#6D28D9" TextTrimming="CharacterEllipsis" MaxWidth="160" />
                                                    </StackPanel>
                                                </Border>

                                                <!-- Message Content -->
                                                <TextBlock Text="{Binding Content}"
                                                           FontSize="11.5"
                                                           Foreground="#2E1065"
                                                           TextWrapping="Wrap" />

                                                <!-- Timestamp -->
                                                <TextBlock Text="{Binding FormattedTime}"
                                                           FontSize="8.5"
                                                           Foreground="#7C3AED"
                                                           HorizontalAlignment="Right" />
                                            </StackPanel>
                                        </Border>

                                        <!-- CASE B: ASSISTANT MESSAGE (Left-Aligned Studio Container) -->
                                        <Border HorizontalAlignment="Left"
                                                MaxWidth="340"
                                                Background="{DynamicResource M3SurfaceContainerLowBrush}"
                                                BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                                                BorderThickness="1"
                                                CornerRadius="14,14,14,2"
                                                Padding="10,8"
                                                IsVisible="{Binding IsAssistant}">
                                            <StackPanel Spacing="6">
                                                <!-- Header: AI Badge, Duration, Timestamp -->
                                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6" VerticalAlignment="Center">
                                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                        <materialIcons:MaterialIcon Kind="AutoFixHigh" Width="13" Height="13" Foreground="#7C3AED" />
                                                        <TextBlock Text="AI Studio Agent" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource M3OnSurfaceBrush}" />
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding FormattedDuration}" FontSize="9" Foreground="{DynamicResource WinMutedBrush}" IsVisible="{Binding FormattedDuration, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                                        <TextBlock Text="{Binding FormattedTime}" FontSize="8.5" Foreground="{DynamicResource WinMutedBrush}" />
                                                    </StackPanel>
                                                </Grid>

                                                <!-- Generating Progress Animation -->
                                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" IsVisible="{Binding IsGenerating}">
                                                    <controls:LoadingAnimationControl Width="20" Height="20" />
                                                    <TextBlock Text="Executing canvas agent actions..." FontSize="10" Foreground="{DynamicResource WinMutedBrush}" VerticalAlignment="Center" />
                                                </StackPanel>

                                                <!-- Real-Time Tool Invocations Box -->
                                                <Border Background="{DynamicResource M3SurfaceContainerLowestBrush}"
                                                        BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="{StaticResource M3ShapeCornerSmall}"
                                                        Padding="6,4"
                                                        IsVisible="{Binding HasToolCalls}">
                                                    <StackPanel Spacing="3">
                                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                                            <materialIcons:MaterialIcon Kind="Console" Width="10" Height="10" Foreground="#10B981" />
                                                            <TextBlock Text="Canvas Actions Executed:" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource WinMutedBrush}" />
                                                        </StackPanel>
                                                        <ItemsControl ItemsSource="{Binding ToolCalls}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <TextBlock Text="{Binding}"
                                                                               FontFamily="Consolas, Menlo, Monaco, monospace"
                                                                               FontSize="9"
                                                                               Foreground="{DynamicResource WinTextBrush}"
                                                                               TextWrapping="Wrap" />
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </Border>

                                                <!-- Content Message / Summary -->
                                                <TextBlock Text="{Binding Content}"
                                                           FontSize="11.5"
                                                           Foreground="{DynamicResource WinTextBrush}"
                                                           TextWrapping="Wrap"
                                                           IsVisible="{Binding !IsGenerating}" />

                                                <!-- Revert Changes Button (Undo) -->
                                                <Button Classes="mini-tool-btn"
                                                        Height="22" Padding="8,2"
                                                        Background="{DynamicResource WinHoverBrush}"
                                                        BorderBrush="{DynamicResource WinBorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="{StaticResource M3ShapeCornerFull}"
                                                        HorizontalAlignment="Left"
                                                        Command="{Binding UndoCommand}"
                                                        IsVisible="{Binding CanUndo}"
                                                        ToolTip.Tip="Revert elements created or modified in this step">
                                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                                        <materialIcons:MaterialIcon Kind="Undo" Width="11" Height="11" Foreground="#0F6CBD" />
                                                        <TextBlock Text="Revert Changes" FontSize="9.5" FontWeight="SemiBold" Foreground="#0F6CBD" />
                                                    </StackPanel>
                                                </Button>

                                            </StackPanel>
                                        </Border>

                                    </Panel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                    </StackPanel>
                </ScrollViewer>

                <!-- B2. BOTTOM INPUT DOCK -->
                <Border Grid.Row="1"
                        Background="{DynamicResource M3SurfaceBrush}"
                        BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                        BorderThickness="0,1,0,0"
                        Padding="10,8">
                    <StackPanel Spacing="6">

                        <!-- Expressive Material 3 Target Scope Card -->
                        <Border Background="{DynamicResource M3SurfaceContainerLowBrush}"
                                BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource M3ShapeCornerMedium}"
                                Padding="8,6">
                            <StackPanel Spacing="5">
                                <!-- Top Row: Scope Selector Segmented Capsules -->
                                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="4">
                                    <!-- 1. Entire Page Button -->
                                    <Button Grid.Column="0"
                                            Classes="secondary-btn"
                                            CornerRadius="{StaticResource M3ShapeCornerFull}"
                                            Padding="4,3"
                                            Height="24"
                                            Command="{Binding SwitchToEntirePageModeCommand}"
                                            ToolTip.Tip="Target entire active document page">
                                        <StackPanel Orientation="Horizontal" Spacing="3" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <materialIcons:MaterialIcon Kind="FileDocumentOutline" Width="11" Height="11" Foreground="#0F6CBD" />
                                            <TextBlock Text="{Binding TargetPageNumber, StringFormat='Page {0}'}" FontSize="10" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Button>

                                    <!-- 2. Point Target Button -->
                                    <Button Grid.Column="1"
                                            Classes="secondary-btn"
                                            CornerRadius="{StaticResource M3ShapeCornerFull}"
                                            Padding="4,3"
                                            Height="24"
                                            Command="{Binding SwitchToPointTargetModeCommand}"
                                            ToolTip.Tip="Target specific point on page (Click on canvas to reposition)">
                                        <StackPanel Orientation="Horizontal" Spacing="3" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <materialIcons:MaterialIcon Kind="Target" Width="11" Height="11" Foreground="#7C3AED" />
                                            <TextBlock Text="Point" FontSize="10" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Button>

                                    <!-- 3. Selected Element Button (Enabled if element exists) -->
                                    <Button Grid.Column="2"
                                            Classes="secondary-btn"
                                            CornerRadius="{StaticResource M3ShapeCornerFull}"
                                            Padding="4,3"
                                            Height="24"
                                            IsEnabled="{Binding TargetElement, Converter={x:Static ObjectConverters.IsNotNull}}"
                                            Command="{Binding SwitchToModifyModeCommand}"
                                            ToolTip.Tip="Target selected element for in-place modifications">
                                        <StackPanel Orientation="Horizontal" Spacing="3" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <materialIcons:MaterialIcon Kind="Selection" Width="11" Height="11" Foreground="#15803D" />
                                            <TextBlock Text="Element" FontSize="10" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <!-- Details Row: Active target info & clear button -->
                                <Border Background="{DynamicResource M3SurfaceContainerHighBrush}"
                                        CornerRadius="{StaticResource M3ShapeCornerSmall}"
                                        Padding="6,3.5">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6" VerticalAlignment="Center">
                                        <materialIcons:MaterialIcon Grid.Column="0" Kind="{Binding TargetIcon}" Width="13" Height="13" Foreground="#7C3AED" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                            <TextBlock Text="Target:" FontSize="9.5" Foreground="{DynamicResource WinMutedBrush}" FontWeight="Medium" />
                                            <TextBlock Text="{Binding TargetDescription}" FontSize="10" FontWeight="Bold" Foreground="#7C3AED" TextTrimming="CharacterEllipsis" MaxWidth="190" />
                                        </StackPanel>
                                        <Button Grid.Column="2" Classes="mini-tool-btn" Width="18" Height="18"
                                                Command="{Binding ClearTargetPointCommand}"
                                                IsVisible="{Binding HasTargetPoint}"
                                                ToolTip.Tip="Clear target point (Revert to Entire Page)">
                                            <materialIcons:MaterialIcon Kind="Close" Width="11" Height="11" Foreground="{DynamicResource WinMutedBrush}" />
                                        </Button>
                                        <Button Grid.Column="2" Classes="mini-tool-btn" Width="18" Height="18"
                                                Command="{Binding DeselectElementTargetCommand}"
                                                IsVisible="{Binding HasTargetElement}"
                                                ToolTip.Tip="Deselect element target">
                                            <materialIcons:MaterialIcon Kind="Close" Width="11" Height="11" Foreground="{DynamicResource WinMutedBrush}" />
                                        </Button>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Quick Prompts Scrollable Chips (Hidden scrollbar to eliminate overlay glitch) -->
                        <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding SuggestedPrompts}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="4" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Classes="secondary-btn"
                                                Padding="7,3.5"
                                                CornerRadius="{StaticResource M3ShapeCornerFull}"
                                                FontSize="10"
                                                Command="{Binding $parent[UserControl].((vm:AiAssistantViewModel)DataContext).UsePromptCommand}"
                                                CommandParameter="{Binding}"
                                                ToolTip.Tip="{Binding}">
                                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                <materialIcons:MaterialIcon Kind="Sparkles" Width="10" Height="10" Foreground="#7C3AED" />
                                                <TextBlock Text="{Binding}" MaxWidth="180" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- Rounded Input Box with Action Row -->
                        <Border Background="{DynamicResource M3SurfaceContainerLowBrush}"
                                BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource M3ShapeCornerMedium}"
                                Padding="8,6">
                            <Grid RowDefinitions="Auto,Auto">
                                <!-- Prompt Input TextBox -->
                                <TextBox Grid.Row="0"
                                         Text="{Binding PromptText, Mode=TwoWay}"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         MinHeight="40"
                                         MaxHeight="120"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         Padding="0"
                                         FontSize="11.5"
                                         PlaceholderText="Ask AI to generate or modify elements..." />

                                <!-- Action Row: Status / Cancel / Send -->
                                <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6" Margin="0,4,0,0" VerticalAlignment="Center">
                                    <!-- Status Message -->
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding StatusMessage}"
                                               FontSize="9.5"
                                               Foreground="{DynamicResource WinMutedBrush}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />

                                    <!-- Cancel Button -->
                                    <Button Grid.Column="1"
                                            Command="{Binding CancelGenerationCommand}"
                                            IsVisible="{Binding IsGenerating}"
                                            Classes="mini-tool-btn"
                                            Height="24" Padding="6,2"
                                            CornerRadius="{StaticResource M3ShapeCornerFull}">
                                        <StackPanel Orientation="Horizontal" Spacing="3">
                                            <materialIcons:MaterialIcon Kind="CloseCircleOutline" Width="11" Height="11" Foreground="#DC2626" />
                                            <TextBlock Text="Cancel" FontSize="9.5" Foreground="#DC2626" />
                                        </StackPanel>
                                    </Button>

                                    <!-- Primary Send Button -->
                                    <Button Grid.Column="2"
                                            Command="{Binding GenerateCommand}"
                                            IsEnabled="{Binding !IsGenerating}"
                                            Background="#7C3AED"
                                            Foreground="White"
                                            BorderThickness="0"
                                            CornerRadius="{StaticResource M3ShapeCornerFull}"
                                            Width="28" Height="28"
                                            Padding="0"
                                            ToolTip.Tip="Send prompt to AI Studio (Enter)">
                                        <materialIcons:MaterialIcon Kind="Send" Width="14" Height="14" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Button>
                                </Grid>
                            </Grid>
                        </Border>

                    </StackPanel>
                </Border>

            </Grid>

        </Panel>

    </Grid>
</UserControl>
