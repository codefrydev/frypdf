<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PdfEditorApp.ViewModels"
             xmlns:views="using:PdfEditorApp.Views"
             xmlns:converters="using:PdfEditorApp.Converters"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="PdfEditorApp.Views.HomeView"
             x:DataType="vm:HomeViewModel"
             Background="{DynamicResource WinBgBrush}">

    <UserControl.Resources>
        <converters:EqualityToBooleanConverter x:Key="EqualityConverter" />
        <converters:BooleanToStringConverter x:Key="BooleanToStringConverter" />
    </UserControl.Resources>

    <UserControl.Styles>
        <!-- Nav Tab Button Style -->
        <Style Selector="Button.nav-tab-btn">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource WinMutedBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15" />
                    <BrushTransition Property="Foreground" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.nav-tab-btn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource WinHoverBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource WinTextBrush}" />
        </Style>
        <Style Selector="Button.nav-tab-btn.active /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource WinAccentLightBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource WinAccentBrush}" />
        </Style>
        <Style Selector="Button.nav-tab-btn.active">
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </UserControl.Styles>

    <Grid ColumnDefinitions="230,*">

        <!-- ===== LEFT SIDEBAR ===== -->
        <Border Grid.Column="0"
                Background="{DynamicResource WinPanelBrush}"
                BorderBrush="{DynamicResource WinBorderBrush}"
                BorderThickness="0,0,1,0">
            <DockPanel>

                <!-- Logo / Brand -->
                <Border DockPanel.Dock="Top"
                        Padding="20,20,20,16"
                        BorderBrush="{DynamicResource WinBorderSubtleBrush}"
                        BorderThickness="0,0,0,1">
                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <Border Width="36" Height="36"
                                Background="#0F172A"
                                BorderBrush="#38BDF8"
                                BorderThickness="1"
                                CornerRadius="8"
                                BoxShadow="0 2 8 #2038BDF8">
                            <Viewbox Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Canvas Width="196" Height="196">
                                    <Path Fill="#38BDF8" Data="M50 126H145V133C145 157.853 124.853 178 100 178H95C70.1472 178 50 157.853 50 133V126Z" />
                                    <Path Fill="#F8FAFC" Data="M39.1328 112.539L51.3008 116.797V122.441L34.2305 115.352V111.27L39.1328 112.539ZM51.3008 109.082L39.1328 113.418L34.2305 114.648V110.547L51.3008 103.457V109.082ZM72.3359 115.469H78.6641C78.5599 117.422 78.026 119.147 77.0625 120.645C76.112 122.129 74.7904 123.294 73.0977 124.141C71.4049 124.974 69.3932 125.391 67.0625 125.391C65.2005 125.391 63.5339 125.072 62.0625 124.434C60.5911 123.796 59.3411 122.884 58.3125 121.699C57.2969 120.501 56.5156 119.062 55.9688 117.383C55.4349 115.69 55.168 113.783 55.168 111.66V109.922C55.168 107.799 55.4479 105.892 56.0078 104.199C56.5677 102.507 57.3685 101.061 58.4102 99.8633C59.4518 98.6654 60.7018 97.7474 62.1602 97.1094C63.6185 96.4714 65.2461 96.1523 67.043 96.1523C69.4648 96.1523 71.5091 96.5885 73.1758 97.4609C74.8424 98.3333 76.1315 99.5312 77.043 101.055C77.9674 102.578 78.5208 104.316 78.7031 106.27H72.3555C72.3034 105.163 72.0951 104.232 71.7305 103.477C71.3659 102.708 70.806 102.129 70.0508 101.738C69.2956 101.348 68.293 101.152 67.043 101.152C66.1315 101.152 65.3307 101.322 64.6406 101.66C63.9635 101.999 63.3971 102.526 62.9414 103.242C62.4987 103.958 62.1667 104.87 61.9453 105.977C61.724 107.07 61.6133 108.372 61.6133 109.883V111.66C61.6133 113.158 61.7109 114.453 61.9062 115.547C62.1016 116.641 62.4141 117.546 62.8438 118.262C63.2865 118.978 63.8529 119.512 64.543 119.863C65.2331 120.215 66.0729 120.391 67.0625 120.391C68.1953 120.391 69.1393 120.215 69.8945 119.863C70.6497 119.499 71.2292 118.952 71.6328 118.223C72.0365 117.493 72.2708 116.576 72.3359 115.469ZM88.5664 96.5625V125H82.1992V96.5625H88.5664ZM99.7578 108.555V113.477H86.7891V108.555H99.7578ZM101.008 96.5625V101.504H86.7891V96.5625H101.008ZM113.117 125H106.867L106.906 120.078H113.117C114.536 120.078 115.734 119.753 116.711 119.102C117.688 118.438 118.43 117.461 118.938 116.172C119.445 114.87 119.699 113.288 119.699 111.426V110.117C119.699 108.711 119.556 107.474 119.27 106.406C118.983 105.326 118.56 104.421 118 103.691C117.44 102.962 116.743 102.415 115.91 102.051C115.09 101.686 114.146 101.504 113.078 101.504H106.75V96.5625H113.078C115.005 96.5625 116.763 96.888 118.352 97.5391C119.953 98.1901 121.333 99.1211 122.492 100.332C123.664 101.543 124.569 102.975 125.207 104.629C125.845 106.283 126.164 108.125 126.164 110.156V111.426C126.164 113.444 125.845 115.286 125.207 116.953C124.569 118.607 123.664 120.039 122.492 121.25C121.333 122.448 119.96 123.372 118.371 124.023C116.783 124.674 115.031 125 113.117 125ZM110.48 96.5625V125H104.113V96.5625H110.48ZM141.789 96.5625L131.73 127.441H127.297L137.355 96.5625H141.789ZM156.594 113.32L144.406 109.082V103.457L161.516 110.547V114.668L156.594 113.32ZM144.406 116.855L156.613 112.5L161.516 111.27V115.371L144.406 122.461V116.855Z" />
                                    <Path Fill="#F59E0B" Data="M68.0627 60.6519C68.3821 54.8593 73.1743 46 73.1743 46C73.1743 46 71.2574 55.5407 71.5769 60.6519C71.8964 65.763 72.5354 65.0815 73.4938 68.8296C74.4522 72.5778 73.8133 74.2815 73.4938 77.0074C73.1743 79.7333 72.8549 80.0741 72.2159 83.4815C71.5769 86.8889 69.9795 92 69.9795 92C69.9795 92 70.299 84.3333 70.299 81.437C70.299 78.5407 70.6185 74.6222 69.6601 70.5333C68.7017 66.4444 67.7432 66.4444 68.0627 60.6519Z" />
                                    <Path Fill="#EF4444" Data="M99.9582 38.7481C99.7452 30.9407 96.5504 19 96.5504 19C96.5504 19 97.8284 31.8593 97.6154 38.7481C97.4024 45.637 96.9764 44.7185 96.3375 49.7704C95.6985 54.8222 96.1245 57.1185 96.3375 60.7926C96.5505 64.4667 96.7634 64.9259 97.1894 69.5185C97.6154 74.1111 98.6803 81 98.6803 81C98.6803 81 98.4673 70.6667 98.4673 66.763C98.4673 62.8593 98.2544 57.5778 98.8933 52.0667C99.5322 46.5556 100.171 46.5556 99.9582 38.7481Z" />
                                    <Path Fill="#F59E0B" Data="M118.042 64.7407C118.255 59.7037 121.45 52 121.45 52C121.45 52 120.172 60.2963 120.385 64.7407C120.598 69.1852 121.024 68.5926 121.663 71.8519C122.301 75.1111 121.876 76.5926 121.663 78.963C121.45 81.3333 121.237 81.6296 120.811 84.5926C120.385 87.5556 119.32 92 119.32 92C119.32 92 119.533 85.3333 119.533 82.8148C119.533 80.2963 119.746 76.8889 119.107 73.3333C118.468 69.7778 117.829 69.7778 118.042 64.7407Z" />
                                </Canvas>
                            </Viewbox>
                        </Border>
                        <StackPanel VerticalAlignment="Center" Spacing="1">
                            <TextBlock Text="FryPDF"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource WinTextBrush}" />
                            <TextBlock Text="by CodeFryDev"
                                       FontSize="10"
                                       Foreground="{DynamicResource WinSubtleBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Navigation Tabs (Scrollable for compact screens) -->
                <ScrollViewer DockPanel.Dock="Top" Margin="10,12,10,0" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="3">

                        <!-- Main Sections Header -->
                        <TextBlock Text="OVERVIEW" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource WinSubtleBrush}" Margin="8,4,0,4" />

                        <!-- 1. Home -->
                        <Button Classes="nav-tab-btn"
                                Classes.active="{Binding SelectedNavSection, Converter={StaticResource EqualityConverter}, ConverterParameter=Home}"
                                Command="{Binding SelectNavSectionCommand}"
                                CommandParameter="Home">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <materialIcons:MaterialIcon Grid.Column="0" Kind="HomeOutline" Width="18" Height="18" Foreground="#0F6CBD" Margin="0,0,10,0" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="Home" VerticalAlignment="Center" />
                            </Grid>
                        </Button>

                        <!-- 2. PDF Reader Mode (Acrobat-Style) -->
                        <Button Classes="nav-tab-btn"
                                Classes.active="{Binding SelectedNavSection, Converter={StaticResource EqualityConverter}, ConverterParameter=PdfReader}"
                                Command="{Binding SelectNavSectionCommand}"
                                CommandParameter="PdfReader">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <materialIcons:MaterialIcon Grid.Column="0" Kind="BookOpenPageVariantOutline" Width="18" Height="18" Foreground="#DC2626" Margin="0,0,10,0" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="PDF Reader" VerticalAlignment="Center" />
                                <Border Grid.Column="2" Background="#FEE2E2" CornerRadius="4" Padding="5,1">
                                    <TextBlock Text="Read" FontSize="10" FontWeight="Bold" Foreground="#DC2626" />
                                </Border>
                            </Grid>
                        </Button>

                        <!-- 3. Start a New Document / Templates -->
                        <Button Classes="nav-tab-btn"
                                Classes.active="{Binding SelectedNavSection, Converter={StaticResource EqualityConverter}, ConverterParameter=NewDocument}"
                                Command="{Binding SelectNavSectionCommand}"
                                CommandParameter="NewDocument">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <materialIcons:MaterialIcon Grid.Column="0" Kind="FileDocumentPlusOutline" Width="18" Height="18" Foreground="#10B981" Margin="0,0,10,0" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="New Document" VerticalAlignment="Center" />
                                <Border Grid.Column="2" Background="#ECFDF5" CornerRadius="4" Padding="5,1">
                                    <TextBlock Text="19" FontSize="10" FontWeight="Bold" Foreground="#059669" />
                                </Border>
                            </Grid>
                        </Button>

                        <!-- 4. All Tools -->
                        <Button Classes="nav-tab-btn"
                                Classes.active="{Binding SelectedNavSection, Converter={StaticResource EqualityConverter}, ConverterParameter=AllTools}"
                                Command="{Binding SelectNavSectionCommand}"
                                CommandParameter="AllTools">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <materialIcons:MaterialIcon Grid.Column="0" Kind="ViewGridOutline" Width="18" Height="18" Foreground="#6366F1" Margin="0,0,10,0" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="All Tools" VerticalAlignment="Center" />
                                <Border Grid.Column="2" Background="#EEF2FF" CornerRadius="4" Padding="5,1">
                                    <TextBlock Text="32" FontSize="10" FontWeight="Bold" Foreground="#4F46E5" />
                                </Border>
                            </Grid>
                        </Button>

                        <!-- Tool Categories Header -->
                        <TextBlock Text="CATEGORIES" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource WinSubtleBrush}" Margin="8,12,0,4" />

                        <!-- 4. Organize & Page -->
                        <Button Classes="nav-tab-btn"
                                Classes.active="{Binding SelectedNavSection, Converter={StaticResource EqualityConverter}, ConverterParameter=OrganizeAndPage}"
                                Command="{Binding SelectNavSectionCommand}"
                                CommandParameter="OrganizeAndPage">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <materialIcons:MaterialIcon Grid.Column="0" Kind="BookOpenPageVariantOutline" Width="18" Height="18" Foreground="#0284C7" Margin="0,0,10,0" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="Organize &amp; Page" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="6" FontSize="10.5" Foreground="{DynamicResource WinSubtleBrush}" VerticalAlignment="Center" />
                            </Grid>
                        </Button>

                        <!-- 5. Optimize & Security -->
                        <Button Classes="nav-tab-btn"
                                Classes.active="{Binding SelectedNavSection, Converter={StaticResource EqualityConverter}, ConverterParameter=OptimizeAndSecurity}"
                                Command="{Binding SelectNavSectionCommand}"
                                CommandParameter="OptimizeAndSecurity">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <materialIcons:MaterialIcon Grid.Column="0" Kind="ShieldLockOutline" Width="18" Height="18" Foreground="#10B981" Margin="0,0,10,0" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="Security &amp; Optimize" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="7" FontSize="10.5" Foreground="{DynamicResource WinSubtleBrush}" VerticalAlignment="Center" />
                            </Grid>
                        </Button>

                        <!-- 6. Convert from PDF -->
                        <Button Classes="nav-tab-btn"
                                Classes.active="{Binding SelectedNavSection, Converter={StaticResource EqualityConverter}, ConverterParameter=ConvertFromPdf}"
                                Command="{Binding SelectNavSectionCommand}"
                                CommandParameter="ConvertFromPdf">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <materialIcons:MaterialIcon Grid.Column="0" Kind="ExportVariant" Width="18" Height="18" Foreground="#6366F1" Margin="0,0,10,0" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="Convert from PDF" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="5" FontSize="10.5" Foreground="{DynamicResource WinSubtleBrush}" VerticalAlignment="Center" />
                            </Grid>
                        </Button>

                        <!-- 7. Convert to PDF -->
                        <Button Classes="nav-tab-btn"
                                Classes.active="{Binding SelectedNavSection, Converter={StaticResource EqualityConverter}, ConverterParameter=ConvertToPdf}"
                                Command="{Binding SelectNavSectionCommand}"
                                CommandParameter="ConvertToPdf">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <materialIcons:MaterialIcon Grid.Column="0" Kind="Import" Width="18" Height="18" Foreground="#8B5CF6" Margin="0,0,10,0" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="Convert to PDF" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="6" FontSize="10.5" Foreground="{DynamicResource WinSubtleBrush}" VerticalAlignment="Center" />
                            </Grid>
                        </Button>

                        <!-- 8. Edit & Forms -->
                        <Button Classes="nav-tab-btn"
                                Classes.active="{Binding SelectedNavSection, Converter={StaticResource EqualityConverter}, ConverterParameter=EditAndForms}"
                                Command="{Binding SelectNavSectionCommand}"
                                CommandParameter="EditAndForms">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <materialIcons:MaterialIcon Grid.Column="0" Kind="Draw" Width="18" Height="18" Foreground="#F59E0B" Margin="0,0,10,0" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="Edit &amp; Forms" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="4" FontSize="10.5" Foreground="{DynamicResource WinSubtleBrush}" VerticalAlignment="Center" />
                            </Grid>
                        </Button>

                        <!-- 9. AI & Automation -->
                        <Button Classes="nav-tab-btn"
                                Classes.active="{Binding SelectedNavSection, Converter={StaticResource EqualityConverter}, ConverterParameter=AiAndAutomation}"
                                Command="{Binding SelectNavSectionCommand}"
                                CommandParameter="AiAndAutomation">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <materialIcons:MaterialIcon Grid.Column="0" Kind="AutoFix" Width="18" Height="18" Foreground="#EC4899" Margin="0,0,10,0" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="AI &amp; Automation" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="4" FontSize="10.5" Foreground="{DynamicResource WinSubtleBrush}" VerticalAlignment="Center" />
                            </Grid>
                        </Button>

                        <!-- Collections Header -->
                        <TextBlock Text="LIBRARY" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource WinSubtleBrush}" Margin="8,12,0,4" />

                        <!-- 10. Starred Tools -->
                        <Button Classes="nav-tab-btn"
                                Classes.active="{Binding SelectedNavSection, Converter={StaticResource EqualityConverter}, ConverterParameter=Starred}"
                                Command="{Binding SelectNavSectionCommand}"
                                CommandParameter="Starred">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <materialIcons:MaterialIcon Grid.Column="0" Kind="StarOutline" Width="18" Height="18" Foreground="#EAB308" Margin="0,0,10,0" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="Starred Tools" VerticalAlignment="Center" />
                                <Border Grid.Column="2" Background="#FEF08A" CornerRadius="4" Padding="5,1" IsVisible="{Binding StarredTools.Count}">
                                    <TextBlock Text="{Binding StarredTools.Count}" FontSize="9.5" FontWeight="Bold" Foreground="#854D0E" />
                                </Border>
                            </Grid>
                        </Button>

                        <!-- 11. Font & Language Packs (On-Demand) -->
                        <Button Classes="nav-tab-btn"
                                Classes.active="{Binding SelectedNavSection, Converter={StaticResource EqualityConverter}, ConverterParameter=FontPackages}"
                                Command="{Binding SelectNavSectionCommand}"
                                CommandParameter="FontPackages">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <materialIcons:MaterialIcon Grid.Column="0" Kind="Translate" Width="18" Height="18" Foreground="#0284C7" Margin="0,0,10,0" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="Language &amp; Fonts" VerticalAlignment="Center" />
                                <Border Grid.Column="2" Background="#E0F2FE" CornerRadius="4" Padding="5,1">
                                    <TextBlock Text="10" FontSize="9.5" FontWeight="Bold" Foreground="#0284C7" />
                                </Border>
                            </Grid>
                        </Button>

                        <!-- 12. Trash / Temp Cleaner -->
                        <Button Classes="nav-tab-btn"
                                Classes.active="{Binding SelectedNavSection, Converter={StaticResource EqualityConverter}, ConverterParameter=Trash}"
                                Command="{Binding SelectNavSectionCommand}"
                                CommandParameter="Trash">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <materialIcons:MaterialIcon Grid.Column="0" Kind="TrashCanOutline" Width="18" Height="18" Foreground="{DynamicResource WinMutedBrush}" Margin="0,0,10,0" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="Trash &amp; Cache" VerticalAlignment="Center" />
                            </Grid>
                        </Button>

                        <!-- Legal & Open Source Header -->
                        <TextBlock Text="ABOUT &amp; LEGAL" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource WinSubtleBrush}" Margin="8,12,0,4" />

                        <!-- 12. Licenses & Third-Party Tools -->
                        <Button Classes="nav-tab-btn"
                                Classes.active="{Binding SelectedNavSection, Converter={StaticResource EqualityConverter}, ConverterParameter=Licensing}"
                                Command="{Binding SelectNavSectionCommand}"
                                CommandParameter="Licensing">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <materialIcons:MaterialIcon Grid.Column="0" Kind="CertificateOutline" Width="18" Height="18" Foreground="#4F46E5" Margin="0,0,10,0" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="Licenses &amp; Tools" VerticalAlignment="Center" />
                                <Border Grid.Column="2" Background="#EEF2FF" CornerRadius="4" Padding="5,1">
                                    <TextBlock Text="12" FontSize="9.5" FontWeight="Bold" Foreground="#4F46E5" />
                                </Border>
                            </Grid>
                        </Button>

                    </StackPanel>
                </ScrollViewer>

                <!-- Sidebar Footer with Theme Toggle & Version -->
                <Border DockPanel.Dock="Bottom"
                        Padding="14,10"
                        BorderBrush="{DynamicResource WinBorderSubtleBrush}"
                        BorderThickness="0,1,0,0">
                    <Grid RowDefinitions="Auto,Auto" RowSpacing="6">
                        <!-- Theme Toggle Button -->
                        <Button Grid.Row="0"
                                Command="{Binding ToggleThemeCommand}"
                                Background="{DynamicResource WinInputBgBrush}"
                                BorderBrush="{DynamicResource WinBorderBrush}"
                                BorderThickness="1"
                                Foreground="{DynamicResource WinTextBrush}"
                                CornerRadius="8"
                                Padding="10,6"
                                HorizontalAlignment="Stretch"
                                Cursor="Hand"
                                ToolTip.Tip="Toggle Dark and Light Studio Theme">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <materialIcons:MaterialIcon Kind="WeatherSunny" Width="15" Height="15" Foreground="#F59E0B" IsVisible="{Binding IsDarkMode}" />
                                    <materialIcons:MaterialIcon Kind="WeatherNight" Width="15" Height="15" Foreground="#818CF8" IsVisible="{Binding !IsDarkMode}" />
                                    <TextBlock Text="{Binding IsDarkMode, Converter={StaticResource BooleanToStringConverter}, ConverterParameter='Light Mode|Dark Mode'}"
                                               FontSize="11.5"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                                <materialIcons:MaterialIcon Grid.Column="2" Kind="SwapHorizontal" Width="14" Height="14" Foreground="{DynamicResource WinSubtleBrush}" VerticalAlignment="Center" />
                            </Grid>
                        </Button>

                        <!-- Version Badge -->
                        <TextBlock Grid.Row="1"
                                   Text="FryPDF v1.0 · Privacy-first PDF Studio"
                                   FontSize="9.5"
                                   Foreground="{DynamicResource WinSubtleBrush}"
                                   TextWrapping="Wrap"
                                   HorizontalAlignment="Center" />
                    </Grid>
                </Border>
            </DockPanel>
        </Border>

        <!-- ===== MAIN CONTENT AREA ===== -->
        <Grid Grid.Column="1" RowDefinitions="Auto,*">

            <!-- Top Search & Open File Bar -->
            <Border Grid.Row="0"
                    Background="{DynamicResource WinPanelBrush}"
                    BorderBrush="{DynamicResource WinBorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="32,14"
                    IsVisible="{Binding !IsToolPageActive}">
                <Grid ColumnDefinitions="*,Auto">

                    <!-- Search Box -->
                    <Border Grid.Column="0"
                            Background="{DynamicResource WinInputBgBrush}"
                            BorderBrush="{DynamicResource WinBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="24"
                            Padding="14,0"
                            MaxWidth="560"
                            HorizontalAlignment="Left"
                            Height="40">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <materialIcons:MaterialIcon Grid.Column="0"
                                                        Kind="Magnify"
                                                        Width="16" Height="16"
                                                        Foreground="{DynamicResource WinSubtleBrush}"
                                                        VerticalAlignment="Center"
                                                        Margin="0,0,8,0" />
                            <TextBox Grid.Column="1"
                                     Text="{Binding SearchQuery}"
                                     PlaceholderText="Search all 32 PDF tools &amp; templates (e.g. merge, compress, ocr, word, invoice)..."
                                     FontSize="13"
                                     Foreground="{DynamicResource WinTextBrush}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     VerticalAlignment="Center"
                                     MinWidth="300" />
                            <Button Grid.Column="2"
                                    Command="{Binding ClearSearchCommand}"
                                    IsVisible="{Binding SearchQuery.Length}"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="4"
                                    Cursor="Hand"
                                    ToolTip.Tip="Clear search">
                                <materialIcons:MaterialIcon Kind="CloseCircle" Width="16" Height="16" Foreground="{DynamicResource WinSubtleBrush}" />
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Top Right Actions: Theme Toggle & Open File Button -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                        <Button Command="{Binding ToggleThemeCommand}"
                                Background="{DynamicResource WinInputBgBrush}"
                                BorderBrush="{DynamicResource WinBorderBrush}"
                                BorderThickness="1"
                                Foreground="{DynamicResource WinTextBrush}"
                                CornerRadius="8"
                                Padding="12,0"
                                Height="40"
                                Cursor="Hand"
                                ToolTip.Tip="Toggle Dark / Light Studio Theme">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <materialIcons:MaterialIcon Kind="WeatherSunny" Width="17" Height="17" Foreground="#F59E0B" IsVisible="{Binding IsDarkMode}" />
                                <materialIcons:MaterialIcon Kind="WeatherNight" Width="17" Height="17" Foreground="#818CF8" IsVisible="{Binding !IsDarkMode}" />
                                <TextBlock Text="{Binding IsDarkMode, Converter={StaticResource BooleanToStringConverter}, ConverterParameter='Light Theme|Dark Theme'}"
                                           FontSize="12.5"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding OpenFileCommand}"
                                Background="{DynamicResource WinAccentBrush}"
                                Foreground="White"
                                CornerRadius="8"
                                Padding="16,0"
                                Height="40"
                                Cursor="Hand"
                                ToolTip.Tip="Open a .frypdf or .pdf project file">
                            <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                                <materialIcons:MaterialIcon Kind="FolderOpenOutline" Width="16" Height="16" />
                                <TextBlock Text="Open File"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                </Grid>
            </Border>

            <!-- Page Container -->
            <Grid Grid.Row="1">

                <!-- 1. Dedicated Full-Page Tool Workspace (Shown when a tool is opened) -->
                <Panel IsVisible="{Binding IsToolPageActive}">
                    <views:PdfToolPageView DataContext="{Binding ActiveToolViewModel}" />
                </Panel>

                <!-- 2. Independent Page Files (Shown when IsToolPageActive is false) -->
                <ScrollViewer IsVisible="{Binding !IsToolPageActive}"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <Panel>
                        <!-- Page 1: Overview Dashboard -->
                        <views:HomeDashboardView IsVisible="{Binding IsHomeSection}" />

                        <!-- Page 2: Dedicated PDF Reader Landing Page -->
                        <views:PdfReaderLandingPageView IsVisible="{Binding IsPdfReaderSection}" />

                        <!-- Page 3: Start a New Document (Template Gallery) -->
                        <views:NewDocumentPageView IsVisible="{Binding IsNewDocumentSection}" />

                        <!-- Page 4: PDF Tools Studio (All 32 Tools) -->
                        <views:PdfToolsStudioView IsVisible="{Binding IsToolsSection}" />

                        <!-- Page 5: Starred Tools -->
                        <views:StarredToolsPageView IsVisible="{Binding IsStarredSection}" />

                        <!-- Page 6: Trash & Storage Cache Cleaner -->
                        <views:TrashCachePageView IsVisible="{Binding IsTrashSection}" />

                        <!-- Page 7: Open Source Licenses & Third-Party Tools -->
                        <views:LicensingPageView IsVisible="{Binding IsLicensingSection}" />

                        <!-- Page 8: On-Demand Font & Language Packages Studio -->
                        <Panel IsVisible="{Binding IsFontPackagesSection}">
                            <views:FontManagerPageView DataContext="{Binding FontManager}" />
                        </Panel>
                    </Panel>
                </ScrollViewer>

            </Grid>

        </Grid>
    </Grid>
</UserControl>
