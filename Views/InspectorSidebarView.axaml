<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PdfEditorApp.ViewModels"
             xmlns:elvm="using:PdfEditorApp.ViewModels.ElementViewModels"
             xmlns:converters="using:PdfEditorApp.Converters"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="PdfEditorApp.Views.InspectorSidebarView"
             x:DataType="vm:InspectorViewModel">

    <UserControl.Resources>
        <converters:HexToBrushConverter x:Key="HexToBrushConverter" />
        <converters:NullToBooleanConverter x:Key="NullToBooleanConverter" />
        <converters:DoubleToThicknessConverter x:Key="DoubleToThickness" />
        <converters:DoubleToCornerRadiusConverter x:Key="DoubleToCornerRadius" />
        <converters:EqualityToBooleanConverter x:Key="EqualityConverter" />
    </UserControl.Resources>

    <Border Background="White" BorderBrush="{StaticResource WinBorderBrush}" BorderThickness="1,0,0,0" Width="310">
        <Grid RowDefinitions="Auto,*">

            <!-- Sidebar Header -->
            <Border Grid.Row="0" Background="{StaticResource WinBgBrush}" BorderBrush="{StaticResource WinBorderBrush}" BorderThickness="0,0,0,1" Padding="14,10">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <materialIcons:MaterialIcon Kind="TuneVariant" Width="18" Height="18" Foreground="{StaticResource WinAccentBrush}" />
                        <TextBlock Text="Properties &amp; Format" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource WinTextBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                    <Border Grid.Column="1" Background="{StaticResource WinAccentLightBrush}" CornerRadius="4" Padding="6,2">
                        <TextBlock Text="{Binding ActiveCategoryName}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource WinAccentBrush}"
                                   VerticalAlignment="Center" />
                    </Border>
                </Grid>
            </Border>

            <!-- Inspector Scrollable Cards -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="12" Spacing="12">

                    <!-- EMPTY STATE: DOCUMENT & PAGE OVERVIEW (Visible when nothing is selected) -->
                    <Border Background="{StaticResource WinBgBrush}" BorderBrush="{StaticResource WinBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14"
                            IsVisible="{Binding !HasSelectedElement}">
                        <StackPanel Spacing="10">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <materialIcons:MaterialIcon Kind="FileDocumentOutline" Width="18" Height="18" Foreground="{StaticResource WinAccentBrush}" />
                                <TextBlock Text="Document Properties" FontWeight="SemiBold" FontSize="12.5" Foreground="{StaticResource WinTextBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="Select any element on the page canvas to inspect and edit its typography, geometry, styles, or interactive form fields."
                                       FontSize="11.5" Foreground="{StaticResource WinMutedBrush}" TextWrapping="Wrap" />

                            <Rectangle Height="1" Fill="{StaticResource WinBorderBrush}" Margin="0,4" />

                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="Page Orientation" FontSize="11.5" Foreground="{StaticResource WinTextBrush}" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Classes="secondary-btn" Height="26" Padding="8,2"
                                        Command="{Binding SelectedPage.RotateClockwiseCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                        <materialIcons:MaterialIcon Kind="RotateRight" Width="13" Height="13" Foreground="{StaticResource WinMutedBrush}" />
                                        <TextBlock Text="Rotate 90°" FontSize="10.5" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="Show Footer Bar" FontSize="11.5" Foreground="{StaticResource WinTextBrush}" VerticalAlignment="Center" />
                                <ToggleSwitch Grid.Column="1" IsChecked="{Binding SelectedPage.ShowHeaderFooter, Mode=TwoWay}"
                                              OnContent="" OffContent="" Margin="0" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 1. TYPOGRAPHY CARD (Visible when Text element is selected) -->
                    <Border Background="{StaticResource WinBgBrush}" BorderBrush="{StaticResource WinBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12"
                            IsVisible="{Binding TextElement, Converter={StaticResource NullToBooleanConverter}}">
                        <StackPanel Spacing="10">
                            <!-- Card Title -->
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <materialIcons:MaterialIcon Kind="FormatFont" Width="16" Height="16" Foreground="{StaticResource WinAccentBrush}" />
                                <TextBlock Text="Typography &amp; Text" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource WinTextBrush}" VerticalAlignment="Center" />
                            </StackPanel>

                            <!-- In-Inspector Text Editor -->
                            <StackPanel Spacing="3">
                                <TextBlock Text="Content Text" Classes="inspector-label" />
                                <TextBox Text="{Binding TextElement.Text, Mode=TwoWay}"
                                         AcceptsReturn="True" TextWrapping="Wrap"
                                         Height="54" FontSize="12" CornerRadius="5" Padding="6,4" />
                            </StackPanel>

                            <!-- Font Family & Font Size -->
                            <Grid ColumnDefinitions="*,75" ColumnSpacing="6">
                                <StackPanel Grid.Column="0" Spacing="3">
                                    <TextBlock Text="Font Family" Classes="inspector-label" />
                                    <ComboBox ItemsSource="{Binding AvailableFontFamilies}"
                                              SelectedItem="{Binding SelectedFontFamily, Mode=TwoWay}"
                                              HorizontalAlignment="Stretch" Height="30" FontSize="12" />
                                </StackPanel>

                                <StackPanel Grid.Column="1" Spacing="3">
                                    <TextBlock Text="Size (pt)" Classes="inspector-label" />
                                    <NumericUpDown Value="{Binding TextElement.FontSize, Mode=TwoWay}"
                                                   Minimum="6" Maximum="144" Increment="1"
                                                   HorizontalAlignment="Stretch" Height="30" FontSize="12" />
                                </StackPanel>
                            </Grid>

                            <!-- Bold / Italic / Underline / Strikethrough / Alignment -->
                            <StackPanel Spacing="3">
                                <TextBlock Text="Style &amp; Formatting" Classes="inspector-label" />
                                <WrapPanel Orientation="Horizontal">
                                    <Button Classes="mini-tool-btn" Width="28" Height="28" Margin="1"
                                            Classes.active="{Binding TextElement.IsBold, FallbackValue=False}"
                                            Command="{Binding ToggleBoldCommand}" ToolTip.Tip="Bold (Ctrl+B)">
                                        <materialIcons:MaterialIcon Kind="FormatBold" Width="15" Height="15" Foreground="{StaticResource WinTextBrush}" />
                                    </Button>

                                    <Button Classes="mini-tool-btn" Width="28" Height="28" Margin="1"
                                            Classes.active="{Binding TextElement.IsItalic, FallbackValue=False}"
                                            Command="{Binding ToggleItalicCommand}" ToolTip.Tip="Italic (Ctrl+I)">
                                        <materialIcons:MaterialIcon Kind="FormatItalic" Width="15" Height="15" Foreground="{StaticResource WinTextBrush}" />
                                    </Button>

                                    <Button Classes="mini-tool-btn" Width="28" Height="28" Margin="1"
                                            Classes.active="{Binding TextElement.IsUnderline, FallbackValue=False}"
                                            Command="{Binding ToggleUnderlineCommand}" ToolTip.Tip="Underline (Ctrl+U)">
                                        <materialIcons:MaterialIcon Kind="FormatUnderline" Width="15" Height="15" Foreground="{StaticResource WinTextBrush}" />
                                    </Button>

                                    <Button Classes="mini-tool-btn" Width="28" Height="28" Margin="1"
                                            Classes.active="{Binding TextElement.IsStrikethrough, FallbackValue=False}"
                                            Command="{Binding ToggleStrikethroughCommand}" ToolTip.Tip="Strikethrough">
                                        <materialIcons:MaterialIcon Kind="FormatStrikethrough" Width="15" Height="15" Foreground="{StaticResource WinTextBrush}" />
                                    </Button>

                                    <Rectangle Width="1" Height="18" Fill="{StaticResource WinBorderBrush}" Margin="3,0" />

                                    <Button Classes="mini-tool-btn" Width="28" Height="28" Margin="1"
                                            Command="{Binding ToggleBulletsCommand}" ToolTip.Tip="Bullet List">
                                        <materialIcons:MaterialIcon Kind="FormatListBulleted" Width="15" Height="15" Foreground="{StaticResource WinTextBrush}" />
                                    </Button>

                                    <Button Classes="mini-tool-btn" Width="28" Height="28" Margin="1"
                                            Command="{Binding ToggleNumberingCommand}" ToolTip.Tip="Numbered List">
                                        <materialIcons:MaterialIcon Kind="FormatListNumbered" Width="15" Height="15" Foreground="{StaticResource WinTextBrush}" />
                                    </Button>

                                    <Rectangle Width="1" Height="18" Fill="{StaticResource WinBorderBrush}" Margin="3,0" />

                                    <Button Classes="mini-tool-btn" Width="28" Height="28" Margin="1"
                                            Command="{Binding SetAlignmentCommand}" CommandParameter="Left" ToolTip.Tip="Align Left">
                                        <materialIcons:MaterialIcon Kind="FormatAlignLeft" Width="15" Height="15" Foreground="{StaticResource WinTextBrush}" />
                                    </Button>

                                    <Button Classes="mini-tool-btn" Width="28" Height="28" Margin="1"
                                            Command="{Binding SetAlignmentCommand}" CommandParameter="Center" ToolTip.Tip="Align Center">
                                        <materialIcons:MaterialIcon Kind="FormatAlignCenter" Width="15" Height="15" Foreground="{StaticResource WinTextBrush}" />
                                    </Button>

                                    <Button Classes="mini-tool-btn" Width="28" Height="28" Margin="1"
                                            Command="{Binding SetAlignmentCommand}" CommandParameter="Right" ToolTip.Tip="Align Right">
                                        <materialIcons:MaterialIcon Kind="FormatAlignRight" Width="15" Height="15" Foreground="{StaticResource WinTextBrush}" />
                                    </Button>
                                </WrapPanel>
                            </StackPanel>

                            <!-- Text Case Transforms -->
                            <StackPanel Spacing="3">
                                <TextBlock Text="Text Case" Classes="inspector-label" />
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <Button Classes="secondary-btn" Height="24" Padding="6,2" Command="{Binding TransformTextCaseCommand}" CommandParameter="Upper"><TextBlock Text="UPPERCASE" FontSize="9.5" /></Button>
                                    <Button Classes="secondary-btn" Height="24" Padding="6,2" Command="{Binding TransformTextCaseCommand}" CommandParameter="Lower"><TextBlock Text="lowercase" FontSize="9.5" /></Button>
                                    <Button Classes="secondary-btn" Height="24" Padding="6,2" Command="{Binding TransformTextCaseCommand}" CommandParameter="Title"><TextBlock Text="Title Case" FontSize="9.5" /></Button>
                                </StackPanel>
                            </StackPanel>

                            <!-- Tracking & Line Spacing -->
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                                <StackPanel Grid.Column="0" Spacing="3">
                                    <TextBlock Text="Letter Spacing" Classes="inspector-label" />
                                    <NumericUpDown Value="{Binding TextElement.CharacterSpacing, Mode=TwoWay}" Minimum="-2" Maximum="10" Increment="0.5" Height="28" FontSize="11.5" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="3">
                                    <TextBlock Text="Line Spacing" Classes="inspector-label" />
                                    <NumericUpDown Value="{Binding TextElement.LineHeight, Mode=TwoWay}" Minimum="0.8" Maximum="3.0" Increment="0.1" Height="28" FontSize="11.5" />
                                </StackPanel>
                            </Grid>

                            <!-- Text Color Swatches -->
                            <StackPanel Spacing="4">
                                <TextBlock Text="Text Color" Classes="inspector-label" />
                                <ItemsControl ItemsSource="{Binding ColorSwatches}">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="vm:ColorSwatchItem">
                                            <Button Width="22" Height="22" Margin="2" CornerRadius="11" BorderBrush="#CBD5E1" BorderThickness="1"
                                                    Background="{Binding Hex, Converter={StaticResource HexToBrushConverter}}"
                                                    Command="{Binding $parent[UserControl].((vm:InspectorViewModel)DataContext).SetTextColorCommand}"
                                                    CommandParameter="{Binding Hex}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <!-- Text Background Color Swatches -->
                            <StackPanel Spacing="4">
                                <TextBlock Text="Highlight / Background Color" Classes="inspector-label" />
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <Button Classes="secondary-btn" Height="22" Padding="6,1" Command="{Binding SetTextBackgroundCommand}" CommandParameter="#00000000"><TextBlock Text="None" FontSize="9.5" /></Button>
                                    <Button Width="22" Height="22" CornerRadius="4" Background="#FEF08A" Command="{Binding SetTextBackgroundCommand}" CommandParameter="#FEF08A" ToolTip.Tip="Yellow Highlight" />
                                    <Button Width="22" Height="22" CornerRadius="4" Background="#BAE6FD" Command="{Binding SetTextBackgroundCommand}" CommandParameter="#BAE6FD" ToolTip.Tip="Blue Highlight" />
                                    <Button Width="22" Height="22" CornerRadius="4" Background="#BBF7D0" Command="{Binding SetTextBackgroundCommand}" CommandParameter="#BBF7D0" ToolTip.Tip="Green Highlight" />
                                    <Button Width="22" Height="22" CornerRadius="4" Background="#FEE2E2" Command="{Binding SetTextBackgroundCommand}" CommandParameter="#FEE2E2" ToolTip.Tip="Red Highlight" />
                                    <Button Width="22" Height="22" CornerRadius="4" Background="#F1F5F9" Command="{Binding SetTextBackgroundCommand}" CommandParameter="#F1F5F9" ToolTip.Tip="Light Gray" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 2. SHAPE & BADGE CARD (Visible when Shape element is selected) -->
                    <Border Background="{StaticResource WinBgBrush}" BorderBrush="{StaticResource WinBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12"
                            IsVisible="{Binding ShapeElement, Converter={StaticResource NullToBooleanConverter}}">
                        <StackPanel Spacing="10">
                            <!-- Card Title -->
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <materialIcons:MaterialIcon Kind="ShapeOutline" Width="16" Height="16" Foreground="{StaticResource WinAccentBrush}" />
                                <TextBlock Text="Shape Geometry &amp; Badges" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource WinTextBrush}" VerticalAlignment="Center" />
                            </StackPanel>

                            <!-- Shape Type Selector Grid -->
                            <StackPanel Spacing="4">
                                <TextBlock Text="Preset Geometry (21 Shapes)" Classes="inspector-label" />
                                <WrapPanel Orientation="Horizontal">
                                    <Button Classes="secondary-btn" Height="24" Padding="5,1" Margin="2" Command="{Binding SetShapeTypeCommand}" CommandParameter="Rectangle"><TextBlock Text="Rect" FontSize="10" /></Button>
                                    <Button Classes="secondary-btn" Height="24" Padding="5,1" Margin="2" Command="{Binding SetShapeTypeCommand}" CommandParameter="RoundedRectangle"><TextBlock Text="Rounded" FontSize="10" /></Button>
                                    <Button Classes="secondary-btn" Height="24" Padding="5,1" Margin="2" Command="{Binding SetShapeTypeCommand}" CommandParameter="Circle"><TextBlock Text="Circle" FontSize="10" /></Button>
                                    <Button Classes="secondary-btn" Height="24" Padding="5,1" Margin="2" Command="{Binding SetShapeTypeCommand}" CommandParameter="Triangle"><TextBlock Text="Triangle" FontSize="10" /></Button>
                                    <Button Classes="secondary-btn" Height="24" Padding="5,1" Margin="2" Command="{Binding SetShapeTypeCommand}" CommandParameter="RightTriangle"><TextBlock Text="Rt. Tri" FontSize="10" /></Button>
                                    <Button Classes="secondary-btn" Height="24" Padding="5,1" Margin="2" Command="{Binding SetShapeTypeCommand}" CommandParameter="Diamond"><TextBlock Text="Diamond" FontSize="10" /></Button>
                                    <Button Classes="secondary-btn" Height="24" Padding="5,1" Margin="2" Command="{Binding SetShapeTypeCommand}" CommandParameter="Pentagon"><TextBlock Text="Pentagon" FontSize="10" /></Button>
                                    <Button Classes="secondary-btn" Height="24" Padding="5,1" Margin="2" Command="{Binding SetShapeTypeCommand}" CommandParameter="Hexagon"><TextBlock Text="Hexagon" FontSize="10" /></Button>
                                    <Button Classes="secondary-btn" Height="24" Padding="5,1" Margin="2" Command="{Binding SetShapeTypeCommand}" CommandParameter="Octagon"><TextBlock Text="Octagon" FontSize="10" /></Button>
                                    <Button Classes="secondary-btn" Height="24" Padding="5,1" Margin="2" Command="{Binding SetShapeTypeCommand}" CommandParameter="Star5"><TextBlock Text="★ Star 5" FontSize="10" /></Button>
                                    <Button Classes="secondary-btn" Height="24" Padding="5,1" Margin="2" Command="{Binding SetShapeTypeCommand}" CommandParameter="Star4Badge"><TextBlock Text="✦ Badge" FontSize="10" /></Button>
                                    <Button Classes="secondary-btn" Height="24" Padding="5,1" Margin="2" Command="{Binding SetShapeTypeCommand}" CommandParameter="ArrowRight"><TextBlock Text="➔ Arrow R" FontSize="10" /></Button>
                                    <Button Classes="secondary-btn" Height="24" Padding="5,1" Margin="2" Command="{Binding SetShapeTypeCommand}" CommandParameter="ArrowLeft"><TextBlock Text="⬅ Arrow L" FontSize="10" /></Button>
                                    <Button Classes="secondary-btn" Height="24" Padding="5,1" Margin="2" Command="{Binding SetShapeTypeCommand}" CommandParameter="Callout"><TextBlock Text="💬 Callout" FontSize="10" /></Button>
                                    <Button Classes="secondary-btn" Height="24" Padding="5,1" Margin="2" Command="{Binding SetShapeTypeCommand}" CommandParameter="Heart"><TextBlock Text="♥ Heart" FontSize="10" /></Button>
                                    <Button Classes="secondary-btn" Height="24" Padding="5,1" Margin="2" Command="{Binding SetShapeTypeCommand}" CommandParameter="Cloud"><TextBlock Text="☁ Cloud" FontSize="10" /></Button>
                                    <Button Classes="secondary-btn" Height="24" Padding="5,1" Margin="2" Command="{Binding SetShapeTypeCommand}" CommandParameter="Line"><TextBlock Text="— Line" FontSize="10" /></Button>
                                    <Button Classes="secondary-btn" Height="24" Padding="5,1" Margin="2" Command="{Binding SetShapeTypeCommand}" CommandParameter="Card"><TextBlock Text="🗂 Card" FontSize="10" /></Button>
                                    <Button Classes="secondary-btn" Height="24" Padding="5,1" Margin="2" Command="{Binding SetShapeTypeCommand}" CommandParameter="StickyNote"><TextBlock Text="📌 Note" FontSize="10" /></Button>
                                </WrapPanel>
                            </StackPanel>

                            <!-- Fill Color Swatches -->
                            <StackPanel Spacing="4">
                                <TextBlock Text="Fill Color" Classes="inspector-label" />
                                <ItemsControl ItemsSource="{Binding ColorSwatches}">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="vm:ColorSwatchItem">
                                            <Button Width="22" Height="22" Margin="2" CornerRadius="4" BorderBrush="#CBD5E1" BorderThickness="1"
                                                    Background="{Binding Hex, Converter={StaticResource HexToBrushConverter}}"
                                                    Command="{Binding $parent[UserControl].((vm:InspectorViewModel)DataContext).SetShapeFillColorCommand}"
                                                    CommandParameter="{Binding Hex}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <!-- Stroke / Border Color Swatches -->
                            <StackPanel Spacing="4">
                                <TextBlock Text="Border / Stroke Color" Classes="inspector-label" />
                                <ItemsControl ItemsSource="{Binding ColorSwatches}">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="vm:ColorSwatchItem">
                                            <Button Width="22" Height="22" Margin="2" CornerRadius="4" BorderBrush="#CBD5E1" BorderThickness="1"
                                                    Background="{Binding Hex, Converter={StaticResource HexToBrushConverter}}"
                                                    Command="{Binding $parent[UserControl].((vm:InspectorViewModel)DataContext).SetShapeStrokeColorCommand}"
                                                    CommandParameter="{Binding Hex}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <!-- Corner Radius & Border Thickness -->
                            <Grid ColumnDefinitions="*,*">
                                <StackPanel Grid.Column="0" Spacing="3" Margin="0,0,4,0">
                                    <TextBlock Text="Corner Radius" Classes="inspector-label" />
                                    <NumericUpDown Value="{Binding ShapeElement.CornerRadius, Mode=TwoWay}"
                                                   Minimum="0" Maximum="100" Height="28" FontSize="12" />
                                </StackPanel>

                                <StackPanel Grid.Column="1" Spacing="3" Margin="4,0,0,0">
                                    <TextBlock Text="Border Width" Classes="inspector-label" />
                                    <NumericUpDown Value="{Binding ShapeElement.StrokeThickness, Mode=TwoWay}"
                                                   Minimum="0" Maximum="20" Height="28" FontSize="12" />
                                </StackPanel>
                            </Grid>

                            <!-- Shape Center Label (for Badges & Buttons) -->
                            <StackPanel Spacing="3">
                                <TextBlock Text="Center Label / Badge Text" Classes="inspector-label" />
                                <TextBox Text="{Binding ShapeElement.Label, Mode=TwoWay}" Height="28" FontSize="12" PlaceholderText="e.g. APPROVED, 1, ✦..." />
                            </StackPanel>

                            <Grid ColumnDefinitions="*,*" IsVisible="{Binding ShapeElement.Label, Converter={StaticResource NullToBooleanConverter}}">
                                <StackPanel Grid.Column="0" Spacing="3" Margin="0,0,4,0">
                                    <TextBlock Text="Label Size" Classes="inspector-label" />
                                    <NumericUpDown Value="{Binding ShapeElement.LabelFontSize, Mode=TwoWay}" Minimum="8" Maximum="72" Height="28" FontSize="12" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="3" Margin="4,0,0,0">
                                    <TextBlock Text="Label Color" Classes="inspector-label" />
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <Button Width="20" Height="20" CornerRadius="10" Background="#FFFFFF" BorderBrush="#94A3B8" BorderThickness="1" Command="{Binding SetShapeLabelColorCommand}" CommandParameter="#FFFFFF" />
                                        <Button Width="20" Height="20" CornerRadius="10" Background="#201F1E" Command="{Binding SetShapeLabelColorCommand}" CommandParameter="#201F1E" />
                                        <Button Width="20" Height="20" CornerRadius="10" Background="#0F6CBD" Command="{Binding SetShapeLabelColorCommand}" CommandParameter="#0F6CBD" />
                                        <Button Width="20" Height="20" CornerRadius="10" Background="#16A34A" Command="{Binding SetShapeLabelColorCommand}" CommandParameter="#16A34A" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 3. IMAGE CARD (Visible when Image is selected) -->
                    <Border Background="{StaticResource WinBgBrush}" BorderBrush="{StaticResource WinBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12"
                            IsVisible="{Binding ImageElement, Converter={StaticResource NullToBooleanConverter}}">
                        <StackPanel Spacing="10">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <materialIcons:MaterialIcon Kind="ImageOutline" Width="16" Height="16" Foreground="{StaticResource WinAccentBrush}" />
                                <TextBlock Text="Image Properties" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource WinTextBrush}" VerticalAlignment="Center" />
                            </StackPanel>

                            <StackPanel Spacing="3">
                                <TextBlock Text="Alt Text / Caption" Classes="inspector-label" />
                                <TextBox Text="{Binding ImageElement.AltText, Mode=TwoWay}" Height="28" FontSize="12" />
                            </StackPanel>

                            <StackPanel Spacing="3">
                                <TextBlock Text="Image File Path" Classes="inspector-label" />
                                <TextBox Text="{Binding ImageElement.ImagePath, Mode=TwoWay}" Height="28" FontSize="11" PlaceholderText="/path/to/image.png" />
                            </StackPanel>

                            <Grid ColumnDefinitions="*,*">
                                <StackPanel Grid.Column="0" Spacing="3" Margin="0,0,4,0">
                                    <TextBlock Text="Corner Radius" Classes="inspector-label" />
                                    <NumericUpDown Value="{Binding ImageElement.CornerRadius, Mode=TwoWay}" Minimum="0" Maximum="60" Height="28" FontSize="12" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="3" Margin="4,0,0,0">
                                    <TextBlock Text="Border Width" Classes="inspector-label" />
                                    <NumericUpDown Value="{Binding ImageElement.BorderThickness, Mode=TwoWay}" Minimum="0" Maximum="10" Height="28" FontSize="12" />
                                </StackPanel>
                            </Grid>

                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="Preserve Aspect Ratio" FontSize="11.5" Foreground="{StaticResource WinMutedBrush}" VerticalAlignment="Center" />
                                <ToggleSwitch Grid.Column="1" IsChecked="{Binding ImageElement.KeepAspectRatio, Mode=TwoWay}" OnContent="" OffContent="" Margin="0" />
                            </Grid>

                            <StackPanel Spacing="4">
                                <TextBlock Text="Border Color" Classes="inspector-label" />
                                <ItemsControl ItemsSource="{Binding ColorSwatches}">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="vm:ColorSwatchItem">
                                            <Button Width="20" Height="20" Margin="2" CornerRadius="3" Background="{Binding Hex, Converter={StaticResource HexToBrushConverter}}"
                                                    Command="{Binding $parent[UserControl].((vm:InspectorViewModel)DataContext).SetImageBorderColorCommand}" CommandParameter="{Binding Hex}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 4. DIVIDER CARD (Visible when Divider is selected) -->
                    <Border Background="{StaticResource WinBgBrush}" BorderBrush="{StaticResource WinBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12"
                            IsVisible="{Binding DividerElement, Converter={StaticResource NullToBooleanConverter}}">
                        <StackPanel Spacing="10">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <materialIcons:MaterialIcon Kind="Minus" Width="16" Height="16" Foreground="{StaticResource WinAccentBrush}" />
                                <TextBlock Text="Divider Line Settings" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource WinTextBrush}" VerticalAlignment="Center" />
                            </StackPanel>

                            <StackPanel Spacing="3">
                                <TextBlock Text="Line Thickness (pt)" Classes="inspector-label" />
                                <NumericUpDown Value="{Binding DividerElement.Thickness, Mode=TwoWay}" Minimum="0.5" Maximum="20" Increment="0.5" Height="28" FontSize="12" />
                            </StackPanel>

                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="Vertical Divider" FontSize="11.5" Foreground="{StaticResource WinMutedBrush}" VerticalAlignment="Center" />
                                <ToggleSwitch Grid.Column="1" IsChecked="{Binding DividerElement.IsVertical, Mode=TwoWay}" OnContent="" OffContent="" Margin="0" />
                            </Grid>

                            <StackPanel Spacing="4">
                                <TextBlock Text="Line Color" Classes="inspector-label" />
                                <ItemsControl ItemsSource="{Binding ColorSwatches}">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="vm:ColorSwatchItem">
                                            <Button Width="20" Height="20" Margin="2" CornerRadius="10" Background="{Binding Hex, Converter={StaticResource HexToBrushConverter}}"
                                                    Command="{Binding $parent[UserControl].((vm:InspectorViewModel)DataContext).SetDividerColorCommand}" CommandParameter="{Binding Hex}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 5. TABLE STYLES & ROW/COL CARD (Visible when Table is selected) -->
                    <Border Background="{StaticResource WinBgBrush}" BorderBrush="{StaticResource WinBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12"
                            IsVisible="{Binding TableElement, Converter={StaticResource NullToBooleanConverter}}">
                        <StackPanel Spacing="10">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <materialIcons:MaterialIcon Kind="TableHeadersEye" Width="16" Height="16" Foreground="{StaticResource WinAccentBrush}" />
                                <TextBlock Text="Table Styles (8 Themes)" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource WinTextBrush}" VerticalAlignment="Center" />
                            </StackPanel>

                            <!-- Table Style Presets -->
                            <StackPanel Spacing="4">
                                <TextBlock Text="Apply Preset Theme" Classes="inspector-label" />
                                <WrapPanel Orientation="Horizontal">
                                    <Button Classes="secondary-btn" Height="24" Padding="5,1" Margin="2" Command="{Binding ApplyTableStyleCommand}" CommandParameter="ModernMinimal"><TextBlock Text="Minimal" FontSize="10" /></Button>
                                    <Button Classes="secondary-btn" Height="24" Padding="5,1" Margin="2" Command="{Binding ApplyTableStyleCommand}" CommandParameter="EnterpriseBlue"><TextBlock Text="Enterprise" FontSize="10" /></Button>
                                    <Button Classes="secondary-btn" Height="24" Padding="5,1" Margin="2" Command="{Binding ApplyTableStyleCommand}" CommandParameter="DarkModeSlate"><TextBlock Text="Dark Slate" FontSize="10" /></Button>
                                    <Button Classes="secondary-btn" Height="24" Padding="5,1" Margin="2" Command="{Binding ApplyTableStyleCommand}" CommandParameter="ZebraStriped"><TextBlock Text="Zebra" FontSize="10" /></Button>
                                    <Button Classes="secondary-btn" Height="24" Padding="5,1" Margin="2" Command="{Binding ApplyTableStyleCommand}" CommandParameter="EmeraldGreen"><TextBlock Text="Emerald" FontSize="10" /></Button>
                                    <Button Classes="secondary-btn" Height="24" Padding="5,1" Margin="2" Command="{Binding ApplyTableStyleCommand}" CommandParameter="AmberAccent"><TextBlock Text="Amber" FontSize="10" /></Button>
                                    <Button Classes="secondary-btn" Height="24" Padding="5,1" Margin="2" Command="{Binding ApplyTableStyleCommand}" CommandParameter="FinancialBordered"><TextBlock Text="Financial" FontSize="10" /></Button>
                                    <Button Classes="secondary-btn" Height="24" Padding="5,1" Margin="2" Command="{Binding ApplyTableStyleCommand}" CommandParameter="CompactClean"><TextBlock Text="Compact" FontSize="10" /></Button>
                                </WrapPanel>
                            </StackPanel>

                            <!-- Add / Remove Rows and Columns -->
                            <TextBlock Text="Structure &amp; Dimensions" Classes="inspector-label" />
                            <Grid ColumnDefinitions="*,*" Margin="0,2">
                                <Button Grid.Column="0" Classes="secondary-btn" Height="28" Margin="0,0,3,0"
                                        Command="{Binding TableElement.AddRowCommand}" ToolTip.Tip="Add Table Row">
                                    <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                                        <materialIcons:MaterialIcon Kind="TableRowPlusAfter" Width="14" Height="14" Foreground="{StaticResource WinMutedBrush}" />
                                        <TextBlock Text="Add Row" FontSize="11" />
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="1" Classes="secondary-btn" Height="28" Margin="3,0,0,0"
                                        Command="{Binding TableElement.RemoveRowCommand}" ToolTip.Tip="Delete Table Row">
                                    <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                                        <materialIcons:MaterialIcon Kind="TableRowRemove" Width="14" Height="14" Foreground="{StaticResource WinDangerBrush}" />
                                        <TextBlock Text="Del Row" FontSize="11" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <Grid ColumnDefinitions="*,*" Margin="0,2">
                                <Button Grid.Column="0" Classes="secondary-btn" Height="28" Margin="0,0,3,0"
                                        Command="{Binding TableElement.AddColumnCommand}" ToolTip.Tip="Add Table Column">
                                    <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                                        <materialIcons:MaterialIcon Kind="TableColumnPlusAfter" Width="14" Height="14" Foreground="{StaticResource WinMutedBrush}" />
                                        <TextBlock Text="Add Col" FontSize="11" />
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="1" Classes="secondary-btn" Height="28" Margin="3,0,0,0"
                                        Command="{Binding TableElement.RemoveColumnCommand}" ToolTip.Tip="Delete Table Column">
                                    <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                                        <materialIcons:MaterialIcon Kind="TableColumnRemove" Width="14" Height="14" Foreground="{StaticResource WinDangerBrush}" />
                                        <TextBlock Text="Del Col" FontSize="11" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 6. CHART CONFIG CARD (Visible when Chart is selected) -->
                    <Border Background="{StaticResource WinBgBrush}" BorderBrush="{StaticResource WinBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12"
                            IsVisible="{Binding ChartElement, Converter={StaticResource NullToBooleanConverter}}">
                        <StackPanel Spacing="10">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <materialIcons:MaterialIcon Kind="ChartBar" Width="16" Height="16" Foreground="{StaticResource WinAccentBrush}" />
                                <TextBlock Text="Chart Types (13 Kinds)" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource WinTextBrush}" VerticalAlignment="Center" />
                            </StackPanel>

                            <!-- Chart Types Selector -->
                            <StackPanel Spacing="4">
                                <TextBlock Text="Select Chart Kind" Classes="inspector-label" />
                                <WrapPanel Orientation="Horizontal">
                                    <Button Classes="secondary-btn" Height="24" Padding="5,1" Margin="2" Command="{Binding SetChartTypeCommand}" CommandParameter="BarColumn"><TextBlock Text="Columns" FontSize="10" /></Button>
                                    <Button Classes="secondary-btn" Height="24" Padding="5,1" Margin="2" Command="{Binding SetChartTypeCommand}" CommandParameter="HorizontalBar"><TextBlock Text="H-Bar" FontSize="10" /></Button>
                                    <Button Classes="secondary-btn" Height="24" Padding="5,1" Margin="2" Command="{Binding SetChartTypeCommand}" CommandParameter="Line"><TextBlock Text="Line" FontSize="10" /></Button>
                                    <Button Classes="secondary-btn" Height="24" Padding="5,1" Margin="2" Command="{Binding SetChartTypeCommand}" CommandParameter="Area"><TextBlock Text="Area" FontSize="10" /></Button>
                                    <Button Classes="secondary-btn" Height="24" Padding="5,1" Margin="2" Command="{Binding SetChartTypeCommand}" CommandParameter="DonutPie"><TextBlock Text="Donut" FontSize="10" /></Button>
                                    <Button Classes="secondary-btn" Height="24" Padding="5,1" Margin="2" Command="{Binding SetChartTypeCommand}" CommandParameter="StackedBar"><TextBlock Text="Stacked" FontSize="10" /></Button>
                                    <Button Classes="secondary-btn" Height="24" Padding="5,1" Margin="2" Command="{Binding SetChartTypeCommand}" CommandParameter="Radar"><TextBlock Text="Radar" FontSize="10" /></Button>
                                    <Button Classes="secondary-btn" Height="24" Padding="5,1" Margin="2" Command="{Binding SetChartTypeCommand}" CommandParameter="Funnel"><TextBlock Text="Funnel" FontSize="10" /></Button>
                                    <Button Classes="secondary-btn" Height="24" Padding="5,1" Margin="2" Command="{Binding SetChartTypeCommand}" CommandParameter="Waterfall"><TextBlock Text="Waterfall" FontSize="10" /></Button>
                                    <Button Classes="secondary-btn" Height="24" Padding="5,1" Margin="2" Command="{Binding SetChartTypeCommand}" CommandParameter="GaugeProgress"><TextBlock Text="Gauge" FontSize="10" /></Button>
                                    <Button Classes="secondary-btn" Height="24" Padding="5,1" Margin="2" Command="{Binding SetChartTypeCommand}" CommandParameter="StepLine"><TextBlock Text="Step" FontSize="10" /></Button>
                                    <Button Classes="secondary-btn" Height="24" Padding="5,1" Margin="2" Command="{Binding SetChartTypeCommand}" CommandParameter="Pyramid"><TextBlock Text="Pyramid" FontSize="10" /></Button>
                                    <Button Classes="secondary-btn" Height="24" Padding="5,1" Margin="2" Command="{Binding SetChartTypeCommand}" CommandParameter="ScatterPlot"><TextBlock Text="Scatter" FontSize="10" /></Button>
                                </WrapPanel>
                            </StackPanel>

                            <StackPanel Spacing="3">
                                <TextBlock Text="Chart Title" Classes="inspector-label" />
                                <TextBox Text="{Binding ChartElement.Title, Mode=TwoWay}" Height="28" FontSize="12" />
                            </StackPanel>

                            <Grid ColumnDefinitions="*,*" Margin="0,2">
                                <Button Grid.Column="0" Classes="secondary-btn" Height="28" Margin="0,0,3,0"
                                        Command="{Binding ChartElement.AddDataPointCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                                        <materialIcons:MaterialIcon Kind="Plus" Width="14" Height="14" Foreground="{StaticResource WinAccentBrush}" />
                                        <TextBlock Text="Add Point" FontSize="11" />
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="1" Classes="secondary-btn" Height="28" Margin="3,0,0,0"
                                        Command="{Binding ChartElement.RemoveDataPointCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                                        <materialIcons:MaterialIcon Kind="Minus" Width="14" Height="14" Foreground="{StaticResource WinDangerBrush}" />
                                        <TextBlock Text="Del Point" FontSize="11" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 7. WATERMARK CARD (Visible when Watermark is selected) -->
                    <Border Background="{StaticResource WinBgBrush}" BorderBrush="{StaticResource WinBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12"
                            IsVisible="{Binding WatermarkElement, Converter={StaticResource NullToBooleanConverter}}">
                        <StackPanel Spacing="10">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <materialIcons:MaterialIcon Kind="Watermark" Width="16" Height="16" Foreground="{StaticResource WinAccentBrush}" />
                                <TextBlock Text="Watermark Settings" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource WinTextBrush}" VerticalAlignment="Center" />
                            </StackPanel>

                            <StackPanel Spacing="3">
                                <TextBlock Text="Watermark Text" Classes="inspector-label" />
                                <TextBox Text="{Binding WatermarkElement.Text, Mode=TwoWay}" Height="28" FontSize="12" />
                            </StackPanel>

                            <Grid ColumnDefinitions="*,*">
                                <StackPanel Grid.Column="0" Spacing="3" Margin="0,0,4,0">
                                    <TextBlock Text="Font Size" Classes="inspector-label" />
                                    <NumericUpDown Value="{Binding WatermarkElement.FontSize, Mode=TwoWay}" Minimum="20" Maximum="120" Height="28" FontSize="12" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="3" Margin="4,0,0,0">
                                    <TextBlock Text="Angle (°)" Classes="inspector-label" />
                                    <NumericUpDown Value="{Binding WatermarkElement.Angle, Mode=TwoWay}" Minimum="-90" Maximum="90" Height="28" FontSize="12" />
                                </StackPanel>
                            </Grid>

                            <StackPanel Spacing="3">
                                <TextBlock Text="Opacity" Classes="inspector-label" />
                                <Slider Value="{Binding WatermarkElement.Opacity, Mode=TwoWay}" Minimum="0.05" Maximum="1.0" Height="28" />
                            </StackPanel>

                            <StackPanel Spacing="4">
                                <TextBlock Text="Watermark Color" Classes="inspector-label" />
                                <ItemsControl ItemsSource="{Binding ColorSwatches}">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="vm:ColorSwatchItem">
                                            <Button Width="20" Height="20" Margin="2" CornerRadius="10" Background="{Binding Hex, Converter={StaticResource HexToBrushConverter}}"
                                                    Command="{Binding $parent[UserControl].((vm:InspectorViewModel)DataContext).SetWatermarkColorCommand}" CommandParameter="{Binding Hex}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 8. ACROFORMS CARD (Visible when Form Field is selected) -->
                    <Border Background="{StaticResource WinBgBrush}" BorderBrush="{StaticResource WinBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12"
                            IsVisible="{Binding FormFieldElement, Converter={StaticResource NullToBooleanConverter}}">
                        <StackPanel Spacing="10">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <materialIcons:MaterialIcon Kind="FormTextbox" Width="16" Height="16" Foreground="{StaticResource WinAccentBrush}" />
                                <TextBlock Text="AcroForm Field Setup" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource WinTextBrush}" VerticalAlignment="Center" />
                            </StackPanel>

                            <!-- Field Type Switcher Chips -->
                            <StackPanel Spacing="3">
                                <TextBlock Text="Field Control Type" Classes="inspector-label" />
                                <WrapPanel Orientation="Horizontal">
                                    <Button Classes="secondary-btn" Height="24" Padding="5,1" Margin="2" Command="{Binding SetFormFieldTypeCommand}" CommandParameter="Text"><TextBlock Text="Text" FontSize="10" /></Button>
                                    <Button Classes="secondary-btn" Height="24" Padding="5,1" Margin="2" Command="{Binding SetFormFieldTypeCommand}" CommandParameter="MultilineText"><TextBlock Text="Textarea" FontSize="10" /></Button>
                                    <Button Classes="secondary-btn" Height="24" Padding="5,1" Margin="2" Command="{Binding SetFormFieldTypeCommand}" CommandParameter="Checkbox"><TextBlock Text="☑ Check" FontSize="10" /></Button>
                                    <Button Classes="secondary-btn" Height="24" Padding="5,1" Margin="2" Command="{Binding SetFormFieldTypeCommand}" CommandParameter="Radio"><TextBlock Text="◉ Radio" FontSize="10" /></Button>
                                    <Button Classes="secondary-btn" Height="24" Padding="5,1" Margin="2" Command="{Binding SetFormFieldTypeCommand}" CommandParameter="Dropdown"><TextBlock Text="▼ Select" FontSize="10" /></Button>
                                    <Button Classes="secondary-btn" Height="24" Padding="5,1" Margin="2" Command="{Binding SetFormFieldTypeCommand}" CommandParameter="DatePicker"><TextBlock Text="📅 Date" FontSize="10" /></Button>
                                    <Button Classes="secondary-btn" Height="24" Padding="5,1" Margin="2" Command="{Binding SetFormFieldTypeCommand}" CommandParameter="Number"><TextBlock Text="123 Num" FontSize="10" /></Button>
                                    <Button Classes="secondary-btn" Height="24" Padding="5,1" Margin="2" Command="{Binding SetFormFieldTypeCommand}" CommandParameter="SignatureLine"><TextBlock Text="✍ Signature" FontSize="10" /></Button>
                                    <Button Classes="secondary-btn" Height="24" Padding="5,1" Margin="2" Command="{Binding SetFormFieldTypeCommand}" CommandParameter="Button"><TextBlock Text="Button" FontSize="10" /></Button>
                                </WrapPanel>
                            </StackPanel>

                            <StackPanel Spacing="3">
                                <TextBlock Text="Field Label" Classes="inspector-label" />
                                <TextBox Text="{Binding FormFieldElement.Label, Mode=TwoWay}" Height="28" FontSize="12" />
                            </StackPanel>

                            <StackPanel Spacing="3">
                                <TextBlock Text="Placeholder / Default Value" Classes="inspector-label" />
                                <TextBox Text="{Binding FormFieldElement.Placeholder, Mode=TwoWay}" Height="28" FontSize="12" />
                            </StackPanel>

                            <StackPanel Spacing="3">
                                <TextBlock Text="Validation Rule Preset" Classes="inspector-label" />
                                <WrapPanel Orientation="Horizontal">
                                    <Button Classes="secondary-btn" Height="24" Padding="5,1" Margin="2" Command="{Binding SetFormFieldValidationCommand}" CommandParameter="None"><TextBlock Text="None" FontSize="10" /></Button>
                                    <Button Classes="secondary-btn" Height="24" Padding="5,1" Margin="2" Command="{Binding SetFormFieldValidationCommand}" CommandParameter="Email"><TextBlock Text="Email" FontSize="10" /></Button>
                                    <Button Classes="secondary-btn" Height="24" Padding="5,1" Margin="2" Command="{Binding SetFormFieldValidationCommand}" CommandParameter="Numeric"><TextBlock Text="123" FontSize="10" /></Button>
                                    <Button Classes="secondary-btn" Height="24" Padding="5,1" Margin="2" Command="{Binding SetFormFieldValidationCommand}" CommandParameter="Phone"><TextBlock Text="Phone" FontSize="10" /></Button>
                                    <Button Classes="secondary-btn" Height="24" Padding="5,1" Margin="2" Command="{Binding SetFormFieldValidationCommand}" CommandParameter="Date"><TextBlock Text="Date" FontSize="10" /></Button>
                                </WrapPanel>
                            </StackPanel>

                            <Grid ColumnDefinitions="*,*">
                                <CheckBox Grid.Column="0" IsChecked="{Binding FormFieldElement.IsRequired, Mode=TwoWay}">
                                    <TextBlock Text="Required (*)" FontSize="11.5" />
                                </CheckBox>
                                <CheckBox Grid.Column="1" IsChecked="{Binding FormFieldElement.IsReadOnly, Mode=TwoWay}">
                                    <TextBlock Text="Read Only" FontSize="11.5" />
                                </CheckBox>
                            </Grid>

                            <StackPanel Spacing="4">
                                <TextBlock Text="Border Color" Classes="inspector-label" />
                                <ItemsControl ItemsSource="{Binding ColorSwatches}">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="vm:ColorSwatchItem">
                                            <Button Width="20" Height="20" Margin="2" CornerRadius="3" Background="{Binding Hex, Converter={StaticResource HexToBrushConverter}}"
                                                    Command="{Binding $parent[UserControl].((vm:InspectorViewModel)DataContext).SetFormFieldBorderColorCommand}" CommandParameter="{Binding Hex}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 9. QR CODE CARD (Visible when QR Code is selected) -->
                    <Border Background="{StaticResource WinBgBrush}" BorderBrush="{StaticResource WinBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12"
                            IsVisible="{Binding QrCodeElement, Converter={StaticResource NullToBooleanConverter}}">
                        <StackPanel Spacing="10">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <materialIcons:MaterialIcon Kind="Qrcode" Width="16" Height="16" Foreground="{StaticResource WinAccentBrush}" />
                                <TextBlock Text="QR Code Settings &amp; Presets" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource WinTextBrush}" VerticalAlignment="Center" />
                            </StackPanel>

                            <StackPanel Spacing="3">
                                <TextBlock Text="Quick Payload Presets" Classes="inspector-label" />
                                <WrapPanel Orientation="Horizontal">
                                    <Button Classes="secondary-btn" Height="24" Padding="5,1" Margin="2" Command="{Binding ApplyQrPresetCommand}" CommandParameter="Url"><TextBlock Text="🔗 URL" FontSize="10" /></Button>
                                    <Button Classes="secondary-btn" Height="24" Padding="5,1" Margin="2" Command="{Binding ApplyQrPresetCommand}" CommandParameter="Wifi"><TextBlock Text="📶 Wi-Fi" FontSize="10" /></Button>
                                    <Button Classes="secondary-btn" Height="24" Padding="5,1" Margin="2" Command="{Binding ApplyQrPresetCommand}" CommandParameter="VCard"><TextBlock Text="👤 vCard" FontSize="10" /></Button>
                                    <Button Classes="secondary-btn" Height="24" Padding="5,1" Margin="2" Command="{Binding ApplyQrPresetCommand}" CommandParameter="Email"><TextBlock Text="✉ Email" FontSize="10" /></Button>
                                    <Button Classes="secondary-btn" Height="24" Padding="5,1" Margin="2" Command="{Binding ApplyQrPresetCommand}" CommandParameter="PhoneCall"><TextBlock Text="📞 Phone" FontSize="10" /></Button>
                                    <Button Classes="secondary-btn" Height="24" Padding="5,1" Margin="2" Command="{Binding ApplyQrPresetCommand}" CommandParameter="GeoLocation"><TextBlock Text="📍 GPS" FontSize="10" /></Button>
                                </WrapPanel>
                            </StackPanel>

                            <StackPanel Spacing="3">
                                <TextBlock Text="Target URL / Payload" Classes="inspector-label" />
                                <TextBox Text="{Binding QrCodeElement.Content, Mode=TwoWay}" Height="28" FontSize="12" />
                            </StackPanel>

                            <StackPanel Spacing="3">
                                <TextBlock Text="Label Text" Classes="inspector-label" />
                                <TextBox Text="{Binding QrCodeElement.Label, Mode=TwoWay}" Height="28" FontSize="12" />
                            </StackPanel>

                            <StackPanel Spacing="4">
                                <TextBlock Text="QR Code Color" Classes="inspector-label" />
                                <ItemsControl ItemsSource="{Binding ColorSwatches}">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="vm:ColorSwatchItem">
                                            <Button Width="20" Height="20" Margin="2" CornerRadius="10" Background="{Binding Hex, Converter={StaticResource HexToBrushConverter}}"
                                                    Command="{Binding $parent[UserControl].((vm:InspectorViewModel)DataContext).SetQrCodeDarkColorCommand}" CommandParameter="{Binding Hex}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 10. BARCODE CARD (Visible when Barcode is selected) -->
                    <Border Background="{StaticResource WinBgBrush}" BorderBrush="{StaticResource WinBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12"
                            IsVisible="{Binding BarcodeElement, Converter={StaticResource NullToBooleanConverter}}">
                        <StackPanel Spacing="10">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <materialIcons:MaterialIcon Kind="Barcode" Width="16" Height="16" Foreground="{StaticResource WinAccentBrush}" />
                                <TextBlock Text="Barcode Standards (7 Formats)" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource WinTextBrush}" VerticalAlignment="Center" />
                            </StackPanel>

                            <StackPanel Spacing="3">
                                <TextBlock Text="Select Barcode Standard" Classes="inspector-label" />
                                <WrapPanel Orientation="Horizontal">
                                    <Button Classes="secondary-btn" Height="24" Padding="5,1" Margin="2" Command="{Binding SetBarcodeFormatCommand}" CommandParameter="Code128"><TextBlock Text="Code128" FontSize="10" /></Button>
                                    <Button Classes="secondary-btn" Height="24" Padding="5,1" Margin="2" Command="{Binding SetBarcodeFormatCommand}" CommandParameter="Code39"><TextBlock Text="Code39" FontSize="10" /></Button>
                                    <Button Classes="secondary-btn" Height="24" Padding="5,1" Margin="2" Command="{Binding SetBarcodeFormatCommand}" CommandParameter="Ean13"><TextBlock Text="EAN-13" FontSize="10" /></Button>
                                    <Button Classes="secondary-btn" Height="24" Padding="5,1" Margin="2" Command="{Binding SetBarcodeFormatCommand}" CommandParameter="UpcA"><TextBlock Text="UPC-A" FontSize="10" /></Button>
                                    <Button Classes="secondary-btn" Height="24" Padding="5,1" Margin="2" Command="{Binding SetBarcodeFormatCommand}" CommandParameter="Itf14"><TextBlock Text="ITF-14" FontSize="10" /></Button>
                                    <Button Classes="secondary-btn" Height="24" Padding="5,1" Margin="2" Command="{Binding SetBarcodeFormatCommand}" CommandParameter="Codabar"><TextBlock Text="Codabar" FontSize="10" /></Button>
                                    <Button Classes="secondary-btn" Height="24" Padding="5,1" Margin="2" Command="{Binding SetBarcodeFormatCommand}" CommandParameter="Pdf417"><TextBlock Text="PDF417" FontSize="10" /></Button>
                                </WrapPanel>
                            </StackPanel>

                            <StackPanel Spacing="3">
                                <TextBlock Text="Code Value" Classes="inspector-label" />
                                <TextBox Text="{Binding BarcodeElement.CodeValue, Mode=TwoWay}" Height="28" FontSize="12" />
                            </StackPanel>

                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="Show Text Underneath" VerticalAlignment="Center" FontSize="11.5" Foreground="{StaticResource WinMutedBrush}" />
                                <ToggleSwitch Grid.Column="1" IsChecked="{Binding BarcodeElement.ShowText, Mode=TwoWay}" OnContent="" OffContent="" Margin="0" />
                            </Grid>

                            <StackPanel Spacing="4">
                                <TextBlock Text="Barcode Color" Classes="inspector-label" />
                                <ItemsControl ItemsSource="{Binding ColorSwatches}">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="vm:ColorSwatchItem">
                                            <Button Width="20" Height="20" Margin="2" CornerRadius="10" Background="{Binding Hex, Converter={StaticResource HexToBrushConverter}}"
                                                    Command="{Binding $parent[UserControl].((vm:InspectorViewModel)DataContext).SetBarcodeColorCommand}" CommandParameter="{Binding Hex}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 11. REDACTION CARD (Visible when Redaction block is selected) -->
                    <Border Background="{StaticResource WinBgBrush}" BorderBrush="{StaticResource WinBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12"
                            IsVisible="{Binding RedactionElement, Converter={StaticResource NullToBooleanConverter}}">
                        <StackPanel Spacing="10">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <materialIcons:MaterialIcon Kind="EyeOffOutline" Width="16" Height="16" Foreground="{StaticResource WinDangerBrush}" />
                                <TextBlock Text="Legal Redaction Exemption" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource WinDangerBrush}" VerticalAlignment="Center" />
                            </StackPanel>

                            <StackPanel Spacing="3">
                                <TextBlock Text="Exemption Code / Rationale" Classes="inspector-label" />
                                <TextBox Text="{Binding RedactionElement.ExemptionCode, Mode=TwoWay}" Height="28" FontSize="12" />
                            </StackPanel>

                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="Show Exemption Text" VerticalAlignment="Center" FontSize="11.5" Foreground="{StaticResource WinMutedBrush}" />
                                <ToggleSwitch Grid.Column="1" IsChecked="{Binding RedactionElement.ShowOverlayText, Mode=TwoWay}" OnContent="" OffContent="" Margin="0" />
                            </Grid>

                            <StackPanel Spacing="4">
                                <TextBlock Text="Redaction Fill Style" Classes="inspector-label" />
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Button Width="24" Height="24" CornerRadius="4" Background="#0F172A" Command="{Binding SetRedactionFillColorCommand}" CommandParameter="#0F172A" ToolTip.Tip="Blackout" />
                                    <Button Width="24" Height="24" CornerRadius="4" Background="#FFFFFF" BorderBrush="#94A3B8" BorderThickness="1" Command="{Binding SetRedactionFillColorCommand}" CommandParameter="#FFFFFF" ToolTip.Tip="Whiteout" />
                                    <Button Width="24" Height="24" CornerRadius="4" Background="#475569" Command="{Binding SetRedactionFillColorCommand}" CommandParameter="#475569" ToolTip.Tip="Grayout" />
                                    <Button Width="24" Height="24" CornerRadius="4" Background="#DC2626" Command="{Binding SetRedactionFillColorCommand}" CommandParameter="#DC2626" ToolTip.Tip="Red Confidential" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 12. INK & MARKUP CARD (Visible when Ink element is selected) -->
                    <Border Background="{StaticResource WinBgBrush}" BorderBrush="{StaticResource WinBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12"
                            IsVisible="{Binding InkElement, Converter={StaticResource NullToBooleanConverter}}">
                        <StackPanel Spacing="10">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <materialIcons:MaterialIcon Kind="DrawPen" Width="16" Height="16" Foreground="{StaticResource WinAccentBrush}" />
                                <TextBlock Text="Ink &amp; Markup Drawing" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource WinTextBrush}" VerticalAlignment="Center" />
                            </StackPanel>

                            <StackPanel Spacing="3">
                                <TextBlock Text="Stroke Width (pt)" Classes="inspector-label" />
                                <NumericUpDown Value="{Binding InkElement.StrokeThickness, Mode=TwoWay}" Minimum="1" Maximum="30" Increment="1" Height="28" FontSize="12" />
                            </StackPanel>

                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="Highlighter Mode" VerticalAlignment="Center" FontSize="11.5" Foreground="{StaticResource WinMutedBrush}" />
                                <ToggleSwitch Grid.Column="1" IsChecked="{Binding InkElement.IsHighlighter, Mode=TwoWay}" OnContent="" OffContent="" Margin="0" />
                            </Grid>

                            <StackPanel Spacing="4">
                                <TextBlock Text="Ink Color" Classes="inspector-label" />
                                <ItemsControl ItemsSource="{Binding ColorSwatches}">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="vm:ColorSwatchItem">
                                            <Button Width="20" Height="20" Margin="2" CornerRadius="10" Background="{Binding Hex, Converter={StaticResource HexToBrushConverter}}"
                                                    Command="{Binding $parent[UserControl].((vm:InspectorViewModel)DataContext).SetInkColorCommand}" CommandParameter="{Binding Hex}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 13. STICKY NOTE CARD (Visible when Sticky Note is selected) -->
                    <Border Background="{StaticResource WinBgBrush}" BorderBrush="{StaticResource WinBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12"
                            IsVisible="{Binding StickyNoteElement, Converter={StaticResource NullToBooleanConverter}}">
                        <StackPanel Spacing="10">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <materialIcons:MaterialIcon Kind="NoteTextOutline" Width="16" Height="16" Foreground="#B45309" />
                                <TextBlock Text="Review Comment Note" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource WinTextBrush}" VerticalAlignment="Center" />
                            </StackPanel>

                            <StackPanel Spacing="3">
                                <TextBlock Text="Comment Text" Classes="inspector-label" />
                                <TextBox Text="{Binding StickyNoteElement.NoteText, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap" Height="60" FontSize="12" />
                            </StackPanel>

                            <Grid ColumnDefinitions="*,*">
                                <StackPanel Grid.Column="0" Spacing="3" Margin="0,0,4,0">
                                    <TextBlock Text="Author" Classes="inspector-label" />
                                    <TextBox Text="{Binding StickyNoteElement.Author, Mode=TwoWay}" Height="28" FontSize="11.5" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="3" Margin="4,0,0,0">
                                    <TextBlock Text="Review Status" Classes="inspector-label" />
                                    <TextBox Text="{Binding StickyNoteElement.Status, Mode=TwoWay}" Height="28" FontSize="11.5" />
                                </StackPanel>
                            </Grid>

                            <StackPanel Spacing="4">
                                <TextBlock Text="Sticky Color" Classes="inspector-label" />
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Button Width="24" Height="24" CornerRadius="4" Background="#FEF3C7" Command="{Binding SetStickyNoteColorCommand}" CommandParameter="#FEF3C7" ToolTip.Tip="Yellow Note" />
                                    <Button Width="24" Height="24" CornerRadius="4" Background="#DBEAFE" Command="{Binding SetStickyNoteColorCommand}" CommandParameter="#DBEAFE" ToolTip.Tip="Blue Note" />
                                    <Button Width="24" Height="24" CornerRadius="4" Background="#DCFCE7" Command="{Binding SetStickyNoteColorCommand}" CommandParameter="#DCFCE7" ToolTip.Tip="Green Note" />
                                    <Button Width="24" Height="24" CornerRadius="4" Background="#FCE7F3" Command="{Binding SetStickyNoteColorCommand}" CommandParameter="#FCE7F3" ToolTip.Tip="Pink Note" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 14. DIMENSIONS, POSITION & TRANSFORMS CARD (Visible for any selected element) -->
                    <Border Background="{StaticResource WinBgBrush}" BorderBrush="{StaticResource WinBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12"
                            IsVisible="{Binding HasSelectedElement}">
                        <StackPanel Spacing="10">
                            <!-- Card Title -->
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <materialIcons:MaterialIcon Kind="ArrowAll" Width="16" Height="16" Foreground="{StaticResource WinAccentBrush}" />
                                <TextBlock Text="Position &amp; Geometry" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource WinTextBrush}" VerticalAlignment="Center" />
                            </StackPanel>

                            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" RowSpacing="6">
                                <StackPanel Grid.Row="0" Grid.Column="0" Spacing="3" Margin="0,0,4,0">
                                    <TextBlock Text="X (pt)" Classes="inspector-label" />
                                    <NumericUpDown Value="{Binding SelectedElement.X, Mode=TwoWay}" Minimum="0" Maximum="2000" Height="30" FontSize="12" />
                                </StackPanel>

                                <StackPanel Grid.Row="0" Grid.Column="1" Spacing="3" Margin="4,0,0,0">
                                    <TextBlock Text="Y (pt)" Classes="inspector-label" />
                                    <NumericUpDown Value="{Binding SelectedElement.Y, Mode=TwoWay}" Minimum="0" Maximum="3000" Height="30" FontSize="12" />
                                </StackPanel>

                                <StackPanel Grid.Row="1" Grid.Column="0" Spacing="3" Margin="0,0,4,0">
                                    <TextBlock Text="Width (pt)" Classes="inspector-label" />
                                    <NumericUpDown Value="{Binding SelectedElement.Width, Mode=TwoWay}" Minimum="10" Maximum="2000" Height="30" FontSize="12" />
                                </StackPanel>

                                <StackPanel Grid.Row="1" Grid.Column="1" Spacing="3" Margin="4,0,0,0">
                                    <TextBlock Text="Height (pt)" Classes="inspector-label" />
                                    <NumericUpDown Value="{Binding SelectedElement.Height, Mode=TwoWay}" Minimum="5" Maximum="3000" Height="30" FontSize="12" />
                                </StackPanel>
                            </Grid>

                            <!-- Rotation & Opacity -->
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                                <StackPanel Grid.Column="0" Spacing="3">
                                    <TextBlock Text="Rotation (°)" Classes="inspector-label" />
                                    <NumericUpDown Value="{Binding SelectedElement.Rotation, Mode=TwoWay}" Minimum="0" Maximum="360" Increment="15" Height="28" FontSize="12" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="3">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Grid.Column="0" Text="Opacity" Classes="inspector-label" />
                                        <TextBlock Grid.Column="1" Text="{Binding SelectedElement.Opacity, StringFormat='{}{0:P0}'}" FontSize="10" Foreground="{StaticResource WinMutedBrush}" />
                                    </Grid>
                                    <Slider Value="{Binding SelectedElement.Opacity, Mode=TwoWay}" Minimum="0.0" Maximum="1.0" Height="28" />
                                </StackPanel>
                            </Grid>

                            <!-- Alignment Buttons -->
                            <StackPanel Spacing="3">
                                <TextBlock Text="Page Alignment" Classes="inspector-label" />
                                <Grid ColumnDefinitions="*,*,*,*,*,*">
                                    <Button Grid.Column="0" Classes="mini-tool-btn" Height="28" Margin="1" Command="{Binding AlignLeftCommand}" ToolTip.Tip="Align Left">
                                        <materialIcons:MaterialIcon Kind="AlignHorizontalLeft" Width="14" Height="14" Foreground="{StaticResource WinMutedBrush}" HorizontalAlignment="Center" />
                                    </Button>
                                    <Button Grid.Column="1" Classes="mini-tool-btn" Height="28" Margin="1" Command="{Binding AlignCenterCommand}" ToolTip.Tip="Align Center">
                                        <materialIcons:MaterialIcon Kind="AlignHorizontalCenter" Width="14" Height="14" Foreground="{StaticResource WinMutedBrush}" HorizontalAlignment="Center" />
                                    </Button>
                                    <Button Grid.Column="2" Classes="mini-tool-btn" Height="28" Margin="1" Command="{Binding AlignRightCommand}" ToolTip.Tip="Align Right">
                                        <materialIcons:MaterialIcon Kind="AlignHorizontalRight" Width="14" Height="14" Foreground="{StaticResource WinMutedBrush}" HorizontalAlignment="Center" />
                                    </Button>
                                    <Button Grid.Column="3" Classes="mini-tool-btn" Height="28" Margin="1" Command="{Binding AlignTopCommand}" ToolTip.Tip="Align Top">
                                        <materialIcons:MaterialIcon Kind="AlignVerticalTop" Width="14" Height="14" Foreground="{StaticResource WinMutedBrush}" HorizontalAlignment="Center" />
                                    </Button>
                                    <Button Grid.Column="4" Classes="mini-tool-btn" Height="28" Margin="1" Command="{Binding AlignMiddleCommand}" ToolTip.Tip="Align Middle">
                                        <materialIcons:MaterialIcon Kind="AlignVerticalCenter" Width="14" Height="14" Foreground="{StaticResource WinMutedBrush}" HorizontalAlignment="Center" />
                                    </Button>
                                    <Button Grid.Column="5" Classes="mini-tool-btn" Height="28" Margin="1" Command="{Binding AlignBottomCommand}" ToolTip.Tip="Align Bottom">
                                        <materialIcons:MaterialIcon Kind="AlignVerticalBottom" Width="14" Height="14" Foreground="{StaticResource WinMutedBrush}" HorizontalAlignment="Center" />
                                    </Button>
                                </Grid>
                            </StackPanel>

                            <!-- Distribution Tools -->
                            <StackPanel Spacing="3">
                                <TextBlock Text="Smart Distribution" Classes="inspector-label" />
                                <Grid ColumnDefinitions="*,*">
                                    <Button Grid.Column="0" Classes="secondary-btn" Height="28" Margin="0,0,3,0" Command="{Binding DistributeHorizontallyCommand}">
                                        <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                                            <materialIcons:MaterialIcon Kind="DistributeHorizontalCenter" Width="14" Height="14" Foreground="{StaticResource WinMutedBrush}" />
                                            <TextBlock Text="Distribute H" FontSize="10" />
                                        </StackPanel>
                                    </Button>
                                    <Button Grid.Column="1" Classes="secondary-btn" Height="28" Margin="3,0,0,0" Command="{Binding DistributeVerticallyCommand}">
                                        <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                                            <materialIcons:MaterialIcon Kind="DistributeVerticalCenter" Width="14" Height="14" Foreground="{StaticResource WinMutedBrush}" />
                                            <TextBlock Text="Distribute V" FontSize="10" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </StackPanel>

                            <!-- Actions Row (Front, Up, Down, Back, Duplicate, Delete) -->
                            <StackPanel Spacing="3" Margin="0,4,0,0">
                                <TextBlock Text="Layer Order &amp; Quick Actions" Classes="inspector-label" />
                                <Grid ColumnDefinitions="*,*,*,*,*,*">
                                    <Button Grid.Column="0" Classes="secondary-btn" Height="30" Margin="1"
                                            Command="{Binding BringToFrontCommand}" ToolTip.Tip="Bring to Front (Ctrl+])">
                                        <materialIcons:MaterialIcon Kind="ArrangeBringToFront" Width="14" Height="14" Foreground="{StaticResource WinMutedBrush}" HorizontalAlignment="Center" />
                                    </Button>

                                    <Button Grid.Column="1" Classes="secondary-btn" Height="30" Margin="1"
                                            Command="{Binding BringForwardCommand}" ToolTip.Tip="Bring Forward (1 Step)">
                                        <materialIcons:MaterialIcon Kind="ArrowUpBold" Width="14" Height="14" Foreground="{StaticResource WinMutedBrush}" HorizontalAlignment="Center" />
                                    </Button>

                                    <Button Grid.Column="2" Classes="secondary-btn" Height="30" Margin="1"
                                            Command="{Binding SendBackwardCommand}" ToolTip.Tip="Send Backward (1 Step)">
                                        <materialIcons:MaterialIcon Kind="ArrowDownBold" Width="14" Height="14" Foreground="{StaticResource WinMutedBrush}" HorizontalAlignment="Center" />
                                    </Button>

                                    <Button Grid.Column="3" Classes="secondary-btn" Height="30" Margin="1"
                                            Command="{Binding SendToBackCommand}" ToolTip.Tip="Send to Back (Ctrl+[)">
                                        <materialIcons:MaterialIcon Kind="ArrangeSendToBack" Width="14" Height="14" Foreground="{StaticResource WinMutedBrush}" HorizontalAlignment="Center" />
                                    </Button>

                                    <Button Grid.Column="4" Classes="secondary-btn" Height="30" Margin="1"
                                            Command="{Binding DuplicateSelectedElementCommand}" ToolTip.Tip="Duplicate (Ctrl+D)">
                                        <materialIcons:MaterialIcon Kind="ContentCopy" Width="14" Height="14" Foreground="{StaticResource WinMutedBrush}" HorizontalAlignment="Center" />
                                    </Button>

                                    <Button Grid.Column="5" Classes="danger-btn" Height="30" Margin="1"
                                            Command="{Binding DeleteSelectedElementCommand}" ToolTip.Tip="Delete (Del)">
                                        <materialIcons:MaterialIcon Kind="DeleteOutline" Width="14" Height="14" Foreground="{StaticResource WinDangerBrush}" HorizontalAlignment="Center" />
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

        </Grid>
    </Border>
</UserControl>
