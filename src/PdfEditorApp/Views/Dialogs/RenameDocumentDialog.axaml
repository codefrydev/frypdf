<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PdfEditorApp.ViewModels"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="PdfEditorApp.Views.Dialogs.RenameDocumentDialog"
             x:DataType="vm:HomeViewModel">

    <!-- Modal Backdrop -->
    <Grid Background="#60000000" PointerPressed="OnBackdropPointerPressed">
        <!-- Dialog Card -->
        <Border Width="480"
                Background="{DynamicResource WinPanelBrush}"
                BorderBrush="{DynamicResource WinBorderBrush}"
                BorderThickness="1"
                CornerRadius="12"
                BoxShadow="0 20 60 #35000000"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Padding="24"
                PointerPressed="OnCardPointerPressed">

            <StackPanel Spacing="16">
                <!-- Header -->
                <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                    <Border Grid.Column="0" Width="40" Height="40" Background="{DynamicResource WinAccentLightBrush}" CornerRadius="10" Margin="0,0,12,0">
                        <materialIcons:MaterialIcon Kind="PencilOutline" Width="22" Height="22" Foreground="{DynamicResource WinAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="Rename Document" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource WinTextBrush}" />
                        <TextBlock Text="Enter a new file name for this document on disk." FontSize="11.5" Foreground="{DynamicResource WinMutedBrush}" />
                    </StackPanel>

                    <Button Grid.Column="2"
                            Classes="mini-tool-btn"
                            Width="30" Height="30"
                            Command="{Binding CancelRenameCommand}"
                            ToolTip.Tip="Close (Esc)">
                        <materialIcons:MaterialIcon Kind="Close" Width="16" Height="16" Foreground="{DynamicResource WinMutedBrush}" />
                    </Button>
                </Grid>

                <!-- Current Path Subtext -->
                <Border Background="{DynamicResource WinInputBgBrush}"
                        BorderBrush="{DynamicResource WinBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="10,7">
                    <Grid ColumnDefinitions="Auto,*">
                        <materialIcons:MaterialIcon Grid.Column="0" Kind="FolderOutline" Width="15" Height="15" Foreground="{DynamicResource WinSubtleBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding RenameTargetFilePath}"
                                   FontSize="10.5"
                                   Foreground="{DynamicResource WinMutedBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center"
                                   ToolTip.Tip="{Binding RenameTargetFilePath}" />
                    </Grid>
                </Border>

                <!-- Input Box with Extension Pill -->
                <StackPanel Spacing="6">
                    <TextBlock Text="New Name" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource WinTextBrush}" />
                    <Border Background="{DynamicResource WinInputBgBrush}"
                            BorderBrush="{DynamicResource WinBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="8,2">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBox x:Name="RenameTextBox"
                                     Grid.Column="0"
                                     Text="{Binding RenameNewName, Mode=TwoWay}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     FontSize="13"
                                     FontWeight="Medium"
                                     Foreground="{DynamicResource WinTextBrush}"
                                     VerticalAlignment="Center"
                                     KeyDown="OnRenameTextBoxKeyDown" />

                            <!-- Extension Pill -->
                            <Border Grid.Column="1"
                                    Background="{DynamicResource WinHoverBrush}"
                                    CornerRadius="4"
                                    Padding="6,3"
                                    Margin="4,0,0,0"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding RenameExtension}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource WinMutedBrush}" />
                            </Border>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- Validation Error Message -->
                <Border Background="#FEE2E2"
                        BorderBrush="#FCA5A5"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="10,6"
                        IsVisible="{Binding HasRenameError}">
                    <Grid ColumnDefinitions="Auto,*">
                        <materialIcons:MaterialIcon Grid.Column="0" Kind="AlertCircleOutline" Width="16" Height="16" Foreground="#DC2626" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding RenameErrorMessage}" FontSize="11" Foreground="#DC2626" VerticalAlignment="Center" TextWrapping="Wrap" />
                    </Grid>
                </Border>

                <!-- Action Buttons -->
                <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,8,0,0" ColumnSpacing="10">
                    <Button Grid.Column="1"
                            Content="Cancel"
                            Background="{DynamicResource WinInputBgBrush}"
                            BorderBrush="{DynamicResource WinBorderBrush}"
                            BorderThickness="1"
                            Foreground="{DynamicResource WinTextBrush}"
                            CornerRadius="6"
                            Padding="16,8"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Cursor="Hand"
                            Command="{Binding CancelRenameCommand}" />

                    <Button Grid.Column="2"
                            Content="Rename"
                            Background="{DynamicResource WinAccentBrush}"
                            Foreground="White"
                            CornerRadius="6"
                            Padding="20,8"
                            FontSize="12"
                            FontWeight="Bold"
                            Cursor="Hand"
                            Command="{Binding ConfirmRenameCommand}" />
                </Grid>

            </StackPanel>
        </Border>
    </Grid>
</UserControl>
