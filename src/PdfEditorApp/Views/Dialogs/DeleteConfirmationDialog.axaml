<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PdfEditorApp.ViewModels"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="PdfEditorApp.Views.Dialogs.DeleteConfirmationDialog"
             x:DataType="vm:HomeViewModel">

    <!-- Modal Backdrop Overlay (Transparent so only the rounded card floats) -->
    <Grid Background="Transparent" PointerPressed="OnBackdropPointerPressed">
        <!-- Dialog Card -->
        <Border Width="460"
                Background="{DynamicResource M3SurfaceBrush}"
                BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource M3ShapeCornerExtraLarge}"
                BoxShadow="{StaticResource M3ElevationModalDialog}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Margin="24"
                PointerPressed="OnCardPointerPressed">

            <Border CornerRadius="{StaticResource M3ShapeCornerExtraLarge}"
                    ClipToBounds="True"
                    Padding="24">
                <StackPanel Spacing="16">
                    <!-- Header -->
                    <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                        <Border Grid.Column="0" Width="44" Height="44" Background="{DynamicResource M3ErrorContainerBrush}" CornerRadius="{StaticResource M3ShapeCornerMedium}" Margin="0,0,12,0">
                            <materialIcons:MaterialIcon Kind="TrashCanOutline" Width="24" Height="24" Foreground="{DynamicResource M3ErrorBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="Delete Document?" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource M3OnSurfaceBrush}" />
                            <TextBlock Text="Permanently delete this file from your computer" FontSize="11.5" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                        </StackPanel>

                        <Button Grid.Column="2"
                                Classes="m3-icon-btn"
                                Width="32" Height="32"
                                Command="{Binding CancelDeleteCommand}"
                                ToolTip.Tip="Cancel (Esc)">
                            <materialIcons:MaterialIcon Kind="Close" Width="16" Height="16" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                        </Button>
                    </Grid>

                    <!-- Warning Content -->
                    <StackPanel Spacing="8">
                        <TextBlock Text="Are you sure you want to delete this file?" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource M3OnSurfaceBrush}" />
                        <TextBlock Text="This action will permanently delete the file from your disk and remove it from your recent documents list. This action cannot be undone."
                                   FontSize="12"
                                   Foreground="{DynamicResource M3OnSurfaceVariantBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <!-- Target File Location Pill -->
                    <Border Background="{DynamicResource M3SurfaceContainerLowBrush}"
                            BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource M3ShapeCornerSmall}"
                            Padding="12,10">
                        <Grid ColumnDefinitions="Auto,*">
                            <materialIcons:MaterialIcon Grid.Column="0" Kind="FileAlertOutline" Width="20" Height="20" Foreground="{DynamicResource M3ErrorBrush}" Margin="0,0,10,0" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="{Binding DeleteTargetFileName}" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource M3OnSurfaceBrush}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding DeleteTargetFilePath}" FontSize="10" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding DeleteTargetFilePath}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Action Buttons -->
                    <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,8,0,0" ColumnSpacing="10">
                        <Button Grid.Column="1"
                                Content="Cancel"
                                Classes="m3-tonal-btn"
                                CornerRadius="{StaticResource M3ShapeCornerFull}"
                                Padding="20,8"
                                Height="36"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Command="{Binding CancelDeleteCommand}" />

                        <Button Grid.Column="2"
                                Content="Delete File"
                                Background="{DynamicResource M3ErrorBrush}"
                                Foreground="{DynamicResource M3OnErrorBrush}"
                                CornerRadius="{StaticResource M3ShapeCornerFull}"
                                Padding="22,8"
                                Height="36"
                                FontSize="12"
                                FontWeight="Bold"
                                Cursor="Hand"
                                Command="{Binding ConfirmDeleteCommand}" />
                    </Grid>

                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
