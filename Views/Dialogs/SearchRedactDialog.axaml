<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PdfEditorApp.ViewModels"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="PdfEditorApp.Views.Dialogs.SearchRedactDialog"
             x:DataType="vm:MainViewModel">

    <!-- Modal Backdrop -->
    <Grid Background="#60000000">
        <!-- Dialog Card -->
        <Border Width="640"
                Background="White"
                BorderBrush="{StaticResource WinBorderBrush}"
                BorderThickness="1"
                CornerRadius="10"
                BoxShadow="0 20 60 #35000000"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Padding="24">

            <Grid RowDefinitions="Auto,*,Auto">
                <!-- Header -->
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,16">
                    <StackPanel Grid.Column="0" Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Border Width="30" Height="30" Background="#F1F5F9" CornerRadius="6">
                                <materialIcons:MaterialIcon Kind="DatabaseSearchOutline" Width="18" Height="18" Foreground="#0F172A" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Search &amp; Redact Privacy Suite" FontSize="17" FontWeight="Bold" Foreground="{StaticResource WinTextBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="Search for sensitive words or patterns and automatically apply FOIA / GDPR privileged blackout boxes." FontSize="11.5" Foreground="{StaticResource WinMutedBrush}" />
                    </StackPanel>

                    <Button Grid.Column="1"
                            Classes="mini-tool-btn"
                            Width="30" Height="30"
                            Command="{Binding CloseSearchRedactDialogCommand}">
                        <materialIcons:MaterialIcon Kind="Close" Width="16" Height="16" Foreground="{StaticResource WinMutedBrush}" />
                    </Button>
                </Grid>

                <!-- Body -->
                <StackPanel Grid.Row="1" Spacing="16">

                    <!-- Search Input -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="Search Text / Keyword to Redact" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource WinTextBrush}" />
                        <TextBox Text="{Binding SearchRedactQuery, Mode=TwoWay}"
                                 Height="36" FontSize="13" CornerRadius="6"
                                 Padding="10,8" PlaceholderText="e.g. Confidential, Revenue, Social Security..." />
                    </StackPanel>

                    <!-- Legal Exemption Code Presets -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="Legal &amp; Statutory Exemption Code" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource WinTextBrush}" />
                        <TextBox Text="{Binding SelectedExemptionCode, Mode=TwoWay}"
                                 Height="34" FontSize="12" CornerRadius="6"
                                 Padding="10,6" PlaceholderText="[REDACTED]" />

                        <WrapPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <Button Classes="secondary-btn" Height="24" Padding="6,2" Margin="0,0,6,0" Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).AddRedactionElementCommand}" CommandParameter="[REDACTED - (b)(4) TRADE SECRETS]">
                                <TextBlock Text="FOIA (b)(4) Trade Secrets" FontSize="10" />
                            </Button>
                            <Button Classes="secondary-btn" Height="24" Padding="6,2" Margin="0,0,6,0" Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).AddRedactionElementCommand}" CommandParameter="[REDACTED - (b)(6) PERSONAL PRIVACY]">
                                <TextBlock Text="FOIA (b)(6) Personal Privacy" FontSize="10" />
                            </Button>
                            <Button Classes="secondary-btn" Height="24" Padding="6,2" Margin="0,0,6,0" Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).AddRedactionElementCommand}" CommandParameter="[HIPAA PROTECTED HEALTH INFO]">
                                <TextBlock Text="HIPAA Protected" FontSize="10" />
                            </Button>
                            <Button Classes="secondary-btn" Height="24" Padding="6,2" Margin="0,0,6,0" Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).AddRedactionElementCommand}" CommandParameter="[GDPR REGULATED PII]">
                                <TextBlock Text="GDPR PII" FontSize="10" />
                            </Button>
                        </WrapPanel>
                    </StackPanel>

                    <!-- Warning Badge -->
                    <Border Background="#FEF2F2" BorderBrush="{StaticResource WinDangerBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
                        <StackPanel Spacing="2">
                            <TextBlock Text="⚠️ Permanent Redaction Notice" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource WinDangerBrush}" />
                            <TextBlock Text="Redactions are vector blackout boxes. To ensure text cannot be selected or copied, apply 'Burn In All Redactions' before exporting." FontSize="10.5" Foreground="{StaticResource WinMutedBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Footer Buttons -->
                <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto" Margin="0,20,0,0">
                    <Button Grid.Column="0" Classes="secondary-btn" Height="34" Padding="14,0" Command="{Binding CloseSearchRedactDialogCommand}">
                        <TextBlock Text="Cancel" FontSize="12" />
                    </Button>

                    <Button Grid.Column="2" Classes="primary-btn" Height="34" Padding="18,0" Command="{Binding ExecuteSearchAndRedactCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <materialIcons:MaterialIcon Kind="EyeOffOutline" Width="15" Height="15" Foreground="White" />
                            <TextBlock Text="Find &amp; Apply Redactions" FontSize="12" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
