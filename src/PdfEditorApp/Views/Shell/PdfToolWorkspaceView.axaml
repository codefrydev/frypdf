<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PdfEditorApp.ViewModels.Tools.Core"
             xmlns:models="using:PdfEditorApp.Models"
             xmlns:converters="using:PdfEditorApp.Converters"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:controls="using:PdfEditorApp.Views.Controls"
             x:Class="PdfEditorApp.Views.Shell.PdfToolWorkspaceView"
             x:Name="RootWorkspace"
             x:DataType="vm:PdfToolViewModelBase"
             Background="{DynamicResource WinBgBrush}">

    <UserControl.Resources>
        <converters:EqualityToBooleanConverter x:Key="EqualityConverter" />
        <converters:MultiplyConverter x:Key="MultiplyConverter" />
        <converters:NullToBooleanConverter x:Key="NullToBooleanConverter" />
        <converters:HexToBrushConverter x:Key="HexToBrushConverter" />
    </UserControl.Resources>

    <UserControl.Styles>
        <!-- M3 Expressive Workspace Sidebar Tab Button -->
        <Style Selector="Button.workspace-tab">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource M3OnSurfaceVariantBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="{StaticResource M3ShapeCornerMedium}" />
            <Setter Property="Padding" Value="4,7" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.18" />
                    <BrushTransition Property="Foreground" Duration="0:0:0.18" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.workspace-tab /template/ ContentPresenter">
            <Setter Property="CornerRadius" Value="{StaticResource M3ShapeCornerMedium}" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.18" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.workspace-tab:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource M3SurfaceContainerHighBrush}" />
        </Style>
        <Style Selector="Button.workspace-tab:pointerover materialIcons|MaterialIcon">
            <Setter Property="Foreground" Value="{DynamicResource M3OnSurfaceBrush}" />
        </Style>
        <Style Selector="Button.workspace-tab:pointerover TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource M3OnSurfaceBrush}" />
        </Style>

        <!-- Active Tab: Signature M3 Tonal Secondary Container -->
        <Style Selector="Button.workspace-tab.mode-active /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource M3SecondaryContainerBrush}" />
        </Style>
        <Style Selector="Button.workspace-tab.mode-active materialIcons|MaterialIcon">
            <Setter Property="Foreground" Value="{DynamicResource M3OnSecondaryContainerBrush}" />
        </Style>
        <Style Selector="Button.workspace-tab.mode-active TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource M3OnSecondaryContainerBrush}" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*">

        <!-- ================= TOOLBAR ================= -->
        <Border Grid.Row="0" Height="48"
                Background="{DynamicResource WinPanelBrush}"
                BorderBrush="{DynamicResource WinBorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto" Margin="16,0">

                <!-- Back + tool identity (merged in from the old separate header banner,
                     so there's exactly one toolbar row, like the PDF Reader) -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center"
                            ToolTip.Tip="{Binding Tool.Description}">
                    <Button Classes="secondary-btn" Padding="10,4" Command="{Binding GoBackCommand}" ToolTip.Tip="Back to All Tools (Home)">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <materialIcons:MaterialIcon Kind="ArrowLeft" Width="15" Height="15" />
                            <TextBlock Text="Back to Tools" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Rectangle Width="1" Height="22" Fill="{DynamicResource WinBorderBrush}" />
                    <Border Width="28" Height="28" CornerRadius="7"
                            Background="{Binding Tool.BackgroundAccentHex, Converter={StaticResource HexToBrushConverter}}">
                        <materialIcons:MaterialIcon Kind="{Binding Tool.IconKind}" Width="16" Height="16"
                                                    Foreground="{Binding Tool.IconColorHex, Converter={StaticResource HexToBrushConverter}}"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="{Binding Tool.Name}" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource WinTextBrush}" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Page navigation capsule -->
                <Border Grid.Column="1" Classes="toolbar-capsule" Margin="14,0,0,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="2">
                        <Button Classes="toolbar-btn" Command="{Binding Preview.PreviousPageCommand}" IsEnabled="{Binding Preview.CanGoToPreviousPage}" ToolTip.Tip="Previous Page">
                            <materialIcons:MaterialIcon Kind="ChevronLeft" Width="16" Height="16" />
                        </Button>
                        <TextBlock Text="{Binding Preview.PageIndicatorText}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource WinTextBrush}" VerticalAlignment="Center" Margin="6,0" />
                        <Button Classes="toolbar-btn" Command="{Binding Preview.NextPageCommand}" IsEnabled="{Binding Preview.CanGoToNextPage}" ToolTip.Tip="Next Page">
                            <materialIcons:MaterialIcon Kind="ChevronRight" Width="16" Height="16" />
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Zoom capsule -->
                <Border Grid.Column="2" Classes="toolbar-capsule" Margin="10,0,0,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="2">
                        <Button Classes="toolbar-btn" Command="{Binding Preview.ZoomOutCommand}" IsEnabled="{Binding Preview.CanZoomOut}" ToolTip.Tip="Zoom Out">
                            <materialIcons:MaterialIcon Kind="Minus" Width="14" Height="14" />
                        </Button>
                        <Button Classes="toolbar-btn" Width="50" Command="{Binding Preview.ResetZoomCommand}" ToolTip.Tip="Reset Zoom">
                            <TextBlock Text="{Binding Preview.ZoomPercentText}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource WinTextBrush}" />
                        </Button>
                        <Button Classes="toolbar-btn" Command="{Binding Preview.ZoomInCommand}" IsEnabled="{Binding Preview.CanZoomIn}" ToolTip.Tip="Zoom In">
                            <materialIcons:MaterialIcon Kind="Plus" Width="14" Height="14" />
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Right: guide/star (merged in from the old header banner) + primary CTA slot -->
                <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Classes="secondary-btn" Padding="7" Command="{Binding OpenToolHelpGuideCommand}" ToolTip.Tip="Guide &amp; Tips">
                        <materialIcons:MaterialIcon Kind="HelpCircleOutline" Width="16" Height="16" />
                    </Button>
                    <Button Classes="secondary-btn" Padding="7" Command="{Binding ToggleStarCommand}" ToolTip.Tip="Toggle Favorite">
                        <Panel>
                            <materialIcons:MaterialIcon Kind="Star" Width="16" Height="16" Foreground="#F59E0B" IsVisible="{Binding IsToolStarred}" />
                            <materialIcons:MaterialIcon Kind="StarOutline" Width="16" Height="16" IsVisible="{Binding !IsToolStarred}" />
                        </Panel>
                    </Button>
                    <ContentPresenter Content="{Binding ToolbarActionContent, ElementName=RootWorkspace}" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= WORKSPACE ================= -->
        <Grid Grid.Row="1" ColumnDefinitions="320,*">

            <!-- ============ LEFT: TOOL-SPECIFIC SIDEBAR (M3 Expressive) ============ -->
            <Border Grid.Column="0"
                    Background="{DynamicResource M3SurfaceContainerLowBrush}"
                    BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                    BorderThickness="0,0,1,0">
                <Grid RowDefinitions="Auto,*">

                    <!-- M3 Tab Switcher Header Bar -->
                    <Border Grid.Row="0"
                            Background="{DynamicResource M3SurfaceContainerLowBrush}"
                            BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="8,8">
                        <UniformGrid Columns="4" Rows="1">
                            <Button Classes="workspace-tab" Tag="Options" Click="OnTabButtonClick"
                                    Classes.mode-active="{Binding SelectedTab, ElementName=RootWorkspace, Converter={StaticResource EqualityConverter}, ConverterParameter=Options}"
                                    ToolTip.Tip="Tool Options &amp; Settings">
                                <StackPanel Spacing="3" HorizontalAlignment="Center">
                                    <materialIcons:MaterialIcon Kind="TuneVariant" Width="18" Height="18" HorizontalAlignment="Center" />
                                    <TextBlock Text="Options" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Classes="workspace-tab" Tag="Files" Click="OnTabButtonClick"
                                    Classes.mode-active="{Binding SelectedTab, ElementName=RootWorkspace, Converter={StaticResource EqualityConverter}, ConverterParameter=Files}"
                                    ToolTip.Tip="Selected Input Files">
                                <StackPanel Spacing="3" HorizontalAlignment="Center">
                                    <materialIcons:MaterialIcon Kind="FileDocumentMultipleOutline" Width="18" Height="18" HorizontalAlignment="Center" />
                                    <TextBlock Text="Files" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Classes="workspace-tab" Tag="Pages" Click="OnTabButtonClick"
                                    Classes.mode-active="{Binding SelectedTab, ElementName=RootWorkspace, Converter={StaticResource EqualityConverter}, ConverterParameter=Pages}"
                                    ToolTip.Tip="Page Thumbnails &amp; Navigation">
                                <StackPanel Spacing="3" HorizontalAlignment="Center">
                                    <materialIcons:MaterialIcon Kind="ViewGridOutline" Width="18" Height="18" HorizontalAlignment="Center" />
                                    <TextBlock Text="Pages" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Classes="workspace-tab" Tag="Info" Click="OnTabButtonClick"
                                    Classes.mode-active="{Binding SelectedTab, ElementName=RootWorkspace, Converter={StaticResource EqualityConverter}, ConverterParameter=Info}"
                                    ToolTip.Tip="Document Metadata &amp; Info">
                                <StackPanel Spacing="3" HorizontalAlignment="Center">
                                    <materialIcons:MaterialIcon Kind="InformationOutline" Width="18" Height="18" HorizontalAlignment="Center" />
                                    <TextBlock Text="Info" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </UniformGrid>
                    </Border>

                    <!-- Tab 1: Options (tool-supplied content) -->
                    <ScrollViewer Grid.Row="1" Padding="16,14" VerticalScrollBarVisibility="Auto"
                                  IsVisible="{Binding SelectedTab, ElementName=RootWorkspace, Converter={StaticResource EqualityConverter}, ConverterParameter=Options}">
                        <ContentPresenter Content="{Binding OptionsContent, ElementName=RootWorkspace}" />
                    </ScrollViewer>

                    <!-- Tab 2: Files (built-in, shared across every tool) -->
                    <ScrollViewer Grid.Row="1" Padding="14,12" VerticalScrollBarVisibility="Auto"
                                  IsVisible="{Binding SelectedTab, ElementName=RootWorkspace, Converter={StaticResource EqualityConverter}, ConverterParameter=Files}">
                        <StackPanel Spacing="12">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="{Binding SelectedFilesCountText}" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource M3OnSurfaceBrush}" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Command="{Binding AddFilesCommand}" Classes="m3-tonal-btn" Height="30" Padding="12,0" FontSize="11.5" FontWeight="SemiBold" Cursor="Hand">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <materialIcons:MaterialIcon Kind="Plus" Width="14" Height="14" />
                                        <TextBlock Text="Add Files" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <!-- Empty State -->
                            <Border Classes="m3-empty-state" IsVisible="{Binding !HasSelectedFiles}">
                                <StackPanel Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Border Width="48" Height="48"
                                            Background="{DynamicResource M3SurfaceContainerHighBrush}"
                                            CornerRadius="{StaticResource M3ShapeCornerLarge}"
                                            HorizontalAlignment="Center">
                                        <materialIcons:MaterialIcon Kind="FilePlusOutline" Width="24" Height="24"
                                                                    Foreground="{DynamicResource M3PrimaryBrush}"
                                                                    HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Spacing="3" HorizontalAlignment="Center">
                                        <TextBlock Text="No Files Selected" FontSize="13" FontWeight="Bold"
                                                   Foreground="{DynamicResource M3OnSurfaceBrush}" HorizontalAlignment="Center" />
                                        <TextBlock Text="Click 'Add Files' to choose documents for processing"
                                                   FontSize="11.5" Foreground="{DynamicResource M3OnSurfaceVariantBrush}"
                                                   HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <ItemsControl ItemsSource="{Binding SelectedFilePreviewItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="models:PdfFilePreviewItem">
                                        <Border Classes="m3-card-outlined" Padding="12,10" Margin="0,0,0,8">
                                            <StackPanel Spacing="8">
                                                <Grid ColumnDefinitions="Auto,*,Auto">
                                                    <Border Grid.Column="0" Width="28" Height="28" Background="{DynamicResource M3PrimaryContainerBrush}" CornerRadius="{StaticResource M3ShapeCornerSmall}" Margin="0,0,8,0">
                                                        <materialIcons:MaterialIcon Kind="FilePdfBox" Width="16" Height="16" Foreground="{DynamicResource M3PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <TextBlock Grid.Column="1" Text="{Binding FileName}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource M3OnSurfaceBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding FilePath}" />
                                                    <Button Grid.Column="2" Command="{Binding $parent[UserControl].((vm:PdfToolViewModelBase)DataContext).RemoveFileCommand}" CommandParameter="{Binding FilePath}" Classes="m3-icon-btn" Width="26" Height="26" ToolTip.Tip="Remove File">
                                                        <materialIcons:MaterialIcon Kind="Close" Width="14" Height="14" Foreground="{DynamicResource M3ErrorBrush}" />
                                                    </Button>
                                                </Grid>
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                        <Border Classes="m3-badge" Padding="6,1">
                                                            <TextBlock Text="{Binding PageCountText}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource M3OnPrimaryContainerBrush}" />
                                                        </Border>
                                                        <Border Background="{DynamicResource M3SurfaceContainerHighBrush}" CornerRadius="{StaticResource M3ShapeCornerFull}" Padding="6,1">
                                                            <TextBlock Text="{Binding FileSizeFormatted}" FontSize="10" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                                                        </Border>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                                        <Button Command="{Binding $parent[UserControl].((vm:PdfToolViewModelBase)DataContext).MoveFileUpCommand}" CommandParameter="{Binding FilePath}" Classes="mini-tool-btn" Width="26" Height="26" ToolTip.Tip="Move Up">
                                                            <materialIcons:MaterialIcon Kind="ArrowUp" Width="13" Height="13" />
                                                        </Button>
                                                        <Button Command="{Binding $parent[UserControl].((vm:PdfToolViewModelBase)DataContext).MoveFileDownCommand}" CommandParameter="{Binding FilePath}" Classes="mini-tool-btn" Width="26" Height="26" ToolTip.Tip="Move Down">
                                                            <materialIcons:MaterialIcon Kind="ArrowDown" Width="13" Height="13" />
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Tab 3: Pages (built-in, real rendered thumbnails from Preview) -->
                    <ScrollViewer Grid.Row="1" Padding="14,12" VerticalScrollBarVisibility="Auto"
                                  IsVisible="{Binding SelectedTab, ElementName=RootWorkspace, Converter={StaticResource EqualityConverter}, ConverterParameter=Pages}">
                        <StackPanel Spacing="12">

                            <!-- Empty State when no document loaded -->
                            <Border Classes="m3-empty-state" IsVisible="{Binding !Preview.HasDocument}">
                                <StackPanel Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Border Width="48" Height="48"
                                            Background="{DynamicResource M3SurfaceContainerHighBrush}"
                                            CornerRadius="{StaticResource M3ShapeCornerLarge}"
                                            HorizontalAlignment="Center">
                                        <materialIcons:MaterialIcon Kind="ViewGridOutline" Width="24" Height="24"
                                                                    Foreground="{DynamicResource M3PrimaryBrush}"
                                                                    HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Spacing="3" HorizontalAlignment="Center">
                                        <TextBlock Text="No Document Loaded" FontSize="13" FontWeight="Bold"
                                                   Foreground="{DynamicResource M3OnSurfaceBrush}" HorizontalAlignment="Center" />
                                        <TextBlock Text="Select or upload a PDF to view page thumbnails"
                                                   FontSize="11.5" Foreground="{DynamicResource M3OnSurfaceVariantBrush}"
                                                   HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Document Pages Header & Quick Nav -->
                            <Border Classes="m3-card-outlined" Padding="12,8" IsVisible="{Binding Preview.HasDocument}">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0" Spacing="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Preview.PageIndicatorText}" FontSize="12.5" FontWeight="Bold"
                                                   Foreground="{DynamicResource M3OnSurfaceBrush}" />
                                        <TextBlock Text="{Binding Preview.TotalPages, StringFormat='{}{0} pages total'}"
                                                   FontSize="10.5" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                        <Button Classes="mini-tool-btn" Width="28" Height="28"
                                                Command="{Binding Preview.PreviousPageCommand}"
                                                IsEnabled="{Binding Preview.CanGoToPreviousPage}"
                                                ToolTip.Tip="Previous Page">
                                            <materialIcons:MaterialIcon Kind="ChevronLeft" Width="16" Height="16" />
                                        </Button>
                                        <Button Classes="mini-tool-btn" Width="28" Height="28"
                                                Command="{Binding Preview.NextPageCommand}"
                                                IsEnabled="{Binding Preview.CanGoToNextPage}"
                                                ToolTip.Tip="Next Page">
                                            <materialIcons:MaterialIcon Kind="ChevronRight" Width="16" Height="16" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Thumbnails Grid -->
                            <ItemsControl ItemsSource="{Binding Preview.Pages}" IsVisible="{Binding Preview.HasDocument}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="models:PdfToolPreviewPage">
                                        <Button Classes="thumbnail-item-btn"
                                                Command="{Binding $parent[UserControl].((vm:PdfToolViewModelBase)DataContext).Preview.SelectPageCommand}"
                                                CommandParameter="{Binding}"
                                                Margin="0,0,10,14"
                                                ToolTip.Tip="{Binding PageLabel}">
                                            <StackPanel Width="134" HorizontalAlignment="Center" Spacing="6">
                                                <Border Classes="thumbnail-card"
                                                        Classes.selected="{Binding IsSelected}"
                                                        HorizontalAlignment="Center">
                                                    <Image Source="{Binding ThumbnailBitmap}" MaxWidth="126" MaxHeight="160" Stretch="Uniform" />
                                                </Border>
                                                <Border Classes="page-number-pill"
                                                        Classes.selected="{Binding IsSelected}">
                                                    <TextBlock Text="{Binding PageLabel}" FontSize="10.5" />
                                                </Border>
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Tab 4: Info (built-in file metadata) -->
                    <ScrollViewer Grid.Row="1" Padding="14,12" VerticalScrollBarVisibility="Auto"
                                  IsVisible="{Binding SelectedTab, ElementName=RootWorkspace, Converter={StaticResource EqualityConverter}, ConverterParameter=Info}">
                        <StackPanel Spacing="10">
                            <!-- Empty State -->
                            <Border Classes="m3-empty-state" IsVisible="{Binding !HasSelectedFiles}">
                                <StackPanel Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Border Width="48" Height="48"
                                            Background="{DynamicResource M3SurfaceContainerHighBrush}"
                                            CornerRadius="{StaticResource M3ShapeCornerLarge}"
                                            HorizontalAlignment="Center">
                                        <materialIcons:MaterialIcon Kind="InformationOutline" Width="24" Height="24"
                                                                    Foreground="{DynamicResource M3PrimaryBrush}"
                                                                    HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Spacing="3" HorizontalAlignment="Center">
                                        <TextBlock Text="No Metadata Available" FontSize="13" FontWeight="Bold"
                                                   Foreground="{DynamicResource M3OnSurfaceBrush}" HorizontalAlignment="Center" />
                                        <TextBlock Text="Add a document to view file and page properties"
                                                   FontSize="11.5" Foreground="{DynamicResource M3OnSurfaceVariantBrush}"
                                                   HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <ItemsControl ItemsSource="{Binding SelectedFilePreviewItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="models:PdfFilePreviewItem">
                                        <Border Classes="m3-card-outlined" Padding="14" Margin="0,0,0,10">
                                            <StackPanel Spacing="10">
                                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                    <Border Width="30" Height="30" Background="{DynamicResource M3PrimaryContainerBrush}" CornerRadius="{StaticResource M3ShapeCornerSmall}">
                                                        <materialIcons:MaterialIcon Kind="FileDocumentOutline" Width="16" Height="16" Foreground="{DynamicResource M3PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <TextBlock Text="{Binding FileName}" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource M3OnSurfaceBrush}" TextWrapping="Wrap" VerticalAlignment="Center" MaxWidth="220" />
                                                </StackPanel>

                                                <Rectangle Height="1" Fill="{DynamicResource M3OutlineVariantBrush}" />

                                                <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <materialIcons:MaterialIcon Kind="BookOpenPageVariantOutline" Width="14" Height="14" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" VerticalAlignment="Center" />
                                                        <TextBlock Text="Pages" FontSize="11.5" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1" Text="{Binding PageCountText}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource M3OnSurfaceBrush}" />
                                                </Grid>
                                                <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <materialIcons:MaterialIcon Kind="Harddisk" Width="14" Height="14" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" VerticalAlignment="Center" />
                                                        <TextBlock Text="File Size" FontSize="11.5" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1" Text="{Binding FileSizeFormatted}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource M3OnSurfaceBrush}" />
                                                </Grid>
                                                <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <materialIcons:MaterialIcon Kind="AspectRatio" Width="14" Height="14" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" VerticalAlignment="Center" />
                                                        <TextBlock Text="Page Dimensions" FontSize="11.5" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1" Text="{Binding PageDimensionsText}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource M3OnSurfaceBrush}" />
                                                </Grid>

                                                <Rectangle Height="1" Fill="{DynamicResource M3OutlineVariantBrush}" />

                                                <TextBlock Text="{Binding FilePath}" FontSize="10" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- ============ CENTER: LIVE PREVIEW & SIDE-BY-SIDE CANVAS ============ -->
            <Grid Grid.Column="1" Background="{DynamicResource WinInputBgBrush}">
                <TextBlock Text="Select a file to preview it here." FontSize="13" Foreground="{DynamicResource WinSubtleBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           IsVisible="{Binding !Preview.HasDocument}" />

                <Grid IsVisible="{Binding Preview.HasDocument}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="{Binding SideBySideColumnWidth, ElementName=RootWorkspace}" />
                    </Grid.ColumnDefinitions>

                    <!-- Left: Document Preview (supports both PDF pages and Plain Text documents) -->
                    <ScrollViewer Grid.Column="0" x:Name="PreviewScrollViewer" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <Panel HorizontalAlignment="Center" VerticalAlignment="Center">

                            <!-- Case A: Text Document Preview (.txt, .md, extracted text output) -->
                            <Border IsVisible="{Binding Preview.IsTextDocument}"
                                    Classes="reader-page-card"
                                    Width="750"
                                    Margin="30"
                                    Background="{DynamicResource WinPanelBrush}"
                                    BorderBrush="{DynamicResource WinBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    BoxShadow="0 6 24 #14000000">
                                <Grid RowDefinitions="Auto,*">
                                    <!-- Text Document Header -->
                                    <Border Grid.Row="0" BorderBrush="{DynamicResource WinBorderBrush}" BorderThickness="0,0,0,1" Padding="16,12" Background="{DynamicResource WinInputBgBrush}">
                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                                <Border Width="32" Height="32" Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="8">
                                                    <materialIcons:MaterialIcon Kind="FileDocumentOutline" Width="18" Height="18" Foreground="#16A34A" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <StackPanel Spacing="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Preview.TextDocumentFileName}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource WinTextBrush}" />
                                                    <TextBlock Text="Plain Text File (.txt)" FontSize="10.5" Foreground="{DynamicResource WinMutedBrush}" />
                                                </StackPanel>
                                            </StackPanel>

                                            <Border Grid.Column="2" Background="{DynamicResource WinHoverBrush}" CornerRadius="12" Padding="10,4" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <TextBlock Text="{Binding Preview.TextDocumentLinesCount, StringFormat='{}{0} lines'}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource WinTextBrush}" />
                                                    <TextBlock Text="·" FontSize="11" Foreground="{DynamicResource WinSubtleBrush}" />
                                                    <TextBlock Text="{Binding Preview.TextDocumentWordsCount, StringFormat='{}{0} words'}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource WinTextBrush}" />
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <!-- Text Content Display -->
                                    <TextBox Grid.Row="1"
                                             Text="{Binding Preview.TextDocumentContent}"
                                             IsReadOnly="True"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             FontFamily="Consolas, Menlo, Monaco, monospace"
                                             FontSize="12.5"
                                             LineHeight="20"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             Padding="20"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                             MinHeight="500" />
                                </Grid>
                            </Border>

                            <!-- Case B: PDF Page Preview -->
                            <Border IsVisible="{Binding !Preview.IsTextDocument}" Padding="30">
                                <Border Classes="reader-page-card">
                                    <Border.Width>
                                        <MultiBinding Converter="{StaticResource MultiplyConverter}">
                                            <Binding Path="Preview.SelectedPage.WidthPoints" />
                                            <Binding Path="Preview.ZoomLevel" />
                                        </MultiBinding>
                                    </Border.Width>
                                    <Border.Height>
                                        <MultiBinding Converter="{StaticResource MultiplyConverter}">
                                            <Binding Path="Preview.SelectedPage.HeightPoints" />
                                            <Binding Path="Preview.ZoomLevel" />
                                        </MultiBinding>
                                    </Border.Height>
                                    <Panel>
                                        <Image Source="{Binding Preview.SelectedPage.Bitmap}" Stretch="Fill" />
                                        <ContentPresenter Content="{Binding CanvasOverlayContent, ElementName=RootWorkspace}" />
                                    </Panel>
                                </Border>
                            </Border>
                        </Panel>
                    </ScrollViewer>

                    <!-- Draggable Splitter between Preview and Side-by-Side Panel -->
                    <GridSplitter Grid.Column="1" Width="5" Background="{DynamicResource WinBorderBrush}" ResizeDirection="Columns"
                                  IsVisible="{Binding SideBySideContent, ElementName=RootWorkspace, Converter={StaticResource NullToBooleanConverter}}" />

                    <!-- Right: Side-by-Side Panel (e.g. OCR Extracted Text) -->
                    <Border Grid.Column="2"
                            Background="{DynamicResource WinPanelBrush}"
                            BorderBrush="{DynamicResource WinBorderBrush}"
                            BorderThickness="1,0,0,0"
                            IsVisible="{Binding SideBySideContent, ElementName=RootWorkspace, Converter={StaticResource NullToBooleanConverter}}">
                        <ContentPresenter Content="{Binding SideBySideContent, ElementName=RootWorkspace}" />
                    </Border>
                </Grid>

                <Border Background="#66000000" IsVisible="{Binding Preview.IsLoading}" IsHitTestVisible="False">
                    <StackPanel Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <controls:LoadingAnimationControl Width="64" Height="64" HorizontalAlignment="Center" />
                        <TextBlock Text="Loading preview..." Foreground="White" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
