<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PdfEditorApp.ViewModels"
             xmlns:models="using:PdfEditorApp.Models"
             xmlns:converters="using:PdfEditorApp.Converters"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="800"
             x:Class="PdfEditorApp.Views.PdfViewerView"
             x:DataType="vm:PdfViewerViewModel"
             Background="{DynamicResource WinBgBrush}">

    <UserControl.Resources>
        <converters:ZoomPercentageConverter x:Key="ZoomPercentageConverter" />
        <converters:EqualityToBooleanConverter x:Key="EqualityConverter" />
        <converters:NullToBooleanConverter x:Key="NullToBooleanConverter" />
        <converters:BooleanToBrushConverter x:Key="BooleanToBrushConverter" />
        <converters:MultiplyConverter x:Key="MultiplyConverter" />
        <converters:HexToBrushConverter x:Key="HexToBrushConverter" />
    </UserControl.Resources>

    <UserControl.Styles>
        <!-- Page Card Physical Styling -->
        <Style Selector="Border.reader-page-card">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="BoxShadow" Value="0 8 28 #22000000, 0 1 3 #12000000" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="ClipToBounds" Value="True" />
        </Style>

        <!-- Reading Theme Specific Paper Styling -->
        <Style Selector="Border.reading-theme-sepia">
            <Setter Property="Background" Value="#FBF0D9" />
            <Setter Property="BorderBrush" Value="#E6D5B8" />
        </Style>
        <Style Selector="Border.reading-theme-dark">
            <Setter Property="Background" Value="#1E293B" />
            <Setter Property="BorderBrush" Value="#334155" />
        </Style>
        <Style Selector="Border.reading-theme-highcontrast">
            <Setter Property="Background" Value="#000000" />
            <Setter Property="BorderBrush" Value="#FFFF00" />
        </Style>

        <!-- Toolbar Segmented Capsule -->
        <Style Selector="Border.toolbar-capsule">
            <Setter Property="Background" Value="{DynamicResource WinInputBgBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource WinBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Padding" Value="3,2" />
        </Style>

        <!-- Compact Tool Button -->
        <Style Selector="Button.toolbar-btn">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.toolbar-btn:pointerover">
            <Setter Property="Background" Value="{DynamicResource WinHoverBrush}" />
        </Style>

        <!-- Active Mode Button in Segmented Capsule -->
        <Style Selector="Button.mode-active">
            <Setter Property="Background" Value="{DynamicResource WinAccentLightBrush}" />
        </Style>

        <!-- Thumbnail Item Card -->
        <Style Selector="Border.thumbnail-card">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="{DynamicResource WinBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="6" />
            <Setter Property="BoxShadow" Value="0 2 8 #10000000" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
                    <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.thumbnail-card:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource WinAccentBrush}" />
            <Setter Property="BoxShadow" Value="0 4 14 #200F6CBD" />
        </Style>
        <Style Selector="Border.thumbnail-card.selected">
            <Setter Property="BorderBrush" Value="#0F6CBD" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="Background" Value="#F0F7FF" />
            <Setter Property="BoxShadow" Value="0 4 16 #280F6CBD" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- ============================================================== -->
        <!-- 1. TOP SLEEK ACROBAT-STYLE READING TOOLBAR (Apple Preview/Acro)-->
        <!-- ============================================================== -->
        <Border Grid.Row="0"
                Background="{DynamicResource WinPanelBrush}"
                Height="46"
                BorderBrush="{DynamicResource WinBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="10,0"
                IsVisible="{Binding !IsFullscreen}">
            <Grid ColumnDefinitions="Auto,*,Auto">

                <!-- Left Section: Back, Document Title & Open -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                    <!-- Back to Dashboard -->
                    <Button Classes="toolbar-btn"
                            Command="{Binding BackToHomeCommand}"
                            ToolTip.Tip="Back to Home Dashboard (⌘W)">
                        <materialIcons:MaterialIcon Kind="ArrowLeft" Width="17" Height="17" Foreground="{DynamicResource WinMutedBrush}" />
                    </Button>

                    <Rectangle Width="1" Height="16" Fill="{DynamicResource WinBorderBrush}" Margin="1,0" />

                    <!-- PDF File Badge & Title -->
                    <materialIcons:MaterialIcon Kind="FilePdfBox" Width="20" Height="20" Foreground="#E11D48" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding DocumentTitle}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource WinTextBrush}"
                               VerticalAlignment="Center"
                               MaxWidth="200"
                               TextTrimming="CharacterEllipsis"
                               ToolTip.Tip="{Binding DocumentTitle}" />

                    <!-- Pages Count Pill -->
                    <Border Background="{DynamicResource WinHoverBrush}" CornerRadius="10" Padding="7,2" VerticalAlignment="Center">
                        <TextBlock Text="{Binding TotalPagesCount, StringFormat='{}{0} pgs'}"
                                   FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource WinMutedBrush}" />
                    </Border>

                    <!-- Open Another PDF Button -->
                    <Button Classes="toolbar-btn"
                            Width="30" Height="28"
                            Command="{Binding OpenAnotherPdfCommand}"
                            ToolTip.Tip="Open another PDF document to read (⌘O)">
                        <materialIcons:MaterialIcon Kind="FolderOpenOutline" Width="16" Height="16" Foreground="{DynamicResource WinMutedBrush}" />
                    </Button>
                </StackPanel>

                <!-- Center Section: Navigation, Layout Modes, Zoom Capsules -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">

                    <!-- Capsule 1: Navigation & Direct Jump Box -->
                    <Border Classes="toolbar-capsule">
                        <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                            <Button Classes="toolbar-btn" Width="24" Height="24" Command="{Binding FirstPageCommand}" ToolTip.Tip="First Page (Home)">
                                <materialIcons:MaterialIcon Kind="PageFirst" Width="13" Height="13" Foreground="{DynamicResource WinMutedBrush}" />
                            </Button>
                            <Button Classes="toolbar-btn" Width="24" Height="24" Command="{Binding PreviousPageCommand}" ToolTip.Tip="Previous Page (PageUp / ⌥←)">
                                <materialIcons:MaterialIcon Kind="ChevronLeft" Width="15" Height="15" Foreground="{DynamicResource WinMutedBrush}" />
                            </Button>

                            <!-- Direct Page Jump Input Box -->
                            <TextBox x:Name="JumpPageTextBox"
                                     Text="{Binding JumpPageText, Mode=TwoWay}"
                                     Width="34"
                                     Height="22"
                                     FontSize="11"
                                     FontWeight="SemiBold"
                                     TextAlignment="Center"
                                     Padding="0,1"
                                     VerticalAlignment="Center"
                                     CornerRadius="4"
                                     ToolTip.Tip="Type page number and press Enter to jump">
                                <TextBox.KeyBindings>
                                    <KeyBinding Gesture="Enter" Command="{Binding CommitJumpPageCommand}" />
                                </TextBox.KeyBindings>
                            </TextBox>

                            <TextBlock Text="{Binding TotalPagesCount, StringFormat='/ {0}'}"
                                       FontSize="11"
                                       FontWeight="Medium"
                                       Foreground="{DynamicResource WinMutedBrush}"
                                       VerticalAlignment="Center"
                                       Margin="2,0,3,0" />

                            <Button Classes="toolbar-btn" Width="24" Height="24" Command="{Binding NextPageCommand}" ToolTip.Tip="Next Page (PageDown / ⌥→)">
                                <materialIcons:MaterialIcon Kind="ChevronRight" Width="15" Height="15" Foreground="{DynamicResource WinMutedBrush}" />
                            </Button>
                            <Button Classes="toolbar-btn" Width="24" Height="24" Command="{Binding LastPageCommand}" ToolTip.Tip="Last Page (End)">
                                <materialIcons:MaterialIcon Kind="PageLast" Width="13" Height="13" Foreground="{DynamicResource WinMutedBrush}" />
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Capsule 2: Layout Modes (Continuous, Single Page, Two-Page Spread) -->
                    <Border Classes="toolbar-capsule">
                        <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                            <!-- Continuous Scroll -->
                            <Button Classes="toolbar-btn" Width="26" Height="24"
                                    Classes.mode-active="{Binding IsContinuousScroll}"
                                    Command="{Binding SetLayoutModeCommand}" CommandParameter="ContinuousScroll"
                                    ToolTip.Tip="Continuous Vertical Scroll">
                                <materialIcons:MaterialIcon Kind="ViewHeadline" Width="14" Height="14"
                                                            Foreground="{Binding IsContinuousScroll, Converter={StaticResource BooleanToBrushConverter}, ConverterParameter='#0F6CBD|#64748B'}" />
                            </Button>
                            <!-- Single Page -->
                            <Button Classes="toolbar-btn" Width="26" Height="24"
                                    Classes.mode-active="{Binding IsSinglePageMode}"
                                    Command="{Binding SetLayoutModeCommand}" CommandParameter="SinglePage"
                                    ToolTip.Tip="Single Page View">
                                <materialIcons:MaterialIcon Kind="FileDocumentOutline" Width="14" Height="14"
                                                            Foreground="{Binding IsSinglePageMode, Converter={StaticResource BooleanToBrushConverter}, ConverterParameter='#0F6CBD|#64748B'}" />
                            </Button>
                            <!-- Two-Page Book Spread -->
                            <Button Classes="toolbar-btn" Width="26" Height="24"
                                    Classes.mode-active="{Binding IsTwoPageSpreadMode}"
                                    Command="{Binding SetLayoutModeCommand}" CommandParameter="TwoPageSpread"
                                    ToolTip.Tip="Two-Page Spread (Book &amp; Magazine Mode)">
                                <materialIcons:MaterialIcon Kind="BookOpenPageVariantOutline" Width="14" Height="14"
                                                            Foreground="{Binding IsTwoPageSpreadMode, Converter={StaticResource BooleanToBrushConverter}, ConverterParameter='#0F6CBD|#64748B'}" />
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Capsule 3: Zoom Controls -->
                    <Border Classes="toolbar-capsule">
                        <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                            <Button Classes="toolbar-btn" Width="24" Height="24" Command="{Binding FitToWidthCommand}" ToolTip.Tip="Fit to Width (⌘1)">
                                <materialIcons:MaterialIcon Kind="ArrowExpandHorizontal" Width="13" Height="13" Foreground="{DynamicResource WinMutedBrush}" />
                            </Button>
                            <Button Classes="toolbar-btn" Width="24" Height="24" Command="{Binding FitToPageCommand}" ToolTip.Tip="Fit to Page (⌘9)">
                                <materialIcons:MaterialIcon Kind="FitToScreenOutline" Width="13" Height="13" Foreground="{DynamicResource WinMutedBrush}" />
                            </Button>

                            <Rectangle Width="1" Height="12" Fill="{DynamicResource WinBorderBrush}" Margin="2,0" />

                            <Button Classes="toolbar-btn" Width="22" Height="24" Command="{Binding ZoomOutCommand}" ToolTip.Tip="Zoom Out (⌘-)">
                                <materialIcons:MaterialIcon Kind="Minus" Width="13" Height="13" Foreground="{DynamicResource WinMutedBrush}" />
                            </Button>

                            <!-- Zoom Percentage Button (Click resets 100%) -->
                            <Button Background="Transparent"
                                    BorderThickness="0"
                                    Padding="4,2"
                                    Command="{Binding ResetZoomCommand}"
                                    ToolTip.Tip="Reset 100% Zoom (⌘0)">
                                <TextBlock Text="{Binding ZoomPercentageText}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource WinTextBrush}" Width="36" TextAlignment="Center" />
                            </Button>

                            <Button Classes="toolbar-btn" Width="22" Height="24" Command="{Binding ZoomInCommand}" ToolTip.Tip="Zoom In (⌘+)">
                                <materialIcons:MaterialIcon Kind="Plus" Width="13" Height="13" Foreground="{DynamicResource WinMutedBrush}" />
                            </Button>
                        </StackPanel>
                    </Border>

                </StackPanel>

                <!-- Right Section: Themes, Tools, Fullscreen & Edit in Studio -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">

                    <!-- Capsule 4: Reading Themes (Daylight, Sepia, Night, High Contrast) -->
                    <Border Classes="toolbar-capsule">
                        <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                            <!-- Daylight -->
                            <Button Classes="toolbar-btn" Width="22" Height="22"
                                    Command="{Binding SetReadingThemeCommand}" CommandParameter="Default"
                                    ToolTip.Tip="Daylight Theme (Standard White)">
                                <materialIcons:MaterialIcon Kind="WhiteBalanceSunny" Width="13" Height="13"
                                                            Foreground="{Binding IsThemeDefault, Converter={StaticResource BooleanToBrushConverter}, ConverterParameter='#0F6CBD|#94A3B8'}" />
                            </Button>
                            <!-- Sepia -->
                            <Button Classes="toolbar-btn" Width="22" Height="22"
                                    Command="{Binding SetReadingThemeCommand}" CommandParameter="Sepia"
                                    ToolTip.Tip="Warm Sepia Book Theme (Reduced Eye Strain)">
                                <materialIcons:MaterialIcon Kind="BookOpenOutline" Width="13" Height="13"
                                                            Foreground="{Binding IsThemeSepia, Converter={StaticResource BooleanToBrushConverter}, ConverterParameter='#D97706|#94A3B8'}" />
                            </Button>
                            <!-- Dark Night -->
                            <Button Classes="toolbar-btn" Width="22" Height="22"
                                    Command="{Binding SetReadingThemeCommand}" CommandParameter="Dark"
                                    ToolTip.Tip="Dark Night Reading Theme (OLED / Low Light)">
                                <materialIcons:MaterialIcon Kind="WeatherNight" Width="13" Height="13"
                                                            Foreground="{Binding IsThemeDark, Converter={StaticResource BooleanToBrushConverter}, ConverterParameter='#6366F1|#94A3B8'}" />
                            </Button>
                            <!-- High Contrast -->
                            <Button Classes="toolbar-btn" Width="22" Height="22"
                                    Command="{Binding SetReadingThemeCommand}" CommandParameter="HighContrast"
                                    ToolTip.Tip="High Contrast Mode (Accessibility)">
                                <materialIcons:MaterialIcon Kind="ContrastCircle" Width="13" Height="13"
                                                            Foreground="{Binding IsThemeHighContrast, Converter={StaticResource BooleanToBrushConverter}, ConverterParameter='#EAB308|#94A3B8'}" />
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Search Trigger -->
                    <Button Classes="toolbar-btn"
                            Width="28" Height="28"
                            Command="{Binding ToggleSearchBarCommand}"
                            ToolTip.Tip="Find Text in Document (⌘F / Ctrl+F)">
                        <materialIcons:MaterialIcon Kind="Magnify" Width="16" Height="16" Foreground="{DynamicResource WinMutedBrush}" />
                    </Button>

                    <!-- Markup Tools Capsule -->
                    <Border Classes="toolbar-capsule">
                        <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                            <!-- Highlight -->
                            <Button Classes="toolbar-btn" Width="24" Height="24"
                                    Command="{Binding AddHighlightAnnotationCommand}"
                                    CommandParameter="#FEF08A"
                                    ToolTip.Tip="Highlight Page Region">
                                <materialIcons:MaterialIcon Kind="FormatColorHighlight" Width="14" Height="14" Foreground="#CA8A04" />
                            </Button>
                            <!-- Sticky Note -->
                            <Button Classes="toolbar-btn" Width="24" Height="24"
                                    Command="{Binding OpenAddNoteDialogCommand}"
                                    ToolTip.Tip="Add Sticky Note Annotation">
                                <materialIcons:MaterialIcon Kind="CommentTextOutline" Width="14" Height="14" Foreground="#0284C7" />
                            </Button>
                            <!-- Stamp -->
                            <Button Classes="toolbar-btn" Width="24" Height="24"
                                    Command="{Binding AddStampCommand}"
                                    CommandParameter="APPROVED"
                                    ToolTip.Tip="Apply 'APPROVED' Stamp">
                                <materialIcons:MaterialIcon Kind="CheckDecagramOutline" Width="14" Height="14" Foreground="#16A34A" />
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Rotate Clockwise -->
                    <Button Classes="toolbar-btn"
                            Width="28" Height="28"
                            Command="{Binding RotateClockwiseCommand}"
                            ToolTip.Tip="Rotate 90° Clockwise">
                        <materialIcons:MaterialIcon Kind="RotateRight" Width="15" Height="15" Foreground="{DynamicResource WinMutedBrush}" />
                    </Button>

                    <!-- Save Copy As -->
                    <Button Classes="toolbar-btn"
                            Width="28" Height="28"
                            Command="{Binding SaveAsCommand}"
                            ToolTip.Tip="Save Document Copy As...">
                        <materialIcons:MaterialIcon Kind="ContentSaveOutline" Width="15" Height="15" Foreground="{DynamicResource WinMutedBrush}" />
                    </Button>

                    <!-- Fullscreen Mode -->
                    <Button Classes="toolbar-btn"
                            Width="28" Height="28"
                            Command="{Binding ToggleFullscreenCommand}"
                            ToolTip.Tip="Presentation Fullscreen Mode (F11)">
                        <materialIcons:MaterialIcon Kind="Fullscreen" Width="15" Height="15" Foreground="{DynamicResource WinMutedBrush}" />
                    </Button>

                    <Rectangle Width="1" Height="16" Fill="{DynamicResource WinBorderBrush}" Margin="1,0" />

                    <!-- EDIT IN FRYPDF PRIMARY ACTION BUTTON -->
                    <Button Background="#0F6CBD"
                            Foreground="White"
                            CornerRadius="6"
                            Padding="11,5"
                            FontWeight="SemiBold"
                            FontSize="11.5"
                            Command="{Binding EditInStudioCommand}"
                            Cursor="Hand"
                            ToolTip.Tip="Open in FryPDF Editor to modify text, layout, and images">
                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                            <materialIcons:MaterialIcon Kind="DrawPen" Width="14" Height="14" Foreground="White" />
                            <TextBlock Text="Edit in FryPDF" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Rectangle Width="1" Height="16" Fill="{DynamicResource WinBorderBrush}" Margin="1,0" />

                    <!-- Navigation Sidebar Drawer Toggle -->
                    <Button Classes="toolbar-btn"
                            Width="28" Height="28"
                            Command="{Binding ToggleSidebarCommand}"
                            Classes.mode-active="{Binding IsSidebarOpen}"
                            ToolTip.Tip="Toggle Navigation Sidebar (⌘B)">
                        <materialIcons:MaterialIcon Kind="DockLeft" Width="16" Height="16"
                                                    Foreground="{Binding IsSidebarOpen, Converter={StaticResource BooleanToBrushConverter}, ConverterParameter='#0F6CBD|#64748B'}" />
                    </Button>
                </StackPanel>

            </Grid>
        </Border>

        <!-- ======================================================= -->
        <!-- 2. MAIN WORKSPACE (LEFT SIDEBAR + CENTER READING CANVAS) -->
        <!-- ======================================================= -->
        <Grid Grid.Row="1" ColumnDefinitions="Auto,*">

            <!-- LEFT NAVIGATION & INSPECTION SIDEBAR -->
            <Border Grid.Column="0"
                    Width="280"
                    Background="{DynamicResource WinPanelBrush}"
                    BorderBrush="{DynamicResource WinBorderBrush}"
                    BorderThickness="0,0,1,0"
                    IsVisible="{Binding IsSidebarOpen}">
                <Grid RowDefinitions="Auto,*">

                    <!-- Sidebar Tab Switcher (5 Tabs with active styling) -->
                    <Border Grid.Row="0" Background="{DynamicResource WinInputBgBrush}" BorderBrush="{DynamicResource WinBorderBrush}" BorderThickness="0,0,0,1" Padding="4,4">
                        <UniformGrid Columns="5">
                            <!-- Thumbnails Tab -->
                            <Button Classes="toolbar-btn"
                                    Height="30"
                                    Classes.mode-active="{Binding SelectedSidebarTab, Converter={StaticResource EqualityConverter}, ConverterParameter=Thumbnails}"
                                    Command="{Binding SelectSidebarTabCommand}"
                                    CommandParameter="Thumbnails"
                                    ToolTip.Tip="Page Thumbnails">
                                <materialIcons:MaterialIcon Kind="ViewGridOutline" Width="15" Height="15" Foreground="{DynamicResource WinMutedBrush}" />
                            </Button>

                            <!-- Bookmarks / Outline Tab -->
                            <Button Classes="toolbar-btn"
                                    Height="30"
                                    Classes.mode-active="{Binding SelectedSidebarTab, Converter={StaticResource EqualityConverter}, ConverterParameter=Bookmarks}"
                                    Command="{Binding SelectSidebarTabCommand}"
                                    CommandParameter="Bookmarks"
                                    ToolTip.Tip="Document Outline &amp; Bookmarks">
                                <materialIcons:MaterialIcon Kind="BookmarkOutline" Width="15" Height="15" Foreground="{DynamicResource WinMutedBrush}" />
                            </Button>

                            <!-- Annotations Tab -->
                            <Button Classes="toolbar-btn"
                                    Height="30"
                                    Classes.mode-active="{Binding SelectedSidebarTab, Converter={StaticResource EqualityConverter}, ConverterParameter=Annotations}"
                                    Command="{Binding SelectSidebarTabCommand}"
                                    CommandParameter="Annotations"
                                    ToolTip.Tip="Review Annotations &amp; Comments">
                                <materialIcons:MaterialIcon Kind="CommentTextOutline" Width="15" Height="15" Foreground="{DynamicResource WinMutedBrush}" />
                            </Button>

                            <!-- Search Tab -->
                            <Button Classes="toolbar-btn"
                                    Height="30"
                                    Classes.mode-active="{Binding SelectedSidebarTab, Converter={StaticResource EqualityConverter}, ConverterParameter=Search}"
                                    Command="{Binding SelectSidebarTabCommand}"
                                    CommandParameter="Search"
                                    ToolTip.Tip="Search in PDF">
                                <materialIcons:MaterialIcon Kind="Magnify" Width="15" Height="15" Foreground="{DynamicResource WinMutedBrush}" />
                            </Button>

                            <!-- Metadata Info Tab -->
                            <Button Classes="toolbar-btn"
                                    Height="30"
                                    Classes.mode-active="{Binding SelectedSidebarTab, Converter={StaticResource EqualityConverter}, ConverterParameter=Info}"
                                    Command="{Binding SelectSidebarTabCommand}"
                                    CommandParameter="Info"
                                    ToolTip.Tip="Document Properties &amp; Metadata">
                                <materialIcons:MaterialIcon Kind="InformationOutline" Width="15" Height="15" Foreground="{DynamicResource WinMutedBrush}" />
                            </Button>
                        </UniformGrid>
                    </Border>

                    <!-- Tab 1: Thumbnails List (Apple Preview Floating Style) -->
                    <ScrollViewer Grid.Row="1"
                                  IsVisible="{Binding SelectedSidebarTab, Converter={StaticResource EqualityConverter}, ConverterParameter=Thumbnails}"
                                  Padding="12,10">
                        <ItemsControl ItemsSource="{Binding Pages}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:PdfViewerPageItem">
                                    <Button Background="Transparent"
                                            BorderThickness="0"
                                            Padding="0"
                                            Margin="0,0,0,14"
                                            HorizontalAlignment="Center"
                                            Cursor="Hand"
                                            Command="{Binding $parent[UserControl].((vm:PdfViewerViewModel)DataContext).SelectPageCommand}"
                                            CommandParameter="{Binding}">
                                        <StackPanel Spacing="5" HorizontalAlignment="Center">
                                            <!-- Floating Page Thumbnail Card -->
                                            <Border Classes="thumbnail-card"
                                                    Classes.selected="{Binding IsSelected}"
                                                    Width="170" Height="230">
                                                <Image Source="{Binding Bitmap}"
                                                       Stretch="Uniform"
                                                       RenderOptions.BitmapInterpolationMode="HighQuality"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                            </Border>

                                            <!-- Page Number Pill -->
                                            <Border Background="{Binding IsSelected, Converter={StaticResource BooleanToBrushConverter}, ConverterParameter='#0F6CBD|#E2E8F0'}"
                                                    CornerRadius="10"
                                                    Padding="8,2"
                                                    HorizontalAlignment="Center">
                                                <TextBlock Text="{Binding PageLabel}"
                                                           FontSize="10"
                                                           FontWeight="Bold"
                                                           Foreground="{Binding IsSelected, Converter={StaticResource BooleanToBrushConverter}, ConverterParameter='#FFFFFF|#64748B'}" />
                                            </Border>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Tab 2: Bookmarks / Outline Tree -->
                    <ScrollViewer Grid.Row="1"
                                  IsVisible="{Binding SelectedSidebarTab, Converter={StaticResource EqualityConverter}, ConverterParameter=Bookmarks}"
                                  Padding="12">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Document Outline" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource WinTextBrush}" />

                            <TextBlock Text="No outline bookmarks in this PDF document."
                                       FontSize="11" Foreground="{DynamicResource WinMutedBrush}"
                                       IsVisible="{Binding !HasBookmarks}"
                                       Margin="0,10" />

                            <ItemsControl ItemsSource="{Binding Bookmarks}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:PdfViewerBookmarkItem">
                                        <Button Classes="toolbar-btn"
                                                HorizontalAlignment="Stretch"
                                                Height="32"
                                                Padding="8,4"
                                                Margin="0,2"
                                                Command="{Binding $parent[UserControl].((vm:PdfViewerViewModel)DataContext).JumpToBookmarkCommand}"
                                                CommandParameter="{Binding}">
                                            <Grid ColumnDefinitions="Auto,*,Auto">
                                                <materialIcons:MaterialIcon Grid.Column="0" Kind="BookmarkOutline" Width="14" Height="14" Foreground="#0F6CBD" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="11" Foreground="{DynamicResource WinTextBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                <Border Grid.Column="2" Background="{DynamicResource WinHoverBrush}" CornerRadius="4" Padding="5,1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding PageNumber, StringFormat='{}p.{0}'}" FontSize="10" Foreground="{DynamicResource WinMutedBrush}" />
                                                </Border>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Tab 3: Annotations & Review Comments List -->
                    <ScrollViewer Grid.Row="1"
                                  IsVisible="{Binding SelectedSidebarTab, Converter={StaticResource EqualityConverter}, ConverterParameter=Annotations}"
                                  Padding="12">
                        <StackPanel Spacing="10">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="Reader Annotations" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource WinTextBrush}" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Classes="toolbar-btn" Command="{Binding OpenAddNoteDialogCommand}" ToolTip.Tip="Add Sticky Note">
                                    <materialIcons:MaterialIcon Kind="Plus" Width="15" Height="15" Foreground="#0F6CBD" />
                                </Button>
                            </Grid>

                            <TextBlock Text="No annotations yet. Use the markup tools above to highlight, stamp, or add notes."
                                       FontSize="11" Foreground="{DynamicResource WinMutedBrush}" TextWrapping="Wrap"
                                       IsVisible="{Binding !HasAnnotations}"
                                       Margin="0,10" />

                            <ItemsControl ItemsSource="{Binding Annotations}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:PdfViewerAnnotationItem">
                                        <Border Background="{DynamicResource WinInputBgBrush}" BorderBrush="{DynamicResource WinBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,8">
                                            <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto">
                                                <materialIcons:MaterialIcon Grid.Column="0" Kind="{Binding IconKind}" Width="15" Height="15" Foreground="#0F6CBD" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                <StackPanel Grid.Column="1" Spacing="1">
                                                    <TextBlock Text="{Binding Type}" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource WinTextBrush}" />
                                                    <TextBlock Text="{Binding TimeFormatted}" FontSize="9.5" Foreground="{DynamicResource WinMutedBrush}" />
                                                </StackPanel>
                                                <Button Grid.Column="2" Classes="toolbar-btn" Width="20" Height="20"
                                                        Command="{Binding $parent[UserControl].((vm:PdfViewerViewModel)DataContext).DeleteAnnotationCommand}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip.Tip="Delete Annotation">
                                                    <materialIcons:MaterialIcon Kind="Close" Width="12" Height="12" Foreground="{DynamicResource WinMutedBrush}" />
                                                </Button>

                                                <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                                                           Text="{Binding Content}" FontSize="11" Foreground="{DynamicResource WinTextBrush}" TextWrapping="Wrap" Margin="0,6,0,0" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Tab 4: Search in Document -->
                    <ScrollViewer Grid.Row="1"
                                  IsVisible="{Binding SelectedSidebarTab, Converter={StaticResource EqualityConverter}, ConverterParameter=Search}"
                                  Padding="12">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Find in PDF" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource WinTextBrush}" />

                            <!-- Search Input -->
                            <TextBox Text="{Binding SearchQuery, Mode=TwoWay}"
                                     PlaceholderText="Type search text..."
                                     FontSize="11.5"
                                     Padding="7,5" />

                            <!-- Options -->
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <CheckBox IsChecked="{Binding SearchMatchCase}" Content="Match Case" FontSize="10.5" />
                                <CheckBox IsChecked="{Binding SearchWholeWord}" Content="Whole Words" FontSize="10.5" />
                            </StackPanel>

                            <TextBlock Text="{Binding SearchStatusText}" FontSize="10.5" Foreground="{DynamicResource WinMutedBrush}" />

                            <ItemsControl ItemsSource="{Binding SearchResults}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:PdfViewerSearchMatch">
                                        <Button Classes="toolbar-btn"
                                                HorizontalAlignment="Stretch"
                                                Height="NaN"
                                                Padding="8"
                                                Margin="0,0,0,6"
                                                Command="{Binding $parent[UserControl].((vm:PdfViewerViewModel)DataContext).JumpToMatchCommand}"
                                                CommandParameter="{Binding}">
                                            <StackPanel Spacing="3" HorizontalAlignment="Left">
                                                <Border Background="#EFF6FF" CornerRadius="4" Padding="5,1" HorizontalAlignment="Left">
                                                    <TextBlock Text="{Binding PageNumber, StringFormat='{}Page {0}'}" FontSize="10" FontWeight="Bold" Foreground="#0F6CBD" />
                                                </Border>
                                                <TextBlock Text="{Binding Snippet}" FontSize="11" Foreground="{DynamicResource WinTextBrush}" TextWrapping="Wrap" TextAlignment="Left" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Tab 5: Metadata Properties Info -->
                    <ScrollViewer Grid.Row="1"
                                  IsVisible="{Binding SelectedSidebarTab, Converter={StaticResource EqualityConverter}, ConverterParameter=Info}"
                                  Padding="12">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Document Properties" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource WinTextBrush}" />

                            <ItemsControl ItemsSource="{Binding MetadataItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:PdfViewerMetadataItem">
                                        <Border Background="{DynamicResource WinInputBgBrush}" BorderBrush="{DynamicResource WinBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,0,0,6">
                                            <Grid ColumnDefinitions="Auto,*">
                                                <materialIcons:MaterialIcon Grid.Column="0" Kind="{Binding IconKind}" Width="14" Height="14" Foreground="{DynamicResource WinMutedBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                <StackPanel Grid.Column="1" Spacing="1">
                                                    <TextBlock Text="{Binding Label}" FontSize="9.5" FontWeight="Medium" Foreground="{DynamicResource WinMutedBrush}" />
                                                    <TextBlock Text="{Binding Value}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource WinTextBrush}" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>

                </Grid>
            </Border>

            <!-- CENTER DOCUMENT VIEWPORT CANVAS (Acrobat/Preview Paper Rendering) -->
            <Grid Grid.Column="1" Background="{DynamicResource WinBgBrush}">

                <!-- Top Indeterminate Progress Bar for instant feedback while opening -->
                <ProgressBar IsIndeterminate="True"
                             IsVisible="{Binding IsLoading}"
                             Height="2.5"
                             VerticalAlignment="Top"
                             ZIndex="999"
                             Background="Transparent"
                             Foreground="#0F6CBD" />

                <!-- Instant Opening Feedback Badge -->
                <Border Background="Transparent"
                        IsVisible="{Binding IsOpeningDocument}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        ZIndex="500">
                    <Border Background="{DynamicResource WinPanelBrush}"
                            BorderBrush="{DynamicResource WinBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="14"
                            Padding="28,20"
                            BoxShadow="0 12 32 0 #25000000">
                        <StackPanel Spacing="12" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <materialIcons:MaterialIcon Kind="FileDocumentOutline" Width="40" Height="40" Foreground="#0F6CBD" HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding DocumentTitle}" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource WinTextBrush}" HorizontalAlignment="Center" />
                            <ProgressBar IsIndeterminate="True" Width="160" Height="3" HorizontalAlignment="Center" Foreground="#0F6CBD" />
                            <TextBlock Text="{Binding StatusMessage}" FontSize="11" Foreground="{DynamicResource WinMutedBrush}" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Border>

                <!-- Layout 1: Continuous Vertical Scroll Mode -->
                <ScrollViewer x:Name="ContinuousScrollViewer"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"
                              Padding="32"
                              IsVisible="{Binding IsContinuousScroll}">
                    <ScrollViewer.GestureRecognizers>
                        <PinchGestureRecognizer />
                    </ScrollViewer.GestureRecognizers>
                    <ItemsControl ItemsSource="{Binding Pages}"
                                  HorizontalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="28" HorizontalAlignment="Center" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:PdfViewerPageItem">
                                <StackPanel HorizontalAlignment="Center" Spacing="8">
                                    <!-- Crisp High-DPI Vector Rendered Page Canvas -->
                                    <Border Classes="reader-page-card"
                                            Classes.reading-theme-sepia="{Binding $parent[UserControl].((vm:PdfViewerViewModel)DataContext).IsThemeSepia}"
                                            Classes.reading-theme-dark="{Binding $parent[UserControl].((vm:PdfViewerViewModel)DataContext).IsThemeDark}"
                                            Classes.reading-theme-highcontrast="{Binding $parent[UserControl].((vm:PdfViewerViewModel)DataContext).IsThemeHighContrast}">
                                        <Border.Width>
                                            <MultiBinding Converter="{StaticResource MultiplyConverter}">
                                                <Binding Path="WidthPoints" />
                                                <Binding Path="$parent[UserControl].((vm:PdfViewerViewModel)DataContext).ZoomLevel" />
                                            </MultiBinding>
                                        </Border.Width>
                                        <Border.Height>
                                            <MultiBinding Converter="{StaticResource MultiplyConverter}">
                                                <Binding Path="HeightPoints" />
                                                <Binding Path="$parent[UserControl].((vm:PdfViewerViewModel)DataContext).ZoomLevel" />
                                            </MultiBinding>
                                        </Border.Height>

                                        <Panel>
                                            <!-- High Quality Anti-Aliased Interpolation Bitmap -->
                                            <Image Source="{Binding Bitmap}"
                                                   Stretch="UniformToFill"
                                                   RenderOptions.BitmapInterpolationMode="HighQuality"
                                                   RenderTransformOrigin="0.5,0.5">
                                                <Image.RenderTransform>
                                                    <RotateTransform Angle="{Binding RotationAngle}" />
                                                </Image.RenderTransform>
                                            </Image>

                                            <!-- Fallback when loading / empty -->
                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8"
                                                        IsVisible="{Binding Bitmap, Converter={StaticResource NullToBooleanConverter}, ConverterParameter=invert}">
                                                <materialIcons:MaterialIcon Kind="FileDocumentOutline" Width="36" Height="36" Foreground="#CBD5E1" />
                                                <TextBlock Text="{Binding PageLabel}" FontSize="12" Foreground="{DynamicResource WinMutedBrush}" HorizontalAlignment="Center" />
                                            </StackPanel>
                                        </Panel>
                                    </Border>

                                    <!-- Page Number Footnote Indicator -->
                                    <TextBlock Text="{Binding PageLabel}"
                                               FontSize="10.5"
                                               FontWeight="Medium"
                                               Foreground="{DynamicResource WinMutedBrush}"
                                               HorizontalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Layout 2: Single Page Fit Mode -->
                <ScrollViewer x:Name="SinglePageScrollViewer"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"
                              Padding="32"
                              IsVisible="{Binding IsSinglePageMode}">
                    <ScrollViewer.GestureRecognizers>
                        <PinchGestureRecognizer />
                    </ScrollViewer.GestureRecognizers>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10"
                                DataContext="{Binding SelectedPage}">
                        <Border Classes="reader-page-card"
                                Classes.reading-theme-sepia="{Binding $parent[UserControl].((vm:PdfViewerViewModel)DataContext).IsThemeSepia}"
                                Classes.reading-theme-dark="{Binding $parent[UserControl].((vm:PdfViewerViewModel)DataContext).IsThemeDark}"
                                Classes.reading-theme-highcontrast="{Binding $parent[UserControl].((vm:PdfViewerViewModel)DataContext).IsThemeHighContrast}">
                            <Border.Width>
                                <MultiBinding Converter="{StaticResource MultiplyConverter}">
                                    <Binding Path="WidthPoints" />
                                    <Binding Path="$parent[UserControl].((vm:PdfViewerViewModel)DataContext).ZoomLevel" />
                                </MultiBinding>
                            </Border.Width>
                            <Border.Height>
                                <MultiBinding Converter="{StaticResource MultiplyConverter}">
                                    <Binding Path="HeightPoints" />
                                    <Binding Path="$parent[UserControl].((vm:PdfViewerViewModel)DataContext).ZoomLevel" />
                                </MultiBinding>
                            </Border.Height>

                            <Panel>
                                <Image Source="{Binding Bitmap}"
                                       Stretch="UniformToFill"
                                       RenderOptions.BitmapInterpolationMode="HighQuality"
                                       RenderTransformOrigin="0.5,0.5">
                                    <Image.RenderTransform>
                                        <RotateTransform Angle="{Binding RotationAngle}" />
                                    </Image.RenderTransform>
                                </Image>

                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8"
                                            IsVisible="{Binding Bitmap, Converter={StaticResource NullToBooleanConverter}, ConverterParameter=invert}">
                                    <materialIcons:MaterialIcon Kind="FileDocumentOutline" Width="36" Height="36" Foreground="#CBD5E1" />
                                    <TextBlock Text="{Binding PageLabel}" FontSize="12" Foreground="{DynamicResource WinMutedBrush}" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Panel>
                        </Border>

                        <TextBlock Text="{Binding PageLabel}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource WinMutedBrush}"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </ScrollViewer>

                <!-- Layout 3: Two-Page Spread (Facing Pages / Book Mode) -->
                <ScrollViewer x:Name="TwoPageSpreadScrollViewer"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"
                              Padding="32"
                              IsVisible="{Binding IsTwoPageSpreadMode}">
                    <ScrollViewer.GestureRecognizers>
                        <PinchGestureRecognizer />
                    </ScrollViewer.GestureRecognizers>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12"
                                DataContext="{Binding SelectedSpread}">
                        <StackPanel Orientation="Horizontal" Spacing="16" HorizontalAlignment="Center">
                            <!-- Left Page -->
                            <Panel IsVisible="{Binding LeftPage, Converter={StaticResource NullToBooleanConverter}}">
                                <Border Classes="reader-page-card"
                                        Classes.reading-theme-sepia="{Binding $parent[UserControl].((vm:PdfViewerViewModel)DataContext).IsThemeSepia}"
                                        Classes.reading-theme-dark="{Binding $parent[UserControl].((vm:PdfViewerViewModel)DataContext).IsThemeDark}"
                                        Classes.reading-theme-highcontrast="{Binding $parent[UserControl].((vm:PdfViewerViewModel)DataContext).IsThemeHighContrast}">
                                    <Border.Width>
                                        <MultiBinding Converter="{StaticResource MultiplyConverter}">
                                            <Binding Path="LeftPage.WidthPoints" />
                                            <Binding Path="$parent[UserControl].((vm:PdfViewerViewModel)DataContext).ZoomLevel" />
                                        </MultiBinding>
                                    </Border.Width>
                                    <Border.Height>
                                        <MultiBinding Converter="{StaticResource MultiplyConverter}">
                                            <Binding Path="LeftPage.HeightPoints" />
                                            <Binding Path="$parent[UserControl].((vm:PdfViewerViewModel)DataContext).ZoomLevel" />
                                        </MultiBinding>
                                    </Border.Height>
                                    <Image Source="{Binding LeftPage.Bitmap}"
                                           Stretch="UniformToFill"
                                           RenderOptions.BitmapInterpolationMode="HighQuality" />
                                </Border>
                            </Panel>

                            <!-- Right Page -->
                            <Panel IsVisible="{Binding RightPage, Converter={StaticResource NullToBooleanConverter}}">
                                <Border Classes="reader-page-card"
                                        Classes.reading-theme-sepia="{Binding $parent[UserControl].((vm:PdfViewerViewModel)DataContext).IsThemeSepia}"
                                        Classes.reading-theme-dark="{Binding $parent[UserControl].((vm:PdfViewerViewModel)DataContext).IsThemeDark}"
                                        Classes.reading-theme-highcontrast="{Binding $parent[UserControl].((vm:PdfViewerViewModel)DataContext).IsThemeHighContrast}">
                                    <Border.Width>
                                        <MultiBinding Converter="{StaticResource MultiplyConverter}">
                                            <Binding Path="RightPage.WidthPoints" />
                                            <Binding Path="$parent[UserControl].((vm:PdfViewerViewModel)DataContext).ZoomLevel" />
                                        </MultiBinding>
                                    </Border.Width>
                                    <Border.Height>
                                        <MultiBinding Converter="{StaticResource MultiplyConverter}">
                                            <Binding Path="RightPage.HeightPoints" />
                                            <Binding Path="$parent[UserControl].((vm:PdfViewerViewModel)DataContext).ZoomLevel" />
                                        </MultiBinding>
                                    </Border.Height>
                                    <Image Source="{Binding RightPage.Bitmap}"
                                           Stretch="UniformToFill"
                                           RenderOptions.BitmapInterpolationMode="HighQuality" />
                                </Border>
                            </Panel>
                        </StackPanel>

                        <TextBlock Text="{Binding SpreadLabel}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource WinMutedBrush}"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </ScrollViewer>

                <!-- FLOATING IN-VIEWER SEARCH BAR OVERLAY -->
                <Border Background="{DynamicResource WinPanelBrush}"
                        BorderBrush="{DynamicResource WinBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        BoxShadow="0 6 20 #25000000"
                        Padding="8,6"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="0,14,20,0"
                        IsVisible="{Binding IsSearchBarVisible}">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <materialIcons:MaterialIcon Kind="Magnify" Width="15" Height="15" Foreground="{DynamicResource WinMutedBrush}" VerticalAlignment="Center" />

                        <TextBox x:Name="SearchQueryTextBox"
                                 Text="{Binding SearchQuery, Mode=TwoWay}"
                                 PlaceholderText="Find in PDF..."
                                 Width="180"
                                 Height="26"
                                 FontSize="11.5"
                                 Padding="6,2"
                                 CornerRadius="4"
                                 VerticalAlignment="Center">
                            <TextBox.KeyBindings>
                                <KeyBinding Gesture="Enter" Command="{Binding NextMatchCommand}" />
                            </TextBox.KeyBindings>
                        </TextBox>

                        <TextBlock Text="{Binding SearchStatusText}"
                                   FontSize="10"
                                   Foreground="{DynamicResource WinMutedBrush}"
                                   VerticalAlignment="Center"
                                   Margin="2,0" />

                        <Button Classes="toolbar-btn" Width="24" Height="24" Command="{Binding PreviousMatchCommand}" ToolTip.Tip="Previous Match (Shift+F3)">
                            <materialIcons:MaterialIcon Kind="ChevronUp" Width="15" Height="15" Foreground="{DynamicResource WinMutedBrush}" />
                        </Button>
                        <Button Classes="toolbar-btn" Width="24" Height="24" Command="{Binding NextMatchCommand}" ToolTip.Tip="Next Match (F3 / Enter)">
                            <materialIcons:MaterialIcon Kind="ChevronDown" Width="15" Height="15" Foreground="{DynamicResource WinMutedBrush}" />
                        </Button>
                        <Button Classes="toolbar-btn" Width="24" Height="24" Command="{Binding ToggleSearchBarCommand}" ToolTip.Tip="Close Search">
                            <materialIcons:MaterialIcon Kind="Close" Width="13" Height="13" Foreground="{DynamicResource WinMutedBrush}" />
                        </Button>
                    </StackPanel>
                </Border>

                <!-- ADD STICKY NOTE MODAL DIALOG -->
                <Border Background="#80000000"
                        IsVisible="{Binding IsAddNoteOpen}"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch">
                    <Border Width="360"
                            Background="{DynamicResource WinPanelBrush}"
                            CornerRadius="10"
                            BoxShadow="0 8 24 #30000000"
                            Padding="18"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                        <StackPanel Spacing="12">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                    <materialIcons:MaterialIcon Kind="NoteTextOutline" Width="18" Height="18" Foreground="#0284C7" VerticalAlignment="Center" />
                                    <TextBlock Text="Add Sticky Note Annotation" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource WinTextBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                                <Button Grid.Column="1" Classes="toolbar-btn" Width="24" Height="24" Command="{Binding $parent[UserControl].((vm:PdfViewerViewModel)DataContext).OpenAddNoteDialogCommand}">
                                    <materialIcons:MaterialIcon Kind="Close" Width="14" Height="14" />
                                </Button>
                            </Grid>

                            <TextBox Text="{Binding NewNoteText, Mode=TwoWay}"
                                     PlaceholderText="Type your annotation, review comment, or bookmark note here..."
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     Height="85"
                                     FontSize="11.5"
                                     CornerRadius="6" />

                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                <Button Content="Cancel" Padding="12,5" FontSize="11.5" Command="{Binding $parent[UserControl].((vm:PdfViewerViewModel)DataContext).OpenAddNoteDialogCommand}" />
                                <Button Content="Add Note" Background="#0F6CBD" Foreground="White" Padding="14,5" FontSize="11.5" FontWeight="SemiBold" Command="{Binding ConfirmAddNoteCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Border>

                <!-- Presentation Fullscreen Floating Exit Button -->
                <Button Classes="toolbar-btn"
                        IsVisible="{Binding IsFullscreen}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="0,14,14,0"
                        Command="{Binding ToggleFullscreenCommand}"
                        Background="#B0000000"
                        CornerRadius="16"
                        Padding="10,5"
                        Width="NaN" Height="NaN"
                        ToolTip.Tip="Exit Fullscreen (Esc)">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <materialIcons:MaterialIcon Kind="FullscreenExit" Width="15" Height="15" Foreground="White" />
                        <TextBlock Text="Exit Fullscreen" FontSize="11" Foreground="White" />
                    </StackPanel>
                </Button>

            </Grid>

        </Grid>

        <!-- ========================================== -->
        <!-- 3. BOTTOM STATUS & SHORTCUTS FOOTER BAR    -->
        <!-- ========================================== -->
        <Border Grid.Row="2"
                Background="{DynamicResource WinPanelBrush}"
                Height="26"
                BorderBrush="{DynamicResource WinBorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="10,0"
                IsVisible="{Binding !IsFullscreen}">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                    <Ellipse Width="6" Height="6" Fill="#10B981" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding StatusMessage}" FontSize="10" Foreground="{DynamicResource WinMutedBrush}" FontWeight="Medium" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <TextBlock Text="{Binding PageNavigationDisplay}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource WinTextBrush}" VerticalAlignment="Center" />
                    <Rectangle Width="1" Height="10" Fill="{DynamicResource WinBorderBrush}" />
                    <TextBlock Text="{Binding ZoomPercentageText}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource WinTextBrush}" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

    </Grid>

</UserControl>
