<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PdfEditorApp.ViewModels"
             xmlns:models="using:PdfEditorApp.Models"
             xmlns:elvm="using:PdfEditorApp.ViewModels.ElementViewModels"
             xmlns:converters="using:PdfEditorApp.Converters"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="PdfEditorApp.Views.HomeDashboardView"
             x:DataType="vm:HomeViewModel">

    <UserControl.Resources>
        <converters:HexToBrushConverter x:Key="HexToBrushConverter" />
        <converters:TextAlignmentConverter x:Key="TextAlignmentConverter" />
        <converters:EqualityToBooleanConverter x:Key="EqualityConverter" />
        <converters:NullToBooleanConverter x:Key="NullToBooleanConverter" />
        <converters:DoubleToThicknessConverter x:Key="DoubleToThickness" />
        <converters:DoubleToCornerRadiusConverter x:Key="DoubleToCornerRadius" />
    </UserControl.Resources>

    <UserControl.Styles>
        <!-- PDF Tool Card Lift & Glow Animation (M3 Expressive Elevated Card) -->
        <Style Selector="Border.pdf-tool-box">
            <Setter Property="Background" Value="{DynamicResource WinPanelBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource WinBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource M3ShapeCornerLarge}" />
            <Setter Property="BoxShadow" Value="{StaticResource M3ElevationLevel1}" />
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2" Easing="CubicEaseOut" />
                    <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.2" Easing="CubicEaseOut" />
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
                    <BrushTransition Property="Background" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.pdf-tool-btn:pointerover Border.pdf-tool-box">
            <Setter Property="RenderTransform" Value="translateY(-3px)" />
            <Setter Property="BoxShadow" Value="{StaticResource M3ElevationLevel2}" />
            <Setter Property="BorderBrush" Value="{DynamicResource WinAccentBrush}" />
        </Style>

        <!-- Template / Recent Card Lift Animation (M3 Expressive Elevated Card) -->
        <Style Selector="Border.template-card-box">
            <Setter Property="Background" Value="{DynamicResource WinPanelBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource WinBorderBrush}" />
            <Setter Property="CornerRadius" Value="{StaticResource M3ShapeCornerLarge}" />
            <Setter Property="BoxShadow" Value="{StaticResource M3ElevationLevel1}" />
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.25" Easing="CubicEaseOut" />
                    <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.25" Easing="CubicEaseOut" />
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.2" />
                    <BrushTransition Property="Background" Duration="0:0:0.2" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.template-card-box:pointerover">
            <Setter Property="RenderTransform" Value="translateY(-4px)" />
            <Setter Property="BoxShadow" Value="{StaticResource M3ElevationLevel3}" />
            <Setter Property="BorderBrush" Value="{DynamicResource WinAccentBrush}" />
        </Style>
        <Style Selector="Button.template-card-btn:pointerover Border.template-card-box">
            <Setter Property="RenderTransform" Value="translateY(-4px)" />
            <Setter Property="BoxShadow" Value="{StaticResource M3ElevationLevel3}" />
            <Setter Property="BorderBrush" Value="{DynamicResource WinAccentBrush}" />
        </Style>
    </UserControl.Styles>

    <StackPanel Margin="32,24,32,32">

        <!-- ========================================== -->
        <!-- 1. WELCOME & QUICK ACTION HERO CARD        -->
        <!-- ========================================== -->
        <Border Background="{DynamicResource WinPanelBrush}"
                BorderBrush="{DynamicResource WinBorderBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource M3ShapeCornerExtraLarge}"
                Padding="28,24"
                Margin="0,0,0,24"
                BoxShadow="{StaticResource M3ElevationLevel1}">
            <Grid RowDefinitions="Auto,Auto">
                <!-- Top Welcome Row -->
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,20">
                    <StackPanel Grid.Column="0" Spacing="4">
                        <TextBlock Text="Welcome to FryPDF" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource WinTextBrush}" />
                        <TextBlock Text="Everything you need to create, edit, convert, and protect professional documents." FontSize="13" Foreground="{DynamicResource WinMutedBrush}" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            Command="{Binding SelectNavSectionCommand}"
                            CommandParameter="AllTools"
                            Background="{DynamicResource M3SecondaryContainerBrush}"
                            Foreground="{DynamicResource M3OnSecondaryContainerBrush}"
                            BorderThickness="0"
                            CornerRadius="{StaticResource M3ShapeCornerFull}"
                            Padding="16,8"
                            FontSize="12.5"
                            FontWeight="SemiBold"
                            Cursor="Hand">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock Text="Explore 32 Tools" VerticalAlignment="Center" />
                            <materialIcons:MaterialIcon Kind="ArrowRight" Width="14" Height="14" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- 5 Primary Quick Action Cards Row -->
                <UniformGrid Grid.Row="1" Columns="5">
                    <!-- Card 1: Start New Document -->
                    <Button Command="{Binding SelectNavSectionCommand}"
                            CommandParameter="NewDocument"
                            Background="{DynamicResource WinPanelBrush}"
                            BorderBrush="{DynamicResource WinBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="14,14"
                            Margin="0,0,8,0"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            Cursor="Hand">
                        <Grid ColumnDefinitions="Auto,*">
                            <Border Grid.Column="0" Width="36" Height="36" Background="#16A34A" CornerRadius="10" Margin="0,0,10,0" VerticalAlignment="Center">
                                <materialIcons:MaterialIcon Kind="FileDocumentPlusOutline" Width="18" Height="18" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="New Document" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource WinTextBrush}" />
                                <TextBlock Text="Blank or 19 templates" FontSize="10.5" Foreground="{DynamicResource WinMutedBrush}" />
                            </StackPanel>
                        </Grid>
                    </Button>

                    <!-- Card 2: Open in Editor -->
                    <Button Command="{Binding OpenFileCommand}"
                            Background="{DynamicResource WinPanelBrush}"
                            BorderBrush="{DynamicResource WinBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="14,14"
                            Margin="0,0,8,0"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            Cursor="Hand">
                        <Grid ColumnDefinitions="Auto,*">
                            <Border Grid.Column="0" Width="36" Height="36" Background="#0284C7" CornerRadius="10" Margin="0,0,10,0" VerticalAlignment="Center">
                                <materialIcons:MaterialIcon Kind="DrawPen" Width="18" Height="18" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="Edit PDF" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource WinTextBrush}" />
                                <TextBlock Text="Open &amp; edit any PDF" FontSize="10.5" Foreground="{DynamicResource WinMutedBrush}" />
                            </StackPanel>
                        </Grid>
                    </Button>

                    <!-- Card 3: Open in PDF Reader -->
                    <Button Command="{Binding OpenInViewerCommand}"
                            Background="{DynamicResource WinPanelBrush}"
                            BorderBrush="{DynamicResource WinBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="14,14"
                            Margin="0,0,8,0"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            Cursor="Hand"
                            ToolTip.Tip="Open any PDF directly in pure Adobe Acrobat-style Reader mode">
                        <Grid ColumnDefinitions="Auto,*">
                            <Border Grid.Column="0" Width="36" Height="36" Background="#DC2626" CornerRadius="10" Margin="0,0,10,0" VerticalAlignment="Center">
                                <materialIcons:MaterialIcon Kind="BookOpenPageVariantOutline" Width="18" Height="18" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="PDF Reader" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource WinTextBrush}" />
                                <TextBlock Text="Acrobat reading &amp; search" FontSize="10.5" Foreground="{DynamicResource WinMutedBrush}" />
                            </StackPanel>
                        </Grid>
                    </Button>

                    <!-- Card 4: All 32 Tools -->
                    <Button Command="{Binding SelectNavSectionCommand}"
                            CommandParameter="AllTools"
                            Background="{DynamicResource WinPanelBrush}"
                            BorderBrush="{DynamicResource WinBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="14,14"
                            Margin="0,0,8,0"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            Cursor="Hand">
                        <Grid ColumnDefinitions="Auto,*">
                            <Border Grid.Column="0" Width="36" Height="36" Background="#4F46E5" CornerRadius="10" Margin="0,0,10,0" VerticalAlignment="Center">
                                <materialIcons:MaterialIcon Kind="ViewGridOutline" Width="18" Height="18" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="All 32 Tools" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource WinTextBrush}" />
                                <TextBlock Text="Convert, OCR, Security" FontSize="10.5" Foreground="{DynamicResource WinMutedBrush}" />
                            </StackPanel>
                        </Grid>
                    </Button>

                    <!-- Card 5: Automate Workflows -->
                    <Button Command="{Binding OpenWorkflowBuilderCommand}"
                            Background="{DynamicResource WinPanelBrush}"
                            BorderBrush="{DynamicResource WinBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="14,14"
                            Margin="0,0,0,0"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            Cursor="Hand">
                        <Grid ColumnDefinitions="Auto,*">
                            <Border Grid.Column="0" Width="36" Height="36" Background="#EA580C" CornerRadius="10" Margin="0,0,10,0" VerticalAlignment="Center">
                                <materialIcons:MaterialIcon Kind="LightningBoltOutline" Width="18" Height="18" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="Chain Workflows" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource WinTextBrush}" />
                                <TextBlock Text="Multi-step batch recipes" FontSize="10.5" Foreground="{DynamicResource WinMutedBrush}" />
                            </StackPanel>
                        </Grid>
                    </Button>
                </UniformGrid>
            </Grid>
        </Border>

        <!-- ============================================================== -->
        <!-- INTERACTIVE PRESENTATION SHOWCASE HERO BANNER (.frypdf)         -->
        <!-- ============================================================== -->
        <Border Background="{DynamicResource WinPanelBrush}"
                BorderBrush="{DynamicResource WinBorderBrush}"
                BorderThickness="1"
                CornerRadius="14"
                Padding="18,14"
                Margin="0,0,0,20"
                BoxShadow="0 4 16 #08000000">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Border Grid.Column="0" Width="44" Height="44" Background="#EEF2FF" CornerRadius="12" Margin="0,0,16,0" VerticalAlignment="Center">
                    <materialIcons:MaterialIcon Kind="PresentationPlay" Width="24" Height="24" Foreground="#4F46E5" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="Featured: Executive Strategy &amp; Telemetry Deck (.frypdf)" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource WinTextBrush}" VerticalAlignment="Center" />
                        <Border Background="#EEF2FF" CornerRadius="9999" Padding="8,2" VerticalAlignment="Center">
                            <TextBlock Text="16:10 LANDSCAPE • LIVE DATA" FontSize="9.5" FontWeight="Bold" Foreground="#4F46E5" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Experience living tables with in-table search &amp; CSV export, animated 600ms charts with hover tooltips, and interactive compliance checklists."
                               FontSize="11.5" Foreground="{DynamicResource WinMutedBrush}" />
                </StackPanel>
                <Button Grid.Column="2"
                        Command="{Binding LaunchInteractiveDeckCommand}"
                        Classes="primary-btn"
                        Height="36"
                        Padding="16,0"
                        CornerRadius="{StaticResource M3ShapeCornerFull}"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <materialIcons:MaterialIcon Kind="PlayCircleOutline" Width="16" Height="16" Foreground="White" />
                        <TextBlock Text="Explore Interactive Deck" FontWeight="SemiBold" FontSize="12" Foreground="White" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- ========================================== -->
        <!-- 2. POPULAR QUICK TOOLS ROW (6 TOP TOOLS)   -->
        <!-- ========================================== -->
        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,12" VerticalAlignment="Center">
            <TextBlock Grid.Column="0" Text="Popular PDF Tools" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource WinTextBrush}" />
            <Button Grid.Column="1"
                    Command="{Binding SelectNavSectionCommand}"
                    CommandParameter="AllTools"
                    Background="Transparent"
                    BorderThickness="0"
                    Foreground="{DynamicResource WinAccentBrush}"
                    FontSize="12"
                    FontWeight="SemiBold"
                    Cursor="Hand">
                View all 32 tools →
            </Button>
        </Grid>

        <ItemsControl ItemsSource="{Binding QuickTools}" Margin="0,0,0,24">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="3" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="vm:PdfToolCardViewModel">
                    <Button Classes="pdf-tool-btn"
                            Command="{Binding SelectToolCommand}"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="0"
                            Margin="0,0,12,12"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            Cursor="Hand">
                        <Border Classes="pdf-tool-box" Padding="14,12" MinHeight="72">
                            <Grid ColumnDefinitions="Auto,*">
                                <Border Grid.Column="0"
                                        Width="36" Height="36"
                                        Background="{Binding BackgroundAccentHex, Converter={StaticResource HexToBrushConverter}}"
                                        CornerRadius="8"
                                        Margin="0,0,12,0"
                                        VerticalAlignment="Top">
                                    <materialIcons:MaterialIcon Kind="{Binding IconKind}"
                                                                Width="20" Height="20"
                                                                Foreground="{Binding IconColorHex, Converter={StaticResource HexToBrushConverter}}"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource WinTextBrush}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{DynamicResource WinMutedBrush}" MaxLines="1" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- ========================================== -->
        <!-- 3. RECENT DOCUMENTS SECTION                -->
        <!-- ========================================== -->
        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,14" VerticalAlignment="Center">
            <StackPanel Grid.Column="0" Spacing="2">
                <TextBlock Text="Recent Documents" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource WinTextBrush}" />
                <TextBlock Text="Quickly resume working on your recent projects and PDFs" FontSize="12" Foreground="{DynamicResource WinMutedBrush}" />
            </StackPanel>
            <Button Grid.Column="1"
                    IsVisible="{Binding HasRecentDocuments}"
                    Command="{Binding ClearRecentCommand}"
                    Background="Transparent"
                    BorderThickness="0"
                    Foreground="{DynamicResource WinMutedBrush}"
                    FontSize="12"
                    Cursor="Hand"
                    Padding="8,4"
                    ToolTip.Tip="Clear all recent documents">
                Clear all
            </Button>
        </Grid>

        <!-- Empty State for Recent Documents -->
        <Border IsVisible="{Binding !HasRecentDocuments}"
                Background="{DynamicResource WinPanelBrush}"
                BorderBrush="{DynamicResource WinBorderBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="40,36">
            <StackPanel HorizontalAlignment="Center" Spacing="10">
                <materialIcons:MaterialIcon Kind="FileDocumentOutline" Width="44" Height="44" Foreground="{DynamicResource WinSubtleBrush}" HorizontalAlignment="Center" />
                <TextBlock Text="No recent documents" FontSize="14" FontWeight="Medium" Foreground="{DynamicResource WinMutedBrush}" HorizontalAlignment="Center" />
                <TextBlock Text="Documents you open or create will appear here for instant access." FontSize="12" Foreground="{DynamicResource WinSubtleBrush}" HorizontalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- Recent Documents Grid -->
        <ItemsControl IsVisible="{Binding HasRecentDocuments}"
                      ItemsSource="{Binding RecentDocuments}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="models:RecentDocumentItem">
                    <Border Classes="template-card-box"
                            Width="204"
                            Background="{DynamicResource WinPanelBrush}"
                            BorderBrush="{DynamicResource WinBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="0"
                            Margin="0,0,16,16"
                            ClipToBounds="True"
                            BoxShadow="0 2 6 #0A000000">
                        <!-- Right-Click Context Menu -->
                        <Border.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Open in Studio Editor"
                                          Command="{Binding $parent[UserControl].((vm:HomeViewModel)DataContext).OpenRecentCommand}"
                                          CommandParameter="{Binding FilePath}">
                                    <MenuItem.Icon>
                                        <materialIcons:MaterialIcon Kind="FileEditOutline" Width="16" Height="16" Foreground="{DynamicResource WinAccentBrush}" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Read in PDF Reader"
                                          Command="{Binding $parent[UserControl].((vm:HomeViewModel)DataContext).OpenInViewerCommand}"
                                          CommandParameter="{Binding FilePath}">
                                    <MenuItem.Icon>
                                        <materialIcons:MaterialIcon Kind="BookOpenPageVariantOutline" Width="16" Height="16" Foreground="#DC2626" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Interactive Presentation (.frypdf)"
                                          Command="{Binding $parent[UserControl].((vm:HomeViewModel)DataContext).OpenInInteractiveViewerCommand}"
                                          CommandParameter="{Binding FilePath}">
                                    <MenuItem.Icon>
                                        <materialIcons:MaterialIcon Kind="PresentationPlay" Width="16" Height="16" Foreground="#8B5CF6" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <Separator />
                                <MenuItem Header="Rename Document..."
                                          InputGesture="F2"
                                          Command="{Binding $parent[UserControl].((vm:HomeViewModel)DataContext).PromptRenameCommand}"
                                          CommandParameter="{Binding FilePath}">
                                    <MenuItem.Icon>
                                        <materialIcons:MaterialIcon Kind="PencilOutline" Width="16" Height="16" Foreground="{DynamicResource WinTextBrush}" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Duplicate / Make a Copy"
                                          Command="{Binding $parent[UserControl].((vm:HomeViewModel)DataContext).DuplicateDocumentCommand}"
                                          CommandParameter="{Binding FilePath}">
                                    <MenuItem.Icon>
                                        <materialIcons:MaterialIcon Kind="ContentCopy" Width="16" Height="16" Foreground="{DynamicResource WinTextBrush}" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Reveal in Finder / Explorer"
                                          Command="{Binding $parent[UserControl].((vm:HomeViewModel)DataContext).RevealInFileManagerCommand}"
                                          CommandParameter="{Binding FilePath}">
                                    <MenuItem.Icon>
                                        <materialIcons:MaterialIcon Kind="FolderOpenOutline" Width="16" Height="16" Foreground="{DynamicResource WinTextBrush}" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Copy File Path"
                                          Command="{Binding $parent[UserControl].((vm:HomeViewModel)DataContext).CopyPathCommand}"
                                          CommandParameter="{Binding FilePath}">
                                    <MenuItem.Icon>
                                        <materialIcons:MaterialIcon Kind="ClipboardTextOutline" Width="16" Height="16" Foreground="{DynamicResource WinTextBrush}" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <Separator />
                                <MenuItem Header="Remove from Recents"
                                          Command="{Binding $parent[UserControl].((vm:HomeViewModel)DataContext).RemoveRecentCommand}"
                                          CommandParameter="{Binding FilePath}">
                                    <MenuItem.Icon>
                                        <materialIcons:MaterialIcon Kind="BookmarkRemoveOutline" Width="16" Height="16" Foreground="{DynamicResource WinMutedBrush}" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Delete File..."
                                          Command="{Binding $parent[UserControl].((vm:HomeViewModel)DataContext).PromptDeleteCommand}"
                                          CommandParameter="{Binding FilePath}"
                                          Foreground="#DC2626">
                                    <MenuItem.Icon>
                                        <materialIcons:MaterialIcon Kind="TrashCanOutline" Width="16" Height="16" Foreground="#DC2626" />
                                    </MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>
                        </Border.ContextMenu>

                        <Grid RowDefinitions="Auto,Auto">
                            <!-- Live Thumbnail Preview Area (Click to open) -->
                            <Button Grid.Row="0"
                                    Command="{Binding $parent[UserControl].((vm:HomeViewModel)DataContext).OpenRecentCommand}"
                                    CommandParameter="{Binding FilePath}"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="0"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    Cursor="Hand">
                                <Border Height="124"
                                        Background="{DynamicResource WinInputBgBrush}"
                                        BorderBrush="{DynamicResource WinBorderBrush}"
                                        BorderThickness="0,0,0,1"
                                        ClipToBounds="True">
                                    <Panel>
                                        <!-- Live Preview (if PagePreview is loaded) -->
                                        <Viewbox Width="192" Height="118" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding HasLivePreview}">
                                            <Border Width="{Binding PagePreview.Width, FallbackValue=800}"
                                                    Height="{Binding PagePreview.Height, FallbackValue=1131}"
                                                    Background="{Binding PagePreview.BackgroundColorHex, Converter={StaticResource HexToBrushConverter}, FallbackValue='White'}"
                                                    ClipToBounds="True">
                                                <ItemsControl ItemsSource="{Binding PagePreview.Elements}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <Canvas Width="{Binding PagePreview.Width, FallbackValue=800}" Height="{Binding PagePreview.Height, FallbackValue=1131}" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemContainerTheme>
                                                        <ControlTheme TargetType="ContentPresenter" x:DataType="elvm:ElementViewModelBase">
                                                            <Setter Property="Canvas.Left" Value="{Binding X}" />
                                                            <Setter Property="Canvas.Top" Value="{Binding Y}" />
                                                            <Setter Property="Canvas.ZIndex" Value="{Binding ZIndex}" />
                                                            <Setter Property="Opacity" Value="{Binding Opacity}" />
                                                            <Setter Property="RenderTransformOrigin" Value="50%,50%" />
                                                            <Setter Property="RenderTransform" Value="{Binding Rotation, Converter={StaticResource RotationToTransformConverter}}" />
                                                        </ControlTheme>
                                                    </ItemsControl.ItemContainerTheme>
                                                    <ItemsControl.DataTemplates>
                                                        <DataTemplate DataType="elvm:TextElementViewModel">
                                                            <Border Width="{Binding Width}" Height="{Binding Height}"
                                                                    Background="{Binding BackgroundColorHex, Converter={StaticResource HexToBrushConverter}}"
                                                                    BorderBrush="{Binding BorderColorHex, Converter={StaticResource HexToBrushConverter}}"
                                                                    BorderThickness="{Binding BorderThickness, Converter={StaticResource DoubleToThickness}}"
                                                                    CornerRadius="{Binding CornerRadius, Converter={StaticResource DoubleToCornerRadius}}"
                                                                    Padding="{Binding Padding, Converter={StaticResource DoubleToThickness}}">
                                                                <TextBlock Text="{Binding Text}"
                                                                            FontFamily="{Binding AvaloniaFontFamily}"
                                                                            FontSize="{Binding FontSize}"
                                                                            FontWeight="{Binding IsBold, Converter={x:Static converters:BooleanToFontWeightConverter.Instance}}"
                                                                            FontStyle="{Binding IsItalic, Converter={x:Static converters:BooleanToFontStyleConverter.Instance}}"
                                                                            Foreground="{Binding TextColorHex, Converter={StaticResource HexToBrushConverter}}"
                                                                            TextAlignment="{Binding Alignment, Converter={StaticResource TextAlignmentConverter}}"
                                                                            TextWrapping="Wrap" />
                                                            </Border>
                                                        </DataTemplate>
                                                        <DataTemplate DataType="elvm:ShapeElementViewModel">
                                                            <Path Data="{Binding PathData}"
                                                                  Fill="{Binding FillColorHex, Converter={StaticResource HexToBrushConverter}}"
                                                                  Stroke="{Binding StrokeColorHex, Converter={StaticResource HexToBrushConverter}}"
                                                                  StrokeThickness="{Binding StrokeThickness}"
                                                                  Stretch="Fill" />
                                                        </DataTemplate>
                                                        <DataTemplate DataType="elvm:DividerElementViewModel">
                                                            <Rectangle Height="{Binding Thickness}" Fill="{Binding ColorHex, Converter={StaticResource HexToBrushConverter}}" />
                                                        </DataTemplate>
                                                    </ItemsControl.DataTemplates>
                                                </ItemsControl>
                                            </Border>
                                        </Viewbox>

                                        <!-- Realistic Document Sheet (when no live PagePreview yet) -->
                                        <Grid IsVisible="{Binding !HasLivePreview}" Background="{DynamicResource WinInputBgBrush}" Margin="8">
                                            <Border Background="{DynamicResource WinPanelBrush}"
                                                    BorderBrush="{DynamicResource WinBorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="4"
                                                    BoxShadow="0 2 6 #08000000"
                                                    Padding="12,10">
                                                <Grid RowDefinitions="Auto,*,Auto">
                                                    <!-- Top File Header Bar -->
                                                    <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,8">
                                                        <materialIcons:MaterialIcon Grid.Column="0" Kind="FileDocumentOutline" Width="18" Height="18" Foreground="#0F6CBD" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="1" Text="PDF" FontSize="9" FontWeight="Bold" Foreground="#0F6CBD" Margin="4,0,0,0" VerticalAlignment="Center" />
                                                        <Border Grid.Column="2" Background="{DynamicResource WinAccentLightBrush}" CornerRadius="3" Padding="4,1">
                                                            <TextBlock Text="Project" FontSize="8.5" FontWeight="SemiBold" Foreground="{DynamicResource WinAccentBrush}" />
                                                        </Border>
                                                    </Grid>
                                                    <!-- Realistic Document Content Representation -->
                                                    <StackPanel Grid.Row="1" Spacing="4" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Title}"
                                                                    FontSize="11"
                                                                    FontWeight="Bold"
                                                                    Foreground="{DynamicResource WinTextBrush}"
                                                                    TextTrimming="CharacterEllipsis"
                                                                    MaxLines="2" />
                                                        <TextBlock Text="{Binding FormatDescription}"
                                                                    FontSize="9.5"
                                                                    Foreground="{DynamicResource WinMutedBrush}" />
                                                    </StackPanel>
                                                    <!-- Bottom Date Stamp -->
                                                    <TextBlock Grid.Row="2"
                                                                Text="{Binding RelativeTime, StringFormat='Opened {0}'}"
                                                                FontSize="8.5"
                                                                Foreground="{DynamicResource WinSubtleBrush}"
                                                                Margin="0,4,0,0" />
                                                </Grid>
                                            </Border>
                                        </Grid>
                                    </Panel>
                                </Border>
                            </Button>

                            <!-- Document Options Button (...) in top-right of preview -->
                            <Button Grid.Row="0"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Margin="0,6,6,0"
                                    Width="26" Height="26"
                                    Padding="0"
                                    CornerRadius="6"
                                    Background="{DynamicResource WinPanelBrush}"
                                    BorderBrush="{DynamicResource WinBorderBrush}"
                                    BorderThickness="1"
                                    Cursor="Hand"
                                    ToolTip.Tip="Document options">
                                <materialIcons:MaterialIcon Kind="DotsVertical" Width="15" Height="15" Foreground="{DynamicResource WinTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Button.Flyout>
                                    <MenuFlyout Placement="BottomEdgeAlignedRight">
                                        <MenuItem Header="Open in Studio Editor"
                                                  Command="{Binding $parent[UserControl].((vm:HomeViewModel)DataContext).OpenRecentCommand}"
                                                  CommandParameter="{Binding FilePath}">
                                            <MenuItem.Icon>
                                                <materialIcons:MaterialIcon Kind="FileEditOutline" Width="16" Height="16" Foreground="{DynamicResource WinAccentBrush}" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Read in PDF Reader"
                                                  Command="{Binding $parent[UserControl].((vm:HomeViewModel)DataContext).OpenInViewerCommand}"
                                                  CommandParameter="{Binding FilePath}">
                                            <MenuItem.Icon>
                                                <materialIcons:MaterialIcon Kind="BookOpenPageVariantOutline" Width="16" Height="16" Foreground="#DC2626" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <Separator />
                                        <MenuItem Header="Rename Document..."
                                                  InputGesture="F2"
                                                  Command="{Binding $parent[UserControl].((vm:HomeViewModel)DataContext).PromptRenameCommand}"
                                                  CommandParameter="{Binding FilePath}">
                                            <MenuItem.Icon>
                                                <materialIcons:MaterialIcon Kind="PencilOutline" Width="16" Height="16" Foreground="{DynamicResource WinTextBrush}" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Duplicate / Make a Copy"
                                                  Command="{Binding $parent[UserControl].((vm:HomeViewModel)DataContext).DuplicateDocumentCommand}"
                                                  CommandParameter="{Binding FilePath}">
                                            <MenuItem.Icon>
                                                <materialIcons:MaterialIcon Kind="ContentCopy" Width="16" Height="16" Foreground="{DynamicResource WinTextBrush}" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Reveal in Finder / Explorer"
                                                  Command="{Binding $parent[UserControl].((vm:HomeViewModel)DataContext).RevealInFileManagerCommand}"
                                                  CommandParameter="{Binding FilePath}">
                                            <MenuItem.Icon>
                                                <materialIcons:MaterialIcon Kind="FolderOpenOutline" Width="16" Height="16" Foreground="{DynamicResource WinTextBrush}" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Copy File Path"
                                                  Command="{Binding $parent[UserControl].((vm:HomeViewModel)DataContext).CopyPathCommand}"
                                                  CommandParameter="{Binding FilePath}">
                                            <MenuItem.Icon>
                                                <materialIcons:MaterialIcon Kind="ClipboardTextOutline" Width="16" Height="16" Foreground="{DynamicResource WinTextBrush}" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <Separator />
                                        <MenuItem Header="Remove from Recents"
                                                  Command="{Binding $parent[UserControl].((vm:HomeViewModel)DataContext).RemoveRecentCommand}"
                                                  CommandParameter="{Binding FilePath}">
                                            <MenuItem.Icon>
                                                <materialIcons:MaterialIcon Kind="BookmarkRemoveOutline" Width="16" Height="16" Foreground="{DynamicResource WinMutedBrush}" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Delete File..."
                                                  Command="{Binding $parent[UserControl].((vm:HomeViewModel)DataContext).PromptDeleteCommand}"
                                                  CommandParameter="{Binding FilePath}"
                                                  Foreground="#DC2626">
                                            <MenuItem.Icon>
                                                <materialIcons:MaterialIcon Kind="TrashCanOutline" Width="16" Height="16" Foreground="#DC2626" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>

                            <!-- File Info Footer (Click to open) -->
                            <Button Grid.Row="1"
                                    Command="{Binding $parent[UserControl].((vm:HomeViewModel)DataContext).OpenRecentCommand}"
                                    CommandParameter="{Binding FilePath}"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="12,10,12,12"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Left"
                                    Cursor="Hand">
                                <StackPanel Spacing="3">
                                    <TextBlock Text="{Binding Title}"
                                               FontSize="12.5"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource WinTextBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding RelativeTime}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource WinSubtleBrush}" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding FormatDescription}"
                                                   FontSize="10"
                                                   Foreground="{DynamicResource WinSubtleBrush}" />
                                    </Grid>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- ========================================== -->
        <!-- 4. WORLDWIDE LANGUAGE PACKS FOOTER BANNER  -->
        <!-- ========================================== -->
        <Border Background="{DynamicResource WinPanelBrush}"
                BorderBrush="{DynamicResource WinBorderBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="20,16"
                Margin="0,24,0,0">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                <Border Grid.Column="0" Width="44" Height="44" Background="{DynamicResource WinAccentLightBrush}" CornerRadius="10" VerticalAlignment="Center">
                    <materialIcons:MaterialIcon Kind="Translate" Width="24" Height="24" Foreground="{DynamicResource WinAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="Worldwide Language &amp; Font Packs" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource WinTextBrush}" />
                        <Border Background="#DCFCE7" BorderBrush="#86EFAC" BorderThickness="1" CornerRadius="4" Padding="5,1" VerticalAlignment="Center">
                            <TextBlock Text="On-Demand" FontSize="9.5" FontWeight="Bold" Foreground="#16A34A" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Download Chinese, Japanese, Korean, Indic, Arabic, Hebrew, Thai, and Eurasian font packages for crisp rendering while keeping the app ultra-lightweight."
                               FontSize="11.5" Foreground="{DynamicResource WinMutedBrush}" TextWrapping="Wrap" />
                </StackPanel>
                <Button Grid.Column="2"
                        Command="{Binding SelectNavSectionCommand}"
                        CommandParameter="FontPackages"
                        Background="{DynamicResource WinAccentLightBrush}"
                        Foreground="{DynamicResource WinAccentBrush}"
                        BorderThickness="0"
                        CornerRadius="8"
                        Padding="14,8"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Cursor="Hand"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="Manage Language Packs" VerticalAlignment="Center" />
                        <materialIcons:MaterialIcon Kind="ArrowRight" Width="14" Height="14" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- On-Demand Tesseract OCR Models Banner -->
        <Border Background="{DynamicResource WinPanelBrush}"
                BorderBrush="{DynamicResource WinBorderBrush}"
                BorderThickness="1"
                CornerRadius="14"
                Padding="20,16"
                Margin="0,12,0,0">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                <Border Grid.Column="0" Width="44" Height="44" Background="#DCFCE7" CornerRadius="10" VerticalAlignment="Center">
                    <materialIcons:MaterialIcon Kind="TextRecognition" Width="24" Height="24" Foreground="#10B981" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="On-Demand Tesseract OCR Models" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource WinTextBrush}" />
                        <Border Background="#DCFCE7" BorderBrush="#86EFAC" BorderThickness="1" CornerRadius="4" Padding="5,1" VerticalAlignment="Center">
                            <TextBlock Text="Offline Neural Models" FontSize="9.5" FontWeight="Bold" Foreground="#16A34A" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Download fast trained models (.traineddata) for English, CJK, Indic, Arabic, and 35+ languages for high-accuracy document scanning and searchable PDFs."
                               FontSize="11.5" Foreground="{DynamicResource WinMutedBrush}" TextWrapping="Wrap" />
                </StackPanel>
                <Button Grid.Column="2"
                        Command="{Binding SelectNavSectionCommand}"
                        CommandParameter="TesseractData"
                        Background="#DCFCE7"
                        Foreground="#15803D"
                        BorderThickness="0"
                        CornerRadius="8"
                        Padding="14,8"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Cursor="Hand"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="Manage OCR Models" VerticalAlignment="Center" />
                        <materialIcons:MaterialIcon Kind="ArrowRight" Width="14" Height="14" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

    </StackPanel>
</UserControl>
