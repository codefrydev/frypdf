<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PdfEditorApp.ViewModels"
             xmlns:models="using:PdfEditorApp.Models"
             xmlns:converters="using:PdfEditorApp.Converters"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:models1="clr-namespace:PdfEditorApp.Core.Models;assembly=PdfEditorApp.Core"
             x:Class="PdfEditorApp.Views.Dialogs.SplitExtractDialog"
             x:DataType="vm:MainViewModel">

    <UserControl.Resources>
        <converters:EqualityToBooleanConverter x:Key="EqualityConverter" />
    </UserControl.Resources>

    <!-- Modal Backdrop -->
    <Grid Background="#60000000">
        <Border Width="580"
                Background="{DynamicResource WinPanelBrush}"
                BorderBrush="{DynamicResource WinBorderBrush}"
                BorderThickness="1"
                CornerRadius="10"
                BoxShadow="0 20 60 #35000000"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Padding="24">

            <Grid RowDefinitions="Auto,*,Auto">
                <!-- Header -->
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,16">
                    <StackPanel Grid.Column="0" Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Border Width="30" Height="30" Background="#EFF6FF" CornerRadius="6">
                                <materialIcons:MaterialIcon Kind="CallSplit" Width="18" Height="18" Foreground="#0F6CBD" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Organize: Split &amp; Extract Pages" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource WinTextBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="Extract or split pages into independent documents or sub-ranges." FontSize="11.5" Foreground="{DynamicResource WinMutedBrush}" />
                    </StackPanel>

                    <Button Grid.Column="1"
                            Classes="mini-tool-btn"
                            Width="30" Height="30"
                            Command="{Binding CloseSplitExtractDialogCommand}">
                        <materialIcons:MaterialIcon Kind="Close" Width="16" Height="16" Foreground="{DynamicResource WinMutedBrush}" />
                    </Button>
                </Grid>

                <!-- Body -->
                <StackPanel Grid.Row="1" Spacing="14">

                    <!-- Mode Selector Tabs -->
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="6">
                        <Button Grid.Column="0" Classes="secondary-btn" Height="32"
                                Classes.active="{Binding SplitExtractMode, Converter={StaticResource EqualityConverter}, ConverterParameter=SplitEveryNPages}"
                                Command="{Binding SetSplitExtractModeCommand}" CommandParameter="{x:Static models1:SplitExtractMode.SplitEveryNPages}">
                            <TextBlock Text="Split Every N Pages" FontSize="11" />
                        </Button>
                        <Button Grid.Column="1" Classes="secondary-btn" Height="32"
                                Classes.active="{Binding SplitExtractMode, Converter={StaticResource EqualityConverter}, ConverterParameter=SplitByPageRanges}"
                                Command="{Binding SetSplitExtractModeCommand}" CommandParameter="{x:Static models1:SplitExtractMode.SplitByPageRanges}">
                            <TextBlock Text="Split by Ranges" FontSize="11" />
                        </Button>
                        <Button Grid.Column="2" Classes="secondary-btn" Height="32"
                                Classes.active="{Binding SplitExtractMode, Converter={StaticResource EqualityConverter}, ConverterParameter=ExtractSelectedPages}"
                                Command="{Binding SetSplitExtractModeCommand}" CommandParameter="{x:Static models1:SplitExtractMode.ExtractSelectedPages}">
                            <TextBlock Text="Extract Current Page" FontSize="11" />
                        </Button>
                    </Grid>

                    <!-- Split Every N Pages Option -->
                    <StackPanel Spacing="6" IsVisible="{Binding SplitExtractMode, Converter={StaticResource EqualityConverter}, ConverterParameter=SplitEveryNPages}">
                        <TextBlock Text="Pages per Document" Classes="inspector-label" />
                        <NumericUpDown Value="{Binding SplitPageInterval, Mode=TwoWay}" Minimum="1" Maximum="{Binding TotalPagesCount}" Height="32" FontSize="12" />
                        <TextBlock Text="Each output document will contain exactly this number of pages." FontSize="11" Foreground="{DynamicResource WinMutedBrush}" />
                    </StackPanel>

                    <!-- Split by Page Ranges Option -->
                    <StackPanel Spacing="6" IsVisible="{Binding SplitExtractMode, Converter={StaticResource EqualityConverter}, ConverterParameter=SplitByPageRanges}">
                        <TextBlock Text="Page Ranges (e.g. 1-2, 3-4)" Classes="inspector-label" />
                        <TextBox Text="{Binding SplitPageRanges, Mode=TwoWay}" Height="32" FontSize="12" PlaceholderText="e.g. 1-2, 3" />
                        <TextBlock Text="Specify comma-separated ranges to partition into multiple PDF projects." FontSize="11" Foreground="{DynamicResource WinMutedBrush}" />
                    </StackPanel>

                    <!-- Extract Selected Page Option -->
                    <StackPanel Spacing="6" IsVisible="{Binding SplitExtractMode, Converter={StaticResource EqualityConverter}, ConverterParameter=ExtractSelectedPages}">
                        <TextBlock Text="Extract Current Active Page into New Project" Classes="inspector-label" />
                        <Border Background="{DynamicResource WinBgBrush}" BorderBrush="{DynamicResource WinBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10">
                            <TextBlock Text="{Binding CurrentPageNumber, StringFormat='Active: Page {0}'}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource WinAccentBrush}" />
                        </Border>
                    </StackPanel>

                </StackPanel>

                <!-- Footer Actions -->
                <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,18,0,0">
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                        <Button Classes="secondary-btn" Height="32" Padding="14,0" Command="{Binding CloseSplitExtractDialogCommand}">
                            <TextBlock Text="Cancel" FontSize="12" />
                        </Button>
                        <Button Classes="accent-btn" Height="32" Padding="16,0" Command="{Binding ExecuteSplitExtractCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <materialIcons:MaterialIcon Kind="CallSplit" Width="15" Height="15" Foreground="White" />
                                <TextBlock Text="Execute" FontSize="12" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

            </Grid>
        </Border>
    </Grid>

</UserControl>
