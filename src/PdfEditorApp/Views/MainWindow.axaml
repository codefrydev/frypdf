<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PdfEditorApp.ViewModels"
        xmlns:views="using:PdfEditorApp.Views"
        xmlns:dialogs="using:PdfEditorApp.Views.Dialogs"
        xmlns:converters="using:PdfEditorApp.Converters"
        xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="820"
        x:Class="PdfEditorApp.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/app-logo.ico"
        Title="{Binding WindowTitle}"
        Width="1320"
        Height="840"
        MinWidth="960"
        MinHeight="640"
        Background="{DynamicResource WinBgBrush}">

    <Window.Resources>
        <converters:ZoomPercentageConverter x:Key="ZoomPercentageConverter" />
        <converters:HexToBrushConverter x:Key="HexToBrushConverter" />
        <converters:BooleanToStringConverter x:Key="BooleanToStringConverter" />
    </Window.Resources>

    <!-- Global Cross-Platform KeyBindings (macOS Cmd & Win/Linux Ctrl) -->
    <Window.KeyBindings>
        <!-- Theme Switching -->
        <KeyBinding Gesture="Ctrl+Shift+T" Command="{Binding ToggleThemeCommand}" />
        <KeyBinding Gesture="Cmd+Shift+T" Command="{Binding ToggleThemeCommand}" />

        <!-- File Operations -->
        <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveProjectCommand}" />
        <KeyBinding Gesture="Cmd+S" Command="{Binding SaveProjectCommand}" />
        <KeyBinding Gesture="Ctrl+E" Command="{Binding ExportPdfCommand}" />
        <KeyBinding Gesture="Cmd+E" Command="{Binding ExportPdfCommand}" />
        <KeyBinding Gesture="Ctrl+O" Command="{Binding OpenProjectCommand}" />
        <KeyBinding Gesture="Cmd+O" Command="{Binding OpenProjectCommand}" />
        <KeyBinding Gesture="Ctrl+N" Command="{Binding OpenNewDocumentDialogCommand}" />
        <KeyBinding Gesture="Cmd+N" Command="{Binding OpenNewDocumentDialogCommand}" />

        <!-- Edit Operations -->
        <KeyBinding Gesture="Ctrl+Z" Command="{Binding UndoCommand}" />
        <KeyBinding Gesture="Cmd+Z" Command="{Binding UndoCommand}" />
        <KeyBinding Gesture="Ctrl+Y" Command="{Binding RedoCommand}" />
        <KeyBinding Gesture="Cmd+Shift+Z" Command="{Binding RedoCommand}" />
        <KeyBinding Gesture="Ctrl+C" Command="{Binding CopyCommand}" />
        <KeyBinding Gesture="Cmd+C" Command="{Binding CopyCommand}" />
        <KeyBinding Gesture="Ctrl+X" Command="{Binding CutCommand}" />
        <KeyBinding Gesture="Cmd+X" Command="{Binding CutCommand}" />
        <KeyBinding Gesture="Ctrl+V" Command="{Binding PasteCommand}" />
        <KeyBinding Gesture="Cmd+V" Command="{Binding PasteCommand}" />
        <KeyBinding Gesture="Ctrl+D" Command="{Binding DuplicateCommand}" />
        <KeyBinding Gesture="Cmd+D" Command="{Binding DuplicateCommand}" />

        <!-- Workspace & Panel Collapsing -->
        <KeyBinding Gesture="Ctrl+F1" Command="{Binding ToggleRibbonCollapseCommand}" />
        <KeyBinding Gesture="Cmd+F1" Command="{Binding ToggleRibbonCollapseCommand}" />
        <KeyBinding Gesture="Ctrl+B" Command="{Binding ToggleLeftSidebarCommand}" />
        <KeyBinding Gesture="Cmd+B" Command="{Binding ToggleLeftSidebarCommand}" />
        <KeyBinding Gesture="Ctrl+Shift+P" Command="{Binding ToggleInspectorCollapseCommand}" />
        <KeyBinding Gesture="Cmd+Shift+P" Command="{Binding ToggleInspectorCollapseCommand}" />

        <!-- Command Palette & Help -->
        <KeyBinding Gesture="Ctrl+K" Command="{Binding OpenCommandPaletteCommand}" />
        <KeyBinding Gesture="Cmd+K" Command="{Binding OpenCommandPaletteCommand}" />
        <KeyBinding Gesture="Ctrl+F" Command="{Binding OpenCommandPaletteCommand}" />
        <KeyBinding Gesture="Cmd+F" Command="{Binding OpenCommandPaletteCommand}" />
        <KeyBinding Gesture="F1" Command="{Binding OpenShortcutsHelpCommand}" />
        <KeyBinding Gesture="Ctrl+OemQuestion" Command="{Binding OpenShortcutsHelpCommand}" />
        <KeyBinding Gesture="Cmd+OemQuestion" Command="{Binding OpenShortcutsHelpCommand}" />

        <!-- View & Zoom -->
        <KeyBinding Gesture="Ctrl+Add" Command="{Binding ZoomInCommand}" />
        <KeyBinding Gesture="Cmd+Add" Command="{Binding ZoomInCommand}" />
        <KeyBinding Gesture="Ctrl+OemPlus" Command="{Binding ZoomInCommand}" />
        <KeyBinding Gesture="Cmd+OemPlus" Command="{Binding ZoomInCommand}" />
        <KeyBinding Gesture="Ctrl+Shift+OemPlus" Command="{Binding ZoomInCommand}" />
        <KeyBinding Gesture="Cmd+Shift+OemPlus" Command="{Binding ZoomInCommand}" />
        <KeyBinding Gesture="Ctrl+Shift+Add" Command="{Binding ZoomInCommand}" />
        <KeyBinding Gesture="Cmd+Shift+Add" Command="{Binding ZoomInCommand}" />
        <KeyBinding Gesture="Ctrl+Subtract" Command="{Binding ZoomOutCommand}" />
        <KeyBinding Gesture="Cmd+Subtract" Command="{Binding ZoomOutCommand}" />
        <KeyBinding Gesture="Ctrl+OemMinus" Command="{Binding ZoomOutCommand}" />
        <KeyBinding Gesture="Cmd+OemMinus" Command="{Binding ZoomOutCommand}" />
        <KeyBinding Gesture="Ctrl+Shift+OemMinus" Command="{Binding ZoomOutCommand}" />
        <KeyBinding Gesture="Cmd+Shift+OemMinus" Command="{Binding ZoomOutCommand}" />
        <KeyBinding Gesture="Ctrl+Shift+Subtract" Command="{Binding ZoomOutCommand}" />
        <KeyBinding Gesture="Cmd+Shift+Subtract" Command="{Binding ZoomOutCommand}" />
        <KeyBinding Gesture="Ctrl+D0" Command="{Binding ResetZoomCommand}" />
        <KeyBinding Gesture="Cmd+D0" Command="{Binding ResetZoomCommand}" />
        <KeyBinding Gesture="Ctrl+NumPad0" Command="{Binding ResetZoomCommand}" />
        <KeyBinding Gesture="Cmd+NumPad0" Command="{Binding ResetZoomCommand}" />
        <KeyBinding Gesture="Ctrl+D1" Command="{Binding FitToWidthCommand}" />
        <KeyBinding Gesture="Cmd+D1" Command="{Binding FitToWidthCommand}" />
        <KeyBinding Gesture="Ctrl+NumPad1" Command="{Binding FitToWidthCommand}" />
        <KeyBinding Gesture="Cmd+NumPad1" Command="{Binding FitToWidthCommand}" />
        <KeyBinding Gesture="Ctrl+D9" Command="{Binding FitToPageCommand}" />
        <KeyBinding Gesture="Cmd+D9" Command="{Binding FitToPageCommand}" />
        <KeyBinding Gesture="Ctrl+NumPad9" Command="{Binding FitToPageCommand}" />
        <KeyBinding Gesture="Cmd+NumPad9" Command="{Binding FitToPageCommand}" />

        <!-- Page Navigation & Page Actions -->
        <KeyBinding Gesture="PageDown" Command="{Binding NextPageCommand}" />
        <KeyBinding Gesture="Ctrl+PageDown" Command="{Binding NextPageCommand}" />
        <KeyBinding Gesture="PageUp" Command="{Binding PreviousPageCommand}" />
        <KeyBinding Gesture="Ctrl+PageUp" Command="{Binding PreviousPageCommand}" />
        <KeyBinding Gesture="Home" Command="{Binding FirstPageCommand}" />
        <KeyBinding Gesture="End" Command="{Binding LastPageCommand}" />
        <KeyBinding Gesture="Ctrl+Shift+N" Command="{Binding AddPageCommand}" />
        <KeyBinding Gesture="Cmd+Shift+N" Command="{Binding AddPageCommand}" />
        <KeyBinding Gesture="Ctrl+Shift+D" Command="{Binding DuplicateCurrentPageCommand}" />
        <KeyBinding Gesture="Cmd+Shift+D" Command="{Binding DuplicateCurrentPageCommand}" />
        <KeyBinding Gesture="Ctrl+Shift+R" Command="{Binding RotateCurrentPageCommand}" />
        <KeyBinding Gesture="Cmd+Shift+R" Command="{Binding RotateCurrentPageCommand}" />
        <KeyBinding Gesture="Ctrl+Shift+Delete" Command="{Binding DeleteCurrentPageCommand}" />
        <KeyBinding Gesture="Cmd+Shift+Delete" Command="{Binding DeleteCurrentPageCommand}" />
    </Window.KeyBindings>

    <!-- Main Window Root Layout -->
    <Grid>

        <!-- ===== HOME PAGE ===== -->
        <views:HomeView IsVisible="{Binding $parent[Window].((vm:MainViewModel)DataContext).IsHomePageVisible}"
                        DataContext="{Binding Home}" />

        <!-- ===== PDF VIEWER SHELL ===== -->
        <views:PdfViewerView IsVisible="{Binding $parent[Window].((vm:MainViewModel)DataContext).IsPdfViewerVisible}"
                             DataContext="{Binding PdfViewer}" />

        <!-- ===== EDITOR SHELL (shown after entering a document) ===== -->
        <Grid IsVisible="{Binding IsEditorVisible}"
              RowDefinitions="Auto,Auto,*,Auto">

            <!-- 1. Top Modern Title Bar -->
            <Border Grid.Row="0" Background="{DynamicResource WinBgBrush}" Height="44" BorderBrush="{DynamicResource WinBorderBrush}" BorderThickness="0,0,0,1" Padding="14,0"
                    IsVisible="{Binding !IsPresentationMode}">
                <Grid ColumnDefinitions="Auto,*,Auto">

                    <!-- Left: App Icon, Brand & Document Title -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <!-- CodeFryDev Logo & FryPDF Brand Badge (Click to open About dialog) -->
                        <Button Classes="mini-tool-btn"
                                Padding="3,2"
                                Command="{Binding OpenAboutDialogCommand}"
                                ToolTip.Tip="About FryPDF by CodeFryDev (⌘K → About)">
                            <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                                <Border Width="28" Height="28" Background="#0F172A" BorderBrush="#38BDF8" BorderThickness="1" CornerRadius="6" BoxShadow="0 2 6 #3038BDF8">
                                    <Viewbox Width="19" Height="19" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Canvas Width="196" Height="196">
                                            <Path Fill="#38BDF8" Data="M50 126H145V133C145 157.853 124.853 178 100 178H95C70.1472 178 50 157.853 50 133V126Z" />
                                            <Path Fill="#F8FAFC" Data="M39.1328 112.539L51.3008 116.797V122.441L34.2305 115.352V111.27L39.1328 112.539ZM51.3008 109.082L39.1328 113.418L34.2305 114.648V110.547L51.3008 103.457V109.082ZM72.3359 115.469H78.6641C78.5599 117.422 78.026 119.147 77.0625 120.645C76.112 122.129 74.7904 123.294 73.0977 124.141C71.4049 124.974 69.3932 125.391 67.0625 125.391C65.2005 125.391 63.5339 125.072 62.0625 124.434C60.5911 123.796 59.3411 122.884 58.3125 121.699C57.2969 120.501 56.5156 119.062 55.9688 117.383C55.4349 115.69 55.168 113.783 55.168 111.66V109.922C55.168 107.799 55.4479 105.892 56.0078 104.199C56.5677 102.507 57.3685 101.061 58.4102 99.8633C59.4518 98.6654 60.7018 97.7474 62.1602 97.1094C63.6185 96.4714 65.2461 96.1523 67.043 96.1523C69.4648 96.1523 71.5091 96.5885 73.1758 97.4609C74.8424 98.3333 76.1315 99.5312 77.043 101.055C77.9674 102.578 78.5208 104.316 78.7031 106.27H72.3555C72.3034 105.163 72.0951 104.232 71.7305 103.477C71.3659 102.708 70.806 102.129 70.0508 101.738C69.2956 101.348 68.293 101.152 67.043 101.152C66.1315 101.152 65.3307 101.322 64.6406 101.66C63.9635 101.999 63.3971 102.526 62.9414 103.242C62.4987 103.958 62.1667 104.87 61.9453 105.977C61.724 107.07 61.6133 108.372 61.6133 109.883V111.66C61.6133 113.158 61.7109 114.453 61.9062 115.547C62.1016 116.641 62.4141 117.546 62.8438 118.262C63.2865 118.978 63.8529 119.512 64.543 119.863C65.2331 120.215 66.0729 120.391 67.0625 120.391C68.1953 120.391 69.1393 120.215 69.8945 119.863C70.6497 119.499 71.2292 118.952 71.6328 118.223C72.0365 117.493 72.2708 116.576 72.3359 115.469ZM88.5664 96.5625V125H82.1992V96.5625H88.5664ZM99.7578 108.555V113.477H86.7891V108.555H99.7578ZM101.008 96.5625V101.504H86.7891V96.5625H101.008ZM113.117 125H106.867L106.906 120.078H113.117C114.536 120.078 115.734 119.753 116.711 119.102C117.688 118.438 118.43 117.461 118.938 116.172C119.445 114.87 119.699 113.288 119.699 111.426V110.117C119.699 108.711 119.556 107.474 119.27 106.406C118.983 105.326 118.56 104.421 118 103.691C117.44 102.962 116.743 102.415 115.91 102.051C115.09 101.686 114.146 101.504 113.078 101.504H106.75V96.5625H113.078C115.005 96.5625 116.763 96.888 118.352 97.5391C119.953 98.1901 121.333 99.1211 122.492 100.332C123.664 101.543 124.569 102.975 125.207 104.629C125.845 106.283 126.164 108.125 126.164 110.156V111.426C126.164 113.444 125.845 115.286 125.207 116.953C124.569 118.607 123.664 120.039 122.492 121.25C121.333 122.448 119.96 123.372 118.371 124.023C116.783 124.674 115.031 125 113.117 125ZM110.48 96.5625V125H104.113V96.5625H110.48ZM141.789 96.5625L131.73 127.441H127.297L137.355 96.5625H141.789ZM156.594 113.32L144.406 109.082V103.457L161.516 110.547V114.668L156.594 113.32ZM144.406 116.855L156.613 112.5L161.516 111.27V115.371L144.406 122.461V116.855Z" />
                                            <Path Fill="#F59E0B" Data="M68.0627 60.6519C68.3821 54.8593 73.1743 46 73.1743 46C73.1743 46 71.2574 55.5407 71.5769 60.6519C71.8964 65.763 72.5354 65.0815 73.4938 68.8296C74.4522 72.5778 73.8133 74.2815 73.4938 77.0074C73.1743 79.7333 72.8549 80.0741 72.2159 83.4815C71.5769 86.8889 69.9795 92 69.9795 92C69.9795 92 70.299 84.3333 70.299 81.437C70.299 78.5407 70.6185 74.6222 69.6601 70.5333C68.7017 66.4444 67.7432 66.4444 68.0627 60.6519Z" />
                                            <Path Fill="#EF4444" Data="M99.9582 38.7481C99.7452 30.9407 96.5504 19 96.5504 19C96.5504 19 97.8284 31.8593 97.6154 38.7481C97.4024 45.637 96.9764 44.7185 96.3375 49.7704C95.6985 54.8222 96.1245 57.1185 96.3375 60.7926C96.5505 64.4667 96.7634 64.9259 97.1894 69.5185C97.6154 74.1111 98.6803 81 98.6803 81C98.6803 81 98.4673 70.6667 98.4673 66.763C98.4673 62.8593 98.2544 57.5778 98.8933 52.0667C99.5322 46.5556 100.171 46.5556 99.9582 38.7481Z" />
                                            <Path Fill="#F59E0B" Data="M118.042 64.7407C118.255 59.7037 121.45 52 121.45 52C121.45 52 120.172 60.2963 120.385 64.7407C120.598 69.1852 121.024 68.5926 121.663 71.8519C122.301 75.1111 121.876 76.5926 121.663 78.963C121.45 81.3333 121.237 81.6296 120.811 84.5926C120.385 87.5556 119.32 92 119.32 92C119.32 92 119.533 85.3333 119.533 82.8148C119.533 80.2963 119.746 76.8889 119.107 73.3333C118.468 69.7778 117.829 69.7778 118.042 64.7407Z" />
                                        </Canvas>
                                    </Viewbox>
                                </Border>
                                <TextBlock Text="FryPDF" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource WinTextBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- Home Navigation Button (only visible in editor) -->
                        <Button Classes="mini-tool-btn"
                                Width="30" Height="30"
                                Command="{Binding NavigateToHomeCommand}"
                                ToolTip.Tip="Go to Home / Start Screen"
                                Margin="-2,0,0,0">
                            <materialIcons:MaterialIcon Kind="HomeOutline" Width="16" Height="16" Foreground="{DynamicResource WinMutedBrush}" />
                        </Button>

                        <!-- Separator -->
                        <Rectangle Width="1" Height="16" Fill="{DynamicResource WinBorderBrush}" />

                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock Text="{Binding DocumentTitle}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource WinTextBrush}"
                                       VerticalAlignment="Center" />

                            <!-- App Subtitle Pill -->
                            <Border Background="{DynamicResource WinHoverBrush}" BorderBrush="{DynamicResource WinBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2">
                                <TextBlock Text="by CodeFryDev" FontSize="10.5" FontWeight="Medium" Foreground="{DynamicResource WinMutedBrush}" VerticalAlignment="Center" />
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <!-- Center: Search & Command Palette Trigger Bar -->
                    <Button Grid.Column="1"
                            HorizontalAlignment="Center"
                            Width="380"
                            Height="30"
                            Background="{DynamicResource WinPanelBrush}"
                            BorderBrush="{DynamicResource WinBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="7"
                            Padding="10,0"
                            Command="{Binding OpenCommandPaletteCommand}"
                            ToolTip.Tip="Open Quick Command Palette (⌘K / Ctrl+K)">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <materialIcons:MaterialIcon Grid.Column="0" Kind="Magnify" Width="15" Height="15" Foreground="{DynamicResource WinAccentBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1"
                                       Text="Type ⌘K to run commands, insert tools, search..."
                                       FontSize="11.5"
                                       Foreground="{DynamicResource WinMutedBrush}"
                                       VerticalAlignment="Center" />
                            <!-- Quick Shortcut Badge -->
                            <Border Grid.Column="2" Background="{DynamicResource WinBgBrush}" BorderBrush="{DynamicResource WinBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="5,1" VerticalAlignment="Center">
                                <TextBlock Text="⌘K" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource WinSubtleBrush}" />
                            </Border>
                        </Grid>
                    </Button>

                    <!-- Right: Quick Save, Panel Toggles & Actions -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <Button Classes="mini-tool-btn" Width="28" Height="28" Command="{Binding ToggleLeftSidebarCommand}" ToolTip.Tip="Toggle Pages Sidebar (⌘B / Ctrl+B)">
                            <materialIcons:MaterialIcon Kind="DockLeft" Width="15" Height="15" Foreground="{DynamicResource WinMutedBrush}" />
                        </Button>
                        <Button Classes="mini-tool-btn" Width="28" Height="28" Command="{Binding ToggleRibbonCollapseCommand}" ToolTip.Tip="Toggle Ribbon Toolbar (⌘F1 / Ctrl+F1)">
                            <materialIcons:MaterialIcon Kind="DockTop" Width="15" Height="15" Foreground="{DynamicResource WinMutedBrush}" />
                        </Button>
                        <Button Classes="mini-tool-btn" Width="28" Height="28" Command="{Binding ToggleInspectorCollapseCommand}" ToolTip.Tip="Toggle Properties Inspector (⌘⇧P / Ctrl+Shift+P)">
                            <materialIcons:MaterialIcon Kind="DockRight" Width="15" Height="15" Foreground="{DynamicResource WinMutedBrush}" />
                        </Button>
                        <Rectangle Width="1" Height="16" Fill="{DynamicResource WinBorderBrush}" Margin="2,0" />
                        <Button Classes="mini-tool-btn" Width="28" Height="28" Command="{Binding SaveProjectCommand}" ToolTip.Tip="Save Project (⌘S / Ctrl+S)">
                            <materialIcons:MaterialIcon Kind="ContentSaveOutline" Width="15" Height="15" Foreground="{DynamicResource WinMutedBrush}" />
                        </Button>
                        <Button Classes="mini-tool-btn" Width="28" Height="28" Command="{Binding ExportPdfCommand}" ToolTip.Tip="Export to PDF (⌘E / Ctrl+E)">
                            <materialIcons:MaterialIcon Kind="ExportVariant" Width="15" Height="15" Foreground="{DynamicResource WinMutedBrush}" />
                        </Button>
                        <Rectangle Width="1" Height="16" Fill="{DynamicResource WinBorderBrush}" Margin="2,0" />
                        <Button Classes="mini-tool-btn" Width="28" Height="28" Command="{Binding NavigateToHelpCommand}" ToolTip.Tip="Help &amp; User Guides (All 32 Tools &amp; Studio Features)">
                            <materialIcons:MaterialIcon Kind="HelpCircleOutline" Width="15" Height="15" Foreground="#0284C7" />
                        </Button>
                        <Button Classes="mini-tool-btn" Width="28" Height="28" Command="{Binding OpenShortcutsHelpCommand}" ToolTip.Tip="Keyboard Shortcuts Cheat Sheet (F1 / ?)">
                            <materialIcons:MaterialIcon Kind="KeyboardOutline" Width="15" Height="15" Foreground="{DynamicResource WinMutedBrush}" />
                        </Button>
                        <Button Classes="mini-tool-btn" Width="28" Height="28" Command="{Binding OpenAboutDialogCommand}" ToolTip.Tip="About FryPDF &amp; Support (CodeFryDev)">
                            <materialIcons:MaterialIcon Kind="InformationOutline" Width="15" Height="15" Foreground="{DynamicResource WinAccentBrush}" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 2. Ribbon Menu & Toolbars -->
            <views:RibbonView Grid.Row="1" IsVisible="{Binding !IsPresentationMode}" />

            <!-- 3. Main Workspace: Left Thumbnails + Center Document Canvas + Right Inspector -->
            <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto">
                <!-- Left: Thumbnails Sidebar -->
                <views:ThumbnailSidebarView Grid.Column="0" IsVisible="{Binding !IsPresentationMode}" />

                <!-- Center: Interactive PDF Document Canvas -->
                <views:DocumentCanvasView Grid.Column="1" />

                <!-- Right: Format & Properties Inspector -->
                <Panel Grid.Column="2" IsVisible="{Binding !IsPresentationMode}">
                    <views:InspectorSidebarView DataContext="{Binding Inspector}" />
                </Panel>
            </Grid>

            <!-- 4. Bottom Status Bar -->
            <Border Grid.Row="3" Background="{DynamicResource WinBgBrush}" Height="32" BorderBrush="{DynamicResource WinBorderBrush}" BorderThickness="0,1,0,0" Padding="14,0">
                <Grid ColumnDefinitions="Auto,*,Auto">

                    <!-- Left: Page Info, Dimensions & Document Status -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <!-- Page Number Chip -->
                        <Border Background="{DynamicResource WinPanelBrush}" BorderBrush="{DynamicResource WinBorderBrush}" BorderThickness="1" CornerRadius="5" Padding="7,2">
                            <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                <materialIcons:MaterialIcon Kind="FileDocumentOutline" Width="13" Height="13" Foreground="{DynamicResource WinMutedBrush}" />
                                <TextBlock FontSize="11" FontWeight="Medium" Foreground="{DynamicResource WinTextBrush}" VerticalAlignment="Center">
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="Page {0} of {1}">
                                            <Binding Path="CurrentPageNumber" />
                                            <Binding Path="TotalPagesCount" />
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <!-- Page Dimensions Chip -->
                        <Border Background="{DynamicResource WinPanelBrush}" BorderBrush="{DynamicResource WinBorderBrush}" BorderThickness="1" CornerRadius="5" Padding="7,2">
                            <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                <materialIcons:MaterialIcon Kind="AspectRatio" Width="13" Height="13" Foreground="{DynamicResource WinMutedBrush}" />
                                <TextBlock Text="{Binding PageDimensionsDisplay}" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource WinTextBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <!-- Status Message with Active Indicator Dot -->
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="6,0,0,0">
                            <Ellipse Width="6" Height="6" Fill="#10B981" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding StatusMessage}" FontSize="11" Foreground="{DynamicResource WinMutedBrush}" FontWeight="Medium" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Right: Zoom Controls & Workspace Panel Toggles -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <!-- Fit to Width -->
                        <Button Classes="mini-tool-btn" Width="26" Height="26" Command="{Binding FitToWidthCommand}" ToolTip.Tip="Fit to Width (⌘1 / Ctrl+1)">
                            <materialIcons:MaterialIcon Kind="ArrowExpandHorizontal" Width="14" Height="14" Foreground="{DynamicResource WinMutedBrush}" />
                        </Button>

                        <!-- Fit to Page -->
                        <Button Classes="mini-tool-btn" Width="26" Height="26" Command="{Binding FitToPageCommand}" ToolTip.Tip="Fit Entire Page (⌘9 / Ctrl+9)">
                            <materialIcons:MaterialIcon Kind="FitToScreenOutline" Width="14" Height="14" Foreground="{DynamicResource WinMutedBrush}" />
                        </Button>

                        <Rectangle Width="1" Height="14" Fill="{DynamicResource WinBorderBrush}" Margin="2,0" />

                        <!-- Zoom Out -->
                        <Button Classes="mini-tool-btn" Width="26" Height="26" Command="{Binding ZoomOutCommand}" ToolTip.Tip="Zoom Out (⌘- / Ctrl+-)">
                            <materialIcons:MaterialIcon Kind="Minus" Width="14" Height="14" Foreground="{DynamicResource WinMutedBrush}" />
                        </Button>

                        <!-- Zoom Slider -->
                        <Slider Width="110"
                                Minimum="0.4"
                                Maximum="2.5"
                                Value="{Binding ZoomLevel, Mode=TwoWay}"
                                SmallChange="0.05"
                                LargeChange="0.1"
                                VerticalAlignment="Center" />

                        <!-- Zoom In -->
                        <Button Classes="mini-tool-btn" Width="26" Height="26" Command="{Binding ZoomInCommand}" ToolTip.Tip="Zoom In (⌘+ / Ctrl++)">
                            <materialIcons:MaterialIcon Kind="Plus" Width="14" Height="14" Foreground="{DynamicResource WinMutedBrush}" />
                        </Button>

                        <!-- Zoom Percentage Pill (Click to Reset 100%) -->
                        <Button Background="{DynamicResource WinPanelBrush}"
                                BorderBrush="{DynamicResource WinBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="5"
                                Padding="6,2"
                                Margin="4,0,0,0"
                                Command="{Binding ResetZoomCommand}"
                                ToolTip.Tip="Reset Zoom 100% (⌘0 / Ctrl+0)">
                            <TextBlock Text="{Binding ZoomLevel, Converter={StaticResource ZoomPercentageConverter}}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource WinTextBrush}"
                                       Width="36"
                                       TextAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Button>

                        <Rectangle Width="1" Height="14" Fill="{DynamicResource WinBorderBrush}" Margin="2,0" />

                        <!-- Quick Panel Dock Buttons -->
                        <Button Classes="mini-tool-btn" Width="26" Height="26" Command="{Binding ToggleLeftSidebarCommand}" ToolTip.Tip="Toggle Pages Sidebar (⌘B)">
                            <materialIcons:MaterialIcon Kind="DockLeft" Width="14" Height="14" Foreground="{DynamicResource WinMutedBrush}" />
                        </Button>
                        <Button Classes="mini-tool-btn" Width="26" Height="26" Command="{Binding ToggleInspectorCollapseCommand}" ToolTip.Tip="Toggle Properties Inspector (⌘⇧P)">
                            <materialIcons:MaterialIcon Kind="DockRight" Width="14" Height="14" Foreground="{DynamicResource WinMutedBrush}" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

        </Grid>
        <!-- END EDITOR SHELL -->

        <!-- Floating HUD Toast Notification Banner -->
        <Border Classes="toast-banner"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Margin="0,0,0,50"
                IsVisible="{Binding IsToastVisible}"
                IsHitTestVisible="False">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <materialIcons:MaterialIcon Kind="{Binding ToastIcon}" Width="18" Height="18" Foreground="#38BDF8" VerticalAlignment="Center" />
                <TextBlock Text="{Binding ToastMessage}" FontSize="12" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- Dialog Overlays -->
        <dialogs:NewDocumentDialog IsVisible="{Binding IsNewDocumentDialogOpen}" />
        <dialogs:ExportSuccessDialog IsVisible="{Binding IsExportSuccessDialogOpen}" />
        <dialogs:CommandPaletteDialog IsVisible="{Binding IsCommandPaletteOpen}" />
        <dialogs:ShortcutsHelpDialog IsVisible="{Binding IsShortcutsHelpDialogOpen}" />
        <dialogs:SignatureStudioDialog IsVisible="{Binding IsSignatureStudioOpen}" />
        <dialogs:DocumentSecurityDialog IsVisible="{Binding IsSecurityDialogOpen}" />
        <dialogs:PreflightDiagnosticsDialog IsVisible="{Binding IsPreflightDialogOpen}" />
        <dialogs:HeaderFooterDialog IsVisible="{Binding IsHeaderFooterDialogOpen}" />
        <dialogs:WatermarkManagerDialog IsVisible="{Binding IsWatermarkManagerOpen}" />
        <dialogs:SearchRedactDialog IsVisible="{Binding IsSearchRedactDialogOpen}" />
        <dialogs:CustomStampDialog IsVisible="{Binding IsCustomStampDialogOpen}" />
        <dialogs:BatesNumberingDialog IsVisible="{Binding IsBatesNumberingDialogOpen}" />
        <dialogs:SplitExtractDialog IsVisible="{Binding IsSplitExtractDialogOpen}" />
        <dialogs:CompareDocumentsDialog IsVisible="{Binding IsCompareDialogOpen}" />
        <dialogs:MathEquationStudioDialog IsVisible="{Binding IsMathStudioOpen}" />
        <dialogs:AboutDialog IsVisible="{Binding IsAboutDialogOpen}" />
        <dialogs:DataStudioDialog DataContext="{Binding DataStudio}" IsVisible="{Binding IsOpen}" />
        <dialogs:WorkflowBuilderDialog DataContext="{Binding WorkflowBuilder}" IsVisible="{Binding IsOpen}" />
        <dialogs:BatchGenerationDialog DataContext="{Binding BatchGeneration}" IsVisible="{Binding IsOpen}" />
    </Grid>

</Window>
