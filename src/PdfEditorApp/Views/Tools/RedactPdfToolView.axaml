<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PdfEditorApp.ViewModels.Tools"
             xmlns:models="using:PdfEditorApp.Models"
             xmlns:converters="using:PdfEditorApp.Converters"
             xmlns:shell="using:PdfEditorApp.Views.Shell"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="PdfEditorApp.Views.Tools.RedactPdfToolView"
             x:DataType="vm:RedactPdfToolViewModel">

    <UserControl.Resources>
        <converters:MultiplyConverter x:Key="MultiplyConverter" />
    </UserControl.Resources>

    <shell:PdfToolWorkspaceView>

        <!-- Toolbar primary action -->
        <shell:PdfToolWorkspaceView.ToolbarActionContent>
            <Button Command="{Binding ExecuteToolCommand}" IsEnabled="{Binding !IsRunning}" Background="#0284C7" Foreground="White" CornerRadius="8" Padding="16,8" FontWeight="Bold" FontSize="12.5" Cursor="Hand">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <materialIcons:MaterialIcon Kind="SelectRemove" Width="15" Height="15" />
                    <TextBlock Text="{Binding Marks.Count, StringFormat='Redact {0} Region(s)'}" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </shell:PdfToolWorkspaceView.ToolbarActionContent>

        <!-- Interactive mark-drawing layer over the shared preview's current page -->
        <shell:PdfToolWorkspaceView.CanvasOverlayContent>
            <Panel>
                <ItemsControl ItemsSource="{Binding CurrentPageMarks}">
                    <ItemsControl.Width>
                        <MultiBinding Converter="{StaticResource MultiplyConverter}">
                            <Binding Path="Preview.SelectedPage.WidthPoints" />
                            <Binding Path="Preview.ZoomLevel" />
                        </MultiBinding>
                    </ItemsControl.Width>
                    <ItemsControl.Height>
                        <MultiBinding Converter="{StaticResource MultiplyConverter}">
                            <Binding Path="Preview.SelectedPage.HeightPoints" />
                            <Binding Path="Preview.ZoomLevel" />
                        </MultiBinding>
                    </ItemsControl.Height>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas Width="{Binding #LiveGestureCanvas.Width}" Height="{Binding #LiveGestureCanvas.Height}" Background="Transparent" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerTheme>
                        <ControlTheme TargetType="ContentPresenter" x:DataType="models:RedactionMarkItem">
                            <Setter Property="Canvas.Left" Value="{Binding DisplayX}" />
                            <Setter Property="Canvas.Top" Value="{Binding DisplayY}" />
                        </ControlTheme>
                    </ItemsControl.ItemContainerTheme>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="models:RedactionMarkItem">
                            <Border Background="#B3DC2626" BorderBrush="#DC2626" BorderThickness="1.5" CornerRadius="1"
                                    Width="{Binding DisplayWidth}" Height="{Binding DisplayHeight}"
                                    ToolTip.Tip="{Binding Label}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Catches drag gestures for manual marking; Background must be
                     non-null to be hit-testable across its whole area, not just
                     where child content is drawn. -->
                <Canvas x:Name="LiveGestureCanvas" Background="Transparent" Cursor="IBeam"
                        PointerPressed="OnPreviewPointerPressed" PointerMoved="OnPreviewPointerMoved"
                        PointerReleased="OnPreviewPointerReleased" PointerWheelChanged="OnPreviewPointerWheelChanged">
                    <Canvas.Width>
                        <MultiBinding Converter="{StaticResource MultiplyConverter}">
                            <Binding Path="Preview.SelectedPage.WidthPoints" />
                            <Binding Path="Preview.ZoomLevel" />
                        </MultiBinding>
                    </Canvas.Width>
                    <Canvas.Height>
                        <MultiBinding Converter="{StaticResource MultiplyConverter}">
                            <Binding Path="Preview.SelectedPage.HeightPoints" />
                            <Binding Path="Preview.ZoomLevel" />
                        </MultiBinding>
                    </Canvas.Height>
                    <Border x:Name="LiveSelectionBox" Background="#4D2563EB" BorderBrush="#2563EB" BorderThickness="1.5" IsVisible="False" IsHitTestVisible="False" />
                </Canvas>
            </Panel>
        </shell:PdfToolWorkspaceView.CanvasOverlayContent>

        <!-- Sidebar Options tab: status, document selection, search-and-mark, and marked list -->
        <shell:PdfToolWorkspaceView.OptionsContent>
            <StackPanel Spacing="16">

                <!-- Error Alert Banner -->
                <Border Background="#FEF2F2" BorderBrush="#FCA5A5" BorderThickness="1" CornerRadius="10" Padding="14,10" IsVisible="{Binding HasError}">
                    <Grid ColumnDefinitions="Auto,*">
                        <materialIcons:MaterialIcon Grid.Column="0" Kind="AlertCircleOutline" Width="20" Height="20" Foreground="#DC2626" Margin="0,0,10,0" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="Redaction Failed" FontSize="12.5" FontWeight="Bold" Foreground="#991B1B" />
                            <TextBlock Text="{Binding ErrorMessage}" FontSize="11.5" Foreground="#B91C1C" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Success Banner -->
                <Border Background="#F0FDF4" BorderBrush="#86EFAC" BorderThickness="1" CornerRadius="12" Padding="16" BoxShadow="0 4 12 #1016A34A" IsVisible="{Binding IsComplete}">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <Border Width="34" Height="34" Background="#DCFCE7" CornerRadius="9">
                                <materialIcons:MaterialIcon Kind="CheckCircle" Width="20" Height="20" Foreground="#16A34A" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="PDF Redacted &amp; Sanitized!" FontSize="13.5" FontWeight="Bold" Foreground="#166534" />
                                <TextBlock Text="{Binding ResultSummaryMessage}" FontSize="11.5" Foreground="#15803D" TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>

                        <WrapPanel Orientation="Horizontal">
                            <Button Command="{Binding OpenOutputFileCommand}" Background="#16A34A" Foreground="White" CornerRadius="8" Padding="12,7" FontSize="11.5" FontWeight="SemiBold" Cursor="Hand" Margin="0,0,6,6">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <materialIcons:MaterialIcon Kind="FileEyeOutline" Width="13" Height="13" />
                                    <TextBlock Text="Open Redacted PDF" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding OpenOutputFolderCommand}" Background="#DCFCE7" Foreground="#166534" BorderBrush="#86EFAC" BorderThickness="1" CornerRadius="8" Padding="12,7" FontSize="11.5" FontWeight="SemiBold" Cursor="Hand" Margin="0,0,6,6">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <materialIcons:MaterialIcon Kind="FolderOpenOutline" Width="13" Height="13" />
                                    <TextBlock Text="Show in Folder" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- Processing Card -->
                <Border Background="{DynamicResource WinPanelBrush}" BorderBrush="{DynamicResource WinBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14" IsVisible="{Binding IsRunning}">
                    <StackPanel Spacing="10">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource WinTextBrush}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding ProgressPercentage, StringFormat='{}{0:F0}%'}" FontSize="13" FontWeight="Bold" Foreground="#0284C7" VerticalAlignment="Center" />
                        </Grid>
                        <ProgressBar Value="{Binding ProgressPercentage}" Minimum="0" Maximum="100" Height="7" CornerRadius="4" Foreground="#0284C7" Background="{DynamicResource WinHoverBrush}" />
                    </StackPanel>
                </Border>

                <!-- Dropzone -->
                <Border Background="{DynamicResource WinPanelBrush}" BorderBrush="{DynamicResource WinBorderBrush}" BorderThickness="2" CornerRadius="10" Padding="20,26" IsVisible="{Binding !HasSelectedFiles}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                        <Border Width="52" Height="52" Background="#F0F9FF" BorderBrush="#BAE6FD" BorderThickness="1" CornerRadius="14" HorizontalAlignment="Center">
                            <materialIcons:MaterialIcon Kind="SelectRemove" Width="28" Height="28" Foreground="#0284C7" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Spacing="3" HorizontalAlignment="Center">
                            <TextBlock Text="Select PDF to Redact" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource WinTextBrush}" HorizontalAlignment="Center" TextAlignment="Center" />
                            <TextBlock Text="Permanently sanitize sensitive information" FontSize="11.5" Foreground="{DynamicResource WinMutedBrush}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Command="{Binding AddFilesCommand}" Background="#0284C7" Foreground="White" CornerRadius="8" Padding="18,9" FontSize="12.5" FontWeight="SemiBold" HorizontalAlignment="Center" Cursor="Hand">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <materialIcons:MaterialIcon Kind="FolderOpenOutline" Width="15" Height="15" />
                                <TextBlock Text="Select PDF Document" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Selected document + interaction hint -->
                <StackPanel Spacing="10" IsVisible="{Binding HasSelectedFiles}">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="{Binding PrimaryInputFile}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource WinTextBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <Button Grid.Column="1" Command="{Binding ClearFilesCommand}" Background="#F0F9FF" Foreground="#0284C7" BorderBrush="#BAE6FD" BorderThickness="1" CornerRadius="6" Padding="10,5" FontSize="11" FontWeight="SemiBold" Cursor="Hand">
                            Change File
                        </Button>
                    </Grid>
                    <TextBlock Text="Drag on the page to select text for redaction, like in the PDF Reader. Hold Alt while dragging to draw a box instead, for images or signatures. Ctrl/Cmd + scroll to zoom." FontSize="10.5" Foreground="{DynamicResource WinSubtleBrush}" TextWrapping="Wrap" />
                </StackPanel>

                <!-- Search & mark -->
                <StackPanel Spacing="6">
                    <TextBlock Text="Search text to find &amp; mark" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource WinMutedBrush}" />
                    <TextBox Text="{Binding SearchPattern}" FontSize="12" PlaceholderText="e.g. CONFIDENTIAL, SSN, Secret..." />
                    <Button Command="{Binding FindAndMarkCommand}" Background="#F0F9FF" Foreground="#0284C7" BorderBrush="#BAE6FD" BorderThickness="1" CornerRadius="8" Padding="12,8" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Cursor="Hand" IsEnabled="{Binding !IsSearching}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <materialIcons:MaterialIcon Kind="Magnify" Width="15" Height="15" />
                            <TextBlock Text="Find &amp; Mark Matches" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <TextBlock Text="{Binding SearchStatusMessage}" FontSize="10.5" Foreground="{DynamicResource WinMutedBrush}" TextWrapping="Wrap" IsVisible="{Binding HasSearchStatusMessage}" />
                </StackPanel>

                <CheckBox Content="Match Exact Case" IsChecked="{Binding CaseSensitive}" FontSize="12" />

                <!-- Marked for Redaction list -->
                <StackPanel Spacing="8">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock Text="Marked for Redaction" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource WinMutedBrush}" />
                            <Border Background="#F0F9FF" CornerRadius="10" Padding="7,1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Marks.Count}" FontSize="10.5" FontWeight="Bold" Foreground="#0284C7" />
                            </Border>
                        </StackPanel>
                        <Button Grid.Column="1" Command="{Binding ClearMarksCommand}" Background="Transparent" BorderThickness="0" Foreground="#EF4444" FontSize="11.5" Padding="4" Cursor="Hand" IsVisible="{Binding HasMarks}">
                            Clear All
                        </Button>
                    </Grid>

                    <TextBlock Text="Nothing marked yet — search above to find matches, review them here, then redact." FontSize="11" Foreground="{DynamicResource WinSubtleBrush}" TextWrapping="Wrap" IsVisible="{Binding !HasMarks}" />

                    <ItemsControl ItemsSource="{Binding Marks}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="models:RedactionMarkItem">
                                <Border Background="{DynamicResource WinInputBgBrush}" BorderBrush="{DynamicResource WinBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,6">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Grid.Column="0" Spacing="2">
                                            <TextBlock Text="{Binding Label}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource WinTextBrush}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding PageLabel}" FontSize="10.5" Foreground="{DynamicResource WinSubtleBrush}" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Command="{Binding $parent[UserControl].((vm:RedactPdfToolViewModel)DataContext).RemoveMarkCommand}" CommandParameter="{Binding}" Background="Transparent" BorderThickness="0" Padding="4" Cursor="Hand" ToolTip.Tip="Remove this mark">
                                            <materialIcons:MaterialIcon Kind="Close" Width="14" Height="14" Foreground="{DynamicResource WinSubtleBrush}" />
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <CheckBox Content="Permanent Deep Content Sanitization" IsChecked="{Binding PermanentScrubText}" FontSize="12" />

                <Border Background="#F0F9FF" BorderBrush="#BAE6FD" BorderThickness="1" CornerRadius="8" Padding="12" IsVisible="{Binding PermanentScrubText}">
                    <TextBlock Text="Marked pages are rendered to flattened images before saving, so the underlying text is genuinely removed — not just covered." FontSize="11" Foreground="#0369A1" TextWrapping="Wrap" />
                </Border>
                <Border Background="#FFFBEB" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="8" Padding="12" IsVisible="{Binding !PermanentScrubText}">
                    <TextBlock Text="Visual overlay only: a black box is drawn over each mark, but the underlying text stays in the PDF and can be recovered by removing the overlay." FontSize="11" Foreground="#92400E" TextWrapping="Wrap" />
                </Border>

            </StackPanel>
        </shell:PdfToolWorkspaceView.OptionsContent>

    </shell:PdfToolWorkspaceView>
</UserControl>
