<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PdfEditorApp.ViewModels.Tools"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="PdfEditorApp.Views.Tools.EditPdfToolView"
             x:DataType="vm:EditPdfToolViewModel">

    <Grid ColumnDefinitions="*,380" Margin="0,4,0,0">

        <!-- LEFT: File Workspace -->
        <ScrollViewer Grid.Column="0" Margin="0,0,20,0" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="16">

                <!-- Error Alert Banner -->
                <Border Background="#FEF2F2" BorderBrush="#FCA5A5" BorderThickness="1" CornerRadius="10" Padding="16,12" IsVisible="{Binding HasError}">
                    <Grid ColumnDefinitions="Auto,*">
                        <materialIcons:MaterialIcon Grid.Column="0" Kind="AlertCircleOutline" Width="22" Height="22" Foreground="#DC2626" Margin="0,0,12,0" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="Could Not Open Editor" FontSize="13" FontWeight="Bold" Foreground="#991B1B" />
                            <TextBlock Text="{Binding ErrorMessage}" FontSize="12" Foreground="#B91C1C" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Dropzone Box -->
                <Border Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="2" CornerRadius="12" Padding="36,44" IsVisible="{Binding !HasSelectedFiles}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
                        <Border Width="64" Height="64" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="16" HorizontalAlignment="Center">
                            <materialIcons:MaterialIcon Kind="SquareEditOutline" Width="34" Height="34" Foreground="#0F6CBD" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Spacing="4" HorizontalAlignment="Center">
                            <TextBlock Text="Select PDF to Open in Editor" FontSize="16" FontWeight="Bold" Foreground="#0F172A" HorizontalAlignment="Center" />
                            <TextBlock Text="Direct visual text editing, ink annotations, highlighting, stamp signatures, and page tools" FontSize="13" Foreground="#64748B" HorizontalAlignment="Center" />
                        </StackPanel>
                        <Button Command="{Binding AddFilesCommand}" Background="#0F6CBD" Foreground="White" CornerRadius="8" Padding="24,10" FontSize="13.5" FontWeight="SemiBold" HorizontalAlignment="Center" Cursor="Hand">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <materialIcons:MaterialIcon Kind="FolderOpenOutline" Width="16" Height="16" />
                                <TextBlock Text="Select PDF Document" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Loaded Documents -->
                <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="20" IsVisible="{Binding HasSelectedFiles}">
                    <StackPanel Spacing="12">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="Document Ready to Edit" FontSize="14" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center" />
                            <Button Command="{Binding AddFilesCommand}" Background="#EFF6FF" Foreground="#0F6CBD" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="6" Padding="12,6" FontSize="12" FontWeight="SemiBold" Cursor="Hand">
                                Change File
                            </Button>
                        </Grid>
                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14,12">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <Border Grid.Column="0" Width="36" Height="36" Background="#EFF6FF" CornerRadius="8" Margin="0,0,12,0">
                                    <materialIcons:MaterialIcon Kind="FilePdfBox" Width="20" Height="20" Foreground="#0F6CBD" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Grid.Column="1" Text="{Binding PrimaryInputFile}" FontSize="13" FontWeight="Medium" Foreground="#1E293B" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <Button Grid.Column="2" Command="{Binding ClearFilesCommand}" Background="Transparent" BorderThickness="0" Padding="6" Cursor="Hand">
                                    <materialIcons:MaterialIcon Kind="Close" Width="16" Height="16" Foreground="#94A3B8" />
                                </Button>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- RIGHT: Launch Options -->
        <Border Grid.Column="1" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="22" BoxShadow="0 4 12 #08000000">
            <DockPanel>
                <Border DockPanel.Dock="Top" Margin="0,0,0,16">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <materialIcons:MaterialIcon Kind="SquareEditOutline" Width="18" Height="18" Foreground="#0F6CBD" />
                        <TextBlock Text="Document Editor" FontSize="14" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <StackPanel DockPanel.Dock="Bottom" Margin="0,16,0,0" Spacing="10">
                    <Button Command="{Binding ExecuteToolCommand}" Background="#0F6CBD" Foreground="White" CornerRadius="10" Padding="24,14" FontWeight="Bold" FontSize="14" Cursor="Hand" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <materialIcons:MaterialIcon Kind="SquareEditOutline" Width="18" Height="18" />
                            <TextBlock Text="Open in PDF Editor" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="14">
                        <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="8" Padding="12">
                            <TextBlock Text="Opens document in the full-featured PDF editing studio with real-time text blocks, annotation drawing tools, forms, and pages manager." FontSize="11.5" Foreground="#1E40AF" TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

    </Grid>
</UserControl>
