<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PdfEditorApp.ViewModels"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="PdfEditorApp.Views.Dialogs.AboutDialog"
             x:DataType="vm:MainViewModel"
             Focusable="True">

    <!-- Fullscreen Backdrop -->
    <Grid Background="#70000000" PointerPressed="OnBackdropPointerPressed">
        <!-- Centered About Card -->
        <Border Width="720"
                Background="{DynamicResource WinPanelBrush}"
                BorderBrush="{DynamicResource WinBorderBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource M3ShapeCornerExtraLarge}"
                BoxShadow="0 28 80 #50000000"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Margin="20"
                ClipToBounds="True">

            <Grid RowDefinitions="Auto,*,Auto">

                <!-- 1. Header Banner with Brand Identity -->
                <Border Grid.Row="0"
                        Background="#0B1222"
                        Padding="24,20"
                        BorderBrush="#1E293B"
                        BorderThickness="0,0,0,1">
                    <Grid ColumnDefinitions="Auto,*,Auto">

                        <!-- Left: Glowing CodeFryDev Vector Logo Badge -->
                        <Border Grid.Column="0"
                                Width="60"
                                Height="60"
                                Background="#131E31"
                                BorderBrush="#38BDF8"
                                BorderThickness="1.5"
                                CornerRadius="14"
                                Margin="0,0,16,0"
                                BoxShadow="0 4 18 #3538BDF8"
                                VerticalAlignment="Center">
                            <!-- CodeFryDev SVG Vector Graphic -->
                            <Viewbox Width="38" Height="38" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Canvas Width="196" Height="196">
                                    <!-- Bowl / Pan Base -->
                                    <Path Fill="#38BDF8"
                                          Data="M50 126H145V133C145 157.853 124.853 178 100 178H95C70.1472 178 50 157.853 50 133V126Z" />
                                    <!-- Code Symbols & Letters -->
                                    <Path Fill="#F8FAFC"
                                          Data="M39.1328 112.539L51.3008 116.797V122.441L34.2305 115.352V111.27L39.1328 112.539ZM51.3008 109.082L39.1328 113.418L34.2305 114.648V110.547L51.3008 103.457V109.082ZM72.3359 115.469H78.6641C78.5599 117.422 78.026 119.147 77.0625 120.645C76.112 122.129 74.7904 123.294 73.0977 124.141C71.4049 124.974 69.3932 125.391 67.0625 125.391C65.2005 125.391 63.5339 125.072 62.0625 124.434C60.5911 123.796 59.3411 122.884 58.3125 121.699C57.2969 120.501 56.5156 119.062 55.9688 117.383C55.4349 115.69 55.168 113.783 55.168 111.66V109.922C55.168 107.799 55.4479 105.892 56.0078 104.199C56.5677 102.507 57.3685 101.061 58.4102 99.8633C59.4518 98.6654 60.7018 97.7474 62.1602 97.1094C63.6185 96.4714 65.2461 96.1523 67.043 96.1523C69.4648 96.1523 71.5091 96.5885 73.1758 97.4609C74.8424 98.3333 76.1315 99.5312 77.043 101.055C77.9674 102.578 78.5208 104.316 78.7031 106.27H72.3555C72.3034 105.163 72.0951 104.232 71.7305 103.477C71.3659 102.708 70.806 102.129 70.0508 101.738C69.2956 101.348 68.293 101.152 67.043 101.152C66.1315 101.152 65.3307 101.322 64.6406 101.66C63.9635 101.999 63.3971 102.526 62.9414 103.242C62.4987 103.958 62.1667 104.87 61.9453 105.977C61.724 107.07 61.6133 108.372 61.6133 109.883V111.66C61.6133 113.158 61.7109 114.453 61.9062 115.547C62.1016 116.641 62.4141 117.546 62.8438 118.262C63.2865 118.978 63.8529 119.512 64.543 119.863C65.2331 120.215 66.0729 120.391 67.0625 120.391C68.1953 120.391 69.1393 120.215 69.8945 119.863C70.6497 119.499 71.2292 118.952 71.6328 118.223C72.0365 117.493 72.2708 116.576 72.3359 115.469ZM88.5664 96.5625V125H82.1992V96.5625H88.5664ZM99.7578 108.555V113.477H86.7891V108.555H99.7578ZM101.008 96.5625V101.504H86.7891V96.5625H101.008ZM113.117 125H106.867L106.906 120.078H113.117C114.536 120.078 115.734 119.753 116.711 119.102C117.688 118.438 118.43 117.461 118.938 116.172C119.445 114.87 119.699 113.288 119.699 111.426V110.117C119.699 108.711 119.556 107.474 119.27 106.406C118.983 105.326 118.56 104.421 118 103.691C117.44 102.962 116.743 102.415 115.91 102.051C115.09 101.686 114.146 101.504 113.078 101.504H106.75V96.5625H113.078C115.005 96.5625 116.763 96.888 118.352 97.5391C119.953 98.1901 121.333 99.1211 122.492 100.332C123.664 101.543 124.569 102.975 125.207 104.629C125.845 106.283 126.164 108.125 126.164 110.156V111.426C126.164 113.444 125.845 115.286 125.207 116.953C124.569 118.607 123.664 120.039 122.492 121.25C121.333 122.448 119.96 123.372 118.371 124.023C116.783 124.674 115.031 125 113.117 125ZM110.48 96.5625V125H104.113V96.5625H110.48ZM141.789 96.5625L131.73 127.441H127.297L137.355 96.5625H141.789ZM156.594 113.32L144.406 109.082V103.457L161.516 110.547V114.668L156.594 113.32ZM144.406 116.855L156.613 112.5L161.516 111.27V115.371L144.406 122.461V116.855Z" />
                                    <!-- Steam / Flame Elements -->
                                    <Path Fill="#F59E0B"
                                          Data="M68.0627 60.6519C68.3821 54.8593 73.1743 46 73.1743 46C73.1743 46 71.2574 55.5407 71.5769 60.6519C71.8964 65.763 72.5354 65.0815 73.4938 68.8296C74.4522 72.5778 73.8133 74.2815 73.4938 77.0074C73.1743 79.7333 72.8549 80.0741 72.2159 83.4815C71.5769 86.8889 69.9795 92 69.9795 92C69.9795 92 70.299 84.3333 70.299 81.437C70.299 78.5407 70.6185 74.6222 69.6601 70.5333C68.7017 66.4444 67.7432 66.4444 68.0627 60.6519Z" />
                                    <Path Fill="#EF4444"
                                          Data="M99.9582 38.7481C99.7452 30.9407 96.5504 19 96.5504 19C96.5504 19 97.8284 31.8593 97.6154 38.7481C97.4024 45.637 96.9764 44.7185 96.3375 49.7704C95.6985 54.8222 96.1245 57.1185 96.3375 60.7926C96.5505 64.4667 96.7634 64.9259 97.1894 69.5185C97.6154 74.1111 98.6803 81 98.6803 81C98.6803 81 98.4673 70.6667 98.4673 66.763C98.4673 62.8593 98.2544 57.5778 98.8933 52.0667C99.5322 46.5556 100.171 46.5556 99.9582 38.7481Z" />
                                    <Path Fill="#F59E0B"
                                          Data="M118.042 64.7407C118.255 59.7037 121.45 52 121.45 52C121.45 52 120.172 60.2963 120.385 64.7407C120.598 69.1852 121.024 68.5926 121.663 71.8519C122.301 75.1111 121.876 76.5926 121.663 78.963C121.45 81.3333 121.237 81.6296 120.811 84.5926C120.385 87.5556 119.32 92 119.32 92C119.32 92 119.533 85.3333 119.533 82.8148C119.533 80.2963 119.746 76.8889 119.107 73.3333C118.468 69.7778 117.829 69.7778 118.042 64.7407Z" />
                                </Canvas>
                            </Viewbox>
                        </Border>

                        <!-- Center: App Title, Badges & Tagline -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <TextBlock Text="FryPDF"
                                           FontSize="22"
                                           FontWeight="Bold"
                                           Foreground="White" />
                                <Border Background="#1E293B" BorderBrush="#38BDF8" BorderThickness="1" CornerRadius="6" Padding="8,2">
                                    <TextBlock Text="{Binding AppVersionDisplay}" FontSize="11" FontWeight="SemiBold" Foreground="#38BDF8" />
                                </Border>
                                <Border Background="#062E1A" BorderBrush="#22C55E" BorderThickness="1" CornerRadius="6" Padding="8,2">
                                    <TextBlock Text="MIT License" FontSize="11" FontWeight="SemiBold" Foreground="#4ADE80" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Next-Gen Cross-Platform PDF Creator, Editor &amp; Executive Publishing Studio"
                                       FontSize="12"
                                       Foreground="#94A3B8" />
                            <TextBlock Text="Crafted with ❤️ by CodeFryDev • High-Performance Vector Graphics"
                                       FontSize="11"
                                       FontWeight="Medium"
                                       Foreground="#64748B" />
                        </StackPanel>

                        <!-- Right: Close Button -->
                        <Button Grid.Column="2"
                                Classes="action-pill-btn"
                                Width="32"
                                Height="32"
                                Padding="0"
                                Background="#1E293B"
                                BorderBrush="#334155"
                                Command="{Binding CloseAboutDialogCommand}"
                                ToolTip.Tip="Close (Esc)"
                                VerticalAlignment="Top">
                            <materialIcons:MaterialIcon Kind="Close" Width="16" Height="16" Foreground="#94A3B8" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Button>
                    </Grid>
                </Border>

                <!-- 2. Main Content Body -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,18">
                    <StackPanel Spacing="16">

                        <!-- SECTION A: COMPANY & SUPPORT CONTACT CARD -->
                        <Border Background="{DynamicResource WinInputBgBrush}"
                                BorderBrush="{DynamicResource WinBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="16">
                            <Grid ColumnDefinitions="*,*">

                                <!-- Support Contact Column -->
                                <StackPanel Grid.Column="0" Spacing="10" Margin="0,0,10,0">
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <Border Width="26" Height="26" Background="{DynamicResource WinAccentLightBrush}" BorderBrush="{DynamicResource WinAccentBorderBrush}" BorderThickness="1" CornerRadius="6">
                                            <materialIcons:MaterialIcon Kind="EmailOutline" Width="15" Height="15" Foreground="{DynamicResource WinAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Text="Support &amp; Community" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource WinTextBrush}" VerticalAlignment="Center" />
                                    </StackPanel>

                                    <TextBlock Text="Have a feature request, found a bug, or need enterprise support?"
                                               FontSize="11.5"
                                               Foreground="{DynamicResource WinMutedBrush}"
                                               TextWrapping="Wrap" />

                                    <!-- Email Card & Action -->
                                    <Border Background="{DynamicResource WinPanelBrush}" BorderBrush="{DynamicResource WinBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10,8">
                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                            <Border Grid.Column="0" Width="28" Height="28" Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="6" Margin="0,0,8,0" VerticalAlignment="Center">
                                                <materialIcons:MaterialIcon Kind="Gmail" Width="15" Height="15" Foreground="#DC2626" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,6,0">
                                                <TextBlock Text="codefrydev@gmail.com"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource WinTextBrush}" />
                                                <TextBlock Text="Direct developer support"
                                                           FontSize="9.5"
                                                           Foreground="{DynamicResource WinMutedBrush}" />
                                            </StackPanel>
                                            <Button Grid.Column="2"
                                                    Classes="action-pill-btn"
                                                    Command="{Binding CopySupportEmailCommand}"
                                                    ToolTip.Tip="Copy Email to Clipboard">
                                                <StackPanel Orientation="Horizontal" Spacing="5">
                                                    <materialIcons:MaterialIcon Kind="ContentCopy" Width="13" Height="13" Foreground="{DynamicResource WinAccentBrush}" />
                                                    <TextBlock Text="Copy" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource WinAccentBrush}" />
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                    </Border>

                                    <!-- GitHub Repository Card & Action -->
                                    <Border Background="{DynamicResource WinPanelBrush}" BorderBrush="{DynamicResource WinBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10,8">
                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                            <Border Grid.Column="0" Width="28" Height="28" Background="{DynamicResource WinHoverBrush}" BorderBrush="{DynamicResource WinBorderBrush}" BorderThickness="1" CornerRadius="6" Margin="0,0,8,0" VerticalAlignment="Center">
                                                <materialIcons:MaterialIcon Kind="Github" Width="16" Height="16" Foreground="{DynamicResource WinTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,6,0">
                                                <TextBlock Text="github.com/codefrydev"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource WinTextBrush}" />
                                                <TextBlock Text="Source code &amp; contributions"
                                                           FontSize="9.5"
                                                           Foreground="{DynamicResource WinMutedBrush}" />
                                            </StackPanel>
                                            <Button Grid.Column="2"
                                                    Classes="action-pill-btn"
                                                    Command="{Binding OpenGitHubCommand}"
                                                    ToolTip.Tip="Open GitHub Repository &amp; Profile">
                                                <StackPanel Orientation="Horizontal" Spacing="5">
                                                    <materialIcons:MaterialIcon Kind="OpenInNew" Width="13" Height="13" Foreground="{DynamicResource WinAccentBrush}" />
                                                    <TextBlock Text="Star ↗" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource WinAccentBrush}" />
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </StackPanel>

                                <!-- Company & Ecosystem Column -->
                                <StackPanel Grid.Column="1" Spacing="10" Margin="10,0,0,0">
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <Border Width="26" Height="26" Background="#FEF3C7" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="6">
                                            <materialIcons:MaterialIcon Kind="Web" Width="15" Height="15" Foreground="#D97706" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Text="Official Ecosystem" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource WinTextBrush}" VerticalAlignment="Center" />
                                    </StackPanel>

                                    <TextBlock Text="Visit CodeFryDev for open-source projects, developer tools, and updates."
                                               FontSize="11.5"
                                               Foreground="{DynamicResource WinMutedBrush}"
                                               TextWrapping="Wrap" />

                                    <!-- Website Link Card & Action -->
                                    <Border Background="{DynamicResource WinPanelBrush}" BorderBrush="{DynamicResource WinBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10,8">
                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                            <Border Grid.Column="0" Width="28" Height="28" Background="#E0F2FE" BorderBrush="#BAE6FD" BorderThickness="1" CornerRadius="6" Margin="0,0,8,0" VerticalAlignment="Center">
                                                <materialIcons:MaterialIcon Kind="Web" Width="15" Height="15" Foreground="#0284C7" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,6,0">
                                                <TextBlock Text="codefrydev.in"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource WinTextBrush}" />
                                                <TextBlock Text="Developer portal &amp; updates"
                                                           FontSize="9.5"
                                                           Foreground="{DynamicResource WinMutedBrush}" />
                                            </StackPanel>
                                            <Button Grid.Column="2"
                                                    Classes="action-pill-btn"
                                                    Command="{Binding OpenCompanyWebsiteCommand}"
                                                    ToolTip.Tip="Open Official Website">
                                                <StackPanel Orientation="Horizontal" Spacing="5">
                                                    <materialIcons:MaterialIcon Kind="OpenInNew" Width="13" Height="13" Foreground="#0284C7" />
                                                    <TextBlock Text="Visit ↗" FontSize="11" FontWeight="SemiBold" Foreground="#0284C7" />
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                    </Border>

                                    <!-- Microsoft Store Link Card & Action -->
                                    <Border Background="{DynamicResource WinPanelBrush}" BorderBrush="{DynamicResource WinBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10,8">
                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                            <Border Grid.Column="0" Width="28" Height="28" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="6" Margin="0,0,8,0" VerticalAlignment="Center">
                                                <materialIcons:MaterialIcon Kind="Microsoft" Width="15" Height="15" Foreground="#0078D4" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,6,0">
                                                <TextBlock Text="Microsoft Store" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource WinTextBrush}" />
                                                <TextBlock Text="ID: 9P5GW2Q81B33" FontSize="9.5" Foreground="{DynamicResource WinMutedBrush}" />
                                            </StackPanel>
                                            <Button Grid.Column="2"
                                                    Classes="action-pill-btn"
                                                    Command="{Binding OpenMicrosoftStoreCommand}"
                                                    ToolTip.Tip="Open in Microsoft Store (9P5GW2Q81B33)">
                                                <StackPanel Orientation="Horizontal" Spacing="5">
                                                    <materialIcons:MaterialIcon Kind="OpenInNew" Width="13" Height="13" Foreground="#0078D4" />
                                                    <TextBlock Text="Store ↗" FontSize="11" FontWeight="SemiBold" Foreground="#0078D4" />
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- SECTION B: ARCHITECTURE & CORE TECHNOLOGIES -->
                        <StackPanel Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <materialIcons:MaterialIcon Kind="CodeTags" Width="14" Height="14" Foreground="{DynamicResource WinMutedBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="POWERED BY OPEN-SOURCE INNOVATION"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource WinMutedBrush}"
                                           LetterSpacing="0.5" />
                            </StackPanel>

                            <Grid ColumnDefinitions="*,*,*,*" Margin="0,2,0,0">
                                <!-- Tech 1: Avalonia UI -->
                                <Border Grid.Column="0" Background="{DynamicResource WinInputBgBrush}" BorderBrush="{DynamicResource WinBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10,10" Margin="0,0,4,0">
                                    <StackPanel Spacing="3" HorizontalAlignment="Center">
                                        <materialIcons:MaterialIcon Kind="ApplicationOutline" Width="20" Height="20" Foreground="#6366F1" HorizontalAlignment="Center" />
                                        <TextBlock Text="Avalonia UI 12" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource WinTextBrush}" HorizontalAlignment="Center" />
                                        <TextBlock Text="Cross-Platform UI" FontSize="9.5" Foreground="{DynamicResource WinMutedBrush}" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Border>

                                <!-- Tech 2: QuestPDF -->
                                <Border Grid.Column="1" Background="{DynamicResource WinInputBgBrush}" BorderBrush="{DynamicResource WinBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10,10" Margin="4,0,4,0">
                                    <StackPanel Spacing="3" HorizontalAlignment="Center">
                                        <materialIcons:MaterialIcon Kind="FilePdfBox" Width="20" Height="20" Foreground="#DC2626" HorizontalAlignment="Center" />
                                        <TextBlock Text="QuestPDF 2026" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource WinTextBrush}" HorizontalAlignment="Center" />
                                        <TextBlock Text="Vector PDF Engine" FontSize="9.5" Foreground="{DynamicResource WinMutedBrush}" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Border>

                                <!-- Tech 3: SkiaSharp -->
                                <Border Grid.Column="2" Background="{DynamicResource WinInputBgBrush}" BorderBrush="{DynamicResource WinBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10,10" Margin="4,0,4,0">
                                    <StackPanel Spacing="3" HorizontalAlignment="Center">
                                        <materialIcons:MaterialIcon Kind="VectorCircle" Width="20" Height="20" Foreground="#0EA5E9" HorizontalAlignment="Center" />
                                        <TextBlock Text="Skia 2D Canvas" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource WinTextBrush}" HorizontalAlignment="Center" />
                                        <TextBlock Text="Sub-pixel Precision" FontSize="9.5" Foreground="{DynamicResource WinMutedBrush}" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Border>

                                <!-- Tech 4: .NET 10 -->
                                <Border Grid.Column="3" Background="{DynamicResource WinInputBgBrush}" BorderBrush="{DynamicResource WinBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10,10" Margin="4,0,0,0">
                                    <StackPanel Spacing="3" HorizontalAlignment="Center">
                                        <materialIcons:MaterialIcon Kind="Microsoft" Width="20" Height="20" Foreground="#8B5CF6" HorizontalAlignment="Center" />
                                        <TextBlock Text=".NET 10.0" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource WinTextBrush}" HorizontalAlignment="Center" />
                                        <TextBlock Text="Modern Runtime" FontSize="9.5" Foreground="{DynamicResource WinMutedBrush}" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>

                        <!-- SECTION C: OPEN SOURCE MISSION & LICENSES LINK -->
                        <Border Background="{DynamicResource WinSuccessLightBrush}"
                                BorderBrush="{DynamicResource WinSuccessBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="14,10">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <materialIcons:MaterialIcon Grid.Column="0" Kind="HeartOutline" Width="18" Height="18" Foreground="{DynamicResource WinSuccessBrush}" Margin="0,0,10,0" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" Margin="0,0,12,0">
                                    <TextBlock Text="FryPDF is 100% Free and Open-Source Software under the MIT License."
                                               FontSize="11.5"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource WinSuccessBrush}" />
                                    <TextBlock Text="Zero telemetry, zero user tracking, and zero remote data collection. Offline &amp; private."
                                               FontSize="10"
                                               Foreground="{DynamicResource WinSuccessBrush}"
                                               Opacity="0.85" />
                                </StackPanel>
                                <Button Grid.Column="2"
                                        Classes="success-pill-btn"
                                        Command="{Binding NavigateToLicensingCommand}"
                                        ToolTip.Tip="View full list of 20 open-source libraries, packages, and full license texts">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <materialIcons:MaterialIcon Kind="CertificateOutline" Width="14" Height="14" Foreground="{DynamicResource WinSuccessBrush}" />
                                        <TextBlock Text="View 20 Licenses &amp; Tools →" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource WinSuccessBrush}" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>

                    </StackPanel>
                </ScrollViewer>

                <!-- 3. Footer Actions Bar -->
                <Border Grid.Row="2"
                        Background="{DynamicResource WinInputBgBrush}"
                        BorderBrush="{DynamicResource WinBorderBrush}"
                        BorderThickness="0,1,0,0"
                        Padding="20,12">
                    <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto">

                        <!-- System Diagnostics Copy Button -->
                        <Button Grid.Column="0"
                                Classes="secondary-btn"
                                Height="32"
                                Padding="12,0"
                                Command="{Binding CopyDiagnosticsCommand}"
                                ToolTip.Tip="Copy OS, Runtime &amp; App Diagnostics for Bug Reports">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <materialIcons:MaterialIcon Kind="InformationOutline" Width="15" Height="15" Foreground="{DynamicResource WinMutedBrush}" />
                                <TextBlock Text="Copy Diagnostics" FontSize="11.5" FontWeight="Medium" />
                            </StackPanel>
                        </Button>

                        <!-- Shortcuts Button -->
                        <Button Grid.Column="1"
                                Classes="secondary-btn"
                                Height="32"
                                Padding="12,0"
                                Margin="8,0,0,0"
                                Command="{Binding OpenShortcutsHelpCommand}"
                                ToolTip.Tip="Open Keyboard Shortcuts Reference (F1)">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <materialIcons:MaterialIcon Kind="KeyboardOutline" Width="15" Height="15" Foreground="{DynamicResource WinAccentBrush}" />
                                <TextBlock Text="Shortcuts (F1)" FontSize="11.5" FontWeight="Medium" />
                            </StackPanel>
                        </Button>

                        <!-- Help Guides Page Button -->
                        <Button Grid.Column="3"
                                Classes="secondary-btn"
                                Height="32"
                                Padding="12,0"
                                Margin="0,0,10,0"
                                Command="{Binding NavigateToHelpCommand}"
                                ToolTip.Tip="Open dedicated Help &amp; User Guides page for all 32 tools">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <materialIcons:MaterialIcon Kind="HelpCircleOutline" Width="15" Height="15" Foreground="#0284C7" />
                                <TextBlock Text="Help &amp; Guides" FontSize="11.5" FontWeight="Medium" />
                            </StackPanel>
                        </Button>

                        <!-- Primary Close Button -->
                        <Button Grid.Column="4"
                                Classes="accent-btn"
                                Height="32"
                                Width="96"
                                Command="{Binding CloseAboutDialogCommand}"
                                ToolTip.Tip="Close Dialog (Esc)">
                            <TextBlock Text="Close" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        </Button>
                    </Grid>
                </Border>

            </Grid>
        </Border>
    </Grid>

</UserControl>
