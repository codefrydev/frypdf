<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PdfEditorApp.ViewModels"
             xmlns:views="using:PdfEditorApp.Views"
             xmlns:converters="using:PdfEditorApp.Converters"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="PdfEditorApp.Views.HomeView"
             x:DataType="vm:HomeViewModel"
             Background="{DynamicResource WinBgBrush}">

    <UserControl.Resources>
        <converters:EqualityToBooleanConverter x:Key="EqualityConverter" />
        <converters:BooleanToStringConverter x:Key="BooleanToStringConverter" />
        <converters:NullToBooleanConverter x:Key="NullToBooleanConverter" />
    </UserControl.Resources>


    <UserControl.Styles>
        <!-- Nav Tab Button Style (M3 Expressive Navigation Rail Pill) -->
        <Style Selector="Button.nav-tab-btn">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource WinMutedBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="{StaticResource M3ShapeCornerFull}" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15" />
                    <BrushTransition Property="Foreground" Duration="0:0:0.15" />
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.nav-tab-btn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource WinHoverBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource WinTextBrush}" />
        </Style>
        <Style Selector="Button.nav-tab-btn:pointerover">
            <Setter Property="RenderTransform" Value="scale(1.01)" />
        </Style>
        <Style Selector="Button.nav-tab-btn.active /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource M3SecondaryContainerBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource M3OnSecondaryContainerBrush}" />
        </Style>
        <Style Selector="Button.nav-tab-btn.active">
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </UserControl.Styles>

    <Grid ColumnDefinitions="Auto,*">

        <!-- ===== LEFT SIDEBAR =====
             Hidden while a tool is open so the tool's own workspace (toolbar + its
             Options/Files/Pages/Info sidebar) gets the full window, matching the PDF
             Reader's full-width treatment instead of squeezing it in next to this nav. -->
        <Border Grid.Column="0"
                Width="230"
                IsVisible="{Binding !IsToolPageActive}"
                Background="{DynamicResource WinPanelBrush}"
                BorderBrush="{DynamicResource WinBorderBrush}"
                BorderThickness="0,0,1,0">
            <DockPanel>

                <!-- Logo / Brand -->
                <Border DockPanel.Dock="Top"
                        Padding="20,20,20,16"
                        BorderBrush="{DynamicResource WinBorderSubtleBrush}"
                        BorderThickness="0,0,0,1">
                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <Border Width="36" Height="36"
                                Background="#FFFFFF"
                                BorderBrush="#CBD5E1"
                                BorderThickness="1"
                                CornerRadius="{StaticResource M3ShapeCornerFull}"
                                BoxShadow="0 2 8 #150D2B45"
                                ClipToBounds="True">
                            <Viewbox Width="26" Height="26" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Canvas Width="5064" Height="5064">
                                    <Path Fill="#0D2B45" Data="M2474 751C2532.5 786.5 2609.5 835.5 2682.5 859.5C2768.74 897.828 2854.61 905.811 2884 925.5C2935.5 960 2964.5 1038.74 3038 1085C3111.5 1131.26 3226 1156 3267 1156.5C3308 1157 3322.5 1124 3356 1128C3389.5 1132 3422.5 1199.5 3431 1251C3439.5 1302.5 3449.5 1442 3417.5 1450.5C3385.5 1459 3252 1403 3164 1391.5C3076 1380 2823 1391.5 2823 1391.5C2823 1391.5 2973 1587.5 3068.5 1626C3164 1664.5 3244.5 1651.5 3257.5 1664.5C3270.5 1677.5 3226.5 1772 3164 1813.5C3101.5 1855 3011 1874.5 2995.5 1864.5C2980 1854.5 2903 1640.5 2742 1630.5C2581 1620.5 2531 1626 2481.5 1607C2432 1588 2370.5 1526 2345.5 1479.5C2320.5 1433 2325 1310 2287.5 1311C2250 1312 1948 1522.5 1927.5 1743C1907 1963.5 1943 2117.5 1968 2220.5C1993 2323.5 2133 2584 2133 2584C2133 2584 1945.5 2439.5 1887 2353C1828.5 2266.5 1747.5 2037 1747.5 2037L1645 2220.5C1645 2220.5 1619 2037 1619 1916C1619 1795 1667 1626 1667 1626C1667 1626 1633 1639 1589.5 1662C1546 1685 1493 1736.5 1493 1736.5C1493 1736.5 1547.5 1549 1615 1457C1682.5 1365 1855.5 1222.5 1855.5 1222.5C1855.5 1222.5 1751.5 1217 1717.5 1215C1683.5 1213 1575 1222.5 1575 1222.5C1575 1222.5 1727.5 1086 1832.5 1045C1937.5 1004 2133 973 2133 973C2133 973 1961 878 1832.5 753C1704 628 1667 353 1667 353C1667 353 1824.5 563.337 1958.5 664C2092.5 764.663 2290.5 822.5 2290.5 822.5C2290.5 822.5 2245.5 757 2203 650C2160.5 543 2158.5 411.5 2158.5 411.5C2158.5 411.5 2415.5 715.5 2474 751Z" />
                                    <Path Fill="#1A3D5C" Data="M2291.5 1633C2291.5 1633 2268.5 1913.5 2645.5 2143C3022.5 2372.5 3176.5 2469.5 3337 2716C3497.5 2962.5 3276.5 3592.5 3276.5 3592.5C3276.5 3592.5 3305 3376 3276.5 3111C3248 2846 3028 2641.5 2916 2545C2804 2448.5 2527 2287.5 2437.5 2205.5C2348 2123.5 2273.5 2027.5 2263.5 1917.5C2253.5 1807.5 2291.5 1633 2291.5 1633Z" />
                                    <Path Fill="#EE4B32" Data="M3923.5 1249.38C4041 1220.88 4226 1235.38 4240.5 1249.38C4255 1263.38 4188.34 1286.7 4122 1325.38C4063.62 1359.41 4013 1386.88 4013 1386.88C4013 1386.88 4199.5 1427.38 4269 1449.38C4338.5 1471.38 4440 1518.88 4550.5 1515.88C4661 1512.88 4833 1449.38 4833 1449.38C4833 1449.38 4741 1566.38 4601.5 1702.88C4462 1839.38 4132.5 1807.38 4132.5 1807.38C4132.5 1807.38 4177.5 1873.38 4218.5 1895.38C4259.5 1917.38 4338.5 1940.38 4338.5 1940.38C4338.5 1940.38 4153 2032.38 3987 2032.38C3821 2032.38 3695.5 1889.38 3603 1815.38C3510.5 1741.38 3227 1608.38 3227 1586.38C3227 1564.38 3453 1589.54 3597 1515.88C3741 1442.22 3806 1277.88 3923.5 1249.38Z" />
                                    <Path Fill="#0D2B45" Data="M4213 2989C4213 3215.14 4168.46 3439.06 4081.92 3647.98C3995.38 3856.9 3868.54 4046.74 3708.64 4206.64C3548.74 4366.54 3358.9 4493.38 3149.98 4579.92C2941.06 4666.46 2717.14 4711 2491 4711C2264.86 4711 2040.94 4666.46 1832.02 4579.92C1623.1 4493.38 1433.26 4366.54 1273.36 4206.64C1113.46 4046.74 986.618 3856.9 900.079 3647.98C813.541 3439.06 769 3215.14 769 2989H1299C1299 3142.65 1329.25 3294.79 1388.02 3436.74C1446.8 3578.69 1532.94 3707.67 1641.54 3816.31C1750.14 3924.96 1879.06 4011.14 2020.95 4069.94C2162.84 4128.74 2314.92 4159 2468.5 4159C2622.08 4159 2774.16 4128.74 2916.05 4069.94C3057.94 4011.14 3186.86 3924.96 3295.46 3816.32C3404.06 3707.67 3490.2 3578.69 3548.98 3436.74C3607.75 3294.79 3638 3142.65 3638 2989H4213Z" />
                                    <Path Fill="#7CA2C2" Data="M2654.5 1023.5C2654.5 1023.5 2753.5 1021 2810 1033C2866.5 1045 2920 1126 2920 1126C2920 1126 2872 1139 2847 1140C2822 1141 2757.5 1132.5 2718.5 1111.5C2679.5 1090.5 2654.5 1023.5 2654.5 1023.5Z" />
                                </Canvas>
                            </Viewbox>
                        </Border>
                        <StackPanel VerticalAlignment="Center" Spacing="1">
                            <TextBlock Text="FryPDF"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource WinTextBrush}" />
                            <TextBlock Text="by CodeFryDev"
                                       FontSize="10"
                                       Foreground="{DynamicResource WinSubtleBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <ScrollViewer DockPanel.Dock="Top" Margin="10,12,10,0" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="2">

                        <!-- ===== PLUGIN-DRIVEN NAVIGATION SIDEBAR =====
                             All groups and items are registered by WorkspacePagesBundle (and 3rd-party bundles)
                             via INavigationRegistry. No hardcoded buttons below. -->
                        <ItemsControl ItemsSource="{Binding NavGroups}" IsVisible="{Binding IsPluginDrivenNavigation}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:NavGroupViewModel">
                                    <StackPanel Spacing="1">
                                        <!-- Group Header -->
                                        <TextBlock Text="{Binding Header}"
                                                   FontSize="10"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource WinSubtleBrush}"
                                                   Margin="8,10,0,4" />

                                        <!-- Nav Items -->
                                        <ItemsControl ItemsSource="{Binding Items}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:NavigationItemViewModel">
                                                    <Button Classes="nav-tab-btn"
                                                            Classes.active="{Binding IsActive}"
                                                            Command="{Binding $parent[views:HomeView].((vm:HomeViewModel)DataContext).SelectNavSectionCommand}"
                                                            CommandParameter="{Binding Id}">
                                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                                            <materialIcons:MaterialIcon Grid.Column="0"
                                                                                       Kind="{Binding IconKind}"
                                                                                       Width="18" Height="18"
                                                                                       Foreground="{DynamicResource WinAccentBrush}"
                                                                                       Margin="0,0,10,0"
                                                                                       VerticalAlignment="Center" />
                                                            <TextBlock Grid.Column="1"
                                                                       Text="{Binding Title}"
                                                                       VerticalAlignment="Center" />
                                                            <Border Grid.Column="2"
                                                                    Background="{DynamicResource WinHoverBrush}"
                                                                    CornerRadius="{StaticResource M3ShapeCornerExtraSmall}"
                                                                    Padding="5,1"
                                                                    IsVisible="{Binding BadgeText, Converter={StaticResource NullToBooleanConverter}}">
                                                                <TextBlock Text="{Binding BadgeText}"
                                                                           FontSize="9.5"
                                                                           FontWeight="Bold"
                                                                           Foreground="{DynamicResource WinAccentBrush}" />
                                                            </Border>
                                                        </Grid>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- ===== LEGACY STATIC NAV (fallback when plugin registry is unavailable) =====
                             Rendered only when IsPluginDrivenNavigation=false (e.g., headless/test mode). -->
                        <StackPanel Spacing="3" IsVisible="{Binding !IsPluginDrivenNavigation}">

                            <!-- Main Sections Header -->
                            <TextBlock Text="OVERVIEW" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource WinSubtleBrush}" Margin="8,4,0,4" />

                            <!-- 1. Home -->
                            <Button Classes="nav-tab-btn"
                                    Classes.active="{Binding SelectedNavSection, Converter={StaticResource EqualityConverter}, ConverterParameter=Home}"
                                    Command="{Binding SelectNavSectionCommand}"
                                    CommandParameter="Home">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <materialIcons:MaterialIcon Grid.Column="0" Kind="HomeOutline" Width="18" Height="18" Foreground="#0F6CBD" Margin="0,0,10,0" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="Home" VerticalAlignment="Center" />
                                </Grid>
                            </Button>

                            <!-- 2. PDF Reader Mode -->
                            <Button Classes="nav-tab-btn"
                                    Classes.active="{Binding SelectedNavSection, Converter={StaticResource EqualityConverter}, ConverterParameter=PdfReader}"
                                    Command="{Binding SelectNavSectionCommand}"
                                    CommandParameter="PdfReader">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <materialIcons:MaterialIcon Grid.Column="0" Kind="BookOpenPageVariantOutline" Width="18" Height="18" Foreground="#DC2626" Margin="0,0,10,0" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="PDF Reader" VerticalAlignment="Center" />
                                    <Border Grid.Column="2" Background="#FEE2E2" CornerRadius="4" Padding="5,1">
                                        <TextBlock Text="Read" FontSize="10" FontWeight="Bold" Foreground="#DC2626" />
                                    </Border>
                                </Grid>
                            </Button>

                            <!-- 3. New Document -->
                            <Button Classes="nav-tab-btn"
                                    Classes.active="{Binding SelectedNavSection, Converter={StaticResource EqualityConverter}, ConverterParameter=NewDocument}"
                                    Command="{Binding SelectNavSectionCommand}"
                                    CommandParameter="NewDocument">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <materialIcons:MaterialIcon Grid.Column="0" Kind="FileDocumentPlusOutline" Width="18" Height="18" Foreground="#10B981" Margin="0,0,10,0" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="New Document" VerticalAlignment="Center" />
                                    <Border Grid.Column="2" Background="#ECFDF5" CornerRadius="4" Padding="5,1">
                                        <TextBlock Text="19" FontSize="10" FontWeight="Bold" Foreground="#059669" />
                                    </Border>
                                </Grid>
                            </Button>

                            <!-- 4. All Tools -->
                            <Button Classes="nav-tab-btn"
                                    Classes.active="{Binding SelectedNavSection, Converter={StaticResource EqualityConverter}, ConverterParameter=AllTools}"
                                    Command="{Binding SelectNavSectionCommand}"
                                    CommandParameter="AllTools">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <materialIcons:MaterialIcon Grid.Column="0" Kind="ViewGridOutline" Width="18" Height="18" Foreground="#6366F1" Margin="0,0,10,0" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="All Tools" VerticalAlignment="Center" />
                                    <Border Grid.Column="2" Background="#EEF2FF" CornerRadius="4" Padding="5,1">
                                        <TextBlock Text="32" FontSize="10" FontWeight="Bold" Foreground="#4F46E5" />
                                    </Border>
                                </Grid>
                            </Button>

                            <!-- Tool Categories Header -->
                            <TextBlock Text="CATEGORIES" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource WinSubtleBrush}" Margin="8,12,0,4" />

                            <!-- 5. Organize & Page -->
                            <Button Classes="nav-tab-btn"
                                    Classes.active="{Binding SelectedNavSection, Converter={StaticResource EqualityConverter}, ConverterParameter=OrganizeAndPage}"
                                    Command="{Binding SelectNavSectionCommand}"
                                    CommandParameter="OrganizeAndPage">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <materialIcons:MaterialIcon Grid.Column="0" Kind="BookOpenPageVariantOutline" Width="18" Height="18" Foreground="#0284C7" Margin="0,0,10,0" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="Organize &amp; Page" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="6" FontSize="10.5" Foreground="{DynamicResource WinSubtleBrush}" VerticalAlignment="Center" />
                                </Grid>
                            </Button>

                            <!-- 6. Security & Optimize -->
                            <Button Classes="nav-tab-btn"
                                    Classes.active="{Binding SelectedNavSection, Converter={StaticResource EqualityConverter}, ConverterParameter=OptimizeAndSecurity}"
                                    Command="{Binding SelectNavSectionCommand}"
                                    CommandParameter="OptimizeAndSecurity">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <materialIcons:MaterialIcon Grid.Column="0" Kind="ShieldLockOutline" Width="18" Height="18" Foreground="#10B981" Margin="0,0,10,0" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="Security &amp; Optimize" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="7" FontSize="10.5" Foreground="{DynamicResource WinSubtleBrush}" VerticalAlignment="Center" />
                                </Grid>
                            </Button>

                            <!-- 7. Convert from PDF -->
                            <Button Classes="nav-tab-btn"
                                    Classes.active="{Binding SelectedNavSection, Converter={StaticResource EqualityConverter}, ConverterParameter=ConvertFromPdf}"
                                    Command="{Binding SelectNavSectionCommand}"
                                    CommandParameter="ConvertFromPdf">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <materialIcons:MaterialIcon Grid.Column="0" Kind="ExportVariant" Width="18" Height="18" Foreground="#6366F1" Margin="0,0,10,0" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="Convert from PDF" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="5" FontSize="10.5" Foreground="{DynamicResource WinSubtleBrush}" VerticalAlignment="Center" />
                                </Grid>
                            </Button>

                            <!-- 8. Convert to PDF -->
                            <Button Classes="nav-tab-btn"
                                    Classes.active="{Binding SelectedNavSection, Converter={StaticResource EqualityConverter}, ConverterParameter=ConvertToPdf}"
                                    Command="{Binding SelectNavSectionCommand}"
                                    CommandParameter="ConvertToPdf">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <materialIcons:MaterialIcon Grid.Column="0" Kind="Import" Width="18" Height="18" Foreground="#8B5CF6" Margin="0,0,10,0" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="Convert to PDF" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="6" FontSize="10.5" Foreground="{DynamicResource WinSubtleBrush}" VerticalAlignment="Center" />
                                </Grid>
                            </Button>

                            <!-- 9. Edit & Forms -->
                            <Button Classes="nav-tab-btn"
                                    Classes.active="{Binding SelectedNavSection, Converter={StaticResource EqualityConverter}, ConverterParameter=EditAndForms}"
                                    Command="{Binding SelectNavSectionCommand}"
                                    CommandParameter="EditAndForms">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <materialIcons:MaterialIcon Grid.Column="0" Kind="Draw" Width="18" Height="18" Foreground="#F59E0B" Margin="0,0,10,0" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="Edit &amp; Forms" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="4" FontSize="10.5" Foreground="{DynamicResource WinSubtleBrush}" VerticalAlignment="Center" />
                                </Grid>
                            </Button>

                            <!-- 10. AI & Automation -->
                            <Button Classes="nav-tab-btn"
                                    Classes.active="{Binding SelectedNavSection, Converter={StaticResource EqualityConverter}, ConverterParameter=AiAndAutomation}"
                                    Command="{Binding SelectNavSectionCommand}"
                                    CommandParameter="AiAndAutomation">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <materialIcons:MaterialIcon Grid.Column="0" Kind="AutoFix" Width="18" Height="18" Foreground="#EC4899" Margin="0,0,10,0" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="AI &amp; Automation" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="4" FontSize="10.5" Foreground="{DynamicResource WinSubtleBrush}" VerticalAlignment="Center" />
                                </Grid>
                            </Button>

                            <!-- Collections Header -->
                            <TextBlock Text="LIBRARY" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource WinSubtleBrush}" Margin="8,12,0,4" />

                            <!-- 11. Starred Tools -->
                            <Button Classes="nav-tab-btn"
                                    Classes.active="{Binding SelectedNavSection, Converter={StaticResource EqualityConverter}, ConverterParameter=Starred}"
                                    Command="{Binding SelectNavSectionCommand}"
                                    CommandParameter="Starred">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <materialIcons:MaterialIcon Grid.Column="0" Kind="StarOutline" Width="18" Height="18" Foreground="#EAB308" Margin="0,0,10,0" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="Starred Tools" VerticalAlignment="Center" />
                                    <Border Grid.Column="2" Background="#FEF08A" CornerRadius="4" Padding="5,1" IsVisible="{Binding StarredTools.Count}">
                                        <TextBlock Text="{Binding StarredTools.Count}" FontSize="9.5" FontWeight="Bold" Foreground="#854D0E" />
                                    </Border>
                                </Grid>
                            </Button>

                            <!-- 12. Language & Fonts -->
                            <Button Classes="nav-tab-btn"
                                    Classes.active="{Binding SelectedNavSection, Converter={StaticResource EqualityConverter}, ConverterParameter=FontPackages}"
                                    Command="{Binding SelectNavSectionCommand}"
                                    CommandParameter="FontPackages">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <materialIcons:MaterialIcon Grid.Column="0" Kind="Translate" Width="18" Height="18" Foreground="#0284C7" Margin="0,0,10,0" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="Language &amp; Fonts" VerticalAlignment="Center" />
                                    <Border Grid.Column="2" Background="#E0F2FE" CornerRadius="4" Padding="5,1">
                                        <TextBlock Text="10" FontSize="9.5" FontWeight="Bold" Foreground="#0284C7" />
                                    </Border>
                                </Grid>
                            </Button>

                            <!-- 13. Tesseract OCR Models -->
                            <Button Classes="nav-tab-btn"
                                    Classes.active="{Binding SelectedNavSection, Converter={StaticResource EqualityConverter}, ConverterParameter=TesseractData}"
                                    Command="{Binding SelectNavSectionCommand}"
                                    CommandParameter="TesseractData">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <materialIcons:MaterialIcon Grid.Column="0" Kind="TextRecognition" Width="18" Height="18" Foreground="#10B981" Margin="0,0,10,0" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="OCR Models" VerticalAlignment="Center" />
                                    <Border Grid.Column="2" Background="#DCFCE7" CornerRadius="4" Padding="5,1">
                                        <TextBlock Text="{Binding TesseractManager.InstalledCount}" FontSize="9.5" FontWeight="Bold" Foreground="#15803D" />
                                    </Border>
                                </Grid>
                            </Button>

                            <!-- 14. Trash / Temp Cleaner -->
                            <Button Classes="nav-tab-btn"
                                    Classes.active="{Binding SelectedNavSection, Converter={StaticResource EqualityConverter}, ConverterParameter=Trash}"
                                    Command="{Binding SelectNavSectionCommand}"
                                    CommandParameter="Trash">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <materialIcons:MaterialIcon Grid.Column="0" Kind="TrashCanOutline" Width="18" Height="18" Foreground="{DynamicResource WinMutedBrush}" Margin="0,0,10,0" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="Trash &amp; Cache" VerticalAlignment="Center" />
                                </Grid>
                            </Button>

                            <!-- 15. Help & User Guides -->
                            <Button Classes="nav-tab-btn"
                                    Classes.active="{Binding SelectedNavSection, Converter={StaticResource EqualityConverter}, ConverterParameter=Help}"
                                    Command="{Binding SelectNavSectionCommand}"
                                    CommandParameter="Help">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <materialIcons:MaterialIcon Grid.Column="0" Kind="HelpCircleOutline" Width="18" Height="18" Foreground="#0284C7" Margin="0,0,10,0" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="Help &amp; Guides" VerticalAlignment="Center" />
                                    <Border Grid.Column="2" Background="#E0F2FE" CornerRadius="4" Padding="5,1">
                                        <TextBlock Text="Guides" FontSize="9.5" FontWeight="Bold" Foreground="#0284C7" />
                                    </Border>
                                </Grid>
                            </Button>

                            <!-- 16. Licenses & Third-Party Tools -->
                            <Button Classes="nav-tab-btn"
                                    Classes.active="{Binding SelectedNavSection, Converter={StaticResource EqualityConverter}, ConverterParameter=Licensing}"
                                    Command="{Binding SelectNavSectionCommand}"
                                    CommandParameter="Licensing">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <materialIcons:MaterialIcon Grid.Column="0" Kind="CertificateOutline" Width="18" Height="18" Foreground="#4F46E5" Margin="0,0,10,0" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="Licenses &amp; Tools" VerticalAlignment="Center" />
                                    <Border Grid.Column="2" Background="#EEF2FF" CornerRadius="4" Padding="5,1">
                                        <TextBlock Text="12" FontSize="9.5" FontWeight="Bold" Foreground="#4F46E5" />
                                    </Border>
                                </Grid>
                            </Button>

                            <!-- Preferences Header -->
                            <TextBlock Text="PREFERENCES" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource WinSubtleBrush}" Margin="8,12,0,4" />

                            <!-- 17. Settings & UI Preferences -->
                            <Button Classes="nav-tab-btn"
                                    Classes.active="{Binding SelectedNavSection, Converter={StaticResource EqualityConverter}, ConverterParameter=Settings}"
                                    Command="{Binding SelectNavSectionCommand}"
                                    CommandParameter="Settings">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <materialIcons:MaterialIcon Grid.Column="0" Kind="TuneVariant" Width="18" Height="18" Foreground="#8B5CF6" Margin="0,0,10,0" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="Settings &amp; UI" VerticalAlignment="Center" />
                                    <Border Grid.Column="2" Background="#EDE9FE" CornerRadius="4" Padding="5,1">
                                        <TextBlock Text="UI" FontSize="9.5" FontWeight="Bold" Foreground="#7C3AED" />
                                    </Border>
                                </Grid>
                            </Button>

                            <!-- 18. Plugins & Extensions Studio -->
                            <Button Classes="nav-tab-btn"
                                    Classes.active="{Binding SelectedNavSection, Converter={StaticResource EqualityConverter}, ConverterParameter=Plugins}"
                                    Command="{Binding SelectNavSectionCommand}"
                                    CommandParameter="Plugins">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <materialIcons:MaterialIcon Grid.Column="0" Kind="PuzzleOutline" Width="18" Height="18" Foreground="#7C3AED" Margin="0,0,10,0" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="Plugins &amp; Extensions" VerticalAlignment="Center" />
                                    <Border Grid.Column="2" Background="#EDE9FE" CornerRadius="4" Padding="5,1">
                                        <TextBlock Text="Store" FontSize="9.5" FontWeight="Bold" Foreground="#7C3AED" />
                                    </Border>
                                </Grid>
                            </Button>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>




                <!-- Sidebar Footer with Theme Toggle & Version -->
                <Border DockPanel.Dock="Bottom"
                        Padding="14,10"
                        BorderBrush="{DynamicResource WinBorderSubtleBrush}"
                        BorderThickness="0,1,0,0">
                    <Grid RowDefinitions="Auto,Auto" RowSpacing="6">
                        <!-- Theme Toggle Button -->
                        <Button Grid.Row="0"
                                Command="{Binding ToggleThemeCommand}"
                                Background="{DynamicResource WinInputBgBrush}"
                                BorderBrush="{DynamicResource WinBorderBrush}"
                                BorderThickness="1"
                                Foreground="{DynamicResource WinTextBrush}"
                                CornerRadius="8"
                                Padding="10,6"
                                HorizontalAlignment="Stretch"
                                Cursor="Hand"
                                ToolTip.Tip="Toggle Dark and Light Studio Theme">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <materialIcons:MaterialIcon Kind="WeatherSunny" Width="15" Height="15" Foreground="#F59E0B" IsVisible="{Binding IsDarkMode}" />
                                    <materialIcons:MaterialIcon Kind="WeatherNight" Width="15" Height="15" Foreground="#818CF8" IsVisible="{Binding !IsDarkMode}" />
                                    <TextBlock Text="{Binding IsDarkMode, Converter={StaticResource BooleanToStringConverter}, ConverterParameter='Light Mode|Dark Mode'}"
                                               FontSize="11.5"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                                <materialIcons:MaterialIcon Grid.Column="2" Kind="SwapHorizontal" Width="14" Height="14" Foreground="{DynamicResource WinSubtleBrush}" VerticalAlignment="Center" />
                            </Grid>
                        </Button>

                        <!-- Version Badge -->
                        <TextBlock Grid.Row="1"
                                   Text="FryPDF v1.0 · Privacy-first PDF Studio"
                                   FontSize="9.5"
                                   Foreground="{DynamicResource WinSubtleBrush}"
                                   TextWrapping="Wrap"
                                   HorizontalAlignment="Center" />
                    </Grid>
                </Border>
            </DockPanel>
        </Border>

        <!-- ===== MAIN CONTENT AREA ===== -->
        <Grid Grid.Column="1" RowDefinitions="Auto,*">

            <!-- Top Search & Open File Bar -->
            <Border Grid.Row="0"
                    Background="{DynamicResource WinPanelBrush}"
                    BorderBrush="{DynamicResource WinBorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="32,14"
                    IsVisible="{Binding !IsToolPageActive}">
                <Grid ColumnDefinitions="*,Auto">

                    <!-- Search Box -->
                    <Border Grid.Column="0"
                            Background="{DynamicResource WinInputBgBrush}"
                            BorderBrush="{DynamicResource WinBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="24"
                            Padding="14,0"
                            MaxWidth="560"
                            HorizontalAlignment="Left"
                            Height="40">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <materialIcons:MaterialIcon Grid.Column="0"
                                                        Kind="Magnify"
                                                        Width="16" Height="16"
                                                        Foreground="{DynamicResource WinSubtleBrush}"
                                                        VerticalAlignment="Center"
                                                        Margin="0,0,8,0" />
                            <TextBox Grid.Column="1"
                                     Text="{Binding SearchQuery}"
                                     PlaceholderText="Search all 32 PDF tools &amp; templates (e.g. merge, compress, ocr, word, invoice)..."
                                     FontSize="13"
                                     Foreground="{DynamicResource WinTextBrush}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     VerticalAlignment="Center"
                                     MinWidth="300" />
                            <Button Grid.Column="2"
                                    Command="{Binding ClearSearchCommand}"
                                    IsVisible="{Binding SearchQuery.Length}"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="4"
                                    Cursor="Hand"
                                    ToolTip.Tip="Clear search">
                                <materialIcons:MaterialIcon Kind="CloseCircle" Width="16" Height="16" Foreground="{DynamicResource WinSubtleBrush}" />
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Top Right Actions: Theme Toggle & Open File Button -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                        <Button Command="{Binding ToggleThemeCommand}"
                                Background="{DynamicResource WinInputBgBrush}"
                                BorderBrush="{DynamicResource WinBorderBrush}"
                                BorderThickness="1"
                                Foreground="{DynamicResource WinTextBrush}"
                                CornerRadius="8"
                                Padding="12,0"
                                Height="40"
                                Cursor="Hand"
                                ToolTip.Tip="Toggle Dark / Light Studio Theme">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <materialIcons:MaterialIcon Kind="WeatherSunny" Width="17" Height="17" Foreground="#F59E0B" IsVisible="{Binding IsDarkMode}" />
                                <materialIcons:MaterialIcon Kind="WeatherNight" Width="17" Height="17" Foreground="#818CF8" IsVisible="{Binding !IsDarkMode}" />
                                <TextBlock Text="{Binding IsDarkMode, Converter={StaticResource BooleanToStringConverter}, ConverterParameter='Light Theme|Dark Theme'}"
                                           FontSize="12.5"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding OpenFileCommand}"
                                Background="{DynamicResource WinAccentBrush}"
                                Foreground="White"
                                CornerRadius="8"
                                Padding="16,0"
                                Height="40"
                                Cursor="Hand"
                                ToolTip.Tip="Open a .frypdf or .pdf project file">
                            <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                                <materialIcons:MaterialIcon Kind="FolderOpenOutline" Width="16" Height="16" />
                                <TextBlock Text="Open File"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                </Grid>
            </Border>

            <!-- Page Container -->
            <Grid Grid.Row="1">

                <!-- 1. Dedicated Full-Page Tool Workspace (Shown when a tool is opened) -->
                <Panel IsVisible="{Binding IsToolPageActive}">
                    <views:PdfToolPageView DataContext="{Binding ActiveToolViewModel}" />
                </Panel>

                <!-- 2. Dedicated Full-Viewport Plugins & Extensions Studio (Independent Master-Detail Scroll) -->
                <Panel IsVisible="{Binding IsPluginsWorkspaceActive}">
                    <views:PluginsManagerPageView DataContext="{Binding PluginsManager}" />
                </Panel>

                <!-- 3. Independent Page Files (Shown when standard scrollable page is active) -->
                <ScrollViewer x:Name="MainContentScrollViewer"
                              IsVisible="{Binding IsStandardScrollableContentActive}"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <Panel>
                        <!-- Dynamic Plugin Page View -->
                        <ContentControl Content="{Binding DynamicPageView}" IsVisible="{Binding DynamicPageView, Converter={StaticResource NullToBooleanConverter}}" />

                        <!-- Built-in Pages (shown when DynamicPageView is not active) -->
                        <Panel IsVisible="{Binding DynamicPageView, Converter={StaticResource NullToBooleanConverter}, ConverterParameter=invert}">
                            <!-- Page 1: Overview Dashboard -->
                            <views:HomeDashboardView IsVisible="{Binding IsHomeSection}" />

                            <!-- Page 2: Dedicated PDF Reader Landing Page -->
                            <views:PdfReaderLandingPageView IsVisible="{Binding IsPdfReaderSection}" />

                            <!-- Page 3: Start a New Document (Template Gallery) -->
                            <views:NewDocumentPageView IsVisible="{Binding IsNewDocumentSection}" />

                            <!-- Page 4: PDF Tools Studio (All 32 Tools) -->
                            <views:PdfToolsStudioView IsVisible="{Binding IsToolsSection}" />

                            <!-- Page 5: Starred Tools -->
                            <views:StarredToolsPageView IsVisible="{Binding IsStarredSection}" />

                            <!-- Page 6: Trash & Storage Cache Cleaner -->
                            <views:TrashCachePageView IsVisible="{Binding IsTrashSection}" />

                            <!-- Page 7: Open Source Licenses & Third-Party Tools -->
                            <views:LicensingPageView IsVisible="{Binding IsLicensingSection}" />

                            <!-- Page 8: On-Demand Font & Language Packages Studio -->
                            <Panel IsVisible="{Binding IsFontPackagesSection}">
                                <views:FontManagerPageView DataContext="{Binding FontManager}" />
                            </Panel>

                            <!-- Page 9: On-Demand Tesseract OCR Language Packs Studio -->
                            <Panel IsVisible="{Binding IsTesseractDataSection}">
                                <views:TesseractManagerPageView DataContext="{Binding TesseractManager}" />
                            </Panel>

                            <!-- Page 10: Comprehensive Help & User Guides Studio -->
                            <Panel IsVisible="{Binding IsHelpSection}">
                                <views:HelpGuidePageView DataContext="{Binding HelpGuide}" />
                            </Panel>

                            <!-- Page 11: UI Settings & Preferences Studio -->
                            <Panel IsVisible="{Binding IsSettingsSection}">
                                <views:SettingsPageView DataContext="{Binding Settings}" />
                            </Panel>
                        </Panel>
                    </Panel>

                </ScrollViewer>

            </Grid>

        </Grid>
    </Grid>
</UserControl>
