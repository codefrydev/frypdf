<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PdfEditorApp.ViewModels"
             xmlns:models="using:PdfEditorApp.Models"
             xmlns:converters="using:PdfEditorApp.Converters"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="PdfEditorApp.Views.Dialogs.PdfToolRunnerDialog"
             x:DataType="vm:PdfToolRunnerViewModel">

    <UserControl.Resources>
        <converters:HexToBrushConverter x:Key="HexToBrushConverter" />
        <converters:EqualityToBooleanConverter x:Key="EqualityConverter" />
    </UserControl.Resources>

    <!-- Modal Backdrop -->
    <Grid Background="#70000000" IsVisible="{Binding IsOpen}">
        <Border Width="720"
                MaxHeight="680"
                Background="{DynamicResource WinPanelBrush}"
                BorderBrush="{DynamicResource WinBorderBrush}"
                BorderThickness="1"
                CornerRadius="14"
                BoxShadow="0 20 40 #40000000"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                ClipToBounds="True">

            <Grid RowDefinitions="Auto,*,Auto">

                <!-- 1. Header Bar -->
                <Border Grid.Row="0"
                        Background="{DynamicResource WinInputBgBrush}"
                        BorderBrush="{DynamicResource WinBorderBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="20,16">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                            <Border Width="40" Height="40"
                                    Background="{Binding Tool.BackgroundAccentHex, Converter={StaticResource HexToBrushConverter}}"
                                    CornerRadius="10">
                                <materialIcons:MaterialIcon Kind="{Binding Tool.IconKind}"
                                                            Width="22" Height="22"
                                                            Foreground="{Binding Tool.IconColorHex, Converter={StaticResource HexToBrushConverter}}"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{Binding Tool.Name}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource WinTextBrush}" />
                                    <Border Background="#EFF6FF" CornerRadius="4" Padding="6,1" IsVisible="{Binding Tool.IsNew}">
                                        <TextBlock Text="NEW" FontSize="9.5" FontWeight="Bold" Foreground="#0F6CBD" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{Binding Tool.Description}" FontSize="12" Foreground="{DynamicResource WinMutedBrush}" MaxWidth="480" TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>

                        <Button Grid.Column="2"
                                Command="{Binding CloseCommand}"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="6"
                                Cursor="Hand"
                                ToolTip.Tip="Close Dialog">
                            <materialIcons:MaterialIcon Kind="Close" Width="18" Height="18" Foreground="{DynamicResource WinMutedBrush}" />
                        </Button>
                    </Grid>
                </Border>

                <!-- 2. Scrollable Body Content -->
                <ScrollViewer Grid.Row="1" Padding="24,20" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="18">

                        <!-- Error Message Banner -->
                        <Border Background="#FEF2F2"
                                BorderBrush="#FCA5A5"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="14,10"
                                IsVisible="{Binding HasError}">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <materialIcons:MaterialIcon Kind="AlertCircleOutline" Width="20" Height="20" Foreground="#DC2626" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding ErrorMessage}" FontSize="12" Foreground="#991B1B" VerticalAlignment="Center" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <!-- Success State Banner -->
                        <Border Background="#F0FDF4"
                                BorderBrush="#86EFAC"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16,14"
                                IsVisible="{Binding IsComplete}">
                            <StackPanel Spacing="10">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <materialIcons:MaterialIcon Kind="CheckCircleOutline" Width="24" Height="24" Foreground="#16A34A" VerticalAlignment="Center" />
                                    <StackPanel VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="Operation Completed Successfully!" FontSize="14" FontWeight="Bold" Foreground="#166534" />
                                        <TextBlock Text="{Binding ResultSummaryMessage}" FontSize="12" Foreground="#15803D" TextWrapping="Wrap" />
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="10" Margin="34,4,0,0">
                                    <Button Command="{Binding OpenOutputFileCommand}"
                                            Background="#16A34A"
                                            Foreground="White"
                                            CornerRadius="6"
                                            Padding="14,6"
                                            FontSize="12"
                                            FontWeight="SemiBold"
                                            Cursor="Hand">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <materialIcons:MaterialIcon Kind="FileEyeOutline" Width="14" Height="14" />
                                            <TextBlock Text="Open File" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{Binding OpenOutputFolderCommand}"
                                            Background="#DCFCE7"
                                            Foreground="#166534"
                                            BorderBrush="#86EFAC"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="14,6"
                                            FontSize="12"
                                            FontWeight="SemiBold"
                                            Cursor="Hand">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <materialIcons:MaterialIcon Kind="FolderOpenOutline" Width="14" Height="14" />
                                            <TextBlock Text="Show in Folder" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- File Selection Zone -->
                        <Border Background="{DynamicResource WinInputBgBrush}"
                                BorderBrush="{DynamicResource WinBorderBrush}"
                                BorderThickness="1.5"
                                CornerRadius="10"
                                Padding="16">
                            <StackPanel Spacing="12">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Text="Input Files" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource WinTextBrush}" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                        <Button Command="{Binding AddFilesCommand}"
                                                Background="#0F6CBD"
                                                Foreground="White"
                                                CornerRadius="6"
                                                Padding="12,5"
                                                FontSize="11.5"
                                                FontWeight="SemiBold"
                                                Cursor="Hand">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <materialIcons:MaterialIcon Kind="Plus" Width="14" Height="14" />
                                                <TextBlock Text="Add Files" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                        <Button Command="{Binding ClearFilesCommand}"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Foreground="{DynamicResource WinMutedBrush}"
                                                FontSize="11.5"
                                                Padding="6,4"
                                                Cursor="Hand"
                                                IsVisible="{Binding HasSelectedFiles}">
                                            Clear
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <!-- Empty File Zone Placeholder -->
                                <Border Background="{DynamicResource WinPanelBrush}"
                                        BorderBrush="{DynamicResource WinBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="20"
                                        IsVisible="{Binding !HasSelectedFiles}">
                                    <StackPanel HorizontalAlignment="Center" Spacing="6">
                                        <materialIcons:MaterialIcon Kind="FilePlusOutline" Width="28" Height="28" Foreground="{DynamicResource WinSubtleBrush}" HorizontalAlignment="Center" />
                                        <TextBlock Text="No files selected. Click 'Add Files' to begin." FontSize="12" Foreground="{DynamicResource WinMutedBrush}" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Border>

                                <!-- Selected Files List -->
                                <ItemsControl ItemsSource="{Binding SelectedFiles}" IsVisible="{Binding HasSelectedFiles}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="x:String">
                                            <Border Background="{DynamicResource WinPanelBrush}"
                                                    BorderBrush="{DynamicResource WinBorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="6"
                                                    Padding="10,8"
                                                    Margin="0,0,0,6">
                                                <Grid ColumnDefinitions="Auto,*,Auto">
                                                    <materialIcons:MaterialIcon Grid.Column="0" Kind="FileDocumentOutline" Width="18" Height="18" Foreground="#0F6CBD" Margin="0,0,10,0" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1" Text="{Binding}" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource WinTextBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                    <Button Grid.Column="2"
                                                            Command="{Binding $parent[UserControl].((vm:PdfToolRunnerViewModel)DataContext).RemoveFileCommand}"
                                                            CommandParameter="{Binding}"
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            Padding="4"
                                                            Cursor="Hand">
                                                        <materialIcons:MaterialIcon Kind="Close" Width="14" Height="14" Foreground="{DynamicResource WinSubtleBrush}" />
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Tool-Specific Parameters Settings Box -->
                        <Border Background="{DynamicResource WinPanelBrush}"
                                BorderBrush="{DynamicResource WinBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="16">
                            <StackPanel Spacing="14">
                                <TextBlock Text="Configuration &amp; Options" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource WinTextBrush}" />

                                <!-- Compression Options -->
                                <StackPanel Spacing="8" IsVisible="{Binding Tool.Id, Converter={StaticResource EqualityConverter}, ConverterParameter=CompressPdf}">
                                    <TextBlock Text="Compression Preset Level" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource WinMutedBrush}" />
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <RadioButton Content="Maximum Quality" IsChecked="{Binding CompressionLevel, Converter={StaticResource EqualityConverter}, ConverterParameter=MaximumQuality}" />
                                        <RadioButton Content="Balanced (Recommended)" IsChecked="{Binding CompressionLevel, Converter={StaticResource EqualityConverter}, ConverterParameter=Balanced}" />
                                        <RadioButton Content="Small Size" IsChecked="{Binding CompressionLevel, Converter={StaticResource EqualityConverter}, ConverterParameter=SmallSize}" />
                                    </StackPanel>
                                    <CheckBox Content="Remove document metadata for additional size savings" IsChecked="{Binding CompressRemoveMetadata}" FontSize="11.5" Margin="0,4,0,0" />
                                </StackPanel>

                                <!-- Watermark Options -->
                                <StackPanel Spacing="10" IsVisible="{Binding Tool.Id, Converter={StaticResource EqualityConverter}, ConverterParameter=Watermark}">
                                    <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,4">
                                        <StackPanel Grid.Column="0" Spacing="4">
                                            <TextBlock Text="Watermark Text" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource WinMutedBrush}" />
                                            <TextBox Text="{Binding WatermarkText}" FontSize="12" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="4" Margin="12,0,0,0">
                                            <TextBlock Text="Opacity (0.1 - 1.0)" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource WinMutedBrush}" />
                                            <NumericUpDown Value="{Binding WatermarkOpacity}" Minimum="0.1" Maximum="1.0" Increment="0.05" FormatString="0.00" Width="100" />
                                        </StackPanel>
                                    </Grid>
                                    <Grid ColumnDefinitions="*,*">
                                        <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,6,0">
                                            <TextBlock Text="Rotation Angle (°)" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource WinMutedBrush}" />
                                            <NumericUpDown Value="{Binding WatermarkRotation}" Minimum="-180" Maximum="180" Increment="15" Width="140" HorizontalAlignment="Left" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="4" Margin="6,0,0,0">
                                            <TextBlock Text="Color Hex" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource WinMutedBrush}" />
                                            <TextBox Text="{Binding WatermarkColorHex}" FontSize="12" Width="140" HorizontalAlignment="Left" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>

                                <!-- Password & Security Options -->
                                <StackPanel Spacing="10" IsVisible="{Binding Tool.Id, Converter={StaticResource EqualityConverter}, ConverterParameter=ProtectPdf}">
                                    <Grid ColumnDefinitions="*,*">
                                        <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,6,0">
                                            <TextBlock Text="User Open Password" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource WinMutedBrush}" />
                                            <TextBox Text="{Binding UserPassword}" PasswordChar="•" FontSize="12" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="4" Margin="6,0,0,0">
                                            <TextBlock Text="Owner / Permissions Password" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource WinMutedBrush}" />
                                            <TextBox Text="{Binding OwnerPassword}" PasswordChar="•" FontSize="12" />
                                        </StackPanel>
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,4,0,0">
                                        <CheckBox Content="Allow Printing" IsChecked="{Binding AllowPrinting}" FontSize="11.5" />
                                        <CheckBox Content="Allow Copying" IsChecked="{Binding AllowCopying}" FontSize="11.5" />
                                        <CheckBox Content="Allow Modifying" IsChecked="{Binding AllowModifying}" FontSize="11.5" />
                                    </StackPanel>
                                </StackPanel>

                                <!-- Unlock Password Options -->
                                <StackPanel Spacing="6" IsVisible="{Binding Tool.Id, Converter={StaticResource EqualityConverter}, ConverterParameter=UnlockPdf}">
                                    <TextBlock Text="Enter Document Password" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource WinMutedBrush}" />
                                    <TextBox Text="{Binding UserPassword}" PasswordChar="•" FontSize="12" PlaceholderText="Password..." />
                                </StackPanel>

                                <!-- Split Options -->
                                <StackPanel Spacing="10" IsVisible="{Binding Tool.Id, Converter={StaticResource EqualityConverter}, ConverterParameter=SplitPdf}">
                                    <TextBlock Text="Split Mode" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource WinMutedBrush}" />
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <RadioButton Content="Split Every N Pages" IsChecked="{Binding SplitMode, Converter={StaticResource EqualityConverter}, ConverterParameter=SplitEveryNPages}" />
                                        <RadioButton Content="Split by Page Ranges" IsChecked="{Binding SplitMode, Converter={StaticResource EqualityConverter}, ConverterParameter=SplitByPageRanges}" />
                                        <RadioButton Content="Odd &amp; Even Split" IsChecked="{Binding SplitOddEven}" />
                                    </StackPanel>
                                    <StackPanel Spacing="4" Margin="0,4,0,0">
                                        <TextBlock Text="Page Range Expression (e.g. 1-3, 5, 7-10)" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource WinMutedBrush}" />
                                        <TextBox Text="{Binding SplitRangeExpression}" FontSize="12" />
                                    </StackPanel>
                                </StackPanel>

                                <!-- Page Numbers Options -->
                                <StackPanel Spacing="10" IsVisible="{Binding Tool.Id, Converter={StaticResource EqualityConverter}, ConverterParameter=PageNumbers}">
                                    <Grid ColumnDefinitions="*,*">
                                        <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,6,0">
                                            <TextBlock Text="Numbering Template" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource WinMutedBrush}" />
                                            <TextBox Text="{Binding PageNumberTemplate}" FontSize="12" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="4" Margin="6,0,0,0">
                                            <TextBlock Text="Starting Number" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource WinMutedBrush}" />
                                            <NumericUpDown Value="{Binding PageNumberStart}" Minimum="1" Maximum="99999" Width="120" HorizontalAlignment="Left" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>

                                <!-- HTML to PDF Options -->
                                <StackPanel Spacing="6" IsVisible="{Binding Tool.Id, Converter={StaticResource EqualityConverter}, ConverterParameter=HtmlToPdf}">
                                    <TextBlock Text="Web Page URL or Local HTML File" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource WinMutedBrush}" />
                                    <TextBox Text="{Binding HtmlInputTextOrUrl}" FontSize="12" PlaceholderText="https://codefrydev.in" />
                                </StackPanel>

                                <!-- AI Summary Options -->
                                <StackPanel Spacing="8" IsVisible="{Binding Tool.Id, Converter={StaticResource EqualityConverter}, ConverterParameter=AiSummarizer}">
                                    <TextBlock Text="Summary Output Format" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource WinMutedBrush}" />
                                    <StackPanel Orientation="Horizontal" Spacing="16">
                                        <CheckBox Content="Executive Overview" IsChecked="{Binding AiIncludeExecutive}" FontSize="11.5" />
                                        <CheckBox Content="Action Items List" IsChecked="{Binding AiIncludeActions}" FontSize="11.5" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                                        <TextBlock Text="Key Points Count:" FontSize="11.5" Foreground="{DynamicResource WinMutedBrush}" VerticalAlignment="Center" />
                                        <NumericUpDown Value="{Binding AiMaxBullets}" Minimum="3" Maximum="15" Width="100" />
                                    </StackPanel>
                                </StackPanel>

                                <!-- Translation Options -->
                                <StackPanel Spacing="6" IsVisible="{Binding Tool.Id, Converter={StaticResource EqualityConverter}, ConverterParameter=TranslatePdf}">
                                    <TextBlock Text="Target Language" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource WinMutedBrush}" />
                                    <TextBox Text="{Binding TargetLanguage}" FontSize="12" PlaceholderText="Spanish, French, German..." />
                                </StackPanel>

                                <!-- Generic Ready Status -->
                                <TextBlock Text="Standard high-fidelity processing enabled." FontSize="11.5" Foreground="{DynamicResource WinSubtleBrush}" />
                            </StackPanel>
                        </Border>

                        <!-- Progress Bar & Status -->
                        <Border Background="{DynamicResource WinInputBgBrush}"
                                BorderBrush="{DynamicResource WinBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="14,10"
                                IsVisible="{Binding IsRunning}">
                            <StackPanel Spacing="8">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource WinTextBrush}" />
                                    <TextBlock Grid.Column="1" Text="{Binding ProgressPercentage, StringFormat='{}{0:F0}%'}" FontSize="12" FontWeight="Bold" Foreground="#0F6CBD" />
                                </Grid>
                                <ProgressBar Value="{Binding ProgressPercentage}" Minimum="0" Maximum="100" Height="6" CornerRadius="3" Foreground="#0F6CBD" />
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>

                <!-- 3. Bottom Action Bar -->
                <Border Grid.Row="2"
                        Background="{DynamicResource WinInputBgBrush}"
                        BorderBrush="{DynamicResource WinBorderBrush}"
                        BorderThickness="0,1,0,0"
                        Padding="20,14">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock Text="{Binding SelectedFilesCountText}" FontSize="12" Foreground="{DynamicResource WinMutedBrush}" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                            <Button Command="{Binding CancelExecutionCommand}"
                                    Background="{DynamicResource WinHoverBrush}"
                                    Foreground="{DynamicResource WinMutedBrush}"
                                    CornerRadius="6"
                                    Padding="14,8"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Cursor="Hand"
                                    IsVisible="{Binding IsRunning}">
                                Cancel
                            </Button>
                            <Button Command="{Binding CloseCommand}"
                                    Background="{DynamicResource WinHoverBrush}"
                                    Foreground="{DynamicResource WinMutedBrush}"
                                    CornerRadius="6"
                                    Padding="14,8"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Cursor="Hand"
                                    IsVisible="{Binding !IsRunning}">
                                Close
                            </Button>
                            <Button Command="{Binding ExecuteToolCommand}"
                                    Background="{Binding Tool.IconColorHex, Converter={StaticResource HexToBrushConverter}}"
                                    Foreground="White"
                                    CornerRadius="6"
                                    Padding="18,8"
                                    FontSize="12.5"
                                    FontWeight="Bold"
                                    Cursor="Hand"
                                    IsEnabled="{Binding !IsRunning}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <materialIcons:MaterialIcon Kind="PlayCircleOutline" Width="16" Height="16" />
                                    <TextBlock Text="{Binding Tool.Name, StringFormat='Execute {0}'}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

            </Grid>
        </Border>
    </Grid>
</UserControl>
