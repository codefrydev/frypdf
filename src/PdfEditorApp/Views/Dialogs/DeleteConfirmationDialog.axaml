<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PdfEditorApp.ViewModels"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="PdfEditorApp.Views.Dialogs.DeleteConfirmationDialog"
             x:DataType="vm:HomeViewModel">

    <!-- Modal Backdrop -->
    <Grid Background="#60000000" PointerPressed="OnBackdropPointerPressed">
        <!-- Dialog Card -->
        <Border Width="460"
                Background="{DynamicResource WinPanelBrush}"
                BorderBrush="{DynamicResource WinBorderBrush}"
                BorderThickness="1"
                CornerRadius="12"
                BoxShadow="0 20 60 #35000000"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Padding="24"
                PointerPressed="OnCardPointerPressed">

            <StackPanel Spacing="16">
                <!-- Header -->
                <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                    <Border Grid.Column="0" Width="44" Height="44" Background="#FEE2E2" CornerRadius="12" Margin="0,0,12,0">
                        <materialIcons:MaterialIcon Kind="TrashCanOutline" Width="24" Height="24" Foreground="#DC2626" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="Delete Document?" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource WinTextBrush}" />
                        <TextBlock Text="Permanently delete this file from your computer" FontSize="11.5" Foreground="{DynamicResource WinMutedBrush}" />
                    </StackPanel>

                    <Button Grid.Column="2"
                            Classes="mini-tool-btn"
                            Width="30" Height="30"
                            Command="{Binding CancelDeleteCommand}"
                            ToolTip.Tip="Cancel (Esc)">
                        <materialIcons:MaterialIcon Kind="Close" Width="16" Height="16" Foreground="{DynamicResource WinMutedBrush}" />
                    </Button>
                </Grid>

                <!-- Warning Content -->
                <StackPanel Spacing="8">
                    <TextBlock Text="Are you sure you want to delete this file?" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource WinTextBrush}" />
                    <TextBlock Text="This action will permanently delete the file from your disk and remove it from your recent documents list. This action cannot be undone."
                               FontSize="12"
                               Foreground="{DynamicResource WinMutedBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>

                <!-- Target File Location Pill -->
                <Border Background="{DynamicResource WinInputBgBrush}"
                        BorderBrush="{DynamicResource WinBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12,10">
                    <Grid ColumnDefinitions="Auto,*">
                        <materialIcons:MaterialIcon Grid.Column="0" Kind="FileAlertOutline" Width="20" Height="20" Foreground="#DC2626" Margin="0,0,10,0" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="{Binding DeleteTargetFileName}" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource WinTextBrush}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding DeleteTargetFilePath}" FontSize="10" Foreground="{DynamicResource WinSubtleBrush}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding DeleteTargetFilePath}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Action Buttons -->
                <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,8,0,0" ColumnSpacing="10">
                    <Button Grid.Column="1"
                            Content="Cancel"
                            Background="{DynamicResource WinInputBgBrush}"
                            BorderBrush="{DynamicResource WinBorderBrush}"
                            BorderThickness="1"
                            Foreground="{DynamicResource WinTextBrush}"
                            CornerRadius="6"
                            Padding="16,8"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Cursor="Hand"
                            Command="{Binding CancelDeleteCommand}" />

                    <Button Grid.Column="2"
                            Content="Delete File"
                            Background="#DC2626"
                            Foreground="White"
                            CornerRadius="6"
                            Padding="20,8"
                            FontSize="12"
                            FontWeight="Bold"
                            Cursor="Hand"
                            Command="{Binding ConfirmDeleteCommand}" />
                </Grid>

            </StackPanel>
        </Border>
    </Grid>
</UserControl>
