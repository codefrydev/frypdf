<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PdfEditorApp.ViewModels.Tools"
             xmlns:models="using:PdfEditorApp.Models"
             xmlns:converters="using:PdfEditorApp.Converters"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="PdfEditorApp.Views.Tools.SplitPdfToolView"
             x:DataType="vm:SplitPdfToolViewModel">

    <UserControl.Resources>
        <converters:HexToBrushConverter x:Key="HexToBrushConverter" />
    </UserControl.Resources>

    <Grid ColumnDefinitions="*,390" Margin="0,4,0,0">

        <!-- LEFT: Workspace, selected document, and preview -->
        <ScrollViewer Grid.Column="0" Margin="0,0,20,0" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="16">

                <!-- Error Banner -->
                <Border Background="#FEF2F2" BorderBrush="#FCA5A5" BorderThickness="1" CornerRadius="10" Padding="16,12" IsVisible="{Binding HasError}">
                    <Grid ColumnDefinitions="Auto,*">
                        <materialIcons:MaterialIcon Grid.Column="0" Kind="AlertCircleOutline" Width="22" Height="22" Foreground="#DC2626" Margin="0,0,12,0" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="Split Failed" FontSize="13" FontWeight="Bold" Foreground="#991B1B" />
                            <TextBlock Text="{Binding ErrorMessage}" FontSize="12" Foreground="#B91C1C" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Saved Destination Notification Banner -->
                <Border Background="#F0FDF4" BorderBrush="#86EFAC" BorderThickness="1" CornerRadius="10" Padding="14,10" IsVisible="{Binding HasSavedNotification}">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <materialIcons:MaterialIcon Grid.Column="0" Kind="CheckCircleOutline" Width="20" Height="20" Foreground="#16A34A" Margin="0,0,10,0" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding SavedNotificationMessage}" FontSize="12.5" FontWeight="SemiBold" Foreground="#166534" VerticalAlignment="Center" TextWrapping="Wrap" />
                        <Button Grid.Column="2" Command="{Binding OpenOutputFolderCommand}" Background="#DCFCE7" Foreground="#166534" CornerRadius="6" Padding="10,4" FontSize="11.5" Cursor="Hand">
                            View in Folder
                        </Button>
                    </Grid>
                </Border>

                <!-- Rich Success & Interactive Preview Card -->
                <Border Background="{DynamicResource WinPanelBrush}" BorderBrush="#86EFAC" BorderThickness="1.5" CornerRadius="14" Padding="20" BoxShadow="0 8 24 #1516A34A" IsVisible="{Binding IsComplete}">
                    <StackPanel Spacing="16">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Border Grid.Column="0" Width="48" Height="48" Background="#DCFCE7" CornerRadius="12" Margin="0,0,14,0">
                                <materialIcons:MaterialIcon Kind="CheckCircle" Width="28" Height="28" Foreground="#16A34A" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="PDF Split Successfully!" FontSize="16" FontWeight="Bold" Foreground="#166534" />
                                <TextBlock Text="{Binding ResultSummaryMessage}" FontSize="12.5" Foreground="#15803D" TextWrapping="Wrap" />
                            </StackPanel>
                            <Button Grid.Column="2" Command="{Binding StartOverCommand}" Background="{DynamicResource WinInputBgBrush}" BorderBrush="{DynamicResource WinBorderBrush}" BorderThickness="1" Foreground="{DynamicResource WinMutedBrush}" CornerRadius="8" Padding="12,6" FontSize="12" Cursor="Hand">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <materialIcons:MaterialIcon Kind="Refresh" Width="14" Height="14" />
                                    <TextBlock Text="Split Another" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <WrapPanel Orientation="Horizontal">
                            <!-- Open / Save Extracted Files -->
                            <Button Command="{Binding SaveOutputFileAsCommand}" Background="#DC2626" Foreground="White" CornerRadius="8" Padding="16,10" FontSize="13" FontWeight="Bold" Cursor="Hand" Margin="0,0,8,6">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <materialIcons:MaterialIcon Kind="ContentSaveOutline" Width="17" Height="17" />
                                    <TextBlock Text="Save Split PDF As..." VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Button Command="{Binding OpenOutputFileCommand}" Background="#16A34A" Foreground="White" CornerRadius="8" Padding="14,10" FontSize="12.5" FontWeight="SemiBold" Cursor="Hand" Margin="0,0,8,6">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <materialIcons:MaterialIcon Kind="FolderOpenOutline" Width="16" Height="16" />
                                    <TextBlock Text="Open Extracted PDF" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding OpenInEditorCommand}" Background="#EFF6FF" Foreground="#0F6CBD" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="8" Padding="14,10" FontSize="12.5" FontWeight="SemiBold" Cursor="Hand" Margin="0,0,8,6">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <materialIcons:MaterialIcon Kind="SquareEditOutline" Width="16" Height="16" />
                                    <TextBlock Text="Edit in FryPDF" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding OpenOutputFolderCommand}" Background="{DynamicResource WinHoverBrush}" Foreground="{DynamicResource WinTextBrush}" BorderBrush="{DynamicResource WinBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,10" FontSize="12.5" FontWeight="SemiBold" Cursor="Hand" Margin="0,0,8,6">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <materialIcons:MaterialIcon Kind="FolderOpenOutline" Width="16" Height="16" />
                                    <TextBlock Text="Show in Folder" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </WrapPanel>

                        <!-- Output Document Metadata -->
                        <Border Background="{DynamicResource WinInputBgBrush}" BorderBrush="{DynamicResource WinBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14,10">
                            <Grid ColumnDefinitions="*,Auto,Auto">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <materialIcons:MaterialIcon Kind="FileDocumentCheckOutline" Width="18" Height="18" Foreground="#16A34A" />
                                    <TextBlock Text="{Binding OutputFilePreview.FileName}" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource WinTextBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="350" />
                                </StackPanel>
                                <Border Grid.Column="1" Background="#DCFCE7" CornerRadius="6" Padding="8,2" Margin="10,0">
                                    <TextBlock Text="{Binding OutputFilePreview.PageCountText}" FontSize="11.5" FontWeight="Bold" Foreground="#166534" />
                                </Border>
                                <Border Grid.Column="2" Background="#E2E8F0" CornerRadius="6" Padding="8,2">
                                    <TextBlock Text="{Binding OutputFilePreview.FileSizeFormatted}" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource WinTextBrush}" />
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Page Gallery Strip Preview -->
                        <StackPanel Spacing="8">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="Extracted Document Pages Preview" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource WinTextBrush}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding OutputPageThumbnails.Count, StringFormat='{}{0} Pages'}" FontSize="11.5" Foreground="{DynamicResource WinMutedBrush}" VerticalAlignment="Center" />
                            </Grid>

                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding OutputPageThumbnails}" Margin="0,4,0,8">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="12" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="models:PdfPagePreviewThumbnail">
                                            <Border Width="110" Height="150" Background="{DynamicResource WinPanelBrush}" BorderBrush="{DynamicResource WinBorderBrush}" BorderThickness="1.5" CornerRadius="8" Padding="8" BoxShadow="0 3 8 #0A000000">
                                                <Grid RowDefinitions="Auto,*,Auto">
                                                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,6">
                                                        <Border Grid.Column="0" Background="#DC2626" CornerRadius="4" Padding="5,1" HorizontalAlignment="Left">
                                                            <TextBlock Text="{Binding PageNumber, StringFormat='{}#{0}'}" FontSize="9.5" FontWeight="Bold" Foreground="White" />
                                                        </Border>
                                                        <TextBlock Grid.Column="1" Text="{Binding DimensionsText}" FontSize="8.5" Foreground="{DynamicResource WinSubtleBrush}" />
                                                    </Grid>

                                                    <Border Grid.Row="1" Background="{DynamicResource WinInputBgBrush}" BorderBrush="{DynamicResource WinBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6,6" Margin="0,0,0,6">
                                                        <StackPanel Spacing="4" VerticalAlignment="Center">
                                                            <Border Height="3" Background="#DC2626" CornerRadius="1.5" Margin="0,0,20,0" Opacity="0.8" />
                                                            <Border Height="2" Background="#CBD5E1" CornerRadius="1" Margin="0,0,6,0" />
                                                            <Border Height="2" Background="#E2E8F0" CornerRadius="1" Margin="0,0,12,0" />
                                                            <Border Height="2" Background="#CBD5E1" CornerRadius="1" Margin="0,0,4,0" />
                                                            <Border Height="2" Background="#E2E8F0" CornerRadius="1" Margin="0,0,16,0" />
                                                        </StackPanel>
                                                    </Border>

                                                    <TextBlock Grid.Row="2" Text="{Binding PageLabel}" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource WinMutedBrush}" HorizontalAlignment="Center" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>

                    </StackPanel>
                </Border>

                <!-- Processing Card -->
                <Border Background="{DynamicResource WinPanelBrush}" BorderBrush="{DynamicResource WinBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20,16" IsVisible="{Binding IsRunning}">
                    <StackPanel Spacing="12">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource WinTextBrush}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding ProgressPercentage, StringFormat='{}{0:F0}%'}" FontSize="14" FontWeight="Bold" Foreground="#DC2626" VerticalAlignment="Center" />
                        </Grid>
                        <ProgressBar Value="{Binding ProgressPercentage}" Minimum="0" Maximum="100" Height="8" CornerRadius="4" Foreground="#DC2626" Background="{DynamicResource WinHoverBrush}" />
                        <Button Command="{Binding CancelExecutionCommand}" HorizontalAlignment="Right" Background="{DynamicResource WinHoverBrush}" Foreground="{DynamicResource WinMutedBrush}" CornerRadius="6" Padding="12,5" FontSize="11.5" Cursor="Hand">
                            Cancel
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Dropzone Box -->
                <Border Background="{DynamicResource WinPanelBrush}" BorderBrush="{DynamicResource WinBorderBrush}" BorderThickness="2" CornerRadius="12" Padding="36,44" IsVisible="{Binding !HasSelectedFiles}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
                        <Border Width="64" Height="64" Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="16" HorizontalAlignment="Center">
                            <materialIcons:MaterialIcon Kind="CallSplit" Width="34" Height="34" Foreground="#DC2626" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Spacing="4" HorizontalAlignment="Center">
                            <TextBlock Text="Select PDF document to extract &amp; split" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource WinTextBrush}" HorizontalAlignment="Center" />
                            <TextBlock Text="Extract specific page ranges, split every N pages, or separate into individual single-page documents" FontSize="13" Foreground="{DynamicResource WinMutedBrush}" HorizontalAlignment="Center" />
                        </StackPanel>
                        <Button Command="{Binding AddFilesCommand}" Background="#DC2626" Foreground="White" CornerRadius="8" Padding="24,10" FontSize="13.5" FontWeight="SemiBold" HorizontalAlignment="Center" Cursor="Hand">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <materialIcons:MaterialIcon Kind="FolderOpenOutline" Width="16" Height="16" />
                                <TextBlock Text="Select PDF Document" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Selected File Card with Mini Preview -->
                <Border Background="{DynamicResource WinPanelBrush}" BorderBrush="{DynamicResource WinBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20" BoxShadow="0 2 6 #05000000" IsVisible="{Binding HasSelectedFiles}">
                    <StackPanel Spacing="14">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="Document to Split" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource WinTextBrush}" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Command="{Binding ClearFilesCommand}" Background="Transparent" BorderThickness="0" Foreground="#EF4444" FontSize="12" Cursor="Hand">
                                Change Document
                            </Button>
                        </Grid>

                        <ItemsControl ItemsSource="{Binding SelectedFilePreviewItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="models:PdfFilePreviewItem">
                                    <Border Background="{DynamicResource WinInputBgBrush}" BorderBrush="{DynamicResource WinBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14">
                                        <Grid ColumnDefinitions="Auto,*">
                                            <Border Grid.Column="0" Width="64" Height="82" Background="{DynamicResource WinPanelBrush}" BorderBrush="{DynamicResource WinBorderBrush}" BorderThickness="1" CornerRadius="4" BoxShadow="0 2 6 #0A000000" Margin="0,0,14,0" Padding="6,5">
                                                <Grid RowDefinitions="Auto,*,Auto">
                                                    <Border Grid.Row="0" Width="20" Height="3" Background="#DC2626" CornerRadius="1" HorizontalAlignment="Left" Margin="0,0,0,4" />
                                                    <StackPanel Grid.Row="1" Spacing="3" VerticalAlignment="Center">
                                                        <Border Height="2.5" Background="#E2E8F0" CornerRadius="1" Margin="0,0,4,0" />
                                                        <Border Height="2.5" Background="#E2E8F0" CornerRadius="1" Margin="0,0,10,0" />
                                                        <Border Height="2.5" Background="{DynamicResource WinHoverBrush}" CornerRadius="1" Margin="0,0,2,0" />
                                                    </StackPanel>
                                                    <Border Grid.Row="2" Background="#FEF2F2" CornerRadius="2" Padding="2,1" HorizontalAlignment="Center">
                                                        <TextBlock Text="{Binding PageCountText}" FontSize="7.5" FontWeight="Bold" Foreground="#DC2626" />
                                                    </Border>
                                                </Grid>
                                            </Border>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                                <TextBlock Text="{Binding FileName}" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource WinTextBrush}" TextTrimming="CharacterEllipsis" />
                                                <WrapPanel Orientation="Horizontal">
                                                    <Border Background="#FEF2F2" CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                                                        <TextBlock Text="{Binding PageCountText}" FontSize="11" FontWeight="SemiBold" Foreground="#DC2626" />
                                                    </Border>
                                                    <Border Background="{DynamicResource WinHoverBrush}" CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                                                        <TextBlock Text="{Binding FileSizeFormatted}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource WinTextBrush}" />
                                                    </Border>
                                                </WrapPanel>
                                                <TextBlock Text="{Binding FilePath}" FontSize="10.5" Foreground="{DynamicResource WinSubtleBrush}" TextTrimming="CharacterEllipsis" MaxWidth="380" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- RIGHT: Settings & Trigger Panel -->
        <Border Grid.Column="1" Background="{DynamicResource WinPanelBrush}" BorderBrush="{DynamicResource WinBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="22" BoxShadow="0 4 12 #08000000">
            <DockPanel>
                <Border DockPanel.Dock="Top" Margin="0,0,0,16">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <materialIcons:MaterialIcon Kind="TuneVerticalVariant" Width="18" Height="18" Foreground="#DC2626" />
                        <TextBlock Text="Split Configuration" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource WinTextBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <StackPanel DockPanel.Dock="Bottom" Margin="0,16,0,0" Spacing="10">
                    <Button Command="{Binding ExecuteToolCommand}" Background="#DC2626" Foreground="White" CornerRadius="10" Padding="24,14" FontWeight="Bold" FontSize="14" Cursor="Hand" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" IsEnabled="{Binding !IsRunning}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <materialIcons:MaterialIcon Kind="CallSplit" Width="18" Height="18" />
                            <TextBlock Text="Split PDF Now" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <TextBlock Text="Extracts specified pages into clean independent files" FontSize="11" Foreground="{DynamicResource WinSubtleBrush}" HorizontalAlignment="Center" />
                </StackPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="16">
                        
                        <!-- Split Mode -->
                        <Border Background="{DynamicResource WinInputBgBrush}" BorderBrush="{DynamicResource WinBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Split Mode" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource WinMutedBrush}" />
                                <RadioButton GroupName="SplitMode" Content="Split Every N Pages" FontSize="12.5" IsChecked="{Binding SplitMode, Converter={StaticResource EqualityConverter}, ConverterParameter=SplitEveryNPages}" />
                                <RadioButton GroupName="SplitMode" Content="Split by Page Ranges" FontSize="12.5" IsChecked="{Binding SplitMode, Converter={StaticResource EqualityConverter}, ConverterParameter=SplitByPageRanges}" />
                            </StackPanel>
                        </Border>

                        <!-- Split Settings -->
                        <Border Background="{DynamicResource WinInputBgBrush}" BorderBrush="{DynamicResource WinBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Split Range Expression" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource WinMutedBrush}" />
                                <TextBox Text="{Binding SplitRangeExpression, Mode=TwoWay}" PlaceholderText="e.g. 1-3, 5, 7-10" FontSize="12" IsEnabled="{Binding SplitMode, Converter={StaticResource EqualityConverter}, ConverterParameter=SplitByPageRanges}" />
                                <TextBlock Text="Separate distinct documents with commas, use hyphens for ranges. Only applies in &quot;Split by Page Ranges&quot; mode." FontSize="10.5" Foreground="{DynamicResource WinSubtleBrush}" />

                                <Grid ColumnDefinitions="*,Auto" Margin="0,6,0,0">
                                    <TextBlock Grid.Column="0" Text="Pages Per Document Interval:" FontSize="12" Foreground="{DynamicResource WinMutedBrush}" VerticalAlignment="Center" />
                                    <NumericUpDown Grid.Column="1" Value="{Binding SplitPagesInterval}" Minimum="1" Maximum="100" Width="90" IsEnabled="{Binding SplitMode, Converter={StaticResource EqualityConverter}, ConverterParameter=SplitEveryNPages}" />
                                </Grid>

                                <CheckBox Content="Separate Odd and Even Pages" IsChecked="{Binding SplitOddEven}" FontSize="12" Margin="0,6,0,0" />
                                <TextBlock Text="Overrides the mode above when checked." FontSize="10.5" Foreground="{DynamicResource WinSubtleBrush}" />
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

    </Grid>
</UserControl>
