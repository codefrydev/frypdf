<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia">

    <!-- Global Application Typography & Controls Default Polish -->
    <Style Selector="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI, -apple-system, BlinkMacSystemFont, 'SF Pro Text', 'Helvetica Neue', Cantarell, sans-serif" />
    </Style>

    <!-- Ribbon Tab Button Style -->
    <Style Selector="Button.ribbon-tab">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource WinMutedBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="12,5" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Height" Value="28" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="Button.ribbon-tab:pointerover">
        <Setter Property="Background" Value="{DynamicResource WinHoverBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource WinTextBrush}" />
    </Style>

    <Style Selector="Button.ribbon-tab.active">
        <Setter Property="Background" Value="{DynamicResource WinAccentLightBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource WinAccentBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- File Tab Button Style (Accent pill) -->
    <Style Selector="Button.ribbon-file-tab">
        <Setter Property="Background" Value="{DynamicResource WinAccentBrush}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="12,5" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Height" Value="28" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="Button.ribbon-file-tab:pointerover">
        <Setter Property="Background" Value="{DynamicResource WinAccentHoverBrush}" />
    </Style>

    <!-- Ribbon Vertical Tool Button -->
    <Style Selector="Button.tool-btn">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource WinTextBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="4,4" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="MinWidth" Value="64" />
        <Setter Property="Height" Value="66" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style Selector="Button.tool-btn:pointerover">
        <Setter Property="Background" Value="{DynamicResource WinHoverBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource WinBorderBrush}" />
    </Style>

    <Style Selector="Button.tool-btn.active">
        <Setter Property="Background" Value="{DynamicResource WinAccentLightBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource WinAccentBorderBrush}" />
    </Style>

    <!-- Mini Tool Button (for fonts, icons, quick toolbar) -->
    <Style Selector="Button.mini-tool-btn">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource WinTextBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="CornerRadius" Value="5" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style Selector="Button.mini-tool-btn:pointerover">
        <Setter Property="Background" Value="{DynamicResource WinHoverBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource WinBorderBrush}" />
    </Style>

    <Style Selector="Button.mini-tool-btn.active">
        <Setter Property="Background" Value="{DynamicResource WinAccentLightBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource WinAccentBorderBrush}" />
    </Style>

    <!-- Secondary Action Button (Icon + Label, perfect for Inspector & Footer) -->
    <Style Selector="Button.secondary-btn">
        <Setter Property="Background" Value="{DynamicResource WinPanelBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource WinTextBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource WinBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style Selector="Button.secondary-btn:pointerover">
        <Setter Property="Background" Value="{DynamicResource WinHoverBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource WinBorderBrush}" />
    </Style>

    <!-- Danger Button (Delete, Remove) -->
    <Style Selector="Button.danger-btn">
        <Setter Property="Background" Value="{DynamicResource WinDangerLightBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource WinDangerBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource WinDangerBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style Selector="Button.danger-btn:pointerover">
        <Setter Property="Background" Value="{DynamicResource WinDangerLightBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource WinDangerBrush}" />
    </Style>

    <!-- Accent / Primary Button (Save, Export, Dialog Confirmations) -->
    <Style Selector="Button.accent-btn, Button.primary-btn">
        <Setter Property="Background" Value="{DynamicResource WinAccentBrush}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="14,6" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Height" Value="34" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style Selector="Button.accent-btn:pointerover, Button.primary-btn:pointerover">
        <Setter Property="Background" Value="{DynamicResource WinAccentHoverBrush}" />
    </Style>

    <!-- Dialog Action Pill Button (for links, copy chips, cards) -->
    <Style Selector="Button.action-pill-btn">
        <Setter Property="Background" Value="{DynamicResource WinHoverBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource WinAccentBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource WinBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style Selector="Button.action-pill-btn:pointerover">
        <Setter Property="Background" Value="{DynamicResource WinAccentLightBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource WinAccentBorderBrush}" />
    </Style>

    <!-- Success Pill Button (for Open-Source & License banners) -->
    <Style Selector="Button.success-pill-btn">
        <Setter Property="Background" Value="{DynamicResource WinSuccessLightBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource WinSuccessBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource WinSuccessBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12,4" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style Selector="Button.success-pill-btn:pointerover">
        <Setter Property="Background" Value="{DynamicResource WinSuccessBrush}" />
        <Setter Property="Foreground" Value="White" />
    </Style>

    <!-- Inspector Section Labels & Headers -->
    <Style Selector="TextBlock.inspector-header">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource WinMutedBrush}" />
        <Setter Property="LetterSpacing" Value="0.6" />
    </Style>

    <Style Selector="TextBlock.inspector-label">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{DynamicResource WinMutedBrush}" />
        <Setter Property="Margin" Value="0,0,0,3" />
    </Style>

    <!-- Modern ComboBox, TextBox, NumericUpDown adjustments -->
    <Style Selector="ComboBox">
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="BorderBrush" Value="{DynamicResource WinBorderBrush}" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="Foreground" Value="{DynamicResource WinTextBrush}" />
    </Style>

    <Style Selector="TextBox">
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="BorderBrush" Value="{DynamicResource WinBorderBrush}" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="Foreground" Value="{DynamicResource WinTextBrush}" />
    </Style>

    <!-- Sleek Compact NumericUpDown & ButtonSpinner Styling (Adobe Pro & Studio Grade) -->
    <Style Selector="NumericUpDown">
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="BorderBrush" Value="{DynamicResource WinBorderBrush}" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Padding" Value="6,1,2,1" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Foreground" Value="{DynamicResource WinTextBrush}" />
    </Style>

    <Style Selector="NumericUpDown /template/ TextBox#PART_TextBox">
        <Setter Property="MinHeight" Value="26" />
        <Setter Property="Height" Value="26" />
        <Setter Property="Padding" Value="4,1" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Foreground" Value="{DynamicResource WinTextBrush}" />
    </Style>

    <Style Selector="NumericUpDown /template/ ButtonSpinner">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>

    <Style Selector="ButtonSpinner /template/ RepeatButton">
        <Setter Property="MinWidth" Value="16" />
        <Setter Property="Width" Value="16" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="ButtonSpinner /template/ RepeatButton:pointerover">
        <Setter Property="Background" Value="{DynamicResource WinHoverBrush}" />
    </Style>

    <Style Selector="ButtonSpinner /template/ RepeatButton Path">
        <Setter Property="Width" Value="8" />
        <Setter Property="Height" Value="5" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="Fill" Value="{DynamicResource WinMutedBrush}" />
    </Style>

    <!-- Inspector ColorPicker Compact Styling -->
    <Style Selector="ColorPicker">
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="Height" Value="24" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="BorderBrush" Value="{DynamicResource WinBorderBrush}" />
        <Setter Property="Padding" Value="2" />
        <Setter Property="IsAlphaEnabled" Value="True" />
        <Setter Property="IsHexInputVisible" Value="True" />
    </Style>

    <!-- Industry Standard Color Studio Button Style -->
    <Style Selector="Button.color-studio-btn">
        <Setter Property="Width" Value="26" />
        <Setter Property="Height" Value="26" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="13" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.color-studio-btn:pointerover">
        <Setter Property="RenderTransform" Value="scale(1.08)" />
    </Style>

    <!-- Input Prefix Badge (e.g., [X], [Y], [W], [H], [∠]) -->
    <Style Selector="Border.input-badge">
        <Setter Property="Background" Value="{DynamicResource WinHoverBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource WinBorderBrush}" />
        <Setter Property="BorderThickness" Value="1,1,0,1" />
        <Setter Property="CornerRadius" Value="5,0,0,5" />
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="28" />
    </Style>

    <Style Selector="TextBlock.input-badge-text">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource WinMutedBrush}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Floating Glass HUD Bar -->
    <Style Selector="Border.glass-hud">
        <Setter Property="Background" Value="{DynamicResource WinPanelBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource WinBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="BoxShadow" Value="0 8 20 #20000000" />
        <Setter Property="Padding" Value="8,6" />
    </Style>

    <!-- Keyboard Key Cap / Badge Style -->
    <Style Selector="Border.kbd-badge">
        <Setter Property="Background" Value="{DynamicResource WinInputBgBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource WinBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="5,1.5" />
        <Setter Property="BoxShadow" Value="0 1 0 #20000000" />
    </Style>

    <Style Selector="TextBlock.kbd-text">
        <Setter Property="FontSize" Value="10" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource WinTextBrush}" />
        <Setter Property="FontFamily" Value="Consolas, -apple-system, monospace" />
    </Style>

    <!-- Toast Notification Banner -->
    <Style Selector="Border.toast-banner">
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="14,9" />
        <Setter Property="BoxShadow" Value="0 8 24 #35000000" />
    </Style>
    <Style Selector="Border.toast-banner Button:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#25000000" />
    </Style>

    <!-- Context Menu Item Styling -->
    <Style Selector="ContextMenu">
        <Setter Property="Background" Value="{DynamicResource WinPanelBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource WinBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="4" />
    </Style>

    <Style Selector="MenuItem">
        <Setter Property="CornerRadius" Value="5" />
        <Setter Property="Padding" Value="8,5" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource WinTextBrush}" />
    </Style>

    <!-- Template Gallery Interactive Card Style -->
    <Style Selector="Button.template-card">
        <Setter Property="Background" Value="{DynamicResource WinPanelBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource WinBorderBrush}" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="BorderBrush" Duration="0:0:0.18" />
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18" />
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="Button.template-card:pointerover">
        <Setter Property="BorderBrush" Value="{DynamicResource WinAccentBrush}" />
        <Setter Property="RenderTransform" Value="scale(1.015)" />
    </Style>

    <!-- Category Filter Chip Style -->
    <Style Selector="Button.category-filter-chip">
        <Setter Property="Background" Value="{DynamicResource WinInputBgBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource WinMutedBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource WinBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Padding" Value="12,4.5" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.15" />
                <BrushTransition Property="Foreground" Duration="0:0:0.15" />
                <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="Button.category-filter-chip:pointerover">
        <Setter Property="Background" Value="{DynamicResource WinHoverBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource WinTextBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource WinBorderBrush}" />
    </Style>

    <Style Selector="Button.category-filter-chip.active">
        <Setter Property="Background" Value="{DynamicResource WinAccentLightBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource WinAccentBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource WinAccentBorderBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- ============================================================== -->
    <!-- Reader-style chrome: shared by the PDF Reader (PdfViewerView)   -->
    <!-- and the tool-screen workspace shell (PdfToolWorkspaceView), so  -->
    <!-- both look and behave the same way instead of maintaining two    -->
    <!-- separate definitions.                                           -->
    <!-- ============================================================== -->

    <!-- Page Card Physical Styling -->
    <Style Selector="Border.reader-page-card">
        <Setter Property="Background" Value="#FFFFFF" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="BoxShadow" Value="0 8 28 #22000000, 0 1 3 #12000000" />
        <Setter Property="BorderBrush" Value="#E2E8F0" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="ClipToBounds" Value="True" />
    </Style>

    <!-- Reading Theme Specific Paper Styling -->
    <Style Selector="Border.reading-theme-sepia">
        <Setter Property="Background" Value="#FBF0D9" />
        <Setter Property="BorderBrush" Value="#E6D5B8" />
    </Style>
    <Style Selector="Border.reading-theme-dark">
        <Setter Property="Background" Value="#1E293B" />
        <Setter Property="BorderBrush" Value="#334155" />
    </Style>
    <Style Selector="Border.reading-theme-highcontrast">
        <Setter Property="Background" Value="#000000" />
        <Setter Property="BorderBrush" Value="#FFFF00" />
    </Style>

    <!-- Toolbar Segmented Capsule -->
    <Style Selector="Border.toolbar-capsule">
        <Setter Property="Background" Value="{DynamicResource WinInputBgBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource WinBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="7" />
        <Setter Property="Padding" Value="3,2" />
    </Style>

    <!-- Compact Tool Button -->
    <Style Selector="Button.toolbar-btn">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="5" />
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.toolbar-btn:pointerover">
        <Setter Property="Background" Value="{DynamicResource WinHoverBrush}" />
    </Style>

    <!-- Active Mode Button in Segmented Capsule -->
    <Style Selector="Button.mode-active">
        <Setter Property="Background" Value="{DynamicResource WinAccentLightBrush}" />
    </Style>

    <!-- Thumbnail Item Card -->
    <Style Selector="Border.thumbnail-card">
        <Setter Property="Background" Value="#FFFFFF" />
        <Setter Property="BorderBrush" Value="{DynamicResource WinBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="BoxShadow" Value="0 2 8 #10000000" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
                <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.15" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Border.thumbnail-card:pointerover">
        <Setter Property="BorderBrush" Value="{DynamicResource WinAccentBrush}" />
        <Setter Property="BoxShadow" Value="0 4 14 #200F6CBD" />
    </Style>
    <Style Selector="Border.thumbnail-card.selected">
        <Setter Property="BorderBrush" Value="#0F6CBD" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="Background" Value="#F0F7FF" />
        <Setter Property="BoxShadow" Value="0 4 16 #280F6CBD" />
    </Style>

    <!-- ============================================================== -->
    <!-- Modern Chubby Tactile Slider Styling                            -->
    <!-- ============================================================== -->
    <Style Selector="Slider">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style Selector="Slider:horizontal">
        <Setter Property="MinHeight" Value="24" />
    </Style>

    <Style Selector="Slider:vertical">
        <Setter Property="MinWidth" Value="24" />
    </Style>

    <!-- Track Corners Polish: ensures smooth pill ends -->
    <Style Selector="Slider /template/ RepeatButton#PART_DecreaseButton /template/ Border#TrackBackground">
        <Setter Property="CornerRadius" Value="4" />
    </Style>
    <Style Selector="Slider /template/ RepeatButton#PART_IncreaseButton /template/ Border#TrackBackground">
        <Setter Property="CornerRadius" Value="4" />
    </Style>

    <!-- Tactile Chubby Thumb with Ring & Soft Shadow -->
    <Style Selector="Slider /template/ Thumb">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12" />
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="Slider /template/ Thumb /template/ Border">
        <Setter Property="BorderBrush" Value="{DynamicResource WinPanelBrush}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="BoxShadow" Value="0 2 6 #35000000" />
    </Style>

    <Style Selector="Slider /template/ Thumb:pointerover">
        <Setter Property="RenderTransform" Value="scale(1.12)" />
    </Style>

    <Style Selector="Slider /template/ Thumb:pressed">
        <Setter Property="RenderTransform" Value="scale(0.94)" />
    </Style>

    <!-- Optional extra-chubby style class for prominent sliders -->
    <Style Selector="Slider.extra-chubby">
        <Setter Property="MinHeight" Value="28" />
    </Style>
    <Style Selector="Slider.extra-chubby /template/ RepeatButton#PART_DecreaseButton /template/ Border#TrackBackground">
        <Setter Property="Height" Value="10" />
        <Setter Property="CornerRadius" Value="5" />
    </Style>
    <Style Selector="Slider.extra-chubby /template/ RepeatButton#PART_IncreaseButton /template/ Border#TrackBackground">
        <Setter Property="Height" Value="10" />
        <Setter Property="CornerRadius" Value="5" />
    </Style>
    <Style Selector="Slider.extra-chubby /template/ Thumb">
        <Setter Property="Width" Value="22" />
        <Setter Property="Height" Value="22" />
    </Style>
    <Style Selector="Slider.extra-chubby /template/ Thumb /template/ Border">
        <Setter Property="CornerRadius" Value="11" />
    </Style>

</Styles>
