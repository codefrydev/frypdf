<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PdfEditorApp.ViewModels"
             xmlns:elvm="using:PdfEditorApp.ViewModels.ElementViewModels"
             xmlns:converters="using:PdfEditorApp.Converters"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:controls="using:PdfEditorApp.Views.Controls"
             x:Class="PdfEditorApp.Views.InspectorSidebarView"
             x:DataType="vm:InspectorViewModel">

    <UserControl.Resources>
        <converters:HexToBrushConverter x:Key="HexToBrushConverter" />
        <converters:HexToColorConverter x:Key="HexToColorConverter" />
        <converters:NullToBooleanConverter x:Key="NullToBooleanConverter" />
        <converters:DoubleToThicknessConverter x:Key="DoubleToThickness" />
        <converters:DoubleToCornerRadiusConverter x:Key="DoubleToCornerRadius" />
        <converters:EqualityToBooleanConverter x:Key="EqualityConverter" />
        <converters:EqualityToBooleanConverter x:Key="EnumToBooleanConverter" />
        <converters:BooleanToStringConverter x:Key="BooleanToStringConverter" />
    </UserControl.Resources>

    <!-- Outer Container: dynamically switches between Expanded (310px) and Collapsed (38px) mode -->
    <Panel>
        <!-- A. EXPANDED MODE (Width 310) -->
        <Border Background="{DynamicResource WinPanelBrush}" BorderBrush="{DynamicResource WinBorderBrush}" BorderThickness="1,0,0,0" Width="310"
                IsVisible="{Binding !$parent[Window].((vm:MainViewModel)DataContext).IsInspectorCollapsed}">
            <Grid RowDefinitions="Auto,*">

                <!-- Sidebar Header -->
                <Border Grid.Row="0" Background="{DynamicResource WinBgBrush}" BorderBrush="{DynamicResource WinBorderBrush}" BorderThickness="0,0,0,1" Padding="14,10">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <materialIcons:MaterialIcon Kind="TuneVariant" Width="18" Height="18" Foreground="{DynamicResource WinAccentBrush}" />
                            <TextBlock Text="Properties &amp; Format" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource WinTextBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <controls:AskAiButton Variant="Subtle"
                                                  CommandParameter="{Binding SelectedElement}"
                                                  IsVisible="{Binding HasSelectedElement}" />
                            <Border Background="{DynamicResource WinAccentLightBrush}" CornerRadius="{StaticResource M3ShapeCornerFull}" Padding="8,2">
                                <TextBlock Text="{Binding ActiveCategoryName}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource WinAccentBrush}"
                                           VerticalAlignment="Center" />
                            </Border>
                            <Button Classes="mini-tool-btn" Width="26" Height="26"
                                    Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).ToggleInspectorCollapseCommand}"
                                    ToolTip.Tip="Collapse Properties Inspector (⌘⇧P / Ctrl+Shift+P)">
                                <materialIcons:MaterialIcon Kind="ChevronRight" Width="16" Height="16" Foreground="{DynamicResource WinMutedBrush}" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Inspector Scrollable Cards -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="12" Spacing="12">

                    <!-- EMPTY STATE: DOCUMENT & PAGE SETUP STUDIO (Visible when nothing is selected) -->
                    <Border Background="{DynamicResource WinBgBrush}" BorderBrush="{DynamicResource WinBorderBrush}" BorderThickness="1" CornerRadius="{StaticResource M3ShapeCornerLarge}" Padding="14"
                            IsVisible="{Binding !HasSelectedElement}">
                        <StackPanel Spacing="12">
                            <!-- Header & Live Page Pill -->
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <materialIcons:MaterialIcon Kind="FileDocumentOutline" Width="18" Height="18" Foreground="{DynamicResource WinAccentBrush}" />
                                    <TextBlock Text="Page &amp; Canvas Setup" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource WinTextBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                                <Border Grid.Column="1" Background="{DynamicResource WinHoverBrush}" BorderBrush="{DynamicResource WinBorderBrush}" BorderThickness="1" CornerRadius="{StaticResource M3ShapeCornerFull}" Padding="8,2">
                                    <TextBlock Text="{Binding SelectedPage.PageNumber, StringFormat='Page {0}'}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource WinAccentBrush}" />
                                </Border>
                            </Grid>

                            <!-- Page Format Standards (Acrobat Feature) -->
                            <StackPanel Spacing="4">
                                <TextBlock Text="Paper Size Standard" Classes="inspector-label" />
                                <WrapPanel Orientation="Horizontal">
                                    <Button Classes="secondary-btn" Height="24" Padding="6,1" Margin="2" Command="{Binding SetPageFormatCommand}" CommandParameter="A4"><TextBlock Text="A4" FontSize="10.5" /></Button>
                                    <Button Classes="secondary-btn" Height="24" Padding="6,1" Margin="2" Command="{Binding SetPageFormatCommand}" CommandParameter="Letter"><TextBlock Text="Letter" FontSize="10.5" /></Button>
                                    <Button Classes="secondary-btn" Height="24" Padding="6,1" Margin="2" Command="{Binding SetPageFormatCommand}" CommandParameter="Legal"><TextBlock Text="Legal" FontSize="10.5" /></Button>
                                    <Button Classes="secondary-btn" Height="24" Padding="6,1" Margin="2" Command="{Binding SetPageFormatCommand}" CommandParameter="A3"><TextBlock Text="A3" FontSize="10.5" /></Button>
                                    <Button Classes="secondary-btn" Height="24" Padding="6,1" Margin="2" Command="{Binding SetPageFormatCommand}" CommandParameter="A5"><TextBlock Text="A5" FontSize="10.5" /></Button>
                                    <Button Classes="secondary-btn" Height="24" Padding="6,1" Margin="2" Command="{Binding SetPageFormatCommand}" CommandParameter="Tabloid"><TextBlock Text="Tabloid" FontSize="10.5" /></Button>
                                </WrapPanel>
                            </StackPanel>

                            <!-- Orientation & Rotation Studio -->
                            <StackPanel Spacing="4">
                                <TextBlock Text="Orientation &amp; Rotation" Classes="inspector-label" />
                                <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="4">
                                    <Button Grid.Column="0" Classes="secondary-btn" Height="26" Padding="4,2" HorizontalAlignment="Stretch"
                                            Command="{Binding SetPageOrientationCommand}" CommandParameter="Portrait">
                                        <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                                            <materialIcons:MaterialIcon Kind="FileOutline" Width="13" Height="13" Foreground="{DynamicResource WinMutedBrush}" />
                                            <TextBlock Text="Portrait" FontSize="10.5" />
                                        </StackPanel>
                                    </Button>
                                    <Button Grid.Column="1" Classes="secondary-btn" Height="26" Padding="4,2" HorizontalAlignment="Stretch"
                                            Command="{Binding SetPageOrientationCommand}" CommandParameter="Landscape">
                                        <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                                            <materialIcons:MaterialIcon Kind="FileOutline" Width="13" Height="13" Foreground="{DynamicResource WinMutedBrush}">
                                                <materialIcons:MaterialIcon.RenderTransform>
                                                    <RotateTransform Angle="90" />
                                                </materialIcons:MaterialIcon.RenderTransform>
                                            </materialIcons:MaterialIcon>
                                            <TextBlock Text="Landscape" FontSize="10.5" />
                                        </StackPanel>
                                    </Button>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2">
                                        <Button Classes="mini-tool-btn" Width="26" Height="26" Command="{Binding RotatePageCounterClockwiseCommand}" ToolTip.Tip="Rotate 90° Counter-Clockwise">
                                            <materialIcons:MaterialIcon Kind="RotateLeft" Width="14" Height="14" Foreground="{DynamicResource WinMutedBrush}" />
                                        </Button>
                                        <Button Classes="mini-tool-btn" Width="26" Height="26" Command="{Binding RotatePageClockwiseCommand}" ToolTip.Tip="Rotate 90° Clockwise">
                                            <materialIcons:MaterialIcon Kind="RotateRight" Width="14" Height="14" Foreground="{DynamicResource WinMutedBrush}" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>

                            <!-- Custom Page Dimensions (Width & Height) -->
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                                <StackPanel Grid.Column="0" Spacing="3">
                                    <TextBlock Text="Width (pt)" Classes="inspector-label" />
                                    <NumericUpDown Value="{Binding SelectedPage.Width, Mode=TwoWay}" Minimum="200" Maximum="4000" Increment="10" FormatString="0"
                                                   HorizontalAlignment="Stretch" Height="28" FontSize="12" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="3">
                                    <TextBlock Text="Height (pt)" Classes="inspector-label" />
                                    <NumericUpDown Value="{Binding SelectedPage.Height, Mode=TwoWay}" Minimum="200" Maximum="4000" Increment="10" FormatString="0"
                                                   HorizontalAlignment="Stretch" Height="28" FontSize="12" />
                                </StackPanel>
                            </Grid>

                            <!-- Page Canvas Background Color & ColorPicker -->
                            <StackPanel Spacing="4">
                                <TextBlock Text="Canvas Background Color" Classes="inspector-label" />
                                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                    <Button Classes="color-studio-btn" ToolTip.Tip="Custom Canvas Color Studio">
                                        <Button.Flyout>
                                            <Flyout Placement="BottomEdgeAlignedLeft">
                                                <Border Background="{DynamicResource WinBgBrush}" BorderBrush="{DynamicResource WinBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10" BoxShadow="0 8 24 #30000000">
                                                    <ColorView Color="{Binding SelectedPage.BackgroundColorHex, Mode=TwoWay, Converter={StaticResource HexToColorConverter}}"
                                                               IsAlphaEnabled="False" IsHexInputVisible="True" Width="280" />
                                                </Border>
                                            </Flyout>
                                        </Button.Flyout>
                                        <Grid Width="24" Height="24">
                                            <Border CornerRadius="12" Width="24" Height="24">
                                                <Border.Background>
                                                    <ConicGradientBrush Center="0.5,0.5">
                                                        <GradientStop Color="#FF0000" Offset="0.0" />
                                                        <GradientStop Color="#FFFF00" Offset="0.17" />
                                                        <GradientStop Color="#00FF00" Offset="0.33" />
                                                        <GradientStop Color="#00FFFF" Offset="0.50" />
                                                        <GradientStop Color="#0000FF" Offset="0.67" />
                                                        <GradientStop Color="#FF00FF" Offset="0.83" />
                                                        <GradientStop Color="#FF0000" Offset="1.0" />
                                                    </ConicGradientBrush>
                                                </Border.Background>
                                            </Border>
                                            <Border Margin="3.5" CornerRadius="9" Background="{DynamicResource WinPanelBrush}">
                                                <materialIcons:MaterialIcon Kind="Palette" Width="11" Height="11" Foreground="{DynamicResource WinTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                        </Grid>
                                    </Button>
                                    <Button Width="22" Height="22" CornerRadius="3" Background="{DynamicResource WinPanelBrush}" BorderBrush="#94A3B8" BorderThickness="1" Command="{Binding SetPageBackgroundColorCommand}" CommandParameter="#FFFFFF" ToolTip.Tip="Pure White" />
                                    <Button Width="22" Height="22" CornerRadius="3" Background="#FFFDF7" BorderBrush="{DynamicResource WinBorderBrush}" BorderThickness="1" Command="{Binding SetPageBackgroundColorCommand}" CommandParameter="#FFFDF7" ToolTip.Tip="Warm Cream" />
                                    <Button Width="22" Height="22" CornerRadius="3" Background="{DynamicResource WinInputBgBrush}" Command="{Binding SetPageBackgroundColorCommand}" CommandParameter="#F8FAFC" ToolTip.Tip="Slate Tint" />
                                    <Button Width="22" Height="22" CornerRadius="3" Background="#FEF3C7" Command="{Binding SetPageBackgroundColorCommand}" CommandParameter="#FEF3C7" ToolTip.Tip="Parchment Yellow" />
                                    <Button Width="22" Height="22" CornerRadius="3" Background="#0F172A" Command="{Binding SetPageBackgroundColorCommand}" CommandParameter="#0F172A" ToolTip.Tip="Blueprint Dark" />
                                </StackPanel>
                            </StackPanel>

                            <Rectangle Height="1" Fill="{DynamicResource WinBorderBrush}" Margin="0,2" />

                            <!-- Header & Footer Bar Settings -->
                            <StackPanel Spacing="8">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                        <materialIcons:MaterialIcon Kind="PageLayoutFooter" Width="14" Height="14" Foreground="{DynamicResource WinAccentBrush}" />
                                        <TextBlock Text="Header &amp; Footer Margins" FontWeight="SemiBold" FontSize="11.5" Foreground="{DynamicResource WinTextBrush}" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding SelectedPage.ShowHeaderFooter, Mode=TwoWay}"
                                                  OnContent="" OffContent="" Margin="0" />
                                </Grid>

                                <StackPanel Spacing="6" IsVisible="{Binding SelectedPage.ShowHeaderFooter}">
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="Quick Header/Footer Preset" Classes="inspector-label" />
                                        <WrapPanel Orientation="Horizontal">
                                            <Button Classes="secondary-btn" Height="22" Padding="5,1" Margin="2" Command="{Binding ApplyHeaderFooterPresetCommand}" CommandParameter="Standard"><TextBlock Text="Standard" FontSize="10" /></Button>
                                            <Button Classes="secondary-btn" Height="22" Padding="5,1" Margin="2" Command="{Binding ApplyHeaderFooterPresetCommand}" CommandParameter="Minimal"><TextBlock Text="Page Only" FontSize="10" /></Button>
                                            <Button Classes="secondary-btn" Height="22" Padding="5,1" Margin="2" Command="{Binding ApplyHeaderFooterPresetCommand}" CommandParameter="Corporate"><TextBlock Text="Corporate" FontSize="10" /></Button>
                                        </WrapPanel>
                                    </StackPanel>

                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                                        <StackPanel Grid.Column="0" Spacing="2">
                                            <TextBlock Text="Footer Left" Classes="inspector-label" FontSize="10" />
                                            <TextBox Text="{Binding SelectedPage.FooterLeft, Mode=TwoWay}" Height="26" FontSize="11" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="2">
                                            <TextBlock Text="Footer Right" Classes="inspector-label" FontSize="10" />
                                            <TextBox Text="{Binding SelectedPage.FooterRight, Mode=TwoWay}" Height="26" FontSize="11" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 1. ADVANCED TYPOGRAPHY & TEXT STUDIO CARD -->
                    <Border Background="{DynamicResource WinBgBrush}" BorderBrush="{DynamicResource WinBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12"
                            IsVisible="{Binding TextElement, Converter={StaticResource NullToBooleanConverter}}">
                        <StackPanel Spacing="12">
                            <!-- Card Header & Auto-Fit Tools -->
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <materialIcons:MaterialIcon Kind="FormatFont" Width="16" Height="16" Foreground="{DynamicResource WinAccentBrush}" />
                                    <TextBlock Text="Typography &amp; Text Studio" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource WinTextBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                    <Button Classes="mini-tool-btn" Height="24" Padding="5,1" Command="{Binding AutoFitTextBothCommand}" ToolTip.Tip="Auto-Fit dimensions (Width &amp; Height)">
                                        <materialIcons:MaterialIcon Kind="FitToPageOutline" Width="13" Height="13" Foreground="{DynamicResource WinAccentBrush}" />
                                    </Button>
                                    <Button Classes="mini-tool-btn" Height="24" Padding="5,1" Command="{Binding AutoFitTextWidthCommand}" ToolTip.Tip="Auto-Fit Width to content">
                                        <materialIcons:MaterialIcon Kind="ArrowExpandHorizontal" Width="13" Height="13" Foreground="{DynamicResource WinAccentBrush}" />
                                    </Button>
                                    <Button Classes="mini-tool-btn" Height="24" Padding="5,1" Command="{Binding AutoFitTextHeightCommand}" ToolTip.Tip="Auto-Fit Height to content">
                                        <materialIcons:MaterialIcon Kind="ArrowExpandVertical" Width="13" Height="13" Foreground="{DynamicResource WinAccentBrush}" />
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <!-- Typography Presets -->
                            <StackPanel Spacing="4">
                                <TextBlock Text="Quick Typography Presets" Classes="inspector-label" />
                                <WrapPanel Orientation="Horizontal">
                                    <Button Classes="secondary-btn" Height="22" Padding="5,1" Margin="1" Command="{Binding ApplyTypographyPresetCommand}" CommandParameter="normal"><TextBlock Text="Normal" FontSize="9.5" /></Button>
                                    <Button Classes="secondary-btn" Height="22" Padding="5,1" Margin="1" Command="{Binding ApplyTypographyPresetCommand}" CommandParameter="wave"><TextBlock Text="〰 Wave" FontSize="9.5" /></Button>
                                    <Button Classes="secondary-btn" Height="22" Padding="5,1" Margin="1" Command="{Binding ApplyTypographyPresetCommand}" CommandParameter="scurve"><TextBlock Text="∿ S-Curve" FontSize="9.5" /></Button>
                                    <Button Classes="secondary-btn" Height="22" Padding="5,1" Margin="1" Command="{Binding ApplyTypographyPresetCommand}" CommandParameter="bridge"><TextBlock Text="⌢ Bridge" FontSize="9.5" /></Button>
                                    <Button Classes="secondary-btn" Height="22" Padding="5,1" Margin="1" Command="{Binding ApplyTypographyPresetCommand}" CommandParameter="valley"><TextBlock Text="⌣ Valley" FontSize="9.5" /></Button>
                                    <Button Classes="secondary-btn" Height="22" Padding="5,1" Margin="1" Command="{Binding ApplyTypographyPresetCommand}" CommandParameter="rise"><TextBlock Text="↗ Rise" FontSize="9.5" /></Button>
                                    <Button Classes="secondary-btn" Height="22" Padding="5,1" Margin="1" Command="{Binding ApplyTypographyPresetCommand}" CommandParameter="archup"><TextBlock Text="⤴ Arch Up" FontSize="9.5" /></Button>
                                    <Button Classes="secondary-btn" Height="22" Padding="5,1" Margin="1" Command="{Binding ApplyTypographyPresetCommand}" CommandParameter="archdown"><TextBlock Text="⤵ Arch Down" FontSize="9.5" /></Button>
                                    <Button Classes="secondary-btn" Height="22" Padding="5,1" Margin="1" Command="{Binding ApplyTypographyPresetCommand}" CommandParameter="circlebadge"><TextBlock Text="◯ Badge" FontSize="9.5" /></Button>
                                    <Button Classes="secondary-btn" Height="22" Padding="5,1" Margin="1" Command="{Binding ApplyTypographyPresetCommand}" CommandParameter="toparc"><TextBlock Text="⌒ Top Arc" FontSize="9.5" /></Button>
                                    <Button Classes="secondary-btn" Height="22" Padding="5,1" Margin="1" Command="{Binding ApplyTypographyPresetCommand}" CommandParameter="bottomarc"><TextBlock Text="ᴗ Bottom Arc" FontSize="9.5" /></Button>
                                    <Button Classes="secondary-btn" Height="22" Padding="5,1" Margin="1" Command="{Binding ApplyTypographyPresetCommand}" CommandParameter="outlined"><TextBlock Text="Outline" FontSize="9.5" /></Button>
                                    <Button Classes="secondary-btn" Height="22" Padding="5,1" Margin="1" Command="{Binding ApplyTypographyPresetCommand}" CommandParameter="shadowheading"><TextBlock Text="Shadow" FontSize="9.5" /></Button>
                                    <Button Classes="secondary-btn" Height="22" Padding="5,1" Margin="1" Command="{Binding ApplyTypographyPresetCommand}" CommandParameter="neonglow"><TextBlock Text="✨ Neon Glow" FontSize="9.5" /></Button>
                                </WrapPanel>
                            </StackPanel>

                            <!-- In-Inspector Text Editor -->
                            <StackPanel Spacing="3">
                                <TextBlock Text="Text Content" Classes="inspector-label" />
                                <TextBox Text="{Binding TextElement.Text, Mode=TwoWay}"
                                         AcceptsReturn="True" TextWrapping="Wrap"
                                         Height="54" FontSize="12" CornerRadius="5" Padding="6,4"
                                         AttachedToVisualTree="OnSidebarTextBoxAttached" />
                            </StackPanel>

                            <!-- Font Family & Font Size -->
                            <Grid ColumnDefinitions="*,75" ColumnSpacing="6">
                                <StackPanel Grid.Column="0" Spacing="3">
                                    <TextBlock Text="Font Family" Classes="inspector-label" />
                                    <ComboBox ItemsSource="{Binding AvailableFontFamilies}"
                                              SelectedItem="{Binding SelectedFontFamily, Mode=TwoWay}"
                                              HorizontalAlignment="Stretch" Height="30" FontSize="12">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate DataType="x:String">
                                                <TextBlock Text="{Binding}" FontFamily="{Binding}" FontSize="12" VerticalAlignment="Center" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Spacing="3">
                                    <TextBlock Text="Size (pt)" Classes="inspector-label" />
                                    <NumericUpDown Value="{Binding TextElement.FontSize, Mode=TwoWay}"
                                                   Minimum="4" Maximum="288" Increment="1" FormatString="0"
                                                   HorizontalAlignment="Stretch" Height="30" FontSize="12" />
                                </StackPanel>
                            </Grid>

                            <!-- Bold / Italic / Underline / Double Underline / Strikethrough / Alignment -->
                            <StackPanel Spacing="3">
                                <TextBlock Text="Style, Underline &amp; Alignment" Classes="inspector-label" />
                                <WrapPanel Orientation="Horizontal">
                                    <Button Classes="mini-tool-btn" Width="28" Height="28" Margin="1" Focusable="False"
                                            Classes.active="{Binding TextElement.IsBold, FallbackValue=False}"
                                            Command="{Binding ToggleBoldCommand}" ToolTip.Tip="Bold (Ctrl+B)">
                                        <materialIcons:MaterialIcon Kind="FormatBold" Width="15" Height="15" Foreground="{DynamicResource WinTextBrush}" />
                                    </Button>

                                    <Button Classes="mini-tool-btn" Width="28" Height="28" Margin="1" Focusable="False"
                                            Classes.active="{Binding TextElement.IsItalic, FallbackValue=False}"
                                            Command="{Binding ToggleItalicCommand}" ToolTip.Tip="Italic (Ctrl+I)">
                                        <materialIcons:MaterialIcon Kind="FormatItalic" Width="15" Height="15" Foreground="{DynamicResource WinTextBrush}" />
                                    </Button>

                                    <Button Classes="mini-tool-btn" Width="28" Height="28" Margin="1" Focusable="False"
                                            Classes.active="{Binding TextElement.IsUnderline, FallbackValue=False}"
                                            Command="{Binding ToggleUnderlineCommand}" ToolTip.Tip="Single Underline (Ctrl+U)">
                                        <materialIcons:MaterialIcon Kind="FormatUnderline" Width="15" Height="15" Foreground="{DynamicResource WinTextBrush}" />
                                    </Button>

                                    <Button Classes="mini-tool-btn" Width="28" Height="28" Margin="1" Focusable="False"
                                            Classes.active="{Binding TextElement.IsDoubleUnderline, FallbackValue=False}"
                                            Command="{Binding ToggleDoubleUnderlineCommand}" ToolTip.Tip="Double Underline">
                                        <materialIcons:MaterialIcon Kind="FormatUnderline" Width="15" Height="15" Foreground="{DynamicResource WinAccentBrush}" />
                                    </Button>

                                    <Button Classes="mini-tool-btn" Width="28" Height="28" Margin="1" Focusable="False"
                                            Classes.active="{Binding TextElement.IsStrikethrough, FallbackValue=False}"
                                            Command="{Binding ToggleStrikethroughCommand}" ToolTip.Tip="Strikethrough">
                                        <materialIcons:MaterialIcon Kind="FormatStrikethrough" Width="15" Height="15" Foreground="{DynamicResource WinTextBrush}" />
                                    </Button>

                                    <Rectangle Width="1" Height="18" Fill="{DynamicResource WinBorderBrush}" Margin="3,0" />

                                    <Button Classes="mini-tool-btn" Width="28" Height="28" Margin="1" Focusable="False"
                                            Command="{Binding ToggleBulletsCommand}" ToolTip.Tip="Bullet List">
                                        <materialIcons:MaterialIcon Kind="FormatListBulleted" Width="15" Height="15" Foreground="{DynamicResource WinTextBrush}" />
                                    </Button>

                                    <Button Classes="mini-tool-btn" Width="28" Height="28" Margin="1" Focusable="False"
                                            Command="{Binding ToggleNumberingCommand}" ToolTip.Tip="Numbered List">
                                        <materialIcons:MaterialIcon Kind="FormatListNumbered" Width="15" Height="15" Foreground="{DynamicResource WinTextBrush}" />
                                    </Button>

                                    <Rectangle Width="1" Height="18" Fill="{DynamicResource WinBorderBrush}" Margin="3,0" />

                                    <!-- Horizontal Alignment -->
                                    <Button Classes="mini-tool-btn" Width="28" Height="28" Margin="1" Focusable="False"
                                            Classes.active="{Binding TextElement.Alignment, Converter={StaticResource EqualityConverter}, ConverterParameter=Left}"
                                            Command="{Binding SetAlignmentCommand}" CommandParameter="Left" ToolTip.Tip="Align Left">
                                        <materialIcons:MaterialIcon Kind="FormatAlignLeft" Width="15" Height="15" Foreground="{DynamicResource WinTextBrush}" />
                                    </Button>

                                    <Button Classes="mini-tool-btn" Width="28" Height="28" Margin="1" Focusable="False"
                                            Classes.active="{Binding TextElement.Alignment, Converter={StaticResource EqualityConverter}, ConverterParameter=Center}"
                                            Command="{Binding SetAlignmentCommand}" CommandParameter="Center" ToolTip.Tip="Align Center">
                                        <materialIcons:MaterialIcon Kind="FormatAlignCenter" Width="15" Height="15" Foreground="{DynamicResource WinTextBrush}" />
                                    </Button>

                                    <Button Classes="mini-tool-btn" Width="28" Height="28" Margin="1" Focusable="False"
                                            Classes.active="{Binding TextElement.Alignment, Converter={StaticResource EqualityConverter}, ConverterParameter=Right}"
                                            Command="{Binding SetAlignmentCommand}" CommandParameter="Right" ToolTip.Tip="Align Right">
                                        <materialIcons:MaterialIcon Kind="FormatAlignRight" Width="15" Height="15" Foreground="{DynamicResource WinTextBrush}" />
                                    </Button>

                                    <Button Classes="mini-tool-btn" Width="28" Height="28" Margin="1" Focusable="False"
                                            Classes.active="{Binding TextElement.Alignment, Converter={StaticResource EqualityConverter}, ConverterParameter=Justify}"
                                            Command="{Binding SetAlignmentCommand}" CommandParameter="Justify" ToolTip.Tip="Justify">
                                        <materialIcons:MaterialIcon Kind="FormatAlignJustify" Width="15" Height="15" Foreground="{DynamicResource WinTextBrush}" />
                                    </Button>
                                </WrapPanel>
                            </StackPanel>

                            <!-- Vertical Alignment & Text Case -->
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                <StackPanel Grid.Column="0" Spacing="3">
                                    <TextBlock Text="Vertical Align" Classes="inspector-label" />
                                    <StackPanel Orientation="Horizontal" Spacing="2">
                                        <Button Classes="mini-tool-btn" Width="26" Height="24"
                                                Classes.active="{Binding TextElement.VerticalAlignment, Converter={StaticResource EqualityConverter}, ConverterParameter=Top}"
                                                Command="{Binding SetVerticalAlignmentCommand}" CommandParameter="Top" ToolTip.Tip="Top Align">
                                            <materialIcons:MaterialIcon Kind="AlignVerticalTop" Width="13" Height="13" Foreground="{DynamicResource WinTextBrush}" />
                                        </Button>
                                        <Button Classes="mini-tool-btn" Width="26" Height="24"
                                                Classes.active="{Binding TextElement.VerticalAlignment, Converter={StaticResource EqualityConverter}, ConverterParameter=Center}"
                                                Command="{Binding SetVerticalAlignmentCommand}" CommandParameter="Center" ToolTip.Tip="Middle Align">
                                            <materialIcons:MaterialIcon Kind="AlignVerticalCenter" Width="13" Height="13" Foreground="{DynamicResource WinTextBrush}" />
                                        </Button>
                                        <Button Classes="mini-tool-btn" Width="26" Height="24"
                                                Classes.active="{Binding TextElement.VerticalAlignment, Converter={StaticResource EqualityConverter}, ConverterParameter=Bottom}"
                                                Command="{Binding SetVerticalAlignmentCommand}" CommandParameter="Bottom" ToolTip.Tip="Bottom Align">
                                            <materialIcons:MaterialIcon Kind="AlignVerticalBottom" Width="13" Height="13" Foreground="{DynamicResource WinTextBrush}" />
                                        </Button>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Spacing="3">
                                    <TextBlock Text="Text Case" Classes="inspector-label" />
                                    <StackPanel Orientation="Horizontal" Spacing="2">
                                        <Button Classes="secondary-btn" Height="24" Padding="4,1" Command="{Binding TransformTextCaseCommand}" CommandParameter="Upper"><TextBlock Text="AA" FontSize="9" /></Button>
                                        <Button Classes="secondary-btn" Height="24" Padding="4,1" Command="{Binding TransformTextCaseCommand}" CommandParameter="Lower"><TextBlock Text="aa" FontSize="9" /></Button>
                                        <Button Classes="secondary-btn" Height="24" Padding="4,1" Command="{Binding TransformTextCaseCommand}" CommandParameter="Title"><TextBlock Text="Aa" FontSize="9" /></Button>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>

                            <!-- Spacing: Tracking, Word Spacing, Line Height, Paragraph Spacing -->
                            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="6" RowSpacing="6">
                                <StackPanel Grid.Row="0" Grid.Column="0" Spacing="2">
                                    <TextBlock Text="Tracking / Spacing" Classes="inspector-label" />
                                    <NumericUpDown Value="{Binding TextElement.CharacterSpacing, Mode=TwoWay}"
                                                   Minimum="-5" Maximum="50" Increment="0.5" FormatString="0.0"
                                                   HorizontalAlignment="Stretch" Height="28" FontSize="11.5" />
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="1" Spacing="2">
                                    <TextBlock Text="Word Spacing" Classes="inspector-label" />
                                    <NumericUpDown Value="{Binding TextElement.WordSpacing, Mode=TwoWay}"
                                                   Minimum="-10" Maximum="50" Increment="1" FormatString="0.0"
                                                   HorizontalAlignment="Stretch" Height="28" FontSize="11.5" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="0" Spacing="2">
                                    <TextBlock Text="Line Height" Classes="inspector-label" />
                                    <NumericUpDown Value="{Binding TextElement.LineHeight, Mode=TwoWay}"
                                                   Minimum="0.5" Maximum="4.0" Increment="0.1" FormatString="0.0"
                                                   HorizontalAlignment="Stretch" Height="28" FontSize="11.5" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="1" Spacing="2">
                                    <TextBlock Text="Paragraph Spacing" Classes="inspector-label" />
                                    <NumericUpDown Value="{Binding TextElement.ParagraphSpacing, Mode=TwoWay}"
                                                   Minimum="0" Maximum="50" Increment="1" FormatString="0"
                                                   HorizontalAlignment="Stretch" Height="28" FontSize="11.5" />
                                </StackPanel>
                            </Grid>

                            <!-- Text Wrap & Text Opacity -->
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                <CheckBox Grid.Column="0" IsChecked="{Binding TextElement.TextWrap, Mode=TwoWay}" VerticalAlignment="Center">
                                    <TextBlock Text="Wrap Multiline Text" FontSize="11" />
                                </CheckBox>
                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Grid.Column="0" Text="Text Opacity" Classes="inspector-label" Margin="0" />
                                        <TextBlock Grid.Column="1" Text="{Binding TextElement.TextOpacity, StringFormat='{}{0:P0}'}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource WinAccentBrush}" />
                                    </Grid>
                                    <Slider Value="{Binding TextElement.TextOpacity, Mode=TwoWay}" Minimum="0.0" Maximum="1.0" Height="24" Margin="0" />
                                </StackPanel>
                            </Grid>

                            <!-- Text Color -->
                            <StackPanel Spacing="4">
                                <TextBlock Text="Text Color" Classes="inspector-label" />
                                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                    <Button Classes="color-studio-btn" ToolTip.Tip="Custom Color Studio">
                                        <Button.Flyout>
                                            <Flyout Placement="BottomEdgeAlignedLeft">
                                                <Border Background="{DynamicResource WinBgBrush}" BorderBrush="{DynamicResource WinBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10" BoxShadow="0 8 24 #30000000">
                                                    <ColorView Color="{Binding TextElement.TextColorHex, Mode=TwoWay, Converter={StaticResource HexToColorConverter}}"
                                                               IsAlphaEnabled="True" IsHexInputVisible="True" Width="280" />
                                                </Border>
                                            </Flyout>
                                        </Button.Flyout>
                                        <Grid Width="24" Height="24">
                                            <Border CornerRadius="12" Width="24" Height="24">
                                                <Border.Background>
                                                    <ConicGradientBrush Center="0.5,0.5">
                                                        <GradientStop Color="#FF0000" Offset="0.0" />
                                                        <GradientStop Color="#FFFF00" Offset="0.17" />
                                                        <GradientStop Color="#00FF00" Offset="0.33" />
                                                        <GradientStop Color="#00FFFF" Offset="0.50" />
                                                        <GradientStop Color="#0000FF" Offset="0.67" />
                                                        <GradientStop Color="#FF00FF" Offset="0.83" />
                                                        <GradientStop Color="#FF0000" Offset="1.0" />
                                                    </ConicGradientBrush>
                                                </Border.Background>
                                            </Border>
                                            <Border Margin="3.5" CornerRadius="9" Background="{DynamicResource WinPanelBrush}">
                                                <materialIcons:MaterialIcon Kind="Palette" Width="11" Height="11" Foreground="{DynamicResource WinTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                        </Grid>
                                    </Button>
                                    <ItemsControl ItemsSource="{Binding ColorSwatches}">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="vm:ColorSwatchItem">
                                                <Button Width="22" Height="22" Margin="1.5" CornerRadius="11" BorderBrush="{DynamicResource WinBorderBrush}" BorderThickness="1"
                                                        Background="{Binding Hex, Converter={StaticResource HexToBrushConverter}}"
                                                        Command="{Binding $parent[UserControl].((vm:InspectorViewModel)DataContext).SetTextColorCommand}"
                                                        CommandParameter="{Binding Hex}" ToolTip.Tip="{Binding Name}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </StackPanel>

                            <!-- Text Stroke / Outline Studio -->
                            <Border Background="{StaticResource WinSubtleBgBrush}" CornerRadius="6" Padding="8" BorderThickness="1" BorderBrush="{DynamicResource WinBorderBrush}">
                                <StackPanel Spacing="6">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <CheckBox Grid.Column="0" IsChecked="{Binding TextElement.HasStroke, Mode=TwoWay}" VerticalAlignment="Center">
                                            <TextBlock Text="Text Outline / Stroke" FontWeight="SemiBold" FontSize="11" />
                                        </CheckBox>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" IsVisible="{Binding TextElement.HasStroke}">
                                            <Button Classes="color-studio-btn" ToolTip.Tip="Custom Stroke Color">
                                                <Button.Flyout>
                                                    <Flyout Placement="BottomEdgeAlignedLeft">
                                                        <Border Background="{DynamicResource WinBgBrush}" BorderBrush="{DynamicResource WinBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10" BoxShadow="0 8 24 #30000000">
                                                            <ColorView Color="{Binding TextElement.StrokeColorHex, Mode=TwoWay, Converter={StaticResource HexToColorConverter}}"
                                                                       IsAlphaEnabled="True" IsHexInputVisible="True" Width="280" />
                                                        </Border>
                                                    </Flyout>
                                                </Button.Flyout>
                                                <Border Width="20" Height="20" CornerRadius="10" Background="{Binding TextElement.StrokeColorHex, Converter={StaticResource HexToBrushConverter}}" BorderBrush="#94A3B8" BorderThickness="1" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>

                                    <Grid ColumnDefinitions="*,80" ColumnSpacing="6" IsVisible="{Binding TextElement.HasStroke}">
                                        <Slider Grid.Column="0" Value="{Binding TextElement.StrokeWidth, Mode=TwoWay}" Minimum="0.5" Maximum="12" Height="24" Margin="0" />
                                        <NumericUpDown Grid.Column="1" Value="{Binding TextElement.StrokeWidth, Mode=TwoWay}" Minimum="0.5" Maximum="20" Increment="0.5" FormatString="0.0 pt" Height="26" FontSize="11" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Text Drop Shadow & Glow Studio -->
                            <Border Background="{StaticResource WinSubtleBgBrush}" CornerRadius="6" Padding="8" BorderThickness="1" BorderBrush="{DynamicResource WinBorderBrush}">
                                <StackPanel Spacing="6">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <CheckBox Grid.Column="0" IsChecked="{Binding TextElement.HasShadow, Mode=TwoWay}" VerticalAlignment="Center">
                                            <TextBlock Text="Text Shadow &amp; Glow" FontWeight="SemiBold" FontSize="11" />
                                        </CheckBox>
                                        <Button Grid.Column="1" Classes="color-studio-btn" ToolTip.Tip="Shadow Color" IsVisible="{Binding TextElement.HasShadow}">
                                            <Button.Flyout>
                                                <Flyout Placement="BottomEdgeAlignedLeft">
                                                    <Border Background="{DynamicResource WinBgBrush}" BorderBrush="{DynamicResource WinBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10" BoxShadow="0 8 24 #30000000">
                                                        <ColorView Color="{Binding TextElement.ShadowColorHex, Mode=TwoWay, Converter={StaticResource HexToColorConverter}}"
                                                                   IsAlphaEnabled="True" IsHexInputVisible="True" Width="280" />
                                                    </Border>
                                                </Flyout>
                                            </Button.Flyout>
                                            <Border Width="20" Height="20" CornerRadius="10" Background="{Binding TextElement.ShadowColorHex, Converter={StaticResource HexToBrushConverter}}" BorderBrush="#94A3B8" BorderThickness="1" />
                                        </Button>
                                    </Grid>

                                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="4" IsVisible="{Binding TextElement.HasShadow}">
                                        <StackPanel Grid.Column="0" Spacing="2">
                                            <TextBlock Text="Offset X" Classes="inspector-label" />
                                            <NumericUpDown Value="{Binding TextElement.ShadowOffsetX, Mode=TwoWay}" Minimum="-50" Maximum="50" Increment="1" FormatString="0" Height="26" FontSize="10.5" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="2">
                                            <TextBlock Text="Offset Y" Classes="inspector-label" />
                                            <NumericUpDown Value="{Binding TextElement.ShadowOffsetY, Mode=TwoWay}" Minimum="-50" Maximum="50" Increment="1" FormatString="0" Height="26" FontSize="10.5" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Spacing="2">
                                            <TextBlock Text="Blur Radius" Classes="inspector-label" />
                                            <NumericUpDown Value="{Binding TextElement.ShadowBlurRadius, Mode=TwoWay}" Minimum="0" Maximum="40" Increment="1" FormatString="0" Height="26" FontSize="10.5" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Background Highlight & Box Decoration -->
                            <StackPanel Spacing="4">
                                <TextBlock Text="Highlight / Background Box" Classes="inspector-label" />
                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                    <Button Classes="secondary-btn" Height="22" Padding="6,1" Command="{Binding SetTextBackgroundCommand}" CommandParameter="#00000000"><TextBlock Text="None" FontSize="9.5" /></Button>
                                    <Button Classes="color-studio-btn" ToolTip.Tip="Custom Highlight Color">
                                        <Button.Flyout>
                                            <Flyout Placement="BottomEdgeAlignedLeft">
                                                <Border Background="{DynamicResource WinBgBrush}" BorderBrush="{DynamicResource WinBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10" BoxShadow="0 8 24 #30000000">
                                                    <ColorView Color="{Binding TextElement.BackgroundColorHex, Mode=TwoWay, Converter={StaticResource HexToColorConverter}}"
                                                               IsAlphaEnabled="True" IsHexInputVisible="True" Width="280" />
                                                </Border>
                                            </Flyout>
                                        </Button.Flyout>
                                        <Grid Width="24" Height="24">
                                            <Border CornerRadius="12" Width="24" Height="24">
                                                <Border.Background>
                                                    <ConicGradientBrush Center="0.5,0.5">
                                                        <GradientStop Color="#FF0000" Offset="0.0" /><GradientStop Color="#FFFF00" Offset="0.17" /><GradientStop Color="#00FF00" Offset="0.33" /><GradientStop Color="#00FFFF" Offset="0.50" /><GradientStop Color="#0000FF" Offset="0.67" /><GradientStop Color="#FF00FF" Offset="0.83" /><GradientStop Color="#FF0000" Offset="1.0" />
                                                    </ConicGradientBrush>
                                                </Border.Background>
                                            </Border>
                                            <Border Margin="3.5" CornerRadius="9" Background="{DynamicResource WinPanelBrush}">
                                                <materialIcons:MaterialIcon Kind="Palette" Width="11" Height="11" Foreground="{DynamicResource WinTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                        </Grid>
                                    </Button>
                                    <Button Width="22" Height="22" CornerRadius="4" Background="#FEF08A" Command="{Binding SetTextBackgroundCommand}" CommandParameter="#FEF08A" ToolTip.Tip="Yellow Highlight" />
                                    <Button Width="22" Height="22" CornerRadius="4" Background="#BAE6FD" Command="{Binding SetTextBackgroundCommand}" CommandParameter="#BAE6FD" ToolTip.Tip="Blue Highlight" />
                                    <Button Width="22" Height="22" CornerRadius="4" Background="#BBF7D0" Command="{Binding SetTextBackgroundCommand}" CommandParameter="#BBF7D0" ToolTip.Tip="Green Highlight" />
                                    <Button Width="22" Height="22" CornerRadius="4" Background="#FEE2E2" Command="{Binding SetTextBackgroundCommand}" CommandParameter="#FEE2E2" ToolTip.Tip="Red Highlight" />
                                    <Button Width="22" Height="22" CornerRadius="4" Background="{DynamicResource WinHoverBrush}" Command="{Binding SetTextBackgroundCommand}" CommandParameter="#F1F5F9" ToolTip.Tip="Light Gray" />
                                </StackPanel>

                                <!-- Box Padding, Corner Radius, Border -->
                                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="6" Margin="0,4,0,0">
                                    <StackPanel Grid.Column="0" Spacing="2">
                                        <TextBlock Text="Padding" Classes="inspector-label" />
                                        <NumericUpDown Value="{Binding TextElement.Padding, Mode=TwoWay}" Minimum="0" Maximum="64" Increment="1" FormatString="0" Height="26" FontSize="11" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock Text="Corner Radius" Classes="inspector-label" />
                                        <NumericUpDown Value="{Binding TextElement.CornerRadius, Mode=TwoWay}" Minimum="0" Maximum="64" Increment="1" FormatString="0" Height="26" FontSize="11" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Spacing="2">
                                        <TextBlock Text="Border Thick." Classes="inspector-label" />
                                        <NumericUpDown Value="{Binding TextElement.BorderThickness, Mode=TwoWay}" Minimum="0" Maximum="20" Increment="0.5" FormatString="0.0" Height="26" FontSize="11" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>

                            <!-- ========================================================= -->
                            <!-- CURVED & CIRCULAR TYPOGRAPHY STUDIO SECTION               -->
                            <!-- ========================================================= -->
                            <Border Background="{DynamicResource WinInputBgBrush}" BorderBrush="{DynamicResource WinBorderBrush}" BorderThickness="1.5" CornerRadius="8" Padding="10">
                                <StackPanel Spacing="8">
                                    <!-- Shape Mode Selector -->
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <materialIcons:MaterialIcon Kind="VectorCurve" Width="16" Height="16" Foreground="{DynamicResource WinAccentBrush}" />
                                            <TextBlock Text="Curved &amp; Circular Text" FontWeight="Bold" FontSize="11.5" Foreground="{DynamicResource WinTextBrush}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- Mode Toggle: Normal, Curved Arc, Circular, Bézier Curve -->
                                    <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="3">
                                        <Button Grid.Column="0" Classes="secondary-btn" Height="28" Padding="2"
                                                Classes.active="{Binding TextElement.ShapeMode, Converter={StaticResource EqualityConverter}, ConverterParameter=Normal}"
                                                Command="{Binding SetTextShapeModeCommand}" CommandParameter="Normal">
                                            <TextBlock Text="Straight" FontSize="10" />
                                        </Button>
                                        <Button Grid.Column="1" Classes="secondary-btn" Height="28" Padding="2"
                                                Classes.active="{Binding TextElement.ShapeMode, Converter={StaticResource EqualityConverter}, ConverterParameter=Curved}"
                                                Command="{Binding SetTextShapeModeCommand}" CommandParameter="Curved">
                                            <StackPanel Orientation="Horizontal" Spacing="2" HorizontalAlignment="Center">
                                                <materialIcons:MaterialIcon Kind="VectorCurve" Width="11" Height="11" />
                                                <TextBlock Text="Arc" FontSize="10" />
                                            </StackPanel>
                                        </Button>
                                        <Button Grid.Column="2" Classes="secondary-btn" Height="28" Padding="2"
                                                Classes.active="{Binding TextElement.ShapeMode, Converter={StaticResource EqualityConverter}, ConverterParameter=Circular}"
                                                Command="{Binding SetTextShapeModeCommand}" CommandParameter="Circular">
                                            <StackPanel Orientation="Horizontal" Spacing="2" HorizontalAlignment="Center">
                                                <materialIcons:MaterialIcon Kind="CircleOutline" Width="11" Height="11" />
                                                <TextBlock Text="Circle" FontSize="10" />
                                            </StackPanel>
                                        </Button>
                                        <Button Grid.Column="3" Classes="secondary-btn" Height="28" Padding="2"
                                                Classes.active="{Binding TextElement.ShapeMode, Converter={StaticResource EqualityConverter}, ConverterParameter=BezierCurve}"
                                                Command="{Binding SetTextShapeModeCommand}" CommandParameter="BezierCurve">
                                            <StackPanel Orientation="Horizontal" Spacing="2" HorizontalAlignment="Center">
                                                <materialIcons:MaterialIcon Kind="VectorBezier" Width="11" Height="11" />
                                                <TextBlock Text="Bézier" FontSize="10" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>

                                    <!-- CURVED MODE CONTROLS -->
                                    <StackPanel Spacing="6" IsVisible="{Binding TextElement.IsCurvedMode}">
                                        <!-- Curve Radius & Arc Sweep Angle -->
                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                                            <StackPanel Grid.Column="0" Spacing="2">
                                                <TextBlock Text="Curve Radius (pt)" Classes="inspector-label" />
                                                <NumericUpDown Value="{Binding TextElement.CurveRadius, Mode=TwoWay}" Minimum="20" Maximum="2000" Increment="10" FormatString="0" Height="26" FontSize="11" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Spacing="2">
                                                <TextBlock Text="Arc Angle (°)" Classes="inspector-label" />
                                                <NumericUpDown Value="{Binding TextElement.CurveArcAngle, Mode=TwoWay}" Minimum="10" Maximum="360" Increment="10" FormatString="0°" Height="26" FontSize="11" />
                                            </StackPanel>
                                        </Grid>

                                        <!-- Start Angle & Direction -->
                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                                            <StackPanel Grid.Column="0" Spacing="2">
                                                <TextBlock Text="Start Angle (°)" Classes="inspector-label" />
                                                <NumericUpDown Value="{Binding TextElement.CurveStartAngle, Mode=TwoWay}" Minimum="-180" Maximum="180" Increment="15" FormatString="0°" Height="26" FontSize="11" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Spacing="2">
                                                <TextBlock Text="Arch Direction" Classes="inspector-label" />
                                                <Button Classes="secondary-btn" Height="26" HorizontalAlignment="Stretch" Command="{Binding ToggleCurveDirectionCommand}">
                                                    <TextBlock Text="{Binding TextElement.CurveClockwise, Converter={x:Static converters:BooleanToFontWeightConverter.Instance}}" FontSize="10" />
                                                </Button>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Invert Text Checkbox -->
                                        <CheckBox IsChecked="{Binding TextElement.CurveInvert, Mode=TwoWay}">
                                            <TextBlock Text="Invert / Reverse Text Orientation" FontSize="10.5" />
                                        </CheckBox>
                                    </StackPanel>

                                    <!-- CIRCULAR MODE CONTROLS -->
                                    <StackPanel Spacing="6" IsVisible="{Binding TextElement.IsCircularMode}">
                                        <!-- Placement Buttons: Top Arc, Bottom Arc, Full Circle -->
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="Circular Placement" Classes="inspector-label" />
                                            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="4">
                                                <Button Grid.Column="0" Classes="secondary-btn" Height="26"
                                                        Classes.active="{Binding TextElement.CircularPlacement, Converter={StaticResource EqualityConverter}, ConverterParameter=TopArc}"
                                                        Command="{Binding SetCircularPlacementCommand}" CommandParameter="TopArc">
                                                    <TextBlock Text="Top Arc" FontSize="10" />
                                                </Button>
                                                <Button Grid.Column="1" Classes="secondary-btn" Height="26"
                                                        Classes.active="{Binding TextElement.CircularPlacement, Converter={StaticResource EqualityConverter}, ConverterParameter=BottomArc}"
                                                        Command="{Binding SetCircularPlacementCommand}" CommandParameter="BottomArc">
                                                    <TextBlock Text="Bottom Arc" FontSize="10" />
                                                </Button>
                                                <Button Grid.Column="2" Classes="secondary-btn" Height="26"
                                                        Classes.active="{Binding TextElement.CircularPlacement, Converter={StaticResource EqualityConverter}, ConverterParameter=FullCircle}"
                                                        Command="{Binding SetCircularPlacementCommand}" CommandParameter="FullCircle">
                                                    <TextBlock Text="Full Circle" FontSize="10" />
                                                </Button>
                                            </Grid>
                                        </StackPanel>

                                        <!-- Circle Radius & Start Angle -->
                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                                            <StackPanel Grid.Column="0" Spacing="2">
                                                <TextBlock Text="Circle Radius" Classes="inspector-label" />
                                                <NumericUpDown Value="{Binding TextElement.CurveRadius, Mode=TwoWay}" Minimum="20" Maximum="2000" Increment="5" FormatString="0 pt" Height="26" FontSize="11" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Spacing="2">
                                                <TextBlock Text="Rotation (°)" Classes="inspector-label" />
                                                <NumericUpDown Value="{Binding TextElement.CurveStartAngle, Mode=TwoWay}" Minimum="-180" Maximum="180" Increment="15" FormatString="0°" Height="26" FontSize="11" />
                                            </StackPanel>
                                        </Grid>

                                        <CheckBox IsChecked="{Binding TextElement.CurveInvert, Mode=TwoWay}">
                                            <TextBlock Text="Invert / Reverse Text Orientation" FontSize="10.5" />
                                        </CheckBox>
                                    </StackPanel>

                                    <!-- BÉZIER CURVE MODE CONTROLS -->
                                    <StackPanel Spacing="6" IsVisible="{Binding TextElement.IsBezierMode}">
                                        <!-- Bézier Presets -->
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="Curve Shape Presets" Classes="inspector-label" />
                                            <WrapPanel Orientation="Horizontal">
                                                <Button Classes="secondary-btn" Height="24" Padding="5,1" Margin="1" Command="{Binding SetBezierPresetCommand}" CommandParameter="Wave"><TextBlock Text="Wave" FontSize="9.5" /></Button>
                                                <Button Classes="secondary-btn" Height="24" Padding="5,1" Margin="1" Command="{Binding SetBezierPresetCommand}" CommandParameter="SCurve"><TextBlock Text="S-Curve" FontSize="9.5" /></Button>
                                                <Button Classes="secondary-btn" Height="24" Padding="5,1" Margin="1" Command="{Binding SetBezierPresetCommand}" CommandParameter="Bridge"><TextBlock Text="Bridge (Arch)" FontSize="9.5" /></Button>
                                                <Button Classes="secondary-btn" Height="24" Padding="5,1" Margin="1" Command="{Binding SetBezierPresetCommand}" CommandParameter="Valley"><TextBlock Text="Valley (Dip)" FontSize="9.5" /></Button>
                                                <Button Classes="secondary-btn" Height="24" Padding="5,1" Margin="1" Command="{Binding SetBezierPresetCommand}" CommandParameter="Rise"><TextBlock Text="Rise" FontSize="9.5" /></Button>
                                            </WrapPanel>
                                        </StackPanel>

                                        <!-- Control Point 1 & Control Point 2 -->
                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                                            <StackPanel Grid.Column="0" Spacing="2">
                                                <TextBlock Text="Control Pt 1 (X, Y)" Classes="inspector-label" />
                                                <Grid ColumnDefinitions="*,*" ColumnSpacing="2">
                                                    <NumericUpDown Grid.Column="0" Value="{Binding TextElement.BezierP1X, Mode=TwoWay}" Minimum="-0.5" Maximum="1.5" Increment="0.05" FormatString="0.00" Height="26" FontSize="10" />
                                                    <NumericUpDown Grid.Column="1" Value="{Binding TextElement.BezierP1Y, Mode=TwoWay}" Minimum="-0.5" Maximum="1.5" Increment="0.05" FormatString="0.00" Height="26" FontSize="10" />
                                                </Grid>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Spacing="2">
                                                <TextBlock Text="Control Pt 2 (X, Y)" Classes="inspector-label" />
                                                <Grid ColumnDefinitions="*,*" ColumnSpacing="2">
                                                    <NumericUpDown Grid.Column="0" Value="{Binding TextElement.BezierP2X, Mode=TwoWay}" Minimum="-0.5" Maximum="1.5" Increment="0.05" FormatString="0.00" Height="26" FontSize="10" />
                                                    <NumericUpDown Grid.Column="1" Value="{Binding TextElement.BezierP2Y, Mode=TwoWay}" Minimum="-0.5" Maximum="1.5" Increment="0.05" FormatString="0.00" Height="26" FontSize="10" />
                                                </Grid>
                                            </StackPanel>
                                        </Grid>

                                        <CheckBox IsChecked="{Binding TextElement.CurveInvert, Mode=TwoWay}">
                                            <TextBlock Text="Invert / Reverse Text Orientation" FontSize="10.5" />
                                        </CheckBox>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- ========================================================= -->
                            <!-- PER-CHARACTER TRANSFORMS & SCALING                        -->
                            <!-- ========================================================= -->
                            <Border Background="{StaticResource WinSubtleBgBrush}" CornerRadius="6" Padding="8" BorderThickness="1" BorderBrush="{DynamicResource WinBorderBrush}">
                                <StackPanel Spacing="6">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Grid.Column="0" Text="Glyph Offsets &amp; Scaling" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" />
                                        <Button Grid.Column="1" Classes="secondary-btn" Height="22" Padding="6,1" Command="{Binding ResetTextTransformsCommand}" ToolTip.Tip="Reset scale and baseline transforms">
                                            <TextBlock Text="Reset" FontSize="9.5" />
                                        </Button>
                                    </Grid>

                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                                        <StackPanel Grid.Column="0" Spacing="2">
                                            <TextBlock Text="Baseline Shift" Classes="inspector-label" />
                                            <NumericUpDown Value="{Binding TextElement.BaselineShift, Mode=TwoWay}" Minimum="-100" Maximum="100" Increment="1" FormatString="0 pt" Height="26" FontSize="10.5" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="2">
                                            <TextBlock Text="Char Rotation (°)" Classes="inspector-label" />
                                            <NumericUpDown Value="{Binding TextElement.CharacterRotation, Mode=TwoWay}" Minimum="-180" Maximum="180" Increment="5" FormatString="0°" Height="26" FontSize="10.5" />
                                        </StackPanel>
                                    </Grid>

                                    <Grid ColumnDefinitions="*,*,Auto,Auto" ColumnSpacing="6">
                                        <StackPanel Grid.Column="0" Spacing="2">
                                            <TextBlock Text="Scale X" Classes="inspector-label" />
                                            <NumericUpDown Value="{Binding TextElement.ScaleX, Mode=TwoWay}" Minimum="0.1" Maximum="5.0" Increment="0.1" FormatString="0.0" Height="26" FontSize="10.5" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="2">
                                            <TextBlock Text="Scale Y" Classes="inspector-label" />
                                            <NumericUpDown Value="{Binding TextElement.ScaleY, Mode=TwoWay}" Minimum="0.1" Maximum="5.0" Increment="0.1" FormatString="0.0" Height="26" FontSize="10.5" />
                                        </StackPanel>
                                        <Button Grid.Column="2" Classes="mini-tool-btn" Width="28" Height="26" Margin="0,14,0,0"
                                                Classes.active="{Binding TextElement.FlipX, FallbackValue=False}"
                                                Command="{Binding $parent[UserControl].((vm:InspectorViewModel)DataContext).ToggleTextFlipXCommand}"
                                                ToolTip.Tip="Flip Text Horizontally">
                                            <materialIcons:MaterialIcon Kind="FlipHorizontal" Width="14" Height="14" Foreground="{DynamicResource WinTextBrush}" />
                                        </Button>
                                        <Button Grid.Column="3" Classes="mini-tool-btn" Width="28" Height="26" Margin="0,14,0,0"
                                                Classes.active="{Binding TextElement.FlipY, FallbackValue=False}"
                                                Command="{Binding $parent[UserControl].((vm:InspectorViewModel)DataContext).ToggleTextFlipYCommand}"
                                                ToolTip.Tip="Flip Text Vertically">
                                            <materialIcons:MaterialIcon Kind="FlipVertical" Width="14" Height="14" Foreground="{DynamicResource WinTextBrush}" />
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </Border>

                    <!-- 2. SHAPE & BADGE CARD (Visible when Shape element is selected) -->
                    <Border Background="{DynamicResource WinBgBrush}" BorderBrush="{DynamicResource WinBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12"
                            IsVisible="{Binding ShapeElement, Converter={StaticResource NullToBooleanConverter}}">
                        <StackPanel Spacing="10">
                            <!-- Card Title -->
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <materialIcons:MaterialIcon Kind="ShapeOutline" Width="16" Height="16" Foreground="{DynamicResource WinAccentBrush}" />
                                <TextBlock Text="Shape Geometry &amp; Badges" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource WinTextBrush}" VerticalAlignment="Center" />
                            </StackPanel>                            <!-- Shape Type Selector Grid -->
                            <StackPanel Spacing="4">
                                <Button Classes="mini-tool-btn" HorizontalAlignment="Stretch" Padding="2,2"
                                        Command="{Binding TogglePresetGeometryExpandedCommand}"
                                        ToolTip.Tip="Collapse / Expand Preset Geometries">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Grid.Column="0" Text="Preset Geometry (Certificates &amp; Polygons)" Classes="inspector-label" VerticalAlignment="Center" />
                                        <materialIcons:MaterialIcon Grid.Column="1" Kind="{Binding IsPresetGeometryExpanded, Converter={StaticResource BooleanToStringConverter}, ConverterParameter='ChevronUp|ChevronDown'}" Width="14" Height="14" Foreground="{DynamicResource WinMutedBrush}" VerticalAlignment="Center" />
                                    </Grid>
                                </Button>
                                <Panel IsVisible="{Binding IsPresetGeometryExpanded}">
                                    <WrapPanel Orientation="Horizontal">
                                        <Button Classes="secondary-btn" Height="24" Padding="5,1" Margin="2" Command="{Binding SetShapeTypeCommand}" CommandParameter="Rectangle"><TextBlock Text="Rect" FontSize="10" /></Button>
                                        <Button Classes="secondary-btn" Height="24" Padding="5,1" Margin="2" Command="{Binding SetShapeTypeCommand}" CommandParameter="RoundedRectangle"><TextBlock Text="Rounded" FontSize="10" /></Button>
                                        <Button Classes="secondary-btn" Height="24" Padding="5,1" Margin="2" Command="{Binding SetShapeTypeCommand}" CommandParameter="Circle"><TextBlock Text="Circle" FontSize="10" /></Button>
                                        <Button Classes="secondary-btn" Height="24" Padding="5,1" Margin="2" Command="{Binding SetShapeTypeCommand}" CommandParameter="BezierCurve"><TextBlock Text="∿ Bézier Curve" FontSize="10" /></Button>
                                        <Button Classes="secondary-btn" Height="24" Padding="5,1" Margin="2" Command="{Binding SetShapeTypeCommand}" CommandParameter="CurvedArrow"><TextBlock Text="⤴ Curved Arrow" FontSize="10" /></Button>
                                        <Button Classes="secondary-btn" Height="24" Padding="5,1" Margin="2" Command="{Binding SetShapeTypeCommand}" CommandParameter="SCurveConnector"><TextBlock Text="⤹ S-Connector" FontSize="10" /></Button>
                                        <Button Classes="secondary-btn" Height="24" Padding="5,1" Margin="2" Command="{Binding SetShapeTypeCommand}" CommandParameter="WaveLine"><TextBlock Text="〰 Wave Line" FontSize="10" /></Button>
                                        <Button Classes="secondary-btn" Height="24" Padding="5,1" Margin="2" Command="{Binding SetShapeTypeCommand}" CommandParameter="ArcLine"><TextBlock Text="◠ Arc" FontSize="10" /></Button>
                                        <Button Classes="secondary-btn" Height="24" Padding="5,1" Margin="2" Command="{Binding SetShapeTypeCommand}" CommandParameter="CurlyBrace"><TextBlock Text="{}{ Curly Brace" FontSize="10" /></Button>
                                        <Button Classes="secondary-btn" Height="24" Padding="5,1" Margin="2" Command="{Binding SetShapeTypeCommand}" CommandParameter="CurvedCallout"><TextBlock Text="💬 Curved Bubble" FontSize="10" /></Button>
                                        <Button Classes="secondary-btn" Height="24" Padding="5,1" Margin="2" Command="{Binding SetShapeTypeCommand}" CommandParameter="Teardrop"><TextBlock Text="💧 Teardrop" FontSize="10" /></Button>
                                        <Button Classes="secondary-btn" Height="24" Padding="5,1" Margin="2" Command="{Binding SetShapeTypeCommand}" CommandParameter="WaveRibbon"><TextBlock Text="🎗 Wave Ribbon" FontSize="10" /></Button>
                                        <Button Classes="secondary-btn" Height="24" Padding="5,1" Margin="2" Command="{Binding SetShapeTypeCommand}" CommandParameter="OrganicBlob"><TextBlock Text="🫧 Blob" FontSize="10" /></Button>
                                        <Button Classes="secondary-btn" Height="24" Padding="5,1" Margin="2" Command="{Binding SetShapeTypeCommand}" CommandParameter="MedalRibbonBadge"><TextBlock Text="🎖 Medal Ribbon" FontSize="10" /></Button>
                                        <Button Classes="secondary-btn" Height="24" Padding="5,1" Margin="2" Command="{Binding SetShapeTypeCommand}" CommandParameter="LaurelWreathSeal"><TextBlock Text="🌿 Laurel Seal" FontSize="10" /></Button>
                                        <Button Classes="secondary-btn" Height="24" Padding="5,1" Margin="2" Command="{Binding SetShapeTypeCommand}" CommandParameter="RosetteSeal"><TextBlock Text="🏵 Rosette" FontSize="10" /></Button>
                                        <Button Classes="secondary-btn" Height="24" Padding="5,1" Margin="2" Command="{Binding SetShapeTypeCommand}" CommandParameter="RibbonBanner"><TextBlock Text="🎗 Banner" FontSize="10" /></Button>
                                        <Button Classes="secondary-btn" Height="24" Padding="5,1" Margin="2" Command="{Binding SetShapeTypeCommand}" CommandParameter="CornerPolygonalAccentTopLeft"><TextBlock Text="📐 Corner TL" FontSize="10" /></Button>
                                        <Button Classes="secondary-btn" Height="24" Padding="5,1" Margin="2" Command="{Binding SetShapeTypeCommand}" CommandParameter="CornerPolygonalAccentBottomRight"><TextBlock Text="📐 Corner BR" FontSize="10" /></Button>
                                        <Button Classes="secondary-btn" Height="24" Padding="5,1" Margin="2" Command="{Binding SetShapeTypeCommand}" CommandParameter="ShieldBadge"><TextBlock Text="🛡 Shield" FontSize="10" /></Button>
                                        <Button Classes="secondary-btn" Height="24" Padding="5,1" Margin="2" Command="{Binding SetShapeTypeCommand}" CommandParameter="Star5"><TextBlock Text="★ Star 5" FontSize="10" /></Button>
                                        <Button Classes="secondary-btn" Height="24" Padding="5,1" Margin="2" Command="{Binding SetShapeTypeCommand}" CommandParameter="Star8Badge"><TextBlock Text="✦ Star 8" FontSize="10" /></Button>
                                        <Button Classes="secondary-btn" Height="24" Padding="5,1" Margin="2" Command="{Binding SetShapeTypeCommand}" CommandParameter="Triangle"><TextBlock Text="Triangle" FontSize="10" /></Button>
                                        <Button Classes="secondary-btn" Height="24" Padding="5,1" Margin="2" Command="{Binding SetShapeTypeCommand}" CommandParameter="RightTriangle"><TextBlock Text="Rt. Tri" FontSize="10" /></Button>
                                        <Button Classes="secondary-btn" Height="24" Padding="5,1" Margin="2" Command="{Binding SetShapeTypeCommand}" CommandParameter="Diamond"><TextBlock Text="Diamond" FontSize="10" /></Button>
                                        <Button Classes="secondary-btn" Height="24" Padding="5,1" Margin="2" Command="{Binding SetShapeTypeCommand}" CommandParameter="Chevron"><TextBlock Text="Chevron" FontSize="10" /></Button>
                                        <Button Classes="secondary-btn" Height="24" Padding="5,1" Margin="2" Command="{Binding SetShapeTypeCommand}" CommandParameter="Trapezoid"><TextBlock Text="Trapezoid" FontSize="10" /></Button>
                                        <Button Classes="secondary-btn" Height="24" Padding="5,1" Margin="2" Command="{Binding SetShapeTypeCommand}" CommandParameter="Parallelogram"><TextBlock Text="Parallelogram" FontSize="10" /></Button>
                                        <Button Classes="secondary-btn" Height="24" Padding="5,1" Margin="2" Command="{Binding SetShapeTypeCommand}" CommandParameter="CustomSvgPath"><TextBlock Text="🖋 Custom SVG" FontSize="10" /></Button>
                                    </WrapPanel>
                                </Panel>
                            </StackPanel>

                            <!-- Line Dash Pattern & Endcaps (for Lines & Curves) -->
                            <StackPanel Spacing="4">
                                <Button Classes="mini-tool-btn" HorizontalAlignment="Stretch" Padding="2,2"
                                        Command="{Binding ToggleLineStrokePatternExpandedCommand}"
                                        ToolTip.Tip="Collapse / Expand Line Stroke Pattern">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Grid.Column="0" Text="Line Stroke Pattern" Classes="inspector-label" VerticalAlignment="Center" />
                                        <materialIcons:MaterialIcon Grid.Column="1" Kind="{Binding IsLineStrokePatternExpanded, Converter={StaticResource BooleanToStringConverter}, ConverterParameter='ChevronUp|ChevronDown'}" Width="14" Height="14" Foreground="{DynamicResource WinMutedBrush}" VerticalAlignment="Center" />
                                    </Grid>
                                </Button>
                                <Panel IsVisible="{Binding IsLineStrokePatternExpanded}">
                                    <WrapPanel Orientation="Horizontal">
                                        <Button Classes="secondary-btn" Height="24" Padding="6,1" Margin="2" Command="{Binding SetShapeDashStyleCommand}" CommandParameter="Solid"><TextBlock Text="— Solid" FontSize="10" /></Button>
                                        <Button Classes="secondary-btn" Height="24" Padding="6,1" Margin="2" Command="{Binding SetShapeDashStyleCommand}" CommandParameter="Dashed"><TextBlock Text="-- Dashed" FontSize="10" /></Button>
                                        <Button Classes="secondary-btn" Height="24" Padding="6,1" Margin="2" Command="{Binding SetShapeDashStyleCommand}" CommandParameter="Dotted"><TextBlock Text="·· Dotted" FontSize="10" /></Button>
                                        <Button Classes="secondary-btn" Height="24" Padding="6,1" Margin="2" Command="{Binding SetShapeDashStyleCommand}" CommandParameter="DashDot"><TextBlock Text="-·- Dash-Dot" FontSize="10" /></Button>
                                    </WrapPanel>
                                </Panel>
                            </StackPanel>

                            <!-- Custom SVG Path Data (Visible when CustomSvgPath is selected) -->
                            <StackPanel Spacing="3" IsVisible="{Binding ShapeElement.ShapeType, Converter={StaticResource EqualityConverter}, ConverterParameter=CustomSvgPath}">
                                <TextBlock Text="Custom Vector Path (SVG 'd')" Classes="inspector-label" />
                                <TextBox Text="{Binding ShapeElement.CustomPathData, Mode=TwoWay}"
                                         AcceptsReturn="True" TextWrapping="Wrap" Height="50" FontSize="11"
                                         PlaceholderText="e.g. M 0,0 L 100,0 L 50,100 Z" />
                            </StackPanel>

                            <!-- Colors Section (Fill, Secondary, Border) -->
                            <StackPanel Spacing="4">
                                <Button Classes="mini-tool-btn" HorizontalAlignment="Stretch" Padding="2,2"
                                        Command="{Binding ToggleColorsExpandedCommand}"
                                        ToolTip.Tip="Collapse / Expand Colors">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Grid.Column="0" Text="Fill &amp; Border Colors" Classes="inspector-label" VerticalAlignment="Center" />
                                        <materialIcons:MaterialIcon Grid.Column="1" Kind="{Binding IsColorsExpanded, Converter={StaticResource BooleanToStringConverter}, ConverterParameter='ChevronUp|ChevronDown'}" Width="14" Height="14" Foreground="{DynamicResource WinMutedBrush}" VerticalAlignment="Center" />
                                    </Grid>
                                </Button>
                                <StackPanel Spacing="8" IsVisible="{Binding IsColorsExpanded}">
                                    <!-- Fill Color Swatches & Custom ColorPicker -->
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Fill Color" Classes="inspector-label" />
                                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                            <Button Classes="color-studio-btn" ToolTip.Tip="Custom Shape Fill Studio">
                                                <Button.Flyout>
                                                    <Flyout Placement="BottomEdgeAlignedLeft">
                                                        <Border Background="{DynamicResource WinBgBrush}" BorderBrush="{DynamicResource WinBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10" BoxShadow="0 8 24 #30000000">
                                                            <ColorView Color="{Binding ShapeElement.FillColorHex, Mode=TwoWay, Converter={StaticResource HexToColorConverter}}"
                                                                       IsAlphaEnabled="True" IsHexInputVisible="True" Width="280" />
                                                        </Border>
                                                    </Flyout>
                                                </Button.Flyout>
                                                <Grid Width="24" Height="24">
                                                    <Border CornerRadius="12" Width="24" Height="24">
                                                        <Border.Background>
                                                            <ConicGradientBrush Center="0.5,0.5">
                                                                <GradientStop Color="#FF0000" Offset="0.0" /><GradientStop Color="#FFFF00" Offset="0.17" /><GradientStop Color="#00FF00" Offset="0.33" /><GradientStop Color="#00FFFF" Offset="0.50" /><GradientStop Color="#0000FF" Offset="0.67" /><GradientStop Color="#FF00FF" Offset="0.83" /><GradientStop Color="#FF0000" Offset="1.0" />
                                                            </ConicGradientBrush>
                                                        </Border.Background>
                                                    </Border>
                                                    <Border Margin="3.5" CornerRadius="9" Background="{DynamicResource WinPanelBrush}">
                                                        <materialIcons:MaterialIcon Kind="Palette" Width="11" Height="11" Foreground="{DynamicResource WinTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                </Grid>
                                            </Button>
                                            <ItemsControl ItemsSource="{Binding ColorSwatches}">
                                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="vm:ColorSwatchItem">
                                                        <Button Width="22" Height="22" Margin="1.5" CornerRadius="4" BorderBrush="{DynamicResource WinBorderBrush}" BorderThickness="1"
                                                                Background="{Binding Hex, Converter={StaticResource HexToBrushConverter}}"
                                                                Command="{Binding $parent[UserControl].((vm:InspectorViewModel)DataContext).SetShapeFillColorCommand}"
                                                                CommandParameter="{Binding Hex}" ToolTip.Tip="{Binding Name}" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Secondary Color (for Medal Ribbons / Dual-Tone Polygons) -->
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Secondary / Ribbon Tail Color" Classes="inspector-label" />
                                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                            <Button Classes="color-studio-btn" ToolTip.Tip="Secondary Accent Color">
                                                <Button.Flyout>
                                                    <Flyout Placement="BottomEdgeAlignedLeft">
                                                        <Border Background="{DynamicResource WinBgBrush}" BorderBrush="{DynamicResource WinBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10" BoxShadow="0 8 24 #30000000">
                                                            <ColorView Color="{Binding ShapeElement.SecondaryFillColorHex, Mode=TwoWay, Converter={StaticResource HexToColorConverter}}"
                                                                       IsAlphaEnabled="True" IsHexInputVisible="True" Width="280" />
                                                        </Border>
                                                    </Flyout>
                                                </Button.Flyout>
                                                <Grid Width="24" Height="24">
                                                    <Border CornerRadius="12" Width="24" Height="24" Background="{Binding ShapeElement.SecondaryFillColorHex, Converter={StaticResource HexToBrushConverter}}" />
                                                    <Border Margin="3.5" CornerRadius="9" Background="{DynamicResource WinPanelBrush}">
                                                        <materialIcons:MaterialIcon Kind="Ribbon" Width="11" Height="11" Foreground="{DynamicResource WinTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                </Grid>
                                            </Button>
                                            <Button Width="22" Height="22" Margin="1.5" CornerRadius="4" Background="#990000" Command="{Binding $parent[UserControl].((vm:InspectorViewModel)DataContext).SetShapeFillColorCommand}" CommandParameter="#990000" ToolTip.Tip="Crimson Red" />
                                            <Button Width="22" Height="22" Margin="1.5" CornerRadius="4" Background="#0F172A" Command="{Binding $parent[UserControl].((vm:InspectorViewModel)DataContext).SetShapeFillColorCommand}" CommandParameter="#0F172A" ToolTip.Tip="Navy Slate" />
                                            <Button Width="22" Height="22" Margin="1.5" CornerRadius="4" Background="#D97706" Command="{Binding $parent[UserControl].((vm:InspectorViewModel)DataContext).SetShapeFillColorCommand}" CommandParameter="#D97706" ToolTip.Tip="Gold Amber" />
                                            <Button Width="22" Height="22" Margin="1.5" CornerRadius="4" Background="#16A34A" Command="{Binding $parent[UserControl].((vm:InspectorViewModel)DataContext).SetShapeFillColorCommand}" CommandParameter="#16A34A" ToolTip.Tip="Emerald" />
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Stroke / Border Color Swatches & Custom ColorPicker -->
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Border / Stroke Color" Classes="inspector-label" />
                                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                            <Button Classes="color-studio-btn" ToolTip.Tip="Custom Stroke Color Studio">
                                                <Button.Flyout>
                                                    <Flyout Placement="BottomEdgeAlignedLeft">
                                                        <Border Background="{DynamicResource WinBgBrush}" BorderBrush="{DynamicResource WinBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10" BoxShadow="0 8 24 #30000000">
                                                            <ColorView Color="{Binding ShapeElement.StrokeColorHex, Mode=TwoWay, Converter={StaticResource HexToColorConverter}}"
                                                                       IsAlphaEnabled="True" IsHexInputVisible="True" Width="280" />
                                                        </Border>
                                                    </Flyout>
                                                </Button.Flyout>
                                                <Grid Width="24" Height="24">
                                                    <Border CornerRadius="12" Width="24" Height="24">
                                                        <Border.Background>
                                                            <ConicGradientBrush Center="0.5,0.5">
                                                                <GradientStop Color="#FF0000" Offset="0.0" /><GradientStop Color="#FFFF00" Offset="0.17" /><GradientStop Color="#00FF00" Offset="0.33" /><GradientStop Color="#00FFFF" Offset="0.50" /><GradientStop Color="#0000FF" Offset="0.67" /><GradientStop Color="#FF00FF" Offset="0.83" /><GradientStop Color="#FF0000" Offset="1.0" />
                                                            </ConicGradientBrush>
                                                        </Border.Background>
                                                    </Border>
                                                    <Border Margin="3.5" CornerRadius="9" Background="{DynamicResource WinPanelBrush}">
                                                        <materialIcons:MaterialIcon Kind="SquareOutline" Width="11" Height="11" Foreground="{DynamicResource WinTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                </Grid>
                                            </Button>
                                            <ItemsControl ItemsSource="{Binding ColorSwatches}">
                                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="vm:ColorSwatchItem">
                                                        <Button Width="22" Height="22" Margin="1.5" CornerRadius="4" BorderBrush="{DynamicResource WinBorderBrush}" BorderThickness="1"
                                                                Background="{Binding Hex, Converter={StaticResource HexToBrushConverter}}"
                                                                Command="{Binding $parent[UserControl].((vm:InspectorViewModel)DataContext).SetShapeStrokeColorCommand}"
                                                                CommandParameter="{Binding Hex}" ToolTip.Tip="{Binding Name}" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>

                            <!-- Radius, Border Width & Badge Text Section -->
                            <StackPanel Spacing="4">
                                <Button Classes="mini-tool-btn" HorizontalAlignment="Stretch" Padding="2,2"
                                        Command="{Binding ToggleDimensionsExpandedCommand}"
                                        ToolTip.Tip="Collapse / Expand Radius &amp; Dimensions">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Grid.Column="0" Text="Radius, Border &amp; Badge Text" Classes="inspector-label" VerticalAlignment="Center" />
                                        <materialIcons:MaterialIcon Grid.Column="1" Kind="{Binding IsDimensionsExpanded, Converter={StaticResource BooleanToStringConverter}, ConverterParameter='ChevronUp|ChevronDown'}" Width="14" Height="14" Foreground="{DynamicResource WinMutedBrush}" VerticalAlignment="Center" />
                                    </Grid>
                                </Button>
                                <StackPanel Spacing="8" IsVisible="{Binding IsDimensionsExpanded}">
                                    <!-- Corner Radius & Border Thickness -->
                                    <Grid ColumnDefinitions="*,*">
                                        <StackPanel Grid.Column="0" Spacing="3" Margin="0,0,4,0">
                                            <TextBlock Text="Corner Radius" Classes="inspector-label" />
                                            <NumericUpDown Value="{Binding ShapeElement.CornerRadius, Mode=TwoWay}"
                                                           Minimum="0" Maximum="100" Increment="1" FormatString="0"
                                                           HorizontalAlignment="Stretch" Height="28" FontSize="12" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Spacing="3" Margin="4,0,0,0">
                                            <TextBlock Text="Border Width" Classes="inspector-label" />
                                            <NumericUpDown Value="{Binding ShapeElement.StrokeThickness, Mode=TwoWay}"
                                                           Minimum="0" Maximum="20" Increment="0.5" FormatString="0.0"
                                                           HorizontalAlignment="Stretch" Height="28" FontSize="12" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- Shape Center Label (for Badges & Buttons) -->
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="Center Label / Badge Text" Classes="inspector-label" />
                                        <TextBox Text="{Binding ShapeElement.Label, Mode=TwoWay}" Height="28" FontSize="12" PlaceholderText="e.g. APPROVED, 1, ✦..." />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>

                            <Grid ColumnDefinitions="*,*" IsVisible="{Binding ShapeElement.Label, Converter={StaticResource NullToBooleanConverter}}">
                                <StackPanel Grid.Column="0" Spacing="3" Margin="0,0,4,0">
                                    <TextBlock Text="Label Size" Classes="inspector-label" />
                                    <NumericUpDown Value="{Binding ShapeElement.LabelFontSize, Mode=TwoWay}"
                                                   Minimum="8" Maximum="72" Increment="1" FormatString="0"
                                                   HorizontalAlignment="Stretch" Height="28" FontSize="12" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="3" Margin="4,0,0,0">
                                    <TextBlock Text="Label Color" Classes="inspector-label" />
                                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                        <Button Classes="color-studio-btn" ToolTip.Tip="Custom Label Color Studio">
                                            <Button.Flyout>
                                                <Flyout Placement="BottomEdgeAlignedLeft">
                                                    <Border Background="{DynamicResource WinBgBrush}" BorderBrush="{DynamicResource WinBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10" BoxShadow="0 8 24 #30000000">
                                                        <ColorView Color="{Binding ShapeElement.LabelColorHex, Mode=TwoWay, Converter={StaticResource HexToColorConverter}}"
                                                                   IsAlphaEnabled="True" IsHexInputVisible="True" Width="280" />
                                                    </Border>
                                                </Flyout>
                                            </Button.Flyout>
                                            <Grid Width="20" Height="20">
                                                <Border CornerRadius="10" Width="20" Height="20">
                                                    <Border.Background>
                                                        <ConicGradientBrush Center="0.5,0.5">
                                                            <GradientStop Color="#FF0000" Offset="0.0" /><GradientStop Color="#FFFF00" Offset="0.17" /><GradientStop Color="#00FF00" Offset="0.33" /><GradientStop Color="#00FFFF" Offset="0.50" /><GradientStop Color="#0000FF" Offset="0.67" /><GradientStop Color="#FF00FF" Offset="0.83" /><GradientStop Color="#FF0000" Offset="1.0" />
                                                        </ConicGradientBrush>
                                                    </Border.Background>
                                                </Border>
                                                <Border Margin="2.5" CornerRadius="8" Background="{DynamicResource WinPanelBrush}">
                                                    <materialIcons:MaterialIcon Kind="Palette" Width="9" Height="9" Foreground="{DynamicResource WinTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                            </Grid>
                                        </Button>
                                        <Button Width="20" Height="20" CornerRadius="10" Background="{DynamicResource WinPanelBrush}" BorderBrush="#94A3B8" BorderThickness="1" Command="{Binding SetShapeLabelColorCommand}" CommandParameter="#FFFFFF" />
                                        <Button Width="20" Height="20" CornerRadius="10" Background="#201F1E" Command="{Binding SetShapeLabelColorCommand}" CommandParameter="#201F1E" />
                                        <Button Width="20" Height="20" CornerRadius="10" Background="#0F6CBD" Command="{Binding SetShapeLabelColorCommand}" CommandParameter="#0F6CBD" />
                                        <Button Width="20" Height="20" CornerRadius="10" Background="#16A34A" Command="{Binding SetShapeLabelColorCommand}" CommandParameter="#16A34A" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 3. IMAGE CARD (Visible when Image is selected) -->
                    <Border Background="{DynamicResource WinBgBrush}" BorderBrush="{DynamicResource WinBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12"
                            IsVisible="{Binding ImageElement, Converter={StaticResource NullToBooleanConverter}}">
                        <StackPanel Spacing="10">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <materialIcons:MaterialIcon Kind="ImageOutline" Width="16" Height="16" Foreground="{DynamicResource WinAccentBrush}" />
                                <TextBlock Text="Image Properties" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource WinTextBrush}" VerticalAlignment="Center" />
                            </StackPanel>

                            <StackPanel Spacing="3">
                                <TextBlock Text="Alt Text / Caption" Classes="inspector-label" />
                                <TextBox Text="{Binding ImageElement.AltText, Mode=TwoWay}" Height="28" FontSize="12" />
                            </StackPanel>

                            <StackPanel Spacing="3">
                                <TextBlock Text="Image File Path" Classes="inspector-label" />
                                <TextBox Text="{Binding ImageElement.ImagePath, Mode=TwoWay}" Height="28" FontSize="11" PlaceholderText="/path/to/image.png" />
                            </StackPanel>

                            <Grid ColumnDefinitions="*,*">
                                <StackPanel Grid.Column="0" Spacing="3" Margin="0,0,4,0">
                                    <TextBlock Text="Corner Radius" Classes="inspector-label" />
                                    <NumericUpDown Value="{Binding ImageElement.CornerRadius, Mode=TwoWay}"
                                                   Minimum="0" Maximum="60" Increment="1" FormatString="0"
                                                   HorizontalAlignment="Stretch" Height="28" FontSize="12" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="3" Margin="4,0,0,0">
                                    <TextBlock Text="Border Width" Classes="inspector-label" />
                                    <NumericUpDown Value="{Binding ImageElement.BorderThickness, Mode=TwoWay}"
                                                   Minimum="0" Maximum="10" Increment="0.5" FormatString="0.0"
                                                   HorizontalAlignment="Stretch" Height="28" FontSize="12" />
                                </StackPanel>
                            </Grid>

                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="Preserve Aspect Ratio" FontSize="11.5" Foreground="{DynamicResource WinMutedBrush}" VerticalAlignment="Center" />
                                <ToggleSwitch Grid.Column="1" IsChecked="{Binding ImageElement.KeepAspectRatio, Mode=TwoWay}" OnContent="" OffContent="" Margin="0" />
                            </Grid>

                            <StackPanel Spacing="4">
                                <TextBlock Text="Border Color" Classes="inspector-label" />
                                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                    <Button Classes="color-studio-btn" ToolTip.Tip="Custom Border Color Studio">
                                        <Button.Flyout>
                                            <Flyout Placement="BottomEdgeAlignedLeft">
                                                <Border Background="{DynamicResource WinBgBrush}" BorderBrush="{DynamicResource WinBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10" BoxShadow="0 8 24 #30000000">
                                                    <ColorView Color="{Binding ImageElement.BorderColorHex, Mode=TwoWay, Converter={StaticResource HexToColorConverter}}"
                                                               IsAlphaEnabled="True" IsHexInputVisible="True" Width="280" />
                                                </Border>
                                            </Flyout>
                                        </Button.Flyout>
                                        <Grid Width="24" Height="24">
                                            <Border CornerRadius="12" Width="24" Height="24">
                                                <Border.Background>
                                                    <ConicGradientBrush Center="0.5,0.5">
                                                        <GradientStop Color="#FF0000" Offset="0.0" /><GradientStop Color="#FFFF00" Offset="0.17" /><GradientStop Color="#00FF00" Offset="0.33" /><GradientStop Color="#00FFFF" Offset="0.50" /><GradientStop Color="#0000FF" Offset="0.67" /><GradientStop Color="#FF00FF" Offset="0.83" /><GradientStop Color="#FF0000" Offset="1.0" />
                                                    </ConicGradientBrush>
                                                </Border.Background>
                                            </Border>
                                            <Border Margin="3.5" CornerRadius="9" Background="{DynamicResource WinPanelBrush}">
                                                <materialIcons:MaterialIcon Kind="Palette" Width="11" Height="11" Foreground="{DynamicResource WinTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                        </Grid>
                                    </Button>
                                    <ItemsControl ItemsSource="{Binding ColorSwatches}">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="vm:ColorSwatchItem">
                                                <Button Width="20" Height="20" Margin="1.5" CornerRadius="3" Background="{Binding Hex, Converter={StaticResource HexToBrushConverter}}"
                                                        Command="{Binding $parent[UserControl].((vm:InspectorViewModel)DataContext).SetImageBorderColorCommand}" CommandParameter="{Binding Hex}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 4. DIVIDER CARD (Visible when Divider is selected) -->
                    <Border Background="{DynamicResource WinBgBrush}" BorderBrush="{DynamicResource WinBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12"
                            IsVisible="{Binding DividerElement, Converter={StaticResource NullToBooleanConverter}}">
                        <StackPanel Spacing="10">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <materialIcons:MaterialIcon Kind="Minus" Width="16" Height="16" Foreground="{DynamicResource WinAccentBrush}" />
                                <TextBlock Text="Divider Line &amp; Decorative Wave" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource WinTextBrush}" VerticalAlignment="Center" />
                            </StackPanel>

                            <!-- Divider Style Presets -->
                            <StackPanel Spacing="4">
                                <TextBlock Text="Divider Style (6 Styles)" Classes="inspector-label" />
                                <WrapPanel Orientation="Horizontal">
                                    <Button Classes="secondary-btn" Height="24" Padding="6,1" Margin="2" Command="{Binding SetDividerStyleCommand}" CommandParameter="Straight"><TextBlock Text="— Straight" FontSize="10" /></Button>
                                    <Button Classes="secondary-btn" Height="24" Padding="6,1" Margin="2" Command="{Binding SetDividerStyleCommand}" CommandParameter="Wave"><TextBlock Text="〰 Wave" FontSize="10" /></Button>
                                    <Button Classes="secondary-btn" Height="24" Padding="6,1" Margin="2" Command="{Binding SetDividerStyleCommand}" CommandParameter="SCurve"><TextBlock Text="∿ S-Curve" FontSize="10" /></Button>
                                    <Button Classes="secondary-btn" Height="24" Padding="6,1" Margin="2" Command="{Binding SetDividerStyleCommand}" CommandParameter="Arch"><TextBlock Text="◠ Arch" FontSize="10" /></Button>
                                    <Button Classes="secondary-btn" Height="24" Padding="6,1" Margin="2" Command="{Binding SetDividerStyleCommand}" CommandParameter="DoubleWave"><TextBlock Text="≋ Double Wave" FontSize="10" /></Button>
                                    <Button Classes="secondary-btn" Height="24" Padding="6,1" Margin="2" Command="{Binding SetDividerStyleCommand}" CommandParameter="CalligraphicFlourish"><TextBlock Text="❦ Flourish" FontSize="10" /></Button>
                                </WrapPanel>
                            </StackPanel>

                            <!-- Wave Parameters (Amplitude & Frequency) -->
                            <Grid ColumnDefinitions="*,*" Margin="0,2">
                                <StackPanel Grid.Column="0" Spacing="3" Margin="0,0,4,0">
                                    <TextBlock Text="Wave Amplitude (px)" Classes="inspector-label" />
                                    <NumericUpDown Value="{Binding DividerElement.WaveAmplitude, Mode=TwoWay}"
                                                   Minimum="2" Maximum="50" Increment="1" FormatString="0.0"
                                                   HorizontalAlignment="Stretch" Height="28" FontSize="12" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="3" Margin="4,0,0,0">
                                    <TextBlock Text="Wave Cycles" Classes="inspector-label" />
                                    <NumericUpDown Value="{Binding DividerElement.WaveFrequency, Mode=TwoWay}"
                                                   Minimum="1" Maximum="20" Increment="1" FormatString="0"
                                                   HorizontalAlignment="Stretch" Height="28" FontSize="12" />
                                </StackPanel>
                            </Grid>

                            <!-- Line Dash Pattern -->
                            <StackPanel Spacing="4">
                                <TextBlock Text="Dash Pattern" Classes="inspector-label" />
                                <WrapPanel Orientation="Horizontal">
                                    <Button Classes="secondary-btn" Height="24" Padding="6,1" Margin="2" Command="{Binding SetDividerDashStyleCommand}" CommandParameter="Solid"><TextBlock Text="— Solid" FontSize="10" /></Button>
                                    <Button Classes="secondary-btn" Height="24" Padding="6,1" Margin="2" Command="{Binding SetDividerDashStyleCommand}" CommandParameter="Dashed"><TextBlock Text="-- Dashed" FontSize="10" /></Button>
                                    <Button Classes="secondary-btn" Height="24" Padding="6,1" Margin="2" Command="{Binding SetDividerDashStyleCommand}" CommandParameter="Dotted"><TextBlock Text="·· Dotted" FontSize="10" /></Button>
                                    <Button Classes="secondary-btn" Height="24" Padding="6,1" Margin="2" Command="{Binding SetDividerDashStyleCommand}" CommandParameter="DashDot"><TextBlock Text="-·- Dash-Dot" FontSize="10" /></Button>
                                </WrapPanel>
                            </StackPanel>

                            <StackPanel Spacing="3">
                                <TextBlock Text="Line Thickness (pt)" Classes="inspector-label" />
                                <NumericUpDown Value="{Binding DividerElement.Thickness, Mode=TwoWay}"
                                               Minimum="0.5" Maximum="20" Increment="0.5" FormatString="0.0"
                                               HorizontalAlignment="Stretch" Height="28" FontSize="12" />
                            </StackPanel>

                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="Vertical Divider" FontSize="11.5" Foreground="{DynamicResource WinMutedBrush}" VerticalAlignment="Center" />
                                <ToggleSwitch Grid.Column="1" IsChecked="{Binding DividerElement.IsVertical, Mode=TwoWay}" OnContent="" OffContent="" Margin="0" />
                            </Grid>

                            <StackPanel Spacing="4">
                                <TextBlock Text="Line Color" Classes="inspector-label" />
                                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                    <Button Classes="color-studio-btn" ToolTip.Tip="Custom Line Color Studio">
                                        <Button.Flyout>
                                            <Flyout Placement="BottomEdgeAlignedLeft">
                                                <Border Background="{DynamicResource WinBgBrush}" BorderBrush="{DynamicResource WinBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10" BoxShadow="0 8 24 #30000000">
                                                    <ColorView Color="{Binding DividerElement.ColorHex, Mode=TwoWay, Converter={StaticResource HexToColorConverter}}"
                                                               IsAlphaEnabled="True" IsHexInputVisible="True" Width="280" />
                                                </Border>
                                            </Flyout>
                                        </Button.Flyout>
                                        <Grid Width="24" Height="24">
                                            <Border CornerRadius="12" Width="24" Height="24">
                                                <Border.Background>
                                                    <ConicGradientBrush Center="0.5,0.5">
                                                        <GradientStop Color="#FF0000" Offset="0.0" /><GradientStop Color="#FFFF00" Offset="0.17" /><GradientStop Color="#00FF00" Offset="0.33" /><GradientStop Color="#00FFFF" Offset="0.50" /><GradientStop Color="#0000FF" Offset="0.67" /><GradientStop Color="#FF00FF" Offset="0.83" /><GradientStop Color="#FF0000" Offset="1.0" />
                                                    </ConicGradientBrush>
                                                </Border.Background>
                                            </Border>
                                            <Border Margin="3.5" CornerRadius="9" Background="{DynamicResource WinPanelBrush}">
                                                <materialIcons:MaterialIcon Kind="Palette" Width="11" Height="11" Foreground="{DynamicResource WinTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                        </Grid>
                                    </Button>
                                    <ItemsControl ItemsSource="{Binding ColorSwatches}">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="vm:ColorSwatchItem">
                                                <Button Width="20" Height="20" Margin="1.5" CornerRadius="10" Background="{Binding Hex, Converter={StaticResource HexToBrushConverter}}"
                                                        Command="{Binding $parent[UserControl].((vm:InspectorViewModel)DataContext).SetDividerColorCommand}" CommandParameter="{Binding Hex}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 5. TABLE STYLES & ROW/COL CARD (Visible when Table is selected) -->
                    <Border Background="{DynamicResource WinBgBrush}" BorderBrush="{DynamicResource WinBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12"
                            IsVisible="{Binding TableElement, Converter={StaticResource NullToBooleanConverter}}">
                        <StackPanel Spacing="10">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <materialIcons:MaterialIcon Kind="TableHeadersEye" Width="16" Height="16" Foreground="{DynamicResource WinAccentBrush}" />
                                <TextBlock Text="Table Styles (8 Themes)" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource WinTextBrush}" VerticalAlignment="Center" />
                            </StackPanel>

                            <!-- Table Style Presets -->
                            <StackPanel Spacing="4">
                                <TextBlock Text="Apply Preset Theme" Classes="inspector-label" />
                                <WrapPanel Orientation="Horizontal">
                                    <Button Classes="secondary-btn" Height="24" Padding="5,1" Margin="2" Command="{Binding ApplyTableStyleCommand}" CommandParameter="ModernMinimal"><TextBlock Text="Minimal" FontSize="10" /></Button>
                                    <Button Classes="secondary-btn" Height="24" Padding="5,1" Margin="2" Command="{Binding ApplyTableStyleCommand}" CommandParameter="EnterpriseBlue"><TextBlock Text="Enterprise" FontSize="10" /></Button>
                                    <Button Classes="secondary-btn" Height="24" Padding="5,1" Margin="2" Command="{Binding ApplyTableStyleCommand}" CommandParameter="DarkModeSlate"><TextBlock Text="Dark Slate" FontSize="10" /></Button>
                                    <Button Classes="secondary-btn" Height="24" Padding="5,1" Margin="2" Command="{Binding ApplyTableStyleCommand}" CommandParameter="ZebraStriped"><TextBlock Text="Zebra" FontSize="10" /></Button>
                                    <Button Classes="secondary-btn" Height="24" Padding="5,1" Margin="2" Command="{Binding ApplyTableStyleCommand}" CommandParameter="EmeraldGreen"><TextBlock Text="Emerald" FontSize="10" /></Button>
                                    <Button Classes="secondary-btn" Height="24" Padding="5,1" Margin="2" Command="{Binding ApplyTableStyleCommand}" CommandParameter="AmberAccent"><TextBlock Text="Amber" FontSize="10" /></Button>
                                    <Button Classes="secondary-btn" Height="24" Padding="5,1" Margin="2" Command="{Binding ApplyTableStyleCommand}" CommandParameter="FinancialBordered"><TextBlock Text="Financial" FontSize="10" /></Button>
                                    <Button Classes="secondary-btn" Height="24" Padding="5,1" Margin="2" Command="{Binding ApplyTableStyleCommand}" CommandParameter="CompactClean"><TextBlock Text="Compact" FontSize="10" /></Button>
                                </WrapPanel>
                            </StackPanel>

                            <!-- Add / Remove Rows and Columns -->
                            <TextBlock Text="Structure &amp; Dimensions" Classes="inspector-label" />
                            <Grid ColumnDefinitions="*,*" Margin="0,2">
                                <Button Grid.Column="0" Classes="secondary-btn" Height="28" Margin="0,0,3,0"
                                        Command="{Binding TableElement.AddRowCommand}" ToolTip.Tip="Add Table Row">
                                    <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                                        <materialIcons:MaterialIcon Kind="TableRowPlusAfter" Width="14" Height="14" Foreground="{DynamicResource WinMutedBrush}" />
                                        <TextBlock Text="Add Row" FontSize="11" />
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="1" Classes="secondary-btn" Height="28" Margin="3,0,0,0"
                                        Command="{Binding TableElement.RemoveRowCommand}" ToolTip.Tip="Delete Table Row">
                                    <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                                        <materialIcons:MaterialIcon Kind="TableRowRemove" Width="14" Height="14" Foreground="{DynamicResource WinDangerBrush}" />
                                        <TextBlock Text="Del Row" FontSize="11" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <Grid ColumnDefinitions="*,*" Margin="0,2">
                                <Button Grid.Column="0" Classes="secondary-btn" Height="28" Margin="0,0,3,0"
                                        Command="{Binding TableElement.AddColumnCommand}" ToolTip.Tip="Add Table Column">
                                    <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                                        <materialIcons:MaterialIcon Kind="TableColumnPlusAfter" Width="14" Height="14" Foreground="{DynamicResource WinMutedBrush}" />
                                        <TextBlock Text="Add Col" FontSize="11" />
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="1" Classes="secondary-btn" Height="28" Margin="3,0,0,0"
                                        Command="{Binding TableElement.RemoveColumnCommand}" ToolTip.Tip="Delete Table Column">
                                    <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                                        <materialIcons:MaterialIcon Kind="TableColumnRemove" Width="14" Height="14" Foreground="{DynamicResource WinDangerBrush}" />
                                        <TextBlock Text="Del Col" FontSize="11" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <!-- Data Source & Studio -->
                            <TextBlock Text="Data Source &amp; Connector" Classes="inspector-label" Margin="0,4,0,0" />
                            <Button Classes="accent-btn" Height="28" Command="{Binding OpenDataStudioForTableCommand}" ToolTip.Tip="Open Data Studio to import from Excel, CSV, REST API, or Grid">
                                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                    <materialIcons:MaterialIcon Kind="DatabaseArrowDownOutline" Width="14" Height="14" />
                                    <TextBlock Text="Open Data Studio..." FontSize="11" />
                                </StackPanel>
                            </Button>

                            <Grid ColumnDefinitions="*,*">
                                <Button Grid.Column="0" Classes="secondary-btn" Height="26" Margin="0,0,2,0" Command="{Binding QuickPasteDataToTableCommand}" ToolTip.Tip="Paste TSV/CSV from clipboard into table">
                                    <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                                        <materialIcons:MaterialIcon Kind="ContentPaste" Width="13" Height="13" Foreground="{DynamicResource WinAccentBrush}" />
                                        <TextBlock Text="Paste Table" FontSize="10.5" />
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="1" Classes="secondary-btn" Height="26" Margin="2,0,0,0" Command="{Binding ConvertTableToChartCommand}" ToolTip.Tip="Convert this Table into a LiveCharts2 Chart">
                                    <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                                        <materialIcons:MaterialIcon Kind="ChartBoxOutline" Width="13" Height="13" Foreground="{DynamicResource WinAccentBrush}" />
                                        <TextBlock Text="To Chart" FontSize="10.5" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 6. CHART CONFIG CARD (Visible when Chart is selected) -->
                    <Border Background="{DynamicResource WinBgBrush}" BorderBrush="{DynamicResource WinBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12"
                            IsVisible="{Binding ChartElement, Converter={StaticResource NullToBooleanConverter}}">
                        <StackPanel Spacing="10">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <materialIcons:MaterialIcon Kind="ChartBar" Width="16" Height="16" Foreground="{DynamicResource WinAccentBrush}" />
                                <TextBlock Text="LiveCharts2 Engine (17 Kinds)" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource WinTextBrush}" VerticalAlignment="Center" />
                            </StackPanel>

                            <!-- Chart Types Selector -->
                            <StackPanel Spacing="4">
                                <TextBlock Text="Select Chart Kind" Classes="inspector-label" />
                                <WrapPanel Orientation="Horizontal">
                                    <Button Classes="secondary-btn" Height="24" Padding="5,1" Margin="2" Command="{Binding SetChartTypeCommand}" CommandParameter="BarColumn"><TextBlock Text="Columns" FontSize="10" /></Button>
                                    <Button Classes="secondary-btn" Height="24" Padding="5,1" Margin="2" Command="{Binding SetChartTypeCommand}" CommandParameter="HorizontalBar"><TextBlock Text="H-Bar" FontSize="10" /></Button>
                                    <Button Classes="secondary-btn" Height="24" Padding="5,1" Margin="2" Command="{Binding SetChartTypeCommand}" CommandParameter="StackedBar"><TextBlock Text="Stacked" FontSize="10" /></Button>
                                    <Button Classes="secondary-btn" Height="24" Padding="5,1" Margin="2" Command="{Binding SetChartTypeCommand}" CommandParameter="StackedHorizontalBar"><TextBlock Text="Stacked-H" FontSize="10" /></Button>
                                    <Button Classes="secondary-btn" Height="24" Padding="5,1" Margin="2" Command="{Binding SetChartTypeCommand}" CommandParameter="Line"><TextBlock Text="Line" FontSize="10" /></Button>
                                    <Button Classes="secondary-btn" Height="24" Padding="5,1" Margin="2" Command="{Binding SetChartTypeCommand}" CommandParameter="SmoothLine"><TextBlock Text="Spline" FontSize="10" /></Button>
                                    <Button Classes="secondary-btn" Height="24" Padding="5,1" Margin="2" Command="{Binding SetChartTypeCommand}" CommandParameter="Area"><TextBlock Text="Area" FontSize="10" /></Button>
                                    <Button Classes="secondary-btn" Height="24" Padding="5,1" Margin="2" Command="{Binding SetChartTypeCommand}" CommandParameter="StepLine"><TextBlock Text="Step" FontSize="10" /></Button>
                                    <Button Classes="secondary-btn" Height="24" Padding="5,1" Margin="2" Command="{Binding SetChartTypeCommand}" CommandParameter="DonutPie"><TextBlock Text="Donut" FontSize="10" /></Button>
                                    <Button Classes="secondary-btn" Height="24" Padding="5,1" Margin="2" Command="{Binding SetChartTypeCommand}" CommandParameter="GaugeProgress"><TextBlock Text="Gauge" FontSize="10" /></Button>
                                    <Button Classes="secondary-btn" Height="24" Padding="5,1" Margin="2" Command="{Binding SetChartTypeCommand}" CommandParameter="ScatterPlot"><TextBlock Text="Scatter" FontSize="10" /></Button>
                                    <Button Classes="secondary-btn" Height="24" Padding="5,1" Margin="2" Command="{Binding SetChartTypeCommand}" CommandParameter="Radar"><TextBlock Text="Radar" FontSize="10" /></Button>
                                    <Button Classes="secondary-btn" Height="24" Padding="5,1" Margin="2" Command="{Binding SetChartTypeCommand}" CommandParameter="PolarArea"><TextBlock Text="Polar" FontSize="10" /></Button>
                                    <Button Classes="secondary-btn" Height="24" Padding="5,1" Margin="2" Command="{Binding SetChartTypeCommand}" CommandParameter="Candlestick"><TextBlock Text="Candle" FontSize="10" /></Button>
                                    <Button Classes="secondary-btn" Height="24" Padding="5,1" Margin="2" Command="{Binding SetChartTypeCommand}" CommandParameter="Waterfall"><TextBlock Text="Waterfall" FontSize="10" /></Button>
                                </WrapPanel>
                            </StackPanel>

                            <!-- Color Palette Selector -->
                            <StackPanel Spacing="4">
                                <TextBlock Text="Color Palette" Classes="inspector-label" />
                                <WrapPanel Orientation="Horizontal">
                                    <Button Classes="secondary-btn" Height="22" Padding="4,1" Margin="1" Command="{Binding SetChartPaletteCommand}" CommandParameter="CorporateBlue"><TextBlock Text="Corporate" FontSize="9.5" /></Button>
                                    <Button Classes="secondary-btn" Height="22" Padding="4,1" Margin="1" Command="{Binding SetChartPaletteCommand}" CommandParameter="EmeraldGreen"><TextBlock Text="Emerald" FontSize="9.5" /></Button>
                                    <Button Classes="secondary-btn" Height="22" Padding="4,1" Margin="1" Command="{Binding SetChartPaletteCommand}" CommandParameter="SunsetOrange"><TextBlock Text="Sunset" FontSize="9.5" /></Button>
                                    <Button Classes="secondary-btn" Height="22" Padding="4,1" Margin="1" Command="{Binding SetChartPaletteCommand}" CommandParameter="CyberNeon"><TextBlock Text="Cyber" FontSize="9.5" /></Button>
                                    <Button Classes="secondary-btn" Height="22" Padding="4,1" Margin="1" Command="{Binding SetChartPaletteCommand}" CommandParameter="ExecutiveSlate"><TextBlock Text="Slate" FontSize="9.5" /></Button>
                                    <Button Classes="secondary-btn" Height="22" Padding="4,1" Margin="1" Command="{Binding SetChartPaletteCommand}" CommandParameter="PastelHarmony"><TextBlock Text="Pastel" FontSize="9.5" /></Button>
                                    <Button Classes="secondary-btn" Height="22" Padding="4,1" Margin="1" Command="{Binding SetChartPaletteCommand}" CommandParameter="VibrantRainbow"><TextBlock Text="Rainbow" FontSize="9.5" /></Button>
                                </WrapPanel>
                            </StackPanel>

                            <!-- Legend Position Selector -->
                            <StackPanel Spacing="4">
                                <TextBlock Text="Legend Placement" Classes="inspector-label" />
                                <Grid ColumnDefinitions="*,*,*,*,*">
                                    <Button Grid.Column="0" Classes="secondary-btn" Height="22" Padding="2,1" Margin="1" Command="{Binding SetChartLegendPositionCommand}" CommandParameter="Top"><TextBlock Text="Top" FontSize="9" HorizontalAlignment="Center" /></Button>
                                    <Button Grid.Column="1" Classes="secondary-btn" Height="22" Padding="2,1" Margin="1" Command="{Binding SetChartLegendPositionCommand}" CommandParameter="Bottom"><TextBlock Text="Btm" FontSize="9" HorizontalAlignment="Center" /></Button>
                                    <Button Grid.Column="2" Classes="secondary-btn" Height="22" Padding="2,1" Margin="1" Command="{Binding SetChartLegendPositionCommand}" CommandParameter="Left"><TextBlock Text="Left" FontSize="9" HorizontalAlignment="Center" /></Button>
                                    <Button Grid.Column="3" Classes="secondary-btn" Height="22" Padding="2,1" Margin="1" Command="{Binding SetChartLegendPositionCommand}" CommandParameter="Right"><TextBlock Text="Right" FontSize="9" HorizontalAlignment="Center" /></Button>
                                    <Button Grid.Column="4" Classes="secondary-btn" Height="22" Padding="2,1" Margin="1" Command="{Binding SetChartLegendPositionCommand}" CommandParameter="Hidden"><TextBlock Text="Off" FontSize="9" HorizontalAlignment="Center" /></Button>
                                </Grid>
                            </StackPanel>

                            <!-- Display Options Toggles -->
                            <Grid ColumnDefinitions="*,*">
                                <CheckBox Grid.Column="0" Content="Data Labels" IsChecked="{Binding ChartElement.ShowDataLabels, Mode=TwoWay}" FontSize="11" />
                                <CheckBox Grid.Column="1" Content="Gridlines" IsChecked="{Binding ChartElement.ShowGridlines, Mode=TwoWay}" FontSize="11" />
                            </Grid>

                            <!-- Donut Hole Slider (Visible for Donut) -->
                            <StackPanel Spacing="3" IsVisible="{Binding ChartElement.IsDonutPie}">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Text="Donut Hole Ratio" Classes="inspector-label" />
                                    <TextBlock Grid.Column="1" Text="{Binding ChartElement.DonutHoleRatio, StringFormat='{}{0:F2}'}" FontSize="10" Foreground="{DynamicResource WinMutedBrush}" />
                                </Grid>
                                <Slider Value="{Binding ChartElement.DonutHoleRatio, Mode=TwoWay}" Minimum="0.1" Maximum="0.85" SmallChange="0.05" Height="24" />
                            </StackPanel>

                            <!-- Curve Smoothness Slider (Visible for Spline / Area) -->
                            <StackPanel Spacing="3" IsVisible="{Binding ChartElement.IsSmoothLine}">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Text="Curve Tension" Classes="inspector-label" />
                                    <TextBlock Grid.Column="1" Text="{Binding ChartElement.CurveSmoothness, StringFormat='{}{0:F2}'}" FontSize="10" Foreground="{DynamicResource WinMutedBrush}" />
                                </Grid>
                                <Slider Value="{Binding ChartElement.CurveSmoothness, Mode=TwoWay}" Minimum="0.0" Maximum="1.0" SmallChange="0.05" Height="24" />
                            </StackPanel>

                            <StackPanel Spacing="3">
                                <TextBlock Text="Chart Title" Classes="inspector-label" />
                                <TextBox Text="{Binding ChartElement.Title, Mode=TwoWay}" Height="28" FontSize="12" />
                            </StackPanel>

                            <Grid ColumnDefinitions="*,*" Margin="0,2">
                                <Button Grid.Column="0" Classes="secondary-btn" Height="28" Margin="0,0,3,0"
                                        Command="{Binding ChartElement.AddDataPointCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                                        <materialIcons:MaterialIcon Kind="Plus" Width="14" Height="14" Foreground="{DynamicResource WinAccentBrush}" />
                                        <TextBlock Text="Add Point" FontSize="11" />
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="1" Classes="secondary-btn" Height="28" Margin="3,0,0,0"
                                        Command="{Binding ChartElement.RemoveDataPointCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                                        <materialIcons:MaterialIcon Kind="Minus" Width="14" Height="14" Foreground="{DynamicResource WinDangerBrush}" />
                                        <TextBlock Text="Del Point" FontSize="11" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <!-- Data Source & Studio -->
                            <TextBlock Text="Data Source &amp; Connector" Classes="inspector-label" Margin="0,4,0,0" />
                            <Button Classes="accent-btn" Height="28" Command="{Binding OpenDataStudioForChartCommand}" ToolTip.Tip="Open Data Studio to import from Excel, CSV, REST API, or Grid">
                                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                    <materialIcons:MaterialIcon Kind="DatabaseArrowDownOutline" Width="14" Height="14" />
                                    <TextBlock Text="Open Data Studio..." FontSize="11" />
                                </StackPanel>
                            </Button>

                            <Grid ColumnDefinitions="*,*">
                                <Button Grid.Column="0" Classes="secondary-btn" Height="26" Margin="0,0,2,0" Command="{Binding QuickPasteDataToChartCommand}" ToolTip.Tip="Paste TSV/CSV from clipboard into chart">
                                    <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                                        <materialIcons:MaterialIcon Kind="ContentPaste" Width="13" Height="13" Foreground="{DynamicResource WinAccentBrush}" />
                                        <TextBlock Text="Paste Data" FontSize="10.5" />
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="1" Classes="secondary-btn" Height="26" Margin="2,0,0,0" Command="{Binding ConvertChartToTableCommand}" ToolTip.Tip="Convert this Chart into an editable Table">
                                    <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                                        <materialIcons:MaterialIcon Kind="Table" Width="13" Height="13" Foreground="{DynamicResource WinAccentBrush}" />
                                        <TextBlock Text="To Table" FontSize="10.5" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 7. WATERMARK CARD (Visible when Watermark is selected) -->
                    <Border Background="{DynamicResource WinBgBrush}" BorderBrush="{DynamicResource WinBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12"
                            IsVisible="{Binding WatermarkElement, Converter={StaticResource NullToBooleanConverter}}">
                        <StackPanel Spacing="10">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <materialIcons:MaterialIcon Kind="Watermark" Width="16" Height="16" Foreground="{DynamicResource WinAccentBrush}" />
                                <TextBlock Text="Watermark Settings" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource WinTextBrush}" VerticalAlignment="Center" />
                            </StackPanel>

                            <StackPanel Spacing="3">
                                <TextBlock Text="Watermark Text" Classes="inspector-label" />
                                <TextBox Text="{Binding WatermarkElement.Text, Mode=TwoWay}" Height="28" FontSize="12" />
                            </StackPanel>

                            <Grid ColumnDefinitions="*,*">
                                <StackPanel Grid.Column="0" Spacing="3" Margin="0,0,4,0">
                                    <TextBlock Text="Font Size" Classes="inspector-label" />
                                    <NumericUpDown Value="{Binding WatermarkElement.FontSize, Mode=TwoWay}"
                                                   Minimum="20" Maximum="120" Increment="1" FormatString="0"
                                                   HorizontalAlignment="Stretch" Height="28" FontSize="12" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="3" Margin="4,0,0,0">
                                    <TextBlock Text="Angle (°)" Classes="inspector-label" />
                                    <NumericUpDown Value="{Binding WatermarkElement.Angle, Mode=TwoWay}"
                                                   Minimum="-90" Maximum="90" Increment="5" FormatString="0°"
                                                   HorizontalAlignment="Stretch" Height="28" FontSize="12" />
                                </StackPanel>
                            </Grid>

                            <StackPanel Spacing="3">
                                <TextBlock Text="Opacity" Classes="inspector-label" />
                                <Slider Value="{Binding WatermarkElement.Opacity, Mode=TwoWay}" Minimum="0.05" Maximum="1.0" Height="28" />
                            </StackPanel>

                            <StackPanel Spacing="4">
                                <TextBlock Text="Watermark Color" Classes="inspector-label" />
                                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                    <Button Classes="color-studio-btn" ToolTip.Tip="Custom Watermark Color Studio">
                                        <Button.Flyout>
                                            <Flyout Placement="BottomEdgeAlignedLeft">
                                                <Border Background="{DynamicResource WinBgBrush}" BorderBrush="{DynamicResource WinBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10" BoxShadow="0 8 24 #30000000">
                                                    <ColorView Color="{Binding WatermarkElement.ColorHex, Mode=TwoWay, Converter={StaticResource HexToColorConverter}}"
                                                               IsAlphaEnabled="True" IsHexInputVisible="True" Width="280" />
                                                </Border>
                                            </Flyout>
                                        </Button.Flyout>
                                        <Grid Width="24" Height="24">
                                            <Border CornerRadius="12" Width="24" Height="24">
                                                <Border.Background>
                                                    <ConicGradientBrush Center="0.5,0.5">
                                                        <GradientStop Color="#FF0000" Offset="0.0" /><GradientStop Color="#FFFF00" Offset="0.17" /><GradientStop Color="#00FF00" Offset="0.33" /><GradientStop Color="#00FFFF" Offset="0.50" /><GradientStop Color="#0000FF" Offset="0.67" /><GradientStop Color="#FF00FF" Offset="0.83" /><GradientStop Color="#FF0000" Offset="1.0" />
                                                    </ConicGradientBrush>
                                                </Border.Background>
                                            </Border>
                                            <Border Margin="3.5" CornerRadius="9" Background="{DynamicResource WinPanelBrush}">
                                                <materialIcons:MaterialIcon Kind="Palette" Width="11" Height="11" Foreground="{DynamicResource WinTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                        </Grid>
                                    </Button>
                                    <ItemsControl ItemsSource="{Binding ColorSwatches}">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="vm:ColorSwatchItem">
                                                <Button Width="20" Height="20" Margin="1.5" CornerRadius="10" Background="{Binding Hex, Converter={StaticResource HexToBrushConverter}}"
                                                        Command="{Binding $parent[UserControl].((vm:InspectorViewModel)DataContext).SetWatermarkColorCommand}" CommandParameter="{Binding Hex}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 8. ACROFORMS CARD (Visible when Form Field is selected) -->
                    <Border Background="{DynamicResource WinBgBrush}" BorderBrush="{DynamicResource WinBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12"
                            IsVisible="{Binding FormFieldElement, Converter={StaticResource NullToBooleanConverter}}">
                        <StackPanel Spacing="10">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <materialIcons:MaterialIcon Kind="FormTextbox" Width="16" Height="16" Foreground="{DynamicResource WinAccentBrush}" />
                                <TextBlock Text="AcroForm Field Setup" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource WinTextBrush}" VerticalAlignment="Center" />
                            </StackPanel>

                            <!-- Field Type Switcher Chips -->
                            <StackPanel Spacing="3">
                                <TextBlock Text="Field Control Type" Classes="inspector-label" />
                                <WrapPanel Orientation="Horizontal">
                                    <Button Classes="secondary-btn" Height="24" Padding="5,1" Margin="2" Command="{Binding SetFormFieldTypeCommand}" CommandParameter="Text"><TextBlock Text="Text" FontSize="10" /></Button>
                                    <Button Classes="secondary-btn" Height="24" Padding="5,1" Margin="2" Command="{Binding SetFormFieldTypeCommand}" CommandParameter="MultilineText"><TextBlock Text="Textarea" FontSize="10" /></Button>
                                    <Button Classes="secondary-btn" Height="24" Padding="5,1" Margin="2" Command="{Binding SetFormFieldTypeCommand}" CommandParameter="Checkbox"><TextBlock Text="☑ Check" FontSize="10" /></Button>
                                    <Button Classes="secondary-btn" Height="24" Padding="5,1" Margin="2" Command="{Binding SetFormFieldTypeCommand}" CommandParameter="Radio"><TextBlock Text="◉ Radio" FontSize="10" /></Button>
                                    <Button Classes="secondary-btn" Height="24" Padding="5,1" Margin="2" Command="{Binding SetFormFieldTypeCommand}" CommandParameter="Dropdown"><TextBlock Text="▼ Select" FontSize="10" /></Button>
                                    <Button Classes="secondary-btn" Height="24" Padding="5,1" Margin="2" Command="{Binding SetFormFieldTypeCommand}" CommandParameter="DatePicker"><TextBlock Text="📅 Date" FontSize="10" /></Button>
                                    <Button Classes="secondary-btn" Height="24" Padding="5,1" Margin="2" Command="{Binding SetFormFieldTypeCommand}" CommandParameter="Number"><TextBlock Text="123 Num" FontSize="10" /></Button>
                                    <Button Classes="secondary-btn" Height="24" Padding="5,1" Margin="2" Command="{Binding SetFormFieldTypeCommand}" CommandParameter="SignatureLine"><TextBlock Text="✍ Signature" FontSize="10" /></Button>
                                    <Button Classes="secondary-btn" Height="24" Padding="5,1" Margin="2" Command="{Binding SetFormFieldTypeCommand}" CommandParameter="Button"><TextBlock Text="Button" FontSize="10" /></Button>
                                </WrapPanel>
                            </StackPanel>

                            <StackPanel Spacing="3">
                                <TextBlock Text="Field Label" Classes="inspector-label" />
                                <TextBox Text="{Binding FormFieldElement.Label, Mode=TwoWay}" Height="28" FontSize="12" />
                            </StackPanel>

                            <StackPanel Spacing="3">
                                <TextBlock Text="Placeholder / Default Value" Classes="inspector-label" />
                                <TextBox Text="{Binding FormFieldElement.Placeholder, Mode=TwoWay}" Height="28" FontSize="12" />
                            </StackPanel>

                            <StackPanel Spacing="3">
                                <TextBlock Text="Validation Rule Preset" Classes="inspector-label" />
                                <WrapPanel Orientation="Horizontal">
                                    <Button Classes="secondary-btn" Height="24" Padding="5,1" Margin="2" Command="{Binding SetFormFieldValidationCommand}" CommandParameter="None"><TextBlock Text="None" FontSize="10" /></Button>
                                    <Button Classes="secondary-btn" Height="24" Padding="5,1" Margin="2" Command="{Binding SetFormFieldValidationCommand}" CommandParameter="Email"><TextBlock Text="Email" FontSize="10" /></Button>
                                    <Button Classes="secondary-btn" Height="24" Padding="5,1" Margin="2" Command="{Binding SetFormFieldValidationCommand}" CommandParameter="Numeric"><TextBlock Text="123" FontSize="10" /></Button>
                                    <Button Classes="secondary-btn" Height="24" Padding="5,1" Margin="2" Command="{Binding SetFormFieldValidationCommand}" CommandParameter="Phone"><TextBlock Text="Phone" FontSize="10" /></Button>
                                    <Button Classes="secondary-btn" Height="24" Padding="5,1" Margin="2" Command="{Binding SetFormFieldValidationCommand}" CommandParameter="Date"><TextBlock Text="Date" FontSize="10" /></Button>
                                </WrapPanel>
                            </StackPanel>

                            <Grid ColumnDefinitions="*,*">
                                <CheckBox Grid.Column="0" IsChecked="{Binding FormFieldElement.IsRequired, Mode=TwoWay}">
                                    <TextBlock Text="Required (*)" FontSize="11.5" />
                                </CheckBox>
                                <CheckBox Grid.Column="1" IsChecked="{Binding FormFieldElement.IsReadOnly, Mode=TwoWay}">
                                    <TextBlock Text="Read Only" FontSize="11.5" />
                                </CheckBox>
                            </Grid>

                            <!-- Calculation Formula (Acrobat Feature) -->
                            <StackPanel Spacing="3">
                                <TextBlock Text="Field Calculation / Formula" Classes="inspector-label" />
                                <WrapPanel Orientation="Horizontal">
                                    <Button Classes="secondary-btn" Height="24" Padding="5,1" Margin="2" Command="{Binding SetFormFieldCalculationCommand}" CommandParameter="None"><TextBlock Text="None" FontSize="10" /></Button>
                                    <Button Classes="secondary-btn" Height="24" Padding="5,1" Margin="2" Command="{Binding SetFormFieldCalculationCommand}" CommandParameter="Sum"><TextBlock Text="Sum (+)" FontSize="10" /></Button>
                                    <Button Classes="secondary-btn" Height="24" Padding="5,1" Margin="2" Command="{Binding SetFormFieldCalculationCommand}" CommandParameter="Average"><TextBlock Text="Avg" FontSize="10" /></Button>
                                    <Button Classes="secondary-btn" Height="24" Padding="5,1" Margin="2" Command="{Binding SetFormFieldCalculationCommand}" CommandParameter="Product"><TextBlock Text="Product (×)" FontSize="10" /></Button>
                                    <Button Classes="secondary-btn" Height="24" Padding="5,1" Margin="2" Command="{Binding SetFormFieldCalculationCommand}" CommandParameter="Min"><TextBlock Text="Min" FontSize="10" /></Button>
                                    <Button Classes="secondary-btn" Height="24" Padding="5,1" Margin="2" Command="{Binding SetFormFieldCalculationCommand}" CommandParameter="Max"><TextBlock Text="Max" FontSize="10" /></Button>
                                </WrapPanel>
                            </StackPanel>

                            <StackPanel Spacing="3">
                                <TextBlock Text="Calculation Source Fields (comma-separated)" Classes="inspector-label" />
                                <TextBox Text="{Binding FormFieldElement.CalculationSourceFields, Mode=TwoWay}" Height="28" FontSize="11.5" PlaceholderText="e.g. subtotal, tax_rate" />
                            </StackPanel>

                            <StackPanel Spacing="4">
                                <TextBlock Text="Border Color" Classes="inspector-label" />
                                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                    <Button Classes="color-studio-btn" ToolTip.Tip="Custom Field Border Color Studio">
                                        <Button.Flyout>
                                            <Flyout Placement="BottomEdgeAlignedLeft">
                                                <Border Background="{DynamicResource WinBgBrush}" BorderBrush="{DynamicResource WinBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10" BoxShadow="0 8 24 #30000000">
                                                    <ColorView Color="{Binding FormFieldElement.BorderColorHex, Mode=TwoWay, Converter={StaticResource HexToColorConverter}}"
                                                               IsAlphaEnabled="True" IsHexInputVisible="True" Width="280" />
                                                </Border>
                                            </Flyout>
                                        </Button.Flyout>
                                        <Grid Width="24" Height="24">
                                            <Border CornerRadius="12" Width="24" Height="24">
                                                <Border.Background>
                                                    <ConicGradientBrush Center="0.5,0.5">
                                                        <GradientStop Color="#FF0000" Offset="0.0" /><GradientStop Color="#FFFF00" Offset="0.17" /><GradientStop Color="#00FF00" Offset="0.33" /><GradientStop Color="#00FFFF" Offset="0.50" /><GradientStop Color="#0000FF" Offset="0.67" /><GradientStop Color="#FF00FF" Offset="0.83" /><GradientStop Color="#FF0000" Offset="1.0" />
                                                    </ConicGradientBrush>
                                                </Border.Background>
                                            </Border>
                                            <Border Margin="3.5" CornerRadius="9" Background="{DynamicResource WinPanelBrush}">
                                                <materialIcons:MaterialIcon Kind="Palette" Width="11" Height="11" Foreground="{DynamicResource WinTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                        </Grid>
                                    </Button>
                                    <ItemsControl ItemsSource="{Binding ColorSwatches}">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="vm:ColorSwatchItem">
                                                <Button Width="20" Height="20" Margin="1.5" CornerRadius="3" Background="{Binding Hex, Converter={StaticResource HexToBrushConverter}}"
                                                        Command="{Binding $parent[UserControl].((vm:InspectorViewModel)DataContext).SetFormFieldBorderColorCommand}" CommandParameter="{Binding Hex}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 9. QR CODE CARD (Visible when QR Code is selected) -->
                    <Border Background="{DynamicResource WinBgBrush}" BorderBrush="{DynamicResource WinBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12"
                            IsVisible="{Binding QrCodeElement, Converter={StaticResource NullToBooleanConverter}}">
                        <StackPanel Spacing="10">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <materialIcons:MaterialIcon Kind="Qrcode" Width="16" Height="16" Foreground="{DynamicResource WinAccentBrush}" />
                                <TextBlock Text="QR Code Studio &amp; Presets" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource WinTextBrush}" VerticalAlignment="Center" />
                            </StackPanel>

                            <StackPanel Spacing="3">
                                <TextBlock Text="Quick Payload Presets" Classes="inspector-label" />
                                <WrapPanel Orientation="Horizontal">
                                    <Button Classes="secondary-btn" Height="24" Padding="5,1" Margin="2" Command="{Binding ApplyQrPresetCommand}" CommandParameter="Url"><TextBlock Text="🔗 URL" FontSize="10" /></Button>
                                    <Button Classes="secondary-btn" Height="24" Padding="5,1" Margin="2" Command="{Binding ApplyQrPresetCommand}" CommandParameter="Wifi"><TextBlock Text="📶 Wi-Fi" FontSize="10" /></Button>
                                    <Button Classes="secondary-btn" Height="24" Padding="5,1" Margin="2" Command="{Binding ApplyQrPresetCommand}" CommandParameter="VCard"><TextBlock Text="👤 vCard" FontSize="10" /></Button>
                                    <Button Classes="secondary-btn" Height="24" Padding="5,1" Margin="2" Command="{Binding ApplyQrPresetCommand}" CommandParameter="Email"><TextBlock Text="✉ Email" FontSize="10" /></Button>
                                    <Button Classes="secondary-btn" Height="24" Padding="5,1" Margin="2" Command="{Binding ApplyQrPresetCommand}" CommandParameter="PhoneCall"><TextBlock Text="📞 Phone" FontSize="10" /></Button>
                                    <Button Classes="secondary-btn" Height="24" Padding="5,1" Margin="2" Command="{Binding ApplyQrPresetCommand}" CommandParameter="Sms"><TextBlock Text="💬 SMS" FontSize="10" /></Button>
                                    <Button Classes="secondary-btn" Height="24" Padding="5,1" Margin="2" Command="{Binding ApplyQrPresetCommand}" CommandParameter="CryptoAddress"><TextBlock Text="₿ Crypto" FontSize="10" /></Button>
                                    <Button Classes="secondary-btn" Height="24" Padding="5,1" Margin="2" Command="{Binding ApplyQrPresetCommand}" CommandParameter="GeoLocation"><TextBlock Text="📍 GPS" FontSize="10" /></Button>
                                    <Button Classes="secondary-btn" Height="24" Padding="5,1" Margin="2" Command="{Binding ApplyQrPresetCommand}" CommandParameter="EventCalendar"><TextBlock Text="📅 Event" FontSize="10" /></Button>
                                    <Button Classes="secondary-btn" Height="24" Padding="5,1" Margin="2" Command="{Binding ApplyQrPresetCommand}" CommandParameter="PlainText"><TextBlock Text="📄 Text" FontSize="10" /></Button>
                                </WrapPanel>
                            </StackPanel>

                            <StackPanel Spacing="3">
                                <TextBlock Text="Target URL / Payload" Classes="inspector-label" />
                                <TextBox Text="{Binding QrCodeElement.Content, Mode=TwoWay}"
                                         AcceptsReturn="True" TextWrapping="Wrap" Height="50" FontSize="11" />
                            </StackPanel>

                            <StackPanel Spacing="3">
                                <TextBlock Text="Label Text" Classes="inspector-label" />
                                <TextBox Text="{Binding QrCodeElement.Label, Mode=TwoWay}" Height="28" FontSize="12" />
                            </StackPanel>

                            <!-- Error Correction Level (ECC) -->
                            <StackPanel Spacing="3">
                                <TextBlock Text="Error Correction (ECC)" Classes="inspector-label" />
                                <Grid ColumnDefinitions="*,*,*,*">
                                    <Button Grid.Column="0" Classes="secondary-btn" Height="24" Padding="2" Margin="1" Command="{Binding SetQrCodeEccLevelCommand}" CommandParameter="L" ToolTip.Tip="Low (7% recovery)">
                                        <TextBlock Text="L (7%)" FontSize="9.5" HorizontalAlignment="Center" />
                                    </Button>
                                    <Button Grid.Column="1" Classes="secondary-btn" Height="24" Padding="2" Margin="1" Command="{Binding SetQrCodeEccLevelCommand}" CommandParameter="M" ToolTip.Tip="Medium (15% recovery)">
                                        <TextBlock Text="M (15%)" FontSize="9.5" HorizontalAlignment="Center" />
                                    </Button>
                                    <Button Grid.Column="2" Classes="secondary-btn" Height="24" Padding="2" Margin="1" Command="{Binding SetQrCodeEccLevelCommand}" CommandParameter="Q" ToolTip.Tip="Quartile (25% recovery)">
                                        <TextBlock Text="Q (25%)" FontSize="9.5" HorizontalAlignment="Center" />
                                    </Button>
                                    <Button Grid.Column="3" Classes="secondary-btn" Height="24" Padding="2" Margin="1" Command="{Binding SetQrCodeEccLevelCommand}" CommandParameter="H" ToolTip.Tip="High (30% recovery)">
                                        <TextBlock Text="H (30%)" FontSize="9.5" HorizontalAlignment="Center" />
                                    </Button>
                                </Grid>
                            </StackPanel>

                            <!-- Foreground (Dark) Color -->
                            <StackPanel Spacing="4">
                                <TextBlock Text="QR Code Color" Classes="inspector-label" />
                                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                    <Button Classes="color-studio-btn" ToolTip.Tip="Custom QR Color Studio">
                                        <Button.Flyout>
                                            <Flyout Placement="BottomEdgeAlignedLeft">
                                                <Border Background="{DynamicResource WinBgBrush}" BorderBrush="{DynamicResource WinBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10" BoxShadow="0 8 24 #30000000">
                                                    <ColorView Color="{Binding QrCodeElement.DarkColorHex, Mode=TwoWay, Converter={StaticResource HexToColorConverter}}"
                                                               IsAlphaEnabled="True" IsHexInputVisible="True" Width="280" />
                                                </Border>
                                            </Flyout>
                                        </Button.Flyout>
                                        <Grid Width="24" Height="24">
                                            <Border CornerRadius="12" Width="24" Height="24">
                                                <Border.Background>
                                                    <ConicGradientBrush Center="0.5,0.5">
                                                        <GradientStop Color="#FF0000" Offset="0.0" /><GradientStop Color="#FFFF00" Offset="0.17" /><GradientStop Color="#00FF00" Offset="0.33" /><GradientStop Color="#00FFFF" Offset="0.50" /><GradientStop Color="#0000FF" Offset="0.67" /><GradientStop Color="#FF00FF" Offset="0.83" /><GradientStop Color="#FF0000" Offset="1.0" />
                                                    </ConicGradientBrush>
                                                </Border.Background>
                                            </Border>
                                            <Border Margin="3.5" CornerRadius="9" Background="{DynamicResource WinPanelBrush}">
                                                <materialIcons:MaterialIcon Kind="Palette" Width="11" Height="11" Foreground="{DynamicResource WinTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                        </Grid>
                                    </Button>
                                    <ItemsControl ItemsSource="{Binding ColorSwatches}">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="vm:ColorSwatchItem">
                                                <Button Width="20" Height="20" Margin="1.5" CornerRadius="10" Background="{Binding Hex, Converter={StaticResource HexToBrushConverter}}"
                                                        Command="{Binding $parent[UserControl].((vm:InspectorViewModel)DataContext).SetQrCodeDarkColorCommand}" CommandParameter="{Binding Hex}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </StackPanel>

                            <!-- Background (Light) Color -->
                            <StackPanel Spacing="4">
                                <TextBlock Text="Background Color" Classes="inspector-label" />
                                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                    <Button Classes="color-studio-btn" ToolTip.Tip="Custom QR Background Color Studio">
                                        <Button.Flyout>
                                            <Flyout Placement="BottomEdgeAlignedLeft">
                                                <Border Background="{DynamicResource WinBgBrush}" BorderBrush="{DynamicResource WinBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10" BoxShadow="0 8 24 #30000000">
                                                    <ColorView Color="{Binding QrCodeElement.LightColorHex, Mode=TwoWay, Converter={StaticResource HexToColorConverter}}"
                                                               IsAlphaEnabled="True" IsHexInputVisible="True" Width="280" />
                                                </Border>
                                            </Flyout>
                                        </Button.Flyout>
                                        <Grid Width="24" Height="24">
                                            <Border CornerRadius="12" Width="24" Height="24" Background="{Binding QrCodeElement.LightColorHex, Converter={StaticResource HexToBrushConverter}}" BorderBrush="{DynamicResource WinBorderBrush}" BorderThickness="1" />
                                            <Border Margin="3.5" CornerRadius="9" Background="Transparent">
                                                <materialIcons:MaterialIcon Kind="FormatColorFill" Width="11" Height="11" Foreground="{DynamicResource WinTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                        </Grid>
                                    </Button>
                                    <Button Width="20" Height="20" Margin="1.5" CornerRadius="10" Background="{DynamicResource WinPanelBrush}" BorderBrush="{DynamicResource WinBorderBrush}" BorderThickness="1" Command="{Binding SetQrCodeLightColorCommand}" CommandParameter="#FFFFFF" ToolTip.Tip="White" />
                                    <Button Width="20" Height="20" Margin="1.5" CornerRadius="10" Background="{DynamicResource WinInputBgBrush}" BorderBrush="{DynamicResource WinBorderBrush}" BorderThickness="1" Command="{Binding SetQrCodeLightColorCommand}" CommandParameter="#F8FAFC" ToolTip.Tip="Slate Light" />
                                    <Button Width="20" Height="20" Margin="1.5" CornerRadius="10" Background="#FEF3C7" BorderBrush="{DynamicResource WinBorderBrush}" BorderThickness="1" Command="{Binding SetQrCodeLightColorCommand}" CommandParameter="#FEF3C7" ToolTip.Tip="Amber Light" />
                                    <Button Width="20" Height="20" Margin="1.5" CornerRadius="10" Background="#EFF6FF" BorderBrush="{DynamicResource WinBorderBrush}" BorderThickness="1" Command="{Binding SetQrCodeLightColorCommand}" CommandParameter="#EFF6FF" ToolTip.Tip="Blue Light" />
                                </StackPanel>
                            </StackPanel>

                            <!-- Quiet Zones Toggle -->
                            <CheckBox IsChecked="{Binding QrCodeElement.DrawQuietZones, Mode=TwoWay}">
                                <TextBlock Text="Include Quiet Zones (Margin)" FontSize="11" Foreground="{DynamicResource WinMutedBrush}" VerticalAlignment="Center" />
                            </CheckBox>
                        </StackPanel>
                    </Border>


                    <!-- 10. BARCODE CARD (Visible when Barcode is selected) -->
                    <Border Background="{DynamicResource WinBgBrush}" BorderBrush="{DynamicResource WinBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12"
                            IsVisible="{Binding BarcodeElement, Converter={StaticResource NullToBooleanConverter}}">
                        <StackPanel Spacing="10">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <materialIcons:MaterialIcon Kind="Barcode" Width="16" Height="16" Foreground="{DynamicResource WinAccentBrush}" />
                                <TextBlock Text="Barcode Standards (7 Formats)" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource WinTextBrush}" VerticalAlignment="Center" />
                            </StackPanel>

                            <StackPanel Spacing="3">
                                <TextBlock Text="Select Barcode Standard" Classes="inspector-label" />
                                <WrapPanel Orientation="Horizontal">
                                    <Button Classes="secondary-btn" Height="24" Padding="5,1" Margin="2" Command="{Binding SetBarcodeFormatCommand}" CommandParameter="Code128"><TextBlock Text="Code128" FontSize="10" /></Button>
                                    <Button Classes="secondary-btn" Height="24" Padding="5,1" Margin="2" Command="{Binding SetBarcodeFormatCommand}" CommandParameter="Code39"><TextBlock Text="Code39" FontSize="10" /></Button>
                                    <Button Classes="secondary-btn" Height="24" Padding="5,1" Margin="2" Command="{Binding SetBarcodeFormatCommand}" CommandParameter="Ean13"><TextBlock Text="EAN-13" FontSize="10" /></Button>
                                    <Button Classes="secondary-btn" Height="24" Padding="5,1" Margin="2" Command="{Binding SetBarcodeFormatCommand}" CommandParameter="UpcA"><TextBlock Text="UPC-A" FontSize="10" /></Button>
                                    <Button Classes="secondary-btn" Height="24" Padding="5,1" Margin="2" Command="{Binding SetBarcodeFormatCommand}" CommandParameter="Itf14"><TextBlock Text="ITF-14" FontSize="10" /></Button>
                                    <Button Classes="secondary-btn" Height="24" Padding="5,1" Margin="2" Command="{Binding SetBarcodeFormatCommand}" CommandParameter="Codabar"><TextBlock Text="Codabar" FontSize="10" /></Button>
                                    <Button Classes="secondary-btn" Height="24" Padding="5,1" Margin="2" Command="{Binding SetBarcodeFormatCommand}" CommandParameter="Pdf417"><TextBlock Text="PDF417" FontSize="10" /></Button>
                                </WrapPanel>
                            </StackPanel>

                            <StackPanel Spacing="3">
                                <TextBlock Text="Code Value" Classes="inspector-label" />
                                <TextBox Text="{Binding BarcodeElement.CodeValue, Mode=TwoWay}" Height="28" FontSize="12" />
                            </StackPanel>

                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="Show Text Underneath" VerticalAlignment="Center" FontSize="11.5" Foreground="{DynamicResource WinMutedBrush}" />
                                <ToggleSwitch Grid.Column="1" IsChecked="{Binding BarcodeElement.ShowText, Mode=TwoWay}" OnContent="" OffContent="" Margin="0" />
                            </Grid>

                            <StackPanel Spacing="4">
                                <TextBlock Text="Barcode Color" Classes="inspector-label" />
                                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                    <Button Classes="color-studio-btn" ToolTip.Tip="Custom Barcode Color Studio">
                                        <Button.Flyout>
                                            <Flyout Placement="BottomEdgeAlignedLeft">
                                                <Border Background="{DynamicResource WinBgBrush}" BorderBrush="{DynamicResource WinBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10" BoxShadow="0 8 24 #30000000">
                                                    <ColorView Color="{Binding BarcodeElement.BarColorHex, Mode=TwoWay, Converter={StaticResource HexToColorConverter}}"
                                                               IsAlphaEnabled="True" IsHexInputVisible="True" Width="280" />
                                                </Border>
                                            </Flyout>
                                        </Button.Flyout>
                                        <Grid Width="24" Height="24">
                                            <Border CornerRadius="12" Width="24" Height="24">
                                                <Border.Background>
                                                    <ConicGradientBrush Center="0.5,0.5">
                                                        <GradientStop Color="#FF0000" Offset="0.0" /><GradientStop Color="#FFFF00" Offset="0.17" /><GradientStop Color="#00FF00" Offset="0.33" /><GradientStop Color="#00FFFF" Offset="0.50" /><GradientStop Color="#0000FF" Offset="0.67" /><GradientStop Color="#FF00FF" Offset="0.83" /><GradientStop Color="#FF0000" Offset="1.0" />
                                                    </ConicGradientBrush>
                                                </Border.Background>
                                            </Border>
                                            <Border Margin="3.5" CornerRadius="9" Background="{DynamicResource WinPanelBrush}">
                                                <materialIcons:MaterialIcon Kind="Palette" Width="11" Height="11" Foreground="{DynamicResource WinTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                        </Grid>
                                    </Button>
                                    <ItemsControl ItemsSource="{Binding ColorSwatches}">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="vm:ColorSwatchItem">
                                                <Button Width="20" Height="20" Margin="1.5" CornerRadius="10" Background="{Binding Hex, Converter={StaticResource HexToBrushConverter}}"
                                                        Command="{Binding $parent[UserControl].((vm:InspectorViewModel)DataContext).SetBarcodeColorCommand}" CommandParameter="{Binding Hex}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 11. REDACTION CARD (Visible when Redaction block is selected) -->
                    <Border Background="{DynamicResource WinBgBrush}" BorderBrush="{DynamicResource WinBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12"
                            IsVisible="{Binding RedactionElement, Converter={StaticResource NullToBooleanConverter}}">
                        <StackPanel Spacing="10">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <materialIcons:MaterialIcon Kind="EyeOffOutline" Width="16" Height="16" Foreground="{DynamicResource WinDangerBrush}" />
                                <TextBlock Text="Legal Redaction Exemption" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource WinDangerBrush}" VerticalAlignment="Center" />
                            </StackPanel>

                            <StackPanel Spacing="3">
                                <TextBlock Text="Exemption Code / Rationale" Classes="inspector-label" />
                                <TextBox Text="{Binding RedactionElement.ExemptionCode, Mode=TwoWay}" Height="28" FontSize="12" />
                            </StackPanel>

                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="Show Exemption Text" VerticalAlignment="Center" FontSize="11.5" Foreground="{DynamicResource WinMutedBrush}" />
                                <ToggleSwitch Grid.Column="1" IsChecked="{Binding RedactionElement.ShowOverlayText, Mode=TwoWay}" OnContent="" OffContent="" Margin="0" />
                            </Grid>

                            <StackPanel Spacing="4">
                                <TextBlock Text="Redaction Fill Style" Classes="inspector-label" />
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <Button Classes="color-studio-btn" ToolTip.Tip="Custom Redaction Color Studio">
                                        <Button.Flyout>
                                            <Flyout Placement="BottomEdgeAlignedLeft">
                                                <Border Background="{DynamicResource WinBgBrush}" BorderBrush="{DynamicResource WinBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10" BoxShadow="0 8 24 #30000000">
                                                    <ColorView Color="{Binding RedactionElement.FillColorHex, Mode=TwoWay, Converter={StaticResource HexToColorConverter}}"
                                                               IsAlphaEnabled="True" IsHexInputVisible="True" Width="280" />
                                                </Border>
                                            </Flyout>
                                        </Button.Flyout>
                                        <Grid Width="24" Height="24">
                                            <Border CornerRadius="12" Width="24" Height="24">
                                                <Border.Background>
                                                    <ConicGradientBrush Center="0.5,0.5">
                                                        <GradientStop Color="#FF0000" Offset="0.0" /><GradientStop Color="#FFFF00" Offset="0.17" /><GradientStop Color="#00FF00" Offset="0.33" /><GradientStop Color="#00FFFF" Offset="0.50" /><GradientStop Color="#0000FF" Offset="0.67" /><GradientStop Color="#FF00FF" Offset="0.83" /><GradientStop Color="#FF0000" Offset="1.0" />
                                                    </ConicGradientBrush>
                                                </Border.Background>
                                            </Border>
                                            <Border Margin="3.5" CornerRadius="9" Background="{DynamicResource WinPanelBrush}">
                                                <materialIcons:MaterialIcon Kind="Palette" Width="11" Height="11" Foreground="{DynamicResource WinTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                        </Grid>
                                    </Button>
                                    <Button Width="24" Height="24" CornerRadius="4" Background="#0F172A" Command="{Binding SetRedactionFillColorCommand}" CommandParameter="#0F172A" ToolTip.Tip="Blackout" />
                                    <Button Width="24" Height="24" CornerRadius="4" Background="{DynamicResource WinPanelBrush}" BorderBrush="#94A3B8" BorderThickness="1" Command="{Binding SetRedactionFillColorCommand}" CommandParameter="#FFFFFF" ToolTip.Tip="Whiteout" />
                                    <Button Width="24" Height="24" CornerRadius="4" Background="#475569" Command="{Binding SetRedactionFillColorCommand}" CommandParameter="#475569" ToolTip.Tip="Grayout" />
                                    <Button Width="24" Height="24" CornerRadius="4" Background="#DC2626" Command="{Binding SetRedactionFillColorCommand}" CommandParameter="#DC2626" ToolTip.Tip="Red Confidential" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 12. INK & MARKUP CARD (Visible when Ink element is selected) -->
                    <Border Background="{DynamicResource WinBgBrush}" BorderBrush="{DynamicResource WinBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12"
                            IsVisible="{Binding InkElement, Converter={StaticResource NullToBooleanConverter}}">
                        <StackPanel Spacing="10">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <materialIcons:MaterialIcon Kind="DrawPen" Width="16" Height="16" Foreground="{DynamicResource WinAccentBrush}" />
                                <TextBlock Text="Ink &amp; Markup Drawing" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource WinTextBrush}" VerticalAlignment="Center" />
                            </StackPanel>

                            <StackPanel Spacing="3">
                                <TextBlock Text="Stroke Width (pt)" Classes="inspector-label" />
                                <NumericUpDown Value="{Binding InkElement.StrokeThickness, Mode=TwoWay}"
                                               Minimum="1" Maximum="30" Increment="1" FormatString="0.0"
                                               HorizontalAlignment="Stretch" Height="28" FontSize="12" />
                            </StackPanel>

                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="Highlighter Mode" VerticalAlignment="Center" FontSize="11.5" Foreground="{DynamicResource WinMutedBrush}" />
                                <ToggleSwitch Grid.Column="1" IsChecked="{Binding InkElement.IsHighlighter, Mode=TwoWay}" OnContent="" OffContent="" Margin="0" />
                            </Grid>

                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="Smooth Bézier Spline" VerticalAlignment="Center" FontSize="11.5" Foreground="{DynamicResource WinMutedBrush}" />
                                <ToggleSwitch Grid.Column="1" IsChecked="{Binding InkElement.IsSmoothSpline, Mode=TwoWay}" OnContent="" OffContent="" Margin="0" />
                            </Grid>

                            <StackPanel Spacing="4">
                                <TextBlock Text="Ink Color" Classes="inspector-label" />
                                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                    <Button Classes="color-studio-btn" ToolTip.Tip="Custom Ink Color Studio">
                                        <Button.Flyout>
                                            <Flyout Placement="BottomEdgeAlignedLeft">
                                                <Border Background="{DynamicResource WinBgBrush}" BorderBrush="{DynamicResource WinBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10" BoxShadow="0 8 24 #30000000">
                                                    <ColorView Color="{Binding InkElement.StrokeColorHex, Mode=TwoWay, Converter={StaticResource HexToColorConverter}}"
                                                               IsAlphaEnabled="True" IsHexInputVisible="True" Width="280" />
                                                </Border>
                                            </Flyout>
                                        </Button.Flyout>
                                        <Grid Width="24" Height="24">
                                            <Border CornerRadius="12" Width="24" Height="24">
                                                <Border.Background>
                                                    <ConicGradientBrush Center="0.5,0.5">
                                                        <GradientStop Color="#FF0000" Offset="0.0" /><GradientStop Color="#FFFF00" Offset="0.17" /><GradientStop Color="#00FF00" Offset="0.33" /><GradientStop Color="#00FFFF" Offset="0.50" /><GradientStop Color="#0000FF" Offset="0.67" /><GradientStop Color="#FF00FF" Offset="0.83" /><GradientStop Color="#FF0000" Offset="1.0" />
                                                    </ConicGradientBrush>
                                                </Border.Background>
                                            </Border>
                                            <Border Margin="3.5" CornerRadius="9" Background="{DynamicResource WinPanelBrush}">
                                                <materialIcons:MaterialIcon Kind="Palette" Width="11" Height="11" Foreground="{DynamicResource WinTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                        </Grid>
                                    </Button>
                                    <ItemsControl ItemsSource="{Binding ColorSwatches}">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="vm:ColorSwatchItem">
                                                <Button Width="20" Height="20" Margin="1.5" CornerRadius="10" Background="{Binding Hex, Converter={StaticResource HexToBrushConverter}}"
                                                        Command="{Binding $parent[UserControl].((vm:InspectorViewModel)DataContext).SetInkColorCommand}" CommandParameter="{Binding Hex}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 13. STICKY NOTE CARD (Visible when Sticky Note is selected) -->
                    <Border Background="{DynamicResource WinBgBrush}" BorderBrush="{DynamicResource WinBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12"
                            IsVisible="{Binding StickyNoteElement, Converter={StaticResource NullToBooleanConverter}}">
                        <StackPanel Spacing="10">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <materialIcons:MaterialIcon Kind="NoteTextOutline" Width="16" Height="16" Foreground="#B45309" />
                                <TextBlock Text="Review Comment Note" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource WinTextBrush}" VerticalAlignment="Center" />
                            </StackPanel>

                            <StackPanel Spacing="3">
                                <TextBlock Text="Comment Text" Classes="inspector-label" />
                                <TextBox Text="{Binding StickyNoteElement.NoteText, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap" Height="60" FontSize="12" />
                            </StackPanel>

                            <Grid ColumnDefinitions="*,*">
                                <StackPanel Grid.Column="0" Spacing="3" Margin="0,0,4,0">
                                    <TextBlock Text="Author" Classes="inspector-label" />
                                    <TextBox Text="{Binding StickyNoteElement.Author, Mode=TwoWay}" Height="28" FontSize="11.5" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="3" Margin="4,0,0,0">
                                    <TextBlock Text="Review Status" Classes="inspector-label" />
                                    <TextBox Text="{Binding StickyNoteElement.Status, Mode=TwoWay}" Height="28" FontSize="11.5" />
                                </StackPanel>
                            </Grid>

                            <StackPanel Spacing="4">
                                <TextBlock Text="Sticky Color" Classes="inspector-label" />
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <Button Classes="color-studio-btn" ToolTip.Tip="Custom Sticky Note Color Studio">
                                        <Button.Flyout>
                                            <Flyout Placement="BottomEdgeAlignedLeft">
                                                <Border Background="{DynamicResource WinBgBrush}" BorderBrush="{DynamicResource WinBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10" BoxShadow="0 8 24 #30000000">
                                                    <ColorView Color="{Binding StickyNoteElement.ColorHex, Mode=TwoWay, Converter={StaticResource HexToColorConverter}}"
                                                               IsAlphaEnabled="True" IsHexInputVisible="True" Width="280" />
                                                </Border>
                                            </Flyout>
                                        </Button.Flyout>
                                        <Grid Width="24" Height="24">
                                            <Border CornerRadius="12" Width="24" Height="24">
                                                <Border.Background>
                                                    <ConicGradientBrush Center="0.5,0.5">
                                                        <GradientStop Color="#FF0000" Offset="0.0" /><GradientStop Color="#FFFF00" Offset="0.17" /><GradientStop Color="#00FF00" Offset="0.33" /><GradientStop Color="#00FFFF" Offset="0.50" /><GradientStop Color="#0000FF" Offset="0.67" /><GradientStop Color="#FF00FF" Offset="0.83" /><GradientStop Color="#FF0000" Offset="1.0" />
                                                    </ConicGradientBrush>
                                                </Border.Background>
                                            </Border>
                                            <Border Margin="3.5" CornerRadius="9" Background="{DynamicResource WinPanelBrush}">
                                                <materialIcons:MaterialIcon Kind="Palette" Width="11" Height="11" Foreground="{DynamicResource WinTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                        </Grid>
                                    </Button>
                                    <Button Width="24" Height="24" CornerRadius="4" Background="#FEF3C7" Command="{Binding SetStickyNoteColorCommand}" CommandParameter="#FEF3C7" ToolTip.Tip="Yellow Note" />
                                    <Button Width="24" Height="24" CornerRadius="4" Background="#DBEAFE" Command="{Binding SetStickyNoteColorCommand}" CommandParameter="#DBEAFE" ToolTip.Tip="Blue Note" />
                                    <Button Width="24" Height="24" CornerRadius="4" Background="#DCFCE7" Command="{Binding SetStickyNoteColorCommand}" CommandParameter="#DCFCE7" ToolTip.Tip="Green Note" />
                                    <Button Width="24" Height="24" CornerRadius="4" Background="#FCE7F3" Command="{Binding SetStickyNoteColorCommand}" CommandParameter="#FCE7F3" ToolTip.Tip="Pink Note" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 14. MEASUREMENT DIMENSION CARD (Visible when Measurement is selected) -->
                    <Border Background="{DynamicResource WinBgBrush}" BorderBrush="{DynamicResource WinBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12"
                            IsVisible="{Binding MeasurementElement, Converter={StaticResource NullToBooleanConverter}}">
                        <StackPanel Spacing="10">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <materialIcons:MaterialIcon Kind="RulerSquare" Width="16" Height="16" Foreground="{DynamicResource WinDangerBrush}" />
                                <TextBlock Text="Measurement &amp; Scale Annotation" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource WinTextBrush}" VerticalAlignment="Center" />
                            </StackPanel>

                            <StackPanel Spacing="3">
                                <TextBlock Text="Custom Label (or auto distance)" Classes="inspector-label" />
                                <TextBox Text="{Binding MeasurementElement.CustomLabel, Mode=TwoWay}" Height="28" FontSize="12" PlaceholderText="Auto-computed dimension..." />
                            </StackPanel>

                            <Grid ColumnDefinitions="*,*">
                                <StackPanel Grid.Column="0" Spacing="3" Margin="0,0,4,0">
                                    <TextBlock Text="Dimension Units" Classes="inspector-label" />
                                    <ComboBox ItemsSource="{Binding MeasurementUnits}"
                                              SelectedItem="{Binding MeasurementElement.Unit, Mode=TwoWay}"
                                              Height="28" FontSize="11.5" HorizontalAlignment="Stretch" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="3" Margin="4,0,0,0">
                                    <TextBlock Text="Stroke Width (pt)" Classes="inspector-label" />
                                    <NumericUpDown Value="{Binding MeasurementElement.StrokeThickness, Mode=TwoWay}"
                                                   Minimum="0.5" Maximum="10" Increment="0.5" FormatString="0.0"
                                                   HorizontalAlignment="Stretch" Height="28" FontSize="11.5" />
                                </StackPanel>
                            </Grid>

                            <StackPanel Spacing="4">
                                <TextBlock Text="Dimension Line Color" Classes="inspector-label" />
                                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                    <Button Classes="color-studio-btn" ToolTip.Tip="Custom Dimension Color Studio">
                                        <Button.Flyout>
                                            <Flyout Placement="BottomEdgeAlignedLeft">
                                                <Border Background="{DynamicResource WinBgBrush}" BorderBrush="{DynamicResource WinBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10" BoxShadow="0 8 24 #30000000">
                                                    <ColorView Color="{Binding MeasurementElement.StrokeColorHex, Mode=TwoWay, Converter={StaticResource HexToColorConverter}}"
                                                               IsAlphaEnabled="True" IsHexInputVisible="True" Width="280" />
                                                </Border>
                                            </Flyout>
                                        </Button.Flyout>
                                        <Grid Width="24" Height="24">
                                            <Border CornerRadius="12" Width="24" Height="24">
                                                <Border.Background>
                                                    <ConicGradientBrush Center="0.5,0.5">
                                                        <GradientStop Color="#FF0000" Offset="0.0" /><GradientStop Color="#FFFF00" Offset="0.17" /><GradientStop Color="#00FF00" Offset="0.33" /><GradientStop Color="#00FFFF" Offset="0.50" /><GradientStop Color="#0000FF" Offset="0.67" /><GradientStop Color="#FF00FF" Offset="0.83" /><GradientStop Color="#FF0000" Offset="1.0" />
                                                    </ConicGradientBrush>
                                                </Border.Background>
                                            </Border>
                                            <Border Margin="3.5" CornerRadius="9" Background="{DynamicResource WinPanelBrush}">
                                                <materialIcons:MaterialIcon Kind="Palette" Width="11" Height="11" Foreground="{DynamicResource WinTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                        </Grid>
                                    </Button>
                                    <ItemsControl ItemsSource="{Binding ColorSwatches}">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="vm:ColorSwatchItem">
                                                <Button Width="20" Height="20" Margin="1.5" CornerRadius="10" Background="{Binding Hex, Converter={StaticResource HexToBrushConverter}}"
                                                        Command="{Binding $parent[UserControl].((vm:InspectorViewModel)DataContext).SetMeasurementColorCommand}" CommandParameter="{Binding Hex}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </StackPanel>

                            <Border Background="{DynamicResource WinPanelBrush}" BorderBrush="{DynamicResource WinBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <materialIcons:MaterialIcon Kind="ArrowExpandHorizontal" Width="14" Height="14" Foreground="{DynamicResource WinDangerBrush}" />
                                    <TextBlock Text="Calculated Dimension:" FontSize="11" Foreground="{DynamicResource WinMutedBrush}" />
                                    <TextBlock Text="{Binding MeasurementElement.FormattedDistance}" FontWeight="Bold" FontSize="11.5" Foreground="{DynamicResource WinDangerBrush}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- 14.5. SVG VECTOR ART & ORNAMENTS STUDIO (Visible when SvgElement is selected) -->
                    <Border Background="{DynamicResource WinBgBrush}" BorderBrush="{DynamicResource WinBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12"
                            IsVisible="{Binding SvgElement, Converter={StaticResource NullToBooleanConverter}}">
                        <StackPanel Spacing="10">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <materialIcons:MaterialIcon Kind="VectorCurve" Width="16" Height="16" Foreground="{DynamicResource WinAccentBrush}" />
                                <TextBlock Text="SVG Vector Art Studio" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource WinTextBrush}" VerticalAlignment="Center" />
                            </StackPanel>

                            <!-- Preset Ornaments Selector -->
                            <StackPanel Spacing="3">
                                <TextBlock Text="Ornament / Crest Preset" Classes="inspector-label" />
                                <WrapPanel Orientation="Horizontal" Margin="0,2">
                                    <Button Classes="secondary-btn" Height="26" Margin="0,0,3,3" Content="Ganesha"
                                            Command="{Binding SetSvgPresetCommand}" CommandParameter="GaneshaCrest" />
                                    <Button Classes="secondary-btn" Height="26" Margin="0,0,3,3" Content="Toran"
                                            Command="{Binding SetSvgPresetCommand}" CommandParameter="MarigoldToran" />
                                    <Button Classes="secondary-btn" Height="26" Margin="0,0,3,3" Content="Deepam"
                                            Command="{Binding SetSvgPresetCommand}" CommandParameter="TraditionalDeepam" />
                                    <Button Classes="secondary-btn" Height="26" Margin="0,0,3,3" Content="Hanging Lamps"
                                            Command="{Binding SetSvgPresetCommand}" CommandParameter="HangingDiyas" />
                                    <Button Classes="secondary-btn" Height="26" Margin="0,0,3,3" Content="Floral Divider"
                                            Command="{Binding SetSvgPresetCommand}" CommandParameter="DottedFloralDivider" />
                                    <Button Classes="secondary-btn" Height="26" Margin="0,0,3,3" Content="Mandap Arch"
                                            Command="{Binding SetSvgPresetCommand}" CommandParameter="MandapArch" />
                                    <Button Classes="secondary-btn" Height="26" Margin="0,0,3,3" Content="Plantain Trees"
                                            Command="{Binding SetSvgPresetCommand}" CommandParameter="PlantainTrees" />
                                    <Button Classes="secondary-btn" Height="26" Margin="0,0,3,3" Content="Vedic Kalash"
                                            Command="{Binding SetSvgPresetCommand}" CommandParameter="AuspiciousKalash" />
                                    <Button Classes="secondary-btn" Height="26" Margin="0,0,3,3" Content="Botanical Wreath"
                                            Command="{Binding SetSvgPresetCommand}" CommandParameter="BotanicalWreath" />
                                    <Button Classes="secondary-btn" Height="26" Margin="0,0,3,3" Content="Art Deco Frame"
                                            Command="{Binding SetSvgPresetCommand}" CommandParameter="ArtDecoFrame" />
                                    <Button Classes="secondary-btn" Height="26" Margin="0,0,3,3" Content="Om Crest"
                                            Command="{Binding SetSvgPresetCommand}" CommandParameter="OmCrest" />
                                </WrapPanel>
                            </StackPanel>

                            <!-- Tint Color Studio -->
                            <StackPanel Spacing="4">
                                <TextBlock Text="Vector Tint Color (Optional)" Classes="inspector-label" />
                                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                    <Button Classes="color-studio-btn" ToolTip.Tip="Custom SVG Tint Color Studio">
                                        <Button.Flyout>
                                            <Flyout Placement="BottomEdgeAlignedLeft">
                                                <Border Background="{DynamicResource WinBgBrush}" BorderBrush="{DynamicResource WinBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10" BoxShadow="0 8 24 #30000000">
                                                    <ColorView Color="{Binding SvgElement.TintColorHex, Mode=TwoWay, Converter={StaticResource HexToColorConverter}}"
                                                               IsAlphaEnabled="True" IsHexInputVisible="True" Width="280" />
                                                </Border>
                                            </Flyout>
                                        </Button.Flyout>
                                        <Grid Width="24" Height="24">
                                            <Border CornerRadius="12" Width="24" Height="24">
                                                <Border.Background>
                                                    <ConicGradientBrush Center="0.5,0.5">
                                                        <GradientStop Color="#FF0000" Offset="0.0" /><GradientStop Color="#FFFF00" Offset="0.17" /><GradientStop Color="#00FF00" Offset="0.33" /><GradientStop Color="#00FFFF" Offset="0.50" /><GradientStop Color="#0000FF" Offset="0.67" /><GradientStop Color="#FF00FF" Offset="0.83" /><GradientStop Color="#FF0000" Offset="1.0" />
                                                    </ConicGradientBrush>
                                                </Border.Background>
                                            </Border>
                                            <Border Margin="3.5" CornerRadius="9" Background="{DynamicResource WinPanelBrush}">
                                                <materialIcons:MaterialIcon Kind="Palette" Width="11" Height="11" Foreground="{DynamicResource WinTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                        </Grid>
                                    </Button>
                                    <ItemsControl ItemsSource="{Binding ColorSwatches}">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="vm:ColorSwatchItem">
                                                <Button Width="20" Height="20" Margin="1.5" CornerRadius="10" Background="{Binding Hex, Converter={StaticResource HexToBrushConverter}}"
                                                        Command="{Binding $parent[UserControl].((vm:InspectorViewModel)DataContext).SetSvgTintColorCommand}" CommandParameter="{Binding Hex}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </StackPanel>

                            <!-- Keep Aspect Ratio -->
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="Keep Aspect Ratio" VerticalAlignment="Center" FontSize="11.5" Foreground="{DynamicResource WinMutedBrush}" />
                                <ToggleSwitch Grid.Column="1" IsChecked="{Binding SvgElement.KeepAspectRatio, Mode=TwoWay}" OnContent="" OffContent="" Margin="0" />
                            </Grid>

                            <!-- Raw SVG Source Editor -->
                            <StackPanel Spacing="3">
                                <TextBlock Text="Raw SVG Source Markup" Classes="inspector-label" />
                                <TextBox Text="{Binding SvgElement.SvgSource, Mode=TwoWay}"
                                         AcceptsReturn="True" TextWrapping="Wrap"
                                         Height="80" FontSize="11" FontFamily="Consolas, monospace" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 15. MATHEMATICAL EQUATION & FORMULA CARD (Visible when Math Element is selected) -->
                    <Border Background="{DynamicResource WinBgBrush}" BorderBrush="{DynamicResource WinBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12"
                            IsVisible="{Binding MathElement, Converter={StaticResource NullToBooleanConverter}}">
                        <StackPanel Spacing="10">
                            <!-- Card Title & Open Studio Button -->
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <materialIcons:MaterialIcon Kind="Sigma" Width="16" Height="16" Foreground="{DynamicResource WinAccentBrush}" />
                                    <TextBlock Text="Mathematical Equation" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource WinTextBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                                <Button Grid.Column="1" Classes="secondary-btn" Height="24" Padding="6,1"
                                        Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).OpenMathStudioCommand}"
                                        CommandParameter="{Binding MathElement}"
                                        ToolTip.Tip="Open Full Equation Studio">
                                    <StackPanel Orientation="Horizontal" Spacing="3">
                                        <materialIcons:MaterialIcon Kind="OpenInNew" Width="11" Height="11" Foreground="{DynamicResource WinAccentBrush}" />
                                        <TextBlock Text="Studio" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource WinAccentBrush}" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <!-- Quick Presets -->
                            <StackPanel Spacing="3">
                                <TextBlock Text="Standard Formula Presets" Classes="inspector-label" />
                                <WrapPanel Orientation="Horizontal">
                                    <Button Classes="secondary-btn" Height="24" Padding="5,1" Margin="2"
                                            Command="{Binding MathElement.ApplyPresetCommand}" CommandParameter="gaussian_integral">
                                        <TextBlock Text="∫ Gaussian" FontSize="10" />
                                    </Button>
                                    <Button Classes="secondary-btn" Height="24" Padding="5,1" Margin="2"
                                            Command="{Binding MathElement.ApplyPresetCommand}" CommandParameter="quadratic_formula">
                                        <TextBlock Text="± Quadratic" FontSize="10" />
                                    </Button>
                                    <Button Classes="secondary-btn" Height="24" Padding="5,1" Margin="2"
                                            Command="{Binding MathElement.ApplyPresetCommand}" CommandParameter="schrodinger_time_dependent">
                                        <TextBlock Text="Ψ Schrödinger" FontSize="10" />
                                    </Button>
                                    <Button Classes="secondary-btn" Height="24" Padding="5,1" Margin="2"
                                            Command="{Binding MathElement.ApplyPresetCommand}" CommandParameter="black_scholes_pde">
                                        <TextBlock Text="∂ Black-Scholes" FontSize="10" />
                                    </Button>
                                    <Button Classes="secondary-btn" Height="24" Padding="5,1" Margin="2"
                                            Command="{Binding MathElement.ApplyPresetCommand}" CommandParameter="eulers_identity">
                                        <TextBlock Text="e^(iπ) Euler" FontSize="10" />
                                    </Button>
                                    <Button Classes="secondary-btn" Height="24" Padding="5,1" Margin="2"
                                            Command="{Binding MathElement.ApplyPresetCommand}" CommandParameter="normal_distribution">
                                        <TextBlock Text="𝒩 Normal PDF" FontSize="10" />
                                    </Button>
                                    <Button Classes="secondary-btn" Height="24" Padding="5,1" Margin="2"
                                            Command="{Binding MathElement.ApplyPresetCommand}" CommandParameter="bates_jump_diffusion">
                                        <TextBlock Text="SDE Bates Jump" FontSize="10" />
                                    </Button>
                                    <Button Classes="secondary-btn" Height="24" Padding="5,1" Margin="2"
                                            Command="{Binding MathElement.ApplyPresetCommand}" CommandParameter="dicke_hamiltonian">
                                        <TextBlock Text="Ĥ Cavity QED" FontSize="10" />
                                    </Button>
                                </WrapPanel>
                            </StackPanel>

                            <!-- LaTeX Formula Editor -->
                            <StackPanel Spacing="3">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Text="LaTeX Expression" Classes="inspector-label" />
                                    <TextBlock Grid.Column="1" Text="{Binding MathElement.PresetName}" FontSize="9.5" Foreground="{DynamicResource WinMutedBrush}" FontWeight="Medium" />
                                </Grid>
                                <TextBox Text="{Binding MathElement.Formula, Mode=TwoWay}"
                                         AcceptsReturn="True" TextWrapping="Wrap"
                                         Height="70" FontSize="11.5"
                                         FontFamily="Cascadia Code, Consolas, Courier New, monospace" />
                            </StackPanel>

                            <!-- Quick Symbol Insert Bar -->
                            <StackPanel Spacing="3">
                                <TextBlock Text="Quick Insert Math Symbols" Classes="inspector-label" />
                                <WrapPanel Orientation="Horizontal">
                                    <Button Classes="secondary-btn" Height="22" Padding="4,1" Margin="1.5" Command="{Binding MathElement.InsertSymbolCommand}" CommandParameter="frac"><TextBlock Text="a/b" FontSize="10" /></Button>
                                    <Button Classes="secondary-btn" Height="22" Padding="4,1" Margin="1.5" Command="{Binding MathElement.InsertSymbolCommand}" CommandParameter="sqrt"><TextBlock Text="√x" FontSize="10" /></Button>
                                    <Button Classes="secondary-btn" Height="22" Padding="4,1" Margin="1.5" Command="{Binding MathElement.InsertSymbolCommand}" CommandParameter="sum"><TextBlock Text="∑" FontSize="10" /></Button>
                                    <Button Classes="secondary-btn" Height="22" Padding="4,1" Margin="1.5" Command="{Binding MathElement.InsertSymbolCommand}" CommandParameter="int"><TextBlock Text="∫" FontSize="10" /></Button>
                                    <Button Classes="secondary-btn" Height="22" Padding="4,1" Margin="1.5" Command="{Binding MathElement.InsertSymbolCommand}" CommandParameter="\partial"><TextBlock Text="∂" FontSize="10" /></Button>
                                    <Button Classes="secondary-btn" Height="22" Padding="4,1" Margin="1.5" Command="{Binding MathElement.InsertSymbolCommand}" CommandParameter="\nabla"><TextBlock Text="∇" FontSize="10" /></Button>
                                    <Button Classes="secondary-btn" Height="22" Padding="4,1" Margin="1.5" Command="{Binding MathElement.InsertSymbolCommand}" CommandParameter="\hbar"><TextBlock Text="ℏ" FontSize="10" /></Button>
                                    <Button Classes="secondary-btn" Height="22" Padding="4,1" Margin="1.5" Command="{Binding MathElement.InsertSymbolCommand}" CommandParameter="\infty"><TextBlock Text="∞" FontSize="10" /></Button>
                                    <Button Classes="secondary-btn" Height="22" Padding="4,1" Margin="1.5" Command="{Binding MathElement.InsertSymbolCommand}" CommandParameter="\alpha"><TextBlock Text="α" FontSize="10" /></Button>
                                    <Button Classes="secondary-btn" Height="22" Padding="4,1" Margin="1.5" Command="{Binding MathElement.InsertSymbolCommand}" CommandParameter="\beta"><TextBlock Text="β" FontSize="10" /></Button>
                                    <Button Classes="secondary-btn" Height="22" Padding="4,1" Margin="1.5" Command="{Binding MathElement.InsertSymbolCommand}" CommandParameter="\pi"><TextBlock Text="π" FontSize="10" /></Button>
                                    <Button Classes="secondary-btn" Height="22" Padding="4,1" Margin="1.5" Command="{Binding MathElement.InsertSymbolCommand}" CommandParameter="\sigma"><TextBlock Text="σ" FontSize="10" /></Button>
                                    <Button Classes="secondary-btn" Height="22" Padding="4,1" Margin="1.5" Command="{Binding MathElement.InsertSymbolCommand}" CommandParameter="\psi"><TextBlock Text="ψ" FontSize="10" /></Button>
                                    <Button Classes="secondary-btn" Height="22" Padding="4,1" Margin="1.5" Command="{Binding MathElement.InsertSymbolCommand}" CommandParameter="\omega"><TextBlock Text="ω" FontSize="10" /></Button>
                                    <Button Classes="secondary-btn" Height="22" Padding="4,1" Margin="1.5" Command="{Binding MathElement.InsertSymbolCommand}" CommandParameter="\pm"><TextBlock Text="±" FontSize="10" /></Button>
                                    <Button Classes="secondary-btn" Height="22" Padding="4,1" Margin="1.5" Command="{Binding MathElement.InsertSymbolCommand}" CommandParameter="\times"><TextBlock Text="×" FontSize="10" /></Button>
                                    <Button Classes="secondary-btn" Height="22" Padding="4,1" Margin="1.5" Command="{Binding MathElement.InsertSymbolCommand}" CommandParameter="\le"><TextBlock Text="≤" FontSize="10" /></Button>
                                    <Button Classes="secondary-btn" Height="22" Padding="4,1" Margin="1.5" Command="{Binding MathElement.InsertSymbolCommand}" CommandParameter="\ge"><TextBlock Text="≥" FontSize="10" /></Button>
                                    <Button Classes="secondary-btn" Height="22" Padding="4,1" Margin="1.5" Command="{Binding MathElement.InsertSymbolCommand}" CommandParameter="\approx"><TextBlock Text="≈" FontSize="10" /></Button>
                                    <Button Classes="secondary-btn" Height="22" Padding="4,1" Margin="1.5" Command="{Binding MathElement.InsertSymbolCommand}" CommandParameter="\to"><TextBlock Text="→" FontSize="10" /></Button>
                                </WrapPanel>
                            </StackPanel>

                            <!-- Font Size & Equation Numbering -->
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                <StackPanel Grid.Column="0" Spacing="3">
                                    <TextBlock Text="Base Font Size (pt)" Classes="inspector-label" />
                                    <NumericUpDown Value="{Binding MathElement.FontSize, Mode=TwoWay}"
                                                   Minimum="8" Maximum="72" Increment="1" FormatString="0 pt" />
                                </StackPanel>

                                <StackPanel Grid.Column="1" Spacing="3">
                                    <TextBlock Text="Equation Number" Classes="inspector-label" />
                                    <TextBox Text="{Binding MathElement.EquationNumber, Mode=TwoWay}"
                                             Height="28" FontSize="11.5"
                                             IsEnabled="{Binding MathElement.ShowEquationNumber}" />
                                </StackPanel>
                            </Grid>

                            <!-- Equation Number Toggle -->
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="Show Equation Number Tag (e.g. (1))" VerticalAlignment="Center" FontSize="11.5" Foreground="{DynamicResource WinMutedBrush}" />
                                <ToggleSwitch Grid.Column="1" IsChecked="{Binding MathElement.ShowEquationNumber, Mode=TwoWay}" OnContent="" OffContent="" Margin="0" />
                            </Grid>

                            <!-- Text / Symbol Color -->
                            <StackPanel Spacing="4">
                                <TextBlock Text="Formula Glyph Color" Classes="inspector-label" />
                                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                    <Button Classes="color-studio-btn" ToolTip.Tip="Formula Color Picker">
                                        <Button.Flyout>
                                            <Flyout Placement="BottomEdgeAlignedLeft">
                                                <Border Background="{DynamicResource WinBgBrush}" BorderBrush="{DynamicResource WinBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10" BoxShadow="0 8 24 #30000000">
                                                    <ColorView Color="{Binding MathElement.TextColorHex, Mode=TwoWay, Converter={StaticResource HexToColorConverter}}"
                                                               IsAlphaEnabled="True" IsHexInputVisible="True" Width="280" />
                                                </Border>
                                            </Flyout>
                                        </Button.Flyout>
                                        <Border CornerRadius="12" Width="24" Height="24" Background="{Binding MathElement.TextColorHex, Converter={StaticResource HexToBrushConverter}}" BorderBrush="{DynamicResource WinBorderBrush}" BorderThickness="1" />
                                    </Button>
                                    <ItemsControl ItemsSource="{Binding ColorSwatches}">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="vm:ColorSwatchItem">
                                                <Button Width="20" Height="20" Margin="1.5" CornerRadius="3" Background="{Binding Hex, Converter={StaticResource HexToBrushConverter}}"
                                                        Command="{Binding $parent[UserControl].((vm:InspectorViewModel)DataContext).SetTextColorCommand}" CommandParameter="{Binding Hex}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </StackPanel>

                            <!-- Background & Border Card Styling -->
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                <StackPanel Grid.Column="0" Spacing="3">
                                    <TextBlock Text="Corner Radius" Classes="inspector-label" />
                                    <NumericUpDown Value="{Binding MathElement.CornerRadius, Mode=TwoWay}"
                                                   Minimum="0" Maximum="30" Increment="1" FormatString="0 px" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="3">
                                    <TextBlock Text="Border Thickness" Classes="inspector-label" />
                                    <NumericUpDown Value="{Binding MathElement.BorderThickness, Mode=TwoWay}"
                                                   Minimum="0" Maximum="10" Increment="0.5" FormatString="0.0 px" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 16. DIMENSIONS, POSITION & TRANSFORMS CARD (Visible for any selected element) -->
                    <Border Background="{DynamicResource WinBgBrush}" BorderBrush="{DynamicResource WinBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12"
                            IsVisible="{Binding HasSelectedElement}">
                        <StackPanel Spacing="10">
                            <!-- Card Title -->
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
                                    <materialIcons:MaterialIcon Kind="ArrowAll" Width="16" Height="16" Foreground="{DynamicResource WinAccentBrush}" />
                                    <TextBlock Text="Position &amp; Geometry" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource WinTextBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                                <Border Grid.Column="1" Background="{DynamicResource WinHoverBrush}" BorderBrush="{DynamicResource WinBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="5,1">
                                    <TextBlock Text="pt" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource WinMutedBrush}" />
                                </Border>
                            </Grid>

                            <!-- X & Y Coords -->
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                <Grid Grid.Column="0" ColumnDefinitions="Auto,*">
                                    <Border Classes="input-badge">
                                        <TextBlock Text="X" Classes="input-badge-text" />
                                    </Border>
                                    <NumericUpDown Grid.Column="1" Value="{Binding SelectedElement.X, Mode=TwoWay}"
                                                   Minimum="0" Maximum="2000" Increment="1" FormatString="0"
                                                   HorizontalAlignment="Stretch" CornerRadius="0,5,5,0" />
                                </Grid>

                                <Grid Grid.Column="1" ColumnDefinitions="Auto,*">
                                    <Border Classes="input-badge">
                                        <TextBlock Text="Y" Classes="input-badge-text" />
                                    </Border>
                                    <NumericUpDown Grid.Column="1" Value="{Binding SelectedElement.Y, Mode=TwoWay}"
                                                   Minimum="0" Maximum="3000" Increment="1" FormatString="0"
                                                   HorizontalAlignment="Stretch" CornerRadius="0,5,5,0" />
                                </Grid>
                            </Grid>

                            <!-- Width & Height -->
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                <Grid Grid.Column="0" ColumnDefinitions="Auto,*">
                                    <Border Classes="input-badge">
                                        <TextBlock Text="W" Classes="input-badge-text" />
                                    </Border>
                                    <NumericUpDown Grid.Column="1" Value="{Binding SelectedElement.Width, Mode=TwoWay}"
                                                   Minimum="10" Maximum="2000" Increment="1" FormatString="0"
                                                   HorizontalAlignment="Stretch" CornerRadius="0,5,5,0" />
                                </Grid>

                                <Grid Grid.Column="1" ColumnDefinitions="Auto,*">
                                    <Border Classes="input-badge">
                                        <TextBlock Text="H" Classes="input-badge-text" />
                                    </Border>
                                    <NumericUpDown Grid.Column="1" Value="{Binding SelectedElement.Height, Mode=TwoWay}"
                                                   Minimum="5" Maximum="3000" Increment="1" FormatString="0"
                                                   HorizontalAlignment="Stretch" CornerRadius="0,5,5,0" />
                                </Grid>
                            </Grid>

                            <!-- Rotation & Opacity -->
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                <Grid Grid.Column="0" ColumnDefinitions="Auto,*">
                                    <Border Classes="input-badge">
                                        <TextBlock Text="∠" Classes="input-badge-text" />
                                    </Border>
                                    <NumericUpDown Grid.Column="1" Value="{Binding SelectedElement.Rotation, Mode=TwoWay}"
                                                   Minimum="0" Maximum="360" Increment="15" FormatString="0°"
                                                   HorizontalAlignment="Stretch" CornerRadius="0,5,5,0" />
                                </Grid>

                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Grid.Column="0" Text="Opacity" Classes="inspector-label" Margin="0" />
                                        <TextBlock Grid.Column="1" Text="{Binding SelectedElement.Opacity, StringFormat='{}{0:P0}'}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource WinAccentBrush}" />
                                    </Grid>
                                    <Slider Value="{Binding SelectedElement.Opacity, Mode=TwoWay}" Minimum="0.0" Maximum="1.0" Height="24" Margin="0" />
                                </StackPanel>
                            </Grid>

                            <!-- Alignment Buttons -->
                            <StackPanel Spacing="3">
                                <TextBlock Text="Page Alignment" Classes="inspector-label" />
                                <Grid ColumnDefinitions="*,*,*,*,*,*">
                                    <Button Grid.Column="0" Classes="mini-tool-btn" Height="28" Margin="1" Command="{Binding AlignLeftCommand}" ToolTip.Tip="Align Left">
                                        <materialIcons:MaterialIcon Kind="AlignHorizontalLeft" Width="14" Height="14" Foreground="{DynamicResource WinMutedBrush}" HorizontalAlignment="Center" />
                                    </Button>
                                    <Button Grid.Column="1" Classes="mini-tool-btn" Height="28" Margin="1" Command="{Binding AlignCenterCommand}" ToolTip.Tip="Align Center">
                                        <materialIcons:MaterialIcon Kind="AlignHorizontalCenter" Width="14" Height="14" Foreground="{DynamicResource WinMutedBrush}" HorizontalAlignment="Center" />
                                    </Button>
                                    <Button Grid.Column="2" Classes="mini-tool-btn" Height="28" Margin="1" Command="{Binding AlignRightCommand}" ToolTip.Tip="Align Right">
                                        <materialIcons:MaterialIcon Kind="AlignHorizontalRight" Width="14" Height="14" Foreground="{DynamicResource WinMutedBrush}" HorizontalAlignment="Center" />
                                    </Button>
                                    <Button Grid.Column="3" Classes="mini-tool-btn" Height="28" Margin="1" Command="{Binding AlignTopCommand}" ToolTip.Tip="Align Top">
                                        <materialIcons:MaterialIcon Kind="AlignVerticalTop" Width="14" Height="14" Foreground="{DynamicResource WinMutedBrush}" HorizontalAlignment="Center" />
                                    </Button>
                                    <Button Grid.Column="4" Classes="mini-tool-btn" Height="28" Margin="1" Command="{Binding AlignMiddleCommand}" ToolTip.Tip="Align Middle">
                                        <materialIcons:MaterialIcon Kind="AlignVerticalCenter" Width="14" Height="14" Foreground="{DynamicResource WinMutedBrush}" HorizontalAlignment="Center" />
                                    </Button>
                                    <Button Grid.Column="5" Classes="mini-tool-btn" Height="28" Margin="1" Command="{Binding AlignBottomCommand}" ToolTip.Tip="Align Bottom">
                                        <materialIcons:MaterialIcon Kind="AlignVerticalBottom" Width="14" Height="14" Foreground="{DynamicResource WinMutedBrush}" HorizontalAlignment="Center" />
                                    </Button>
                                </Grid>
                            </StackPanel>

                            <!-- Distribution Tools -->
                            <StackPanel Spacing="3">
                                <TextBlock Text="Smart Distribution" Classes="inspector-label" />
                                <Grid ColumnDefinitions="*,*">
                                    <Button Grid.Column="0" Classes="secondary-btn" Height="28" Margin="0,0,3,0" Command="{Binding DistributeHorizontallyCommand}">
                                        <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                                            <materialIcons:MaterialIcon Kind="DistributeHorizontalCenter" Width="14" Height="14" Foreground="{DynamicResource WinMutedBrush}" />
                                            <TextBlock Text="Distribute H" FontSize="10" />
                                        </StackPanel>
                                    </Button>
                                    <Button Grid.Column="1" Classes="secondary-btn" Height="28" Margin="3,0,0,0" Command="{Binding DistributeVerticallyCommand}">
                                        <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                                            <materialIcons:MaterialIcon Kind="DistributeVerticalCenter" Width="14" Height="14" Foreground="{DynamicResource WinMutedBrush}" />
                                            <TextBlock Text="Distribute V" FontSize="10" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </StackPanel>

                            <!-- Actions Row (Front, Up, Down, Back, Duplicate, Delete) -->
                            <StackPanel Spacing="3" Margin="0,4,0,0">
                                <TextBlock Text="Layer Order &amp; Quick Actions" Classes="inspector-label" />
                                <Grid ColumnDefinitions="*,*,*,*,*,*">
                                    <Button Grid.Column="0" Classes="secondary-btn" Height="30" Margin="1"
                                            Command="{Binding BringToFrontCommand}" ToolTip.Tip="Bring to Front (Ctrl+])">
                                        <materialIcons:MaterialIcon Kind="ArrangeBringToFront" Width="14" Height="14" Foreground="{DynamicResource WinMutedBrush}" HorizontalAlignment="Center" />
                                    </Button>

                                    <Button Grid.Column="1" Classes="secondary-btn" Height="30" Margin="1"
                                            Command="{Binding BringForwardCommand}" ToolTip.Tip="Bring Forward (1 Step)">
                                        <materialIcons:MaterialIcon Kind="ArrowUpBold" Width="14" Height="14" Foreground="{DynamicResource WinMutedBrush}" HorizontalAlignment="Center" />
                                    </Button>

                                    <Button Grid.Column="2" Classes="secondary-btn" Height="30" Margin="1"
                                            Command="{Binding SendBackwardCommand}" ToolTip.Tip="Send Backward (1 Step)">
                                        <materialIcons:MaterialIcon Kind="ArrowDownBold" Width="14" Height="14" Foreground="{DynamicResource WinMutedBrush}" HorizontalAlignment="Center" />
                                    </Button>

                                    <Button Grid.Column="3" Classes="secondary-btn" Height="30" Margin="1"
                                            Command="{Binding SendToBackCommand}" ToolTip.Tip="Send to Back (Ctrl+[)">
                                        <materialIcons:MaterialIcon Kind="ArrangeSendToBack" Width="14" Height="14" Foreground="{DynamicResource WinMutedBrush}" HorizontalAlignment="Center" />
                                    </Button>

                                    <Button Grid.Column="4" Classes="secondary-btn" Height="30" Margin="1"
                                            Command="{Binding DuplicateSelectedElementCommand}" ToolTip.Tip="Duplicate (Ctrl+D)">
                                        <materialIcons:MaterialIcon Kind="ContentCopy" Width="14" Height="14" Foreground="{DynamicResource WinMutedBrush}" HorizontalAlignment="Center" />
                                    </Button>

                                    <Button Grid.Column="5" Classes="danger-btn" Height="30" Margin="1"
                                            Command="{Binding DeleteSelectedElementCommand}" ToolTip.Tip="Delete (Del)">
                                        <materialIcons:MaterialIcon Kind="DeleteOutline" Width="14" Height="14" Foreground="{DynamicResource WinDangerBrush}" HorizontalAlignment="Center" />
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

        </Grid>
    </Border>

    <!-- B. COLLAPSED MINI DOCK RAIL (Width 38) -->
    <Border Background="{DynamicResource WinBgBrush}" BorderBrush="{DynamicResource WinBorderBrush}" BorderThickness="1,0,0,0" Width="38"
            IsVisible="{Binding $parent[Window].((vm:MainViewModel)DataContext).IsInspectorCollapsed}">
        <Grid RowDefinitions="Auto,*,Auto" Margin="0,4">
            <!-- Top: Expand Chevron Button -->
            <StackPanel Grid.Row="0" HorizontalAlignment="Center" Spacing="4">
                <Button Classes="mini-tool-btn" Width="30" Height="30"
                        Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).ToggleInspectorCollapseCommand}"
                        ToolTip.Tip="Expand Properties Inspector (⌘⇧P / Ctrl+Shift+P)">
                    <materialIcons:MaterialIcon Kind="ChevronLeft" Width="16" Height="16" Foreground="{DynamicResource WinAccentBrush}" />
                </Button>
                <Rectangle Width="22" Height="1" Fill="{DynamicResource WinBorderBrush}" Margin="0,2" />
            </StackPanel>

            <!-- Middle: Inspector Icon & Category Indicator -->
            <StackPanel Grid.Row="1" HorizontalAlignment="Center" Spacing="8" Margin="0,6">
                <Button Classes="mini-tool-btn" Width="30" Height="30"
                        Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).ToggleInspectorCollapseCommand}"
                        ToolTip.Tip="Open Properties &amp; Format Inspector (⌘⇧P)">
                    <materialIcons:MaterialIcon Kind="TuneVariant" Width="16" Height="16" Foreground="{DynamicResource WinAccentBrush}" />
                </Button>
                <Border Background="{DynamicResource WinAccentLightBrush}" BorderBrush="{DynamicResource WinAccentBorderBrush}" BorderThickness="1"
                        CornerRadius="4" Padding="2,4" HorizontalAlignment="Center">
                    <TextBlock Text="{Binding ActiveCategoryName}"
                               FontSize="9"
                               FontWeight="Bold"
                               Foreground="{DynamicResource WinAccentBrush}"
                               TextAlignment="Center" />
                </Border>
            </StackPanel>

            <!-- Bottom: Duplicate Action -->
            <StackPanel Grid.Row="2" HorizontalAlignment="Center" Spacing="4">
                <Button Classes="mini-tool-btn" Width="30" Height="30"
                        Command="{Binding DuplicateSelectedElementCommand}"
                        IsEnabled="{Binding HasSelectedElement}"
                        ToolTip.Tip="Duplicate Selected Element (⌘D)">
                    <materialIcons:MaterialIcon Kind="ContentCopy" Width="14" Height="14" Foreground="{DynamicResource WinMutedBrush}" />
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Panel>
</UserControl>
