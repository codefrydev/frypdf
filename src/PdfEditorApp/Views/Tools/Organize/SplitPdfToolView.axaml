<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PdfEditorApp.ViewModels.Tools.Organize"
             xmlns:models="using:PdfEditorApp.Models"
             xmlns:converters="using:PdfEditorApp.Converters"
             xmlns:shell="using:PdfEditorApp.Views.Shell"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="PdfEditorApp.Views.Tools.Organize.SplitPdfToolView"
             x:DataType="vm:SplitPdfToolViewModel">

    <UserControl.Resources>
        <converters:HexToBrushConverter x:Key="HexToBrushConverter" />
    </UserControl.Resources>

    <shell:PdfToolWorkspaceView>

        <!-- Toolbar primary action -->
        <shell:PdfToolWorkspaceView.ToolbarActionContent>
            <Button Command="{Binding ExecuteToolCommand}" IsEnabled="{Binding !IsRunning}" Background="#DC2626" Foreground="White" CornerRadius="8" Padding="16,8" FontWeight="Bold" FontSize="12.5" Cursor="Hand">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <materialIcons:MaterialIcon Kind="CallSplit" Width="15" Height="15" />
                    <TextBlock Text="Split PDF" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </shell:PdfToolWorkspaceView.ToolbarActionContent>

        <!-- Sidebar Options tab: status, document selection, and split settings -->
        <shell:PdfToolWorkspaceView.OptionsContent>
            <StackPanel Spacing="16">

                <!-- Error Banner -->
                <Border Background="#FEF2F2" BorderBrush="#FCA5A5" BorderThickness="1" CornerRadius="10" Padding="14,10" IsVisible="{Binding HasError}">
                    <Grid ColumnDefinitions="Auto,*">
                        <materialIcons:MaterialIcon Grid.Column="0" Kind="AlertCircleOutline" Width="20" Height="20" Foreground="#DC2626" Margin="0,0,10,0" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="Split Failed" FontSize="12.5" FontWeight="Bold" Foreground="#991B1B" />
                            <TextBlock Text="{Binding ErrorMessage}" FontSize="11.5" Foreground="#B91C1C" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Saved Destination Notification Banner -->
                <Border Background="#F0FDF4" BorderBrush="#86EFAC" BorderThickness="1" CornerRadius="10" Padding="12,9" IsVisible="{Binding HasSavedNotification}">
                    <StackPanel Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <materialIcons:MaterialIcon Kind="CheckCircleOutline" Width="18" Height="18" Foreground="#16A34A" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding SavedNotificationMessage}" FontSize="11.5" FontWeight="SemiBold" Foreground="#166534" VerticalAlignment="Center" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Command="{Binding OpenOutputFolderCommand}" Background="#DCFCE7" Foreground="#166534" CornerRadius="6" Padding="10,4" FontSize="11" Cursor="Hand" HorizontalAlignment="Left">
                            View in Folder
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Rich Success & Interactive Preview Card -->
                <Border Background="{DynamicResource WinPanelBrush}" BorderBrush="#86EFAC" BorderThickness="1.5" CornerRadius="12" Padding="16" BoxShadow="0 6 18 #1216A34A" IsVisible="{Binding IsComplete}">
                    <StackPanel Spacing="12">
                        <StackPanel Spacing="2">
                            <TextBlock Text="PDF split successfully!" FontSize="15" FontWeight="ExtraBold" Foreground="{DynamicResource WinTextBrush}" />
                            <TextBlock Text="{Binding ResultSummaryMessage}" FontSize="11.5" Foreground="{DynamicResource WinMutedBrush}" TextWrapping="Wrap" />
                        </StackPanel>

                        <!-- Output Document Metadata -->
                        <Border Background="{DynamicResource WinInputBgBrush}" BorderBrush="{DynamicResource WinBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10,8">
                            <StackPanel Spacing="6">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <materialIcons:MaterialIcon Kind="FileDocumentCheckOutline" Width="15" Height="15" Foreground="#16A34A" />
                                    <TextBlock Text="{Binding OutputFilePreview.FileName}" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource WinTextBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                </StackPanel>
                                <WrapPanel Orientation="Horizontal">
                                    <Border Background="#DCFCE7" CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                                        <TextBlock Text="{Binding OutputFilePreview.PageCountText}" FontSize="10.5" FontWeight="SemiBold" Foreground="#166534" />
                                    </Border>
                                    <Border Background="{DynamicResource WinHoverBrush}" CornerRadius="4" Padding="6,2">
                                        <TextBlock Text="{Binding OutputFilePreview.FileSizeFormatted}" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource WinTextBrush}" />
                                    </Border>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <WrapPanel Orientation="Horizontal">
                            <Button Command="{Binding SaveOutputFileAsCommand}" Background="#DC2626" Foreground="White" CornerRadius="8" Padding="14,9" FontSize="12" FontWeight="Bold" Cursor="Hand" Margin="0,0,6,6">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <materialIcons:MaterialIcon Kind="ContentSaveOutline" Width="15" Height="15" />
                                    <TextBlock Text="Save As..." VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding OpenOutputFileCommand}" Background="#16A34A" Foreground="White" CornerRadius="8" Padding="14,9" FontSize="12" FontWeight="SemiBold" Cursor="Hand" Margin="0,0,6,6">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <materialIcons:MaterialIcon Kind="FolderOpenOutline" Width="15" Height="15" />
                                    <TextBlock Text="Open Extracted" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding OpenInEditorCommand}" Background="#EFF6FF" Foreground="#0F6CBD" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="8" Padding="14,9" FontSize="12" FontWeight="SemiBold" Cursor="Hand" Margin="0,0,6,6">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <materialIcons:MaterialIcon Kind="SquareEditOutline" Width="15" Height="15" />
                                    <TextBlock Text="Edit in FryPDF" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding OpenOutputFolderCommand}" Background="{DynamicResource WinHoverBrush}" Foreground="{DynamicResource WinTextBrush}" BorderBrush="{DynamicResource WinBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,9" FontSize="12" FontWeight="SemiBold" Cursor="Hand" Margin="0,0,6,6">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <materialIcons:MaterialIcon Kind="FolderOpenOutline" Width="15" Height="15" />
                                    <TextBlock Text="Show in Folder" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding StartOverCommand}" Background="{DynamicResource WinInputBgBrush}" BorderBrush="{DynamicResource WinBorderBrush}" BorderThickness="1" Foreground="{DynamicResource WinMutedBrush}" CornerRadius="8" Padding="14,9" FontSize="12" Cursor="Hand" Margin="0,0,6,6">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <materialIcons:MaterialIcon Kind="Refresh" Width="14" Height="14" />
                                    <TextBlock Text="Split Another" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </WrapPanel>

                        <!-- Extracted Pages Preview Strip -->
                        <StackPanel Spacing="6">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="Extracted Pages Preview" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource WinTextBrush}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding OutputPageThumbnails.Count, StringFormat='{}{0} Pages'}" FontSize="10.5" Foreground="{DynamicResource WinMutedBrush}" VerticalAlignment="Center" />
                            </Grid>

                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding OutputPageThumbnails}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="8" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="models:PdfPagePreviewThumbnail">
                                            <Border Width="82" Height="112" Background="{DynamicResource WinPanelBrush}" BorderBrush="{DynamicResource WinBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="6" BoxShadow="0 2 6 #08000000">
                                                <Grid RowDefinitions="Auto,*,Auto">
                                                    <Border Grid.Row="0" Background="#DC2626" CornerRadius="4" Padding="4,1" HorizontalAlignment="Left" Margin="0,0,0,4">
                                                        <TextBlock Text="{Binding PageNumber, StringFormat='{}#{0}'}" FontSize="8.5" FontWeight="Bold" Foreground="White" />
                                                    </Border>

                                                    <Border Grid.Row="1" Background="{DynamicResource WinInputBgBrush}" BorderBrush="{DynamicResource WinBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="5" Margin="0,0,0,4">
                                                        <StackPanel Spacing="3" VerticalAlignment="Center">
                                                            <Border Height="2.5" Background="#DC2626" CornerRadius="1" Margin="0,0,16,0" Opacity="0.8" />
                                                            <Border Height="2" Background="#CBD5E1" CornerRadius="1" Margin="0,0,4,0" />
                                                            <Border Height="2" Background="#E2E8F0" CornerRadius="1" Margin="0,0,10,0" />
                                                            <Border Height="2" Background="#CBD5E1" CornerRadius="1" Margin="0,0,2,0" />
                                                        </StackPanel>
                                                    </Border>

                                                    <TextBlock Grid.Row="2" Text="{Binding PageLabel}" FontSize="8" FontWeight="SemiBold" Foreground="{DynamicResource WinMutedBrush}" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Processing Card -->
                <Border Background="{DynamicResource WinPanelBrush}" BorderBrush="{DynamicResource WinBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14" IsVisible="{Binding IsRunning}">
                    <StackPanel Spacing="10">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource WinTextBrush}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding ProgressPercentage, StringFormat='{}{0:F0}%'}" FontSize="13" FontWeight="Bold" Foreground="#DC2626" VerticalAlignment="Center" />
                        </Grid>
                        <ProgressBar Value="{Binding ProgressPercentage}" Minimum="0" Maximum="100" Height="7" CornerRadius="4" Foreground="#DC2626" Background="{DynamicResource WinHoverBrush}" />
                        <Button Command="{Binding CancelExecutionCommand}" HorizontalAlignment="Right" Background="{DynamicResource WinHoverBrush}" Foreground="{DynamicResource WinMutedBrush}" CornerRadius="6" Padding="10,4" FontSize="11" Cursor="Hand">
                            Cancel
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Dropzone -->
                <Border Background="{DynamicResource WinPanelBrush}" BorderBrush="{DynamicResource WinBorderBrush}" BorderThickness="2" CornerRadius="10" Padding="20,26" IsVisible="{Binding !HasSelectedFiles}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                        <Border Width="52" Height="52" Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="14" HorizontalAlignment="Center">
                            <materialIcons:MaterialIcon Kind="CallSplit" Width="28" Height="28" Foreground="#DC2626" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Spacing="3" HorizontalAlignment="Center">
                            <TextBlock Text="Select PDF to Split" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource WinTextBrush}" HorizontalAlignment="Center" TextAlignment="Center" />
                            <TextBlock Text="Extract page ranges, split every N pages, or separate odd/even pages" FontSize="11.5" Foreground="{DynamicResource WinMutedBrush}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Command="{Binding AddFilesCommand}" Background="#DC2626" Foreground="White" CornerRadius="8" Padding="18,9" FontSize="12.5" FontWeight="SemiBold" HorizontalAlignment="Center" Cursor="Hand">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <materialIcons:MaterialIcon Kind="FolderOpenOutline" Width="15" Height="15" />
                                <TextBlock Text="Select PDF Document" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Selected document -->
                <Border Background="{DynamicResource WinPanelBrush}" BorderBrush="{DynamicResource WinBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14" IsVisible="{Binding HasSelectedFiles}">
                    <StackPanel Spacing="8">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="Document to Split" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource WinTextBrush}" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Command="{Binding ClearFilesCommand}" Background="Transparent" BorderThickness="0" Foreground="#EF4444" FontSize="11" Cursor="Hand">
                                Change
                            </Button>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding SelectedFilePreviewItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="models:PdfFilePreviewItem">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="{Binding FileName}" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource WinTextBrush}" TextTrimming="CharacterEllipsis" />
                                        <WrapPanel Orientation="Horizontal">
                                            <Border Background="#FEF2F2" CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                                                <TextBlock Text="{Binding PageCountText}" FontSize="10.5" FontWeight="SemiBold" Foreground="#DC2626" />
                                            </Border>
                                            <Border Background="{DynamicResource WinHoverBrush}" CornerRadius="4" Padding="6,2">
                                                <TextBlock Text="{Binding FileSizeFormatted}" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource WinTextBrush}" />
                                            </Border>
                                        </WrapPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Split settings -->
                <StackPanel Spacing="3">
                    <TextBlock Text="Split Settings" FontSize="14" FontWeight="ExtraBold" Foreground="{DynamicResource WinTextBrush}" />
                    <TextBlock Text="Choose how to divide this document" FontSize="11" Foreground="{DynamicResource WinMutedBrush}" TextWrapping="Wrap" />
                </StackPanel>

                <Border Background="{DynamicResource WinInputBgBrush}" BorderBrush="{DynamicResource WinBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Split Mode" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource WinMutedBrush}" />
                        <RadioButton GroupName="SplitMode" Content="Split Every N Pages" FontSize="12.5" IsChecked="{Binding SplitMode, Converter={StaticResource EqualityConverter}, ConverterParameter=SplitEveryNPages}" />
                        <RadioButton GroupName="SplitMode" Content="Split by Page Ranges" FontSize="12.5" IsChecked="{Binding SplitMode, Converter={StaticResource EqualityConverter}, ConverterParameter=SplitByPageRanges}" />
                    </StackPanel>
                </Border>

                <Border Background="{DynamicResource WinInputBgBrush}" BorderBrush="{DynamicResource WinBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Split Range Expression" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource WinMutedBrush}" />
                        <TextBox Text="{Binding SplitRangeExpression, Mode=TwoWay}" PlaceholderText="e.g. 1-3, 5, 7-10" FontSize="12" IsEnabled="{Binding SplitMode, Converter={StaticResource EqualityConverter}, ConverterParameter=SplitByPageRanges}" />
                        <TextBlock Text="Separate distinct documents with commas, use hyphens for ranges. Only applies in &quot;Split by Page Ranges&quot; mode." FontSize="10.5" Foreground="{DynamicResource WinSubtleBrush}" TextWrapping="Wrap" />

                        <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                            <TextBlock Grid.Column="0" Text="Pages Per Document:" FontSize="12" Foreground="{DynamicResource WinMutedBrush}" VerticalAlignment="Center" />
                            <NumericUpDown Grid.Column="1" Value="{Binding SplitPagesInterval}" Minimum="1" Maximum="100" Width="90" IsEnabled="{Binding SplitMode, Converter={StaticResource EqualityConverter}, ConverterParameter=SplitEveryNPages}" />
                        </Grid>

                        <CheckBox Content="Separate Odd and Even Pages" IsChecked="{Binding SplitOddEven}" FontSize="12" Margin="0,4,0,0" />
                        <TextBlock Text="Overrides the mode above when checked." FontSize="10.5" Foreground="{DynamicResource WinSubtleBrush}" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </shell:PdfToolWorkspaceView.OptionsContent>

    </shell:PdfToolWorkspaceView>
</UserControl>
