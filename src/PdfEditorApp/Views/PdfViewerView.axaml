<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PdfEditorApp.ViewModels"
             xmlns:models="using:PdfEditorApp.Models"
             xmlns:controls="using:PdfEditorApp.Views.Controls"
             xmlns:converters="using:PdfEditorApp.Converters"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="800"
             x:Class="PdfEditorApp.Views.PdfViewerView"
             x:Name="RootPdfViewer"
             x:DataType="vm:PdfViewerViewModel"
             Background="{DynamicResource WinBgBrush}">

    <UserControl.Resources>
        <converters:ZoomPercentageConverter x:Key="ZoomPercentageConverter" />
        <converters:EqualityToBooleanConverter x:Key="EqualityConverter" />
        <converters:NullToBooleanConverter x:Key="NullToBooleanConverter" />
        <converters:BooleanToBrushConverter x:Key="BooleanToBrushConverter" />
        <converters:MultiplyConverter x:Key="MultiplyConverter" />
        <converters:HexToBrushConverter x:Key="HexToBrushConverter" />
    </UserControl.Resources>

    <!-- Reader-page/toolbar/thumbnail styling now lives in Styles/FluentOfficeStyles.axaml,
         shared with the tool-screen workspace shell (PdfToolWorkspaceView). -->

    <UserControl.KeyBindings>
        <KeyBinding Gesture="F2" Command="{Binding RenameDocumentCommand}" />
        <KeyBinding Gesture="Escape" Command="{Binding CancelLoadingCommand}" />
        <KeyBinding Gesture="Cmd+W" Command="{Binding BackToHomeCommand}" />
        <KeyBinding Gesture="Ctrl+W" Command="{Binding BackToHomeCommand}" />
        <KeyBinding Gesture="Cmd+F1" Command="{Binding ToggleRibbonCollapseCommand}" />
        <KeyBinding Gesture="Ctrl+F1" Command="{Binding ToggleRibbonCollapseCommand}" />
        <KeyBinding Gesture="Cmd+B" Command="{Binding ToggleSidebarCommand}" />
        <KeyBinding Gesture="Ctrl+B" Command="{Binding ToggleSidebarCommand}" />
        <KeyBinding Gesture="Cmd+F" Command="{Binding ToggleSearchBarCommand}" />
        <KeyBinding Gesture="Ctrl+F" Command="{Binding ToggleSearchBarCommand}" />
        <KeyBinding Gesture="Cmd+R" Command="{Binding RotateClockwiseCommand}" />
        <KeyBinding Gesture="Ctrl+R" Command="{Binding RotateClockwiseCommand}" />
        <KeyBinding Gesture="Cmd+O" Command="{Binding OpenAnotherPdfCommand}" />
        <KeyBinding Gesture="Ctrl+O" Command="{Binding OpenAnotherPdfCommand}" />
        <KeyBinding Gesture="Cmd+1" Command="{Binding FitToWidthCommand}" />
        <KeyBinding Gesture="Ctrl+1" Command="{Binding FitToWidthCommand}" />
        <KeyBinding Gesture="Cmd+9" Command="{Binding FitToPageCommand}" />
        <KeyBinding Gesture="Ctrl+9" Command="{Binding FitToPageCommand}" />
        <KeyBinding Gesture="Cmd+0" Command="{Binding ResetZoomCommand}" />
        <KeyBinding Gesture="Ctrl+0" Command="{Binding ResetZoomCommand}" />
        <KeyBinding Gesture="F11" Command="{Binding ToggleFullscreenCommand}" />
    </UserControl.KeyBindings>

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- ============================================================== -->
        <!-- 1. TOP M3 EXPRESSIVE PDF VIEWER RIBBON                         -->
        <!-- ============================================================== -->
        <Border Grid.Row="0"
                Background="{DynamicResource M3SurfaceContainerLowBrush}"
                BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                BorderThickness="0,0,0,1"
                IsVisible="{Binding !IsFullscreen}">
            <Grid RowDefinitions="Auto,Auto">

                <!-- 1.1 TOP RIBBON TABS & DOCUMENT BAR -->
                <Border Grid.Row="0"
                        Background="{DynamicResource M3SurfaceBrush}"
                        BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="12,6,12,6">
                    <Grid ColumnDefinitions="Auto,*,Auto">

                        <!-- Left: Back, Document Brand, Name & Options -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <!-- Back to Dashboard -->
                            <Button Classes="m3-icon-btn"
                                    Width="30" Height="30"
                                    Command="{Binding BackToHomeCommand}"
                                    ToolTip.Tip="Back to Home Dashboard (⌘W / Ctrl+W)">
                                <materialIcons:MaterialIcon Kind="ArrowLeft" Width="17" Height="17" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                            </Button>

                            <Rectangle Width="1" Height="16" Fill="{DynamicResource M3OutlineVariantBrush}" Margin="1,0" />

                            <!-- PDF File Badge & Title with Rename -->
                            <materialIcons:MaterialIcon Kind="FilePdfBox" Width="20" Height="20" Foreground="#E11D48" VerticalAlignment="Center" />

                            <Button Classes="m3-header-btn"
                                    Padding="6,2"
                                    Command="{Binding RenameDocumentCommand}"
                                    ToolTip.Tip="Rename Document (F2)">
                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding DocumentTitle}"
                                               FontSize="12.5"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource M3OnSurfaceBrush}"
                                               VerticalAlignment="Center"
                                               MaxWidth="180"
                                               TextTrimming="CharacterEllipsis" />
                                    <materialIcons:MaterialIcon Kind="PencilOutline" Width="12" Height="12" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <!-- Document Options Menu Button -->
                            <Button Classes="m3-icon-btn" Width="26" Height="26" ToolTip.Tip="Document Options (Rename, Duplicate, Reveal, Delete)">
                                <Button.Flyout>
                                    <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                        <MenuItem Header="Rename Document..." InputGesture="F2" Command="{Binding RenameDocumentCommand}">
                                            <MenuItem.Icon><materialIcons:MaterialIcon Kind="PencilOutline" Width="15" Height="15" Foreground="{DynamicResource M3PrimaryBrush}" /></MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Duplicate Document" Command="{Binding DuplicateDocumentCommand}">
                                            <MenuItem.Icon><materialIcons:MaterialIcon Kind="ContentCopy" Width="15" Height="15" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" /></MenuItem.Icon>
                                        </MenuItem>
                                        <Separator />
                                        <MenuItem Header="Reveal in File Manager" Command="{Binding RevealInFileManagerCommand}">
                                            <MenuItem.Icon><materialIcons:MaterialIcon Kind="FolderOpenOutline" Width="15" Height="15" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" /></MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Copy File Path" Command="{Binding CopyPathCommand}">
                                            <MenuItem.Icon><materialIcons:MaterialIcon Kind="ClipboardTextOutline" Width="15" Height="15" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" /></MenuItem.Icon>
                                        </MenuItem>
                                        <Separator />
                                        <MenuItem Header="Delete File..." Command="{Binding DeleteDocumentCommand}">
                                            <MenuItem.Icon><materialIcons:MaterialIcon Kind="TrashCanOutline" Width="15" Height="15" Foreground="#DC2626" /></MenuItem.Icon>
                                        </MenuItem>
                                    </MenuFlyout>
                                </Button.Flyout>
                                <materialIcons:MaterialIcon Kind="DotsVertical" Width="14" Height="14" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                            </Button>

                            <!-- Pages Count Pill -->
                            <Border Background="{DynamicResource M3SurfaceContainerHighBrush}"
                                    CornerRadius="{StaticResource M3ShapeCornerFull}"
                                    Padding="8,2" VerticalAlignment="Center">
                                <TextBlock Text="{Binding TotalPagesCount, StringFormat='{}{0} pgs'}"
                                           FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                            </Border>

                            <!-- File Size Badge -->
                            <Border Background="{DynamicResource M3SurfaceContainerHighBrush}"
                                    CornerRadius="{StaticResource M3ShapeCornerFull}"
                                    Padding="8,2" VerticalAlignment="Center"
                                    IsVisible="{Binding HasDocumentFileSize}">
                                <TextBlock Text="{Binding DocumentFileSize}"
                                           FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                            </Border>
                        </StackPanel>

                        <!-- Center: Ribbon Tab Selection Segmented Capsule -->
                        <Border Grid.Column="1" Classes="m3-segmented-container" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="2">
                                <!-- View Tab -->
                                <Button Classes="m3-segment-btn"
                                        Classes.active="{Binding ActiveRibbonTab, Converter={StaticResource EqualityConverter}, ConverterParameter=View}"
                                        Command="{Binding SelectRibbonTabCommand}"
                                        CommandParameter="{x:Static vm:PdfViewerRibbonTab.View}"
                                        ToolTip.Tip="View: Page navigation, single/spread layout, zoom &amp; sizing">
                                    <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                        <materialIcons:MaterialIcon Kind="EyeOutline" Width="14" Height="14" />
                                        <TextBlock Text="View" VerticalAlignment="Center" FontSize="11.5" />
                                    </StackPanel>
                                </Button>

                                <!-- Annotate Tab -->
                                <Button Classes="m3-segment-btn"
                                        Classes.active="{Binding ActiveRibbonTab, Converter={StaticResource EqualityConverter}, ConverterParameter=Annotate}"
                                        Command="{Binding SelectRibbonTabCommand}"
                                        CommandParameter="{x:Static vm:PdfViewerRibbonTab.Annotate}"
                                        ToolTip.Tip="Annotate: Text/Area selection, highlights, sticky notes, stamps &amp; OCR">
                                    <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                        <materialIcons:MaterialIcon Kind="DrawPen" Width="14" Height="14" />
                                        <TextBlock Text="Annotate" VerticalAlignment="Center" FontSize="11.5" />
                                    </StackPanel>
                                </Button>

                                <!-- Tools Tab -->
                                <Button Classes="m3-segment-btn"
                                        Classes.active="{Binding ActiveRibbonTab, Converter={StaticResource EqualityConverter}, ConverterParameter=Tools}"
                                        Command="{Binding SelectRibbonTabCommand}"
                                        CommandParameter="{x:Static vm:PdfViewerRibbonTab.Tools}"
                                        ToolTip.Tip="Tools: Find text, page rotation, save copy &amp; FryPDF Studio bridge">
                                    <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                        <materialIcons:MaterialIcon Kind="Tools" Width="14" Height="14" />
                                        <TextBlock Text="Tools" VerticalAlignment="Center" FontSize="11.5" />
                                    </StackPanel>
                                </Button>

                                <!-- Themes Tab -->
                                <Button Classes="m3-segment-btn"
                                        Classes.active="{Binding ActiveRibbonTab, Converter={StaticResource EqualityConverter}, ConverterParameter=Themes}"
                                        Command="{Binding SelectRibbonTabCommand}"
                                        CommandParameter="{x:Static vm:PdfViewerRibbonTab.Themes}"
                                        ToolTip.Tip="Themes: Eye-comfort reading modes &amp; sidebar navigation panels">
                                    <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                        <materialIcons:MaterialIcon Kind="PaletteOutline" Width="14" Height="14" />
                                        <TextBlock Text="Themes" VerticalAlignment="Center" FontSize="11.5" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- Right: Quick Actions & Ribbon Collapse -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <!-- Quick Find in Document -->
                            <Button Classes="m3-icon-btn" Width="28" Height="28"
                                    Classes.active="{Binding IsSearchBarVisible}"
                                    Command="{Binding ToggleSearchBarCommand}"
                                    ToolTip.Tip="Find Text in Document (⌘F / Ctrl+F)">
                                <materialIcons:MaterialIcon Kind="Magnify" Width="15" Height="15" />
                            </Button>

                            <!-- Primary Action: Edit in Studio -->
                            <Button Classes="m3-filled-btn"
                                    Padding="12,5"
                                    Height="30"
                                    Command="{Binding EditInStudioCommand}"
                                    ToolTip.Tip="Open in FryPDF Editor to modify text, vector layouts, and images">
                                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                    <materialIcons:MaterialIcon Kind="PencilBoxOutline" Width="14" Height="14" />
                                    <TextBlock Text="Edit in Studio" VerticalAlignment="Center" FontSize="11.5" />
                                </StackPanel>
                            </Button>

                            <Rectangle Width="1" Height="16" Fill="{DynamicResource M3OutlineVariantBrush}" Margin="2,0" />

                            <!-- Sidebar Toggle -->
                            <Button Classes="m3-icon-btn" Width="28" Height="28"
                                    Classes.active="{Binding IsSidebarOpen}"
                                    Command="{Binding ToggleSidebarCommand}"
                                    ToolTip.Tip="Toggle Navigation Sidebar (⌘B / Ctrl+B)">
                                <materialIcons:MaterialIcon Kind="DockLeft" Width="15" Height="15" />
                            </Button>

                            <!-- Ribbon Minimize / Expand Chevron -->
                            <Button Classes="m3-icon-btn" Width="28" Height="28"
                                    Command="{Binding ToggleRibbonCollapseCommand}"
                                    ToolTip.Tip="Collapse or Expand Ribbon Toolbar (⌘F1 / Ctrl+F1)">
                                <materialIcons:MaterialIcon Kind="{Binding IsRibbonCollapsed, Converter={StaticResource BooleanToStringConverter}, ConverterParameter='ChevronDown|ChevronUp'}"
                                                            Width="16" Height="16" />
                            </Button>
                        </StackPanel>

                    </Grid>
                </Border>

                <!-- 1.2 RIBBON DYNAMIC TOOLS PANEL (COLLAPSIBLE) -->
                <Border Grid.Row="1"
                        Background="{DynamicResource M3SurfaceContainerLowBrush}"
                        Height="46"
                        Padding="12,0"
                        IsVisible="{Binding !IsRibbonCollapsed}">
                    <ScrollViewer Classes="ribbon-scroll-viewer" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <Panel VerticalAlignment="Center">

                            <!-- ================= TAB 1: VIEW ================= -->
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                                        IsVisible="{Binding ActiveRibbonTab, Converter={StaticResource EqualityConverter}, ConverterParameter=View}">

                                <!-- Navigation Segmented Capsule -->
                                <Border Classes="m3-segmented-container">
                                    <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                                        <Button Classes="m3-segment-btn" Width="28" Height="28" Padding="0"
                                                Command="{Binding FirstPageCommand}" ToolTip.Tip="First Page (Home)">
                                            <materialIcons:MaterialIcon Kind="PageFirst" Width="15" Height="15" />
                                        </Button>
                                        <Button Classes="m3-segment-btn" Width="28" Height="28" Padding="0"
                                                Command="{Binding PreviousPageCommand}" ToolTip.Tip="Previous Page (PageUp / ⌥←)">
                                            <materialIcons:MaterialIcon Kind="ChevronLeft" Width="17" Height="17" />
                                        </Button>

                                        <!-- Direct Page Jump Input Capsule -->
                                        <Border Background="{DynamicResource M3SurfaceContainerHighBrush}"
                                                CornerRadius="{StaticResource M3ShapeCornerFull}"
                                                Padding="6,0" Margin="2,0" VerticalAlignment="Center" Height="26">
                                            <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                                                <TextBox x:Name="JumpPageTextBox"
                                                         Text="{Binding JumpPageText, Mode=TwoWay}"
                                                         Width="32" Height="22"
                                                         FontSize="11.5" FontWeight="SemiBold"
                                                         TextAlignment="Center"
                                                         Background="Transparent"
                                                         BorderThickness="0"
                                                         Padding="0"
                                                         VerticalAlignment="Center"
                                                         ToolTip.Tip="Type page number and press Enter to jump">
                                                    <TextBox.KeyBindings>
                                                        <KeyBinding Gesture="Enter" Command="{Binding CommitJumpPageCommand}" />
                                                    </TextBox.KeyBindings>
                                                </TextBox>

                                                <TextBlock Text="{Binding TotalPagesCount, StringFormat='/ {0}'}"
                                                           FontSize="11" FontWeight="Medium"
                                                           Foreground="{DynamicResource M3OnSurfaceVariantBrush}"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,3,0" />
                                            </StackPanel>
                                        </Border>

                                        <Button Classes="m3-segment-btn" Width="28" Height="28" Padding="0"
                                                Command="{Binding NextPageCommand}" ToolTip.Tip="Next Page (PageDown / ⌥→)">
                                            <materialIcons:MaterialIcon Kind="ChevronRight" Width="17" Height="17" />
                                        </Button>
                                        <Button Classes="m3-segment-btn" Width="28" Height="28" Padding="0"
                                                Command="{Binding LastPageCommand}" ToolTip.Tip="Last Page (End)">
                                            <materialIcons:MaterialIcon Kind="PageLast" Width="15" Height="15" />
                                        </Button>
                                    </StackPanel>
                                </Border>

                                <!-- Page Layout Segmented Capsule -->
                                <Border Classes="m3-segmented-container">
                                    <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                                        <Button Classes="m3-segment-btn"
                                                Classes.active="{Binding IsSinglePageMode}"
                                                Command="{Binding SetSinglePageLayoutCommand}"
                                                ToolTip.Tip="Single Page Fit View">
                                            <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                                <materialIcons:MaterialIcon Kind="FileDocumentOutline" Width="15" Height="15" />
                                                <TextBlock Text="Single Page" VerticalAlignment="Center" FontSize="11.5" />
                                            </StackPanel>
                                        </Button>
                                        <Button Classes="m3-segment-btn"
                                                Classes.active="{Binding IsTwoPageSpreadMode}"
                                                Command="{Binding SetTwoPageSpreadLayoutCommand}"
                                                ToolTip.Tip="Two-Page Spread (Book &amp; Magazine Mode)">
                                            <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                                <materialIcons:MaterialIcon Kind="BookOpenPageVariantOutline" Width="15" Height="15" />
                                                <TextBlock Text="Two-Page" VerticalAlignment="Center" FontSize="11.5" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Border>

                                <!-- Zoom Mode Segmented Capsule -->
                                <Border Classes="m3-segmented-container">
                                    <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                                        <Button Classes="m3-segment-btn"
                                                Classes.active="{Binding IsFitToWidthActive}"
                                                Command="{Binding FitToWidthCommand}"
                                                ToolTip.Tip="Fit to Width (⌘1 / Ctrl+1)">
                                            <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                                <materialIcons:MaterialIcon Kind="ArrowExpandHorizontal" Width="15" Height="15" />
                                                <TextBlock Text="Fit Width" VerticalAlignment="Center" FontSize="11.5" />
                                            </StackPanel>
                                        </Button>
                                        <Button Classes="m3-segment-btn"
                                                Classes.active="{Binding IsFitToPageActive}"
                                                Command="{Binding FitToPageCommand}"
                                                ToolTip.Tip="Fit to Page (⌘9 / Ctrl+9)">
                                            <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                                <materialIcons:MaterialIcon Kind="FitToScreenOutline" Width="15" Height="15" />
                                                <TextBlock Text="Fit Page" VerticalAlignment="Center" FontSize="11.5" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Border>

                                <!-- Zoom Stepper Segmented Capsule -->
                                <Border Classes="m3-segmented-container">
                                    <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                                        <Button Classes="m3-segment-btn" Width="26" Height="28" Padding="0"
                                                Command="{Binding ZoomOutCommand}" ToolTip.Tip="Zoom Out (⌘-)">
                                            <materialIcons:MaterialIcon Kind="Minus" Width="14" Height="14" />
                                        </Button>
                                        <Button Classes="m3-segment-btn" Padding="8,2" Height="28"
                                                Command="{Binding ResetZoomCommand}"
                                                ToolTip.Tip="Reset 100% Zoom (⌘0 / Ctrl+0)">
                                            <TextBlock Text="{Binding ZoomPercentageText}" FontSize="11" FontWeight="SemiBold" TextAlignment="Center" />
                                        </Button>
                                        <Button Classes="m3-segment-btn" Width="26" Height="28" Padding="0"
                                                Command="{Binding ZoomInCommand}" ToolTip.Tip="Zoom In (⌘+)">
                                            <materialIcons:MaterialIcon Kind="Plus" Width="14" Height="14" />
                                        </Button>
                                        <Button Classes="m3-segment-btn" Width="24" Height="28" Padding="0"
                                                ToolTip.Tip="Zoom Presets">
                                            <Button.Flyout>
                                                <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                                    <MenuItem Header="50%" Command="{Binding SetZoomPresetCommand}" CommandParameter="50%" />
                                                    <MenuItem Header="75%" Command="{Binding SetZoomPresetCommand}" CommandParameter="75%" />
                                                    <MenuItem Header="100% (Actual Size)" Command="{Binding SetZoomPresetCommand}" CommandParameter="100%" />
                                                    <MenuItem Header="125%" Command="{Binding SetZoomPresetCommand}" CommandParameter="125%" />
                                                    <MenuItem Header="150%" Command="{Binding SetZoomPresetCommand}" CommandParameter="150%" />
                                                    <MenuItem Header="200%" Command="{Binding SetZoomPresetCommand}" CommandParameter="200%" />
                                                    <MenuItem Header="300%" Command="{Binding SetZoomPresetCommand}" CommandParameter="300%" />
                                                    <MenuItem Header="400%" Command="{Binding SetZoomPresetCommand}" CommandParameter="400%" />
                                                </MenuFlyout>
                                            </Button.Flyout>
                                            <materialIcons:MaterialIcon Kind="ChevronDown" Width="14" Height="14" />
                                        </Button>
                                    </StackPanel>
                                </Border>

                                <!-- Viewport Chips -->
                                <Button Classes="m3-filter-chip pill"
                                        Classes.active="{Binding IsFullscreen}"
                                        Command="{Binding ToggleFullscreenCommand}"
                                        ToolTip.Tip="Presentation Fullscreen Mode (F11)">
                                    <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                        <materialIcons:MaterialIcon Kind="Fullscreen" Width="15" Height="15" />
                                        <TextBlock Text="Fullscreen" VerticalAlignment="Center" FontSize="11.5" />
                                    </StackPanel>
                                </Button>

                                <Button Classes="m3-filter-chip pill"
                                        Classes.active="{Binding IsSidebarOpen}"
                                        Command="{Binding ToggleSidebarCommand}"
                                        ToolTip.Tip="Toggle Navigation Sidebar (⌘B / Ctrl+B)">
                                    <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                        <materialIcons:MaterialIcon Kind="DockLeft" Width="15" Height="15" />
                                        <TextBlock Text="Sidebar" VerticalAlignment="Center" FontSize="11.5" />
                                    </StackPanel>
                                </Button>

                            </StackPanel>


                            <!-- ================= TAB 2: ANNOTATE ================= -->
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                                        IsVisible="{Binding ActiveRibbonTab, Converter={StaticResource EqualityConverter}, ConverterParameter=Annotate}">

                                <!-- Selection Modes Segmented Capsule -->
                                <Border Classes="m3-segmented-container">
                                    <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                                        <Button Classes="m3-segment-btn"
                                                Classes.active="{Binding IsTextSelectionMode}"
                                                Command="{Binding SetTextSelectionModeCommand}"
                                                ToolTip.Tip="Text Selection Tool (I-Beam): Click &amp; drag words/lines">
                                            <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                                <materialIcons:MaterialIcon Kind="FormatColorText" Width="15" Height="15" />
                                                <TextBlock Text="Text Select" VerticalAlignment="Center" FontSize="11.5" />
                                            </StackPanel>
                                        </Button>
                                        <Button Classes="m3-segment-btn"
                                                Classes.active="{Binding IsAreaSelectionMode}"
                                                Command="{Binding SetAreaSelectionModeCommand}"
                                                ToolTip.Tip="Area / Marquee Tool: Select rectangular regions on scanned documents, tables &amp; columns">
                                            <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                                <materialIcons:MaterialIcon Kind="CropFree" Width="15" Height="15" />
                                                <TextBlock Text="Area Select" VerticalAlignment="Center" FontSize="11.5" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Border>

                                <!-- Highlight & Palette Segmented Capsule -->
                                <Border Classes="m3-segmented-container">
                                    <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                                        <Button Classes="m3-segment-btn"
                                                Command="{Binding AddHighlightAnnotationCommand}"
                                                CommandParameter="#FEF08A"
                                                ToolTip.Tip="Highlight Selected Text or Passage">
                                            <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                                <materialIcons:MaterialIcon Kind="FormatColorHighlight" Width="15" Height="15" Foreground="#CA8A04" />
                                                <TextBlock Text="Highlight" VerticalAlignment="Center" FontSize="11.5" />
                                            </StackPanel>
                                        </Button>
                                        <Button Classes="m3-segment-btn" Width="24" Height="28" Padding="0"
                                                ToolTip.Tip="Highlight Color Palette">
                                            <Button.Flyout>
                                                <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                                    <MenuItem Header="Yellow" Command="{Binding AddHighlightAnnotationCommand}" CommandParameter="#FEF08A">
                                                        <MenuItem.Icon><materialIcons:MaterialIcon Kind="Circle" Width="14" Height="14" Foreground="#EAB308" /></MenuItem.Icon>
                                                    </MenuItem>
                                                    <MenuItem Header="Green" Command="{Binding AddHighlightAnnotationCommand}" CommandParameter="#BBF7D0">
                                                        <MenuItem.Icon><materialIcons:MaterialIcon Kind="Circle" Width="14" Height="14" Foreground="#22C55E" /></MenuItem.Icon>
                                                    </MenuItem>
                                                    <MenuItem Header="Blue" Command="{Binding AddHighlightAnnotationCommand}" CommandParameter="#BAE6FD">
                                                        <MenuItem.Icon><materialIcons:MaterialIcon Kind="Circle" Width="14" Height="14" Foreground="#0EA5E9" /></MenuItem.Icon>
                                                    </MenuItem>
                                                    <MenuItem Header="Pink" Command="{Binding AddHighlightAnnotationCommand}" CommandParameter="#FBCFE8">
                                                        <MenuItem.Icon><materialIcons:MaterialIcon Kind="Circle" Width="14" Height="14" Foreground="#EC4899" /></MenuItem.Icon>
                                                    </MenuItem>
                                                    <MenuItem Header="Purple" Command="{Binding AddHighlightAnnotationCommand}" CommandParameter="#E9D5FF">
                                                        <MenuItem.Icon><materialIcons:MaterialIcon Kind="Circle" Width="14" Height="14" Foreground="#A855F7" /></MenuItem.Icon>
                                                    </MenuItem>
                                                </MenuFlyout>
                                            </Button.Flyout>
                                            <materialIcons:MaterialIcon Kind="Palette" Width="14" Height="14" Foreground="#CA8A04" />
                                        </Button>
                                    </StackPanel>
                                </Border>

                                <!-- Notes Chips -->
                                <Button Classes="m3-filter-chip pill"
                                        Command="{Binding OpenAddNoteDialogCommand}"
                                        ToolTip.Tip="Add Sticky Note Annotation">
                                    <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                        <materialIcons:MaterialIcon Kind="CommentTextOutline" Width="15" Height="15" Foreground="#0284C7" />
                                        <TextBlock Text="Sticky Note" VerticalAlignment="Center" FontSize="11.5" />
                                    </StackPanel>
                                </Button>

                                <Button Classes="m3-filter-chip pill"
                                        Command="{Binding AddNoteFromSelectionCommand}"
                                        ToolTip.Tip="Add Note Quoting Active Text Selection">
                                    <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                        <materialIcons:MaterialIcon Kind="CommentQuoteOutline" Width="15" Height="15" Foreground="#8B5CF6" />
                                        <TextBlock Text="Note Quote" VerticalAlignment="Center" FontSize="11.5" />
                                    </StackPanel>
                                </Button>

                                <!-- Stamps Segmented Capsule -->
                                <Border Classes="m3-segmented-container">
                                    <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                                        <Button Classes="m3-segment-btn"
                                                Command="{Binding AddStampCommand}"
                                                CommandParameter="APPROVED"
                                                ToolTip.Tip="Apply 'APPROVED' Stamp">
                                            <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                                <materialIcons:MaterialIcon Kind="CheckDecagramOutline" Width="15" Height="15" Foreground="#16A34A" />
                                                <TextBlock Text="Approved" VerticalAlignment="Center" FontSize="11.5" />
                                            </StackPanel>
                                        </Button>
                                        <Button Classes="m3-segment-btn"
                                                Command="{Binding AddStampCommand}"
                                                CommandParameter="REVIEWED"
                                                ToolTip.Tip="Apply 'REVIEWED' Stamp">
                                            <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                                <materialIcons:MaterialIcon Kind="FileCheckOutline" Width="15" Height="15" Foreground="#2563EB" />
                                                <TextBlock Text="Reviewed" VerticalAlignment="Center" FontSize="11.5" />
                                            </StackPanel>
                                        </Button>
                                        <Button Classes="m3-segment-btn"
                                                Command="{Binding AddStampCommand}"
                                                CommandParameter="CONFIDENTIAL"
                                                ToolTip.Tip="Apply 'CONFIDENTIAL' Stamp">
                                            <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                                <materialIcons:MaterialIcon Kind="ShieldAlertOutline" Width="15" Height="15" Foreground="#DC2626" />
                                                <TextBlock Text="Confidential" VerticalAlignment="Center" FontSize="11.5" />
                                            </StackPanel>
                                        </Button>
                                        <Button Classes="m3-segment-btn"
                                                Command="{Binding AddStampCommand}"
                                                CommandParameter="DRAFT"
                                                ToolTip.Tip="Apply 'DRAFT' Stamp">
                                            <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                                <materialIcons:MaterialIcon Kind="FileClockOutline" Width="15" Height="15" Foreground="#D97706" />
                                                <TextBlock Text="Draft" VerticalAlignment="Center" FontSize="11.5" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Border>

                                <!-- OCR & Copy -->
                                <Button Classes="m3-filter-chip pill"
                                        Classes.active="{Binding IsCurrentPageScanned}"
                                        Command="{Binding RecognizeActivePageOcrCommand}"
                                        ToolTip.Tip="Recognize Text with OCR on this page (Apple Vision / Tesseract)">
                                    <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                        <materialIcons:MaterialIcon Kind="ScanHelper" Width="15" Height="15" Foreground="{DynamicResource M3PrimaryBrush}" />
                                        <TextBlock Text="OCR Page" VerticalAlignment="Center" FontSize="11.5" />
                                    </StackPanel>
                                </Button>

                                <Border Classes="m3-segmented-container">
                                    <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                                        <Button Classes="m3-segment-btn"
                                                Command="{Binding CopySelectedTextCommand}"
                                                ToolTip.Tip="Copy Selected Text to Clipboard (⌘C / Ctrl+C)">
                                            <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                                <materialIcons:MaterialIcon Kind="ContentCopy" Width="15" Height="15" />
                                                <TextBlock Text="Copy Text" VerticalAlignment="Center" FontSize="11.5" />
                                            </StackPanel>
                                        </Button>
                                        <Button Classes="m3-segment-btn"
                                                Command="{Binding CopySelectedCitationCommand}"
                                                ToolTip.Tip="Copy Citation with Page Reference &amp; Document Name">
                                            <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                                <materialIcons:MaterialIcon Kind="FormatQuoteClose" Width="15" Height="15" />
                                                <TextBlock Text="Citation" VerticalAlignment="Center" FontSize="11.5" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Border>

                            </StackPanel>


                            <!-- ================= TAB 3: TOOLS ================= -->
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                                        IsVisible="{Binding ActiveRibbonTab, Converter={StaticResource EqualityConverter}, ConverterParameter=Tools}">

                                <!-- Search Chip -->
                                <Button Classes="m3-filter-chip pill"
                                        Classes.active="{Binding IsSearchBarVisible}"
                                        Command="{Binding ToggleSearchBarCommand}"
                                        ToolTip.Tip="Find Text across Document (⌘F / Ctrl+F)">
                                    <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                        <materialIcons:MaterialIcon Kind="Magnify" Width="15" Height="15" Foreground="{DynamicResource M3PrimaryBrush}" />
                                        <TextBlock Text="Find Text" VerticalAlignment="Center" FontSize="11.5" />
                                    </StackPanel>
                                </Button>

                                <!-- Page Rotation Segmented Capsule -->
                                <Border Classes="m3-segmented-container">
                                    <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                                        <Button Classes="m3-segment-btn"
                                                Command="{Binding RotateClockwiseCommand}"
                                                ToolTip.Tip="Rotate 90° Clockwise (⌘R / Ctrl+R)">
                                            <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                                <materialIcons:MaterialIcon Kind="RotateRight" Width="15" Height="15" />
                                                <TextBlock Text="Rotate CW" VerticalAlignment="Center" FontSize="11.5" />
                                            </StackPanel>
                                        </Button>
                                        <Button Classes="m3-segment-btn"
                                                Command="{Binding RotateCounterClockwiseCommand}"
                                                ToolTip.Tip="Rotate 90° Counter-Clockwise">
                                            <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                                <materialIcons:MaterialIcon Kind="RotateLeft" Width="15" Height="15" />
                                                <TextBlock Text="Rotate CCW" VerticalAlignment="Center" FontSize="11.5" />
                                            </StackPanel>
                                        </Button>
                                        <Button Classes="m3-segment-btn"
                                                Command="{Binding RotateAllPagesClockwiseCommand}"
                                                ToolTip.Tip="Rotate All Pages 90° Clockwise">
                                            <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                                <materialIcons:MaterialIcon Kind="Autorenew" Width="15" Height="15" />
                                                <TextBlock Text="Rotate All" VerticalAlignment="Center" FontSize="11.5" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Border>

                                <!-- Document Operations Segmented Capsule -->
                                <Border Classes="m3-segmented-container">
                                    <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                                        <Button Classes="m3-segment-btn"
                                                Command="{Binding SaveAsCommand}"
                                                ToolTip.Tip="Save Document Copy As...">
                                            <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                                <materialIcons:MaterialIcon Kind="ContentSaveOutline" Width="15" Height="15" />
                                                <TextBlock Text="Save As..." VerticalAlignment="Center" FontSize="11.5" />
                                            </StackPanel>
                                        </Button>
                                        <Button Classes="m3-segment-btn"
                                                Command="{Binding OpenAnotherPdfCommand}"
                                                ToolTip.Tip="Open another PDF document (⌘O / Ctrl+O)">
                                            <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                                <materialIcons:MaterialIcon Kind="FolderOpenOutline" Width="15" Height="15" />
                                                <TextBlock Text="Open PDF" VerticalAlignment="Center" FontSize="11.5" />
                                            </StackPanel>
                                        </Button>
                                        <Button Classes="m3-segment-btn"
                                                Command="{Binding RevealInFileManagerCommand}"
                                                ToolTip.Tip="Reveal PDF file in system file manager">
                                            <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                                <materialIcons:MaterialIcon Kind="FolderEyeOutline" Width="15" Height="15" />
                                                <TextBlock Text="Show File" VerticalAlignment="Center" FontSize="11.5" />
                                            </StackPanel>
                                        </Button>
                                        <Button Classes="m3-segment-btn"
                                                Command="{Binding RenameDocumentCommand}"
                                                ToolTip.Tip="Rename Document (F2)">
                                            <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                                <materialIcons:MaterialIcon Kind="PencilOutline" Width="15" Height="15" />
                                                <TextBlock Text="Rename" VerticalAlignment="Center" FontSize="11.5" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Border>

                                <!-- FryPDF Studio & PDF Tools Bridge -->
                                <Button Classes="m3-filled-btn"
                                        Height="30"
                                        Padding="12,5"
                                        Command="{Binding EditInStudioCommand}"
                                        ToolTip.Tip="Open live vector deconstruction editor to edit text, objects &amp; images">
                                    <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                        <materialIcons:MaterialIcon Kind="DrawPen" Width="15" Height="15" />
                                        <TextBlock Text="Edit in Studio" VerticalAlignment="Center" FontSize="11.5" />
                                    </StackPanel>
                                </Button>

                                <Button Classes="m3-filter-chip pill"
                                        ToolTip.Tip="Run Modular PDF Processing Tools">
                                    <Button.Flyout>
                                        <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                            <MenuItem Header="Compress PDF..." Command="{Binding RunToolOnDocumentCommand}" CommandParameter="Compress">
                                                <MenuItem.Icon><materialIcons:MaterialIcon Kind="ZipBoxOutline" Width="15" Height="15" Foreground="{DynamicResource M3PrimaryBrush}" /></MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="Watermark PDF..." Command="{Binding RunToolOnDocumentCommand}" CommandParameter="Watermark">
                                                <MenuItem.Icon><materialIcons:MaterialIcon Kind="Watermark" Width="15" Height="15" Foreground="#0284C7" /></MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="Convert PDF to Office/Images..." Command="{Binding RunToolOnDocumentCommand}" CommandParameter="Convert">
                                                <MenuItem.Icon><materialIcons:MaterialIcon Kind="FileSyncOutline" Width="15" Height="15" Foreground="#16A34A" /></MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="Split Pages..." Command="{Binding RunToolOnDocumentCommand}" CommandParameter="Split">
                                                <MenuItem.Icon><materialIcons:MaterialIcon Kind="CallSplit" Width="15" Height="15" Foreground="#D97706" /></MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="Merge Documents..." Command="{Binding RunToolOnDocumentCommand}" CommandParameter="Merge">
                                                <MenuItem.Icon><materialIcons:MaterialIcon Kind="CallMerge" Width="15" Height="15" Foreground="#8B5CF6" /></MenuItem.Icon>
                                            </MenuItem>
                                        </MenuFlyout>
                                    </Button.Flyout>
                                    <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                        <materialIcons:MaterialIcon Kind="WrenchOutline" Width="15" Height="15" />
                                        <TextBlock Text="PDF Tools ▾" VerticalAlignment="Center" FontSize="11.5" />
                                    </StackPanel>
                                </Button>

                            </StackPanel>


                            <!-- ================= TAB 4: THEMES ================= -->
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                                        IsVisible="{Binding ActiveRibbonTab, Converter={StaticResource EqualityConverter}, ConverterParameter=Themes}">

                                <!-- Reading Themes Segmented Capsule -->
                                <Border Classes="m3-segmented-container">
                                    <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                                        <Button Classes="m3-segment-btn"
                                                Classes.active="{Binding IsThemeDefault}"
                                                Command="{Binding SetDefaultReadingThemeCommand}"
                                                ToolTip.Tip="Daylight Theme (Standard White Paper)">
                                            <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                                <materialIcons:MaterialIcon Kind="WhiteBalanceSunny" Width="15" Height="15" />
                                                <TextBlock Text="Daylight" VerticalAlignment="Center" FontSize="11.5" />
                                            </StackPanel>
                                        </Button>
                                        <Button Classes="m3-segment-btn"
                                                Classes.active="{Binding IsThemeSepia}"
                                                Command="{Binding SetSepiaReadingThemeCommand}"
                                                ToolTip.Tip="Warm Sepia Book Theme (Reduced Eye Fatigue)">
                                            <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                                <materialIcons:MaterialIcon Kind="BookOpenOutline" Width="15" Height="15" />
                                                <TextBlock Text="Warm Sepia" VerticalAlignment="Center" FontSize="11.5" />
                                            </StackPanel>
                                        </Button>
                                        <Button Classes="m3-segment-btn"
                                                Classes.active="{Binding IsThemeDark}"
                                                Command="{Binding SetDarkReadingThemeCommand}"
                                                ToolTip.Tip="Dark Night Reading Theme (OLED / Low Light)">
                                            <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                                <materialIcons:MaterialIcon Kind="WeatherNight" Width="15" Height="15" />
                                                <TextBlock Text="Dark Night" VerticalAlignment="Center" FontSize="11.5" />
                                            </StackPanel>
                                        </Button>
                                        <Button Classes="m3-segment-btn"
                                                Classes.active="{Binding IsThemeHighContrast}"
                                                Command="{Binding SetHighContrastReadingThemeCommand}"
                                                ToolTip.Tip="High Contrast Mode (Accessibility)">
                                            <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                                <materialIcons:MaterialIcon Kind="ContrastCircle" Width="15" Height="15" />
                                                <TextBlock Text="High Contrast" VerticalAlignment="Center" FontSize="11.5" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Border>

                                <!-- Sidebar Panels Segmented Capsule -->
                                <Border Classes="m3-segmented-container">
                                    <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                                        <Button Classes="m3-segment-btn"
                                                Command="{Binding SelectSidebarTabCommand}"
                                                CommandParameter="Thumbnails"
                                                ToolTip.Tip="Show Page Thumbnails Panel">
                                            <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                                <materialIcons:MaterialIcon Kind="ViewGridOutline" Width="15" Height="15" />
                                                <TextBlock Text="Thumbnails" VerticalAlignment="Center" FontSize="11.5" />
                                            </StackPanel>
                                        </Button>
                                        <Button Classes="m3-segment-btn"
                                                Command="{Binding SelectSidebarTabCommand}"
                                                CommandParameter="Bookmarks"
                                                ToolTip.Tip="Show Document Outline &amp; Bookmarks">
                                            <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                                <materialIcons:MaterialIcon Kind="BookmarkMultipleOutline" Width="15" Height="15" />
                                                <TextBlock Text="Bookmarks" VerticalAlignment="Center" FontSize="11.5" />
                                            </StackPanel>
                                        </Button>
                                        <Button Classes="m3-segment-btn"
                                                Command="{Binding SelectSidebarTabCommand}"
                                                CommandParameter="Annotations"
                                                ToolTip.Tip="Show Review Annotations List">
                                            <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                                <materialIcons:MaterialIcon Kind="CommentOutline" Width="15" Height="15" />
                                                <TextBlock Text="Annotations" VerticalAlignment="Center" FontSize="11.5" />
                                            </StackPanel>
                                        </Button>
                                        <Button Classes="m3-segment-btn"
                                                Command="{Binding SelectSidebarTabCommand}"
                                                CommandParameter="Info"
                                                ToolTip.Tip="Show Document Metadata &amp; Security Info">
                                            <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                                <materialIcons:MaterialIcon Kind="InformationOutline" Width="15" Height="15" />
                                                <TextBlock Text="File Info" VerticalAlignment="Center" FontSize="11.5" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Border>

                                <!-- Quick Layout Segmented Capsule -->
                                <Border Classes="m3-segmented-container">
                                    <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                                        <Button Classes="m3-segment-btn"
                                                Classes.active="{Binding IsSinglePageMode}"
                                                Command="{Binding SetSinglePageLayoutCommand}"
                                                ToolTip.Tip="Single Page Fit View">
                                            <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                                <materialIcons:MaterialIcon Kind="FileDocumentOutline" Width="15" Height="15" />
                                                <TextBlock Text="Single Page" VerticalAlignment="Center" FontSize="11.5" />
                                            </StackPanel>
                                        </Button>
                                        <Button Classes="m3-segment-btn"
                                                Classes.active="{Binding IsTwoPageSpreadMode}"
                                                Command="{Binding SetTwoPageSpreadLayoutCommand}"
                                                ToolTip.Tip="Two-Page Spread (Book &amp; Magazine Mode)">
                                            <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                                <materialIcons:MaterialIcon Kind="BookOpenPageVariantOutline" Width="15" Height="15" />
                                                <TextBlock Text="Two-Page" VerticalAlignment="Center" FontSize="11.5" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Border>

                            </StackPanel>

                        </Panel>
                    </ScrollViewer>
                </Border>

            </Grid>
        </Border>

        <!-- ======================================================= -->
        <!-- 2. MAIN WORKSPACE (LEFT SIDEBAR + CENTER READING CANVAS) -->
        <!-- ======================================================= -->
        <Grid Grid.Row="1" ColumnDefinitions="Auto,*">

            <!-- LEFT NAVIGATION & INSPECTION SIDEBAR -->
            <Border Grid.Column="0"
                    Width="280"
                    Background="{DynamicResource WinPanelBrush}"
                    BorderBrush="{DynamicResource WinBorderBrush}"
                    BorderThickness="0,0,1,0"
                    IsVisible="{Binding IsSidebarOpen}">
                <Grid RowDefinitions="Auto,*">

                    <!-- Sidebar Tab Switcher (5 Tabs with active styling) -->
                    <Border Grid.Row="0" Background="{DynamicResource WinInputBgBrush}" BorderBrush="{DynamicResource WinBorderBrush}" BorderThickness="0,0,0,1" Padding="4,4">
                        <UniformGrid Columns="5">
                            <!-- Thumbnails Tab -->
                            <Button Classes="toolbar-btn"
                                    Height="30"
                                    Classes.mode-active="{Binding SelectedSidebarTab, Converter={StaticResource EqualityConverter}, ConverterParameter=Thumbnails}"
                                    Command="{Binding SelectSidebarTabCommand}"
                                    CommandParameter="Thumbnails"
                                    ToolTip.Tip="Page Thumbnails">
                                <materialIcons:MaterialIcon Kind="ViewGridOutline" Width="15" Height="15" Foreground="{DynamicResource WinMutedBrush}" />
                            </Button>

                            <!-- Bookmarks / Outline Tab -->
                            <Button Classes="toolbar-btn"
                                    Height="30"
                                    Classes.mode-active="{Binding SelectedSidebarTab, Converter={StaticResource EqualityConverter}, ConverterParameter=Bookmarks}"
                                    Command="{Binding SelectSidebarTabCommand}"
                                    CommandParameter="Bookmarks"
                                    ToolTip.Tip="Document Outline &amp; Bookmarks">
                                <materialIcons:MaterialIcon Kind="BookmarkOutline" Width="15" Height="15" Foreground="{DynamicResource WinMutedBrush}" />
                            </Button>

                            <!-- Annotations Tab -->
                            <Button Classes="toolbar-btn"
                                    Height="30"
                                    Classes.mode-active="{Binding SelectedSidebarTab, Converter={StaticResource EqualityConverter}, ConverterParameter=Annotations}"
                                    Command="{Binding SelectSidebarTabCommand}"
                                    CommandParameter="Annotations"
                                    ToolTip.Tip="Review Annotations &amp; Comments">
                                <materialIcons:MaterialIcon Kind="CommentTextOutline" Width="15" Height="15" Foreground="{DynamicResource WinMutedBrush}" />
                            </Button>

                            <!-- Search Tab -->
                            <Button Classes="toolbar-btn"
                                    Height="30"
                                    Classes.mode-active="{Binding SelectedSidebarTab, Converter={StaticResource EqualityConverter}, ConverterParameter=Search}"
                                    Command="{Binding SelectSidebarTabCommand}"
                                    CommandParameter="Search"
                                    ToolTip.Tip="Search in PDF">
                                <materialIcons:MaterialIcon Kind="Magnify" Width="15" Height="15" Foreground="{DynamicResource WinMutedBrush}" />
                            </Button>

                            <!-- Metadata Info Tab -->
                            <Button Classes="toolbar-btn"
                                    Height="30"
                                    Classes.mode-active="{Binding SelectedSidebarTab, Converter={StaticResource EqualityConverter}, ConverterParameter=Info}"
                                    Command="{Binding SelectSidebarTabCommand}"
                                    CommandParameter="Info"
                                    ToolTip.Tip="Document Properties &amp; Metadata">
                                <materialIcons:MaterialIcon Kind="InformationOutline" Width="15" Height="15" Foreground="{DynamicResource WinMutedBrush}" />
                            </Button>
                        </UniformGrid>
                    </Border>

                    <!-- Tab 1: Thumbnails List (Apple Preview Floating Style) -->
                    <ScrollViewer x:Name="ThumbnailsScrollViewer"
                                  Grid.Row="1"
                                  IsVisible="{Binding SelectedSidebarTab, Converter={StaticResource EqualityConverter}, ConverterParameter=Thumbnails}"
                                  Padding="14,12">
                        <ItemsControl x:Name="ThumbnailsItemsControl" ItemsSource="{Binding Pages}">
                            <!-- Plain panel, not virtualized: ScrollThumbnailIntoView does pixel-based
                                 math against this ScrollViewer's Offset/Viewport, which a virtualizing
                                 panel can switch to logical (item-based) scrolling and break. -->
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:PdfViewerPageItem">
                                    <Button Classes="thumbnail-item-btn"
                                            Command="{Binding #RootPdfViewer.ViewModel.SelectPageCommand}"
                                            CommandParameter="{Binding}">
                                        <StackPanel Spacing="8" HorizontalAlignment="Center" IsHitTestVisible="False">
                                            <!-- Floating Page Thumbnail Paper Sheet -->
                                            <Border Classes="thumbnail-card"
                                                    Classes.selected="{Binding IsSelected}"
                                                    HorizontalAlignment="Center">
                                                <LayoutTransformControl HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <LayoutTransformControl.LayoutTransform>
                                                        <RotateTransform Angle="{Binding RotationAngle}" />
                                                    </LayoutTransformControl.LayoutTransform>
                                                    <Panel>
                                                        <!-- Placeholder when bitmap is still rasterizing -->
                                                        <Border Width="150" Height="200"
                                                                Background="{DynamicResource M3SurfaceContainerLowestBrush}"
                                                                IsVisible="{Binding ThumbnailBitmap, Converter={x:Static converters:EqualityToBooleanConverter.Instance}, ConverterParameter={x:Null}}">
                                                            <materialIcons:MaterialIcon Kind="FileDocumentOutline" Width="32" Height="32" Foreground="{DynamicResource WinSubtleBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Border>
                                                        <!-- Rendered High-Quality Page Bitmap -->
                                                        <Image Source="{Binding ThumbnailBitmap}"
                                                               MaxWidth="172"
                                                               MaxHeight="222"
                                                               Stretch="Uniform"
                                                               RenderOptions.BitmapInterpolationMode="HighQuality"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" />
                                                    </Panel>
                                                </LayoutTransformControl>
                                            </Border>

                                            <!-- Page Number Pill -->
                                            <Border Classes="page-number-pill"
                                                    Classes.selected="{Binding IsSelected}">
                                                <TextBlock Text="{Binding PageLabel}" />
                                            </Border>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Tab 2: Bookmarks / Outline Tree -->
                    <ScrollViewer Grid.Row="1"
                                  IsVisible="{Binding SelectedSidebarTab, Converter={StaticResource EqualityConverter}, ConverterParameter=Bookmarks}"
                                  Padding="12">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Document Outline" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource WinTextBrush}" />

                            <TextBlock Text="No outline bookmarks in this PDF document."
                                       FontSize="11" Foreground="{DynamicResource WinMutedBrush}"
                                       IsVisible="{Binding !HasBookmarks}"
                                       Margin="0,10" />

                            <TreeView ItemsSource="{Binding Bookmarks}"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      Padding="0">
                                <TreeView.ItemTemplate>
                                    <TreeDataTemplate DataType="vm:PdfViewerBookmarkItem" ItemsSource="{Binding Children}">
                                        <Button Background="Transparent"
                                                BorderThickness="0"
                                                Padding="4,3"
                                                Margin="0,1"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Stretch"
                                                Cursor="Hand"
                                                Command="{Binding #RootPdfViewer.ViewModel.JumpToBookmarkCommand}"
                                                CommandParameter="{Binding}">
                                            <Grid ColumnDefinitions="Auto,*,Auto" IsHitTestVisible="False">
                                                <materialIcons:MaterialIcon Grid.Column="0" Kind="BookmarkOutline" Width="13" Height="13" Foreground="#0F6CBD" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="11" Foreground="{DynamicResource WinTextBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                <Border Grid.Column="2" Background="{DynamicResource WinHoverBrush}" CornerRadius="4" Padding="5,1" Margin="4,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding PageNumber, StringFormat='{}p.{0}'}" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource WinMutedBrush}" />
                                                </Border>
                                            </Grid>
                                        </Button>
                                    </TreeDataTemplate>
                                </TreeView.ItemTemplate>
                            </TreeView>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Tab 3: Annotations & Review Comments List -->
                    <ScrollViewer Grid.Row="1"
                                  IsVisible="{Binding SelectedSidebarTab, Converter={StaticResource EqualityConverter}, ConverterParameter=Annotations}"
                                  Padding="12">
                        <StackPanel Spacing="10">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="Reader Annotations" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource WinTextBrush}" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Classes="toolbar-btn" Command="{Binding OpenAddNoteDialogCommand}" ToolTip.Tip="Add Sticky Note">
                                    <materialIcons:MaterialIcon Kind="Plus" Width="15" Height="15" Foreground="#0F6CBD" />
                                </Button>
                            </Grid>

                            <TextBlock Text="No annotations yet. Use the markup tools above to highlight, stamp, or add notes."
                                       FontSize="11" Foreground="{DynamicResource WinMutedBrush}" TextWrapping="Wrap"
                                       IsVisible="{Binding !HasAnnotations}"
                                       Margin="0,10" />

                            <ItemsControl ItemsSource="{Binding Annotations}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:PdfViewerAnnotationItem">
                                        <Border Background="{DynamicResource WinInputBgBrush}"
                                                BorderBrush="{DynamicResource WinBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Padding="10"
                                                Margin="0,0,0,8">
                                            <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto">
                                                <Button Grid.Column="0" Grid.Row="0" Grid.ColumnSpan="2"
                                                        Background="Transparent" BorderThickness="0" Padding="0"
                                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Cursor="Hand"
                                                        Command="{Binding #RootPdfViewer.ViewModel.JumpToAnnotationCommand}"
                                                        CommandParameter="{Binding}">
                                                    <Grid ColumnDefinitions="Auto,*">
                                                        <materialIcons:MaterialIcon Grid.Column="0" Kind="{Binding IconKind, Converter={StaticResource SafeMaterialIconKindConverter}}" Width="15" Height="15" Foreground="#0F6CBD" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                        <StackPanel Grid.Column="1" Spacing="1">
                                                            <TextBlock Text="{Binding Type}" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource WinTextBrush}" />
                                                            <TextBlock Text="{Binding TimeFormatted}" FontSize="9.5" Foreground="{DynamicResource WinMutedBrush}" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Button>

                                                <Button Grid.Column="2" Grid.Row="0" Classes="toolbar-btn" Width="20" Height="20"
                                                        Command="{Binding #RootPdfViewer.ViewModel.DeleteAnnotationCommand}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip.Tip="Delete Annotation">
                                                    <materialIcons:MaterialIcon Kind="Close" Width="12" Height="12" Foreground="{DynamicResource WinMutedBrush}" />
                                                </Button>

                                                <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                                                           Text="{Binding Content}" FontSize="11" Foreground="{DynamicResource WinTextBrush}" TextWrapping="Wrap" Margin="0,6,0,0" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Tab 4: Search in Document -->
                    <ScrollViewer Grid.Row="1"
                                  IsVisible="{Binding SelectedSidebarTab, Converter={StaticResource EqualityConverter}, ConverterParameter=Search}"
                                  Padding="12">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Find in PDF" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource WinTextBrush}" />

                            <!-- Search Input -->
                            <TextBox Text="{Binding SearchQuery, Mode=TwoWay}"
                                     PlaceholderText="Type search text..."
                                     FontSize="11.5"
                                     Padding="7,5" />

                            <!-- Options -->
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <CheckBox IsChecked="{Binding SearchMatchCase}" Content="Match Case" FontSize="10.5" />
                                <CheckBox IsChecked="{Binding SearchWholeWord}" Content="Whole Words" FontSize="10.5" />
                            </StackPanel>

                            <TextBlock Text="{Binding SearchStatusText}" FontSize="10.5" Foreground="{DynamicResource WinMutedBrush}" />

                            <ItemsControl ItemsSource="{Binding SearchResults}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:PdfViewerSearchMatch">
                                        <Button Classes="toolbar-btn"
                                                HorizontalAlignment="Stretch"
                                                Height="NaN"
                                                Padding="8"
                                                Margin="0,0,0,6"
                                                Command="{Binding #RootPdfViewer.ViewModel.JumpToMatchCommand}"
                                                CommandParameter="{Binding}">
                                            <StackPanel Spacing="3" HorizontalAlignment="Left" IsHitTestVisible="False">
                                                <Border Background="#EFF6FF" CornerRadius="4" Padding="5,1" HorizontalAlignment="Left">
                                                    <TextBlock Text="{Binding PageNumber, StringFormat='{}Page {0}'}" FontSize="10" FontWeight="Bold" Foreground="#0F6CBD" />
                                                </Border>
                                                <TextBlock Text="{Binding Snippet}" FontSize="11" Foreground="{DynamicResource WinTextBrush}" TextWrapping="Wrap" TextAlignment="Left" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Tab 5: Metadata Properties Info -->
                    <ScrollViewer Grid.Row="1"
                                  IsVisible="{Binding SelectedSidebarTab, Converter={StaticResource EqualityConverter}, ConverterParameter=Info}"
                                  Padding="12">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Document Properties" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource WinTextBrush}" />

                            <ItemsControl ItemsSource="{Binding MetadataItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:PdfViewerMetadataItem">
                                        <Border Background="{DynamicResource WinInputBgBrush}" BorderBrush="{DynamicResource WinBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,0,0,6">
                                            <Grid ColumnDefinitions="Auto,*">
                                                <materialIcons:MaterialIcon Grid.Column="0" Kind="{Binding IconKind, Converter={StaticResource SafeMaterialIconKindConverter}}" Width="14" Height="14" Foreground="{DynamicResource WinMutedBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                <StackPanel Grid.Column="1" Spacing="1">
                                                    <TextBlock Text="{Binding Label}" FontSize="9.5" FontWeight="Medium" Foreground="{DynamicResource WinMutedBrush}" />
                                                    <TextBlock Text="{Binding Value}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource WinTextBrush}" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>

                </Grid>
            </Border>

            <!-- CENTER DOCUMENT VIEWPORT CANVAS (Acrobat/Preview Paper Rendering) -->
            <Grid Grid.Column="1" Background="{Binding ThemeBackgroundHex}">

                <!-- SCANNED DOCUMENT OCR NOTIFICATION BANNER -->
                <Border Background="{DynamicResource WinCardHoverBrush}"
                        BorderBrush="#BFDBFE"
                        BorderThickness="0,0,0,1"
                        Padding="16,8"
                        VerticalAlignment="Top"
                        ZIndex="300"
                        IsVisible="{Binding ShowScannedDocumentBanner}">
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <materialIcons:MaterialIcon Kind="ScanHelper" Width="18" Height="18" Foreground="#0F6CBD" VerticalAlignment="Center" />
                            <TextBlock Text="Scanned Document Detected" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource WinTextBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="— This page has no selectable text layer. Run OCR to enable text selection, search, and copying."
                                       FontSize="11.5" Foreground="{DynamicResource WinMutedBrush}" VerticalAlignment="Center" />
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="12,0">
                            <!-- Recognize Current Page -->
                            <Button Background="#0F6CBD" Foreground="White" CornerRadius="6" Padding="10,4" FontSize="11" FontWeight="SemiBold"
                                    Command="{Binding RecognizeActivePageOcrCommand}" Cursor="Hand"
                                    ToolTip.Tip="Run OCR on current page">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <materialIcons:MaterialIcon Kind="LightningBolt" Width="13" Height="13" Foreground="White" />
                                    <TextBlock Text="Recognize Page (OCR)" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <!-- Recognize All Pages -->
                            <Button Classes="toolbar-btn" BorderThickness="1" BorderBrush="{DynamicResource WinBorderBrush}"
                                    CornerRadius="6" Padding="10,4" FontSize="11" FontWeight="Medium"
                                    Command="{Binding RecognizeDocumentOcrCommand}"
                                    ToolTip.Tip="Run OCR on all pages in document">
                                <TextBlock Text="Recognize All Pages" VerticalAlignment="Center" />
                            </Button>
                        </StackPanel>

                        <!-- Dismiss Button -->
                        <Button Grid.Column="3" Classes="toolbar-btn" Width="24" Height="24"
                                Command="{Binding DismissScannedBannerCommand}"
                                ToolTip.Tip="Dismiss Notification">
                            <materialIcons:MaterialIcon Kind="Close" Width="14" Height="14" Foreground="{DynamicResource WinMutedBrush}" />
                        </Button>
                    </Grid>
                </Border>

                <!-- OCR RUNNING PROGRESS OVERLAY -->
                <Border Background="{DynamicResource WinPanelBrush}"
                        BorderBrush="{DynamicResource WinBorderBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="16,6"
                        VerticalAlignment="Top"
                        ZIndex="301"
                        IsVisible="{Binding IsOcrRunning}">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <ProgressBar Value="{Binding OcrProgress}" Minimum="0" Maximum="100" Width="120" Height="6" CornerRadius="3" Foreground="#0F6CBD" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding OcrStatusText}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource WinTextBrush}" VerticalAlignment="Center" />
                        </StackPanel>

                        <Button Grid.Column="2" Classes="toolbar-btn" Height="24" Padding="8,0"
                                Command="{Binding CancelOcrCommand}"
                                ToolTip.Tip="Cancel OCR">
                            <TextBlock Text="Cancel" FontSize="11" Foreground="#DC2626" VerticalAlignment="Center" />
                        </Button>
                    </Grid>
                </Border>

                <!-- Top Indeterminate Progress Bar for instant feedback while opening -->
                <ProgressBar IsIndeterminate="True"
                             IsVisible="{Binding IsLoading}"
                             Height="2.5"
                             VerticalAlignment="Top"
                             ZIndex="999"
                             Background="Transparent"
                             Foreground="#0F6CBD" />

                <!-- Layout 2: Single Page Fit Mode -->
                <ScrollViewer x:Name="SinglePageScrollViewer"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"
                              Padding="32"
                              IsVisible="{Binding IsSinglePageMode}">
                    <ScrollViewer.GestureRecognizers>
                        <PinchGestureRecognizer />
                    </ScrollViewer.GestureRecognizers>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10"
                                IsVisible="{Binding SelectedPage, Converter={StaticResource NullToBooleanConverter}}">
                        <LayoutTransformControl HorizontalAlignment="Center" VerticalAlignment="Center">
                            <LayoutTransformControl.LayoutTransform>
                                <RotateTransform Angle="{Binding SelectedPage.RotationAngle}" />
                            </LayoutTransformControl.LayoutTransform>
                            <Border Classes="reader-page-card"
                                    Classes.reading-theme-sepia="{Binding IsThemeSepia}"
                                    Classes.reading-theme-dark="{Binding IsThemeDark}"
                                    Classes.reading-theme-highcontrast="{Binding IsThemeHighContrast}">
                                <Border.Width>
                                    <MultiBinding Converter="{StaticResource MultiplyConverter}">
                                        <Binding Path="SelectedPage.WidthPoints" />
                                        <Binding Path="ZoomLevel" />
                                    </MultiBinding>
                                </Border.Width>
                                <Border.Height>
                                    <MultiBinding Converter="{StaticResource MultiplyConverter}">
                                        <Binding Path="SelectedPage.HeightPoints" />
                                        <Binding Path="ZoomLevel" />
                                    </MultiBinding>
                                </Border.Height>

                                <Panel>
                                    <Image Source="{Binding SelectedPage.Bitmap}"
                                           Stretch="UniformToFill"
                                           RenderOptions.BitmapInterpolationMode="HighQuality" />

                                    <!-- Interactive Vector Text Selection & Highlight Layer -->
                                    <controls:PdfTextOverlayControl
                                        Page="{Binding SelectedPage}"
                                        ZoomLevel="{Binding ZoomLevel}"
                                        ViewerViewModel="{Binding}" />

                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8"
                                                IsVisible="{Binding SelectedPage.Bitmap, Converter={StaticResource NullToBooleanConverter}, ConverterParameter=invert}">
                                        <materialIcons:MaterialIcon Kind="FileDocumentOutline" Width="36" Height="36" Foreground="{DynamicResource WinSubtleBrush}" />
                                        <TextBlock Text="{Binding SelectedPage.PageLabel}" FontSize="12" Foreground="{DynamicResource WinMutedBrush}" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Panel>
                            </Border>
                        </LayoutTransformControl>

                        <TextBlock Text="{Binding SelectedPage.PageLabel}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{Binding ThemeTextColorHex}"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </ScrollViewer>

                <!-- Layout 3: Two-Page Spread (Facing Pages / Book Mode) -->
                <ScrollViewer x:Name="TwoPageSpreadScrollViewer"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"
                              Padding="32"
                              IsVisible="{Binding IsTwoPageSpreadMode}">
                    <ScrollViewer.GestureRecognizers>
                        <PinchGestureRecognizer />
                    </ScrollViewer.GestureRecognizers>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12"
                                IsVisible="{Binding SelectedSpread, Converter={StaticResource NullToBooleanConverter}}">
                        <StackPanel Orientation="Horizontal" Spacing="16" HorizontalAlignment="Center">
                            <!-- Left Page -->
                            <Panel IsVisible="{Binding SelectedSpread.LeftPage, Converter={StaticResource NullToBooleanConverter}}">
                                <StackPanel Spacing="6" HorizontalAlignment="Center">
                                    <LayoutTransformControl HorizontalAlignment="Center">
                                        <LayoutTransformControl.LayoutTransform>
                                            <RotateTransform Angle="{Binding SelectedSpread.LeftPage.RotationAngle}" />
                                        </LayoutTransformControl.LayoutTransform>
                                        <Border Classes="reader-page-card"
                                                Classes.reading-theme-sepia="{Binding IsThemeSepia}"
                                                Classes.reading-theme-dark="{Binding IsThemeDark}"
                                                Classes.reading-theme-highcontrast="{Binding IsThemeHighContrast}">
                                            <Border.Width>
                                                <MultiBinding Converter="{StaticResource MultiplyConverter}">
                                                    <Binding Path="SelectedSpread.LeftPage.WidthPoints" />
                                                    <Binding Path="ZoomLevel" />
                                                </MultiBinding>
                                            </Border.Width>
                                            <Border.Height>
                                                <MultiBinding Converter="{StaticResource MultiplyConverter}">
                                                    <Binding Path="SelectedSpread.LeftPage.HeightPoints" />
                                                    <Binding Path="ZoomLevel" />
                                                </MultiBinding>
                                            </Border.Height>
                                            <Panel>
                                                <Image Source="{Binding SelectedSpread.LeftPage.Bitmap}"
                                                       Stretch="UniformToFill"
                                                       RenderOptions.BitmapInterpolationMode="HighQuality" />
                                                <controls:PdfTextOverlayControl
                                                    Page="{Binding SelectedSpread.LeftPage}"
                                                    ZoomLevel="{Binding ZoomLevel}"
                                                    ViewerViewModel="{Binding}" />

                                                <!-- Fallback when loading / empty -->
                                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8"
                                                            IsVisible="{Binding SelectedSpread.LeftPage.Bitmap, Converter={StaticResource NullToBooleanConverter}, ConverterParameter=invert}">
                                                    <materialIcons:MaterialIcon Kind="FileDocumentOutline" Width="36" Height="36" Foreground="{DynamicResource WinSubtleBrush}" />
                                                    <TextBlock Text="{Binding SelectedSpread.LeftPage.PageLabel}" FontSize="12" Foreground="{DynamicResource WinMutedBrush}" HorizontalAlignment="Center" />
                                                </StackPanel>
                                            </Panel>
                                        </Border>
                                    </LayoutTransformControl>
                                    <TextBlock Text="{Binding SelectedSpread.LeftPage.PageLabel}" FontSize="10.5" FontWeight="Medium" Foreground="{Binding ThemeTextColorHex}" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Panel>

                            <!-- Right Page -->
                            <Panel IsVisible="{Binding SelectedSpread.RightPage, Converter={StaticResource NullToBooleanConverter}}">
                                <StackPanel Spacing="6" HorizontalAlignment="Center">
                                    <LayoutTransformControl HorizontalAlignment="Center">
                                        <LayoutTransformControl.LayoutTransform>
                                            <RotateTransform Angle="{Binding SelectedSpread.RightPage.RotationAngle}" />
                                        </LayoutTransformControl.LayoutTransform>
                                        <Border Classes="reader-page-card"
                                                Classes.reading-theme-sepia="{Binding IsThemeSepia}"
                                                Classes.reading-theme-dark="{Binding IsThemeDark}"
                                                Classes.reading-theme-highcontrast="{Binding IsThemeHighContrast}">
                                            <Border.Width>
                                                <MultiBinding Converter="{StaticResource MultiplyConverter}">
                                                    <Binding Path="SelectedSpread.RightPage.WidthPoints" />
                                                    <Binding Path="ZoomLevel" />
                                                </MultiBinding>
                                            </Border.Width>
                                            <Border.Height>
                                                <MultiBinding Converter="{StaticResource MultiplyConverter}">
                                                    <Binding Path="SelectedSpread.RightPage.HeightPoints" />
                                                    <Binding Path="ZoomLevel" />
                                                </MultiBinding>
                                            </Border.Height>
                                            <Panel>
                                                <Image Source="{Binding SelectedSpread.RightPage.Bitmap}"
                                                       Stretch="UniformToFill"
                                                       RenderOptions.BitmapInterpolationMode="HighQuality" />
                                                <controls:PdfTextOverlayControl
                                                    Page="{Binding SelectedSpread.RightPage}"
                                                    ZoomLevel="{Binding ZoomLevel}"
                                                    ViewerViewModel="{Binding}" />

                                                <!-- Fallback when loading / empty -->
                                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8"
                                                            IsVisible="{Binding SelectedSpread.RightPage.Bitmap, Converter={StaticResource NullToBooleanConverter}, ConverterParameter=invert}">
                                                    <materialIcons:MaterialIcon Kind="FileDocumentOutline" Width="36" Height="36" Foreground="{DynamicResource WinSubtleBrush}" />
                                                    <TextBlock Text="{Binding SelectedSpread.RightPage.PageLabel}" FontSize="12" Foreground="{DynamicResource WinMutedBrush}" HorizontalAlignment="Center" />
                                                </StackPanel>
                                            </Panel>
                                        </Border>
                                    </LayoutTransformControl>
                                    <TextBlock Text="{Binding SelectedSpread.RightPage.PageLabel}" FontSize="10.5" FontWeight="Medium" Foreground="{Binding ThemeTextColorHex}" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Panel>
                        </StackPanel>

                        <TextBlock Text="{Binding SelectedSpread.SpreadLabel}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{Binding ThemeTextColorHex}"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </ScrollViewer>

                <!-- FLOATING QUICK-ACTION BAR WHEN TEXT IS SELECTED -->
                <Border Background="{DynamicResource WinPanelBrush}"
                        BorderBrush="{DynamicResource WinBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="24"
                        BoxShadow="0 8 28 #35000000"
                        Padding="10,6"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Bottom"
                        Margin="0,0,0,24"
                        ZIndex="400"
                        IsVisible="{Binding HasTextSelection}">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <!-- Selection Icon & Snippet Preview -->
                        <materialIcons:MaterialIcon Kind="FormatColorText" Width="16" Height="16" Foreground="#0F6CBD" VerticalAlignment="Center" Margin="2,0,0,0" />
                        <TextBlock Text="{Binding SelectedTextSnippet}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource WinTextBrush}"
                                   VerticalAlignment="Center"
                                   MaxWidth="180"
                                   TextTrimming="CharacterEllipsis" />

                        <!-- Auto-Detected Garbled Font Encoding: One-Click Fix Pill -->
                        <Button Classes="toolbar-btn"
                                Height="22"
                                Padding="6,0"
                                Margin="3,0"
                                Background="#FEF3C7"
                                BorderBrush="#F59E0B"
                                BorderThickness="1"
                                CornerRadius="4"
                                Command="{Binding RecognizeSelectedTextOcrCommand}"
                                IsVisible="{Binding IsSelectionTextGarbled}"
                                ToolTip.Tip="This text looks garbled/unmapped from a custom PDF font. Click to fix with OCR.">
                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <materialIcons:MaterialIcon Kind="AutoFix" Width="12" Height="12" Foreground="#D97706" />
                                <TextBlock Text="Fix with OCR" FontSize="10" FontWeight="SemiBold" Foreground="#B45309" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Rectangle Width="1" Height="16" Fill="{DynamicResource WinBorderBrush}" Margin="4,0" />

                        <!-- Copy Button -->
                        <Button Classes="toolbar-btn" Width="28" Height="28"
                                Command="{Binding CopySelectedTextCommand}"
                                ToolTip.Tip="Copy Text (⌘C / Ctrl+C)">
                            <materialIcons:MaterialIcon Kind="ContentCopy" Width="15" Height="15" Foreground="{DynamicResource WinTextBrush}" />
                        </Button>

                        <!-- Copy with Citation Button -->
                        <Button Classes="toolbar-btn" Width="28" Height="28"
                                Command="{Binding CopySelectedCitationCommand}"
                                ToolTip.Tip="Copy Text with Page Reference Citation">
                            <materialIcons:MaterialIcon Kind="FormatQuoteClose" Width="15" Height="15" Foreground="{DynamicResource WinMutedBrush}" />
                        </Button>

                        <!-- Copy Area Snapshot / Image Button -->
                        <Button Classes="toolbar-btn" Width="28" Height="28"
                                Command="{Binding CopySelectedAreaImageCommand}"
                                ToolTip.Tip="Copy Area Snapshot (PNG image to clipboard)">
                            <materialIcons:MaterialIcon Kind="CameraOutline" Width="15" Height="15" Foreground="#0284C7" />
                        </Button>

                        <!-- Recognize Selection with OCR Button -->
                        <Button Classes="toolbar-btn" Width="28" Height="28"
                                Command="{Binding RecognizeSelectedTextOcrCommand}"
                                ToolTip.Tip="Recognize Selection with OCR (Extract text from scanned regions, images &amp; fix unmapped fonts)">
                            <materialIcons:MaterialIcon Kind="ScanHelper" Width="15" Height="15" Foreground="#0F6CBD" />
                        </Button>

                        <!-- Highlight Selection Button (Yellow) -->
                        <Button Classes="toolbar-btn" Width="28" Height="28"
                                Command="{Binding HighlightSelectedTextCommand}"
                                CommandParameter="#FEF08A"
                                ToolTip.Tip="Highlight Selection">
                            <materialIcons:MaterialIcon Kind="FormatColorHighlight" Width="15" Height="15" Foreground="#CA8A04" />
                        </Button>

                        <!-- Add Note on Selection Button -->
                        <Button Classes="toolbar-btn" Width="28" Height="28"
                                Command="{Binding AddNoteFromSelectionCommand}"
                                ToolTip.Tip="Add Sticky Note on Selection">
                            <materialIcons:MaterialIcon Kind="CommentTextOutline" Width="15" Height="15" Foreground="#0284C7" />
                        </Button>

                        <!-- Search Selection in PDF Button -->
                        <Button Classes="toolbar-btn" Width="28" Height="28"
                                Command="{Binding SearchSelectedTextCommand}"
                                ToolTip.Tip="Find this text in PDF (⌘F)">
                            <materialIcons:MaterialIcon Kind="Magnify" Width="15" Height="15" Foreground="{DynamicResource WinMutedBrush}" />
                        </Button>

                        <!-- Google Web Search Button -->
                        <Button Classes="toolbar-btn" Width="28" Height="28"
                                Command="{Binding SearchWebSelectedTextCommand}"
                                ToolTip.Tip="Search with Google">
                            <materialIcons:MaterialIcon Kind="Web" Width="15" Height="15" Foreground="#2563EB" />
                        </Button>

                        <Rectangle Width="1" Height="16" Fill="{DynamicResource WinBorderBrush}" Margin="2,0" />

                        <!-- Clear / Deselect Button -->
                        <Button Classes="toolbar-btn" Width="24" Height="24"
                                Command="{Binding ClearSelectionCommand}"
                                ToolTip.Tip="Clear Selection (Esc)">
                            <materialIcons:MaterialIcon Kind="Close" Width="13" Height="13" Foreground="{DynamicResource WinMutedBrush}" />
                        </Button>
                    </StackPanel>
                </Border>

                <!-- FLOATING IN-VIEWER SEARCH BAR OVERLAY -->
                <Border Background="{DynamicResource WinPanelBrush}"
                        BorderBrush="{DynamicResource WinBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        BoxShadow="0 6 20 #25000000"
                        Padding="8,6"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="0,14,20,0"
                        IsVisible="{Binding IsSearchBarVisible}">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <materialIcons:MaterialIcon Kind="Magnify" Width="15" Height="15" Foreground="{DynamicResource WinMutedBrush}" VerticalAlignment="Center" />

                        <TextBox x:Name="SearchQueryTextBox"
                                 Text="{Binding SearchQuery, Mode=TwoWay}"
                                 PlaceholderText="Find in PDF..."
                                 Width="180"
                                 Height="26"
                                 FontSize="11.5"
                                 Padding="6,2"
                                 CornerRadius="4"
                                 VerticalAlignment="Center">
                            <TextBox.KeyBindings>
                                <KeyBinding Gesture="Enter" Command="{Binding NextMatchCommand}" />
                            </TextBox.KeyBindings>
                        </TextBox>

                        <TextBlock Text="{Binding SearchStatusText}"
                                   FontSize="10"
                                   Foreground="{DynamicResource WinMutedBrush}"
                                   VerticalAlignment="Center"
                                   Margin="2,0" />

                        <Button Classes="toolbar-btn" Width="24" Height="24" Command="{Binding PreviousMatchCommand}" ToolTip.Tip="Previous Match (Shift+F3)">
                            <materialIcons:MaterialIcon Kind="ChevronUp" Width="15" Height="15" Foreground="{DynamicResource WinMutedBrush}" />
                        </Button>
                        <Button Classes="toolbar-btn" Width="24" Height="24" Command="{Binding NextMatchCommand}" ToolTip.Tip="Next Match (F3 / Enter)">
                            <materialIcons:MaterialIcon Kind="ChevronDown" Width="15" Height="15" Foreground="{DynamicResource WinMutedBrush}" />
                        </Button>
                        <Button Classes="toolbar-btn" Width="24" Height="24" Command="{Binding ToggleSearchBarCommand}" ToolTip.Tip="Close Search">
                            <materialIcons:MaterialIcon Kind="Close" Width="13" Height="13" Foreground="{DynamicResource WinMutedBrush}" />
                        </Button>
                    </StackPanel>
                </Border>

                <!-- ADD STICKY NOTE MODAL DIALOG -->
                <Border Background="#80000000"
                        IsVisible="{Binding IsAddNoteOpen}"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch">
                    <Border Width="360"
                            Background="{DynamicResource WinPanelBrush}"
                            CornerRadius="10"
                            BoxShadow="0 8 24 #30000000"
                            Padding="18"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                        <StackPanel Spacing="12">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                    <materialIcons:MaterialIcon Kind="NoteTextOutline" Width="18" Height="18" Foreground="#0284C7" VerticalAlignment="Center" />
                                    <TextBlock Text="Add Sticky Note Annotation" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource WinTextBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                                <Button Grid.Column="1" Classes="toolbar-btn" Width="24" Height="24" Command="{Binding #RootPdfViewer.ViewModel.OpenAddNoteDialogCommand}">
                                    <materialIcons:MaterialIcon Kind="Close" Width="14" Height="14" />
                                </Button>
                            </Grid>

                            <TextBox Text="{Binding NewNoteText, Mode=TwoWay}"
                                     PlaceholderText="Type your annotation, review comment, or bookmark note here..."
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     Height="85"
                                     FontSize="11.5"
                                     CornerRadius="6" />

                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                <Button Content="Cancel" Padding="12,5" FontSize="11.5" Command="{Binding #RootPdfViewer.ViewModel.OpenAddNoteDialogCommand}" />
                                <Button Content="Add Note" Background="#0F6CBD" Foreground="White" Padding="14,5" FontSize="11.5" FontWeight="SemiBold" Command="{Binding ConfirmAddNoteCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Border>

                <!-- Presentation Fullscreen Floating Exit Button -->
                <Button Classes="toolbar-btn"
                        IsVisible="{Binding IsFullscreen}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="0,14,14,0"
                        Command="{Binding ToggleFullscreenCommand}"
                        Background="#B0000000"
                        CornerRadius="16"
                        Padding="10,5"
                        Width="NaN" Height="NaN"
                        ToolTip.Tip="Exit Fullscreen (Esc)">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <materialIcons:MaterialIcon Kind="FullscreenExit" Width="15" Height="15" Foreground="White" />
                        <TextBlock Text="Exit Fullscreen" FontSize="11" Foreground="White" />
                    </StackPanel>
                </Button>

            </Grid>

        </Grid>

        <!-- ========================================== -->
        <!-- 3. BOTTOM STATUS & SHORTCUTS FOOTER BAR    -->
        <!-- ========================================== -->
        <Border Grid.Row="2"
                Background="{DynamicResource WinPanelBrush}"
                Height="28"
                BorderBrush="{DynamicResource WinBorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="12,0"
                IsVisible="{Binding !IsFullscreen}">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Ellipse Width="7" Height="7" Fill="#10B981" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding StatusMessage}" FontSize="10.5" Foreground="{DynamicResource WinMutedBrush}" FontWeight="Medium" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <TextBlock Text="{Binding PageNavigationDisplay}" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource WinTextBrush}" VerticalAlignment="Center" />
                    <Rectangle Width="1" Height="12" Fill="{DynamicResource WinBorderBrush}" />
                    <TextBlock Text="{Binding ZoomPercentageText}" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource WinTextBrush}" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

    </Grid>

</UserControl>
