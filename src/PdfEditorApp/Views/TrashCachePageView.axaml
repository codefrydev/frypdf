<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PdfEditorApp.ViewModels"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="PdfEditorApp.Views.TrashCachePageView"
             x:DataType="vm:HomeViewModel">

    <StackPanel Margin="32,24,32,32" Spacing="20">

        <!-- Header -->
        <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
            <StackPanel Grid.Column="0" Spacing="2">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <materialIcons:MaterialIcon Kind="TrashCanOutline" Width="20" Height="20" Foreground="#EF4444" VerticalAlignment="Center" />
                    <TextBlock Text="Trash &amp; Storage Cache" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource WinTextBrush}" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="Manage temporary PDF renders, scratch files, and recent project history" FontSize="12" Foreground="{DynamicResource WinMutedBrush}" />
            </StackPanel>
        </Grid>

        <!-- Cache Cleanup Card -->
        <Border Background="{DynamicResource WinPanelBrush}" BorderBrush="{DynamicResource WinBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="28" HorizontalAlignment="Stretch">
            <StackPanel Spacing="18">
                <StackPanel Orientation="Horizontal" Spacing="14">
                    <Border Width="48" Height="48" Background="#FEF2F2" CornerRadius="12">
                        <materialIcons:MaterialIcon Kind="Broom" Width="26" Height="26" Foreground="#DC2626" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="Clear Temporary Cache &amp; Recent Lists" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource WinTextBrush}" />
                        <TextBlock Text="Removes temporary scratch files generated during OCR, split/merge, and image exports to reclaim disk space." FontSize="12" Foreground="{DynamicResource WinMutedBrush}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="10" Margin="62,0,0,0">
                    <Button Command="{Binding ClearRecentCommand}"
                            Background="#DC2626"
                            Foreground="White"
                            CornerRadius="8"
                            Padding="16,8"
                            FontSize="12.5"
                            FontWeight="SemiBold"
                            Cursor="Hand">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <materialIcons:MaterialIcon Kind="TrashCanOutline" Width="15" Height="15" />
                            <TextBlock Text="Clear Recent Projects History" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>

    </StackPanel>
</UserControl>
