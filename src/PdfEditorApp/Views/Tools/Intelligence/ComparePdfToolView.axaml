<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PdfEditorApp.ViewModels.Tools.Intelligence"
             xmlns:shell="using:PdfEditorApp.Views.Shell"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="PdfEditorApp.Views.Tools.Intelligence.ComparePdfToolView"
             x:DataType="vm:ComparePdfToolViewModel">

    <shell:PdfToolWorkspaceView>

        <!-- Toolbar primary action -->
        <shell:PdfToolWorkspaceView.ToolbarActionContent>
            <Button Command="{Binding ExecuteToolCommand}" IsEnabled="{Binding !IsRunning}" Background="#2563EB" Foreground="White" CornerRadius="8" Padding="16,8" FontWeight="Bold" FontSize="12.5" Cursor="Hand">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <materialIcons:MaterialIcon Kind="Compare" Width="15" Height="15" />
                    <TextBlock Text="Run Diff" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </shell:PdfToolWorkspaceView.ToolbarActionContent>

        <!-- Sidebar Options tab: status, the two labeled document pickers (A/B — not a
             generic file list, so this stays here rather than the Files tab), and diff
             settings. The live preview canvas shows Document A (whichever file is at
             SelectedFiles[0]), since Preview always tracks the primary input file. -->
        <shell:PdfToolWorkspaceView.OptionsContent>
            <StackPanel Spacing="16">

                <!-- Error Alert Banner -->
                <Border Background="#FEF2F2" BorderBrush="#FCA5A5" BorderThickness="1" CornerRadius="10" Padding="14,10" IsVisible="{Binding HasError}">
                    <Grid ColumnDefinitions="Auto,*">
                        <materialIcons:MaterialIcon Grid.Column="0" Kind="AlertCircleOutline" Width="20" Height="20" Foreground="#DC2626" Margin="0,0,10,0" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="Comparison Failed" FontSize="12.5" FontWeight="Bold" Foreground="#991B1B" />
                            <TextBlock Text="{Binding ErrorMessage}" FontSize="11.5" Foreground="#B91C1C" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Success Banner -->
                <Border Background="#F0FDF4" BorderBrush="#86EFAC" BorderThickness="1" CornerRadius="12" Padding="16,14" BoxShadow="0 4 12 #1016A34A" IsVisible="{Binding IsComplete}">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <Border Width="36" Height="36" Background="#DCFCE7" CornerRadius="9">
                                <materialIcons:MaterialIcon Kind="CheckCircle" Width="20" Height="20" Foreground="#16A34A" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="Documents Compared!" FontSize="13.5" FontWeight="Bold" Foreground="#166534" />
                                <TextBlock Text="{Binding ResultSummaryMessage}" FontSize="11.5" Foreground="#15803D" TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>

                        <WrapPanel Orientation="Horizontal">
                            <Button Command="{Binding OpenOutputFileCommand}" Background="#16A34A" Foreground="White" CornerRadius="8" Padding="12,7" FontSize="11.5" FontWeight="SemiBold" Cursor="Hand" Margin="0,0,6,6">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <materialIcons:MaterialIcon Kind="FileEyeOutline" Width="14" Height="14" />
                                    <TextBlock Text="Open Report" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding OpenOutputFolderCommand}" Background="#DCFCE7" Foreground="#166534" BorderBrush="#86EFAC" BorderThickness="1" CornerRadius="8" Padding="12,7" FontSize="11.5" FontWeight="SemiBold" Cursor="Hand" Margin="0,0,6,6">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <materialIcons:MaterialIcon Kind="FolderOpenOutline" Width="14" Height="14" />
                                    <TextBlock Text="Show in Folder" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- Processing Card -->
                <Border Background="{DynamicResource WinPanelBrush}" BorderBrush="{DynamicResource WinBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14" IsVisible="{Binding IsRunning}">
                    <StackPanel Spacing="10">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource WinTextBrush}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding ProgressPercentage, StringFormat='{}{0:F0}%'}" FontSize="13" FontWeight="Bold" Foreground="#2563EB" VerticalAlignment="Center" />
                        </Grid>
                        <ProgressBar Value="{Binding ProgressPercentage}" Minimum="0" Maximum="100" Height="7" CornerRadius="4" Foreground="#2563EB" Background="{DynamicResource WinHoverBrush}" />
                    </StackPanel>
                </Border>

                <!-- Document A -->
                <Border Background="{DynamicResource WinPanelBrush}" BorderBrush="{DynamicResource WinBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14" BoxShadow="0 2 6 #05000000">
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Border Width="30" Height="30" Background="#EFF6FF" CornerRadius="7">
                                <TextBlock Text="A" FontSize="14" FontWeight="Bold" Foreground="#2563EB" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel VerticalAlignment="Center" Spacing="1">
                                <TextBlock Text="Original Document A" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource WinTextBrush}" />
                                <TextBlock Text="Reference baseline version" FontSize="10.5" Foreground="{DynamicResource WinMutedBrush}" />
                            </StackPanel>
                        </StackPanel>

                        <Border Background="{DynamicResource WinInputBgBrush}" BorderBrush="{DynamicResource WinBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,14">
                            <StackPanel Spacing="8">
                                <TextBlock Text="{Binding DocumentAPath}" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource WinTextBrush}" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center" />
                                <Button Command="{Binding PickDocumentACommand}" Background="#2563EB" Foreground="White" CornerRadius="6" Padding="14,7" FontSize="11.5" FontWeight="SemiBold" HorizontalAlignment="Center" Cursor="Hand">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <materialIcons:MaterialIcon Kind="FolderOpenOutline" Width="13" Height="13" />
                                        <TextBlock Text="Select Document A" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Document B -->
                <Border Background="{DynamicResource WinPanelBrush}" BorderBrush="{DynamicResource WinBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14" BoxShadow="0 2 6 #05000000">
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Border Width="30" Height="30" Background="#FAF5FF" CornerRadius="7">
                                <TextBlock Text="B" FontSize="14" FontWeight="Bold" Foreground="#9333EA" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel VerticalAlignment="Center" Spacing="1">
                                <TextBlock Text="Modified Document B" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource WinTextBrush}" />
                                <TextBlock Text="New or revised version" FontSize="10.5" Foreground="{DynamicResource WinMutedBrush}" />
                            </StackPanel>
                        </StackPanel>

                        <Border Background="{DynamicResource WinInputBgBrush}" BorderBrush="{DynamicResource WinBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,14">
                            <StackPanel Spacing="8">
                                <TextBlock Text="{Binding DocumentBPath}" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource WinTextBrush}" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center" />
                                <Button Command="{Binding PickDocumentBCommand}" Background="#9333EA" Foreground="White" CornerRadius="6" Padding="14,7" FontSize="11.5" FontWeight="SemiBold" HorizontalAlignment="Center" Cursor="Hand">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <materialIcons:MaterialIcon Kind="FolderOpenOutline" Width="13" Height="13" />
                                        <TextBlock Text="Select Document B" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <TextBlock Text="The preview canvas shows Document A. Diff detection settings below control how the comparison report is generated." FontSize="10.5" Foreground="{DynamicResource WinSubtleBrush}" TextWrapping="Wrap" />

                <!-- Diff settings -->
                <StackPanel Spacing="3">
                    <TextBlock Text="Diff Analysis Options" FontSize="14" FontWeight="ExtraBold" Foreground="{DynamicResource WinTextBrush}" />
                </StackPanel>

                <StackPanel Spacing="10">
                    <CheckBox Content="Detect Semantic Text Additions &amp; Deletions" IsChecked="{Binding DetectTextDiff}" FontSize="12" />
                    <CheckBox Content="Perform Pixel-Level Visual Overlay Diff" IsChecked="{Binding DetectVisualDiff}" FontSize="12" />
                </StackPanel>

            </StackPanel>
        </shell:PdfToolWorkspaceView.OptionsContent>

    </shell:PdfToolWorkspaceView>
</UserControl>
