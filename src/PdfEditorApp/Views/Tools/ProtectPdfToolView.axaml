<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PdfEditorApp.ViewModels.Tools"
             xmlns:shell="using:PdfEditorApp.Views.Shell"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="PdfEditorApp.Views.Tools.ProtectPdfToolView"
             x:DataType="vm:ProtectPdfToolViewModel">

    <shell:PdfToolWorkspaceView>

        <!-- Toolbar primary action -->
        <shell:PdfToolWorkspaceView.ToolbarActionContent>
            <Button Command="{Binding ExecuteToolCommand}" IsEnabled="{Binding !IsRunning}" Background="#0284C7" Foreground="White" CornerRadius="8" Padding="16,8" FontWeight="Bold" FontSize="12.5" Cursor="Hand">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <materialIcons:MaterialIcon Kind="ShieldLockOutline" Width="15" Height="15" />
                    <TextBlock Text="Encrypt &amp; Protect" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </shell:PdfToolWorkspaceView.ToolbarActionContent>

        <!-- Sidebar Options tab: status banners, document selection, and password/permission settings.
             Full file list with add/remove/reorder lives in the shared Files tab (reuses
             AddFilesCommand/RemoveFileCommand/MoveFileUpCommand/MoveFileDownCommand already on the base class). -->
        <shell:PdfToolWorkspaceView.OptionsContent>
            <StackPanel Spacing="16">

                <!-- Error Alert Banner -->
                <Border Background="#FEF2F2" BorderBrush="#FCA5A5" BorderThickness="1" CornerRadius="10" Padding="14,10" IsVisible="{Binding HasError}">
                    <Grid ColumnDefinitions="Auto,*">
                        <materialIcons:MaterialIcon Grid.Column="0" Kind="AlertCircleOutline" Width="20" Height="20" Foreground="#DC2626" Margin="0,0,10,0" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="Protection Failed" FontSize="12.5" FontWeight="Bold" Foreground="#991B1B" />
                            <TextBlock Text="{Binding ErrorMessage}" FontSize="11.5" Foreground="#B91C1C" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Success Banner -->
                <Border Background="#F0FDF4" BorderBrush="#86EFAC" BorderThickness="1" CornerRadius="12" Padding="16,14" BoxShadow="0 4 12 #1016A34A" IsVisible="{Binding IsComplete}">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <Border Width="34" Height="34" Background="#DCFCE7" CornerRadius="9">
                                <materialIcons:MaterialIcon Kind="CheckCircle" Width="20" Height="20" Foreground="#16A34A" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="PDF Encrypted &amp; Protected!" FontSize="13.5" FontWeight="Bold" Foreground="#166534" />
                                <TextBlock Text="{Binding ResultSummaryMessage}" FontSize="11.5" Foreground="#15803D" TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>

                        <WrapPanel Orientation="Horizontal">
                            <Button Command="{Binding OpenOutputFileCommand}" Background="#16A34A" Foreground="White" CornerRadius="8" Padding="12,8" FontSize="12" FontWeight="SemiBold" Cursor="Hand" Margin="0,0,6,6">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <materialIcons:MaterialIcon Kind="LockCheckOutline" Width="14" Height="14" />
                                    <TextBlock Text="Open Protected PDF" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding OpenOutputFolderCommand}" Background="#DCFCE7" Foreground="#166534" BorderBrush="#86EFAC" BorderThickness="1" CornerRadius="8" Padding="12,8" FontSize="12" FontWeight="SemiBold" Cursor="Hand" Margin="0,0,6,6">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <materialIcons:MaterialIcon Kind="FolderOpenOutline" Width="14" Height="14" />
                                    <TextBlock Text="Show in Folder" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- Processing Card -->
                <Border Background="{DynamicResource WinPanelBrush}" BorderBrush="{DynamicResource WinBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14" IsVisible="{Binding IsRunning}">
                    <StackPanel Spacing="10">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource WinTextBrush}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding ProgressPercentage, StringFormat='{}{0:F0}%'}" FontSize="13" FontWeight="Bold" Foreground="#0284C7" VerticalAlignment="Center" />
                        </Grid>
                        <ProgressBar Value="{Binding ProgressPercentage}" Minimum="0" Maximum="100" Height="7" CornerRadius="4" Foreground="#0284C7" Background="{DynamicResource WinHoverBrush}" />
                    </StackPanel>
                </Border>

                <!-- Security Feature Highlights Card -->
                <Border Background="{DynamicResource WinPanelBrush}" BorderBrush="{DynamicResource WinBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="14" BoxShadow="0 2 6 #05000000">
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <materialIcons:MaterialIcon Kind="ShieldLockOutline" Width="18" Height="18" Foreground="#0284C7" />
                            <TextBlock Text="AES-256 Bit Encryption Engine" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource WinTextBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBlock Text="Your documents are encrypted entirely locally in offline sandbox memory with industry standard AES algorithms." FontSize="11" Foreground="{DynamicResource WinMutedBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- Dropzone -->
                <Border Background="{DynamicResource WinPanelBrush}" BorderBrush="{DynamicResource WinBorderBrush}" BorderThickness="2" CornerRadius="10" Padding="20,26" IsVisible="{Binding !HasSelectedFiles}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                        <Border Width="52" Height="52" Background="#F0F9FF" BorderBrush="#BAE6FD" BorderThickness="1" CornerRadius="14" HorizontalAlignment="Center">
                            <materialIcons:MaterialIcon Kind="ShieldLockOutline" Width="28" Height="28" Foreground="#0284C7" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Spacing="3" HorizontalAlignment="Center">
                            <TextBlock Text="Select PDF to Encrypt &amp; Protect" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource WinTextBrush}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                            <TextBlock Text="Add password protection and restrict viewing, printing, and modification permissions" FontSize="11.5" Foreground="{DynamicResource WinMutedBrush}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Command="{Binding AddFilesCommand}" Background="#0284C7" Foreground="White" CornerRadius="8" Padding="18,9" FontSize="12.5" FontWeight="SemiBold" HorizontalAlignment="Center" Cursor="Hand">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <materialIcons:MaterialIcon Kind="FolderOpenOutline" Width="15" Height="15" />
                                <TextBlock Text="Select PDF Documents" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Selected documents quick summary (full list with add/remove/reorder lives in the shared Files tab) -->
                <Border Background="#F0F9FF" BorderBrush="#BAE6FD" BorderThickness="1" CornerRadius="10" Padding="12,9" IsVisible="{Binding HasSelectedFiles}">
                    <StackPanel Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <materialIcons:MaterialIcon Kind="FileDocumentMultipleOutline" Width="16" Height="16" Foreground="#0284C7" />
                            <TextBlock Text="Documents to Protect" FontSize="11.5" FontWeight="Bold" Foreground="#075985" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{Binding TotalSummaryText}" FontSize="11" FontWeight="Medium" Foreground="#0369A1" TextWrapping="Wrap" />
                        <TextBlock Text="Manage documents in the Files tab — add, remove, or reorder them there." FontSize="10.5" Foreground="#0369A1" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- Password & Permissions Configuration -->
                <StackPanel Spacing="14">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <materialIcons:MaterialIcon Kind="ShieldCheckOutline" Width="18" Height="18" Foreground="#0284C7" />
                        <TextBlock Text="Security &amp; Passwords" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource WinTextBrush}" VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="User Open Password" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource WinMutedBrush}" />
                        <TextBox Text="{Binding UserPassword}" PasswordChar="•" FontSize="12" PlaceholderText="Required to open..." />
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="Owner / Permissions Password" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource WinMutedBrush}" />
                        <TextBox Text="{Binding OwnerPassword}" PasswordChar="•" FontSize="12" PlaceholderText="Required to edit permissions..." />
                    </StackPanel>

                    <TextBlock Text="Permissions Restrictions" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource WinMutedBrush}" Margin="0,6,0,0" />
                    <StackPanel Spacing="6">
                        <CheckBox Content="Allow Printing Documents" IsChecked="{Binding AllowPrinting}" FontSize="12" />
                        <CheckBox Content="Allow Copying Text &amp; Graphics" IsChecked="{Binding AllowCopying}" FontSize="12" />
                        <CheckBox Content="Allow Modifying Contents" IsChecked="{Binding AllowModifying}" FontSize="12" />
                        <CheckBox Content="Allow Adding Annotations &amp; Comments" IsChecked="{Binding AllowAnnotating}" FontSize="12" />
                        <CheckBox Content="Allow Interactive Form Filling" IsChecked="{Binding AllowFormFilling}" FontSize="12" />
                    </StackPanel>
                </StackPanel>

            </StackPanel>
        </shell:PdfToolWorkspaceView.OptionsContent>

    </shell:PdfToolWorkspaceView>
</UserControl>
