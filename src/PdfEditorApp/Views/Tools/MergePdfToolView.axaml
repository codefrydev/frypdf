<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PdfEditorApp.ViewModels.Tools"
             xmlns:models="using:PdfEditorApp.Models"
             xmlns:converters="using:PdfEditorApp.Converters"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="PdfEditorApp.Views.Tools.MergePdfToolView"
             x:DataType="vm:MergePdfToolViewModel">

    <UserControl.Resources>
        <converters:HexToBrushConverter x:Key="HexToBrushConverter" />
    </UserControl.Resources>

    <Grid ColumnDefinitions="*,390" Margin="0,4,0,0">

        <!-- LEFT: Files workspace, ordering, execution status, and merged PDF preview -->
        <ScrollViewer Grid.Column="0" Margin="0,0,20,0" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="16">

                <!-- Error Alert Banner -->
                <Border Background="#FEF2F2" BorderBrush="#FCA5A5" BorderThickness="1" CornerRadius="10" Padding="16,12" IsVisible="{Binding HasError}">
                    <Grid ColumnDefinitions="Auto,*">
                        <materialIcons:MaterialIcon Grid.Column="0" Kind="AlertCircleOutline" Width="22" Height="22" Foreground="#DC2626" Margin="0,0,12,0" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="Merge Failed" FontSize="13" FontWeight="Bold" Foreground="#991B1B" />
                            <TextBlock Text="{Binding ErrorMessage}" FontSize="12" Foreground="#B91C1C" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Saved Destination Notification Banner -->
                <Border Background="#F0FDF4" BorderBrush="#86EFAC" BorderThickness="1" CornerRadius="10" Padding="14,10" IsVisible="{Binding HasSavedNotification}">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <materialIcons:MaterialIcon Grid.Column="0" Kind="CheckCircleOutline" Width="20" Height="20" Foreground="#16A34A" Margin="0,0,10,0" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding SavedNotificationMessage}" FontSize="12.5" FontWeight="SemiBold" Foreground="#166534" VerticalAlignment="Center" TextWrapping="Wrap" />
                        <Button Grid.Column="2" Command="{Binding OpenOutputFolderCommand}" Background="#DCFCE7" Foreground="#166534" CornerRadius="6" Padding="10,4" FontSize="11.5" Cursor="Hand">
                            View in Folder
                        </Button>
                    </Grid>
                </Border>

                <!-- Rich Merged Result & Interactive Document Preview Card -->
                <Border Background="#FFFFFF" BorderBrush="#86EFAC" BorderThickness="1.5" CornerRadius="14" Padding="20" BoxShadow="0 8 24 #1516A34A" IsVisible="{Binding IsComplete}">
                    <StackPanel Spacing="16">
                        
                        <!-- Header & Primary Status -->
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Border Grid.Column="0" Width="48" Height="48" Background="#DCFCE7" CornerRadius="12" Margin="0,0,14,0">
                                <materialIcons:MaterialIcon Kind="CheckCircle" Width="28" Height="28" Foreground="#16A34A" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="PDFs Merged Successfully!" FontSize="16" FontWeight="Bold" Foreground="#166534" />
                                <TextBlock Text="{Binding ResultSummaryMessage}" FontSize="12.5" Foreground="#15803D" TextWrapping="Wrap" />
                            </StackPanel>
                            <Button Grid.Column="2" Command="{Binding StartOverCommand}" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" Foreground="#64748B" CornerRadius="8" Padding="12,6" FontSize="12" Cursor="Hand">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <materialIcons:MaterialIcon Kind="Refresh" Width="14" Height="14" />
                                    <TextBlock Text="Merge Another" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- Action Buttons Bar: Save As / Edit / View / Reveal -->
                        <WrapPanel Orientation="Horizontal">
                            <!-- Prominent Save As Button -->
                            <Button Command="{Binding SaveOutputFileAsCommand}" Background="#EA580C" Foreground="White" CornerRadius="8" Padding="16,10" FontSize="13" FontWeight="Bold" Cursor="Hand" Margin="0,0,8,6">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <materialIcons:MaterialIcon Kind="ContentSaveOutline" Width="17" Height="17" />
                                    <TextBlock Text="Save Merged PDF As..." VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <!-- Open in Default Viewer -->
                            <Button Command="{Binding OpenOutputFileCommand}" Background="#16A34A" Foreground="White" CornerRadius="8" Padding="14,10" FontSize="12.5" FontWeight="SemiBold" Cursor="Hand" Margin="0,0,8,6">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <materialIcons:MaterialIcon Kind="FileEyeOutline" Width="16" Height="16" />
                                    <TextBlock Text="Open in Viewer" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <!-- Open in Editor -->
                            <Button Command="{Binding OpenInEditorCommand}" Background="#EFF6FF" Foreground="#0F6CBD" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="8" Padding="14,10" FontSize="12.5" FontWeight="SemiBold" Cursor="Hand" Margin="0,0,8,6">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <materialIcons:MaterialIcon Kind="SquareEditOutline" Width="16" Height="16" />
                                    <TextBlock Text="Edit in FryPDF" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <!-- Reveal in Folder -->
                            <Button Command="{Binding OpenOutputFolderCommand}" Background="#F1F5F9" Foreground="#334155" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="14,10" FontSize="12.5" FontWeight="SemiBold" Cursor="Hand" Margin="0,0,8,6">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <materialIcons:MaterialIcon Kind="FolderOpenOutline" Width="16" Height="16" />
                                    <TextBlock Text="Show in Folder" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </WrapPanel>

                        <!-- Document Metadata Summary -->
                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="14,10">
                            <Grid ColumnDefinitions="*,Auto,Auto">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <materialIcons:MaterialIcon Kind="FileDocumentCheckOutline" Width="18" Height="18" Foreground="#16A34A" />
                                    <TextBlock Text="{Binding OutputFilePreview.FileName}" FontSize="12.5" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="350" />
                                </StackPanel>
                                <Border Grid.Column="1" Background="#DCFCE7" CornerRadius="6" Padding="8,2" Margin="10,0">
                                    <TextBlock Text="{Binding OutputFilePreview.PageCountText}" FontSize="11.5" FontWeight="Bold" Foreground="#166534" />
                                </Border>
                                <Border Grid.Column="2" Background="#E2E8F0" CornerRadius="6" Padding="8,2">
                                    <TextBlock Text="{Binding OutputFilePreview.FileSizeFormatted}" FontSize="11.5" FontWeight="Bold" Foreground="#334155" />
                                </Border>
                            </Grid>
                        </Border>

                        <!-- IN-APP MERGED PDF PAGE STRIP PREVIEW -->
                        <StackPanel Spacing="8">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="Merged Document Pages Preview" FontSize="13" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding OutputPageThumbnails.Count, StringFormat='{}{0} Pages Generated'}" FontSize="11.5" Foreground="#64748B" VerticalAlignment="Center" />
                            </Grid>

                            <!-- Horizontal Scrollable Page Gallery -->
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding OutputPageThumbnails}" Margin="0,4,0,8">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="12" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="models:PdfPagePreviewThumbnail">
                                            <Border Width="110" Height="150" Background="White" BorderBrush="#CBD5E1" BorderThickness="1.5" CornerRadius="8" Padding="8" BoxShadow="0 3 8 #0A000000">
                                                <Grid RowDefinitions="Auto,*,Auto">
                                                    
                                                    <!-- Top Page Badge -->
                                                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,6">
                                                        <Border Grid.Column="0" Background="#EA580C" CornerRadius="4" Padding="5,1" HorizontalAlignment="Left">
                                                            <TextBlock Text="{Binding PageNumber, StringFormat='{}#{0}'}" FontSize="9.5" FontWeight="Bold" Foreground="White" />
                                                        </Border>
                                                        <TextBlock Grid.Column="1" Text="{Binding DimensionsText}" FontSize="8.5" Foreground="#94A3B8" />
                                                    </Grid>

                                                    <!-- Visual Page Sheet Lines -->
                                                    <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4" Padding="6,6" Margin="0,0,0,6">
                                                        <StackPanel Spacing="4" VerticalAlignment="Center">
                                                            <Border Height="3" Background="#EA580C" CornerRadius="1.5" Margin="0,0,20,0" Opacity="0.8" />
                                                            <Border Height="2" Background="#CBD5E1" CornerRadius="1" Margin="0,0,6,0" />
                                                            <Border Height="2" Background="#E2E8F0" CornerRadius="1" Margin="0,0,12,0" />
                                                            <Border Height="2" Background="#CBD5E1" CornerRadius="1" Margin="0,0,4,0" />
                                                            <Border Height="2" Background="#E2E8F0" CornerRadius="1" Margin="0,0,16,0" />
                                                            <Border Height="2" Background="#F1F5F9" CornerRadius="1" Margin="0,0,8,0" />
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- Bottom Label -->
                                                    <TextBlock Grid.Row="2" Text="{Binding PageLabel}" FontSize="9.5" FontWeight="SemiBold" Foreground="#475569" HorizontalAlignment="Center" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>

                    </StackPanel>
                </Border>

                <!-- Processing Progress Card -->
                <Border Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="12" Padding="20,16" BoxShadow="0 4 12 #08000000" IsVisible="{Binding IsRunning}">
                    <StackPanel Spacing="12">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <materialIcons:MaterialIcon Kind="CogSyncOutline" Width="20" Height="20" Foreground="#EA580C" />
                                <TextBlock Text="{Binding StatusMessage}" FontSize="13" FontWeight="SemiBold" Foreground="#1E293B" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding ProgressPercentage, StringFormat='{}{0:F0}%'}" FontSize="14" FontWeight="Bold" Foreground="#EA580C" VerticalAlignment="Center" />
                        </Grid>
                        <ProgressBar Value="{Binding ProgressPercentage}" Minimum="0" Maximum="100" Height="8" CornerRadius="4" Foreground="#EA580C" Background="#F1F5F9" />
                        <Button Command="{Binding CancelExecutionCommand}" HorizontalAlignment="Right" Background="#F1F5F9" Foreground="#64748B" CornerRadius="6" Padding="12,5" FontSize="11.5" Cursor="Hand">
                            Cancel Merge
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Large Drag & Drop Box when empty -->
                <Border Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="2" CornerRadius="12" Padding="36,44" IsVisible="{Binding !HasSelectedFiles}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
                        <Border Width="64" Height="64" Background="#FFF7ED" BorderBrush="#FED7AA" BorderThickness="1" CornerRadius="16" HorizontalAlignment="Center">
                            <materialIcons:MaterialIcon Kind="CallMerge" Width="34" Height="34" Foreground="#EA580C" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Spacing="4" HorizontalAlignment="Center">
                            <TextBlock Text="Drag and drop PDF files to combine" FontSize="16" FontWeight="Bold" Foreground="#0F172A" HorizontalAlignment="Center" />
                            <TextBlock Text="Combine multiple PDF documents into a single organized file with full page previews" FontSize="13" Foreground="#64748B" HorizontalAlignment="Center" />
                        </StackPanel>
                        <Button Command="{Binding AddFilesCommand}" Background="#EA580C" Foreground="White" CornerRadius="8" Padding="24,10" FontSize="13.5" FontWeight="SemiBold" HorizontalAlignment="Center" Cursor="Hand">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <materialIcons:MaterialIcon Kind="FolderOpenOutline" Width="16" Height="16" />
                                <TextBlock Text="Select PDF Documents" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <TextBlock Text="Select 2 or more PDF files to preview and arrange" FontSize="11.5" Foreground="#94A3B8" HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- Merge Sequence Visual Flow Banner (When files loaded) -->
                <Border Background="#FFF7ED" BorderBrush="#FFEDD5" BorderThickness="1" CornerRadius="10" Padding="14,10" IsVisible="{Binding HasSelectedFiles}">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <materialIcons:MaterialIcon Kind="FileTreeOutline" Width="18" Height="18" Foreground="#EA580C" />
                            <TextBlock Text="Merge Pipeline Sequence:" FontSize="12" FontWeight="Bold" Foreground="#9A3412" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding TotalSummaryText}" FontSize="12" FontWeight="Medium" Foreground="#C2410C" Margin="10,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <Border Grid.Column="2" Background="#EA580C" CornerRadius="12" Padding="8,2">
                            <TextBlock Text="{Binding TotalSelectedPages, StringFormat='{}{0} Total Pages'}" FontSize="11" FontWeight="Bold" Foreground="White" />
                        </Border>
                    </Grid>
                </Border>

                <!-- Selected Files List with Rich Visual Previews & Reorder Controls -->
                <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="20" BoxShadow="0 2 6 #05000000" IsVisible="{Binding HasSelectedFiles}">
                    <StackPanel Spacing="14">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <materialIcons:MaterialIcon Kind="FormatListNumbered" Width="18" Height="18" Foreground="#EA580C" />
                                <TextBlock Text="Documents in Merge Sequence" FontSize="14" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center" />
                                <Border Background="#FFF7ED" CornerRadius="12" Padding="8,2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding SelectedFilePreviewItems.Count, StringFormat='{}{0} files'}" FontSize="11" FontWeight="Bold" Foreground="#EA580C" />
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                <Button Command="{Binding AddFilesCommand}" Background="#FFF7ED" Foreground="#EA580C" BorderBrush="#FED7AA" BorderThickness="1" CornerRadius="6" Padding="12,6" FontSize="12" FontWeight="SemiBold" Cursor="Hand">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <materialIcons:MaterialIcon Kind="Plus" Width="14" Height="14" />
                                        <TextBlock Text="Add More" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding ClearFilesCommand}" Background="Transparent" BorderThickness="0" Foreground="#EF4444" FontSize="12" Padding="8,6" Cursor="Hand">
                                    Clear All
                                </Button>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Drag or use the Up/Down buttons to adjust the merge order. Each document's pages will be appended sequentially." FontSize="11.5" Foreground="#64748B" />

                        <!-- Visual Document Preview Items List -->
                        <ItemsControl ItemsSource="{Binding SelectedFilePreviewItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="models:PdfFilePreviewItem">
                                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,10" BoxShadow="0 2 6 #04000000">
                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                            
                                            <!-- Mini-Page Sheet Thumbnail Preview -->
                                            <Border Grid.Column="0" Width="64" Height="82" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" BoxShadow="0 2 6 #0A000000" Margin="0,0,14,0" Padding="6,5">
                                                <Grid RowDefinitions="Auto,*,Auto">
                                                    <!-- Miniature Page Header -->
                                                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,4">
                                                        <Border Grid.Column="0" Width="20" Height="3" Background="#EA580C" CornerRadius="1" HorizontalAlignment="Left" />
                                                        <Border Grid.Column="1" Width="8" Height="3" Background="#CBD5E1" CornerRadius="1" />
                                                    </Grid>
                                                    
                                                    <!-- Miniature Page Body Content Lines -->
                                                    <StackPanel Grid.Row="1" Spacing="3" VerticalAlignment="Center">
                                                        <Border Height="2.5" Background="#E2E8F0" CornerRadius="1" Margin="0,0,4,0" />
                                                        <Border Height="2.5" Background="#E2E8F0" CornerRadius="1" Margin="0,0,10,0" />
                                                        <Border Height="2.5" Background="#F1F5F9" CornerRadius="1" Margin="0,0,2,0" />
                                                        <Border Height="2.5" Background="#E2E8F0" CornerRadius="1" Margin="0,0,8,0" />
                                                    </StackPanel>
                                                    
                                                    <!-- Miniature Page Footer Tag -->
                                                    <Border Grid.Row="2" Background="#FFF7ED" CornerRadius="2" Padding="2,1" HorizontalAlignment="Center">
                                                        <TextBlock Text="{Binding PageCountText}" FontSize="7.5" FontWeight="Bold" Foreground="#EA580C" />
                                                    </Border>
                                                </Grid>
                                            </Border>

                                            <!-- Document Metadata & Order Info -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <Border Background="#EA580C" CornerRadius="4" Padding="6,1.5">
                                                        <TextBlock Text="{Binding OrderIndexText}" FontSize="10.5" FontWeight="Bold" Foreground="White" />
                                                    </Border>
                                                    <TextBlock Text="{Binding FileName}" FontSize="13" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="320" ToolTip.Tip="{Binding FilePath}" />
                                                </StackPanel>

                                                <!-- Metadata Badges Strip -->
                                                <WrapPanel Orientation="Horizontal">
                                                    <Border Background="#F1F5F9" CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                                            <materialIcons:MaterialIcon Kind="FileDocumentOutline" Width="13" Height="13" Foreground="#475569" />
                                                            <TextBlock Text="{Binding PageCountText}" FontSize="11" FontWeight="SemiBold" Foreground="#334155" />
                                                        </StackPanel>
                                                    </Border>

                                                    <Border Background="#F1F5F9" CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                                            <materialIcons:MaterialIcon Kind="DatabaseOutline" Width="13" Height="13" Foreground="#475569" />
                                                            <TextBlock Text="{Binding FileSizeFormatted}" FontSize="11" FontWeight="SemiBold" Foreground="#334155" />
                                                        </StackPanel>
                                                    </Border>

                                                    <Border Background="#EFF6FF" CornerRadius="4" Padding="6,2">
                                                        <TextBlock Text="{Binding PageDimensionsText}" FontSize="11" Foreground="#1E40AF" />
                                                    </Border>
                                                </WrapPanel>

                                                <!-- Truncated Path Subtitle -->
                                                <TextBlock Text="{Binding FilePath}" FontSize="10.5" Foreground="#94A3B8" TextTrimming="CharacterEllipsis" MaxWidth="380" />
                                            </StackPanel>

                                            <!-- Reordering & Remove Actions -->
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                <Button Command="{Binding $parent[UserControl].((vm:MergePdfToolViewModel)DataContext).MoveFileUpCommand}" CommandParameter="{Binding FilePath}" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="7" Cursor="Hand" ToolTip.Tip="Move Up in Sequence">
                                                    <materialIcons:MaterialIcon Kind="ArrowUp" Width="16" Height="16" Foreground="#475569" />
                                                </Button>
                                                <Button Command="{Binding $parent[UserControl].((vm:MergePdfToolViewModel)DataContext).MoveFileDownCommand}" CommandParameter="{Binding FilePath}" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="7" Cursor="Hand" ToolTip.Tip="Move Down in Sequence">
                                                    <materialIcons:MaterialIcon Kind="ArrowDown" Width="16" Height="16" Foreground="#475569" />
                                                </Button>
                                                <Button Command="{Binding $parent[UserControl].((vm:MergePdfToolViewModel)DataContext).RemoveFileCommand}" CommandParameter="{Binding FilePath}" Background="#FEF2F2" BorderBrush="#FCA5A5" BorderThickness="1" CornerRadius="6" Padding="7" Cursor="Hand" ToolTip.Tip="Remove from Merge">
                                                    <materialIcons:MaterialIcon Kind="Close" Width="16" Height="16" Foreground="#DC2626" />
                                                </Button>
                                            </StackPanel>

                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- RIGHT: Merge Options & Action Panel -->
        <Border Grid.Column="1" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="22" BoxShadow="0 4 12 #08000000">
            <DockPanel>
                <Border DockPanel.Dock="Top" Margin="0,0,0,16">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <materialIcons:MaterialIcon Kind="TuneVerticalVariant" Width="18" Height="18" Foreground="#EA580C" />
                        <TextBlock Text="Merge Configuration" FontSize="14" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <StackPanel DockPanel.Dock="Bottom" Margin="0,16,0,0" Spacing="10">
                    <Button Command="{Binding ExecuteToolCommand}" Background="#EA580C" Foreground="White" CornerRadius="10" Padding="24,14" FontWeight="Bold" FontSize="14" Cursor="Hand" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" IsEnabled="{Binding !IsRunning}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <materialIcons:MaterialIcon Kind="CallMerge" Width="18" Height="18" />
                            <TextBlock Text="Merge PDFs Now" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <TextBlock Text="Combine all selected files into one document" FontSize="11" Foreground="#94A3B8" HorizontalAlignment="Center" />
                </StackPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="16">
                        
                        <!-- Summary Stats Card -->
                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Output Document Stats" FontSize="11.5" FontWeight="Bold" Foreground="#475569" />
                                <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Input Files:" FontSize="12" Foreground="#64748B" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedFilePreviewItems.Count, StringFormat='{}{0}'}" FontSize="12" FontWeight="Bold" Foreground="#0F172A" />

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Total Output Pages:" FontSize="12" Foreground="#64748B" Margin="0,4,0,0" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding TotalSelectedPages, StringFormat='{}{0} pages'}" FontSize="12" FontWeight="Bold" Foreground="#EA580C" Margin="0,4,0,0" />

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Total Input Size:" FontSize="12" Foreground="#64748B" Margin="0,4,0,0" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding TotalSummaryText}" FontSize="11.5" FontWeight="SemiBold" Foreground="#334155" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" MaxWidth="150" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Background="#FFF7ED" BorderBrush="#FED7AA" BorderThickness="1" CornerRadius="8" Padding="12">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Sequential Order Tip" FontSize="11" FontWeight="Bold" Foreground="#9A3412" />
                                <TextBlock Text="Files will be merged in the exact sequential order listed in the left pane." FontSize="11.5" Foreground="#C2410C" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <StackPanel Spacing="8">
                            <TextBlock Text="Merge Options" FontSize="12" FontWeight="SemiBold" Foreground="#475569" />
                            <CheckBox Content="Preserve Bookmarks &amp; Outlines" IsChecked="{Binding PreserveBookmarks}" FontSize="12" />
                            <CheckBox Content="Normalize Page Dimensions (A4 standard)" IsChecked="{Binding NormalizePageSizes}" FontSize="12" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

    </Grid>
</UserControl>
