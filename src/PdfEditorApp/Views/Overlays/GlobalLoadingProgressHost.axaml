<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PdfEditorApp.ViewModels"
             xmlns:controls="using:PdfEditorApp.Views.Controls"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="800"
             x:Class="PdfEditorApp.Views.Overlays.GlobalLoadingProgressHost"
             x:DataType="vm:LoadingProgressViewModel"
             Background="{DynamicResource M3SurfaceBrush}">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- 1. Top Minimal Navigation Bar -->
        <Border Grid.Row="0"
                Height="56"
                Padding="24,0"
                Background="Transparent">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <!-- Left: Back to Dashboard Pill Button -->
                <Button Grid.Column="0"
                        Classes="m3-tonal-btn action-pill-btn"
                        Command="{Binding CancelCommand}"
                        IsVisible="{Binding IsCancellable}"
                        ToolTip.Tip="Cancel Operation &amp; Return to Dashboard (Esc or ⌘W)"
                        Padding="14,6"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <materialIcons:MaterialIcon Kind="ArrowLeft" Width="16" Height="16" />
                        <TextBlock Text="Back to Dashboard" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- Center: FryPDF Brand Badge -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Width="26" Height="26"
                            Background="{DynamicResource M3SurfaceContainerLowestBrush}"
                            BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource M3ShapeCornerFull}"
                            BoxShadow="0 1 4 #15000000"
                            ClipToBounds="True">
                        <Image Source="avares://PdfEditorApp/Assets/app-logo.png" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="FryPDF" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource M3OnSurfaceBrush}" VerticalAlignment="Center" />
                    <Border Classes="m3-badge" Padding="6,2" VerticalAlignment="Center">
                        <TextBlock Text="STUDIO" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource M3OnPrimaryContainerBrush}" />
                    </Border>
                </StackPanel>

                <!-- Right: High-Performance Engine Chip -->
                <Border Grid.Column="2"
                        Classes="m3-chip"
                        Padding="12,5"
                        VerticalAlignment="Center"
                        Background="{DynamicResource M3SurfaceContainerLowBrush}"
                        BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource M3ShapeCornerFull}">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <materialIcons:MaterialIcon Kind="Cpu64Bit" Width="14" Height="14" Foreground="{DynamicResource M3PrimaryBrush}" />
                        <TextBlock Text="Skia Hardware Accelerated" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- 2. Ambient Background Aura & Center Hero Card -->
        <Panel Grid.Row="1">
            <!-- Soft Centered Radial Aura -->
            <Ellipse Width="720" Height="720"
                     HorizontalAlignment="Center" VerticalAlignment="Center"
                     IsHitTestVisible="False" Opacity="0.08">
                <Ellipse.Fill>
                    <RadialGradientBrush Center="50%,50%" GradientOrigin="50%,50%" RadiusX="50%" RadiusY="50%">
                        <GradientStop Color="#0F6CBD" Offset="0" />
                        <GradientStop Color="#6366F1" Offset="0.45" />
                        <GradientStop Color="Transparent" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <!-- Centerpiece Hero Loading Card -->
            <Border Classes="m3-card-elevated"
                    CornerRadius="{StaticResource M3ShapeCornerExtraLarge}"
                    BoxShadow="{StaticResource M3ElevationLevel3}"
                    Background="{DynamicResource M3SurfaceContainerLowestBrush}"
                    BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                    BorderThickness="1"
                    Padding="44,36"
                    Width="540"
                    MaxWidth="600"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel Spacing="0">

                    <!-- Hero Animated Emblem Halo Disc -->
                    <Panel HorizontalAlignment="Center" Margin="0,0,0,20">
                        <Border Width="112" Height="112"
                                CornerRadius="{StaticResource M3ShapeCornerFull}"
                                Background="{DynamicResource M3SurfaceContainerLowBrush}"
                                BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                                BorderThickness="1"
                                BoxShadow="{StaticResource M3ElevationLevel1}"
                                HorizontalAlignment="Center">
                            <controls:LoadingAnimationControl Width="80" Height="80"
                                                              HorizontalAlignment="Center"
                                                              VerticalAlignment="Center" />
                        </Border>

                        <!-- Floating Category Icon Badge -->
                        <Border Background="{DynamicResource M3PrimaryBrush}"
                                CornerRadius="{StaticResource M3ShapeCornerFull}"
                                Padding="7,3"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                Margin="0,0,-4,-2"
                                BoxShadow="0 2 6 #300F6CBD">
                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <materialIcons:MaterialIcon Kind="{Binding IconKind}" Width="13" Height="13" Foreground="{DynamicResource M3OnPrimaryBrush}" />
                                <TextBlock Text="PRO" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource M3OnPrimaryBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </Panel>

                    <!-- Category & File Size Pill -->
                    <Border Background="{DynamicResource M3SurfaceContainerHighBrush}"
                            CornerRadius="{StaticResource M3ShapeCornerFull}"
                            Padding="12,4"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <materialIcons:MaterialIcon Kind="LightningBolt" Width="13" Height="13" Foreground="{DynamicResource M3PrimaryBrush}" />
                            <TextBlock Text="{Binding Category}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource M3PrimaryBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="•" FontSize="11" Foreground="{DynamicResource M3OutlineBrush}" IsVisible="{Binding HasFileSize}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding FileSize}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" IsVisible="{Binding HasFileSize}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- Title -->
                    <TextBlock Text="{Binding Title}"
                               FontSize="17"
                               FontWeight="Bold"
                               Foreground="{DynamicResource M3OnSurfaceBrush}"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               MaxLines="2"
                               Margin="0,0,0,18" />

                    <!-- Chubby Tactile Progress Bar (Switches Determinate / Indeterminate cleanly) -->
                    <ProgressBar IsIndeterminate="{Binding !IsDeterminate}"
                                 Value="{Binding ProgressPercent}"
                                 Minimum="0" Maximum="100"
                                 Height="8"
                                 CornerRadius="{StaticResource M3ShapeCornerFull}"
                                 Foreground="{DynamicResource M3PrimaryBrush}"
                                 Background="{DynamicResource M3SurfaceContainerHighBrush}"
                                 Margin="12,0,12,14" />

                    <!-- Live Status Row with Glowing Indicator Beacon -->
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" Margin="0,0,0,22">
                        <Border Width="8" Height="8" CornerRadius="{StaticResource M3ShapeCornerFull}"
                                Background="#10B981" VerticalAlignment="Center"
                                BoxShadow="0 0 6 #6010B981" />
                        <TextBlock Text="{Binding StatusMessage}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource M3OnSurfaceBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Dynamic Pipeline Phase Visualizer -->
                    <Border Background="{DynamicResource M3SurfaceContainerLowBrush}"
                            BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource M3ShapeCornerMedium}"
                            Padding="14,8"
                            Margin="0,0,0,24"
                            IsVisible="{Binding HasPipelinePhases}">
                        <ItemsControl ItemsSource="{Binding PipelinePhases}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="6" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:PipelinePhaseItem">
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                            <materialIcons:MaterialIcon Kind="CheckCircle" Width="13" Height="13" Foreground="#10B981" IsVisible="{Binding IsCompleted}" />
                                            <materialIcons:MaterialIcon Kind="ProgressClock" Width="13" Height="13" Foreground="{DynamicResource M3PrimaryBrush}" IsVisible="{Binding IsActive}" />
                                            <materialIcons:MaterialIcon Kind="CircleOutline" Width="13" Height="13" Foreground="{DynamicResource M3OutlineVariantBrush}" IsVisible="{Binding !IsActive}" />
                                            <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource M3OnSurfaceBrush}" />
                                        </StackPanel>
                                        <materialIcons:MaterialIcon Kind="ChevronRight" Width="14" Height="14" Foreground="{DynamicResource M3OutlineVariantBrush}" VerticalAlignment="Center" IsVisible="{Binding !IsLast}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>

                    <!-- Cancel Action Button -->
                    <Button Classes="m3-tonal-btn action-pill-btn"
                            Command="{Binding CancelCommand}"
                            IsVisible="{Binding IsCancellable}"
                            HorizontalAlignment="Center"
                            Padding="24,8"
                            ToolTip.Tip="Cancel operation (Esc)">
                        <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                            <materialIcons:MaterialIcon Kind="CloseCircleOutline" Width="15" Height="15" />
                            <TextBlock Text="{Binding CancelButtonText}" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- Keyboard Hint -->
                    <TextBlock Text="Press Esc or ⌘W to return to dashboard"
                               FontSize="11"
                               Foreground="{DynamicResource M3OnSurfaceVariantBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,10,0,0"
                               IsVisible="{Binding IsCancellable}" />

                </StackPanel>
            </Border>
        </Panel>

        <!-- 3. Bottom Minimal Footer -->
        <Border Grid.Row="2"
                Height="40"
                Padding="24,0"
                Background="Transparent">
            <TextBlock Text="FryPDF Document Studio • Universal Plugin Microkernel Engine"
                       FontSize="11"
                       Foreground="{DynamicResource M3OutlineBrush}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
        </Border>

    </Grid>

</UserControl>
