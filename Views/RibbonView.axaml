<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PdfEditorApp.ViewModels"
             xmlns:models="using:PdfEditorApp.Models"
             xmlns:converters="using:PdfEditorApp.Converters"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="PdfEditorApp.Views.RibbonView"
             x:DataType="vm:MainViewModel">

    <UserControl.Resources>
        <converters:EqualityToBooleanConverter x:Key="EqualityConverter" />
        <converters:HexToBrushConverter x:Key="HexToBrushConverter" />
    </UserControl.Resources>

    <Border Background="White" BorderBrush="{StaticResource WinBorderBrush}" BorderThickness="0,0,0,1">
        <Grid RowDefinitions="Auto,Auto">

            <!-- 1. Ribbon Menu Tabs Bar -->
            <Border Grid.Row="0" Background="{StaticResource WinBgBrush}" BorderBrush="{StaticResource WinBorderBrush}" BorderThickness="0,0,0,1" Padding="12,4,12,4">
                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">

                    <!-- File Tab (Accent Pill) -->
                    <Button Classes="ribbon-file-tab"
                            Command="{Binding OpenNewDocumentDialogCommand}"
                            ToolTip.Tip="New Document, Open, Templates">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <materialIcons:MaterialIcon Kind="FileOutline" Width="14" Height="14" Foreground="White" />
                            <TextBlock Text="File" VerticalAlignment="Center" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>

                    <!-- Home Tab -->
                    <Button Classes="ribbon-tab"
                            Classes.active="{Binding ActiveRibbonTab, Converter={StaticResource EqualityConverter}, ConverterParameter=Home}"
                            Command="{Binding SelectRibbonTabCommand}"
                            CommandParameter="{x:Static models:RibbonTabKind.Home}">
                        <TextBlock Text="Home" />
                    </Button>

                    <!-- Edit Tab -->
                    <Button Classes="ribbon-tab"
                            Classes.active="{Binding ActiveRibbonTab, Converter={StaticResource EqualityConverter}, ConverterParameter=Edit}"
                            Command="{Binding SelectRibbonTabCommand}"
                            CommandParameter="{x:Static models:RibbonTabKind.Edit}">
                        <TextBlock Text="Edit" />
                    </Button>

                    <!-- Comment Tab -->
                    <Button Classes="ribbon-tab"
                            Classes.active="{Binding ActiveRibbonTab, Converter={StaticResource EqualityConverter}, ConverterParameter=Comment}"
                            Command="{Binding SelectRibbonTabCommand}"
                            CommandParameter="{x:Static models:RibbonTabKind.Comment}">
                        <TextBlock Text="Comment" />
                    </Button>

                    <!-- Insert Tab -->
                    <Button Classes="ribbon-tab"
                            Classes.active="{Binding ActiveRibbonTab, Converter={StaticResource EqualityConverter}, ConverterParameter=Insert}"
                            Command="{Binding SelectRibbonTabCommand}"
                            CommandParameter="{x:Static models:RibbonTabKind.Insert}">
                        <TextBlock Text="Insert" />
                    </Button>

                    <!-- Fill & Sign Tab -->
                    <Button Classes="ribbon-tab"
                            Classes.active="{Binding ActiveRibbonTab, Converter={StaticResource EqualityConverter}, ConverterParameter=Sign}"
                            Command="{Binding SelectRibbonTabCommand}"
                            CommandParameter="{x:Static models:RibbonTabKind.Sign}">
                        <TextBlock Text="Fill &amp; Sign" />
                    </Button>

                    <!-- Forms Tab (AcroForms Suite) -->
                    <Button Classes="ribbon-tab"
                            Classes.active="{Binding ActiveRibbonTab, Converter={StaticResource EqualityConverter}, ConverterParameter=Forms}"
                            Command="{Binding SelectRibbonTabCommand}"
                            CommandParameter="{x:Static models:RibbonTabKind.Forms}">
                        <TextBlock Text="Forms" />
                    </Button>

                    <!-- Organize Tab -->
                    <Button Classes="ribbon-tab"
                            Classes.active="{Binding ActiveRibbonTab, Converter={StaticResource EqualityConverter}, ConverterParameter=Organize}"
                            Command="{Binding SelectRibbonTabCommand}"
                            CommandParameter="{x:Static models:RibbonTabKind.Organize}">
                        <TextBlock Text="Organize" />
                    </Button>

                    <!-- Protect & Redact Tab -->
                    <Button Classes="ribbon-tab"
                            Classes.active="{Binding ActiveRibbonTab, Converter={StaticResource EqualityConverter}, ConverterParameter=Protect}"
                            Command="{Binding SelectRibbonTabCommand}"
                            CommandParameter="{x:Static models:RibbonTabKind.Protect}">
                        <TextBlock Text="Protect &amp; Redact" />
                    </Button>

                    <!-- Preflight Audit & Guides Tab -->
                    <Button Classes="ribbon-tab"
                            Classes.active="{Binding ActiveRibbonTab, Converter={StaticResource EqualityConverter}, ConverterParameter=Audit}"
                            Command="{Binding SelectRibbonTabCommand}"
                            CommandParameter="{x:Static models:RibbonTabKind.Audit}">
                        <TextBlock Text="Preflight &amp; View" />
                    </Button>

                    <!-- Export Tab -->
                    <Button Classes="ribbon-tab"
                            Classes.active="{Binding ActiveRibbonTab, Converter={StaticResource EqualityConverter}, ConverterParameter=Export}"
                            Command="{Binding SelectRibbonTabCommand}"
                            CommandParameter="{x:Static models:RibbonTabKind.Export}">
                        <TextBlock Text="Export" />
                    </Button>
                </StackPanel>
            </Border>

            <!-- 2. Ribbon Dynamic Tools Panel -->
            <Border Grid.Row="1" Background="White" Height="100" Padding="12,5,12,5">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <Panel>

                        <!-- ================= TAB: HOME ================= -->
                        <StackPanel Orientation="Horizontal" Spacing="6"
                                    IsVisible="{Binding ActiveRibbonTab, Converter={StaticResource EqualityConverter}, ConverterParameter=Home}">

                            <!-- Clipboard Group -->
                            <Grid RowDefinitions="*,Auto">
                                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                    <Button Classes="tool-btn" Command="{Binding PasteCommand}" ToolTip.Tip="Paste Element (⌘V / Ctrl+V)">
                                        <StackPanel HorizontalAlignment="Center" Spacing="3">
                                            <materialIcons:MaterialIcon Kind="ContentPaste" Width="22" Height="22" Foreground="{StaticResource WinAccentBrush}" HorizontalAlignment="Center" />
                                            <TextBlock Text="Paste" FontSize="10" FontWeight="Medium" Foreground="{StaticResource WinTextBrush}" HorizontalAlignment="Center" TextWrapping="NoWrap" />
                                        </StackPanel>
                                    </Button>
                                    <StackPanel VerticalAlignment="Center" Spacing="2">
                                        <Button Classes="mini-tool-btn" Command="{Binding CutCommand}" ToolTip.Tip="Cut Element (⌘X / Ctrl+X)">
                                            <materialIcons:MaterialIcon Kind="ContentCut" Width="15" Height="15" Foreground="{StaticResource WinTextBrush}" />
                                        </Button>
                                        <Button Classes="mini-tool-btn" Command="{Binding CopyCommand}" ToolTip.Tip="Copy Element (⌘C / Ctrl+C)">
                                            <materialIcons:MaterialIcon Kind="ContentCopy" Width="15" Height="15" Foreground="{StaticResource WinTextBrush}" />
                                        </Button>
                                        <Button Classes="mini-tool-btn" Command="{Binding DuplicateCommand}" ToolTip.Tip="Duplicate Element (⌘D / Ctrl+D)">
                                            <materialIcons:MaterialIcon Kind="ContentDuplicate" Width="15" Height="15" Foreground="{StaticResource WinTextBrush}" />
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock Grid.Row="1" Text="Clipboard" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource WinSubtleBrush}" HorizontalAlignment="Center" Margin="0,3,0,0" LetterSpacing="0.4" />
                            </Grid>

                            <Rectangle Width="1" Height="68" Fill="{StaticResource WinBorderBrush}" VerticalAlignment="Center" Margin="4,0" />

                            <!-- History Group -->
                            <Grid RowDefinitions="*,Auto">
                                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                    <Button Classes="tool-btn" Command="{Binding UndoCommand}" ToolTip.Tip="Undo Action (⌘Z / Ctrl+Z)">
                                        <StackPanel HorizontalAlignment="Center" Spacing="3">
                                            <materialIcons:MaterialIcon Kind="Undo" Width="20" Height="20" Foreground="{StaticResource WinTextBrush}" HorizontalAlignment="Center" />
                                            <TextBlock Text="Undo" FontSize="10" FontWeight="Medium" Foreground="{StaticResource WinTextBrush}" HorizontalAlignment="Center" TextWrapping="NoWrap" />
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="tool-btn" Command="{Binding RedoCommand}" ToolTip.Tip="Redo Action (⌘Y / Ctrl+Y)">
                                        <StackPanel HorizontalAlignment="Center" Spacing="3">
                                            <materialIcons:MaterialIcon Kind="Redo" Width="20" Height="20" Foreground="{StaticResource WinTextBrush}" HorizontalAlignment="Center" />
                                            <TextBlock Text="Redo" FontSize="10" FontWeight="Medium" Foreground="{StaticResource WinTextBrush}" HorizontalAlignment="Center" TextWrapping="NoWrap" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                                <TextBlock Grid.Row="1" Text="History" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource WinSubtleBrush}" HorizontalAlignment="Center" Margin="0,3,0,0" LetterSpacing="0.4" />
                            </Grid>

                            <Rectangle Width="1" Height="68" Fill="{StaticResource WinBorderBrush}" VerticalAlignment="Center" Margin="4,0" />

                            <!-- Quick Insert Group -->
                            <Grid RowDefinitions="*,Auto">
                                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                    <Button Classes="tool-btn" Command="{Binding AddTextElementCommand}" ToolTip.Tip="Insert Text (T)">
                                        <StackPanel HorizontalAlignment="Center" Spacing="3">
                                            <materialIcons:MaterialIcon Kind="FormatColorText" Width="20" Height="20" Foreground="{StaticResource WinAccentBrush}" HorizontalAlignment="Center" />
                                            <TextBlock Text="Text" FontSize="10" FontWeight="Medium" Foreground="{StaticResource WinTextBrush}" HorizontalAlignment="Center" TextWrapping="NoWrap" />
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="tool-btn" Command="{Binding AddHeadingElementCommand}" ToolTip.Tip="Insert Heading (H)">
                                        <StackPanel HorizontalAlignment="Center" Spacing="3">
                                            <materialIcons:MaterialIcon Kind="FormatHeader1" Width="20" Height="20" Foreground="#475569" HorizontalAlignment="Center" />
                                            <TextBlock Text="Heading" FontSize="10" FontWeight="Medium" Foreground="{StaticResource WinTextBrush}" HorizontalAlignment="Center" TextWrapping="NoWrap" />
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="tool-btn" Command="{Binding AddImageElementCommand}" ToolTip.Tip="Insert Image (⌘I / Ctrl+I)">
                                        <StackPanel HorizontalAlignment="Center" Spacing="3">
                                            <materialIcons:MaterialIcon Kind="ImageOutline" Width="20" Height="20" Foreground="#475569" HorizontalAlignment="Center" />
                                            <TextBlock Text="Image" FontSize="10" FontWeight="Medium" Foreground="{StaticResource WinTextBrush}" HorizontalAlignment="Center" TextWrapping="NoWrap" />
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="tool-btn" Command="{Binding AddShapeElementCommand}" CommandParameter="Rectangle" ToolTip.Tip="Insert Rectangle Shape (R)">
                                        <StackPanel HorizontalAlignment="Center" Spacing="3">
                                            <materialIcons:MaterialIcon Kind="ShapeOutline" Width="20" Height="20" Foreground="#475569" HorizontalAlignment="Center" />
                                            <TextBlock Text="Shape" FontSize="10" FontWeight="Medium" Foreground="{StaticResource WinTextBrush}" HorizontalAlignment="Center" TextWrapping="NoWrap" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                                <TextBlock Grid.Row="1" Text="Quick Content" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource WinSubtleBrush}" HorizontalAlignment="Center" Margin="0,3,0,0" LetterSpacing="0.4" />
                            </Grid>

                            <Rectangle Width="1" Height="68" Fill="{StaticResource WinBorderBrush}" VerticalAlignment="Center" Margin="4,0" />

                            <!-- Quick Actions Group -->
                            <Grid RowDefinitions="*,Auto">
                                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <Button Classes="secondary-btn" Height="34" Padding="12,6" Command="{Binding OpenNewDocumentDialogCommand}" ToolTip.Tip="New Document / Templates (⌘N / Ctrl+N)">
                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <materialIcons:MaterialIcon Kind="FilePlusOutline" Width="16" Height="16" Foreground="{StaticResource WinMutedBrush}" VerticalAlignment="Center" />
                                            <TextBlock Text="Templates" VerticalAlignment="Center" FontWeight="Medium" FontSize="12" />
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="accent-btn" Height="34" Padding="14,6" Command="{Binding ExportPdfCommand}" ToolTip.Tip="Export Production PDF (⌘E / Ctrl+E)">
                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <materialIcons:MaterialIcon Kind="FilePdfBox" Width="18" Height="18" Foreground="White" VerticalAlignment="Center" />
                                            <TextBlock Text="Export PDF" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12.5" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                                <TextBlock Grid.Row="1" Text="Actions" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource WinSubtleBrush}" HorizontalAlignment="Center" Margin="0,3,0,0" LetterSpacing="0.4" />
                            </Grid>
                        </StackPanel>

                        <!-- ================= TAB: EDIT (Authoring & Typography) ================= -->
                        <StackPanel Orientation="Horizontal" Spacing="6"
                                    IsVisible="{Binding ActiveRibbonTab, Converter={StaticResource EqualityConverter}, ConverterParameter=Edit}">

                            <!-- Content Tools Group -->
                            <Grid RowDefinitions="*,Auto">
                                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                    <Button Classes="tool-btn" Command="{Binding AddTextElementCommand}" ToolTip.Tip="Insert Editable Text Block">
                                        <StackPanel HorizontalAlignment="Center" Spacing="3">
                                            <materialIcons:MaterialIcon Kind="FormatColorText" Width="20" Height="20" Foreground="{StaticResource WinAccentBrush}" HorizontalAlignment="Center" />
                                            <TextBlock Text="Edit Text" FontSize="10" FontWeight="Medium" Foreground="{StaticResource WinTextBrush}" HorizontalAlignment="Center" TextWrapping="NoWrap" />
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="tool-btn" Command="{Binding AddHeadingElementCommand}" ToolTip.Tip="Insert Section Heading">
                                        <StackPanel HorizontalAlignment="Center" Spacing="3">
                                            <materialIcons:MaterialIcon Kind="FormatHeader1" Width="20" Height="20" Foreground="#475569" HorizontalAlignment="Center" />
                                            <TextBlock Text="Heading" FontSize="10" FontWeight="Medium" Foreground="{StaticResource WinTextBrush}" HorizontalAlignment="Center" TextWrapping="NoWrap" />
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="tool-btn" Command="{Binding AddImageElementCommand}" ToolTip.Tip="Insert Image from File">
                                        <StackPanel HorizontalAlignment="Center" Spacing="3">
                                            <materialIcons:MaterialIcon Kind="ImageOutline" Width="20" Height="20" Foreground="#475569" HorizontalAlignment="Center" />
                                            <TextBlock Text="Image" FontSize="10" FontWeight="Medium" Foreground="{StaticResource WinTextBrush}" HorizontalAlignment="Center" TextWrapping="NoWrap" />
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="tool-btn" Command="{Binding AddTableElementCommand}" ToolTip.Tip="Insert Multi-Column Table">
                                        <StackPanel HorizontalAlignment="Center" Spacing="3">
                                            <materialIcons:MaterialIcon Kind="TableLarge" Width="20" Height="20" Foreground="#475569" HorizontalAlignment="Center" />
                                            <TextBlock Text="Table" FontSize="10" FontWeight="Medium" Foreground="{StaticResource WinTextBrush}" HorizontalAlignment="Center" TextWrapping="NoWrap" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                                <TextBlock Grid.Row="1" Text="Content" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource WinSubtleBrush}" HorizontalAlignment="Center" Margin="0,3,0,0" LetterSpacing="0.4" />
                            </Grid>

                            <Rectangle Width="1" Height="68" Fill="{StaticResource WinBorderBrush}" VerticalAlignment="Center" Margin="4,0" />

                            <!-- Advanced Typography Group -->
                            <Grid RowDefinitions="*,Auto">
                                <StackPanel Grid.Row="0" VerticalAlignment="Center" Spacing="4" HorizontalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <ComboBox Width="144" Height="28" FontSize="12" Padding="8,2"
                                                  ItemsSource="{Binding Inspector.AvailableFontFamilies}"
                                                  SelectedItem="{Binding Inspector.SelectedFontFamily, Mode=TwoWay}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate DataType="x:String">
                                                    <TextBlock Text="{Binding}" FontFamily="{Binding}" FontSize="12" VerticalAlignment="Center" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>

                                        <ComboBox Width="66" Height="28" FontSize="12" Padding="6,2"
                                                  ItemsSource="{Binding Inspector.AvailableFontSizes}"
                                                  SelectedItem="{Binding Inspector.SelectedFontSize, Mode=TwoWay}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="2">
                                        <Button Classes="mini-tool-btn" Classes.active="{Binding Inspector.TextElement.IsBold, FallbackValue=False}" Command="{Binding Inspector.ToggleBoldCommand}" ToolTip.Tip="Bold">
                                            <materialIcons:MaterialIcon Kind="FormatBold" Width="15" Height="15" Foreground="{StaticResource WinTextBrush}" />
                                        </Button>
                                        <Button Classes="mini-tool-btn" Classes.active="{Binding Inspector.TextElement.IsItalic, FallbackValue=False}" Command="{Binding Inspector.ToggleItalicCommand}" ToolTip.Tip="Italic">
                                            <materialIcons:MaterialIcon Kind="FormatItalic" Width="15" Height="15" Foreground="{StaticResource WinTextBrush}" />
                                        </Button>
                                        <Button Classes="mini-tool-btn" Classes.active="{Binding Inspector.TextElement.IsUnderline, FallbackValue=False}" Command="{Binding Inspector.ToggleUnderlineCommand}" ToolTip.Tip="Underline">
                                            <materialIcons:MaterialIcon Kind="FormatUnderline" Width="15" Height="15" Foreground="{StaticResource WinTextBrush}" />
                                        </Button>
                                        <Button Classes="mini-tool-btn" Classes.active="{Binding Inspector.TextElement.IsStrikethrough, FallbackValue=False}" Command="{Binding Inspector.ToggleStrikethroughCommand}" ToolTip.Tip="Strikethrough">
                                            <materialIcons:MaterialIcon Kind="FormatStrikethrough" Width="15" Height="15" Foreground="{StaticResource WinTextBrush}" />
                                        </Button>
                                        <Rectangle Width="1" Height="16" Fill="{StaticResource WinBorderBrush}" Margin="2,0" />
                                        <Button Classes="mini-tool-btn" Command="{Binding Inspector.ToggleBulletsCommand}" ToolTip.Tip="Bullet List">
                                            <materialIcons:MaterialIcon Kind="FormatListBulleted" Width="15" Height="15" Foreground="{StaticResource WinTextBrush}" />
                                        </Button>
                                        <Button Classes="mini-tool-btn" Command="{Binding Inspector.ToggleNumberingCommand}" ToolTip.Tip="Numbered List">
                                            <materialIcons:MaterialIcon Kind="FormatListNumbered" Width="15" Height="15" Foreground="{StaticResource WinTextBrush}" />
                                        </Button>
                                        <Button Classes="mini-tool-btn" Command="{Binding Inspector.TransformTextCaseCommand}" CommandParameter="Upper" ToolTip.Tip="UPPERCASE">
                                            <materialIcons:MaterialIcon Kind="FormatLetterCaseUpper" Width="15" Height="15" Foreground="{StaticResource WinTextBrush}" />
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock Grid.Row="1" Text="Typography" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource WinSubtleBrush}" HorizontalAlignment="Center" Margin="0,3,0,0" LetterSpacing="0.4" />
                            </Grid>

                            <Rectangle Width="1" Height="68" Fill="{StaticResource WinBorderBrush}" VerticalAlignment="Center" Margin="4,0" />

                            <!-- Alignment Suite Group -->
                            <Grid RowDefinitions="*,Auto">
                                <StackPanel Grid.Row="0" VerticalAlignment="Center" Spacing="4" HorizontalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="2">
                                        <Button Classes="mini-tool-btn" Command="{Binding Inspector.AlignLeftCommand}" ToolTip.Tip="Align Page Left Margin">
                                            <materialIcons:MaterialIcon Kind="AlignHorizontalLeft" Width="14" Height="14" Foreground="{StaticResource WinTextBrush}" />
                                        </Button>
                                        <Button Classes="mini-tool-btn" Command="{Binding Inspector.AlignCenterCommand}" ToolTip.Tip="Center Horizontally">
                                            <materialIcons:MaterialIcon Kind="AlignHorizontalCenter" Width="14" Height="14" Foreground="{StaticResource WinTextBrush}" />
                                        </Button>
                                        <Button Classes="mini-tool-btn" Command="{Binding Inspector.AlignRightCommand}" ToolTip.Tip="Align Page Right Margin">
                                            <materialIcons:MaterialIcon Kind="AlignHorizontalRight" Width="14" Height="14" Foreground="{StaticResource WinTextBrush}" />
                                        </Button>
                                        <Button Classes="mini-tool-btn" Command="{Binding Inspector.DistributeHorizontallyCommand}" ToolTip.Tip="Distribute Horizontally">
                                            <materialIcons:MaterialIcon Kind="DistributeHorizontalCenter" Width="14" Height="14" Foreground="{StaticResource WinTextBrush}" />
                                        </Button>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="2">
                                        <Button Classes="mini-tool-btn" Command="{Binding Inspector.AlignTopCommand}" ToolTip.Tip="Align Page Top Margin">
                                            <materialIcons:MaterialIcon Kind="AlignVerticalTop" Width="14" Height="14" Foreground="{StaticResource WinTextBrush}" />
                                        </Button>
                                        <Button Classes="mini-tool-btn" Command="{Binding Inspector.AlignMiddleCommand}" ToolTip.Tip="Center Vertically">
                                            <materialIcons:MaterialIcon Kind="AlignVerticalCenter" Width="14" Height="14" Foreground="{StaticResource WinTextBrush}" />
                                        </Button>
                                        <Button Classes="mini-tool-btn" Command="{Binding Inspector.AlignBottomCommand}" ToolTip.Tip="Align Page Bottom">
                                            <materialIcons:MaterialIcon Kind="AlignVerticalBottom" Width="14" Height="14" Foreground="{StaticResource WinTextBrush}" />
                                        </Button>
                                        <Button Classes="mini-tool-btn" Command="{Binding Inspector.DistributeVerticallyCommand}" ToolTip.Tip="Distribute Vertically">
                                            <materialIcons:MaterialIcon Kind="DistributeVerticalCenter" Width="14" Height="14" Foreground="{StaticResource WinTextBrush}" />
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock Grid.Row="1" Text="Align &amp; Distribute" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource WinSubtleBrush}" HorizontalAlignment="Center" Margin="0,3,0,0" LetterSpacing="0.4" />
                            </Grid>

                            <Rectangle Width="1" Height="68" Fill="{StaticResource WinBorderBrush}" VerticalAlignment="Center" Margin="4,0" />

                            <!-- Search & Measure Group -->
                            <Grid RowDefinitions="*,Auto">
                                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                    <Button Classes="tool-btn" Command="{Binding OpenFindReplaceCommand}" ToolTip.Tip="Interactive Find &amp; Replace (⌘F / Ctrl+F)">
                                        <StackPanel HorizontalAlignment="Center" Spacing="3">
                                            <materialIcons:MaterialIcon Kind="FindReplace" Width="20" Height="20" Foreground="{StaticResource WinAccentBrush}" HorizontalAlignment="Center" />
                                            <TextBlock Text="Find &amp; Replace" FontSize="10" FontWeight="Medium" Foreground="{StaticResource WinTextBrush}" HorizontalAlignment="Center" TextWrapping="NoWrap" />
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="tool-btn" Command="{Binding AddMeasurementElementCommand}" ToolTip.Tip="Add Dimension Measurement Tool">
                                        <StackPanel HorizontalAlignment="Center" Spacing="3">
                                            <materialIcons:MaterialIcon Kind="RulerSquare" Width="20" Height="20" Foreground="#DC2626" HorizontalAlignment="Center" />
                                            <TextBlock Text="Measure" FontSize="10" FontWeight="Medium" Foreground="{StaticResource WinTextBrush}" HorizontalAlignment="Center" TextWrapping="NoWrap" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                                <TextBlock Grid.Row="1" Text="Search &amp; Measure" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource WinSubtleBrush}" HorizontalAlignment="Center" Margin="0,3,0,0" LetterSpacing="0.4" />
                            </Grid>
                        </StackPanel>

                        <!-- ================= TAB: COMMENT (Review & Annotations) ================= -->
                        <StackPanel Orientation="Horizontal" Spacing="6"
                                    IsVisible="{Binding ActiveRibbonTab, Converter={StaticResource EqualityConverter}, ConverterParameter=Comment}">

                            <!-- Markup Tools -->
                            <Grid RowDefinitions="*,Auto">
                                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                    <Button Classes="tool-btn" Command="{Binding AddStickyNoteElementCommand}" ToolTip.Tip="Insert Sticky Review Note (N)">
                                        <StackPanel HorizontalAlignment="Center" Spacing="3">
                                            <materialIcons:MaterialIcon Kind="NoteTextOutline" Width="20" Height="20" Foreground="#D97706" HorizontalAlignment="Center" />
                                            <TextBlock Text="Sticky Note" FontSize="10" FontWeight="Medium" Foreground="{StaticResource WinTextBrush}" HorizontalAlignment="Center" TextWrapping="NoWrap" />
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="tool-btn" Command="{Binding AddCalloutElementCommand}" ToolTip.Tip="Insert Callout Markup Note">
                                        <StackPanel HorizontalAlignment="Center" Spacing="3">
                                            <materialIcons:MaterialIcon Kind="ChatAlertOutline" Width="20" Height="20" Foreground="#0F6CBD" HorizontalAlignment="Center" />
                                            <TextBlock Text="Callout" FontSize="10" FontWeight="Medium" Foreground="{StaticResource WinTextBrush}" HorizontalAlignment="Center" TextWrapping="NoWrap" />
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="tool-btn" Command="{Binding AddRevisionCloudElementCommand}" ToolTip.Tip="Insert Revision Cloud Perimeter">
                                        <StackPanel HorizontalAlignment="Center" Spacing="3">
                                            <materialIcons:MaterialIcon Kind="CloudOutline" Width="20" Height="20" Foreground="#DC2626" HorizontalAlignment="Center" />
                                            <TextBlock Text="Rev Cloud" FontSize="10" FontWeight="Medium" Foreground="{StaticResource WinTextBrush}" HorizontalAlignment="Center" TextWrapping="NoWrap" />
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="tool-btn" Command="{Binding AddMeasurementElementCommand}" ToolTip.Tip="Insert Dimension Measurement">
                                        <StackPanel HorizontalAlignment="Center" Spacing="3">
                                            <materialIcons:MaterialIcon Kind="RulerSquare" Width="20" Height="20" Foreground="#DC2626" HorizontalAlignment="Center" />
                                            <TextBlock Text="Measure" FontSize="10" FontWeight="Medium" Foreground="{StaticResource WinTextBrush}" HorizontalAlignment="Center" TextWrapping="NoWrap" />
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="tool-btn" Command="{Binding AddInkElementCommand}" CommandParameter="true" ToolTip.Tip="Highlighter Stroke (H)">
                                        <StackPanel HorizontalAlignment="Center" Spacing="3">
                                            <materialIcons:MaterialIcon Kind="Marker" Width="20" Height="20" Foreground="#EAB308" HorizontalAlignment="Center" />
                                            <TextBlock Text="Highlight" FontSize="10" FontWeight="Medium" Foreground="{StaticResource WinTextBrush}" HorizontalAlignment="Center" TextWrapping="NoWrap" />
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="tool-btn" Command="{Binding AddInkElementCommand}" CommandParameter="false" ToolTip.Tip="Freehand Pen (D)">
                                        <StackPanel HorizontalAlignment="Center" Spacing="3">
                                            <materialIcons:MaterialIcon Kind="DrawPen" Width="20" Height="20" Foreground="#0F6CBD" HorizontalAlignment="Center" />
                                            <TextBlock Text="Draw Ink" FontSize="10" FontWeight="Medium" Foreground="{StaticResource WinTextBrush}" HorizontalAlignment="Center" TextWrapping="NoWrap" />
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="tool-btn" Command="{Binding OpenCustomStampDialogCommand}" ToolTip.Tip="Custom Stamp Creator">
                                        <StackPanel HorizontalAlignment="Center" Spacing="3">
                                            <materialIcons:MaterialIcon Kind="CertificateOutline" Width="20" Height="20" Foreground="#0F6CBD" HorizontalAlignment="Center" />
                                            <TextBlock Text="Custom Stamp" FontSize="10" FontWeight="Medium" Foreground="{StaticResource WinTextBrush}" HorizontalAlignment="Center" TextWrapping="NoWrap" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                                <TextBlock Grid.Row="1" Text="Markup Tools" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource WinSubtleBrush}" HorizontalAlignment="Center" Margin="0,3,0,0" LetterSpacing="0.4" />
                            </Grid>

                            <Rectangle Width="1" Height="68" Fill="{StaticResource WinBorderBrush}" VerticalAlignment="Center" Margin="4,0" />

                            <!-- Standard Stamps -->
                            <Grid RowDefinitions="*,Auto">
                                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                    <Button Classes="tool-btn" Command="{Binding AddStampElementCommand}" CommandParameter="Approved" ToolTip.Tip="Add 'APPROVED' Stamp">
                                        <StackPanel HorizontalAlignment="Center" Spacing="3">
                                            <materialIcons:MaterialIcon Kind="CheckDecagramOutline" Width="20" Height="20" Foreground="#16A34A" HorizontalAlignment="Center" />
                                            <TextBlock Text="Approved" FontSize="10" FontWeight="Medium" Foreground="{StaticResource WinTextBrush}" HorizontalAlignment="Center" TextWrapping="NoWrap" />
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="tool-btn" Command="{Binding AddStampElementCommand}" CommandParameter="Confidential" ToolTip.Tip="Add 'CONFIDENTIAL' Stamp">
                                        <StackPanel HorizontalAlignment="Center" Spacing="3">
                                            <materialIcons:MaterialIcon Kind="ShieldLockOutline" Width="20" Height="20" Foreground="#DC2626" HorizontalAlignment="Center" />
                                            <TextBlock Text="Confidential" FontSize="10" FontWeight="Medium" Foreground="{StaticResource WinTextBrush}" HorizontalAlignment="Center" TextWrapping="NoWrap" />
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="tool-btn" Command="{Binding ExportCommentsSummaryCommand}" ToolTip.Tip="Export Review Notes to Markdown">
                                        <StackPanel HorizontalAlignment="Center" Spacing="3">
                                            <materialIcons:MaterialIcon Kind="CommentTextMultipleOutline" Width="20" Height="20" Foreground="#0F6CBD" HorizontalAlignment="Center" />
                                            <TextBlock Text="Export Notes" FontSize="10" FontWeight="Medium" Foreground="{StaticResource WinTextBrush}" HorizontalAlignment="Center" TextWrapping="NoWrap" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                                <TextBlock Grid.Row="1" Text="Stamps &amp; Summary" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource WinSubtleBrush}" HorizontalAlignment="Center" Margin="0,3,0,0" LetterSpacing="0.4" />
                            </Grid>
                        </StackPanel>

                        <!-- ================= TAB: INSERT (Visuals, Charts, QR, Barcodes) ================= -->
                        <StackPanel Orientation="Horizontal" Spacing="6"
                                    IsVisible="{Binding ActiveRibbonTab, Converter={StaticResource EqualityConverter}, ConverterParameter=Insert}">

                            <Grid RowDefinitions="*,Auto">
                                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                    <Button Classes="tool-btn" Command="{Binding AddTextElementCommand}" ToolTip.Tip="Insert Text Block">
                                        <StackPanel HorizontalAlignment="Center" Spacing="3">
                                            <materialIcons:MaterialIcon Kind="TextBoxOutline" Width="20" Height="20" Foreground="{StaticResource WinAccentBrush}" HorizontalAlignment="Center" />
                                            <TextBlock Text="Text Box" FontSize="10" FontWeight="Medium" Foreground="{StaticResource WinTextBrush}" HorizontalAlignment="Center" TextWrapping="NoWrap" />
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="tool-btn" Command="{Binding AddImageElementCommand}" ToolTip.Tip="Insert Image from Disk">
                                        <StackPanel HorizontalAlignment="Center" Spacing="3">
                                            <materialIcons:MaterialIcon Kind="ImagePlus" Width="20" Height="20" Foreground="#475569" HorizontalAlignment="Center" />
                                            <TextBlock Text="Image" FontSize="10" FontWeight="Medium" Foreground="{StaticResource WinTextBrush}" HorizontalAlignment="Center" TextWrapping="NoWrap" />
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="tool-btn" Command="{Binding AddQrCodeElementCommand}" ToolTip.Tip="Insert Vector QR Code">
                                        <StackPanel HorizontalAlignment="Center" Spacing="3">
                                            <materialIcons:MaterialIcon Kind="Qrcode" Width="20" Height="20" Foreground="#0F6CBD" HorizontalAlignment="Center" />
                                            <TextBlock Text="QR Code" FontSize="10" FontWeight="Medium" Foreground="{StaticResource WinTextBrush}" HorizontalAlignment="Center" TextWrapping="NoWrap" />
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="tool-btn" Command="{Binding AddBarcodeElementCommand}" ToolTip.Tip="Insert Barcode">
                                        <StackPanel HorizontalAlignment="Center" Spacing="3">
                                            <materialIcons:MaterialIcon Kind="Barcode" Width="20" Height="20" Foreground="#475569" HorizontalAlignment="Center" />
                                            <TextBlock Text="Barcode" FontSize="10" FontWeight="Medium" Foreground="{StaticResource WinTextBrush}" HorizontalAlignment="Center" TextWrapping="NoWrap" />
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="tool-btn" Command="{Binding AddTableElementCommand}" ToolTip.Tip="Insert Table">
                                        <StackPanel HorizontalAlignment="Center" Spacing="3">
                                            <materialIcons:MaterialIcon Kind="TablePlus" Width="20" Height="20" Foreground="#475569" HorizontalAlignment="Center" />
                                            <TextBlock Text="Table" FontSize="10" FontWeight="Medium" Foreground="{StaticResource WinTextBrush}" HorizontalAlignment="Center" TextWrapping="NoWrap" />
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="tool-btn" Command="{Binding AddChartElementCommand}" ToolTip.Tip="Insert Chart">
                                        <StackPanel HorizontalAlignment="Center" Spacing="3">
                                            <materialIcons:MaterialIcon Kind="ChartBar" Width="20" Height="20" Foreground="#475569" HorizontalAlignment="Center" />
                                            <TextBlock Text="Chart" FontSize="10" FontWeight="Medium" Foreground="{StaticResource WinTextBrush}" HorizontalAlignment="Center" TextWrapping="NoWrap" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                                <TextBlock Grid.Row="1" Text="Visual Elements" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource WinSubtleBrush}" HorizontalAlignment="Center" Margin="0,3,0,0" LetterSpacing="0.4" />
                            </Grid>
                        </StackPanel>

                        <!-- ================= TAB: FILL & SIGN ================= -->
                        <StackPanel Orientation="Horizontal" Spacing="6"
                                    IsVisible="{Binding ActiveRibbonTab, Converter={StaticResource EqualityConverter}, ConverterParameter=Sign}">

                            <!-- Signature Studio & Line -->
                            <Grid RowDefinitions="*,Auto">
                                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                    <Button Classes="tool-btn" Command="{Binding OpenSignatureStudioCommand}" ToolTip.Tip="Open Full Digital Signature Studio">
                                        <StackPanel HorizontalAlignment="Center" Spacing="3">
                                            <materialIcons:MaterialIcon Kind="Draw" Width="20" Height="20" Foreground="{StaticResource WinAccentBrush}" HorizontalAlignment="Center" />
                                            <TextBlock Text="Signature Studio" FontSize="10" FontWeight="Medium" Foreground="{StaticResource WinTextBrush}" HorizontalAlignment="Center" TextWrapping="NoWrap" />
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="tool-btn" Command="{Binding AddFormFieldElementCommand}" CommandParameter="Signature" ToolTip.Tip="Insert Interactive Signature Line Field">
                                        <StackPanel HorizontalAlignment="Center" Spacing="3">
                                            <materialIcons:MaterialIcon Kind="SignatureFreehand" Width="20" Height="20" Foreground="#0F6CBD" HorizontalAlignment="Center" />
                                            <TextBlock Text="Signature Line" FontSize="10" FontWeight="Medium" Foreground="{StaticResource WinTextBrush}" HorizontalAlignment="Center" TextWrapping="NoWrap" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                                <TextBlock Grid.Row="1" Text="Signatures" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource WinSubtleBrush}" HorizontalAlignment="Center" Margin="0,3,0,0" LetterSpacing="0.4" />
                            </Grid>

                            <Rectangle Width="1" Height="68" Fill="{StaticResource WinBorderBrush}" VerticalAlignment="Center" Margin="4,0" />

                            <!-- Signer Markup Tools (Date, Initials, Check, Cross) -->
                            <Grid RowDefinitions="*,Auto">
                                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                    <Button Classes="tool-btn" Command="{Binding AddDateStampCommand}" ToolTip.Tip="Stamp Today's Date">
                                        <StackPanel HorizontalAlignment="Center" Spacing="3">
                                            <materialIcons:MaterialIcon Kind="CalendarClockOutline" Width="20" Height="20" Foreground="#475569" HorizontalAlignment="Center" />
                                            <TextBlock Text="Date Stamp" FontSize="10" FontWeight="Medium" Foreground="{StaticResource WinTextBrush}" HorizontalAlignment="Center" TextWrapping="NoWrap" />
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="tool-btn" Command="{Binding AddInitialsBadgeCommand}" CommandParameter="JD" ToolTip.Tip="Stamp Signer Initials">
                                        <StackPanel HorizontalAlignment="Center" Spacing="3">
                                            <materialIcons:MaterialIcon Kind="AccountOutline" Width="20" Height="20" Foreground="#0F6CBD" HorizontalAlignment="Center" />
                                            <TextBlock Text="Initials" FontSize="10" FontWeight="Medium" Foreground="{StaticResource WinTextBrush}" HorizontalAlignment="Center" TextWrapping="NoWrap" />
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="tool-btn" Command="{Binding AddCheckmarkBadgeCommand}" ToolTip.Tip="Stamp Green Checkmark (✓)">
                                        <StackPanel HorizontalAlignment="Center" Spacing="3">
                                            <materialIcons:MaterialIcon Kind="CheckBold" Width="20" Height="20" Foreground="#16A34A" HorizontalAlignment="Center" />
                                            <TextBlock Text="Check (✓)" FontSize="10" FontWeight="Medium" Foreground="{StaticResource WinTextBrush}" HorizontalAlignment="Center" TextWrapping="NoWrap" />
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="tool-btn" Command="{Binding AddCrossBadgeCommand}" ToolTip.Tip="Stamp Red Cross (✕)">
                                        <StackPanel HorizontalAlignment="Center" Spacing="3">
                                            <materialIcons:MaterialIcon Kind="CloseThick" Width="20" Height="20" Foreground="#DC2626" HorizontalAlignment="Center" />
                                            <TextBlock Text="Cross (✕)" FontSize="10" FontWeight="Medium" Foreground="{StaticResource WinTextBrush}" HorizontalAlignment="Center" TextWrapping="NoWrap" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                                <TextBlock Grid.Row="1" Text="Signer Markups" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource WinSubtleBrush}" HorizontalAlignment="Center" Margin="0,3,0,0" LetterSpacing="0.4" />
                            </Grid>
                        </StackPanel>

                        <!-- ================= TAB: FORMS (AcroForms Interactive Suite) ================= -->
                        <StackPanel Orientation="Horizontal" Spacing="6"
                                    IsVisible="{Binding ActiveRibbonTab, Converter={StaticResource EqualityConverter}, ConverterParameter=Forms}">

                            <Grid RowDefinitions="*,Auto">
                                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                    <Button Classes="tool-btn" Command="{Binding AddFormFieldElementCommand}" CommandParameter="Text" ToolTip.Tip="Insert Text Input Field">
                                        <StackPanel HorizontalAlignment="Center" Spacing="3">
                                            <materialIcons:MaterialIcon Kind="FormTextbox" Width="20" Height="20" Foreground="{StaticResource WinAccentBrush}" HorizontalAlignment="Center" />
                                            <TextBlock Text="Text Field" FontSize="10" FontWeight="Medium" Foreground="{StaticResource WinTextBrush}" HorizontalAlignment="Center" TextWrapping="NoWrap" />
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="tool-btn" Command="{Binding AddFormFieldElementCommand}" CommandParameter="Checkbox" ToolTip.Tip="Insert Checkbox">
                                        <StackPanel HorizontalAlignment="Center" Spacing="3">
                                            <materialIcons:MaterialIcon Kind="CheckboxMarkedOutline" Width="20" Height="20" Foreground="#16A34A" HorizontalAlignment="Center" />
                                            <TextBlock Text="Checkbox" FontSize="10" FontWeight="Medium" Foreground="{StaticResource WinTextBrush}" HorizontalAlignment="Center" TextWrapping="NoWrap" />
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="tool-btn" Command="{Binding AddFormFieldElementCommand}" CommandParameter="Radio" ToolTip.Tip="Insert Radio Option">
                                        <StackPanel HorizontalAlignment="Center" Spacing="3">
                                            <materialIcons:MaterialIcon Kind="RadioboxMarked" Width="20" Height="20" Foreground="#0F6CBD" HorizontalAlignment="Center" />
                                            <TextBlock Text="Radio" FontSize="10" FontWeight="Medium" Foreground="{StaticResource WinTextBrush}" HorizontalAlignment="Center" TextWrapping="NoWrap" />
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="tool-btn" Command="{Binding AddFormFieldElementCommand}" CommandParameter="Dropdown" ToolTip.Tip="Insert Dropdown List">
                                        <StackPanel HorizontalAlignment="Center" Spacing="3">
                                            <materialIcons:MaterialIcon Kind="FormDropdown" Width="20" Height="20" Foreground="#7C3AED" HorizontalAlignment="Center" />
                                            <TextBlock Text="Dropdown" FontSize="10" FontWeight="Medium" Foreground="{StaticResource WinTextBrush}" HorizontalAlignment="Center" TextWrapping="NoWrap" />
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="tool-btn" Command="{Binding AddFormFieldElementCommand}" CommandParameter="DatePicker" ToolTip.Tip="Insert Date Picker Field">
                                        <StackPanel HorizontalAlignment="Center" Spacing="3">
                                            <materialIcons:MaterialIcon Kind="CalendarMonthOutline" Width="20" Height="20" Foreground="#0F6CBD" HorizontalAlignment="Center" />
                                            <TextBlock Text="Date Picker" FontSize="10" FontWeight="Medium" Foreground="{StaticResource WinTextBrush}" HorizontalAlignment="Center" TextWrapping="NoWrap" />
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="tool-btn" Command="{Binding AddFormFieldElementCommand}" CommandParameter="Number" ToolTip.Tip="Insert Numeric Currency Field">
                                        <StackPanel HorizontalAlignment="Center" Spacing="3">
                                            <materialIcons:MaterialIcon Kind="Numeric" Width="20" Height="20" Foreground="#0F6CBD" HorizontalAlignment="Center" />
                                            <TextBlock Text="Number" FontSize="10" FontWeight="Medium" Foreground="{StaticResource WinTextBrush}" HorizontalAlignment="Center" TextWrapping="NoWrap" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                                <TextBlock Grid.Row="1" Text="AcroForm Fields" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource WinSubtleBrush}" HorizontalAlignment="Center" Margin="0,3,0,0" LetterSpacing="0.4" />
                            </Grid>
                        </StackPanel>

                        <!-- ================= TAB: ORGANIZE (Pages, Headers/Footers, Watermarks) ================= -->
                        <StackPanel Orientation="Horizontal" Spacing="6"
                                    IsVisible="{Binding ActiveRibbonTab, Converter={StaticResource EqualityConverter}, ConverterParameter=Organize}">

                            <Grid RowDefinitions="*,Auto">
                                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                    <Button Classes="tool-btn" Command="{Binding AddPageCommand}" ToolTip.Tip="Insert Blank Page">
                                        <StackPanel HorizontalAlignment="Center" Spacing="3">
                                            <materialIcons:MaterialIcon Kind="FilePlusOutline" Width="20" Height="20" Foreground="#475569" HorizontalAlignment="Center" />
                                            <TextBlock Text="Add Page" FontSize="10" FontWeight="Medium" Foreground="{StaticResource WinTextBrush}" HorizontalAlignment="Center" TextWrapping="NoWrap" />
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="tool-btn" Command="{Binding DuplicateCurrentPageCommand}" ToolTip.Tip="Duplicate Current Page">
                                        <StackPanel HorizontalAlignment="Center" Spacing="3">
                                            <materialIcons:MaterialIcon Kind="ContentDuplicate" Width="20" Height="20" Foreground="#475569" HorizontalAlignment="Center" />
                                            <TextBlock Text="Duplicate" FontSize="10" FontWeight="Medium" Foreground="{StaticResource WinTextBrush}" HorizontalAlignment="Center" TextWrapping="NoWrap" />
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="tool-btn" Command="{Binding RotateCurrentPageCommand}" ToolTip.Tip="Rotate Page 90° Clockwise">
                                        <StackPanel HorizontalAlignment="Center" Spacing="3">
                                            <materialIcons:MaterialIcon Kind="RotateRight" Width="20" Height="20" Foreground="#475569" HorizontalAlignment="Center" />
                                            <TextBlock Text="Rotate 90°" FontSize="10" FontWeight="Medium" Foreground="{StaticResource WinTextBrush}" HorizontalAlignment="Center" TextWrapping="NoWrap" />
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="tool-btn" Command="{Binding BatchRotatePagesCommand}" CommandParameter="all" ToolTip.Tip="Rotate All Pages 90° CW">
                                        <StackPanel HorizontalAlignment="Center" Spacing="3">
                                            <materialIcons:MaterialIcon Kind="Rotate3dVariant" Width="20" Height="20" Foreground="#0F6CBD" HorizontalAlignment="Center" />
                                            <TextBlock Text="Rotate All" FontSize="10" FontWeight="Medium" Foreground="{StaticResource WinTextBrush}" HorizontalAlignment="Center" TextWrapping="NoWrap" />
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="tool-btn" Command="{Binding MovePageUpCommand}" ToolTip.Tip="Move Active Page Up">
                                        <StackPanel HorizontalAlignment="Center" Spacing="3">
                                            <materialIcons:MaterialIcon Kind="ArrowUpBold" Width="20" Height="20" Foreground="#475569" HorizontalAlignment="Center" />
                                            <TextBlock Text="Move Up" FontSize="10" FontWeight="Medium" Foreground="{StaticResource WinTextBrush}" HorizontalAlignment="Center" TextWrapping="NoWrap" />
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="tool-btn" Command="{Binding MovePageDownCommand}" ToolTip.Tip="Move Active Page Down">
                                        <StackPanel HorizontalAlignment="Center" Spacing="3">
                                            <materialIcons:MaterialIcon Kind="ArrowDownBold" Width="20" Height="20" Foreground="#475569" HorizontalAlignment="Center" />
                                            <TextBlock Text="Move Down" FontSize="10" FontWeight="Medium" Foreground="{StaticResource WinTextBrush}" HorizontalAlignment="Center" TextWrapping="NoWrap" />
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="tool-btn" Command="{Binding DeleteCurrentPageCommand}" ToolTip.Tip="Delete Current Page">
                                        <StackPanel HorizontalAlignment="Center" Spacing="3">
                                            <materialIcons:MaterialIcon Kind="DeleteOutline" Width="20" Height="20" Foreground="{StaticResource WinDangerBrush}" HorizontalAlignment="Center" />
                                            <TextBlock Text="Delete" FontSize="10" FontWeight="Medium" Foreground="{StaticResource WinDangerBrush}" HorizontalAlignment="Center" TextWrapping="NoWrap" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                                <TextBlock Grid.Row="1" Text="Page Operations" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource WinSubtleBrush}" HorizontalAlignment="Center" Margin="0,3,0,0" LetterSpacing="0.4" />
                            </Grid>

                            <Rectangle Width="1" Height="68" Fill="{StaticResource WinBorderBrush}" VerticalAlignment="Center" Margin="4,0" />

                            <!-- Split & Extract Tools -->
                            <Grid RowDefinitions="*,Auto">
                                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                    <Button Classes="tool-btn" Command="{Binding OpenSplitExtractDialogCommand}" ToolTip.Tip="Split / Extract Document Pages">
                                        <StackPanel HorizontalAlignment="Center" Spacing="3">
                                            <materialIcons:MaterialIcon Kind="CallSplit" Width="20" Height="20" Foreground="#0F6CBD" HorizontalAlignment="Center" />
                                            <TextBlock Text="Split / Extract" FontSize="10" FontWeight="Medium" Foreground="{StaticResource WinTextBrush}" HorizontalAlignment="Center" TextWrapping="NoWrap" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                                <TextBlock Grid.Row="1" Text="Partition" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource WinSubtleBrush}" HorizontalAlignment="Center" Margin="0,3,0,0" LetterSpacing="0.4" />
                            </Grid>

                            <Rectangle Width="1" Height="68" Fill="{StaticResource WinBorderBrush}" VerticalAlignment="Center" Margin="4,0" />

                            <!-- Header/Footer & Watermark Group -->
                            <Grid RowDefinitions="*,Auto">
                                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                    <Button Classes="tool-btn" Command="{Binding OpenHeaderFooterDialogCommand}" ToolTip.Tip="Header &amp; Footer Layout Studio">
                                        <StackPanel HorizontalAlignment="Center" Spacing="3">
                                            <materialIcons:MaterialIcon Kind="PageLayoutHeaderFooter" Width="20" Height="20" Foreground="#0F6CBD" HorizontalAlignment="Center" />
                                            <TextBlock Text="Header &amp; Footer" FontSize="10" FontWeight="Medium" Foreground="{StaticResource WinTextBrush}" HorizontalAlignment="Center" TextWrapping="NoWrap" />
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="tool-btn" Command="{Binding OpenWatermarkManagerCommand}" ToolTip.Tip="Watermark Studio">
                                        <StackPanel HorizontalAlignment="Center" Spacing="3">
                                            <materialIcons:MaterialIcon Kind="Watermark" Width="20" Height="20" Foreground="#DC2626" HorizontalAlignment="Center" />
                                            <TextBlock Text="Watermark" FontSize="10" FontWeight="Medium" Foreground="{StaticResource WinTextBrush}" HorizontalAlignment="Center" TextWrapping="NoWrap" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                                <TextBlock Grid.Row="1" Text="Layout &amp; Stamps" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource WinSubtleBrush}" HorizontalAlignment="Center" Margin="0,3,0,0" LetterSpacing="0.4" />
                            </Grid>
                        </StackPanel>

                        <!-- ================= TAB: PROTECT & REDACT ================= -->
                        <StackPanel Orientation="Horizontal" Spacing="6"
                                    IsVisible="{Binding ActiveRibbonTab, Converter={StaticResource EqualityConverter}, ConverterParameter=Protect}">

                            <!-- Security & Sanitization -->
                            <Grid RowDefinitions="*,Auto">
                                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                    <Button Classes="tool-btn" Command="{Binding OpenSecurityDialogCommand}" ToolTip.Tip="Document Security, Passwords &amp; Permissions">
                                        <StackPanel HorizontalAlignment="Center" Spacing="3">
                                            <materialIcons:MaterialIcon Kind="ShieldLockOutline" Width="20" Height="20" Foreground="{StaticResource WinDangerBrush}" HorizontalAlignment="Center" />
                                            <TextBlock Text="Protect PDF" FontSize="10" FontWeight="Medium" Foreground="{StaticResource WinTextBrush}" HorizontalAlignment="Center" TextWrapping="NoWrap" />
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="tool-btn" Command="{Binding SanitizeDocumentCommand}" ToolTip.Tip="Sanitize Document (Scrub Metadata &amp; Internal Notes)">
                                        <StackPanel HorizontalAlignment="Center" Spacing="3">
                                            <materialIcons:MaterialIcon Kind="ShieldCheck" Width="20" Height="20" Foreground="{StaticResource WinAccentBrush}" HorizontalAlignment="Center" />
                                            <TextBlock Text="Sanitize" FontSize="10" FontWeight="Medium" Foreground="{StaticResource WinTextBrush}" HorizontalAlignment="Center" TextWrapping="NoWrap" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                                <TextBlock Grid.Row="1" Text="Security" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource WinSubtleBrush}" HorizontalAlignment="Center" Margin="0,3,0,0" LetterSpacing="0.4" />
                            </Grid>

                            <Rectangle Width="1" Height="68" Fill="{StaticResource WinBorderBrush}" VerticalAlignment="Center" Margin="4,0" />

                            <!-- Legal Redaction Suite -->
                            <Grid RowDefinitions="*,Auto">
                                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                    <Button Classes="tool-btn" Command="{Binding AddRedactionElementCommand}" CommandParameter="[REDACTED]" ToolTip.Tip="Insert FOIA Redaction Box">
                                        <StackPanel HorizontalAlignment="Center" Spacing="3">
                                            <materialIcons:MaterialIcon Kind="EyeOffOutline" Width="20" Height="20" Foreground="#0F172A" HorizontalAlignment="Center" />
                                            <TextBlock Text="Redact Box" FontSize="10" FontWeight="Medium" Foreground="{StaticResource WinTextBrush}" HorizontalAlignment="Center" TextWrapping="NoWrap" />
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="tool-btn" Command="{Binding OpenSearchRedactDialogCommand}" ToolTip.Tip="Search &amp; Redact Privacy Suite">
                                        <StackPanel HorizontalAlignment="Center" Spacing="3">
                                            <materialIcons:MaterialIcon Kind="DatabaseSearchOutline" Width="20" Height="20" Foreground="#0F6CBD" HorizontalAlignment="Center" />
                                            <TextBlock Text="Search &amp; Redact" FontSize="10" FontWeight="Medium" Foreground="{StaticResource WinTextBrush}" HorizontalAlignment="Center" TextWrapping="NoWrap" />
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="tool-btn" Command="{Binding BurnInAllRedactionsCommand}" ToolTip.Tip="Burn In All Redactions Permanently">
                                        <StackPanel HorizontalAlignment="Center" Spacing="3">
                                            <materialIcons:MaterialIcon Kind="ShieldCheckOutline" Width="20" Height="20" Foreground="#DC2626" HorizontalAlignment="Center" />
                                            <TextBlock Text="Burn In Redactions" FontSize="10" FontWeight="Medium" Foreground="{StaticResource WinTextBrush}" HorizontalAlignment="Center" TextWrapping="NoWrap" />
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="tool-btn" Command="{Binding OpenBatesNumberingDialogCommand}" ToolTip.Tip="Legal Bates Numbering Studio">
                                        <StackPanel HorizontalAlignment="Center" Spacing="3">
                                            <materialIcons:MaterialIcon Kind="Numeric" Width="20" Height="20" Foreground="#0F6CBD" HorizontalAlignment="Center" />
                                            <TextBlock Text="Bates Studio" FontSize="10" FontWeight="Medium" Foreground="{StaticResource WinTextBrush}" HorizontalAlignment="Center" TextWrapping="NoWrap" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                                <TextBlock Grid.Row="1" Text="Legal &amp; Privacy" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource WinSubtleBrush}" HorizontalAlignment="Center" Margin="0,3,0,0" LetterSpacing="0.4" />
                            </Grid>
                        </StackPanel>

                        <!-- ================= TAB: PREFLIGHT & GUIDES ================= -->
                        <StackPanel Orientation="Horizontal" Spacing="6"
                                    IsVisible="{Binding ActiveRibbonTab, Converter={StaticResource EqualityConverter}, ConverterParameter=Audit}">

                            <!-- Preflight Diagnostics -->
                            <Grid RowDefinitions="*,Auto">
                                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                    <Button Classes="tool-btn" Command="{Binding OpenPreflightDialogCommand}" ToolTip.Tip="Run Preflight Health Check &amp; Compliance Audit">
                                        <StackPanel HorizontalAlignment="Center" Spacing="3">
                                            <materialIcons:MaterialIcon Kind="FileCheckOutline" Width="20" Height="20" Foreground="{StaticResource WinSuccessBrush}" HorizontalAlignment="Center" />
                                            <TextBlock Text="Preflight Audit" FontSize="10" FontWeight="Medium" Foreground="{StaticResource WinTextBrush}" HorizontalAlignment="Center" TextWrapping="NoWrap" />
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="tool-btn" Command="{Binding OpenCompareDialogCommand}" ToolTip.Tip="Document Comparison &amp; Visual Diff Matrix">
                                        <StackPanel HorizontalAlignment="Center" Spacing="3">
                                            <materialIcons:MaterialIcon Kind="FileCompare" Width="20" Height="20" Foreground="#0F6CBD" HorizontalAlignment="Center" />
                                            <TextBlock Text="Compare Diff" FontSize="10" FontWeight="Medium" Foreground="{StaticResource WinTextBrush}" HorizontalAlignment="Center" TextWrapping="NoWrap" />
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="tool-btn" Command="{Binding ExportPreflightReportCommand}" ToolTip.Tip="Export Preflight Report">
                                        <StackPanel HorizontalAlignment="Center" Spacing="3">
                                            <materialIcons:MaterialIcon Kind="DownloadOutline" Width="20" Height="20" Foreground="#475569" HorizontalAlignment="Center" />
                                            <TextBlock Text="Save Report" FontSize="10" FontWeight="Medium" Foreground="{StaticResource WinTextBrush}" HorizontalAlignment="Center" TextWrapping="NoWrap" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                                <TextBlock Grid.Row="1" Text="Compliance &amp; Diff" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource WinSubtleBrush}" HorizontalAlignment="Center" Margin="0,3,0,0" LetterSpacing="0.4" />
                            </Grid>

                            <Rectangle Width="1" Height="68" Fill="{StaticResource WinBorderBrush}" VerticalAlignment="Center" Margin="4,0" />

                            <!-- Canvas Guides & Grid -->
                            <Grid RowDefinitions="*,Auto">
                                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                    <Button Classes="tool-btn" Command="{Binding ToggleRulersCommand}" ToolTip.Tip="Toggle Canvas Rulers (⌘R / Ctrl+R)">
                                        <StackPanel HorizontalAlignment="Center" Spacing="3">
                                            <materialIcons:MaterialIcon Kind="Ruler" Width="20" Height="20" Foreground="#0F6CBD" HorizontalAlignment="Center" />
                                            <TextBlock Text="Rulers" FontSize="10" FontWeight="Medium" Foreground="{StaticResource WinTextBrush}" HorizontalAlignment="Center" TextWrapping="NoWrap" />
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="tool-btn" Command="{Binding ToggleGridCommand}" ToolTip.Tip="Toggle Visual Grid Dots">
                                        <StackPanel HorizontalAlignment="Center" Spacing="3">
                                            <materialIcons:MaterialIcon Kind="Grid" Width="20" Height="20" Foreground="#475569" HorizontalAlignment="Center" />
                                            <TextBlock Text="Show Grid" FontSize="10" FontWeight="Medium" Foreground="{StaticResource WinTextBrush}" HorizontalAlignment="Center" TextWrapping="NoWrap" />
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="tool-btn" Command="{Binding ToggleSnapToGridCommand}" ToolTip.Tip="Snap-to-Grid Movement">
                                        <StackPanel HorizontalAlignment="Center" Spacing="3">
                                            <materialIcons:MaterialIcon Kind="Magnet" Width="20" Height="20" Foreground="{StaticResource WinAccentBrush}" HorizontalAlignment="Center" />
                                            <TextBlock Text="Snap to Grid" FontSize="10" FontWeight="Medium" Foreground="{StaticResource WinTextBrush}" HorizontalAlignment="Center" TextWrapping="NoWrap" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                                <TextBlock Grid.Row="1" Text="Canvas Guides" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource WinSubtleBrush}" HorizontalAlignment="Center" Margin="0,3,0,0" LetterSpacing="0.4" />
                            </Grid>

                            <Rectangle Width="1" Height="68" Fill="{StaticResource WinBorderBrush}" VerticalAlignment="Center" Margin="4,0" />

                            <!-- Presentation & Workspace -->
                            <Grid RowDefinitions="*,Auto">
                                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                    <Button Classes="tool-btn" Command="{Binding TogglePresentationModeCommand}" ToolTip.Tip="Full-Screen Read / Presentation Mode (F5 / F11)">
                                        <StackPanel HorizontalAlignment="Center" Spacing="3">
                                            <materialIcons:MaterialIcon Kind="Presentation" Width="20" Height="20" Foreground="#7C3AED" HorizontalAlignment="Center" />
                                            <TextBlock Text="Present" FontSize="10" FontWeight="Medium" Foreground="{StaticResource WinTextBrush}" HorizontalAlignment="Center" TextWrapping="NoWrap" />
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="tool-btn" Command="{Binding ToggleThemeCommand}" ToolTip.Tip="Toggle Dark / Light Workspace Theme">
                                        <StackPanel HorizontalAlignment="Center" Spacing="3">
                                            <materialIcons:MaterialIcon Kind="ThemeLightDark" Width="20" Height="20" Foreground="#0F6CBD" HorizontalAlignment="Center" />
                                            <TextBlock Text="Theme" FontSize="10" FontWeight="Medium" Foreground="{StaticResource WinTextBrush}" HorizontalAlignment="Center" TextWrapping="NoWrap" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                                <TextBlock Grid.Row="1" Text="View Mode" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource WinSubtleBrush}" HorizontalAlignment="Center" Margin="0,3,0,0" LetterSpacing="0.4" />
                            </Grid>

                            <Rectangle Width="1" Height="68" Fill="{StaticResource WinBorderBrush}" VerticalAlignment="Center" Margin="4,0" />

                            <!-- Support & About Group -->
                            <Grid RowDefinitions="*,Auto">
                                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                    <Button Classes="tool-btn" Command="{Binding OpenAboutDialogCommand}" ToolTip.Tip="About FryPDF &amp; CodeFryDev Support">
                                        <StackPanel HorizontalAlignment="Center" Spacing="3">
                                            <materialIcons:MaterialIcon Kind="InformationOutline" Width="20" Height="20" Foreground="{StaticResource WinAccentBrush}" HorizontalAlignment="Center" />
                                            <TextBlock Text="About &amp; Help" FontSize="10" FontWeight="Medium" Foreground="{StaticResource WinTextBrush}" HorizontalAlignment="Center" TextWrapping="NoWrap" />
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="tool-btn" Command="{Binding OpenShortcutsHelpCommand}" ToolTip.Tip="Keyboard Shortcuts Reference (F1)">
                                        <StackPanel HorizontalAlignment="Center" Spacing="3">
                                            <materialIcons:MaterialIcon Kind="KeyboardOutline" Width="20" Height="20" Foreground="#475569" HorizontalAlignment="Center" />
                                            <TextBlock Text="Shortcuts" FontSize="10" FontWeight="Medium" Foreground="{StaticResource WinTextBrush}" HorizontalAlignment="Center" TextWrapping="NoWrap" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                                <TextBlock Grid.Row="1" Text="Support" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource WinSubtleBrush}" HorizontalAlignment="Center" Margin="0,3,0,0" LetterSpacing="0.4" />
                            </Grid>
                        </StackPanel>

                        <!-- ================= TAB: EXPORT ================= -->
                        <StackPanel Orientation="Horizontal" Spacing="6"
                                    IsVisible="{Binding ActiveRibbonTab, Converter={StaticResource EqualityConverter}, ConverterParameter=Export}">

                            <Grid RowDefinitions="*,Auto">
                                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <Button Classes="accent-btn" Height="36" Padding="14,6" Command="{Binding ExportPdfCommand}" ToolTip.Tip="Compile High-Fidelity PDF Document">
                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <materialIcons:MaterialIcon Kind="FilePdfBox" Width="20" Height="20" Foreground="White" VerticalAlignment="Center" />
                                            <TextBlock Text="Compile PDF" FontWeight="SemiBold" FontSize="12.5" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                                <TextBlock Grid.Row="1" Text="PDF Engine" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource WinSubtleBrush}" HorizontalAlignment="Center" Margin="0,3,0,0" LetterSpacing="0.4" />
                            </Grid>

                            <Rectangle Width="1" Height="68" Fill="{StaticResource WinBorderBrush}" VerticalAlignment="Center" Margin="4,0" />

                            <Grid RowDefinitions="*,Auto">
                                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <Button Classes="secondary-btn" Height="34" Padding="12,6" Command="{Binding SaveProjectCommand}" ToolTip.Tip="Save Document Project (.frypdf)">
                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <materialIcons:MaterialIcon Kind="ContentSaveOutline" Width="16" Height="16" Foreground="{StaticResource WinMutedBrush}" VerticalAlignment="Center" />
                                            <TextBlock Text="Save Project (.frypdf)" FontSize="12" FontWeight="Medium" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="secondary-btn" Height="34" Padding="12,6" Command="{Binding OpenProjectCommand}" ToolTip.Tip="Open Project (.frypdf)">
                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <materialIcons:MaterialIcon Kind="FolderOpenOutline" Width="16" Height="16" Foreground="{StaticResource WinMutedBrush}" VerticalAlignment="Center" />
                                            <TextBlock Text="Open Project" FontSize="12" FontWeight="Medium" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                                <TextBlock Grid.Row="1" Text="Project Files" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource WinSubtleBrush}" HorizontalAlignment="Center" Margin="0,3,0,0" LetterSpacing="0.4" />
                            </Grid>
                        </StackPanel>

                    </Panel>
                </ScrollViewer>
            </Border>

        </Grid>
    </Border>
</UserControl>
