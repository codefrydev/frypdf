<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PdfEditorApp.ViewModels.Tools"
             xmlns:models="using:PdfEditorApp.Models"
             xmlns:converters="using:PdfEditorApp.Converters"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="PdfEditorApp.Views.PdfToolPageView"
             x:DataType="vm:PdfToolViewModelBase"
             Background="#F8FAFC">

    <UserControl.Resources>
        <converters:HexToBrushConverter x:Key="HexToBrushConverter" />
        <converters:EqualityToBooleanConverter x:Key="EqualityConverter" />
    </UserControl.Resources>

    <UserControl.Styles>
        <!-- Back Button Hover Style -->
        <Style Selector="Button.back-btn">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="#475569" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15" />
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
                    <BrushTransition Property="Foreground" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.back-btn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#EFF6FF" />
            <Setter Property="BorderBrush" Value="#3B82F6" />
            <Setter Property="Foreground" Value="#1D4ED8" />
        </Style>

        <!-- Star Button Style -->
        <Style Selector="Button.star-btn">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="9,7" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15" />
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.star-btn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#FFFBEB" />
            <Setter Property="BorderBrush" Value="#FDE68A" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*">

        <!-- 1. Top Navigation & Header Banner -->
        <Border Grid.Row="0"
                Background="#FFFFFF"
                BorderBrush="#E2E8F0"
                BorderThickness="0,0,0,1"
                Padding="28,18">
            <Grid ColumnDefinitions="Auto,*,Auto">

                <!-- Left: Back Button & Tool Identification -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                    <Button Classes="back-btn" Command="{Binding GoBackCommand}" ToolTip.Tip="Back to All Tools (Home)">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <materialIcons:MaterialIcon Kind="ArrowLeft" Width="16" Height="16" Foreground="#3B82F6" />
                            <TextBlock Text="Back to Tools" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Rectangle Width="1" Height="28" Fill="#E2E8F0" />

                    <!-- Tool Large Icon Badge -->
                    <Border Width="48" Height="48"
                            Background="{Binding Tool.BackgroundAccentHex, Converter={StaticResource HexToBrushConverter}}"
                            CornerRadius="12"
                            BoxShadow="0 2 8 #10000000"
                            VerticalAlignment="Center">
                        <materialIcons:MaterialIcon Kind="{Binding Tool.IconKind}"
                                                    Width="26" Height="26"
                                                    Foreground="{Binding Tool.IconColorHex, Converter={StaticResource HexToBrushConverter}}"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center" />
                    </Border>

                    <!-- Tool Title & Description -->
                    <StackPanel Spacing="2" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Tool.Name}"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="#0F172A" />
                            <Border Background="#F1F5F9" CornerRadius="6" Padding="8,2" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Tool.CategoryDisplayName}" FontSize="11" FontWeight="Medium" Foreground="#64748B" />
                            </Border>
                            <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="6" Padding="6,1" IsVisible="{Binding Tool.IsNew}">
                                <TextBlock Text="NEW" FontSize="10" FontWeight="Bold" Foreground="#0F6CBD" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding Tool.Description}"
                                   FontSize="12.5"
                                   Foreground="#64748B"
                                   MaxWidth="650" />
                    </StackPanel>
                </StackPanel>

                <!-- Right: Quick Info / Status Pill & Star Button -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Button Classes="star-btn" Command="{Binding ToggleStarCommand}" ToolTip.Tip="Toggle Favorite / Starred Tool">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <materialIcons:MaterialIcon Kind="Star" Width="16" Height="16" Foreground="#F59E0B" IsVisible="{Binding IsToolStarred}" />
                            <materialIcons:MaterialIcon Kind="StarOutline" Width="16" Height="16" Foreground="#94A3B8" IsVisible="{Binding !IsToolStarred}" />
                            <TextBlock Text="{Binding IsToolStarred, Converter={StaticResource EqualityConverter}, ConverterParameter=True, StringFormat='Starred'}"
                                       FontSize="12" FontWeight="SemiBold"
                                       Foreground="{Binding IsToolStarred, Converter={StaticResource EqualityConverter}, ConverterParameter=True, StringFormat='#B45309'}"
                                       VerticalAlignment="Center"
                                       IsVisible="{Binding IsToolStarred}" />
                        </StackPanel>
                    </Button>

                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12,6">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <materialIcons:MaterialIcon Kind="ShieldCheckOutline" Width="15" Height="15" Foreground="#16A34A" />
                            <TextBlock Text="Local &amp; Secure · 100% Offline" FontSize="11.5" FontWeight="Medium" Foreground="#334155" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. Dynamic Dedicated Tool View Loaded via ViewLocator -->
        <ContentControl Grid.Row="1" Content="{Binding}" Margin="28,24,28,28" />

    </Grid>
</UserControl>
