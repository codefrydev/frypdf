<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PdfEditorApp.ViewModels.Tools.Security"
             xmlns:converters="using:PdfEditorApp.Converters"
             xmlns:shell="using:PdfEditorApp.Views.Shell"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="PdfEditorApp.Views.Tools.Security.WatermarkToolView"
             x:DataType="vm:WatermarkToolViewModel">

    <UserControl.Resources>
        <converters:HexToBrushConverter x:Key="HexToBrushConverter" />
        <converters:EqualityToBooleanConverter x:Key="EqualityConverter" />
    </UserControl.Resources>

    <shell:PdfToolWorkspaceView>

        <!-- Toolbar primary action -->
        <shell:PdfToolWorkspaceView.ToolbarActionContent>
            <Button Command="{Binding ExecuteToolCommand}" IsEnabled="{Binding !IsRunning}" Background="#9333EA" Foreground="White" CornerRadius="8" Padding="16,8" FontWeight="Bold" FontSize="12.5" Cursor="Hand">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <materialIcons:MaterialIcon Kind="Watermark" Width="15" Height="15" />
                    <TextBlock Text="Apply Watermark" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </shell:PdfToolWorkspaceView.ToolbarActionContent>

        <!-- Sidebar Options tab: status, document selection, live stamp preview, and watermark styling -->
        <shell:PdfToolWorkspaceView.OptionsContent>
            <StackPanel Spacing="16">

                <!-- Error Alert Banner -->
                <Border Background="#FEF2F2" BorderBrush="#FCA5A5" BorderThickness="1" CornerRadius="10" Padding="16,12" IsVisible="{Binding HasError}">
                    <Grid ColumnDefinitions="Auto,*">
                        <materialIcons:MaterialIcon Grid.Column="0" Kind="AlertCircleOutline" Width="22" Height="22" Foreground="#DC2626" Margin="0,0,12,0" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="Watermark Failed" FontSize="13" FontWeight="Bold" Foreground="#991B1B" />
                            <TextBlock Text="{Binding ErrorMessage}" FontSize="12" Foreground="#B91C1C" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Success Banner -->
                <Border Background="#F0FDF4" BorderBrush="#86EFAC" BorderThickness="1" CornerRadius="12" Padding="20,18" BoxShadow="0 4 12 #1016A34A" IsVisible="{Binding IsComplete}">
                    <StackPanel Spacing="14">
                        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                            <Border Width="40" Height="40" Background="#DCFCE7" CornerRadius="10">
                                <materialIcons:MaterialIcon Kind="CheckCircle" Width="24" Height="24" Foreground="#16A34A" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="Watermark Applied Successfully!" FontSize="15" FontWeight="Bold" Foreground="#166534" />
                                <TextBlock Text="{Binding ResultSummaryMessage}" FontSize="12.5" Foreground="#15803D" TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>

                        <WrapPanel Orientation="Horizontal">
                            <Button Command="{Binding OpenOutputFileCommand}" Background="#16A34A" Foreground="White" CornerRadius="8" Padding="14,8" FontSize="12.5" FontWeight="SemiBold" Cursor="Hand" Margin="0,0,8,6">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <materialIcons:MaterialIcon Kind="FileEyeOutline" Width="15" Height="15" />
                                    <TextBlock Text="Open Watermarked PDF" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding OpenOutputFolderCommand}" Background="#DCFCE7" Foreground="#166534" BorderBrush="#86EFAC" BorderThickness="1" CornerRadius="8" Padding="14,8" FontSize="12.5" FontWeight="SemiBold" Cursor="Hand" Margin="0,0,8,6">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <materialIcons:MaterialIcon Kind="FolderOpenOutline" Width="15" Height="15" />
                                    <TextBlock Text="Show in Folder" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding OpenInEditorCommand}" Background="#EFF6FF" Foreground="#0F6CBD" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="8" Padding="14,8" FontSize="12.5" FontWeight="SemiBold" Cursor="Hand" Margin="0,0,8,6">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <materialIcons:MaterialIcon Kind="SquareEditOutline" Width="15" Height="15" />
                                    <TextBlock Text="Edit in FryPDF" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- Processing Card -->
                <Border Background="{DynamicResource WinPanelBrush}" BorderBrush="{DynamicResource WinBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20,16" IsVisible="{Binding IsRunning}">
                    <StackPanel Spacing="12">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource WinTextBrush}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding ProgressPercentage, StringFormat='{}{0:F0}%'}" FontSize="14" FontWeight="Bold" Foreground="#9333EA" VerticalAlignment="Center" />
                        </Grid>
                        <ProgressBar Value="{Binding ProgressPercentage}" Minimum="0" Maximum="100" Height="8" CornerRadius="4" Foreground="#9333EA" Background="{DynamicResource WinHoverBrush}" />
                        <Button Command="{Binding CancelExecutionCommand}" HorizontalAlignment="Right" Background="{DynamicResource WinHoverBrush}" Foreground="{DynamicResource WinMutedBrush}" CornerRadius="6" Padding="12,5" FontSize="11.5" Cursor="Hand">
                            Cancel
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Live Watermark Stamp Preview -->
                <Border Background="{DynamicResource WinPanelBrush}" BorderBrush="{DynamicResource WinBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="14" BoxShadow="0 2 8 #06000000">
                    <StackPanel Spacing="10">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <materialIcons:MaterialIcon Kind="EyeOutline" Width="16" Height="16" Foreground="#9333EA" />
                                <TextBlock Text="Live Stamp Preview" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource WinTextBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                            <Border Background="#FAF5FF" CornerRadius="6" Padding="7,3">
                                <TextBlock Text="Live" FontSize="10.5" FontWeight="SemiBold" Foreground="#9333EA" />
                            </Border>
                        </Grid>

                        <!-- Simulated Page Canvas -->
                        <Border Height="170" Background="{DynamicResource WinInputBgBrush}" BorderBrush="{DynamicResource WinBorderBrush}" BorderThickness="1" CornerRadius="8" HorizontalAlignment="Stretch" ClipToBounds="True">
                            <Panel HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                <!-- Ghost document lines -->
                                <StackPanel Margin="16,14" Spacing="7" Opacity="0.35">
                                    <Rectangle Width="140" Height="8" Fill="#94A3B8" HorizontalAlignment="Left" RadiusX="3" RadiusY="3" />
                                    <Rectangle Width="220" Height="5" Fill="{DynamicResource WinBorderBrush}" HorizontalAlignment="Left" RadiusX="2" RadiusY="2" />
                                    <Rectangle Width="200" Height="5" Fill="{DynamicResource WinBorderBrush}" HorizontalAlignment="Left" RadiusX="2" RadiusY="2" />
                                    <Rectangle Width="210" Height="5" Fill="{DynamicResource WinBorderBrush}" HorizontalAlignment="Left" RadiusX="2" RadiusY="2" />
                                    <Rectangle Width="120" Height="5" Fill="{DynamicResource WinBorderBrush}" HorizontalAlignment="Left" RadiusX="2" RadiusY="2" />
                                    <Rectangle Width="220" Height="5" Fill="{DynamicResource WinBorderBrush}" HorizontalAlignment="Left" RadiusX="2" RadiusY="2" Margin="0,8,0,0" />
                                    <Rectangle Width="190" Height="5" Fill="{DynamicResource WinBorderBrush}" HorizontalAlignment="Left" RadiusX="2" RadiusY="2" />
                                </StackPanel>

                                <!-- Rotated Watermark Text -->
                                <LayoutTransformControl HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <LayoutTransformControl.LayoutTransform>
                                        <RotateTransform Angle="{Binding RotationAngle}" />
                                    </LayoutTransformControl.LayoutTransform>
                                    <Border BorderBrush="{Binding ColorHex, Converter={StaticResource HexToBrushConverter}}"
                                            BorderThickness="2"
                                            CornerRadius="6"
                                            Padding="10,5"
                                            Opacity="{Binding Opacity}">
                                        <TextBlock Text="{Binding WatermarkText}"
                                                   Foreground="{Binding ColorHex, Converter={StaticResource HexToBrushConverter}}"
                                                   FontSize="17"
                                                   FontWeight="Bold"
                                                   TextAlignment="Center" />
                                    </Border>
                                </LayoutTransformControl>
                            </Panel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Dropzone Box -->
                <Border Background="{DynamicResource WinPanelBrush}" BorderBrush="{DynamicResource WinBorderBrush}" BorderThickness="2" CornerRadius="10" Padding="20,26" IsVisible="{Binding !HasSelectedFiles}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                        <Border Width="52" Height="52" Background="#FAF5FF" BorderBrush="#E9D5FF" BorderThickness="1" CornerRadius="14" HorizontalAlignment="Center">
                            <materialIcons:MaterialIcon Kind="Watermark" Width="28" Height="28" Foreground="#9333EA" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Spacing="3" HorizontalAlignment="Center">
                            <TextBlock Text="Select PDF to Watermark" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource WinTextBrush}" HorizontalAlignment="Center" TextAlignment="Center" />
                            <TextBlock Text="Stamp text with precise transparency, angle, and position" FontSize="11.5" Foreground="{DynamicResource WinMutedBrush}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Command="{Binding AddFilesCommand}" Background="#9333EA" Foreground="White" CornerRadius="8" Padding="18,9" FontSize="12.5" FontWeight="SemiBold" HorizontalAlignment="Center" Cursor="Hand">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <materialIcons:MaterialIcon Kind="FolderOpenOutline" Width="15" Height="15" />
                                <TextBlock Text="Select PDF Document" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Document Card -->
                <Border Background="{DynamicResource WinPanelBrush}" BorderBrush="{DynamicResource WinBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14" IsVisible="{Binding HasSelectedFiles}">
                    <StackPanel Spacing="10">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="Document to Stamp" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource WinTextBrush}" VerticalAlignment="Center" />
                            <Button Command="{Binding AddFilesCommand}" Background="#FAF5FF" Foreground="#9333EA" BorderBrush="#E9D5FF" BorderThickness="1" CornerRadius="6" Padding="10,5" FontSize="11" FontWeight="SemiBold" Cursor="Hand">
                                Change File
                            </Button>
                        </Grid>
                        <Border Background="{DynamicResource WinInputBgBrush}" BorderBrush="{DynamicResource WinBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,10">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <Border Grid.Column="0" Width="32" Height="32" Background="#FAF5FF" CornerRadius="8" Margin="0,0,10,0">
                                    <materialIcons:MaterialIcon Kind="FilePdfBox" Width="18" Height="18" Foreground="#9333EA" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Grid.Column="1" Text="{Binding PrimaryInputFile}" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource WinTextBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <Button Grid.Column="2" Command="{Binding ClearFilesCommand}" Background="Transparent" BorderThickness="0" Padding="6" Cursor="Hand">
                                    <materialIcons:MaterialIcon Kind="Close" Width="16" Height="16" Foreground="{DynamicResource WinSubtleBrush}" />
                                </Button>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Watermark styling settings -->
                <StackPanel Spacing="3">
                    <TextBlock Text="Watermark Style" FontSize="14" FontWeight="ExtraBold" Foreground="{DynamicResource WinTextBrush}" />
                    <TextBlock Text="Customize text, opacity, rotation, and position" FontSize="11" Foreground="{DynamicResource WinMutedBrush}" TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Spacing="4">
                    <TextBlock Text="Watermark Text" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource WinMutedBrush}" />
                    <TextBox Text="{Binding WatermarkText}" FontSize="12" />
                </StackPanel>

                <Grid ColumnDefinitions="*,*">
                    <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,6,0">
                        <TextBlock Text="Opacity (0.05 - 1.0)" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource WinMutedBrush}" />
                        <NumericUpDown Value="{Binding Opacity}" Minimum="0.05" Maximum="1.0" Increment="0.05" FormatString="0.00" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="4" Margin="6,0,0,0">
                        <TextBlock Text="Rotation Angle (°)" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource WinMutedBrush}" />
                        <NumericUpDown Value="{Binding RotationAngle}" Minimum="-180" Maximum="180" Increment="15" />
                    </StackPanel>
                </Grid>

                <Grid ColumnDefinitions="*,*">
                    <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,6,0">
                        <TextBlock Text="Color Hex Code" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource WinMutedBrush}" />
                        <TextBox Text="{Binding ColorHex}" FontSize="12" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="4" Margin="6,0,0,0">
                        <TextBlock Text="Font Size (pt)" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource WinMutedBrush}" />
                        <NumericUpDown Value="{Binding FontSize}" Minimum="12" Maximum="140" Increment="4" />
                    </StackPanel>
                </Grid>

                <StackPanel Spacing="6">
                    <TextBlock Text="Stamp Position" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource WinMutedBrush}" />
                    <WrapPanel Orientation="Horizontal">
                        <RadioButton Content="Center" IsChecked="{Binding Position, Converter={StaticResource EqualityConverter}, ConverterParameter=Center}" Margin="0,0,10,6" />
                        <RadioButton Content="Top-Left" IsChecked="{Binding Position, Converter={StaticResource EqualityConverter}, ConverterParameter=TopLeft}" Margin="0,0,10,6" />
                        <RadioButton Content="Top-Right" IsChecked="{Binding Position, Converter={StaticResource EqualityConverter}, ConverterParameter=TopRight}" Margin="0,0,10,6" />
                        <RadioButton Content="Bottom-Center" IsChecked="{Binding Position, Converter={StaticResource EqualityConverter}, ConverterParameter=BottomCenter}" Margin="0,0,10,6" />
                        <RadioButton Content="Tiled Pattern" IsChecked="{Binding Position, Converter={StaticResource EqualityConverter}, ConverterParameter=Tiled}" Margin="0,0,10,6" />
                    </WrapPanel>
                </StackPanel>

            </StackPanel>
        </shell:PdfToolWorkspaceView.OptionsContent>

    </shell:PdfToolWorkspaceView>
</UserControl>
