<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PdfEditorApp.ViewModels"
             xmlns:models="using:PdfEditorApp.Models"
             xmlns:converters="using:PdfEditorApp.Converters"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="PdfEditorApp.Views.LicensingPageView"
             x:DataType="vm:HomeViewModel">

    <UserControl.Resources>
        <converters:HexToBrushConverter x:Key="HexToBrushConverter" />
        <converters:EqualityToBooleanConverter x:Key="EqualityConverter" />
    </UserControl.Resources>

    <UserControl.Styles>
        <!-- Category Filter Pill Style -->
        <Style Selector="Button.category-filter-btn">
            <Setter Property="Background" Value="{DynamicResource WinInputBgBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource WinMutedBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource WinBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="20" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15" />
                    <BrushTransition Property="Foreground" Duration="0:0:0.15" />
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.category-filter-btn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource WinHoverBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource WinTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource WinBorderBrush}" />
        </Style>
        <Style Selector="Button.category-filter-btn.active /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource WinAccentLightBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource WinAccentBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource WinAccentBorderBrush}" />
        </Style>
        <Style Selector="Button.category-filter-btn.active">
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <!-- Library Card Hover Style -->
        <Style Selector="Border.library-card">
            <Setter Property="Background" Value="{DynamicResource WinPanelBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource WinBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="BoxShadow" Value="0 2 8 #08000000" />
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2" Easing="CubicEaseOut" />
                    <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.2" Easing="CubicEaseOut" />
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
                    <BrushTransition Property="Background" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.library-card:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource WinAccentBrush}" />
            <Setter Property="BoxShadow" Value="0 6 20 #120F6CBD" />
            <Setter Property="RenderTransform" Value="translateY(-2px)" />
        </Style>

        <!-- Action Button Style -->
        <Style Selector="Button.card-action-btn">
            <Setter Property="Background" Value="{DynamicResource WinInputBgBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource WinMutedBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource WinBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15" />
                    <BrushTransition Property="Foreground" Duration="0:0:0.15" />
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.card-action-btn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource WinAccentLightBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource WinAccentBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource WinAccentBorderBrush}" />
        </Style>
    </UserControl.Styles>

    <StackPanel Margin="32,24,32,48" Spacing="20">

        <!-- ================================================================= -->
        <!-- 1. TOP HEADER & TITLE ROW                                         -->
        <!-- ================================================================= -->
        <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
            <!-- Left: Icon & Title -->
            <StackPanel Grid.Column="0" Spacing="3">
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Border Width="36" Height="36" Background="#EEF2FF" BorderBrush="#C7D2FE" BorderThickness="1" CornerRadius="8">
                        <materialIcons:MaterialIcon Kind="CertificateOutline" Width="20" Height="20" Foreground="#4F46E5" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Licenses &amp; Third-Party Tools" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource WinTextBrush}" VerticalAlignment="Center" />
                    <Border Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="6" Padding="8,2" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                            <Ellipse Width="6" Height="6" Fill="#10B981" />
                            <TextBlock Text="100% OPEN SOURCE" FontSize="10" FontWeight="Bold" Foreground="#047857" />
                        </StackPanel>
                    </Border>
                </StackPanel>
                <TextBlock Text="Transparency by design: all open-source libraries, document engines, graphics frameworks, and tools used in FryPDF."
                           FontSize="12.5" Foreground="{DynamicResource WinMutedBrush}" Margin="46,0,0,0" />
            </StackPanel>

            <!-- Right: Global Actions -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Command="{Binding CopyFullAttributionsCommand}"
                        Background="{DynamicResource WinInputBgBrush}"
                        BorderBrush="{DynamicResource WinBorderBrush}"
                        BorderThickness="1"
                        Foreground="{DynamicResource WinTextBrush}"
                        CornerRadius="8"
                        Padding="14,8"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Cursor="Hand"
                        ToolTip.Tip="Copy all third-party license notices to clipboard as a formatted text document">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <materialIcons:MaterialIcon Kind="ContentCopy" Width="15" Height="15" Foreground="{DynamicResource WinAccentBrush}" />
                        <TextBlock Text="Copy Full Notice" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button Command="{Binding OpenLibraryWebsiteCommand}"
                        CommandParameter="https://codefrydev.in"
                        Background="{DynamicResource WinAccentBrush}"
                        Foreground="White"
                        CornerRadius="8"
                        Padding="14,8"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Cursor="Hand"
                        ToolTip.Tip="Visit CodeFryDev Developer Portal">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <materialIcons:MaterialIcon Kind="Web" Width="15" Height="15" />
                        <TextBlock Text="codefrydev.in" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ================================================================= -->
        <!-- 2. FRYPDF MAIN PROJECT LICENSE HERO CARD                          -->
        <!-- ================================================================= -->
        <Border Background="{DynamicResource WinPanelBrush}"
                BorderBrush="{DynamicResource WinBorderBrush}"
                BorderThickness="1"
                CornerRadius="14"
                Padding="22,20"
                BoxShadow="0 2 10 #08000000">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <!-- Logo Mark -->
                <Border Grid.Column="0" Width="54" Height="54" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1.5" CornerRadius="{StaticResource M3ShapeCornerFull}" Margin="0,0,18,0" VerticalAlignment="Center" BoxShadow="0 2 10 #150D2B45" ClipToBounds="True">
                    <Viewbox Width="40" Height="40" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Canvas Width="5064" Height="5064">
                            <Path Fill="#0D2B45" Data="M2474 751C2532.5 786.5 2609.5 835.5 2682.5 859.5C2768.74 897.828 2854.61 905.811 2884 925.5C2935.5 960 2964.5 1038.74 3038 1085C3111.5 1131.26 3226 1156 3267 1156.5C3308 1157 3322.5 1124 3356 1128C3389.5 1132 3422.5 1199.5 3431 1251C3439.5 1302.5 3449.5 1442 3417.5 1450.5C3385.5 1459 3252 1403 3164 1391.5C3076 1380 2823 1391.5 2823 1391.5C2823 1391.5 2973 1587.5 3068.5 1626C3164 1664.5 3244.5 1651.5 3257.5 1664.5C3270.5 1677.5 3226.5 1772 3164 1813.5C3101.5 1855 3011 1874.5 2995.5 1864.5C2980 1854.5 2903 1640.5 2742 1630.5C2581 1620.5 2531 1626 2481.5 1607C2432 1588 2370.5 1526 2345.5 1479.5C2320.5 1433 2325 1310 2287.5 1311C2250 1312 1948 1522.5 1927.5 1743C1907 1963.5 1943 2117.5 1968 2220.5C1993 2323.5 2133 2584 2133 2584C2133 2584 1945.5 2439.5 1887 2353C1828.5 2266.5 1747.5 2037 1747.5 2037L1645 2220.5C1645 2220.5 1619 2037 1619 1916C1619 1795 1667 1626 1667 1626C1667 1626 1633 1639 1589.5 1662C1546 1685 1493 1736.5 1493 1736.5C1493 1736.5 1547.5 1549 1615 1457C1682.5 1365 1855.5 1222.5 1855.5 1222.5C1855.5 1222.5 1751.5 1217 1717.5 1215C1683.5 1213 1575 1222.5 1575 1222.5C1575 1222.5 1727.5 1086 1832.5 1045C1937.5 1004 2133 973 2133 973C2133 973 1961 878 1832.5 753C1704 628 1667 353 1667 353C1667 353 1824.5 563.337 1958.5 664C2092.5 764.663 2290.5 822.5 2290.5 822.5C2290.5 822.5 2245.5 757 2203 650C2160.5 543 2158.5 411.5 2158.5 411.5C2158.5 411.5 2415.5 715.5 2474 751Z" />
                            <Path Fill="#1A3D5C" Data="M2291.5 1633C2291.5 1633 2268.5 1913.5 2645.5 2143C3022.5 2372.5 3176.5 2469.5 3337 2716C3497.5 2962.5 3276.5 3592.5 3276.5 3592.5C3276.5 3592.5 3305 3376 3276.5 3111C3248 2846 3028 2641.5 2916 2545C2804 2448.5 2527 2287.5 2437.5 2205.5C2348 2123.5 2273.5 2027.5 2263.5 1917.5C2253.5 1807.5 2291.5 1633 2291.5 1633Z" />
                            <Path Fill="#EE4B32" Data="M3923.5 1249.38C4041 1220.88 4226 1235.38 4240.5 1249.38C4255 1263.38 4188.34 1286.7 4122 1325.38C4063.62 1359.41 4013 1386.88 4013 1386.88C4013 1386.88 4199.5 1427.38 4269 1449.38C4338.5 1471.38 4440 1518.88 4550.5 1515.88C4661 1512.88 4833 1449.38 4833 1449.38C4833 1449.38 4741 1566.38 4601.5 1702.88C4462 1839.38 4132.5 1807.38 4132.5 1807.38C4132.5 1807.38 4177.5 1873.38 4218.5 1895.38C4259.5 1917.38 4338.5 1940.38 4338.5 1940.38C4338.5 1940.38 4153 2032.38 3987 2032.38C3821 2032.38 3695.5 1889.38 3603 1815.38C3510.5 1741.38 3227 1608.38 3227 1586.38C3227 1564.38 3453 1589.54 3597 1515.88C3741 1442.22 3806 1277.88 3923.5 1249.38Z" />
                            <Path Fill="#0D2B45" Data="M4213 2989C4213 3215.14 4168.46 3439.06 4081.92 3647.98C3995.38 3856.9 3868.54 4046.74 3708.64 4206.64C3548.74 4366.54 3358.9 4493.38 3149.98 4579.92C2941.06 4666.46 2717.14 4711 2491 4711C2264.86 4711 2040.94 4666.46 1832.02 4579.92C1623.1 4493.38 1433.26 4366.54 1273.36 4206.64C1113.46 4046.74 986.618 3856.9 900.079 3647.98C813.541 3439.06 769 3215.14 769 2989H1299C1299 3142.65 1329.25 3294.79 1388.02 3436.74C1446.8 3578.69 1532.94 3707.67 1641.54 3816.31C1750.14 3924.96 1879.06 4011.14 2020.95 4069.94C2162.84 4128.74 2314.92 4159 2468.5 4159C2622.08 4159 2774.16 4128.74 2916.05 4069.94C3057.94 4011.14 3186.86 3924.96 3295.46 3816.32C3404.06 3707.67 3490.2 3578.69 3548.98 3436.74C3607.75 3294.79 3638 3142.65 3638 2989H4213Z" />
                            <Path Fill="#7CA2C2" Data="M2654.5 1023.5C2654.5 1023.5 2753.5 1021 2810 1033C2866.5 1045 2920 1126 2920 1126C2920 1126 2872 1139 2847 1140C2822 1141 2757.5 1132.5 2718.5 1111.5C2679.5 1090.5 2654.5 1023.5 2654.5 1023.5Z" />
                        </Canvas>
                    </Viewbox>
                </Border>

                <!-- Information -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <TextBlock Text="FryPDF Desktop Studio" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource WinTextBrush}" />
                        <Border Background="{DynamicResource WinAccentLightBrush}" BorderBrush="{DynamicResource WinAccentBorderBrush}" BorderThickness="1" CornerRadius="5" Padding="6,1.5">
                            <TextBlock Text="v1.0.0" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource WinAccentBrush}" />
                        </Border>
                        <Border Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="5" Padding="6,1.5">
                            <TextBlock Text="MIT License" FontSize="10.5" FontWeight="SemiBold" Foreground="#047857" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Copyright © 2026 Code Fry Dev. All rights reserved." FontSize="12" Foreground="{DynamicResource WinMutedBrush}" />
                    <TextBlock Text="Privacy Guarantee: 100% offline and local document processing. No cloud uploads, telemetry, or user tracking."
                               FontSize="11.5" Foreground="{DynamicResource WinMutedBrush}" />
                </StackPanel>

                <!-- Right Pill & Badges -->
                <Border Grid.Column="2" Background="{DynamicResource WinInputBgBrush}" BorderBrush="{DynamicResource WinBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14,10" VerticalAlignment="Center">
                    <StackPanel Spacing="3" HorizontalAlignment="Center">
                        <materialIcons:MaterialIcon Kind="ShieldCheckOutline" Width="20" Height="20" Foreground="#16A34A" HorizontalAlignment="Center" />
                        <TextBlock Text="Zero Telemetry" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource WinTextBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="100% Local Processing" FontSize="10" Foreground="{DynamicResource WinMutedBrush}" HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ================================================================= -->
        <!-- 3. INTERACTIVE SEARCH & CATEGORY FILTER BAR                       -->
        <!-- ================================================================= -->
        <Border Background="{DynamicResource WinPanelBrush}" BorderBrush="{DynamicResource WinBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16">
            <Grid ColumnDefinitions="Auto,*,Auto">

                <!-- Search Input Box -->
                <Border Grid.Column="0"
                        Background="{DynamicResource WinInputBgBrush}"
                        BorderBrush="{DynamicResource WinBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="20"
                        Padding="12,0"
                        Height="36"
                        Width="320">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <materialIcons:MaterialIcon Grid.Column="0" Kind="Magnify" Width="15" Height="15" Foreground="{DynamicResource WinSubtleBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Grid.Column="1"
                                 Text="{Binding SearchQuery}"
                                 PlaceholderText="Search libraries, maintainers, licenses..."
                                 FontSize="12"
                                 Foreground="{DynamicResource WinTextBrush}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 VerticalAlignment="Center" />
                        <Button Grid.Column="2"
                                Command="{Binding ClearLicenseSearchCommand}"
                                IsVisible="{Binding SearchQuery.Length}"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="3"
                                Cursor="Hand"
                                ToolTip.Tip="Clear search">
                            <materialIcons:MaterialIcon Kind="CloseCircle" Width="14" Height="14" Foreground="{DynamicResource WinSubtleBrush}" />
                        </Button>
                    </Grid>
                </Border>

                <!-- Category Filters (Horizontal Scroll/Wrap) -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" Margin="14,0,0,0" VerticalAlignment="Center">
                    <Button Classes="category-filter-btn"
                            Classes.active="{Binding SelectedLicenseCategory, Converter={StaticResource EqualityConverter}, ConverterParameter=All}"
                            Command="{Binding SetLicenseCategoryCommand}"
                            CommandParameter="All">
                        <TextBlock Text="{Binding AllLicenses.Count, StringFormat='All ({0})'}" />
                    </Button>

                    <Button Classes="category-filter-btn"
                            Classes.active="{Binding SelectedLicenseCategory, Converter={StaticResource EqualityConverter}, ConverterParameter=PDF &amp; Document Engines}"
                            Command="{Binding SetLicenseCategoryCommand}"
                            CommandParameter="PDF &amp; Document Engines"
                            Content="PDF Engines" />

                    <Button Classes="category-filter-btn"
                            Classes.active="{Binding SelectedLicenseCategory, Converter={StaticResource EqualityConverter}, ConverterParameter=UI &amp; Graphics Frameworks}"
                            Command="{Binding SetLicenseCategoryCommand}"
                            CommandParameter="UI &amp; Graphics Frameworks"
                            Content="UI &amp; Graphics" />

                    <Button Classes="category-filter-btn"
                            Classes.active="{Binding SelectedLicenseCategory, Converter={StaticResource EqualityConverter}, ConverterParameter=Office &amp; Data Formats}"
                            Command="{Binding SetLicenseCategoryCommand}"
                            CommandParameter="Office &amp; Data Formats"
                            Content="Office &amp; Data" />

                    <Button Classes="category-filter-btn"
                            Classes.active="{Binding SelectedLicenseCategory, Converter={StaticResource EqualityConverter}, ConverterParameter=Architecture &amp; Runtime}"
                            Command="{Binding SetLicenseCategoryCommand}"
                            CommandParameter="Architecture &amp; Runtime"
                            Content="Runtime &amp; MVVM" />

                    <Button Classes="category-filter-btn"
                            Classes.active="{Binding SelectedLicenseCategory, Converter={StaticResource EqualityConverter}, ConverterParameter=AI &amp; Document Intelligence}"
                            Command="{Binding SetLicenseCategoryCommand}"
                            CommandParameter="AI &amp; Document Intelligence"
                            Content="AI &amp; Intelligence" />

                    <Button Classes="category-filter-btn"
                            Classes.active="{Binding SelectedLicenseCategory, Converter={StaticResource EqualityConverter}, ConverterParameter=Typography &amp; Typefaces}"
                            Command="{Binding SetLicenseCategoryCommand}"
                            CommandParameter="Typography &amp; Typefaces"
                            Content="Typography &amp; Fonts" />
                </StackPanel>

                <!-- Count Badge -->
                <Border Grid.Column="2" Background="{DynamicResource WinInputBgBrush}" CornerRadius="6" Padding="10,5" VerticalAlignment="Center">
                    <TextBlock Text="{Binding MatchingLicensesCount, StringFormat='{}{0} Packages'}"
                               FontSize="11.5"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource WinMutedBrush}" />
                </Border>

            </Grid>
        </Border>

        <!-- ================================================================= -->
        <!-- 4. NO MATCHING LIBRARIES EMPTY STATE                             -->
        <!-- ================================================================= -->
        <Border Background="{DynamicResource WinPanelBrush}" BorderBrush="{DynamicResource WinBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="36" IsVisible="{Binding HasNoMatchingLicenses}">
            <StackPanel HorizontalAlignment="Center" Spacing="10">
                <materialIcons:MaterialIcon Kind="PackageVariantClosed" Width="40" Height="40" Foreground="{DynamicResource WinSubtleBrush}" HorizontalAlignment="Center" />
                <TextBlock Text="No Matching Open-Source Packages" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource WinMutedBrush}" HorizontalAlignment="Center" />
                <TextBlock Text="Try searching for a different keyword such as Avalonia, QuestPDF, MIT, or Apache." FontSize="12.5" Foreground="{DynamicResource WinSubtleBrush}" HorizontalAlignment="Center" />
                <Button Command="{Binding ClearLicenseSearchCommand}"
                        Background="{DynamicResource WinAccentLightBrush}"
                        Foreground="{DynamicResource WinAccentBrush}"
                        CornerRadius="8"
                        Padding="14,6"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Cursor="Hand"
                        HorizontalAlignment="Center"
                        Margin="0,4,0,0">
                    <TextBlock Text="Reset Filters" />
                </Button>
            </StackPanel>
        </Border>

        <!-- ================================================================= -->
        <!-- 5. THIRD-PARTY TOOLS & LIBRARIES REPEAT LIST                      -->
        <!-- ================================================================= -->
        <ItemsControl ItemsSource="{Binding FilteredLicenses}" IsVisible="{Binding !HasNoMatchingLicenses}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Spacing="12" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="models:ThirdPartyToolLicense">
                    <Border Classes="library-card" Padding="18">
                        <Grid RowDefinitions="Auto,Auto">

                            <!-- Top Row: Card Summary & Actions -->
                            <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto">

                                <!-- Package Icon -->
                                <Border Grid.Column="0"
                                        Width="44" Height="44"
                                        Background="{Binding AccentColorHex, Converter={StaticResource HexToBrushConverter}}"
                                        CornerRadius="10"
                                        Margin="0,0,16,0"
                                        VerticalAlignment="Top">
                                    <materialIcons:MaterialIcon Kind="{Binding IconKind}"
                                                                Width="24" Height="24"
                                                                Foreground="White"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center" />
                                </Border>

                                <!-- Center Details -->
                                <StackPanel Grid.Column="1" Spacing="5" VerticalAlignment="Center">
                                    <!-- Title, Version & License Badge -->
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource WinTextBrush}" VerticalAlignment="Center" />

                                        <!-- Version Pill -->
                                        <Border Background="{DynamicResource WinInputBgBrush}" BorderBrush="{DynamicResource WinBorderBrush}" BorderThickness="1" CornerRadius="5" Padding="6,1.5" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Version, StringFormat='v{0}'}" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource WinMutedBrush}" />
                                        </Border>

                                        <!-- License Type Badge -->
                                        <Border Background="{Binding BadgeBackgroundHex, Converter={StaticResource HexToBrushConverter}}"
                                                CornerRadius="5"
                                                Padding="7,1.5"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding LicenseType}"
                                                       FontSize="10.5"
                                                       FontWeight="Bold"
                                                       Foreground="{Binding BadgeColorHex, Converter={StaticResource HexToBrushConverter}}" />
                                        </Border>

                                        <!-- Category Pill -->
                                        <Border Background="{DynamicResource WinInputBgBrush}" BorderBrush="{DynamicResource WinBorderBrush}" BorderThickness="1" CornerRadius="5" Padding="6,1.5" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Category}" FontSize="10.5" Foreground="{DynamicResource WinMutedBrush}" />
                                        </Border>
                                    </StackPanel>

                                    <!-- Purpose / Role in FryPDF -->
                                    <TextBlock Text="{Binding Purpose}" FontSize="12" Foreground="{DynamicResource WinTextBrush}" TextWrapping="Wrap" />

                                    <!-- Maintainer & Repository URL -->
                                    <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center" Margin="0,2,0,0">
                                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                            <materialIcons:MaterialIcon Kind="AccountOutline" Width="13" Height="13" Foreground="{DynamicResource WinSubtleBrush}" />
                                            <TextBlock Text="{Binding Maintainer}" FontSize="11" Foreground="{DynamicResource WinMutedBrush}" />
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                            <materialIcons:MaterialIcon Kind="LinkVariant" Width="13" Height="13" Foreground="{DynamicResource WinSubtleBrush}" />
                                            <TextBlock Text="{Binding ProjectUrl}" FontSize="11" Foreground="{DynamicResource WinAccentBrush}" />
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Right Actions -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Top" Margin="10,0,0,0">
                                    <!-- Toggle License Viewer -->
                                    <Button Classes="card-action-btn"
                                            Command="{Binding $parent[UserControl].((vm:HomeViewModel)DataContext).ToggleLicenseExpandCommand}"
                                            CommandParameter="{Binding}">
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <materialIcons:MaterialIcon Kind="FileDocumentOutline" Width="13" Height="13" />
                                            <TextBlock Text="License Text" VerticalAlignment="Center" />
                                            <materialIcons:MaterialIcon Kind="ChevronDown" Width="13" Height="13" IsVisible="{Binding !IsExpanded}" />
                                            <materialIcons:MaterialIcon Kind="ChevronUp" Width="13" Height="13" IsVisible="{Binding IsExpanded}" />
                                        </StackPanel>
                                    </Button>

                                    <!-- Copy License Action -->
                                    <Button Classes="card-action-btn"
                                            Command="{Binding $parent[UserControl].((vm:HomeViewModel)DataContext).CopyLicenseTextCommand}"
                                            CommandParameter="{Binding}"
                                            ToolTip.Tip="Copy license text to clipboard">
                                        <materialIcons:MaterialIcon Kind="ContentCopy" Width="13" Height="13" />
                                    </Button>

                                    <!-- Open Project Link -->
                                    <Button Classes="card-action-btn"
                                            Command="{Binding $parent[UserControl].((vm:HomeViewModel)DataContext).OpenLibraryWebsiteCommand}"
                                            CommandParameter="{Binding ProjectUrl}"
                                            ToolTip.Tip="Open official project website or repository">
                                        <materialIcons:MaterialIcon Kind="OpenInNew" Width="13" Height="13" />
                                    </Button>
                                </StackPanel>

                            </Grid>

                            <!-- Bottom Row: Expandable Full License Text Drawer -->
                            <Border Grid.Row="1"
                                    Margin="60,14,0,0"
                                    Background="{DynamicResource WinInputBgBrush}"
                                    BorderBrush="{DynamicResource WinBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="14"
                                    IsVisible="{Binding IsExpanded}">
                                <Grid RowDefinitions="Auto,Auto">
                                    <!-- Top Banner inside License Drawer -->
                                    <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,8">
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <materialIcons:MaterialIcon Kind="CodeTags" Width="14" Height="14" Foreground="{DynamicResource WinAccentBrush}" />
                                            <TextBlock Text="{Binding Name, StringFormat='Verbatim License Agreement — {0}'}"
                                                       FontSize="11"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource WinTextBrush}" />
                                        </StackPanel>

                                        <Button Grid.Column="2"
                                                Command="{Binding $parent[UserControl].((vm:HomeViewModel)DataContext).CopyLicenseTextCommand}"
                                                CommandParameter="{Binding}"
                                                Background="{DynamicResource WinPanelBrush}"
                                                Foreground="{DynamicResource WinAccentBrush}"
                                                BorderBrush="{DynamicResource WinBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="5"
                                                Padding="8,3"
                                                FontSize="10.5"
                                                FontWeight="SemiBold"
                                                Cursor="Hand">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <materialIcons:MaterialIcon Kind="ContentCopy" Width="11" Height="11" />
                                                <TextBlock Text="Copy Text" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>

                                    <!-- Monospace Verbatim Text -->
                                    <ScrollViewer Grid.Row="1" MaxHeight="220" VerticalScrollBarVisibility="Auto">
                                        <TextBox Text="{Binding LicenseText}"
                                                 IsReadOnly="True"
                                                 FontFamily="Consolas, Menlo, Monaco, Courier New, monospace"
                                                 FontSize="11"
                                                 Foreground="{DynamicResource WinTextBrush}"
                                                 Background="Transparent"
                                                 BorderThickness="0"
                                                 TextWrapping="Wrap"
                                                 Padding="0" />
                                    </ScrollViewer>
                                </Grid>
                            </Border>

                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- ================================================================= -->
        <!-- 6. IN-HOUSE ENGINEERED SUBSYSTEMS OVERVIEW                        -->
        <!-- ================================================================= -->
        <Border Background="{DynamicResource WinPanelBrush}" BorderBrush="{DynamicResource WinBorderBrush}" BorderThickness="1" CornerRadius="14" Padding="22">
            <StackPanel Spacing="14">
                <StackPanel Spacing="2">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <materialIcons:MaterialIcon Kind="CogOutline" Width="18" Height="18" Foreground="{DynamicResource WinAccentBrush}" />
                        <TextBlock Text="FryPDF Native Subsystems &amp; Architecture" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource WinTextBrush}" />
                    </StackPanel>
                    <TextBlock Text="Core features built from the ground up by CodeFryDev specifically for this application." FontSize="11.5" Foreground="{DynamicResource WinMutedBrush}" />
                </StackPanel>

                <Grid ColumnDefinitions="*,*,*" Margin="0,4,0,0">
                    <!-- Engine 1: Vector Canvas -->
                    <Border Grid.Column="0" Background="{DynamicResource WinInputBgBrush}" BorderBrush="{DynamicResource WinBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="0,0,6,0">
                        <StackPanel Spacing="3">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <materialIcons:MaterialIcon Kind="SelectDrag" Width="16" Height="16" Foreground="{DynamicResource WinAccentBrush}" />
                                <TextBlock Text="Vector Canvas Engine" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource WinTextBrush}" />
                            </StackPanel>
                            <TextBlock Text="Interactive multi-element selection, rotation, resizing, snap-to-grid, zoom scaling (25%-500%), and smart alignment guides."
                                       FontSize="11" Foreground="{DynamicResource WinMutedBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!-- Engine 2: 32 Tools Automation Suite -->
                    <Border Grid.Column="1" Background="{DynamicResource WinInputBgBrush}" BorderBrush="{DynamicResource WinBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="3,0,3,0">
                        <StackPanel Spacing="3">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <materialIcons:MaterialIcon Kind="AutoFix" Width="16" Height="16" Foreground="#10B981" />
                                <TextBlock Text="32-Tool Studio Suite" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource WinTextBrush}" />
                            </StackPanel>
                            <TextBlock Text="Unified batch PDF operations, format conversion pipeline, chainable multi-step workflow builder, and compression optimization."
                                       FontSize="11" Foreground="{DynamicResource WinMutedBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!-- Engine 3: AcroForms & Bates System -->
                    <Border Grid.Column="2" Background="{DynamicResource WinInputBgBrush}" BorderBrush="{DynamicResource WinBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="6,0,0,0">
                        <StackPanel Spacing="3">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <materialIcons:MaterialIcon Kind="FormSelect" Width="16" Height="16" Foreground="#8B5CF6" />
                                <TextBlock Text="Forms &amp; Security Engine" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource WinTextBrush}" />
                            </StackPanel>
                            <TextBlock Text="Live AcroForm formula recalculation, Bates legal numbering, permanent search-and-redact, and AES-256 permission encryption."
                                       FontSize="11" Foreground="{DynamicResource WinMutedBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </Border>

        <!-- ================================================================= -->
        <!-- 7. LEGAL NOTICE & NO-WARRANTY DISCLAIMER                          -->
        <!-- ================================================================= -->
        <Border Background="{DynamicResource WinInputBgBrush}" BorderBrush="{DynamicResource WinBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16,12">
            <StackPanel Spacing="4">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <materialIcons:MaterialIcon Kind="InformationOutline" Width="14" Height="14" Foreground="{DynamicResource WinMutedBrush}" />
                    <TextBlock Text="Open Source Warranty &amp; Liability Disclaimer" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource WinTextBrush}" />
                </StackPanel>
                <TextBlock Text="THE SOFTWARE IS PROVIDED &quot;AS IS&quot;, WITHOUT WARRANTY OF ANY KIND, EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS, COPYRIGHT HOLDERS, OR CONTRIBUTORS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY."
                           FontSize="10" Foreground="{DynamicResource WinMutedBrush}" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

    </StackPanel>
</UserControl>
